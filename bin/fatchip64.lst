------- FILE attack.asm LEVEL 2 PASS 3
      0  7914					      include	"attack.asm"
      1  7914							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  7914							; how each note starts and ends in pitch
      3  7914							;
      4  7914							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  7914							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  7914							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  7914							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  7914							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  7914							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  7914							;   (v0.42) as long as TIME.
     11  7914							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  7914							;   release rings.
     13  7914
     14  7914							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  7914							; jumps to the note
     16  7914				   AtkStep
     17  7914					      subroutine
     18  7914		       ac 8b c8 	      ldy	envY
     19  7917		       b9 31 ce 	      lda	atkT,y
     20  791a		       18		      clc
     21  791b		       6d 1e c9 	      adc	fxN
     22  791e		       90 02		      bcc	.t
     23  7920		       a9 ff		      lda	#255
     24  7922				   .t
     25  7922		       99 31 ce 	      sta	atkT,y
     26  7925		       b9 34 ce 	      lda	clickOn,y
     27  7928		       f0 21		      beq	.s
     28  792a		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  792c		       ae 5f cb 	      ldx	sndClick
     30  792f		       e0 02		      cpx	#2
     31  7931		       90 03		      bcc	.cl
     32  7933		       ad 5e cb 	      lda	sndStepT
     33  7936				   .cl
     34  7936		       d9 31 ce 	      cmp	atkT,y
     35  7939		       f0 02		      beq	.ce
     36  793b		       b0 0e		      bcs	.s
     37  793d				   .ce
     38  793d		       a9 00		      lda	#0
     39  793f		       99 34 ce 	      sta	clickOn,y
     40  7942		       be 7d 88 	      ldx	sidOfs,y
     41  7945		       b9 f6 c7 	      lda	sidGate,y
     42  7948		       9d 04 d4 	      sta	SID+4,x
     43  794b				   .s
     44  794b		       b9 2a ce 	      lda	sK,y
     45  794e		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  7950		       d0 19		      bne	.x
     47  7952		       b9 31 ce 	      lda	atkT,y
     48  7955		       cd 5e cb 	      cmp	sndStepT
     49  7958		       90 11		      bcc	.x
     50  795a		       b9 28 c9 	      lda	sidTgtLo,y	; TIME's up: the note
     51  795d		       99 aa c8 	      sta	sidBaseLo,y
     52  7960		       b9 2b c9 	      lda	sidTgtHi,y
     53  7963		       99 ad c8 	      sta	sidBaseHi,y
     54  7966		       a9 00		      lda	#0
     55  7968		       99 2a ce 	      sta	sK,y
     56  796b				   .x
     57  796b		       60		      rts
     58  796c
     59  796c							; a SID voice's gate went on (Y = SID voice, t2 = its registers): the CLICK
     60  796c							; starts. Keeps Y.
     61  796c				   ClickOn
     62  796c					      subroutine
     63  796c		       ad 5f cb 	      lda	sndClick
     64  796f		       f0 11		      beq	.x
     65  7971		       a9 01		      lda	#1
     66  7973		       99 34 ce 	      sta	clickOn,y
     67  7976		       b9 f6 c7 	      lda	sidGate,y
     68  7979		       29 01		      and	#1
