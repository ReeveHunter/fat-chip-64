------- FILE midi.asm LEVEL 2 PASS 3
      0  0a70					      include	"midi.asm"
      1  0a70							; Fat Chip 64 - MIDI out
      2  0a70							;
      3  0a70							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0a70							; at most one message per device onto the wire buffer, no sooner than that
      5  0a70							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0a70							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0a70							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0a70							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0a70							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0a70
     11  0a70				   MidiInit
     12  0a70					      subroutine
     13  0a70		       a9 03		      lda	#ACIA_RESET
     14  0a72		       8d 04 de 	      sta	ACIA_CTRL
     15  0a75		       a9 16		      lda	#ACIA_MODE
     16  0a77		       8d 04 de 	      sta	ACIA_CTRL
     17  0a7a		       60		      rts
     18  0a7b
     19  0a7b							; IRQ: send one wire byte if the ACIA is ready.
     20  0a7b				   TxByte
     21  0a7b					      subroutine
     22  0a7b		       a6 16		      ldx	wireTail
     23  0a7d		       e4 15		      cpx	wireHead
     24  0a7f		       f0 0f		      beq	.done
     25  0a81		       ad 06 de 	      lda	ACIA_STAT
     26  0a84		       29 02		      and	#ACIA_TDRE
     27  0a86		       f0 08		      beq	.done
     28  0a88		       bd 00 c0 	      lda	wireBuf,x
     29  0a8b		       8d 05 de 	      sta	ACIA_TX
     30  0a8e		       e6 16		      inc	wireTail
     31  0a90				   .done
     32  0a90		       60		      rts
     33  0a91
     34  0a91							; Main loop: same, with interrupts off around it.
     35  0a91				   TxService
     36  0a91					      subroutine
     37  0a91		       08		      php
     38  0a92		       78		      sei
     39  0a93		       20 7b 0a 	      jsr	TxByte
