     69  0f31							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0f31							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0f31							; still count as a combination.
     72  0f31		       a9 00		      lda	#0
