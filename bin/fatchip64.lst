------- FILE nesfx.asm LEVEL 2 PASS 3
      0  806a					      include	"nesfx.asm"
      1  806a							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  806a							;
      3  806a							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  806a							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  806a							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  806a							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  806a							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  806a							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  806a							;   glide    a new note starts bent back to the voice's last note and slides
     10  806a							;	      in the way the SID's does (all three channels)
     11  806a							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  806a							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  806a							; semitone, so these are a little stepped.
     14  806a
     15  806a		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  806a							;  (the pulses, and the triangle while it glides)
     17  806a
     18  806a							; A = 1 (not Z) when a NesFxTick step is due
     19  806a				   NesFxDue
     20  806a					      subroutine
     21  806a		       ad 2b c3 	      lda	devOn+DEV_NES
     22  806d		       f0 1c		      beq	.x
     23  806f		       ad 0b c6 	      lda	vibDepth
     24  8072		       0d 39 c5 	      ora	nfxGlide
     25  8075		       0d 3a c5 	      ora	nfxRun
     26  8078		       0d f3 c9 	      ora	nfxWarb
     27  807b		       f0 0e		      beq	.x
     28  807d		       a5 10		      lda	ticks
     29  807f		       38		      sec
     30  8080		       ed 35 c5 	      sbc	nfxLast
     31  8083		       c9 08		      cmp	#NFX_EVERY
     32  8085		       a9 00		      lda	#0
     33  8087		       90 02		      bcc	.x
     34  8089		       a9 01		      lda	#1
     35  808b				   .x
     36  808b		       60		      rts
     37  808c
     38  808c							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     39  808c							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     40  808c							; quick return.
     41  808c				   NesFxTick
     42  808c					      subroutine
     43  808c		       ad 2b c3 	      lda	devOn+DEV_NES
     44  808f		       f0 0e		      beq	.q
