      0  6204					      include	"wander.asm"
      1  6204							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  6204							;
      3  6204							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  6204							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  6204							;   ATTACK   as always: the new notes start
      6  6204							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  6204							;	      has none)
      8  6204							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  6204							;	      start again
     10  6204							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  6204							;	      late; some glide, some start again (fade out, come back in)
     12  6204							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  6204							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  6204							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  6204							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  6204
     17  6204		       00 01	   CHG_ATTACK equ	1
     18  6204		       00 02	   CHG_GLIDE  equ	2
     19  6204		       00 03	   CHG_STAGGER equ	3
     20  6204		       00 04	   CHG_WANDER equ	4
     21  6204		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  6204
