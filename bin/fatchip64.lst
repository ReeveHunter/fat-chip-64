    128  21ef		       8e a4 c4 	      stx	bendSidUp
    129  21f2		       20 4b 22 	      jsr	SidBendAll
    130  21f5				   .mid2
    131  21f5		       ad a0 c4 	      lda	bendMag
    132  21f8		       cd d8 c3 	      cmp	bendSent
    133  21fb		       d0 08		      bne	.chg
