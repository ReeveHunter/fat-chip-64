------- FILE midi.asm LEVEL 2 PASS 3
      0  0b3b					      include	"midi.asm"
      1  0b3b							; Fat Chip 64 - MIDI out
      2  0b3b							;
      3  0b3b							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0b3b							; at most one message per device onto the wire buffer, no sooner than that
      5  0b3b							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0b3b							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0b3b							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0b3b							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0b3b							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0b3b
     11  0b3b				   MidiInit
     12  0b3b					      subroutine
     13  0b3b		       a9 03		      lda	#ACIA_RESET
     14  0b3d		       8d 04 de 	      sta	ACIA_CTRL
     15  0b40		       a9 16		      lda	#ACIA_MODE
     16  0b42		       8d 04 de 	      sta	ACIA_CTRL
     17  0b45							; (fall into the test)
     18  0b45
     19  0b45							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0b45							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0b45							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0b45							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0b45							; before. Interrupts are off when this is called.
     24  0b45				   MidiIrqTest
     25  0b45					      subroutine
     26  0b45		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0b47		       8d 0d dc 	      sta	CIA1_ICR
     28  0b4a		       ad 0d dc 	      lda	CIA1_ICR
     29  0b4d		       a9 95		      lda	#<IrqTest
     30  0b4f		       8d fe ff 	      sta	$FFFE
     31  0b52		       a9 0b		      lda	#>IrqTest
     32  0b54		       8d ff ff 	      sta	$FFFF
     33  0b57		       a9 00		      lda	#0
     34  0b59		       85 2f		      sta	midiIrq
     35  0b5b		       a9 b6		      lda	#ACIA_MODE_TX
     36  0b5d		       8d 04 de 	      sta	ACIA_CTRL
     37  0b60		       58		      cli
     38  0b61		       a2 00		      ldx	#0
     39  0b63				   .w
     40  0b63		       ca		      dex
     41  0b64		       d0 fd		      bne	.w
     42  0b66		       78		      sei
     43  0b67		       a6 2f		      ldx	midiIrq
     44  0b69		       bd a1 0b 	      lda	midiCtl,x
     45  0b6c		       8d 04 de 	      sta	ACIA_CTRL
     46  0b6f		       bd a3 0b 	      lda	irqLo,x
     47  0b72		       8d fe ff 	      sta	$FFFE
     48  0b75		       bd a5 0b 	      lda	irqHi,x
     49  0b78		       8d ff ff 	      sta	$FFFF
     50  0b7b		       bd a7 0b 	      lda	latchLo,x
     51  0b7e		       8d 04 dc 	      sta	CIA1_TALO
     52  0b81		       bd a9 0b 	      lda	latchHi,x
     53  0b84		       8d 05 dc 	      sta	CIA1_TAHI
     54  0b87		       a9 11		      lda	#$11	; start, force load, continuous
     55  0b89		       8d 0e dc 	      sta	CIA1_CRA
     56  0b8c		       ad 0d dc 	      lda	CIA1_ICR
     57  0b8f		       a9 81		      lda	#$81	; timer A interrupt on
     58  0b91		       8d 0d dc 	      sta	CIA1_ICR
