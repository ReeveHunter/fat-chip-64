    123  557b							; 250 ms .. 2 s (1000 .. 8000 quarters), else start the average again
    124  557b		       a5 27		      lda	t3
    125  557d		       c9 03		      cmp	#>1000
    126  557f		       90 10		      bcc	.bad0
    127  5581		       d0 06		      bne	.hi
    128  5583		       a5 26		      lda	t2
    129  5585		       c9 e8		      cmp	#<1000
