------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  3c8b					      include	"sounds.asm"
      1  3c8b							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  3c8b							;
      3  3c8b							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  3c8b							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  3c8b							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  3c8b							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  3c8b							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  3c8b							;
      9  3c8b							; Each sound has a mono default and a Fat Bass default:
     10  3c8b							;   MONO      one note (the last key pressed and still held) on every voice;
     11  3c8b							;	       a new key while another is held changes the pitch without a
     12  3c8b							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  3c8b							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  3c8b							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  3c8b							;	       the other voices
     16  3c8b							;
     17  3c8b							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  3c8b							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  3c8b							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  3c8b
     21  3c8b							; ------------------------------------------------------------ choosing
     22  3c8b							; V: next sound (SHIFT+V: previous)
     23  3c8b				   SoundKey
     24  3c8b					      subroutine
     25  3c8b		       20 1b 3d 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3c8e		       ae 9d c3 	      ldx	soundMode
     27  3c91		       ad 2e c3 	      lda	shiftDown
     28  3c94		       d0 09		      bne	.prev
     29  3c96		       e8		      inx
     30  3c97		       e0 13		      cpx	#NUM_SOUNDS
     31  3c99		       90 09		      bcc	.s
     32  3c9b		       a2 00		      ldx	#0
     33  3c9d		       f0 05		      beq	.s
     34  3c9f				   .prev
