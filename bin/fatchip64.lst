    372  3ca0		       d0 13		      bne	.x
    373  3ca2		       ae e7 cc 	      ldx	sxCmd
    374  3ca5		       e0 02		      cpx	#2
    375  3ca7		       f0 0d		      beq	.dev
    376  3ca9		       ae 18 cc 	      ldx	sxPos
    377  3cac		       e0 db		      cpx	#SX_LEN
    378  3cae		       d0 05		      bne	.x
    379  3cb0		       48		      pha
    380  3cb1		       20 47 3d 	      jsr	PatchReceived
    381  3cb4		       68		      pla
    382  3cb5				   .x
