    138  0ef9							; A = key code at ksCol / ksRow
    139  0ef9				   KeyCode
    140  0ef9					      subroutine
    141  0ef9		       ad 37 c3 	      lda	ksCol
    142  0efc		       0a		      asl
    143  0efd		       0a		      asl
    144  0efe		       0a		      asl
    145  0eff		       0d 38 c3 	      ora	ksRow
    146  0f02		       a8		      tay
    147  0f03		       b9 8b 6a 	      lda	keymap,y
    148  0f06		       60		      rts
