     30  1063		       99 06 d4 	      sta	SID+6,y
     31  1066		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     32  1068		       99 03 d4 	      sta	SID+3,y
     33  106b		       a9 20		      lda	#$20	; sawtooth, gate off
     34  106d		       9d 19 c3 	      sta	sidGate,x
     35  1070		       99 04 d4 	      sta	SID+4,y
     36  1073		       ca		      dex
