      0  0e08					      include	"keys.asm"
      1  0e08							; Fat Chip 64 - keyboard and RESTORE
      2  0e08
      3  0e08							; Scan the whole matrix, turn changes into key events.
      4  0e08							;
      5  0e08							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0e08							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0e08							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0e08							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0e08							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0e08							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0e08							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0e08							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0e08							; chords whose ghost lands on another used key lose their newest note.
     14  0e08				   KeyScan
     15  0e08					      subroutine
     16  0e08		       a2 07		      ldx	#7
     17  0e0a				   .col
     18  0e0a		       bd 25 69 	      lda	colSelect,x
     19  0e0d		       8d 00 dc 	      sta	CIA1_PRA
     20  0e10		       ad 01 dc 	      lda	CIA1_PRB
     21  0e13		       49 ff		      eor	#$FF
     22  0e15		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0e18		       9d 80 c2 	      sta	keyNow,x
     24  0e1b		       ca		      dex
     25  0e1c		       10 ec		      bpl	.col
     26  0e1e		       a9 ff		      lda	#$FF
     27  0e20		       8d 00 dc 	      sta	CIA1_PRA
     28  0e23							; ---- every column as accepted (nothing pressed or let go): done
     29  0e23		       a2 07		      ldx	#7
     30  0e25				   .same
     31  0e25		       bd 80 c2 	      lda	keyNow,x
     32  0e28		       dd 90 c2 	      cmp	keyAcc,x
     33  0e2b		       d0 04		      bne	.changed
     34  0e2d		       ca		      dex
     35  0e2e		       10 f5		      bpl	.same
     36  0e30		       60		      rts
     37  0e31				   .changed
     38  0e31							; ---- releases first: accepted keys that are up now
     39  0e31		       a2 00		      ldx	#0
     40  0e33				   .rc
     41  0e33		       8e 37 c3 	      stx	ksCol
     42  0e36		       bd 80 c2 	      lda	keyNow,x
     43  0e39		       49 ff		      eor	#$FF
     44  0e3b		       3d 90 c2 	      and	keyAcc,x
     45  0e3e		       8d 36 c3 	      sta	ksBits
     46  0e41		       a9 00		      lda	#0
     47  0e43		       8d 38 c3 	      sta	ksRow
     48  0e46				   .rb
     49  0e46		       ad 36 c3 	      lda	ksBits
     50  0e49		       f0 21		      beq	.rcn
     51  0e4b		       4e 36 c3 	      lsr	ksBits
     52  0e4e		       90 17		      bcc	.rbn
     53  0e50		       ae 37 c3 	      ldx	ksCol
     54  0e53		       ac 38 c3 	      ldy	ksRow
     55  0e56		       b9 2d 69 	      lda	rowBit,y
     56  0e59		       49 ff		      eor	#$FF
     57  0e5b		       3d 90 c2 	      and	keyAcc,x
     58  0e5e		       9d 90 c2 	      sta	keyAcc,x
     59  0e61		       20 f3 0e 	      jsr	KeyCode
     60  0e64		       20 b5 11 	      jsr	KeyUp
     61  0e67				   .rbn
     62  0e67		       ee 38 c3 	      inc	ksRow
     63  0e6a		       d0 da		      bne	.rb
     64  0e6c				   .rcn
     65  0e6c		       ae 37 c3 	      ldx	ksCol
     66  0e6f		       e8		      inx
     67  0e70		       e0 08		      cpx	#8
     68  0e72		       d0 bf		      bne	.rc
     69  0e74							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0e74							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0e74							; still count as a combination.
     72  0e74		       a9 00		      lda	#0
     73  0e76		       8d 3a c3 	      sta	ksPass
     74  0e79				   .pass
     75  0e79		       a2 00		      ldx	#0
     76  0e7b				   .pc
     77  0e7b		       8e 37 c3 	      stx	ksCol
     78  0e7e		       bd 90 c2 	      lda	keyAcc,x
     79  0e81		       49 ff		      eor	#$FF
     80  0e83		       3d 80 c2 	      and	keyNow,x
     81  0e86		       8d 36 c3 	      sta	ksBits
     82  0e89		       a9 00		      lda	#0
     83  0e8b		       8d 38 c3 	      sta	ksRow
     84  0e8e				   .pb
     85  0e8e		       ad 36 c3 	      lda	ksBits
     86  0e91		       f0 3d		      beq	.pcn
     87  0e93		       4e 36 c3 	      lsr	ksBits
     88  0e96		       90 33		      bcc	.pbn
     89  0e98		       ad 3b c3 	      lda	ghostFilter
     90  0e9b		       f0 05		      beq	.accept	; filter off (default): phantoms play
     91  0e9d		       20 01 0f 	      jsr	Suspect
     92  0ea0		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     93  0ea2				   .accept
     94  0ea2		       20 f3 0e 	      jsr	KeyCode
     95  0ea5		       20 e4 0e 	      jsr	IsModifier	; Z set = modifier
     96  0ea8		       f0 07		      beq	.mod
     97  0eaa		       ad 3a c3 	      lda	ksPass
     98  0ead		       f0 1c		      beq	.pbn	; pass 0: modifiers only
     99  0eaf		       d0 05		      bne	.take
    100  0eb1				   .mod
    101  0eb1		       ad 3a c3 	      lda	ksPass
    102  0eb4		       d0 15		      bne	.pbn	; (taken in pass 0)
    103  0eb6				   .take
    104  0eb6		       ae 37 c3 	      ldx	ksCol
    105  0eb9		       ac 38 c3 	      ldy	ksRow
    106  0ebc		       b9 2d 69 	      lda	rowBit,y
    107  0ebf		       1d 90 c2 	      ora	keyAcc,x
    108  0ec2		       9d 90 c2 	      sta	keyAcc,x
    109  0ec5		       20 f3 0e 	      jsr	KeyCode
    110  0ec8		       20 32 0f 	      jsr	KeyDown
    111  0ecb				   .pbn
