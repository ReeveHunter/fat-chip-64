------- FILE repeat.asm LEVEL 2 PASS 3
      0  470b					      include	"repeat.asm"
      1  470b							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  470b							;
      3  470b							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  470b							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  470b							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  470b							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  470b							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  470b							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  470b							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  470b							; 3/4 of the time between echoes. The SID doesn't echo.
     11  470b							;
     12  470b							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  470b							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  470b							; or a keytar button).
     15  470b							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  470b							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  470b
     18  470b		       00 10	   RP_SLOTS   equ	16
     19  470b		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  470b
     21  470b							; REPEAT is on now?
     22  470b				   RepeatActive
     23  470b		       ad 4c c5 	      lda	repeatOn
     24  470e		       0d ac c4 	      ora	actCnt+A_REPEAT
     25  4711		       60		      rts
     26  4712
