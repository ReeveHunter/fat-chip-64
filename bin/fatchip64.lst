------- FILE bend.asm LEVEL 2 PASS 3
      0  2132					      include	"bend.asm"
      1  2132							; Fat Chip 64 - SPACE modes and the SPACE bend (v0.10)
      2  2132							;
      3  2132							; , and . (the < > keys) pick what SPACE does:
      4  2132							;   MUTES  (default) held = the mute flips (the momentary mute / play key)
      5  2132							;   BENDS  held = everything bends down 2 semitones over about 1 s;
      6  2132							;	    let go and it comes back up over about 0.5 s
      7  2132							;
      8  2132							; bendLvl 0-255 is the depth (255 = 2 semitones down).
      9  2132							;   SID       frequency x (1 - k / 256), k = lvl / 8 - lvl / 64 (max 28: 0.891,
     10  2132							;	       2 semitones), every change (4 ms steps)
     11  2132							;   Game Boy  pitch bend on its three channels (Fat Chip GB bend range is
     12  2132							;	       2 semitones): 8192 - lvl x 32, every BEND_TICK ms
     13  2132							;   MidiNES   its bend moves the timer, so the amount depends on the note:
     14  2132							;	       p(n) x lvl / 1024 for the triangle, twice that for the pulses
     15  2132							;	       (p = the MidiNES triangle bend scale, 1710 at MIDI 36; 2 semitones
     16  2132							;	       is p x 0.245, this is p x 0.249). Sent every BEND_TICK ms, and
     17  2132							;	       before each new NES note while bent. Notes too near the bottom
     18  2132							;	       of the NES range (the timer would wrap) don't bend.
     19  2132
     20  2132							; , : SPACE mode back
     21  2132				   SpaceBack
     22  2132					      subroutine
     23  2132		       ae d4 c3 	      ldx	spaceMode
     24  2135		       d0 02		      bne	.d
     25  2137		       a2 02		      ldx	#SPC_MODES
     26  2139				   .d
     27  2139		       ca		      dex
     28  213a		       4c 47 21 	      jmp	SpaceSet
     29  213d
     30  213d							; . : SPACE mode on
     31  213d				   SpaceNext
     32  213d					      subroutine
     33  213d		       ae d4 c3 	      ldx	spaceMode
     34  2140		       e8		      inx
     35  2141		       e0 02		      cpx	#SPC_MODES
     36  2143		       90 02		      bcc	SpaceSet
     37  2145		       a2 00		      ldx	#0
     38  2147				   SpaceSet
     39  2147		       8e d4 c3 	      stx	spaceMode
     40  214a		       a9 00		      lda	#0
     41  214c		       8d 8f c3 	      sta	moment	; a mute held in the old mode ends
     42  214f		       20 46 11 	      jsr	MuteChanged
     43  2152		       4c 3f 10 	      jmp	Dirty
     44  2155
     45  2155							; Main loop, every pass.
