    129  7bcd		       86 24		      stx	t0
    130  7bcf		       bd 97 c3 	      lda	vOut,x
    131  7bd2		       c9 ff		      cmp	#NO_NOTE
    132  7bd4		       f0 20		      beq	.x
    133  7bd6		       20 3f 7d 	      jsr	NesFxVal
    134  7bd9		       a6 24		      ldx	t0
    135  7bdb		       ad 33 c5 	      lda	nfxL
    136  7bde		       dd df c4 	      cmp	nesFxSL,x
    137  7be1		       d0 08		      bne	.send
    138  7be3		       ad 34 c5 	      lda	nfxH
    139  7be6		       dd e8 c4 	      cmp	nesFxSH,x
    140  7be9		       f0 0b		      beq	.x
    141  7beb				   .send
    142  7beb		       a9 01		      lda	#1
