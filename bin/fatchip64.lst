    107  7ab7		       a5 29		      lda	ptr+1
    108  7ab9		       99 ad c8 	      sta	sidBaseHi,y
    109  7abc		       ad 61 cb 	      lda	sndPenvK
    110  7abf		       ae 5d cb 	      ldx	sndStep
    111  7ac2		       f0 02		      beq	.k
    112  7ac4		       a9 ff		      lda	#$FF	; (STEP: held; AtkStep jumps)
