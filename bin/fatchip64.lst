    139  0cba
    140  0cba							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    141  0cba							; keys: some other column has a key in this row and shares another row with
    142  0cba							; this column.
    143  0cba				   Suspect
    144  0cba					      subroutine
    145  0cba		       ac 20 c3 	      ldy	ksRow
    146  0cbd		       b9 b5 20 	      lda	rowBit,y
    147  0cc0		       49 ff		      eor	#$FF
    148  0cc2		       ae 1f c3 	      ldx	ksCol
    149  0cc5		       3d 80 c2 	      and	keyNow,x
    150  0cc8		       8d 21 c3 	      sta	ksMask	; this column's other held rows
    151  0ccb		       f0 1c		      beq	.no
    152  0ccd		       a2 07		      ldx	#7
    153  0ccf				   .c
    154  0ccf		       ec 1f c3 	      cpx	ksCol
    155  0cd2		       f0 12		      beq	.n
    156  0cd4		       bd 80 c2 	      lda	keyNow,x
    157  0cd7		       39 b5 20 	      and	rowBit,y
    158  0cda		       f0 0a		      beq	.n
    159  0cdc		       bd 80 c2 	      lda	keyNow,x
    160  0cdf		       2d 21 c3 	      and	ksMask
    161  0ce2		       f0 02		      beq	.n
    162  0ce4		       38		      sec
    163  0ce5		       60		      rts
    164  0ce6				   .n
    165  0ce6		       ca		      dex
    166  0ce7		       10 e6		      bpl	.c
    167  0ce9				   .no
    168  0ce9		       18		      clc
