    877 Ucf74		       00	   beatAcc    ds	1	; RUN/STOP J: 0 the beat's, else accent layer + 1
    878 Ucf75		       00	   beatTs     ds	1	; RUN/STOP K: time signature
    879 Ucf76		       00	   beatSwg    ds	1	; RUN/STOP L: 0 the beat's, else swingT
    880 Ucf77		       00	   beatDev    ds	1	; menu BEATS ON: 0 MIDINES, 1 GAME BOY, 2 BOTH
    881 Ucf78		       00	   beatSplit  ds	1	; menu BOTH: 0 LAYER, 1 SPLIT (NES drums, Game Boy hats)
    882 Ucf79		       00	   gbBtHats   ds	1	; menu GB HATS: 0 SAMPLE, 1 NOISE
    883 Ucf7a		       00	   beatLoop   ds	1	; loops of the cycle played (A<->B)
    884 Ucf7b		       00	   cycLen     ds	1	; the cycle (the time signature over the beat's 32 steps)
    885 Ucf7c		       00 00 00 00*cycSrc     ds	32	;  each step's place in the beat
    886 Ucf9c		       00 00 00 00*cycPos     ds	32	;  its place in its bar
    887 Ucfbc		       00 00 00 00*cycBar     ds	32	;  which bar
    888 Ucfdc		       00	   hitLo      ds	1	; this step's lanes (bit = LANES order: kick .. hi hat)
    889 Ucfdd		       00	   hitHi      ds	1	;  (open hat .. clave)
    890 Ucfde		       00	   hitSt      ds	1	; its accent: 0 soft, 1 normal, 2 strong
    891 Ucfdf		       00	   hitFill    ds	1	; (a fill: the levels are its own)
    892 Ucfe0		       00	   tripK      ds	1	; triplet hats: the next of the beat's three (3 = none)
    893 Ucfe1		       00	   tripJ      ds	1	;  the first one's place in the layer's 12
    894 Ucfe2		       00 00	   tripMs     ds	2	;  a third of a beat, ms
    895 Ucfe4		       00	   tripAtL    ds	1
    896 Ucfe5		       00	   tripAtH    ds	1
    897 Ucfe6		       00	   gbKitSent  ds	1	; the Game Boy drum kit (CC 70) last sent + 1 (0: not yet)
    898 Ucfe7		       00	   gbHatSent  ds	1	; its HATS (CC 71) + 1
    899 Ucfe8				   ramEnd     ds	0
    900 Ucfe8				  -	      if	ramEnd > $D000
    901 Ucfe8				  -	      echo	"RAM variables run past $D000 (the I/O)"
    902 Ucfe8				  -	      err
    903 Ucfe8					      endif
