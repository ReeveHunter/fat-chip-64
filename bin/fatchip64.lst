      0  41ce					      include	"repeat.asm"
      1  41ce							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  41ce							;
      3  41ce							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  41ce							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  41ce							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  41ce							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  41ce							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  41ce							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  41ce							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  41ce							; 3/4 of the time between echoes. The SID doesn't echo.
     11  41ce							;
     12  41ce							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  41ce							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  41ce							; or a keytar button).
     15  41ce							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  41ce							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  41ce
     18  41ce		       00 10	   RP_SLOTS   equ	16
     19  41ce		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  41ce
     21  41ce							; REPEAT is on now?
     22  41ce				   RepeatActive
     23  41ce		       ad 4b c5 	      lda	repeatOn
     24  41d1		       0d ab c4 	      ora	actCnt+A_REPEAT
     25  41d4		       60		      rts
