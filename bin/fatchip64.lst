------- FILE drums.asm LEVEL 2 PASS 3
      0  50bc					      include	"drums.asm"
      1  50bc							; Fat Chip 64 - drums on the MidiNES
      2  50bc							;
      3  50bc							; Two sources, one kit:
      4  50bc							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  50bc							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  50bc							;			   64 = hit, 56 = ghost)
      7  50bc							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  50bc							;			   RETURN starts / stops it, at its own tempo (B taps
      9  50bc							;			   a new one)
     10  50bc							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  50bc							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  50bc							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  50bc							; a note-on, then a note-off after the sound's length, the level set with
     14  50bc							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  50bc							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  50bc
     17  50bc		       00 0c	   KIT_SIZE   equ	12
     18  50bc		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  50bc		       00 00	   DK_KICK    equ	0
     20  50bc		       00 01	   DK_SNARE   equ	1
     21  50bc		       00 02	   DK_CH      equ	2
     22  50bc		       00 03	   DK_OH      equ	3
     23  50bc		       00 04	   DK_CY      equ	4
     24  50bc		       00 05	   DK_TOM     equ	5
     25  50bc		       00 06	   DK_PERC    equ	6
     26  50bc
     27  50bc							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  50bc				   DrumHit
     29  50bc					      subroutine
     30  50bc		       8d 4f c9 	      sta	drumKind
