     86  4644		       65 25		      adc	t1
     87  4646		       aa		      tax
     88  4647		       bd 3f 9b 	      lda	kits,x
     89  464a		       85 25		      sta	t1
     90  464c							; bank (CC14 on the sample channel) when it changes
     91  464c		       a9 04		      lda	#4
     92  464e		       20 a6 46 	      jsr	NesChStatus	; mS = CC, sample channel
     93  4651		       a9 00		      lda	#0
     94  4653		       a6 25		      ldx	t1
     95  4655		       10 02		      bpl	.a
     96  4657		       a9 7f		      lda	#127
     97  4659				   .a
     98  4659		       cd 77 c4 	      cmp	dmcBank
     99  465c		       f0 0c		      beq	.note
    100  465e		       8d 77 c4 	      sta	dmcBank
    101  4661		       85 23		      sta	mD2
    102  4663		       a9 0e		      lda	#14
    103  4665		       85 22		      sta	mD1
    104  4667		       20 3d 0d 	      jsr	NesPut
    105  466a				   .note
    106  466a		       a5 21		      lda	mS
    107  466c		       29 0f		      and	#$0F
    108  466e		       85 26		      sta	t2	; channel
    109  4670		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    110  4672							;  cuts it anyway, and the hit lands 1 ms sooner)
    111  4672		       29 7f		      and	#$7F
