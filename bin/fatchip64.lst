    221  0ac9							; write the slot at head first (always free: one slot stays empty),
    222  0ac9							; then publish head unless the queue is full. Uses only A and X.
    223  0ac9		       a6 19		      ldx	nesqHead
    224  0acb		       a5 20		      lda	mS
    225  0acd		       9d c0 c1 	      sta	nesqS,x
    226  0ad0		       a5 21		      lda	mD1
    227  0ad2		       9d 00 c2 	      sta	nesqD1,x
    228  0ad5		       a5 22		      lda	mD2
