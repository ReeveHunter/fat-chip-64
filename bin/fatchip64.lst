    286  22ec		       8d ce c3 	      sta	mulB
    287  22ef		       a9 00		      lda	#0
    288  22f1		       8d cf c3 	      sta	mulB+1
    289  22f4		       20 15 20 	      jsr	Mul16	; p x lvl
    290  22f7							; triangle >> 10, pulse >> 9: bytes 1-2 shifted right 2 or 1
    291  22f7		       ad d2 c3 	      lda	mulR+2
    292  22fa		       8d dc c3 	      sta	bT2
    293  22fd		       ad d1 c3 	      lda	mulR+1
    294  2300		       8d dd c3 	      sta	bT3
    295  2303		       a6 24		      ldx	t0
