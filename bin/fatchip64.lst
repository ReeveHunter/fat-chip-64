      0  7296					      include	"attack.asm"
      1  7296							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  7296							; how each note starts and ends in pitch
      3  7296							;
      4  7296							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  7296							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  7296							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  7296							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  7296							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  7296							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  7296							;   (v0.42) as long as TIME.
     11  7296							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  7296							;   release rings.
     13  7296
     14  7296							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  7296							; jumps to the note
     16  7296				   AtkStep
     17  7296					      subroutine
     18  7296		       ac c3 c3 	      ldy	envY
     19  7299		       b9 6d c9 	      lda	atkT,y
     20  729c		       18		      clc
     21  729d		       6d 56 c4 	      adc	fxN
     22  72a0		       90 02		      bcc	.t
     23  72a2		       a9 ff		      lda	#255
     24  72a4				   .t
