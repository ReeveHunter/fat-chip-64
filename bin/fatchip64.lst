    191  0fc3							;   /		    mute		      SHIFT+/  the dice
    192  0fc3							;   ; / :	    free arp speed	      SPACE  its action
    193  0fc3							;   F1 / F3	    octave up / down	      F5  arp on / off	  F7  visualizer
    194  0fc3							;   RETURN	    the menu		      CTRL+F3/F5  GB / NES channel block
    195  0fc3							;   C= +  A S D F  arp type / pattern / speed / SPARKLE octave
    196  0fc3							;	   Z X C    notes mode / extensions / POLY-MONO     L  latch style
    197  0fc3							;	   , .	    SPACE's action	      ; :  MIDI in octave down / up
    198  0fc3							;	   /	    undo the dice	      F1 F3 F5	SID / GB / NES on-off
