    186  0cbe		       90 20		      bcc	.done
    187  0cc0		       a6 1b		      ldx	nesqTail
    188  0cc2		       bd 80 c6 	      lda	nesqS,x
    189  0cc5		       bc 00 c7 	      ldy	nesqD2,x
    190  0cc8		       84 2c		      sty	irqT
    191  0cca		       bc c0 c6 	      ldy	nesqD1,x
    192  0ccd		       20 fd 0c 	      jsr	WireMsg
    193  0cd0		       a5 1b		      lda	nesqTail
    194  0cd2		       18		      clc
    195  0cd3		       69 01		      adc	#1
    196  0cd5		       29 3f		      and	#63
    197  0cd7		       85 1b		      sta	nesqTail
    198  0cd9		       a5 10		      lda	ticks
    199  0cdb		       18		      clc
    200  0cdc		       69 01		      adc	#NES_GAP
    201  0cde		       85 1c		      sta	nesNext
