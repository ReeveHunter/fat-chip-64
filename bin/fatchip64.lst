------- FILE attack.asm LEVEL 2 PASS 3
      0  742c					      include	"attack.asm"
      1  742c							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  742c							; how each note starts and ends in pitch
      3  742c							;
      4  742c							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  742c							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  742c							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  742c							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  742c							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  742c							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  742c							;   (v0.42) as long as TIME.
     11  742c							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  742c							;   release rings.
     13  742c
     14  742c							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  742c							; jumps to the note
     16  742c				   AtkStep
     17  742c					      subroutine
     18  742c		       ac cb c3 	      ldy	envY
     19  742f		       b9 75 c9 	      lda	atkT,y
     20  7432		       18		      clc
     21  7433		       6d 5e c4 	      adc	fxN
     22  7436		       90 02		      bcc	.t
     23  7438		       a9 ff		      lda	#255
     24  743a				   .t
     25  743a		       99 75 c9 	      sta	atkT,y
     26  743d		       b9 78 c9 	      lda	clickOn,y
     27  7440		       f0 21		      beq	.s
     28  7442		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  7444		       ae a1 c6 	      ldx	sndClick
     30  7447		       e0 02		      cpx	#2
     31  7449		       90 03		      bcc	.cl
     32  744b		       ad a0 c6 	      lda	sndStepT
     33  744e				   .cl
     34  744e		       d9 75 c9 	      cmp	atkT,y
     35  7451		       f0 02		      beq	.ce
     36  7453		       b0 0e		      bcs	.s
     37  7455				   .ce
     38  7455		       a9 00		      lda	#0
     39  7457		       99 78 c9 	      sta	clickOn,y
     40  745a		       be a8 83 	      ldx	sidOfs,y
     41  745d		       b9 36 c3 	      lda	sidGate,y
     42  7460		       9d 04 d4 	      sta	SID+4,x
     43  7463				   .s
     44  7463		       b9 6e c9 	      lda	sK,y
     45  7466		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  7468		       d0 19		      bne	.x
     47  746a		       b9 75 c9 	      lda	atkT,y
     48  746d		       cd a0 c6 	      cmp	sndStepT
     49  7470		       90 11		      bcc	.x
     50  7472		       b9 68 c4 	      lda	sidTgtLo,y	; TIME's up: the note
     51  7475		       99 ea c3 	      sta	sidBaseLo,y
     52  7478		       b9 6b c4 	      lda	sidTgtHi,y
     53  747b		       99 ed c3 	      sta	sidBaseHi,y
     54  747e		       a9 00		      lda	#0
     55  7480		       99 6e c9 	      sta	sK,y
     56  7483				   .x
     57  7483		       60		      rts
