------- FILE main.asm LEVEL 1 PASS 3
      1  6618 ????						; Fat Chip 64 - main program
      2  6618 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  6618 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  6618 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  6618 ????
      6  6618 ????				      processor	6502
