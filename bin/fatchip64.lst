      0  1ec7					      include	"arp.asm"
      1  1ec7							; Fat Chip 64 - tempo and arpeggiator
      2  1ec7							;
      3  1ec7							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1ec7							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1ec7							;
      6  1ec7							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1ec7							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1ec7							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1ec7							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1ec7							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1ec7							;	     until its voice's next turn.
     12  1ec7							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1ec7							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1ec7							;   J faster; either one also picks FREE).
     15  1ec7							;
     16  1ec7							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1ec7							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1ec7
     19  1ec7							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1ec7							; between the two bytes: $22FF read as $23FF)
     21  1ec7				   GetTicks
     22  1ec7					      subroutine
     23  1ec7		       08		      php
     24  1ec8		       78		      sei
     25  1ec9		       a5 10		      lda	ticks
     26  1ecb		       8d 3e c3 	      sta	nowL
     27  1ece		       a5 11		      lda	ticks+1
     28  1ed0		       8d 3f c3 	      sta	nowH
     29  1ed3		       28		      plp
     30  1ed4		       60		      rts
