     70  797d		       a6 26		      ldx	t2
     71  797f		       9d 04 d4 	      sta	SID+4,x
     72  7982				   .x
     73  7982		       60		      rts
     74  7983
     75  7983							; VoiceSet, a SID voice's new note (Y = SID voice, t0 = the voice, t3 = a new
     76  7983							; press): BEND IN starts it away from its pitch
     77  7983				   BendIn
     78  7983					      subroutine
     79  7983		       ad 60 cb 	      lda	sndPenv
