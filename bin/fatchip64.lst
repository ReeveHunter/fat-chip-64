    132  8d5d		       bd 5f c8 	      lda	vOut,x
    133  8d60		       c9 ff		      cmp	#NO_NOTE
    134  8d62		       f0 20		      beq	.x
    135  8d64		       20 ec 8e 	      jsr	NesFxVal
    136  8d67		       a6 24		      ldx	t0
    137  8d69		       ad fd c9 	      lda	nfxL
    138  8d6c		       dd a9 c9 	      cmp	nesFxSL,x
    139  8d6f		       d0 08		      bne	.send
    140  8d71		       ad fe c9 	      lda	nfxH
