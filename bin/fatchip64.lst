    126  0eea							; Z set if key code A is a modifier. Keeps A.
    127  0eea				   IsModifier
    128  0eea		       c9 88		      cmp	#K_LSHIFT
    129  0eec		       f0 0a		      beq	.y
    130  0eee		       c9 89		      cmp	#K_RSHIFT
    131  0ef0		       f0 06		      beq	.y
    132  0ef2		       c9 8c		      cmp	#K_CTRL
    133  0ef4		       f0 02		      beq	.y
    134  0ef6		       c9 9a		      cmp	#K_K
    135  0ef8				   .y
