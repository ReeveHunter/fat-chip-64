      0  19ed					      include	"pads.asm"
      1  19ed							; Fat Chip 64 - sound: FAT (default) or PADS (V)
      2  19ed							;
      3  19ed							; PADS, per the brief's ambient pads: some voices swell and glide into each
      4  19ed							; chord, others keep sharp defined attacks.
      5  19ed							;   SID       slow attack (500 ms), long release (2.4 s), pulse wave with its
      6  19ed							;	       width wobbling (each voice its own phase), through a low-pass
      7  19ed							;	       filter that sweeps slowly (about 8 s up and down)
      8  19ed							;   Game Boy  slow attack and release on pulses + wave, pulse 2 glides
      9  19ed							;	       into each new note, deeper warble
     10  19ed							;   MidiNES   unchanged: the sharp attacks under the swell
     11  19ed
