    378  0b03							;------------------------------------------------------------- interrupts
    379  0b03							; Every 1/4 ms: take a MIDI-in byte, feed the ACIA one byte (fast path).
    380  0b03							; Every fourth time (1 ms):
    381  0b03							; count a tick and move paced messages onto the wire.
    382  0b03				   Irq
    383  0b03					      subroutine
    384  0b03		       48		      pha
    385  0b04		       8a		      txa
    386  0b05		       48		      pha
    387  0b06		       ad 0d dc 	      lda	CIA1_ICR	; acknowledge
    388  0b09		       ad 06 de 	      lda	ACIA_STAT	; MIDI in: a received byte? (quick check inline)
    389  0b0c		       4a		      lsr
    390  0b0d		       90 03		      bcc	.noRx
    391  0b0f		       20 1c 34 	      jsr	RxGot
    392  0b12				   .noRx
    393  0b12		       a6 16		      ldx	wireTail
    394  0b14		       e4 15		      cpx	wireHead
    395  0b16		       f0 0f		      beq	.noByte
    396  0b18		       ad 06 de 	      lda	ACIA_STAT
    397  0b1b		       29 02		      and	#ACIA_TDRE
    398  0b1d		       f0 08		      beq	.noByte
