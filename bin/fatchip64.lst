    396  3dcd							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    397  3dcd							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    398  3dcd							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    399  3dcd							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    400  3dcd		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    401  3dd1		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    402  3dd8		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    403  3ddf		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    404  3de4		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    405  3de8		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
