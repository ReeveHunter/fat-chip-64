     15  0b1f		       a9 16		      lda	#ACIA_MODE
     16  0b21		       8d 04 de 	      sta	ACIA_CTRL
     17  0b24							; (fall into the test)
     18  0b24
     19  0b24							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0b24							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0b24							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0b24							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0b24							; before. Interrupts are off when this is called.
     24  0b24				   MidiIrqTest
