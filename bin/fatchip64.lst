      0  0b0b					      include	"midi.asm"
      1  0b0b							; Fat Chip 64 - MIDI out
      2  0b0b							;
      3  0b0b							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0b0b							; at most one message per device onto the wire buffer, no sooner than that
      5  0b0b							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0b0b							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0b0b							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0b0b							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0b0b							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0b0b
     11  0b0b				   MidiInit
     12  0b0b					      subroutine
     13  0b0b		       a9 03		      lda	#ACIA_RESET
     14  0b0d		       8d 04 de 	      sta	ACIA_CTRL
     15  0b10		       a9 16		      lda	#ACIA_MODE
     16  0b12		       8d 04 de 	      sta	ACIA_CTRL
     17  0b15							; (fall into the test)
     18  0b15
     19  0b15							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0b15							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0b15							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0b15							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0b15							; before. Interrupts are off when this is called.
     24  0b15				   MidiIrqTest
     25  0b15					      subroutine
     26  0b15		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0b17		       8d 0d dc 	      sta	CIA1_ICR
