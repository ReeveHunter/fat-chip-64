    106  39fd		       a5 21		      lda	mS
    107  39ff		       29 0f		      and	#$0F
    108  3a01		       85 26		      sta	t2	; channel
    109  3a03		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    110  3a05							;  cuts it anyway, and the hit lands 1 ms sooner)
    111  3a05		       29 7f		      and	#$7F
    112  3a07		       8d 85 c4 	      sta	dmcNote
    113  3a0a		       85 22		      sta	mD1
    114  3a0c		       a5 26		      lda	t2
    115  3a0e		       09 90		      ora	#$90
    116  3a10		       85 21		      sta	mS
    117  3a12		       a9 7f		      lda	#127
    118  3a14		       85 23		      sta	mD2
    119  3a16		       20 d9 0b 	      jsr	NesPut
