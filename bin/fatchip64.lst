    126  0fa1							; Z set if key code A is a modifier. Keeps A.
    127  0fa1				   IsModifier
    128  0fa1		       c9 88		      cmp	#K_LSHIFT
    129  0fa3		       f0 12		      beq	.y
    130  0fa5		       c9 89		      cmp	#K_RSHIFT
    131  0fa7		       f0 0e		      beq	.y
    132  0fa9		       c9 8c		      cmp	#K_CTRL
    133  0fab		       f0 0a		      beq	.y
    134  0fad		       c9 a2		      cmp	#K_CBM
    135  0faf		       f0 06		      beq	.y
    136  0fb1		       c9 a3		      cmp	#K_STOP
    137  0fb3		       f0 02		      beq	.y
