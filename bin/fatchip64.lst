------- FILE sounds.asm LEVEL 2 PASS 3
      0  293a					      include	"sounds.asm"
      1  293a							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  293a							;
      3  293a							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  293a							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  293a							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  293a							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  293a							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  293a							;
      9  293a							; Each sound has a mono default and a Fat Bass default:
     10  293a							;   MONO      one note (the last key pressed and still held) on every voice;
     11  293a							;	       a new key while another is held changes the pitch without a
     12  293a							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  293a							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  293a							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  293a							;	       the other voices
     16  293a							;
     17  293a							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  293a							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  293a							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  293a
     21  293a							; ------------------------------------------------------------ choosing
     22  293a							; V: next sound (SHIFT+V: previous)
     23  293a				   SoundKey
     24  293a					      subroutine
     25  293a		       20 7c 29 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  293d		       ae 95 c3 	      ldx	soundMode
     27  2940		       ad 2a c3 	      lda	shiftDown
     28  2943		       d0 09		      bne	.prev
     29  2945		       e8		      inx
     30  2946		       e0 13		      cpx	#NUM_SOUNDS
     31  2948		       90 09		      bcc	.s
     32  294a		       a2 00		      ldx	#0
     33  294c		       f0 05		      beq	.s
     34  294e				   .prev
     35  294e		       ca		      dex
     36  294f		       10 02		      bpl	.s
     37  2951		       a2 12		      ldx	#NUM_SOUNDS-1
     38  2953				   .s
     39  2953		       4c 5d 29 	      jmp	SoundSetX
     40  2956
