     88  7548		       f0 24		      beq	.x	; (a glide to a new note, no new attack)
     89  754a				   .go
     90  754a		       bd 0e c3 	      lda	vWant,x
     91  754d		       18		      clc
     92  754e		       6d a2 c6 	      adc	sndPenv
     93  7551		       20 9b 75 	      jsr	NoteClamp
     94  7554		       20 64 21 	      jsr	SidPitch	; -> ptr
     95  7557		       a5 28		      lda	ptr
