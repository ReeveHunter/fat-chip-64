      0  1aa3					      include	"voices.asm"
      1  1aa3							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  1aa3							;
      3  1aa3							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  1aa3							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  1aa3							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  1aa3							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  1aa3							; Allocation, whenever the held notes change. Who comes first (v0.21):
      8  1aa3							; Polyphony > Fat Bass > the patch's effects (REPEAT's echoes) > stacking.
      9  1aa3							;   1. every note gets a voice (SPARKLE's arp pair is what you play, so it
     10  1aa3							;	counts as notes and goes first)
     11  1aa3							;   2. Fat Bass: as many bass voices as are spare play the lowest note,
     12  1aa3							;	folded into the bass range (one note fewer needs a voice, so with
     13  1aa3							;	Fat Bass the bottom of the chord is the bass)
     14  1aa3							;   3. REPEAT's echo voices: one or two of what's still spare
     15  1aa3							;   4. leftover voices stack on the lowest two notes, alternating
     16  1aa3							; So one note = a nine-voice unison across three chips, and in chords the
     17  1aa3							; bottom of the chord is fattest. Disabled devices, and voices the drums
     18  1aa3							; hold (vDrum), get no notes.
     19  1aa3
     20  1aa3							; ------------------------------------------------------------ SID
     21  1aa3				   SidInit
     22  1aa3					      subroutine
     23  1aa3		       a2 18		      ldx	#24
     24  1aa5		       a9 00		      lda	#0
     25  1aa7				   .clr
