------- FILE nesenv.asm LEVEL 2 PASS 3
      0  29d1					      include	"nesenv.asm"
      1  29d1							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  29d1							;
      3  29d1							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  29d1							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  29d1							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  29d1							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  29d1							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  29d1							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  29d1							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  29d1							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  29d1							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  29d1							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  29d1							; would wrap to a high pitch).
     14  29d1							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  29d1
     16  29d1							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  29d1							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  29d1							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  29d1							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  29d1							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  29d1		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  29d1		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  29d1							; NES channels too, and can't take a bend every 4 ms
     24  29d1		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  29d1		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  29d1
     27  29d1							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  29d1		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  29da		       02 05	   slotVoice  .byte.b	2,5
     30  29dc
     31  29dc							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  29dc							; note keeps sounding for now). X = voice (= t0).
     33  29dc				   NesSoftRelease
     34  29dc					      subroutine
     35  29dc		       4c e1 29 	      jmp	.go
     36  29df				   .nope
     37  29df		       18		      clc
     38  29e0		       60		      rts
     39  29e1				   .go
     40  29e1		       ad 98 c7 	      lda	muteNow
     41  29e4		       0d d7 c7 	      ora	hardCut
     42  29e7		       d0 f6		      bne	.nope
     43  29e9		       ad 2b c7 	      lda	devOn+DEV_NES
     44  29ec		       f0 f1		      beq	.nope
     45  29ee		       bd c5 88 	      lda	vDev,x
     46  29f1		       c9 02		      cmp	#DEV_NES
     47  29f3		       d0 ea		      bne	.nope
     48  29f5		       bd 9f c7 	      lda	vOut,x
     49  29f8		       c9 ff		      cmp	#NO_NOTE
     50  29fa		       f0 e3		      beq	.nope
     51  29fc		       ad 53 c8 	      lda	nesEnvOn
     52  29ff		       f0 78		      beq	.fo	; (no envelope: BEND OUT's fall-off, if any)
     53  2a01		       bc d1 29 	      ldy	vEnvSlot,x
     54  2a04		       30 41		      bmi	.tri
     55  2a06							; pulse: release from the current level; step = level x factor / 4 + 1
     56  2a06							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  2a06							; about 2 s). Factor 0: no release, cut.
     58  2a06		       ad 76 c8 	      lda	envRelV
     59  2a09		       f0 6e		      beq	.fo
     60  2a0b		       86 26		      stx	t2
     61  2a0d		       84 27		      sty	t3
