------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  55bf					      include	"sync.asm"
      1  55bf							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  55bf							;
      3  55bf							; Menu, DEVICE SYNC (defaults first):
      4  55bf							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  55bf							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  55bf							;		     sets the tempo, averaged over beats (the clock jitters about
      7  55bf							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  55bf							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  55bf							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  55bf							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  55bf							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  55bf							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  55bf							;		     picks a beat demo (styleBeat)
     14  55bf							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  55bf							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  55bf							;		     key channel) picks a sound (voiceSound)
     17  55bf							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  55bf							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  55bf							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  55bf							;
     21  55bf							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  55bf							; 1/4 ms); a Start makes the next clock a beat.
     23  55bf
     24  55bf		       00 00	   TEMPO_KEYTAR equ	0
     25  55bf		       00 01	   TEMPO_OWN  equ	1
     26  55bf		       00 02	   TEMPO_SC   equ	2
     27  55bf		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  55bf
     29  55bf
     30  55bf
     31  55bf							; ------------------------------------------------------------ clock
     32  55bf							; Main loop, every pass
     33  55bf				   ClockTick
     34  55bf					      subroutine
