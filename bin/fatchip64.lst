     25  7eea		       0d 3a c5 	      ora	nfxRun
     26  7eed		       0d ef c9 	      ora	nfxWarb
     27  7ef0		       f0 0e		      beq	.x
     28  7ef2		       a5 10		      lda	ticks
     29  7ef4		       38		      sec
     30  7ef5		       ed 35 c5 	      sbc	nfxLast
