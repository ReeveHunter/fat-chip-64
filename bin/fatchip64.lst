      0  5002					      include	"nestables.asm"
      1  5002							; generated by tools/gen_tables.py (NES part) - do not edit
      2  5002							; MidiNES triangle release drop: -24 semitones over 50 steps (5 ms each = 250 ms), slow at first
      3  5002							; triPb: MidiNES triangle bend scale per MIDI note, p(n) = 1710 * 0.5^((n - 36) / 12)
      4  5002							; triDropH: (2 * 2^(s/12) - 2) * 1024 for the drop s at each step; bend = -(p * h) / 1024
      5  5002							; triDropS8: the drop at each step in eighths of a semitone (for the floor check)
      6  5002		       00 32	   TRI_STEPS  equ	50
