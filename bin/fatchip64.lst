    228  0cb1							; Put a message on the wire (IRQ only): A = status, Y = data 1, irqT = data 2.
    229  0cb1							; Program change / channel pressure have one data byte.
    230  0cb1				   WireMsg
    231  0cb1					      subroutine
    232  0cb1		       c5 14		      cmp	lastStatus
    233  0cb3		       f0 05		      beq	.rs
    234  0cb5		       85 14		      sta	lastStatus
    235  0cb7		       20 d4 0c 	      jsr	WirePut
    236  0cba				   .rs
    237  0cba		       98		      tya
    238  0cbb		       20 d4 0c 	      jsr	WirePut
    239  0cbe		       a5 14		      lda	lastStatus
    240  0cc0		       29 e0		      and	#$E0
    241  0cc2		       c9 c0		      cmp	#$C0	; $Cx and $Dx: one data byte
    242  0cc4		       f0 05		      beq	.done
    243  0cc6		       a5 2c		      lda	irqT
    244  0cc8		       20 d4 0c 	      jsr	WirePut
    245  0ccb				   .done
    246  0ccb		       ee 34 c3 	      inc	statSent
    247  0cce		       d0 03		      bne	.x
    248  0cd0		       ee 35 c3 	      inc	statSent+1
    249  0cd3				   .x
    250  0cd3		       60		      rts
