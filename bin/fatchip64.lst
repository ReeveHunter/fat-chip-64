    386  3cfa		       ae e7 cc 	      ldx	sxCmd
    387  3cfd		       e0 02		      cpx	#2
    388  3cff		       f0 0d		      beq	.dev
    389  3d01		       ae 18 cc 	      ldx	sxPos
    390  3d04		       e0 db		      cpx	#SX_LEN
    391  3d06		       d0 05		      bne	.x
    392  3d08		       48		      pha
    393  3d09		       20 9f 3d 	      jsr	PatchReceived
    394  3d0c		       68		      pla
    395  3d0d				   .x
