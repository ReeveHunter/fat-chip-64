------- FILE drums.asm LEVEL 2 PASS 3
      0  3c95					      include	"drums.asm"
      1  3c95							; Fat Chip 64 - drums on the MidiNES
      2  3c95							;
      3  3c95							; Two sources, one kit:
      4  3c95							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  3c95							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  3c95							;			   64 = hit, 56 = ghost)
      7  3c95							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  3c95							;			   RETURN starts / stops it, at its own tempo (B taps
      9  3c95							;			   a new one)
     10  3c95							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  3c95							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  3c95							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  3c95							; a note-on, then a note-off after the sound's length, the level set with
     14  3c95							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  3c95							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  3c95
     17  3c95		       00 0c	   KIT_SIZE   equ	12
     18  3c95		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  3c95		       00 00	   DK_KICK    equ	0
     20  3c95		       00 01	   DK_SNARE   equ	1
     21  3c95		       00 02	   DK_CH      equ	2
     22  3c95		       00 03	   DK_OH      equ	3
     23  3c95		       00 04	   DK_CY      equ	4
     24  3c95		       00 05	   DK_TOM     equ	5
     25  3c95		       00 06	   DK_PERC    equ	6
     26  3c95
     27  3c95							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  3c95				   DrumHit
     29  3c95					      subroutine
     30  3c95		       8d 83 c4 	      sta	drumKind
     31  3c98		       8e 82 c4 	      stx	drumLvl
     32  3c9b		       8c 84 c4 	      sty	drumTom
     33  3c9e		       c9 00		      cmp	#DK_KICK
     34  3ca0		       d0 05		      bne	.nk
     35  3ca2		       a9 01		      lda	#1
     36  3ca4		       8d 40 c6 	      sta	vizKick	; (the visualizer's border flash)
     37  3ca7				   .nk
     38  3ca7		       ad 27 c3 	      lda	devOn+DEV_NES
     39  3caa		       d0 01		      bne	.on
     40  3cac		       60		      rts
     41  3cad				   .on
     42  3cad		       20 19 1a 	      jsr	GetTicks
     43  3cb0		       ad 83 c4 	      lda	drumKind
     44  3cb3		       c9 02		      cmp	#DK_CH
     45  3cb5		       90 07		      bcc	.dmc
     46  3cb7		       c9 05		      cmp	#DK_TOM
     47  3cb9		       b0 03		      bcs	.dmc
     48  3cbb		       4c 70 3d 	      jmp	NoiseHit
     49  3cbe				   .dmc
     50  3cbe		       ae 83 c4 	      ldx	drumKind
     51  3cc1		       bd 57 3d 	      lda	dmcPrioT,x
     52  3cc4		       85 24		      sta	t0
     53  3cc6		       ad 3e c3 	      lda	nowL
     54  3cc9		       38		      sec
     55  3cca		       ed 7a c4 	      sbc	dmcAt
     56  3ccd		       a8		      tay
     57  3cce		       ad 3f c3 	      lda	nowH
     58  3cd1		       ed 7b c4 	      sbc	dmcAt+1
     59  3cd4		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  3cd6		       c0 0c		      cpy	#DRUM_WINDOW
     61  3cd8		       b0 08		      bcs	.ok
     62  3cda		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     63  3cdc		       cd 79 c4 	      cmp	dmcPrio
     64  3cdf		       90 01		      bcc	.ok
     65  3ce1		       60		      rts
     66  3ce2				   .ok
     67  3ce2							; the sample: kit[beat][kitOfs[kind] + level, or + tom]
     68  3ce2		       ae 83 c4 	      ldx	drumKind
     69  3ce5		       bd 5e 3d 	      lda	kitOfs,x
     70  3ce8		       e0 05		      cpx	#DK_TOM
     71  3cea		       d0 07		      bne	.lv
     72  3cec		       18		      clc
     73  3ced		       6d 84 c4 	      adc	drumTom
     74  3cf0		       4c f7 3c 	      jmp	.k
     75  3cf3				   .lv
     76  3cf3		       18		      clc
     77  3cf4		       6d 82 c4 	      adc	drumLvl
     78  3cf7				   .k
     79  3cf7		       85 25		      sta	t1
     80  3cf9		       ad 6e c4 	      lda	beatSel	; x 12
     81  3cfc		       0a		      asl
     82  3cfd		       0a		      asl
