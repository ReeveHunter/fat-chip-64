    160  0fb1							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    161  0fb1							; keys: some other column has a key in this row and shares another row with
    162  0fb1							; this column.
    163  0fb1				   Suspect
    164  0fb1					      subroutine
    165  0fb1		       ac 39 c3 	      ldy	ksRow
    166  0fb4		       b9 ba 80 	      lda	rowBit,y
    167  0fb7		       49 ff		      eor	#$FF
    168  0fb9		       ae 38 c3 	      ldx	ksCol
    169  0fbc		       3d 80 c2 	      and	keyNow,x
    170  0fbf		       8d 3a c3 	      sta	ksMask	; this column's other held rows
    171  0fc2		       f0 1c		      beq	.no
    172  0fc4		       a2 07		      ldx	#7
    173  0fc6				   .c
    174  0fc6		       ec 38 c3 	      cpx	ksCol
    175  0fc9		       f0 12		      beq	.n
    176  0fcb		       bd 80 c2 	      lda	keyNow,x
    177  0fce		       39 ba 80 	      and	rowBit,y
    178  0fd1		       f0 0a		      beq	.n
    179  0fd3		       bd 80 c2 	      lda	keyNow,x
    180  0fd6		       2d 3a c3 	      and	ksMask
    181  0fd9		       f0 02		      beq	.n
    182  0fdb		       38		      sec
    183  0fdc		       60		      rts
    184  0fdd				   .n
    185  0fdd		       ca		      dex
