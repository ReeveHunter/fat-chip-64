------- FILE arp.asm LEVEL 2 PASS 3
      0  23b4					      include	"arp.asm"
      1  23b4							; Fat Chip 64 - tempo and arpeggiator
      2  23b4							;
      3  23b4							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  23b4							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  23b4							;
      6  23b4							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  23b4							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  23b4							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  23b4							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  23b4							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  23b4							;	     until its voice's next turn.
     12  23b4							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  23b4							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  23b4							;   J faster; either one also picks FREE).
     15  23b4							;
     16  23b4							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  23b4							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  23b4
     19  23b4							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  23b4							; between the two bytes: $22FF read as $23FF)
     21  23b4				   GetTicks
     22  23b4					      subroutine
     23  23b4		       08		      php
     24  23b5		       78		      sei
     25  23b6		       a5 10		      lda	ticks
     26  23b8		       8d 43 c3 	      sta	nowL
     27  23bb		       a5 11		      lda	ticks+1
     28  23bd		       8d 44 c3 	      sta	nowH
     29  23c0		       28		      plp
     30  23c1		       60		      rts
     31  23c2
