------- FILE main.asm
------- FILE attack.asm LEVEL 2 PASS 3
      0  6676					      include	"attack.asm"
      1  6676							; Fat Chip 64 - ATTACK, BEND IN, BEND OUT (v0.30): how each note starts and
      2  6676							; ends in pitch
      3  6676							;
      4  6676							; ATTACK (the SID): BLIP: an octave up for one BLIP STEP, then the note
      5  6676							;   (OCTAVE + 5TH: an octave, a fifth, the note; 2 OCTAVES: two up, one up,
      6  6676							;   the note); CLICK: the first 20 ms as noise.
      7  6676							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      8  6676							;   a scoop) and bends to its pitch over TIME: the SID and NES slide it (the
      9  6676							;   SID per voice, the NES with its glide), the Game Boy has its own pitch
     10  6676							;   envelope (CC 80 / 81).
     11  6676							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  6676							;   release rings.
     13  6676
     14  6676							; SidFxs pitch loop, SID voice envY: ATTACK's clock; the CLICK ends
     15  6676				   AtkStep
     16  6676					      subroutine
     17  6676		       ac c2 c3 	      ldy	envY
     18  6679		       b9 58 c9 	      lda	atkT,y
     19  667c		       18		      clc
     20  667d		       6d 51 c4 	      adc	fxN
     21  6680		       90 02		      bcc	.t
     22  6682		       a9 ff		      lda	#255
     23  6684				   .t
     24  6684		       99 58 c9 	      sta	atkT,y
     25  6687		       b9 5b c9 	      lda	clickOn,y
     26  668a		       f0 15		      beq	.x
     27  668c		       b9 58 c9 	      lda	atkT,y
     28  668f		       c9 05		      cmp	#5	; (20 ms of noise)
     29  6691		       90 0e		      bcc	.x
     30  6693		       a9 00		      lda	#0
     31  6695		       99 5b c9 	      sta	clickOn,y
     32  6698		       be d3 74 	      ldx	sidOfs,y
     33  669b		       b9 31 c3 	      lda	sidGate,y
     34  669e		       9d 04 d4 	      sta	SID+4,x
     35  66a1				   .x
     36  66a1		       60		      rts
     37  66a2
     38  66a2							; a SID voice's gate went on (Y = SID voice, t2 = its registers): the CLICK
     39  66a2							; starts, the BLIP is there from the start. Keeps Y.
     40  66a2				   ClickOn
     41  66a2					      subroutine
     42  66a2		       ad 94 c6 	      lda	sndClick
     43  66a5		       f0 11		      beq	.b
     44  66a7		       a9 01		      lda	#1
     45  66a9		       99 5b c9 	      sta	clickOn,y
     46  66ac		       b9 31 c3 	      lda	sidGate,y
     47  66af		       29 01		      and	#1
     48  66b1		       09 80		      ora	#$80	; noise
     49  66b3		       a6 26		      ldx	t2
     50  66b5		       9d 04 d4 	      sta	SID+4,x
     51  66b8				   .b
     52  66b8		       ad 92 c6 	      lda	sndBlip
     53  66bb		       f0 03		      beq	.x
