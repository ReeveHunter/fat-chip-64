------- FILE midi.asm LEVEL 2 PASS 2
      0  09b0					      include	"midi.asm"
      1  09b0							; Fat Chip 64 - MIDI out
      2  09b0							;
      3  09b0							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  09b0							; at most one message per device onto the wire buffer, no sooner than that
      5  09b0							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  09b0							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  09b0							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  09b0							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  09b0							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  09b0
     11  09b0				   MidiInit
     12  09b0					      subroutine
     13  09b0		       a9 03		      lda	#ACIA_RESET
     14  09b2		       8d 04 de 	      sta	ACIA_CTRL
     15  09b5		       a9 16		      lda	#ACIA_MODE
     16  09b7		       8d 04 de 	      sta	ACIA_CTRL
     17  09ba		       60		      rts
     18  09bb
     19  09bb							; IRQ: send one wire byte if the ACIA is ready.
     20  09bb				   TxByte
     21  09bb					      subroutine
     22  09bb		       a6 15		      ldx	wireTail
     23  09bd		       e4 14		      cpx	wireHead
     24  09bf		       f0 0f		      beq	.done
     25  09c1		       ad 06 de 	      lda	ACIA_STAT
     26  09c4		       29 02		      and	#ACIA_TDRE
     27  09c6		       f0 08		      beq	.done
     28  09c8		       bd 00 c0 	      lda	wireBuf,x
     29  09cb		       8d 05 de 	      sta	ACIA_TX
     30  09ce		       e6 15		      inc	wireTail
     31  09d0				   .done
     32  09d0		       60		      rts
     33  09d1
     34  09d1							; Main loop: same, with interrupts off around it.
     35  09d1				   TxService
     36  09d1					      subroutine
     37  09d1		       08		      php
     38  09d2		       78		      sei
     39  09d3		       20 bb 09 	      jsr	TxByte
     40  09d6		       28		      plp
     41  09d7		       60		      rts
     42  09d8
     43  09d8							; IRQ: pace device queues onto the wire.
     44  09d8							;
     45  09d8							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
     46  09d8							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
     47  09d8							; times as signed numbers, so after 33 s of silence every queue froze for
     48  09d8							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
     49  09d8							;
     50  09d8							; When the Game Boy is on, everything on the wire also passes through the
     51  09d8							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
     52  09d8							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
     53  09d8							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
     54  09d8							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
     55  09d8							; message, the rate measured clean.
     56  09d8				   Schedule
     57  09d8					      subroutine
     58  09d8		       ad 0e c3 	      lda	devOn+DEV_GB
     59  09db		       f0 10		      beq	.gb
     60  09dd		       a5 2d		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
     61  09df		       f0 0c		      beq	.gb
     62  09e1		       c6 2d		      dec	linkLoad
     63  09e3		       f0 08		      beq	.gb
     64  09e5		       a5 10		      lda	ticks
     65  09e7		       29 01		      and	#1
     66  09e9		       f0 02		      beq	.gb
     67  09eb		       c6 2d		      dec	linkLoad
     68  09ed				   .gb
     69  09ed							; ---- Game Boy
     70  09ed		       a5 17		      lda	gbqTail
     71  09ef		       c5 16		      cmp	gbqHead
     72  09f1		       f0 36		      beq	.nes
     73  09f3		       a5 18		      lda	gbNext
     74  09f5		       38		      sec
     75  09f6		       e5 10		      sbc	ticks
     76  09f8		       f0 04		      beq	.gbDue
     77  09fa		       c9 04		      cmp	#GB_GAP+1
     78  09fc		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
     79  09fe				   .gbDue
     80  09fe							; only onto an empty wire, so the gap holds on the cable itself (NES
     81  09fe							; bytes already waiting would otherwise delay this one and squeeze it
     82  09fe							; against the next)
     83  09fe		       a5 14		      lda	wireHead
     84  0a00		       c5 15		      cmp	wireTail
     85  0a02		       d0 25		      bne	.nes
     86  0a04		       20 67 0a 	      jsr	LinkRoom
     87  0a07		       90 20		      bcc	.nes
     88  0a09		       a6 17		      ldx	gbqTail
     89  0a0b		       bd 00 c1 	      lda	gbqS,x
     90  0a0e		       bc 80 c1 	      ldy	gbqD2,x
     91  0a11		       84 2b		      sty	irqT
     92  0a13		       bc 40 c1 	      ldy	gbqD1,x
     93  0a16		       20 83 0a 	      jsr	WireMsg
     94  0a19		       a5 17		      lda	gbqTail
     95  0a1b		       18		      clc
     96  0a1c		       69 01		      adc	#1
     97  0a1e		       29 3f		      and	#63
     98  0a20		       85 17		      sta	gbqTail
     99  0a22		       a5 10		      lda	ticks
    100  0a24		       18		      clc
    101  0a25		       69 03		      adc	#GB_GAP
    102  0a27		       85 18		      sta	gbNext
    103  0a29				   .nes
    104  0a29		       a5 1a		      lda	nesqTail
    105  0a2b		       c5 19		      cmp	nesqHead
    106  0a2d		       f0 37		      beq	.done
    107  0a2f		       a5 1b		      lda	nesNext
    108  0a31		       38		      sec
    109  0a32		       e5 10		      sbc	ticks
    110  0a34		       f0 04		      beq	.nesDue
    111  0a36		       c9 02		      cmp	#NES_GAP+1
    112  0a38		       90 2c		      bcc	.done
    113  0a3a				   .nesDue
    114  0a3a		       20 7a 0a 	      jsr	WireFree
    115  0a3d		       c9 03		      cmp	#3
    116  0a3f		       90 25		      bcc	.done
    117  0a41		       20 67 0a 	      jsr	LinkRoom
    118  0a44		       90 20		      bcc	.done
    119  0a46		       a6 1a		      ldx	nesqTail
    120  0a48		       bd c0 c1 	      lda	nesqS,x
    121  0a4b		       bc 40 c2 	      ldy	nesqD2,x
    122  0a4e		       84 2b		      sty	irqT
    123  0a50		       bc 00 c2 	      ldy	nesqD1,x
    124  0a53		       20 83 0a 	      jsr	WireMsg
    125  0a56		       a5 1a		      lda	nesqTail
    126  0a58		       18		      clc
    127  0a59		       69 01		      adc	#1
    128  0a5b		       29 3f		      and	#63
    129  0a5d		       85 1a		      sta	nesqTail
    130  0a5f		       a5 10		      lda	ticks
    131  0a61		       18		      clc
    132  0a62		       69 01		      adc	#NES_GAP
    133  0a64		       85 1b		      sta	nesNext
    134  0a66				   .done
    135  0a66		       60		      rts
