    103  0c03							; IRQ: pace device queues onto the wire.
    104  0c03							;
    105  0c03							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0c03							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0c03							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0c03							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0c03							;
    110  0c03							; When the Game Boy is on, everything on the wire also passes through the
    111  0c03							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0c03							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0c03							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0c03							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0c03							; message, the rate measured clean.
    116  0c03				   Schedule
    117  0c03					      subroutine
    118  0c03		       ad 26 c3 	      lda	devOn+DEV_GB
    119  0c06		       f0 10		      beq	.gb
    120  0c08		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0c0a		       f0 0c		      beq	.gb
    122  0c0c		       c6 2e		      dec	linkLoad
    123  0c0e		       f0 08		      beq	.gb
    124  0c10		       a5 10		      lda	ticks
    125  0c12		       29 01		      and	#1
    126  0c14		       f0 02		      beq	.gb
    127  0c16		       c6 2e		      dec	linkLoad
    128  0c18				   .gb
    129  0c18							; ---- Game Boy
    130  0c18		       a5 18		      lda	gbqTail
    131  0c1a		       c5 17		      cmp	gbqHead
    132  0c1c		       f0 36		      beq	.nes
    133  0c1e		       a5 19		      lda	gbNext
    134  0c20		       38		      sec
    135  0c21		       e5 10		      sbc	ticks
    136  0c23		       f0 04		      beq	.gbDue
    137  0c25		       c9 04		      cmp	#GB_GAP+1
    138  0c27		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0c29				   .gbDue
    140  0c29							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0c29							; bytes already waiting would otherwise delay this one and squeeze it
    142  0c29							; against the next). While a Game Boy message is due, the NES doesn't
    143  0c29							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0c29							; holding its notes back.
    145  0c29		       a5 15		      lda	wireHead
    146  0c2b		       c5 16		      cmp	wireTail
    147  0c2d		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0c2f		       20 95 0c 	      jsr	LinkRoom
    149  0c32		       90 20		      bcc	.nes
    150  0c34		       a6 18		      ldx	gbqTail
    151  0c36		       bd 00 c1 	      lda	gbqS,x
    152  0c39		       bc 80 c1 	      ldy	gbqD2,x
    153  0c3c		       84 2c		      sty	irqT
    154  0c3e		       bc 40 c1 	      ldy	gbqD1,x
    155  0c41		       20 b1 0c 	      jsr	WireMsg
    156  0c44		       a5 18		      lda	gbqTail
    157  0c46		       18		      clc
    158  0c47		       69 01		      adc	#1
    159  0c49		       29 3f		      and	#63
    160  0c4b		       85 18		      sta	gbqTail
    161  0c4d		       a5 10		      lda	ticks
    162  0c4f		       18		      clc
    163  0c50		       69 03		      adc	#GB_GAP
    164  0c52		       85 19		      sta	gbNext
    165  0c54				   .nes
    166  0c54		       20 4e 30 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0c57		       a5 1b		      lda	nesqTail
    168  0c59		       c5 1a		      cmp	nesqHead
    169  0c5b		       f0 37		      beq	.done
    170  0c5d		       a5 1c		      lda	nesNext
    171  0c5f		       38		      sec
    172  0c60		       e5 10		      sbc	ticks
    173  0c62		       f0 04		      beq	.nesDue
    174  0c64		       c9 02		      cmp	#NES_GAP+1
    175  0c66		       90 2c		      bcc	.done
    176  0c68				   .nesDue
    177  0c68		       20 a8 0c 	      jsr	WireFree
    178  0c6b		       c9 03		      cmp	#3
    179  0c6d		       90 25		      bcc	.done
    180  0c6f		       20 95 0c 	      jsr	LinkRoom
    181  0c72		       90 20		      bcc	.done
    182  0c74		       a6 1b		      ldx	nesqTail
    183  0c76		       bd c0 c1 	      lda	nesqS,x
    184  0c79		       bc 40 c2 	      ldy	nesqD2,x
    185  0c7c		       84 2c		      sty	irqT
    186  0c7e		       bc 00 c2 	      ldy	nesqD1,x
    187  0c81		       20 b1 0c 	      jsr	WireMsg
    188  0c84		       a5 1b		      lda	nesqTail
    189  0c86		       18		      clc
    190  0c87		       69 01		      adc	#1
    191  0c89		       29 3f		      and	#63
    192  0c8b		       85 1b		      sta	nesqTail
    193  0c8d		       a5 10		      lda	ticks
    194  0c8f		       18		      clc
    195  0c90		       69 01		      adc	#NES_GAP
    196  0c92		       85 1c		      sta	nesNext
    197  0c94				   .done
    198  0c94		       60		      rts
    199  0c95
    200  0c95							; Carry set if the Teensyboy has room for a message (always, with the Game
    201  0c95							; Boy off), and counts it.
    202  0c95				   LinkRoom
    203  0c95					      subroutine
    204  0c95		       ad 26 c3 	      lda	devOn+DEV_GB
    205  0c98		       f0 0a		      beq	.yes
    206  0c9a		       a5 2e		      lda	linkLoad
    207  0c9c		       c9 2d		      cmp	#LINK_MAX
    208  0c9e		       b0 06		      bcs	.no
    209  0ca0		       69 03		      adc	#3
    210  0ca2		       85 2e		      sta	linkLoad
    211  0ca4				   .yes
    212  0ca4		       38		      sec
    213  0ca5		       60		      rts
    214  0ca6				   .no
    215  0ca6		       18		      clc
    216  0ca7		       60		      rts
    217  0ca8
    218  0ca8							; A = free bytes in the wire ring
    219  0ca8				   WireFree
    220  0ca8					      subroutine
    221  0ca8		       a5 16		      lda	wireTail
    222  0caa		       38		      sec
    223  0cab		       e5 15		      sbc	wireHead
    224  0cad		       38		      sec
    225  0cae		       e9 01		      sbc	#1
    226  0cb0		       60		      rts
