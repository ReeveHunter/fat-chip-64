      0  61f3					      include	"wander.asm"
      1  61f3							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  61f3							;
      3  61f3							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  61f3							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  61f3							;   ATTACK   as always: the new notes start
      6  61f3							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  61f3							;	      has none)
      8  61f3							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  61f3							;	      start again
     10  61f3							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  61f3							;	      late; some glide, some start again (fade out, come back in)
     12  61f3							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  61f3							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  61f3							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  61f3							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  61f3
     17  61f3		       00 01	   CHG_ATTACK equ	1
     18  61f3		       00 02	   CHG_GLIDE  equ	2
     19  61f3		       00 03	   CHG_STAGGER equ	3
     20  61f3		       00 04	   CHG_WANDER equ	4
     21  61f3		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  61f3
