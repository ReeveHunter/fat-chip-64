    443  653d							; ------------------------------------------------------------ tuning
    444  653d							; tuneC = PLAYING's FINE TUNE + the Synthcart's TUNE TO (while it's in use),
    445  653d							; in cents (-100..+100). The Game Boy gets it as master tune (CC 103), the
    446  653d							; NES in its bends (tuneN, 1/64 semitones), the SID in its note frequencies
    447  653d							; (SidTune; the notes sounding move at once). MATCH KEY sets the key's root
    448  653d							; once, when it changes.
    449  653d				   ScTune
    450  653d					      subroutine
    451  653d		       a9 00		      lda	#0
    452  653f		       ae 38 c8 	      ldx	useSc
