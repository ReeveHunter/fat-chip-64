    140  0cf7							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    141  0cf7							; keys: some other column has a key in this row and shares another row with
    142  0cf7							; this column.
    143  0cf7				   Suspect
    144  0cf7					      subroutine
    145  0cf7		       ac 20 c3 	      ldy	ksRow
    146  0cfa		       b9 91 24 	      lda	rowBit,y
    147  0cfd		       49 ff		      eor	#$FF
    148  0cff		       ae 1f c3 	      ldx	ksCol
    149  0d02		       3d 80 c2 	      and	keyNow,x
    150  0d05		       8d 21 c3 	      sta	ksMask	; this column's other held rows
    151  0d08		       f0 1c		      beq	.no
    152  0d0a		       a2 07		      ldx	#7
    153  0d0c				   .c
    154  0d0c		       ec 1f c3 	      cpx	ksCol
    155  0d0f		       f0 12		      beq	.n
    156  0d11		       bd 80 c2 	      lda	keyNow,x
    157  0d14		       39 91 24 	      and	rowBit,y
    158  0d17		       f0 0a		      beq	.n
    159  0d19		       bd 80 c2 	      lda	keyNow,x
    160  0d1c		       2d 21 c3 	      and	ksMask
    161  0d1f		       f0 02		      beq	.n
    162  0d21		       38		      sec
    163  0d22		       60		      rts
    164  0d23				   .n
    165  0d23		       ca		      dex
    166  0d24		       10 e6		      bpl	.c
    167  0d26				   .no
    168  0d26		       18		      clc
    169  0d27		       60		      rts
