------- FILE arp.asm LEVEL 2 PASS 3
      0  1e48					      include	"arp.asm"
      1  1e48							; Fat Chip 64 - tempo and arpeggiator
      2  1e48							;
      3  1e48							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1e48							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1e48							;
      6  1e48							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1e48							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1e48							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1e48							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1e48							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1e48							;	     until its voice's next turn.
     12  1e48							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1e48							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1e48							;   J faster; either one also picks FREE).
     15  1e48							;
     16  1e48							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1e48							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1e48
     19  1e48							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1e48							; between the two bytes: $22FF read as $23FF)
     21  1e48				   GetTicks
     22  1e48					      subroutine
     23  1e48		       08		      php
     24  1e49		       78		      sei
     25  1e4a		       a5 10		      lda	ticks
     26  1e4c		       8d 3e c3 	      sta	nowL
     27  1e4f		       a5 11		      lda	ticks+1
     28  1e51		       8d 3f c3 	      sta	nowH
     29  1e54		       28		      plp
     30  1e55		       60		      rts
     31  1e56
     32  1e56							; ------------------------------------------------------------ tempo
     33  1e56				   TapTempo
     34  1e56					      subroutine
     35  1e56		       20 3b 4a 	      jsr	FollowActive	; the keytar's clock sets the tempo: taps do nothing
     36  1e59		       f0 01		      beq	.tap
     37  1e5b		       60		      rts
     38  1e5c				   .tap
     39  1e5c		       a9 00		      lda	#0
     40  1e5e		       8d 1a c6 	      sta	beatFresh	; (a tempo of your own: a beat starting keeps it)
     41  1e61		       20 48 1e 	      jsr	GetTicks
     42  1e64		       ad 3e c3 	      lda	nowL
     43  1e67		       38		      sec
     44  1e68		       ed 43 c3 	      sbc	tapLast
     45  1e6b		       85 24		      sta	t0
     46  1e6d		       ad 3f c3 	      lda	nowH
     47  1e70		       ed 44 c3 	      sbc	tapLast+1
     48  1e73		       85 25		      sta	t1
     49  1e75		       ad 3e c3 	      lda	nowL
     50  1e78		       8d 43 c3 	      sta	tapLast
     51  1e7b		       ad 3f c3 	      lda	nowH
     52  1e7e		       8d 44 c3 	      sta	tapLast+1
     53  1e81		       ad 45 c3 	      lda	tapCount
     54  1e84		       d0 03		      bne	.had
     55  1e86		       4c 0a 1f 	      jmp	.first
     56  1e89				   .had
     57  1e89							; 240 ms (250 BPM) <= gap < 2000 ms (30 BPM)
     58  1e89		       a5 25		      lda	t1
     59  1e8b		       c9 07		      cmp	#>2000
     60  1e8d		       90 08		      bcc	.lt2000
     61  1e8f		       d0 79		      bne	.first2
     62  1e91		       a5 24		      lda	t0
     63  1e93		       c9 d0		      cmp	#<2000
     64  1e95		       b0 73		      bcs	.first2
     65  1e97				   .lt2000
     66  1e97		       a5 25		      lda	t1
     67  1e99		       d0 06		      bne	.ok
     68  1e9b		       a5 24		      lda	t0
     69  1e9d		       c9 f0		      cmp	#240
     70  1e9f		       90 68		      bcc	.x	; too fast: a bounce, ignore
     71  1ea1				   .ok
     72  1ea1		       ae 47 c3 	      ldx	tapPos
     73  1ea4		       a5 24		      lda	t0
     74  1ea6		       9d 48 c3 	      sta	tapRingLo,x
     75  1ea9		       a5 25		      lda	t1
     76  1eab		       9d 4c c3 	      sta	tapRingHi,x
     77  1eae		       e8		      inx
     78  1eaf		       8a		      txa
     79  1eb0		       29 03		      and	#3
     80  1eb2		       8d 47 c3 	      sta	tapPos
     81  1eb5		       ad 46 c3 	      lda	tapN
     82  1eb8		       c9 04		      cmp	#4
     83  1eba		       b0 03		      bcs	.avg
     84  1ebc		       ee 46 c3 	      inc	tapN
