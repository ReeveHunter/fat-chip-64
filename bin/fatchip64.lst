------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  4da5					      include	"sync.asm"
      1  4da5							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  4da5							;
      3  4da5							; Menu, DEVICE SYNC (defaults first):
      4  4da5							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  4da5							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  4da5							;		     sets the tempo, averaged over beats (the clock jitters about
      7  4da5							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  4da5							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  4da5							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  4da5							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  4da5							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  4da5							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  4da5							;		     picks a beat demo (styleBeat)
     14  4da5							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  4da5							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  4da5							;		     key channel) picks a sound (voiceSound)
     17  4da5							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  4da5							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  4da5							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  4da5							;
     21  4da5							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  4da5							; 1/4 ms); a Start makes the next clock a beat.
     23  4da5
     24  4da5		       00 00	   TEMPO_KEYTAR equ	0
     25  4da5		       00 01	   TEMPO_OWN  equ	1
     26  4da5		       00 02	   TEMPO_SC   equ	2
     27  4da5		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  4da5
     29  4da5
     30  4da5
     31  4da5							; ------------------------------------------------------------ clock
     32  4da5							; Main loop, every pass
     33  4da5				   ClockTick
     34  4da5					      subroutine
     35  4da5		       ad e4 c5 	      lda	clkCount	; any clock lately?
