    115 Uc140		       00 00 00 00*gbqD1      ds	64
    116 Uc180		       00 00 00 00*gbqD2      ds	64
    117 Uc1c0		       00 00 00 00*nesqS      ds	64
    118 Uc200		       00 00 00 00*nesqD1     ds	64
    119 Uc240		       00 00 00 00*nesqD2     ds	64
    120 Uc280		       00 00 00 00*keyNow     ds	8
    121 Uc288		       00 00 00 00*keyPrev    ds	8
    122 Uc290		       00 00 00 00*noteHeld   ds	24	; 1 = overlay key held
    123 Uc2a8		       00 00 00 00*notePressed ds	24	; 1 = pressed since the last voice update
    124 Uc2c0		       00 00 00 00*heldList   ds	8	; held notes, ascending (indexes 0-23)
    125 Uc2c8		       00	   heldCount  ds	1
