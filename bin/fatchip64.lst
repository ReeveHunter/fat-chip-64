    416  3ce5		       d0 0b		      bne	.nc
    417  3ce7		       c9 02		      cmp	#2
    418  3ce9		       d0 07		      bne	.nc
    419  3ceb		       8d e9 cc 	      sta	sxCmd
    420  3cee		       ee 1a cc 	      inc	sxPos
    421  3cf1		       60		      rts
    422  3cf2				   .nc
    423  3cf2		       ac e9 cc 	      ldy	sxCmd
    424  3cf5		       c0 02		      cpy	#2
    425  3cf7		       d0 0b		      bne	.pat
    426  3cf9		       e0 04		      cpx	#4	; 2: one byte, bit 0 SID, 1 Game Boy, 2 NES
