      0  42c7					      include	"menu.asm"
      1  42c7							; Fat Chip 64 - the menu (v0.14): RETURN in, SHIFT+RETURN back out
      2  42c7							;
      3  42c7							; Three pages: the main one (SOUND, PLAYING), ADVANCED SOUND and DEVICE SYNC
      4  42c7							; (RETURN on their lines opens them, SHIFT+RETURN comes back).
      5  42c7							; CRSR DOWN / SHIFT+CRSR DOWN (up): choose a setting. CRSR RIGHT / SHIFT+CRSR
      6  42c7							; RIGHT: its next / previous value. Every other key works as usual (notes
      7  42c7							; play; V, F keys, = ... too: the values here follow).
      8  42c7							; The play screen pauses while the menu is up and redraws when it closes.
      9  42c7
