------- FILE drums.asm LEVEL 2 PASS 3
      0  4e5e					      include	"drums.asm"
      1  4e5e							; Fat Chip 64 - drums on the MidiNES
      2  4e5e							;
      3  4e5e							; Two sources, one kit:
      4  4e5e							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  4e5e							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  4e5e							;			   64 = hit, 56 = ghost)
      7  4e5e							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  4e5e							;			   RETURN starts / stops it, at its own tempo (B taps
      9  4e5e							;			   a new one)
     10  4e5e							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  4e5e							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  4e5e							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  4e5e							; a note-on, then a note-off after the sound's length, the level set with
     14  4e5e							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  4e5e							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  4e5e
     17  4e5e		       00 0c	   KIT_SIZE   equ	12
     18  4e5e		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  4e5e		       00 00	   DK_KICK    equ	0
     20  4e5e		       00 01	   DK_SNARE   equ	1
     21  4e5e		       00 02	   DK_CH      equ	2
     22  4e5e		       00 03	   DK_OH      equ	3
     23  4e5e		       00 04	   DK_CY      equ	4
     24  4e5e		       00 05	   DK_TOM     equ	5
     25  4e5e		       00 06	   DK_PERC    equ	6
     26  4e5e
     27  4e5e							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  4e5e				   DrumHit
     29  4e5e					      subroutine
     30  4e5e		       8d 8f c4 	      sta	drumKind
     31  4e61		       8e 8e c4 	      stx	drumLvl
