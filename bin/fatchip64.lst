------- FILE main.asm LEVEL 1 PASS 3
      1  d297 ????						; Fat Chip 64 - main program
      2  d297 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  d297 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  d297 ????						; Build: ./build.sh (dasm makes bin/fatchip64-image.prg; tools/crunch.py packs it
      5  d297 ????						; into bin/fatchip64.prg)
      6  d297 ????
      7  d297 ????				      processor	6502
