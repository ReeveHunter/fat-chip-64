    375  0ad2		       10 23		      bpl	.tim	; (not the MIDI chip)
    376  0ad4		       4a		      lsr		; a byte in?
    377  0ad5		       90 03		      bcc	.tx
    378  0ad7		       20 cb 2e 	      jsr	RxGot
    379  0ada				   .tx
    380  0ada		       ad 06 de 	      lda	ACIA_STAT
