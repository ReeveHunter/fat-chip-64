------- FILE attack.asm LEVEL 2 PASS 3
      0  718b					      include	"attack.asm"
      1  718b							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  718b							; how each note starts and ends in pitch
      3  718b							;
      4  718b							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  718b							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  718b							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  718b							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  718b							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  718b							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  718b							;   (v0.42) as long as TIME.
     11  718b							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  718b							;   release rings.
     13  718b
     14  718b							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  718b							; jumps to the note
     16  718b				   AtkStep
     17  718b					      subroutine
     18  718b		       ac c3 c3 	      ldy	envY
     19  718e		       b9 69 c9 	      lda	atkT,y
     20  7191		       18		      clc
     21  7192		       6d 52 c4 	      adc	fxN
     22  7195		       90 02		      bcc	.t
     23  7197		       a9 ff		      lda	#255
     24  7199				   .t
     25  7199		       99 69 c9 	      sta	atkT,y
     26  719c		       b9 6c c9 	      lda	clickOn,y
     27  719f		       f0 21		      beq	.s
     28  71a1		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  71a3		       ae 95 c6 	      ldx	sndClick
     30  71a6		       e0 02		      cpx	#2
     31  71a8		       90 03		      bcc	.cl
     32  71aa		       ad 94 c6 	      lda	sndStepT
     33  71ad				   .cl
     34  71ad		       d9 69 c9 	      cmp	atkT,y
     35  71b0		       f0 02		      beq	.ce
     36  71b2		       b0 0e		      bcs	.s
     37  71b4				   .ce
     38  71b4		       a9 00		      lda	#0
     39  71b6		       99 6c c9 	      sta	clickOn,y
     40  71b9		       be 02 81 	      ldx	sidOfs,y
     41  71bc		       b9 32 c3 	      lda	sidGate,y
     42  71bf		       9d 04 d4 	      sta	SID+4,x
     43  71c2				   .s
     44  71c2		       b9 62 c9 	      lda	sK,y
     45  71c5		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  71c7		       d0 19		      bne	.x
     47  71c9		       b9 69 c9 	      lda	atkT,y
     48  71cc		       cd 94 c6 	      cmp	sndStepT
     49  71cf		       90 11		      bcc	.x
     50  71d1		       b9 5c c4 	      lda	sidTgtLo,y	; TIME's up: the note
     51  71d4		       99 de c3 	      sta	sidBaseLo,y
     52  71d7		       b9 5f c4 	      lda	sidTgtHi,y
     53  71da		       99 e1 c3 	      sta	sidBaseHi,y
     54  71dd		       a9 00		      lda	#0
     55  71df		       99 62 c9 	      sta	sK,y
     56  71e2				   .x
     57  71e2		       60		      rts
     58  71e3
     59  71e3							; a SID voice's gate went on (Y = SID voice, t2 = its registers): the CLICK
     60  71e3							; starts. Keeps Y.
     61  71e3				   ClickOn
     62  71e3					      subroutine
     63  71e3		       ad 95 c6 	      lda	sndClick
     64  71e6		       f0 11		      beq	.x
     65  71e8		       a9 01		      lda	#1
     66  71ea		       99 6c c9 	      sta	clickOn,y
