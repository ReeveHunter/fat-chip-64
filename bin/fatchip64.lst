     39  ca1f ????	       03 ff	   TICK_LATCH_MS equ	1023	; with the MIDI chip's interrupts (midiIrq): 1 ms
     40  ca1f ????	       00 ff	   TICK_LATCH equ	255	; CIA1 timer A: 256 cycles = 1/4 ms (NTSC), quicker
     41  ca1f ????						; than a MIDI byte (327 cycles), so the ACIA is fed
     42  ca1f ????						; and read (MIDI in) even while the main loop is
