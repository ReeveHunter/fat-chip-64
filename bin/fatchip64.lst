------- FILE main.asm
------- FILE arp.asm LEVEL 2 PASS 3
      0  1a92					      include	"arp.asm"
      1  1a92							; Fat Chip 64 - tempo and arpeggiator
      2  1a92							;
      3  1a92							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1a92							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1a92							;
      6  1a92							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1a92							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1a92							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1a92							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1a92							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1a92							;	     until its voice's next turn.
     12  1a92							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1a92							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1a92							;   J faster; either one also picks FREE).
     15  1a92							;
     16  1a92							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1a92							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1a92
     19  1a92							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1a92							; between the two bytes: $22FF read as $23FF)
     21  1a92				   GetTicks
     22  1a92					      subroutine
     23  1a92		       08		      php
     24  1a93		       78		      sei
     25  1a94		       a5 10		      lda	ticks
     26  1a96		       8d 3e c3 	      sta	nowL
     27  1a99		       a5 11		      lda	ticks+1
     28  1a9b		       8d 3f c3 	      sta	nowH
     29  1a9e		       28		      plp
     30  1a9f		       60		      rts
     31  1aa0
     32  1aa0							; ------------------------------------------------------------ tempo
     33  1aa0				   TapTempo
     34  1aa0					      subroutine
     35  1aa0		       20 da 44 	      jsr	FollowActive	; the keytar's clock sets the tempo: taps do nothing
     36  1aa3		       f0 01		      beq	.tap
     37  1aa5		       60		      rts
     38  1aa6				   .tap
     39  1aa6		       a9 00		      lda	#0
     40  1aa8		       8d 1b c6 	      sta	beatFresh	; (a tempo of your own: a beat starting keeps it)
     41  1aab		       20 92 1a 	      jsr	GetTicks
     42  1aae		       ad 3e c3 	      lda	nowL
     43  1ab1		       38		      sec
     44  1ab2		       ed 43 c3 	      sbc	tapLast
     45  1ab5		       85 24		      sta	t0
     46  1ab7		       ad 3f c3 	      lda	nowH
     47  1aba		       ed 44 c3 	      sbc	tapLast+1
