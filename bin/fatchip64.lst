------- FILE main.asm
------- FILE arp.asm LEVEL 2 PASS 3
      0  22ae					      include	"arp.asm"
      1  22ae							; Fat Chip 64 - tempo and arpeggiator
      2  22ae							;
      3  22ae							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  22ae							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  22ae							;
      6  22ae							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  22ae							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  22ae							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  22ae							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  22ae							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  22ae							;	     until its voice's next turn.
     12  22ae							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  22ae							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  22ae							;   J faster; either one also picks FREE).
     15  22ae							;
     16  22ae							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  22ae							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  22ae
     19  22ae							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  22ae							; between the two bytes: $22FF read as $23FF)
     21  22ae				   GetTicks
     22  22ae					      subroutine
     23  22ae		       08		      php
     24  22af		       78		      sei
     25  22b0		       a5 10		      lda	ticks
     26  22b2		       8d 3f c3 	      sta	nowL
     27  22b5		       a5 11		      lda	ticks+1
     28  22b7		       8d 40 c3 	      sta	nowH
     29  22ba		       28		      plp
     30  22bb		       60		      rts
     31  22bc
     32  22bc							; ------------------------------------------------------------ tempo
     33  22bc				   TapTempo
     34  22bc					      subroutine
     35  22bc		       20 08 53 	      jsr	FollowActive	; the keytar's clock sets the tempo: taps do nothing
     36  22bf		       f0 01		      beq	.tap
     37  22c1		       60		      rts
     38  22c2				   .tap
     39  22c2		       a9 00		      lda	#0
     40  22c4		       8d 1b c6 	      sta	beatFresh	; (a tempo of your own: a beat starting keeps it)
     41  22c7		       20 ae 22 	      jsr	GetTicks
     42  22ca		       ad 3f c3 	      lda	nowL
     43  22cd		       38		      sec
     44  22ce		       ed 44 c3 	      sbc	tapLast
     45  22d1		       85 24		      sta	t0
     46  22d3		       ad 40 c3 	      lda	nowH
