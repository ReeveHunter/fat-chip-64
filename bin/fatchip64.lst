------- FILE main.asm
------- FILE pads.asm LEVEL 2 PASS 2
      0  1a7c					      include	"pads.asm"
      1  1a7c							; Fat Chip 64 - sound: FAT (default) or PADS (V)
      2  1a7c							;
      3  1a7c							; PADS, per the brief's ambient pads: some voices swell and glide into each
      4  1a7c							; chord, others keep sharp defined attacks.
      5  1a7c							;   SID       slow attack (500 ms), long release (2.4 s), pulse wave with its
      6  1a7c							;	       width wobbling (each voice its own phase), through a low-pass
      7  1a7c							;	       filter that sweeps slowly (about 8 s up and down)
      8  1a7c							;   Game Boy  slow attack and release on pulses + wave, pulse 2 glides
      9  1a7c							;	       into each new note, deeper warble
     10  1a7c							;   MidiNES   pulses swell and fade (CC7 envelope, see nesenv.asm); the
     11  1a7c							;	       triangle (bass) just stops on release
     12  1a7c							;
     13  1a7c							; RAW, the classic raw chip sound: FAT's stacking, everything square and
     14  1a7c							; instant: SID pulse (50 / 25 / 12.5% per voice), attack 0, sustain full,
     15  1a7c							; release 0, no filter; Game Boy instant attack and release, no warble,
     16  1a7c							; pulses 50% / 25%, wave channel as a third pulse; MidiNES full volume,
     17  1a7c							; pulse 2 at 25%. The small detunes between doubled voices stay.
     18  1a7c
     19  1a7c				   SoundApply
     20  1a7c					      subroutine
     21  1a7c		       20 67 1f 	      jsr	NesSoundApply	; leaving PADS: NES envelopes end, full volume
     22  1a7f		       20 8c 1b 	      jsr	NesDuty
