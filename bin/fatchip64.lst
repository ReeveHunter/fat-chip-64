    177  4fc0		       a5 24		      lda	t0
    178  4fc2		       d0 2f		      bne	.send
    179  4fc4							; closed hats: a third of the time a neighbouring noise note, a third
    180  4fc4							; of the time a level up or down
    181  4fc4		       20 c6 28 	      jsr	Random
    182  4fc7		       8d 90 c4 	      sta	drumTom
