    331  0d7d		       a5 21		      lda	mS	; next channel (wraps 16 -> 1)
    332  0d7f		       18		      clc
    333  0d80		       69 01		      adc	#1
    334  0d82		       29 0f		      and	#$0F
    335  0d84		       09 b0		      ora	#$B0
