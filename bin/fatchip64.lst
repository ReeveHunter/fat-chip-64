    207  0ffe		       aa		      tax
    208  0fff		       ad bd c8 	      lda	spArm
    209  1002		       f0 03		      beq	.nsp
    210  1004		       4c c0 67 	      jmp	SplitSet	; (C= + V held: this note sets the split, it doesn't play)
    211  1007				   .nsp
