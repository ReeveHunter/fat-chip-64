    142  0fb3							; A = key code at ksCol / ksRow
    143  0fb3				   KeyCode
    144  0fb3					      subroutine
    145  0fb3		       ad 37 c3 	      lda	ksCol
    146  0fb6		       0a		      asl
    147  0fb7		       0a		      asl
    148  0fb8		       0a		      asl
