------- FILE main.asm
------- FILE arp.asm LEVEL 2 PASS 3
      0  1e8c					      include	"arp.asm"
      1  1e8c							; Fat Chip 64 - tempo and arpeggiator
      2  1e8c							;
      3  1e8c							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1e8c							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1e8c							;
      6  1e8c							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1e8c							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1e8c							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1e8c							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1e8c							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1e8c							;	     until its voice's next turn.
     12  1e8c							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1e8c							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1e8c							;   J faster; either one also picks FREE).
     15  1e8c							;
     16  1e8c							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1e8c							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1e8c
     19  1e8c							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1e8c							; between the two bytes: $22FF read as $23FF)
     21  1e8c				   GetTicks
     22  1e8c					      subroutine
     23  1e8c		       08		      php
     24  1e8d		       78		      sei
     25  1e8e		       a5 10		      lda	ticks
     26  1e90		       8d 3e c3 	      sta	nowL
     27  1e93		       a5 11		      lda	ticks+1
     28  1e95		       8d 3f c3 	      sta	nowH
     29  1e98		       28		      plp
     30  1e99		       60		      rts
     31  1e9a
     32  1e9a							; ------------------------------------------------------------ tempo
     33  1e9a				   TapTempo
     34  1e9a					      subroutine
     35  1e9a		       20 cb 4c 	      jsr	FollowActive	; the keytar's clock sets the tempo: taps do nothing
