------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  35c2					      include	"sounds.asm"
      1  35c2							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  35c2							;
      3  35c2							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  35c2							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  35c2							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  35c2							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  35c2							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  35c2							;
      9  35c2							; Each sound has a mono default and a Fat Bass default:
     10  35c2							;   MONO      one note (the last key pressed and still held) on every voice;
     11  35c2							;	       a new key while another is held changes the pitch without a
     12  35c2							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  35c2							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  35c2							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  35c2							;	       the other voices
     16  35c2							;
     17  35c2							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  35c2							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  35c2							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  35c2
     21  35c2							; ------------------------------------------------------------ choosing
     22  35c2							; V: next sound (SHIFT+V: previous)
     23  35c2				   SoundKey
     24  35c2					      subroutine
     25  35c2		       20 3c 36 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  35c5		       ae 94 c3 	      ldx	soundMode
     27  35c8		       ad 2a c3 	      lda	shiftDown
     28  35cb		       d0 09		      bne	.prev
