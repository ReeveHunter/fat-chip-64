     95  2a54		       c9 16		      cmp	#TRI_FLOOR+1
     96  2a56		       90 36		      bcc	.no	; already at the bottom: just cut
     97  2a58		       8d d3 c7 	      sta	triNote
     98  2a5b		       a9 00		      lda	#0
     99  2a5d		       8d d2 c7 	      sta	triK
    100  2a60		       20 91 24 	      jsr	GetTicks
    101  2a63		       ad 43 c7 	      lda	nowL
    102  2a66		       8d d4 c7 	      sta	triLast
