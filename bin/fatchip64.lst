    205  0f3c		       aa		      tax
    206  0f3d		       ad 8b c3 	      lda	kDown
    207  0f40		       f0 03		      beq	.note
    208  0f42		       4c e4 10 	      jmp	SetKeyRoot
    209  0f45				   .note
    210  0f45		       a9 01		      lda	#1
