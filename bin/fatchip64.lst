    330  0d40		       20 e5 0c 	      jsr	GbPut
    331  0d43		       a5 21		      lda	mS	; next channel (wraps 16 -> 1)
    332  0d45		       18		      clc
    333  0d46		       69 01		      adc	#1
    334  0d48		       29 0f		      and	#$0F
    335  0d4a		       09 b0		      ora	#$B0
