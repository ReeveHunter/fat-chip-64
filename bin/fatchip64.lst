     32  0bde		       bd 80 c2 	      lda	keyNow,x
     33  0be1		       49 ff		      eor	#$FF
     34  0be3		       3d 90 c2 	      and	keyAcc,x
     35  0be6		       8d 1e c3 	      sta	ksBits
     36  0be9		       a9 00		      lda	#0
