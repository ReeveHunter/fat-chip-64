     44  0a93							; IRQ: pace device queues onto the wire.
     45  0a93							;
     46  0a93							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
     47  0a93							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
     48  0a93							; times as signed numbers, so after 33 s of silence every queue froze for
     49  0a93							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
     50  0a93							;
     51  0a93							; When the Game Boy is on, everything on the wire also passes through the
     52  0a93							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
     53  0a93							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
     54  0a93							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
     55  0a93							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
     56  0a93							; message, the rate measured clean.
     57  0a93				   Schedule
     58  0a93					      subroutine
     59  0a93		       ad 26 c3 	      lda	devOn+DEV_GB
     60  0a96		       f0 10		      beq	.gb
     61  0a98		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
     62  0a9a		       f0 0c		      beq	.gb
     63  0a9c		       c6 2e		      dec	linkLoad
     64  0a9e		       f0 08		      beq	.gb
     65  0aa0		       a5 10		      lda	ticks
     66  0aa2		       29 01		      and	#1
     67  0aa4		       f0 02		      beq	.gb
     68  0aa6		       c6 2e		      dec	linkLoad
     69  0aa8				   .gb
     70  0aa8							; ---- Game Boy
     71  0aa8		       a5 18		      lda	gbqTail
     72  0aaa		       c5 17		      cmp	gbqHead
     73  0aac		       f0 36		      beq	.nes
     74  0aae		       a5 19		      lda	gbNext
     75  0ab0		       38		      sec
     76  0ab1		       e5 10		      sbc	ticks
     77  0ab3		       f0 04		      beq	.gbDue
     78  0ab5		       c9 04		      cmp	#GB_GAP+1
     79  0ab7		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
     80  0ab9				   .gbDue
     81  0ab9							; only onto an empty wire, so the gap holds on the cable itself (NES
     82  0ab9							; bytes already waiting would otherwise delay this one and squeeze it
     83  0ab9							; against the next). While a Game Boy message is due, the NES doesn't
     84  0ab9							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
     85  0ab9							; holding its notes back.
     86  0ab9		       a5 15		      lda	wireHead
     87  0abb		       c5 16		      cmp	wireTail
     88  0abd		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
     89  0abf		       20 25 0b 	      jsr	LinkRoom
     90  0ac2		       90 20		      bcc	.nes
     91  0ac4		       a6 18		      ldx	gbqTail
     92  0ac6		       bd 00 c1 	      lda	gbqS,x
     93  0ac9		       bc 80 c1 	      ldy	gbqD2,x
     94  0acc		       84 2c		      sty	irqT
     95  0ace		       bc 40 c1 	      ldy	gbqD1,x
     96  0ad1		       20 41 0b 	      jsr	WireMsg
     97  0ad4		       a5 18		      lda	gbqTail
     98  0ad6		       18		      clc
     99  0ad7		       69 01		      adc	#1
    100  0ad9		       29 3f		      and	#63
    101  0adb		       85 18		      sta	gbqTail
    102  0add		       a5 10		      lda	ticks
    103  0adf		       18		      clc
    104  0ae0		       69 03		      adc	#GB_GAP
    105  0ae2		       85 19		      sta	gbNext
    106  0ae4				   .nes
    107  0ae4		       20 8d 26 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    108  0ae7		       a5 1b		      lda	nesqTail
    109  0ae9		       c5 1a		      cmp	nesqHead
    110  0aeb		       f0 37		      beq	.done
    111  0aed		       a5 1c		      lda	nesNext
