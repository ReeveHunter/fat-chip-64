     65  1d35		       4c 6a 1d 	      jmp	.no	; PADS: the bass just stops (Reeve, 2026-11-01)
     66  1d38					      endif
     67  1d38		       bd ce 2a 	      lda	vIdx,x
     68  1d3b		       c9 02		      cmp	#2
     69  1d3d		       d0 2b		      bne	.no
