    160  0fac							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    161  0fac							; keys: some other column has a key in this row and shares another row with
    162  0fac							; this column.
    163  0fac				   Suspect
    164  0fac					      subroutine
    165  0fac		       ac 39 c3 	      ldy	ksRow
    166  0faf		       b9 c5 7f 	      lda	rowBit,y
    167  0fb2		       49 ff		      eor	#$FF
    168  0fb4		       ae 38 c3 	      ldx	ksCol
    169  0fb7		       3d 80 c2 	      and	keyNow,x
    170  0fba		       8d 3a c3 	      sta	ksMask	; this column's other held rows
    171  0fbd		       f0 1c		      beq	.no
    172  0fbf		       a2 07		      ldx	#7
    173  0fc1				   .c
    174  0fc1		       ec 38 c3 	      cpx	ksCol
    175  0fc4		       f0 12		      beq	.n
    176  0fc6		       bd 80 c2 	      lda	keyNow,x
    177  0fc9		       39 c5 7f 	      and	rowBit,y
    178  0fcc		       f0 0a		      beq	.n
    179  0fce		       bd 80 c2 	      lda	keyNow,x
    180  0fd1		       2d 3a c3 	      and	ksMask
    181  0fd4		       f0 02		      beq	.n
    182  0fd6		       38		      sec
    183  0fd7		       60		      rts
    184  0fd8				   .n
    185  0fd8		       ca		      dex
    186  0fd9		       10 e6		      bpl	.c
    187  0fdb				   .no
    188  0fdb		       18		      clc
    189  0fdc		       60		      rts
    190  0fdd
    191  0fdd							; A = key code (v0.22 layout)
    192  0fdd							;   overlay	    notes
    193  0fdd							;   A S D F G	    bank (FAT PADS LEADS BASS FX): switches at once, same slot
    194  0fdd							;   Z X C V B	    patch 1-5 in the bank
    195  0fdd							;   L		    latch on / off	      K, then a note or a shape: key + scale
    196  0fdd							;   =		    tap tempo		      , / .  tempo -1 / +1 (SHIFT: 10)
    197  0fdd							;   /		    mute		      SHIFT+/  the dice
    198  0fdd							;   ; / :	    free arp speed	      SPACE  its action
    199  0fdd							;   F1 / F3	    octave up / down	      F5  arp on / off	  F7  visualizer
    200  0fdd							;   RETURN	    the menu		      CTRL+F3/F5  GB / NES channel block
    201  0fdd							;   C= +  A S D F  arp type / pattern / speed / SPARKLE octave
    202  0fdd							;	   Z X C    notes mode / extensions / POLY-MONO     L  latch style
    203  0fdd							;	   , .	    SPACE's action	      ; :  MIDI in octave down / up
    204  0fdd							;	   /	    undo the dice	      F1 F3 F5	SID / GB / NES on-off
    205  0fdd							;	   F7	    panic		      (SHIFT + F keys too, as before)
    206  0fdd							;   RUN/STOP	    tapped: beat start / stop; held + A S D F G H: pick a beat
    207  0fdd				   KeyDown
    208  0fdd					      subroutine
    209  0fdd		       c9 18		      cmp	#24
    210  0fdf		       90 03		      bcc	NoteDown
    211  0fe1		       4c 8e 10 	      jmp	.cmd
    212  0fe4				   NoteDown		; A = note index (overlay key 0-23, MIDI slot 24-31)
    213  0fe4		       aa		      tax
    214  0fe5		       ad bd c8 	      lda	spArm
    215  0fe8		       f0 03		      beq	.nsp
    216  0fea		       4c bc 6d 	      jmp	SplitSet	; (C= + V held: this note sets the split, it doesn't play)
    217  0fed				   .nsp
    218  0fed		       ad 71 c7 	      lda	kArm
    219  0ff0		       f0 03		      beq	.note
    220  0ff2		       4c ca 16 	      jmp	KeyShapeNote	; (K tapped: this note picks the key, it doesn't play)
    221  0ff5				   .note
    222  0ff5		       a9 01		      lda	#1
    223  0ff7		       9d b8 c2 	      sta	physKey,x
    224  0ffa		       ee d8 c2 	      inc	physCount
    225  0ffd		       20 3f 48 	      jsr	RepeatPress	; REPEAT: its echoes (keeps X)
    226  1000		       20 86 22 	      jsr	GetTicks
    227  1003		       20 8b 17 	      jsr	ApplySettings	; (changes waiting for this note)
    228  1006		       ad ae c8 	      lda	clMode	; CHORD + LEAD: the chord's key, or the lead
    229  1009		       f0 08		      beq	.ncl
    230  100b		       20 1e 6c 	      jsr	ClPress
    231  100e		       90 03		      bcc	.ncl
    232  1010		       4c 64 10 	      jmp	.add	; (the lead: no latch styles)
    233  1013				   .ncl
    234  1013		       ad 8c c3 	      lda	newPending	; NEXT or a setting change: this note starts a new chord
    235  1016		       f0 0b		      beq	.styles
    236  1018		       a9 00		      lda	#0
    237  101a		       8d 8c c3 	      sta	newPending
    238  101d		       20 26 18 	      jsr	ClearNotes
    239  1020		       4c 64 10 	      jmp	.add
    240  1023				   .styles
    241  1023		       ad 40 c4 	      lda	latch
    242  1026		       c9 03		      cmp	#LATCH_ADD
    243  1028		       f0 54		      beq	.addStyle
