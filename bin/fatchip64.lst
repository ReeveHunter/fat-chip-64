------- FILE drums.asm LEVEL 2 PASS 3
      0  50ea					      include	"drums.asm"
      1  50ea							; Fat Chip 64 - drums on the MidiNES
      2  50ea							;
      3  50ea							; Two sources, one kit:
      4  50ea							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  50ea							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  50ea							;			   64 = hit, 56 = ghost)
      7  50ea							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  50ea							;			   RETURN starts / stops it, at its own tempo (B taps
      9  50ea							;			   a new one)
     10  50ea							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  50ea							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  50ea							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  50ea							; a note-on, then a note-off after the sound's length, the level set with
     14  50ea							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  50ea							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  50ea
     17  50ea		       00 0c	   KIT_SIZE   equ	12
     18  50ea		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  50ea		       00 00	   DK_KICK    equ	0
     20  50ea		       00 01	   DK_SNARE   equ	1
     21  50ea		       00 02	   DK_CH      equ	2
     22  50ea		       00 03	   DK_OH      equ	3
     23  50ea		       00 04	   DK_CY      equ	4
     24  50ea		       00 05	   DK_TOM     equ	5
     25  50ea		       00 06	   DK_PERC    equ	6
     26  50ea
     27  50ea							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  50ea				   DrumHit
     29  50ea					      subroutine
     30  50ea		       8d 4f c9 	      sta	drumKind
     31  50ed		       8e 4e c9 	      stx	drumLvl
     32  50f0		       8c 50 c9 	      sty	drumTom
     33  50f3		       c9 00		      cmp	#DK_KICK
     34  50f5		       d0 05		      bne	.nk
     35  50f7		       a9 01		      lda	#1
     36  50f9		       8d 0a cb 	      sta	vizKick	; (the visualizer's border flash)
     37  50fc				   .nk
     38  50fc		       ad eb c7 	      lda	devOn+DEV_NES
     39  50ff		       d0 01		      bne	.on
     40  5101		       60		      rts
     41  5102				   .on
     42  5102		       20 ed 24 	      jsr	GetTicks
     43  5105		       ad 4f c9 	      lda	drumKind
     44  5108		       c9 02		      cmp	#DK_CH
     45  510a		       90 07		      bcc	.dmc
     46  510c		       c9 05		      cmp	#DK_TOM
     47  510e		       b0 03		      bcs	.dmc
     48  5110		       4c d3 51 	      jmp	NoiseHit
     49  5113				   .dmc
     50  5113		       ae 4f c9 	      ldx	drumKind
     51  5116		       bd ba 51 	      lda	dmcPrioT,x
     52  5119		       85 24		      sta	t0
     53  511b		       ad 03 c8 	      lda	nowL
     54  511e		       38		      sec
     55  511f		       ed 46 c9 	      sbc	dmcAt
     56  5122		       a8		      tay
     57  5123		       ad 04 c8 	      lda	nowH
     58  5126		       ed 47 c9 	      sbc	dmcAt+1
     59  5129		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  512b		       c0 0c		      cpy	#DRUM_WINDOW
     61  512d		       b0 08		      bcs	.ok
     62  512f		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     63  5131		       cd 45 c9 	      cmp	dmcPrio
     64  5134		       90 01		      bcc	.ok
     65  5136		       60		      rts
     66  5137				   .ok
     67  5137							; the sample: kit[beat][kitOfs[kind] + level, or + tom]
     68  5137		       ae 4f c9 	      ldx	drumKind
     69  513a		       bd c1 51 	      lda	kitOfs,x
     70  513d		       e0 05		      cpx	#DK_TOM
     71  513f		       d0 07		      bne	.lv
     72  5141		       18		      clc
     73  5142		       6d 50 c9 	      adc	drumTom
