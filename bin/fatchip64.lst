      0  37f0					      include	"midiin.asm"
      1  37f0							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  37f0							;
      3  37f0							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  37f0							; The main loop parses them (running status; realtime and system bytes are
      5  37f0							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  37f0							; notes mode, latch, arp and K + note.
      7  37f0							;
      8  37f0							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  37f0							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  37f0							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  37f0							;
     12  37f0							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  37f0							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  37f0							;
     15  37f0							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  37f0							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  37f0							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  37f0							; MIDI in is passed on to the Game Boy or NES.
     19  37f0
     20  37f0							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  37f0							; Uses A, X.
     22  37f0							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  37f0							; with the time; a Start ($FA) makes the next clock a beat.
     24  37f0				   RxByte
     25  37f0					      subroutine
     26  37f0		       ad 06 de 	      lda	ACIA_STAT
     27  37f3		       4a		      lsr		; RDRF -> carry
     28  37f4		       90 2b		      bcc	.x
     29  37f6				   RxGot
     30  37f6		       ad 07 de 	      lda	ACIA_RX
     31  37f9		       c9 f8		      cmp	#$F8
     32  37fb		       f0 25		      beq	.clk
     33  37fd		       c9 fa		      cmp	#$FA
     34  37ff		       d0 0e		      bne	.buf
     35  3801		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  3803		       8e e9 c5 	      stx	clkPhase
     37  3806		       8e f1 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3809							;  the main loop could measure it)
     39  3809		       ae ea c5 	      ldx	clkBeat
     40  380c		       8e fc c5 	      stx	clkStartBeat
     41  380f				   .buf
     42  380f		       ae 25 c4 	      ldx	rxHead
     43  3812		       9d e5 c3 	      sta	rxBuf,x
     44  3815		       e8		      inx
     45  3816		       8a		      txa
     46  3817		       29 3f		      and	#63
     47  3819		       cd 26 c4 	      cmp	rxTail
     48  381c		       f0 03		      beq	.x	; full: dropped
     49  381e		       8d 25 c4 	      sta	rxHead
