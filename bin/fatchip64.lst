------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  3d65					      include	"sounds.asm"
      1  3d65							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  3d65							;
      3  3d65							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  3d65							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  3d65							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  3d65							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  3d65							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  3d65							;
      9  3d65							; Each sound has a mono default and a Fat Bass default:
     10  3d65							;   MONO      one note (the last key pressed and still held) on every voice;
     11  3d65							;	       a new key while another is held changes the pitch without a
     12  3d65							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  3d65							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  3d65							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  3d65							;	       the other voices
     16  3d65							;
     17  3d65							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  3d65							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  3d65							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  3d65
     21  3d65							; ------------------------------------------------------------ choosing
     22  3d65							; V: next sound (SHIFT+V: previous)
     23  3d65				   SoundKey
     24  3d65					      subroutine
     25  3d65		       20 f5 3d 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3d68		       ae 5d c8 	      ldx	soundMode
     27  3d6b		       ad ee c7 	      lda	shiftDown
     28  3d6e		       d0 09		      bne	.prev
