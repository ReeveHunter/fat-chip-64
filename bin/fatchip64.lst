------- FILE menu.asm LEVEL 2 PASS 3
      0  5aa4					      include	"menu.asm"
      1  5aa4							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  5aa4							;
      3  5aa4							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  5aa4							;   page   RETURN opens a page
      5  5aa4							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  5aa4							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  5aa4							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  5aa4							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  5aa4							; device pages, until DEVICES says the device is in use).
     10  5aa4							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  5aa4							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  5aa4							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  5aa4
     14  5aa4		       00 17	   MENU_VALCOL equ	23
     15  5aa4
     16  5aa4				   MenuOpen
     17  5aa4		       20 a5 7c 	      jsr	GlitchCalm	; (GLITCH may have the picture shaking)
     18  5aa7		       a9 01		      lda	#1
