    252  0cff				   WirePut
    253  0cff					      subroutine
    254  0cff		       a6 15		      ldx	wireHead
    255  0d01		       9d 00 c0 	      sta	wireBuf,x
    256  0d04		       e6 15		      inc	wireHead
    257  0d06		       a5 2f		      lda	midiIrq	; the MIDI chip: interrupt when it can take it
    258  0d08		       f0 05		      beq	.x
    259  0d0a		       a9 b6		      lda	#ACIA_MODE_TX
    260  0d0c		       8d 04 de 	      sta	ACIA_CTRL
    261  0d0f				   .x
    262  0d0f		       60		      rts
