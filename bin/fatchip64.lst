    126  79da		       38		      sec
    127  79db		       ed 64 cb 	      sbc	sndRdrop
    128  79de		       20 fa 79 	      jsr	NoteClamp
    129  79e1		       20 f6 21 	      jsr	SidPitch
    130  79e4		       a5 28		      lda	ptr
