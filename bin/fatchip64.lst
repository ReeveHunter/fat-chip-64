------- FILE drums.asm LEVEL 2 PASS 3
      0  4e15					      include	"drums.asm"
      1  4e15							; Fat Chip 64 - drums on the MidiNES
      2  4e15							;
      3  4e15							; Two sources, one kit:
      4  4e15							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  4e15							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  4e15							;			   64 = hit, 56 = ghost)
      7  4e15							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  4e15							;			   RETURN starts / stops it, at its own tempo (B taps
      9  4e15							;			   a new one)
     10  4e15							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  4e15							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  4e15							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  4e15							; a note-on, then a note-off after the sound's length, the level set with
     14  4e15							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  4e15							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  4e15
     17  4e15		       00 0c	   KIT_SIZE   equ	12
     18  4e15		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  4e15		       00 00	   DK_KICK    equ	0
     20  4e15		       00 01	   DK_SNARE   equ	1
     21  4e15		       00 02	   DK_CH      equ	2
     22  4e15		       00 03	   DK_OH      equ	3
     23  4e15		       00 04	   DK_CY      equ	4
     24  4e15		       00 05	   DK_TOM     equ	5
     25  4e15		       00 06	   DK_PERC    equ	6
     26  4e15
     27  4e15							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  4e15				   DrumHit
     29  4e15					      subroutine
     30  4e15		       8d 87 c4 	      sta	drumKind
     31  4e18		       8e 86 c4 	      stx	drumLvl
     32  4e1b		       8c 88 c4 	      sty	drumTom
     33  4e1e		       c9 00		      cmp	#DK_KICK
     34  4e20		       d0 05		      bne	.nk
     35  4e22		       a9 01		      lda	#1
     36  4e24		       8d 44 c6 	      sta	vizKick	; (the visualizer's border flash)
     37  4e27				   .nk
