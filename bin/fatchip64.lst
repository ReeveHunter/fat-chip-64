------- FILE sounds.asm LEVEL 2 PASS 3
      0  3d82					      include	"sounds.asm"
      1  3d82							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  3d82							;
      3  3d82							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  3d82							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  3d82							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  3d82							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  3d82							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  3d82							;
      9  3d82							; Each sound has a mono default and a Fat Bass default:
     10  3d82							;   MONO      one note (the last key pressed and still held) on every voice;
     11  3d82							;	       a new key while another is held changes the pitch without a
     12  3d82							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  3d82							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  3d82							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  3d82							;	       the other voices
     16  3d82							;
     17  3d82							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  3d82							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  3d82							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  3d82
     21  3d82							; ------------------------------------------------------------ choosing
     22  3d82							; V: next sound (SHIFT+V: previous)
     23  3d82				   SoundKey
     24  3d82					      subroutine
