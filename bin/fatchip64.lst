      0  84f1					      include	"nesfx.asm"
      1  84f1							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  84f1							;
      3  84f1							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  84f1							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  84f1							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  84f1							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  84f1							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  84f1							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  84f1							;   glide    a new note starts bent back to the voice's last note and slides
     10  84f1							;	      in the way the SID's does (all three channels)
     11  84f1							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  84f1							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  84f1							; semitone, so these are a little stepped.
     14  84f1
     15  84f1		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  84f1							;  (the pulses, and the triangle while it glides)
     17  84f1
     18  84f1							; A = 1 (not Z) when a NesFxTick step is due
     19  84f1				   NesFxDue
     20  84f1					      subroutine
     21  84f1		       ad eb c7 	      lda	devOn+DEV_NES
     22  84f4		       f0 1c		      beq	.x
     23  84f6		       ad c9 ca 	      lda	vibDepth
     24  84f9		       0d f7 c9 	      ora	nfxGlide
     25  84fc		       0d f8 c9 	      ora	nfxRun
     26  84ff		       0d b5 ce 	      ora	nfxWarb
     27  8502		       f0 0e		      beq	.x
     28  8504		       a5 10		      lda	ticks
     29  8506		       38		      sec
     30  8507		       ed f3 c9 	      sbc	nfxLast
     31  850a		       c9 08		      cmp	#NFX_EVERY
     32  850c		       a9 00		      lda	#0
     33  850e		       90 02		      bcc	.x
     34  8510		       a9 01		      lda	#1
     35  8512				   .x
     36  8512		       60		      rts
     37  8513
