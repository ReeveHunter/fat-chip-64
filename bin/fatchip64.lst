     41  0a7a		       28		      plp
     42  0a7b		       60		      rts
     43  0a7c
     44  0a7c							; IRQ: pace device queues onto the wire.
     45  0a7c							;
     46  0a7c							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
     47  0a7c							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
     48  0a7c							; times as signed numbers, so after 33 s of silence every queue froze for
     49  0a7c							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
     50  0a7c							;
     51  0a7c							; When the Game Boy is on, everything on the wire also passes through the
     52  0a7c							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
     53  0a7c							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
     54  0a7c							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
     55  0a7c							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
     56  0a7c							; message, the rate measured clean.
     57  0a7c				   Schedule
     58  0a7c					      subroutine
     59  0a7c		       ad 26 c3 	      lda	devOn+DEV_GB
     60  0a7f		       f0 10		      beq	.gb
     61  0a81		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
     62  0a83		       f0 0c		      beq	.gb
     63  0a85		       c6 2e		      dec	linkLoad
     64  0a87		       f0 08		      beq	.gb
     65  0a89		       a5 10		      lda	ticks
     66  0a8b		       29 01		      and	#1
     67  0a8d		       f0 02		      beq	.gb
     68  0a8f		       c6 2e		      dec	linkLoad
     69  0a91				   .gb
     70  0a91							; ---- Game Boy
     71  0a91		       a5 18		      lda	gbqTail
     72  0a93		       c5 17		      cmp	gbqHead
     73  0a95		       f0 36		      beq	.nes
     74  0a97		       a5 19		      lda	gbNext
     75  0a99		       38		      sec
     76  0a9a		       e5 10		      sbc	ticks
     77  0a9c		       f0 04		      beq	.gbDue
     78  0a9e		       c9 04		      cmp	#GB_GAP+1
     79  0aa0		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
     80  0aa2				   .gbDue
     81  0aa2							; only onto an empty wire, so the gap holds on the cable itself (NES
     82  0aa2							; bytes already waiting would otherwise delay this one and squeeze it
     83  0aa2							; against the next). While a Game Boy message is due, the NES doesn't
     84  0aa2							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
     85  0aa2							; holding its notes back.
     86  0aa2		       a5 15		      lda	wireHead
     87  0aa4		       c5 16		      cmp	wireTail
     88  0aa6		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
     89  0aa8		       20 0e 0b 	      jsr	LinkRoom
     90  0aab		       90 20		      bcc	.nes
     91  0aad		       a6 18		      ldx	gbqTail
     92  0aaf		       bd 00 c1 	      lda	gbqS,x
     93  0ab2		       bc 80 c1 	      ldy	gbqD2,x
     94  0ab5		       84 2c		      sty	irqT
     95  0ab7		       bc 40 c1 	      ldy	gbqD1,x
     96  0aba		       20 2a 0b 	      jsr	WireMsg
     97  0abd		       a5 18		      lda	gbqTail
     98  0abf		       18		      clc
     99  0ac0		       69 01		      adc	#1
    100  0ac2		       29 3f		      and	#63
    101  0ac4		       85 18		      sta	gbqTail
    102  0ac6		       a5 10		      lda	ticks
    103  0ac8		       18		      clc
    104  0ac9		       69 03		      adc	#GB_GAP
    105  0acb		       85 19		      sta	gbNext
    106  0acd				   .nes
    107  0acd		       20 49 24 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    108  0ad0		       a5 1b		      lda	nesqTail
