------- FILE drums.asm LEVEL 2 PASS 3
      0  473e					      include	"drums.asm"
      1  473e							; Fat Chip 64 - drums on the MidiNES
      2  473e							;
      3  473e							; Two sources, one kit:
      4  473e							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  473e							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  473e							;			   64 = hit, 56 = ghost)
      7  473e							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  473e							;			   RETURN starts / stops it, at its own tempo (B taps
      9  473e							;			   a new one)
     10  473e							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  473e							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  473e							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  473e							; a note-on, then a note-off after the sound's length, the level set with
     14  473e							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  473e							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  473e
     17  473e		       00 0c	   KIT_SIZE   equ	12
     18  473e		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  473e		       00 00	   DK_KICK    equ	0
     20  473e		       00 01	   DK_SNARE   equ	1
     21  473e		       00 02	   DK_CH      equ	2
     22  473e		       00 03	   DK_OH      equ	3
     23  473e		       00 04	   DK_CY      equ	4
     24  473e		       00 05	   DK_TOM     equ	5
     25  473e		       00 06	   DK_PERC    equ	6
     26  473e
     27  473e							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  473e				   DrumHit
     29  473e					      subroutine
