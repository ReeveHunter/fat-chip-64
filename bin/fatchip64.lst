    107  4119		       29 0f		      and	#$0F
    108  411b		       85 26		      sta	t2	; channel
    109  411d		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    110  411f							;  cuts it anyway, and the hit lands 1 ms sooner)
    111  411f		       29 7f		      and	#$7F
    112  4121		       8d 84 c4 	      sta	dmcNote
