------- FILE main.asm
------- FILE wander.asm LEVEL 2 PASS 3
      0  6265					      include	"wander.asm"
      1  6265							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  6265							;
      3  6265							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  6265							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  6265							;   ATTACK   as always: the new notes start
      6  6265							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  6265							;	      has none)
      8  6265							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  6265							;	      start again
     10  6265							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  6265							;	      late; some glide, some start again (fade out, come back in)
     12  6265							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  6265							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  6265							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  6265							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  6265
     17  6265		       00 01	   CHG_ATTACK equ	1
     18  6265		       00 02	   CHG_GLIDE  equ	2
     19  6265		       00 03	   CHG_STAGGER equ	3
     20  6265		       00 04	   CHG_WANDER equ	4
     21  6265		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  6265
     23  6265							; A = the chord change style now (keeps X, Y)
     24  6265				   ChgEff
     25  6265					      subroutine
     26  6265		       ad 59 c8 	      lda	chgMode
     27  6268		       d0 0c		      bne	.x
     28  626a		       ad ab c3 	      lda	effMode
     29  626d		       c9 02		      cmp	#MODE_DRONE
     30  626f		       d0 03		      bne	.a
     31  6271		       a9 04		      lda	#CHG_WANDER
     32  6273		       60		      rts
     33  6274				   .a
     34  6274		       a9 01		      lda	#CHG_ATTACK
     35  6276				   .x
     36  6276		       60		      rts
     37  6277
