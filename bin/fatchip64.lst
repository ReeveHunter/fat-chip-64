     81  6bb9		       a2 08		      ldx	#8	; (the NES voices: 2, 5, 8)
     82  6bbb				   .v
     83  6bbb		       bd d5 c4 	      lda	nesVT,x
     84  6bbe		       18		      clc
     85  6bbf		       6d 2e c5 	      adc	nfxN
     86  6bc2		       90 02		      bcc	.vt
     87  6bc4		       a9 ff		      lda	#255
     88  6bc6				   .vt
