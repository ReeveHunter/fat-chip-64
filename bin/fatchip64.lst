     44  2991		       f0 f1		      beq	.nope
     45  2993		       bd 8c 83 	      lda	vDev,x
     46  2996		       c9 02		      cmp	#DEV_NES
     47  2998		       d0 ea		      bne	.nope
     48  299a		       bd 9f c3 	      lda	vOut,x
     49  299d		       c9 ff		      cmp	#NO_NOTE
     50  299f		       f0 e3		      beq	.nope
     51  29a1		       ad 53 c4 	      lda	nesEnvOn
     52  29a4		       f0 78		      beq	.fo	; (no envelope: BEND OUT's fall-off, if any)
     53  29a6		       bc 76 29 	      ldy	vEnvSlot,x
     54  29a9		       30 41		      bmi	.tri
     55  29ab							; pulse: release from the current level; step = level x factor / 4 + 1
     56  29ab							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  29ab							; about 2 s). Factor 0: no release, cut.
     58  29ab		       ad 76 c4 	      lda	envRelV
