    376  3c9f		       c9 f0		      cmp	#$F0
    377  3ca1		       d0 0e		      bne	.end
    378  3ca3		       a2 01		      ldx	#1
    379  3ca5		       8e 19 cc 	      stx	sxOn
    380  3ca8		       8e e9 cc 	      stx	sxCmd
    381  3cab		       a2 00		      ldx	#0
    382  3cad		       8e 1a cc 	      stx	sxPos
