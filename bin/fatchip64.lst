    316  2e9d							; CC 79, glide CC 5, detune +- from 64 on CC 94)
    317  2e9d		       10 18 1c 20 gbVibDepT  .byte.b	16, 24, 28, 32
    318  2ea1		       48 50 54 58*gbVibRateT .byte.b	72, 80, 84, 88, 92, 96, 100
    319  2ea8		       00 08 10 20*gbVibDelT  .byte.b	0, 8, 16, 32, 64
    320  2ead		       10 20 30 40 gbGlideT   .byte.b	16, 32, 48, 64
    321  2eb1		       03 06 0a 10 gbDetT     .byte.b	3, 6, 10, 16
