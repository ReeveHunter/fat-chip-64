    264  0ce5							; ------------------------------------------------------------ queueing (main loop)
    265  0ce5							; Message in mS / mD1 / mD2. Dropped if the queue is full (63 messages).
    266  0ce5				   GbPut
    267  0ce5					      subroutine
    268  0ce5							; write the slot at head first (always free: one slot stays empty),
    269  0ce5							; then publish head unless the queue is full. Uses only A and X.
    270  0ce5		       a6 17		      ldx	gbqHead
    271  0ce7		       a5 21		      lda	mS
    272  0ce9		       9d 00 c1 	      sta	gbqS,x
    273  0cec		       a5 22		      lda	mD1
    274  0cee		       9d 40 c1 	      sta	gbqD1,x
    275  0cf1		       a5 23		      lda	mD2
    276  0cf3		       9d 80 c1 	      sta	gbqD2,x
    277  0cf6		       8a		      txa
    278  0cf7		       18		      clc
    279  0cf8		       69 01		      adc	#1
    280  0cfa		       29 3f		      and	#63
    281  0cfc		       c5 18		      cmp	gbqTail
    282  0cfe		       f0 02		      beq	.full
    283  0d00		       85 17		      sta	gbqHead
    284  0d02				   .full
    285  0d02		       60		      rts
    286  0d03
    287  0d03				   NesPut
    288  0d03					      subroutine
    289  0d03							; write the slot at head first (always free: one slot stays empty),
    290  0d03							; then publish head unless the queue is full. Uses only A and X.
    291  0d03		       a6 1a		      ldx	nesqHead
    292  0d05		       a5 21		      lda	mS
    293  0d07		       9d c0 c1 	      sta	nesqS,x
    294  0d0a		       a5 22		      lda	mD1
    295  0d0c		       9d 00 c2 	      sta	nesqD1,x
    296  0d0f		       a5 23		      lda	mD2
    297  0d11		       9d 40 c2 	      sta	nesqD2,x
    298  0d14		       8a		      txa
    299  0d15		       18		      clc
    300  0d16		       69 01		      adc	#1
    301  0d18		       29 3f		      and	#63
    302  0d1a		       c5 1b		      cmp	nesqTail
    303  0d1c		       f0 02		      beq	.full
    304  0d1e		       85 1a		      sta	nesqHead
    305  0d20				   .full
