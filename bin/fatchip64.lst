      0  0e2a					      include	"keys.asm"
      1  0e2a							; Fat Chip 64 - keyboard and RESTORE
      2  0e2a
      3  0e2a							; Scan the whole matrix, turn changes into key events.
      4  0e2a							;
      5  0e2a							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0e2a							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0e2a							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0e2a							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0e2a							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0e2a							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0e2a							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0e2a							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0e2a							; chords whose ghost lands on another used key lose their newest note.
     14  0e2a				   KeyScan
     15  0e2a					      subroutine
     16  0e2a		       a2 07		      ldx	#7
     17  0e2c				   .col
     18  0e2c		       bd 99 67 	      lda	colSelect,x
     19  0e2f		       8d 00 dc 	      sta	CIA1_PRA
     20  0e32		       ad 01 dc 	      lda	CIA1_PRB
     21  0e35		       49 ff		      eor	#$FF
     22  0e37		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0e3a		       9d 80 c2 	      sta	keyNow,x
     24  0e3d		       ca		      dex
     25  0e3e		       10 ec		      bpl	.col
     26  0e40		       a9 ff		      lda	#$FF
     27  0e42		       8d 00 dc 	      sta	CIA1_PRA
     28  0e45							; ---- every column as accepted (nothing pressed or let go): done
     29  0e45		       a2 07		      ldx	#7
     30  0e47				   .same
     31  0e47		       bd 80 c2 	      lda	keyNow,x
     32  0e4a		       dd 90 c2 	      cmp	keyAcc,x
     33  0e4d		       d0 04		      bne	.changed
     34  0e4f		       ca		      dex
     35  0e50		       10 f5		      bpl	.same
     36  0e52		       60		      rts
     37  0e53				   .changed
     38  0e53							; ---- releases first: accepted keys that are up now
     39  0e53		       a2 00		      ldx	#0
     40  0e55				   .rc
     41  0e55		       8e 37 c3 	      stx	ksCol
     42  0e58		       bd 80 c2 	      lda	keyNow,x
     43  0e5b		       49 ff		      eor	#$FF
     44  0e5d		       3d 90 c2 	      and	keyAcc,x
     45  0e60		       8d 36 c3 	      sta	ksBits
     46  0e63		       a9 00		      lda	#0
     47  0e65		       8d 38 c3 	      sta	ksRow
     48  0e68				   .rb
     49  0e68		       ad 36 c3 	      lda	ksBits
     50  0e6b		       f0 21		      beq	.rcn
     51  0e6d		       4e 36 c3 	      lsr	ksBits
     52  0e70		       90 17		      bcc	.rbn
     53  0e72		       ae 37 c3 	      ldx	ksCol
     54  0e75		       ac 38 c3 	      ldy	ksRow
     55  0e78		       b9 a1 67 	      lda	rowBit,y
     56  0e7b		       49 ff		      eor	#$FF
     57  0e7d		       3d 90 c2 	      and	keyAcc,x
     58  0e80		       9d 90 c2 	      sta	keyAcc,x
     59  0e83		       20 1d 0f 	      jsr	KeyCode
     60  0e86		       20 d1 13 	      jsr	KeyUp
     61  0e89				   .rbn
     62  0e89		       ee 38 c3 	      inc	ksRow
     63  0e8c		       d0 da		      bne	.rb
     64  0e8e				   .rcn
     65  0e8e		       ae 37 c3 	      ldx	ksCol
     66  0e91		       e8		      inx
     67  0e92		       e0 08		      cpx	#8
     68  0e94		       d0 bf		      bne	.rc
     69  0e96							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0e96							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0e96							; still count as a combination.
     72  0e96		       a9 00		      lda	#0
     73  0e98		       8d 3a c3 	      sta	ksPass
     74  0e9b				   .pass
     75  0e9b		       a2 00		      ldx	#0
     76  0e9d				   .pc
     77  0e9d		       8e 37 c3 	      stx	ksCol
     78  0ea0		       bd 90 c2 	      lda	keyAcc,x
     79  0ea3		       49 ff		      eor	#$FF
     80  0ea5		       3d 80 c2 	      and	keyNow,x
     81  0ea8		       8d 36 c3 	      sta	ksBits
     82  0eab		       a9 00		      lda	#0
     83  0ead		       8d 38 c3 	      sta	ksRow
     84  0eb0				   .pb
     85  0eb0		       ad 36 c3 	      lda	ksBits
     86  0eb3		       f0 3d		      beq	.pcn
     87  0eb5		       4e 36 c3 	      lsr	ksBits
     88  0eb8		       90 33		      bcc	.pbn
     89  0eba		       ad 3b c3 	      lda	ghostFilter
     90  0ebd		       f0 05		      beq	.accept	; filter off (default): phantoms play
     91  0ebf		       20 2b 0f 	      jsr	Suspect
     92  0ec2		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     93  0ec4				   .accept
     94  0ec4		       20 1d 0f 	      jsr	KeyCode
     95  0ec7		       20 06 0f 	      jsr	IsModifier	; Z set = modifier
     96  0eca		       f0 07		      beq	.mod
     97  0ecc		       ad 3a c3 	      lda	ksPass
     98  0ecf		       f0 1c		      beq	.pbn	; pass 0: modifiers only
     99  0ed1		       d0 05		      bne	.take
    100  0ed3				   .mod
    101  0ed3		       ad 3a c3 	      lda	ksPass
    102  0ed6		       d0 15		      bne	.pbn	; (taken in pass 0)
    103  0ed8				   .take
    104  0ed8		       ae 37 c3 	      ldx	ksCol
    105  0edb		       ac 38 c3 	      ldy	ksRow
    106  0ede		       b9 a1 67 	      lda	rowBit,y
    107  0ee1		       1d 90 c2 	      ora	keyAcc,x
    108  0ee4		       9d 90 c2 	      sta	keyAcc,x
    109  0ee7		       20 1d 0f 	      jsr	KeyCode
    110  0eea		       20 5c 0f 	      jsr	KeyDown
    111  0eed				   .pbn
    112  0eed		       ee 38 c3 	      inc	ksRow
    113  0ef0		       d0 be		      bne	.pb
    114  0ef2				   .pcn
