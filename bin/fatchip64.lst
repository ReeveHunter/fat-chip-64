    171  0d2b							; A = key code
    172  0d2b							;   overlay	    notes (K held + a note: set the key)
    173  0d2b							;   F1/F3/F5/F7    octave: C4 / C3 / C2 / C1 on the lowest key
    174  0d2b							;   SHIFT+F1/F3/F5 SID / Game Boy / MidiNES on-off	SHIFT+F7 panic
    175  0d2b							;   CTRL+F3/F5     Game Boy / MidiNES: next channel block
    176  0d2b							;   M		    mute everything	   SPACE  momentary (flips mute while held)
    177  0d2b							;   =		    latch: OFF -> SMART -> HOLD -> ADD -> OFF
    178  0d2b							;   N		    new chord: the next note starts one (twice: clear now)
    179  0d2b							;   Z / X	    notes mode (POLY, CHORD, EXT) / extensions (7 9 11 13)
    180  0d2b							;   K + note / L   key root / major-minor	  V  sound: FAT or PADS
    181  0d2b							;   A / S / D / F  arp mode / pattern / speed / SPARKLE octave
    182  0d2b							;   H / J	    free arp speed	      B  tap tempo
    183  0d2b							;   G		    phantom-key filter on / off (off at start; for testing)
    184  0d2b				   KeyDown
    185  0d2b					      subroutine
    186  0d2b		       c9 18		      cmp	#24
    187  0d2d		       90 03		      bcc	.isNote
    188  0d2f		       4c c4 0d 	      jmp	.cmd
    189  0d32				   .isNote
    190  0d32		       aa		      tax
