      0  5360					      include	"menu.asm"
      1  5360							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  5360							;
      3  5360							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  5360							;   page   RETURN opens a page
      5  5360							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  5360							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  5360							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  5360							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  5360							; device pages, until DEVICES says the device is in use).
     10  5360							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  5360							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  5360							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  5360
     14  5360		       00 17	   MENU_VALCOL equ	23
     15  5360
