------- FILE drums.asm LEVEL 2 PASS 3
      0  3352					      include	"drums.asm"
      1  3352							; Fat Chip 64 - drums on the MidiNES
      2  3352							;
      3  3352							; Two sources, one kit:
      4  3352							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  3352							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  3352							;			   64 = hit, 56 = ghost)
      7  3352							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  3352							;			   RETURN starts / stops it, at its own tempo (B taps
      9  3352							;			   a new one)
     10  3352							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  3352							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  3352							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  3352							; a note-on, then a note-off after the sound's length, the level set with
     14  3352							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  3352							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  3352
     17  3352		       00 0c	   KIT_SIZE   equ	12
     18  3352		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  3352		       00 00	   DK_KICK    equ	0
     20  3352		       00 01	   DK_SNARE   equ	1
     21  3352		       00 02	   DK_CH      equ	2
     22  3352		       00 03	   DK_OH      equ	3
     23  3352		       00 04	   DK_CY      equ	4
     24  3352		       00 05	   DK_TOM     equ	5
     25  3352		       00 06	   DK_PERC    equ	6
     26  3352
