    102  0c2e
    103  0c2e							; IRQ: pace device queues onto the wire.
    104  0c2e							;
    105  0c2e							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0c2e							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0c2e							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0c2e							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0c2e							;
    110  0c2e							; When the Game Boy is on, everything on the wire also passes through the
    111  0c2e							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0c2e							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0c2e							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0c2e							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0c2e							; message, the rate measured clean.
    116  0c2e				   Schedule
    117  0c2e					      subroutine
    118  0c2e		       ad 26 c3 	      lda	devOn+DEV_GB
    119  0c31		       f0 10		      beq	.gb
    120  0c33		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0c35		       f0 0c		      beq	.gb
    122  0c37		       c6 2e		      dec	linkLoad
    123  0c39		       f0 08		      beq	.gb
    124  0c3b		       a5 10		      lda	ticks
    125  0c3d		       29 01		      and	#1
    126  0c3f		       f0 02		      beq	.gb
    127  0c41		       c6 2e		      dec	linkLoad
    128  0c43				   .gb
    129  0c43							; ---- Game Boy
    130  0c43		       a5 18		      lda	gbqTail
    131  0c45		       c5 17		      cmp	gbqHead
    132  0c47		       f0 36		      beq	.nes
    133  0c49		       a5 19		      lda	gbNext
    134  0c4b		       38		      sec
    135  0c4c		       e5 10		      sbc	ticks
    136  0c4e		       f0 04		      beq	.gbDue
    137  0c50		       c9 04		      cmp	#GB_GAP+1
    138  0c52		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0c54				   .gbDue
    140  0c54							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0c54							; bytes already waiting would otherwise delay this one and squeeze it
    142  0c54							; against the next). While a Game Boy message is due, the NES doesn't
    143  0c54							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0c54							; holding its notes back.
    145  0c54		       a5 15		      lda	wireHead
    146  0c56		       c5 16		      cmp	wireTail
    147  0c58		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0c5a		       20 c0 0c 	      jsr	LinkRoom
    149  0c5d		       90 20		      bcc	.nes
    150  0c5f		       a6 18		      ldx	gbqTail
    151  0c61		       bd 00 c1 	      lda	gbqS,x
    152  0c64		       bc 80 c1 	      ldy	gbqD2,x
    153  0c67		       84 2c		      sty	irqT
    154  0c69		       bc 40 c1 	      ldy	gbqD1,x
    155  0c6c		       20 dc 0c 	      jsr	WireMsg
    156  0c6f		       a5 18		      lda	gbqTail
    157  0c71		       18		      clc
    158  0c72		       69 01		      adc	#1
    159  0c74		       29 3f		      and	#63
    160  0c76		       85 18		      sta	gbqTail
    161  0c78		       a5 10		      lda	ticks
    162  0c7a		       18		      clc
    163  0c7b		       69 03		      adc	#GB_GAP
    164  0c7d		       85 19		      sta	gbNext
    165  0c7f				   .nes
    166  0c7f		       20 4d 32 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0c82		       a5 1b		      lda	nesqTail
    168  0c84		       c5 1a		      cmp	nesqHead
    169  0c86		       f0 37		      beq	.done
    170  0c88		       a5 1c		      lda	nesNext
    171  0c8a		       38		      sec
    172  0c8b		       e5 10		      sbc	ticks
    173  0c8d		       f0 04		      beq	.nesDue
    174  0c8f		       c9 02		      cmp	#NES_GAP+1
    175  0c91		       90 2c		      bcc	.done
    176  0c93				   .nesDue
    177  0c93		       20 d3 0c 	      jsr	WireFree
    178  0c96		       c9 03		      cmp	#3
    179  0c98		       90 25		      bcc	.done
    180  0c9a		       20 c0 0c 	      jsr	LinkRoom
    181  0c9d		       90 20		      bcc	.done
    182  0c9f		       a6 1b		      ldx	nesqTail
    183  0ca1		       bd c0 c1 	      lda	nesqS,x
    184  0ca4		       bc 40 c2 	      ldy	nesqD2,x
    185  0ca7		       84 2c		      sty	irqT
    186  0ca9		       bc 00 c2 	      ldy	nesqD1,x
    187  0cac		       20 dc 0c 	      jsr	WireMsg
    188  0caf		       a5 1b		      lda	nesqTail
    189  0cb1		       18		      clc
    190  0cb2		       69 01		      adc	#1
    191  0cb4		       29 3f		      and	#63
    192  0cb6		       85 1b		      sta	nesqTail
    193  0cb8		       a5 10		      lda	ticks
    194  0cba		       18		      clc
    195  0cbb		       69 01		      adc	#NES_GAP
    196  0cbd		       85 1c		      sta	nesNext
    197  0cbf				   .done
    198  0cbf		       60		      rts
