    212  3c03		       ca		      dex
    213  3c04		       10 ef		      bpl	.dup
    214  3c06							; the note it plays: + midiOct octaves, 0-127 or it's ignored
    215  3c06		       ad 07 c9 	      lda	midiOct
    216  3c09		       0a		      asl
    217  3c0a		       0a		      asl		; x 4
    218  3c0b		       85 24		      sta	t0
