------- FILE nesfx.asm LEVEL 2 PASS 3
      0  70b3					      include	"nesfx.asm"
      1  70b3							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  70b3							;
      3  70b3							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  70b3							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  70b3							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  70b3							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  70b3							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  70b3							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  70b3							;   glide    a new note starts bent back to the voice's last note and slides
     10  70b3							;	      in the way the SID's does (all three channels)
     11  70b3							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  70b3							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  70b3							; semitone, so these are a little stepped.
     14  70b3
     15  70b3		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  70b3							;  (the pulses, and the triangle while it glides)
     17  70b3
     18  70b3							; A = 1 (not Z) when a NesFxTick step is due
     19  70b3				   NesFxDue
     20  70b3					      subroutine
     21  70b3		       ad 27 c3 	      lda	devOn+DEV_NES
     22  70b6		       f0 19		      beq	.x
     23  70b8		       ad fe c5 	      lda	vibDepth
     24  70bb		       0d 2c c5 	      ora	nfxGlide
     25  70be		       0d 2d c5 	      ora	nfxRun
     26  70c1		       f0 0e		      beq	.x
     27  70c3		       a5 10		      lda	ticks
     28  70c5		       38		      sec
     29  70c6		       ed 28 c5 	      sbc	nfxLast
     30  70c9		       c9 08		      cmp	#NFX_EVERY
     31  70cb		       a9 00		      lda	#0
     32  70cd		       90 02		      bcc	.x
     33  70cf		       a9 01		      lda	#1
     34  70d1				   .x
     35  70d1		       60		      rts
     36  70d2
     37  70d2							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  70d2							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  70d2							; quick return.
