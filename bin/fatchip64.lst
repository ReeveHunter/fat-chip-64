     41  0a99		       28		      plp
     42  0a9a		       60		      rts
     43  0a9b
     44  0a9b							; IRQ: pace device queues onto the wire.
     45  0a9b							;
     46  0a9b							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
     47  0a9b							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
     48  0a9b							; times as signed numbers, so after 33 s of silence every queue froze for
     49  0a9b							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
     50  0a9b							;
     51  0a9b							; When the Game Boy is on, everything on the wire also passes through the
     52  0a9b							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
     53  0a9b							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
     54  0a9b							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
     55  0a9b							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
     56  0a9b							; message, the rate measured clean.
     57  0a9b				   Schedule
     58  0a9b					      subroutine
     59  0a9b		       ad 26 c3 	      lda	devOn+DEV_GB
     60  0a9e		       f0 10		      beq	.gb
     61  0aa0		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
     62  0aa2		       f0 0c		      beq	.gb
     63  0aa4		       c6 2e		      dec	linkLoad
     64  0aa6		       f0 08		      beq	.gb
     65  0aa8		       a5 10		      lda	ticks
     66  0aaa		       29 01		      and	#1
     67  0aac		       f0 02		      beq	.gb
     68  0aae		       c6 2e		      dec	linkLoad
     69  0ab0				   .gb
     70  0ab0							; ---- Game Boy
     71  0ab0		       a5 18		      lda	gbqTail
     72  0ab2		       c5 17		      cmp	gbqHead
     73  0ab4		       f0 36		      beq	.nes
     74  0ab6		       a5 19		      lda	gbNext
     75  0ab8		       38		      sec
     76  0ab9		       e5 10		      sbc	ticks
     77  0abb		       f0 04		      beq	.gbDue
     78  0abd		       c9 04		      cmp	#GB_GAP+1
     79  0abf		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
     80  0ac1				   .gbDue
     81  0ac1							; only onto an empty wire, so the gap holds on the cable itself (NES
     82  0ac1							; bytes already waiting would otherwise delay this one and squeeze it
     83  0ac1							; against the next). While a Game Boy message is due, the NES doesn't
     84  0ac1							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
     85  0ac1							; holding its notes back.
     86  0ac1		       a5 15		      lda	wireHead
     87  0ac3		       c5 16		      cmp	wireTail
     88  0ac5		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
     89  0ac7		       20 2d 0b 	      jsr	LinkRoom
     90  0aca		       90 20		      bcc	.nes
     91  0acc		       a6 18		      ldx	gbqTail
     92  0ace		       bd 00 c1 	      lda	gbqS,x
     93  0ad1		       bc 80 c1 	      ldy	gbqD2,x
     94  0ad4		       84 2c		      sty	irqT
     95  0ad6		       bc 40 c1 	      ldy	gbqD1,x
     96  0ad9		       20 49 0b 	      jsr	WireMsg
     97  0adc		       a5 18		      lda	gbqTail
     98  0ade		       18		      clc
     99  0adf		       69 01		      adc	#1
    100  0ae1		       29 3f		      and	#63
    101  0ae3		       85 18		      sta	gbqTail
    102  0ae5		       a5 10		      lda	ticks
    103  0ae7		       18		      clc
    104  0ae8		       69 03		      adc	#GB_GAP
    105  0aea		       85 19		      sta	gbNext
    106  0aec				   .nes
    107  0aec		       20 cb 26 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    108  0aef		       a5 1b		      lda	nesqTail
    109  0af1		       c5 1a		      cmp	nesqHead
    110  0af3		       f0 37		      beq	.done
    111  0af5		       a5 1c		      lda	nesNext
    112  0af7		       38		      sec
    113  0af8		       e5 10		      sbc	ticks
