     46  7da5		       0d 2d c5 	      ora	nfxGlide
     47  7da8		       0d 2e c5 	      ora	nfxRun
     48  7dab		       0d e3 c9 	      ora	nfxWarb
     49  7dae		       d0 01		      bne	.on
     50  7db0				   .q
     51  7db0		       60		      rts
     52  7db1				   .on
     53  7db1		       a5 10		      lda	ticks
     54  7db3		       38		      sec
     55  7db4		       ed 29 c5 	      sbc	nfxLast
     56  7db7		       c9 08		      cmp	#NFX_EVERY
     57  7db9		       b0 01		      bcs	.go
     58  7dbb		       60		      rts
     59  7dbc				   .go
