      0  0ef7					      include	"keys.asm"
      1  0ef7							; Fat Chip 64 - keyboard and RESTORE
      2  0ef7
      3  0ef7							; Scan the whole matrix, turn changes into key events.
      4  0ef7							;
      5  0ef7							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0ef7							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0ef7							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0ef7							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0ef7							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0ef7							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0ef7							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0ef7							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0ef7							; chords whose ghost lands on another used key lose their newest note.
     14  0ef7				   KeyScan
     15  0ef7					      subroutine
     16  0ef7		       a2 07		      ldx	#7
     17  0ef9				   .col
     18  0ef9		       bd 90 88 	      lda	colSelect,x
     19  0efc		       8d 00 dc 	      sta	CIA1_PRA
     20  0eff		       ad 01 dc 	      lda	CIA1_PRB
     21  0f02		       49 ff		      eor	#$FF
     22  0f04		       3d 48 c7 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0f07		       9d 40 c7 	      sta	keyNow,x
     24  0f0a		       ca		      dex
     25  0f0b		       10 ec		      bpl	.col
     26  0f0d		       a9 ff		      lda	#$FF
     27  0f0f		       8d 00 dc 	      sta	CIA1_PRA
     28  0f12							; ---- every column as accepted (nothing pressed or let go): done
     29  0f12		       a2 07		      ldx	#7
     30  0f14				   .same
     31  0f14		       bd 40 c7 	      lda	keyNow,x
     32  0f17		       dd 50 c7 	      cmp	keyAcc,x
     33  0f1a		       d0 04		      bne	.changed
     34  0f1c		       ca		      dex
     35  0f1d		       10 f5		      bpl	.same
     36  0f1f		       60		      rts
     37  0f20				   .changed
     38  0f20							; ---- releases first: accepted keys that are up now
     39  0f20		       a2 00		      ldx	#0
     40  0f22				   .rc
     41  0f22		       8e fc c7 	      stx	ksCol
     42  0f25		       bd 40 c7 	      lda	keyNow,x
     43  0f28		       49 ff		      eor	#$FF
     44  0f2a		       3d 50 c7 	      and	keyAcc,x
     45  0f2d		       8d fb c7 	      sta	ksBits
     46  0f30		       a9 00		      lda	#0
     47  0f32		       8d fd c7 	      sta	ksRow
     48  0f35				   .rb
     49  0f35		       ad fb c7 	      lda	ksBits
     50  0f38		       f0 21		      beq	.rcn
     51  0f3a		       4e fb c7 	      lsr	ksBits
     52  0f3d		       90 17		      bcc	.rbn
     53  0f3f		       ae fc c7 	      ldx	ksCol
     54  0f42		       ac fd c7 	      ldy	ksRow
     55  0f45		       b9 98 88 	      lda	rowBit,y
     56  0f48		       49 ff		      eor	#$FF
     57  0f4a		       3d 50 c7 	      and	keyAcc,x
     58  0f4d		       9d 50 c7 	      sta	keyAcc,x
     59  0f50		       20 f6 0f 	      jsr	KeyCode
     60  0f53		       20 64 19 	      jsr	KeyUp
     61  0f56				   .rbn
     62  0f56		       ee fd c7 	      inc	ksRow
     63  0f59		       d0 da		      bne	.rb
     64  0f5b				   .rcn
     65  0f5b		       ae fc c7 	      ldx	ksCol
     66  0f5e		       e8		      inx
     67  0f5f		       e0 08		      cpx	#8
     68  0f61		       d0 bf		      bne	.rc
     69  0f63							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0f63							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0f63							; still count as a combination.
     72  0f63		       a9 00		      lda	#0
     73  0f65		       8d ff c7 	      sta	ksPass
     74  0f68				   .pass
     75  0f68		       a2 00		      ldx	#0
     76  0f6a				   .pc
     77  0f6a		       8e fc c7 	      stx	ksCol
     78  0f6d		       bd 50 c7 	      lda	keyAcc,x
     79  0f70		       49 ff		      eor	#$FF
     80  0f72		       3d 40 c7 	      and	keyNow,x
     81  0f75		       8d fb c7 	      sta	ksBits
     82  0f78		       a9 00		      lda	#0
     83  0f7a		       8d fd c7 	      sta	ksRow
     84  0f7d				   .pb
     85  0f7d		       ad fb c7 	      lda	ksBits
     86  0f80		       f0 49		      beq	.pcn
     87  0f82		       4e fb c7 	      lsr	ksBits
     88  0f85		       90 3f		      bcc	.pbn
     89  0f87		       ad 00 c8 	      lda	ghostFilter
     90  0f8a		       d0 0c		      bne	.chk	; filter off (default): phantom notes play...
     91  0f8c		       20 f6 0f 	      jsr	KeyCode
     92  0f8f		       c9 18		      cmp	#24
     93  0f91		       90 0a		      bcc	.accept
     94  0f93		       20 df 0f 	      jsr	IsModifier
     95  0f96		       f0 05		      beq	.accept
     96  0f98				   .chk 		; ...but a command key never comes from a phantom
     97  0f98		       20 04 10 	      jsr	Suspect	;  (v0.40: Q + E held, then C=, read C= + S too)
     98  0f9b		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     99  0f9d				   .accept
    100  0f9d		       20 f6 0f 	      jsr	KeyCode
    101  0fa0		       20 df 0f 	      jsr	IsModifier	; Z set = modifier
    102  0fa3		       f0 07		      beq	.mod
    103  0fa5		       ad ff c7 	      lda	ksPass
