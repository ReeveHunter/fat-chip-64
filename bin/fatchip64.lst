      0  4c66					      include	"menu.asm"
      1  4c66							; Fat Chip 64 - the menu (v0.14): RETURN in, SHIFT+RETURN back out
      2  4c66							;
      3  4c66							; Three pages: the main one (SOUND, PLAYING), ADVANCED SOUND and DEVICE SYNC
      4  4c66							; (RETURN on their lines opens them, SHIFT+RETURN comes back).
      5  4c66							; CRSR DOWN / SHIFT+CRSR DOWN (up): choose a setting. CRSR RIGHT / SHIFT+CRSR
      6  4c66							; RIGHT: its next / previous value. Every other key works as usual (notes
      7  4c66							; play; V, F keys, = ... too: the values here follow).
      8  4c66							; The play screen pauses while the menu is up and redraws when it closes.
      9  4c66
