    540  e562				   ioEnd
    541  e562					      rend
    542  e562				  -	      if	ioEnd > $DE00
    543  e562				  -			; (Nmi reads the ACIA at $DE06: if one came while BeatLoad has the I/O
    544  e562				  -			;  switched out, it would read and write the RAM there: keep data below)
    545  e562				  -	      echo	"the $D000 data runs past $DE00"
    546  e562				  -	      err
    547  e562					      endif
