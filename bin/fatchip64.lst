     73  462e		       6d 83 c4 	      adc	drumTom
     74  4631		       4c 38 46 	      jmp	.k
     75  4634				   .lv
     76  4634		       18		      clc
     77  4635		       6d 81 c4 	      adc	drumLvl
     78  4638				   .k
