------- FILE main.asm
------- FILE arp.asm LEVEL 2 PASS 3
      0  2286					      include	"arp.asm"
      1  2286							; Fat Chip 64 - tempo and arpeggiator
      2  2286							;
      3  2286							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  2286							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  2286							;
      6  2286							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  2286							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  2286							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  2286							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  2286							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  2286							;	     until its voice's next turn.
     12  2286							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  2286							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  2286							;   J faster; either one also picks FREE).
     15  2286							;
     16  2286							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  2286							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  2286
     19  2286							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  2286							; between the two bytes: $22FF read as $23FF)
     21  2286				   GetTicks
     22  2286					      subroutine
     23  2286		       08		      php
     24  2287		       78		      sei
     25  2288		       a5 10		      lda	ticks
     26  228a		       8d 3f c3 	      sta	nowL
     27  228d		       a5 11		      lda	ticks+1
     28  228f		       8d 40 c3 	      sta	nowH
     29  2292		       28		      plp
     30  2293		       60		      rts
     31  2294
     32  2294							; ------------------------------------------------------------ tempo
     33  2294				   TapTempo
     34  2294					      subroutine
     35  2294		       20 b5 53 	      jsr	FollowActive	; the keytar's clock sets the tempo: taps do nothing
     36  2297		       f0 01		      beq	.tap
