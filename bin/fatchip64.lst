    492  3aef				   PatchReceived
    493  3aef					      subroutine
    494  3aef		       20 9d 3b 	      jsr	SoundRelease	; (the held notes end with the old patch)
    495  3af2		       a0 67		      ldy	#PATCH_SIZE-1
