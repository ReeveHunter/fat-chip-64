------- FILE voices.asm LEVEL 2 PASS 2
      0  104a					      include	"voices.asm"
      1  104a							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  104a							;
      3  104a							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  104a							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  104a							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  104a							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  104a							; Allocation, whenever the held notes change:
      8  104a							;   1. bass voices play the lowest note, an octave down
      9  104a							;   2. every other note gets one voice, lowest notes first
     10  104a							;   3. leftover voices stack on the lowest two notes, alternating
     11  104a							; So one note = a nine-voice unison across three chips, and in chords the
     12  104a							; bottom of the chord is fattest. Disabled devices get no notes.
     13  104a
     14  104a							; ------------------------------------------------------------ SID
     15  104a				   SidInit
     16  104a					      subroutine
     17  104a		       a2 18		      ldx	#24
     18  104c		       a9 00		      lda	#0
     19  104e				   .clr
