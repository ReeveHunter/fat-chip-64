     69  80bb							; ---- vibrato phase, the voices' delay counters, glides
     70  80bb		       ac 3b c5 	      ldy	nfxN
     71  80be				   .ph
     72  80be		       ad 41 c5 	      lda	nvPhL
     73  80c1		       18		      clc
