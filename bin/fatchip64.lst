      0  1ce7					      include	"arp.asm"
      1  1ce7							; Fat Chip 64 - tempo and arpeggiator
      2  1ce7							;
      3  1ce7							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1ce7							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1ce7							;
      6  1ce7							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1ce7							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1ce7							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1ce7							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1ce7							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1ce7							;	     until its voice's next turn.
     12  1ce7							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1ce7							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1ce7							;   J faster; either one also picks FREE).
     15  1ce7							;
     16  1ce7							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1ce7							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1ce7
     19  1ce7							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1ce7							; between the two bytes: $22FF read as $23FF)
     21  1ce7				   GetTicks
     22  1ce7					      subroutine
     23  1ce7		       08		      php
     24  1ce8		       78		      sei
     25  1ce9		       a5 10		      lda	ticks
     26  1ceb		       8d 3e c3 	      sta	nowL
     27  1cee		       a5 11		      lda	ticks+1
     28  1cf0		       8d 3f c3 	      sta	nowH
     29  1cf3		       28		      plp
     30  1cf4		       60		      rts
     31  1cf5
