     95  6c33		       ca		      dex
     96  6c34		       ca		      dex
     97  6c35		       ca		      dex
     98  6c36		       10 de		      bpl	.v
     99  6c38							; ---- the NES queue needs room
    100  6c38		       a5 1a		      lda	nesqHead
    101  6c3a		       38		      sec
    102  6c3b		       e5 1b		      sbc	nesqTail
    103  6c3d		       29 3f		      and	#63
    104  6c3f		       c9 08		      cmp	#Q_BACKLOG
    105  6c41		       b0 51		      bcs	.x
    106  6c43							; ---- the next NES voice: a bend if its effects moved
    107  6c43		       ad 2d c5 	      lda	nfxRun	; (a few rounds after an effects change)
    108  6c46		       f0 03		      beq	.r
    109  6c48		       ce 2d c5 	      dec	nfxRun
    110  6c4b				   .r
    111  6c4b		       ae 29 c5 	      ldx	nfxV	; (2, 5, 8)
    112  6c4e		       e8		      inx
