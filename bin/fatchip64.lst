    171  0ceb							; A = key code
    172  0ceb							;   overlay	    notes (K held + a note: set the key)
    173  0ceb							;   F1/F3/F5/F7    octave: C4 / C3 / C2 / C1 on the lowest key
    174  0ceb							;   SHIFT+F1/F3/F5 SID / Game Boy / MidiNES on-off	SHIFT+F7 panic
    175  0ceb							;   CTRL+F3/F5     Game Boy / MidiNES: next channel block
    176  0ceb							;   M		    mute everything	   SPACE  momentary (flips mute while held)
    177  0ceb							;   =		    latch: OFF -> SMART -> HOLD -> ADD -> OFF
    178  0ceb							;   N		    new chord: the next note starts one (twice: clear now)
    179  0ceb							;   Z / X	    notes mode (POLY, CHORD, EXT) / extensions (7 9 11 13)
    180  0ceb							;   K + note / L   key root / major-minor	  V  sound: FAT or PADS
    181  0ceb							;   A / S / D / F  arp mode / pattern / speed / SPARKLE octave
    182  0ceb							;   H / J	    free arp speed	      B  tap tempo
    183  0ceb							;   G		    phantom-key filter on / off (off at start; for testing)
    184  0ceb				   KeyDown
    185  0ceb					      subroutine
    186  0ceb		       c9 18		      cmp	#24
    187  0ced		       90 03		      bcc	.isNote
    188  0cef		       4c 84 0d 	      jmp	.cmd
