------- FILE nesfx.asm LEVEL 2 PASS 3
      0  85e8					      include	"nesfx.asm"
      1  85e8							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  85e8							;
      3  85e8							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  85e8							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  85e8							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  85e8							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  85e8							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  85e8							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  85e8							;   glide    a new note starts bent back to the voice's last note and slides
     10  85e8							;	      in the way the SID's does (all three channels)
     11  85e8							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  85e8							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  85e8							; semitone, so these are a little stepped.
     14  85e8
     15  85e8		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  85e8							;  (the pulses, and the triangle while it glides)
     17  85e8
     18  85e8							; A = 1 (not Z) when a NesFxTick step is due
     19  85e8				   NesFxDue
     20  85e8					      subroutine
     21  85e8		       ad eb c7 	      lda	devOn+DEV_NES
     22  85eb		       f0 1c		      beq	.x
     23  85ed		       ad cb ca 	      lda	vibDepth
     24  85f0		       0d f9 c9 	      ora	nfxGlide
     25  85f3		       0d fa c9 	      ora	nfxRun
     26  85f6		       0d b9 ce 	      ora	nfxWarb
     27  85f9		       f0 0e		      beq	.x
     28  85fb		       a5 10		      lda	ticks
     29  85fd		       38		      sec
     30  85fe		       ed f5 c9 	      sbc	nfxLast
     31  8601		       c9 08		      cmp	#NFX_EVERY
     32  8603		       a9 00		      lda	#0
     33  8605		       90 02		      bcc	.x
     34  8607		       a9 01		      lda	#1
     35  8609				   .x
     36  8609		       60		      rts
     37  860a
