    197 U001e		       00 00	   nmiTick    ds	2
    198 U0020		       00	   nmiSeen    ds	1
    199 U0021		       00	   mS	      ds	1	; message being queued: status, data 1, data 2
    200 U0022		       00	   mD1	      ds	1
    201 U0023		       00	   mD2	      ds	1
