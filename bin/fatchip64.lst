------- FILE arp.asm LEVEL 2 PASS 3
      0  1e08					      include	"arp.asm"
      1  1e08							; Fat Chip 64 - tempo and arpeggiator
      2  1e08							;
      3  1e08							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1e08							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1e08							;
      6  1e08							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1e08							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1e08							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1e08							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1e08							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1e08							;	     until its voice's next turn.
     12  1e08							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1e08							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1e08							;   J faster; either one also picks FREE).
     15  1e08							;
     16  1e08							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1e08							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1e08
     19  1e08							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1e08							; between the two bytes: $22FF read as $23FF)
     21  1e08				   GetTicks
     22  1e08					      subroutine
     23  1e08		       08		      php
     24  1e09		       78		      sei
     25  1e0a		       a5 10		      lda	ticks
     26  1e0c		       8d 3e c3 	      sta	nowL
     27  1e0f		       a5 11		      lda	ticks+1
     28  1e11		       8d 3f c3 	      sta	nowH
     29  1e14		       28		      plp
     30  1e15		       60		      rts
     31  1e16
