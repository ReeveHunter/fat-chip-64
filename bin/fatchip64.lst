     83  7deb		       a2 08		      ldx	#8	; (the NES voices: 2, 5, 8)
     84  7ded				   .v
     85  7ded		       bd d6 c4 	      lda	nesVT,x
     86  7df0		       18		      clc
     87  7df1		       6d 2f c5 	      adc	nfxN
     88  7df4		       90 02		      bcc	.vt
     89  7df6		       a9 ff		      lda	#255
     90  7df8				   .vt
     91  7df8		       9d d6 c4 	      sta	nesVT,x
     92  7dfb		       20 6f 7e 	      jsr	NesGlideStep
     93  7dfe		       bd c4 c4 	      lda	nesGlL,x
