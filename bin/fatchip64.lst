------- FILE main.asm LEVEL 1 PASS 3
      1  8c42 ????						; Fat Chip 64 - main program
      2  8c42 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  8c42 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  8c42 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  8c42 ????
      6  8c42 ????				      processor	6502
