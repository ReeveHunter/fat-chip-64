      0  618c					      include	"menu.asm"
      1  618c							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  618c							;
      3  618c							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  618c							;   page   RETURN opens a page
      5  618c							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  618c							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  618c							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  618c							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  618c							; device pages, until DEVICES says the device is in use).
     10  618c							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  618c							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  618c							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  618c
     14  618c		       00 17	   MENU_VALCOL equ	23
     15  618c
