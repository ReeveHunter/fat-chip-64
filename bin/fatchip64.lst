------- FILE main.asm
------- FILE menu.asm LEVEL 2 PASS 3
      0  51eb					      include	"menu.asm"
      1  51eb							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  51eb							;
      3  51eb							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  51eb							;   page   RETURN opens a page
      5  51eb							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  51eb							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  51eb							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  51eb							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  51eb							; device pages, until DEVICES says the device is in use).
     10  51eb							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  51eb							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  51eb							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  51eb
     14  51eb		       00 17	   MENU_VALCOL equ	23
     15  51eb
     16  51eb				   MenuOpen
     17  51eb		       20 05 6f 	      jsr	GlitchCalm	; (GLITCH may have the picture shaking)
     18  51ee		       a9 01		      lda	#1
     19  51f0		       8d 89 c4 	      sta	menuOn
     20  51f3		       a9 00		      lda	#0
     21  51f5		       8d 8a c4 	      sta	menuRow
     22  51f8							; page A on screen (the cursor stays on its line if it's on this page)
     23  51f8				   MenuPage
     24  51f8					      subroutine
     25  51f8		       8d 1b c6 	      sta	menuPage
     26  51fb		       aa		      tax
     27  51fc		       ad 8a c4 	      lda	menuRow
     28  51ff		       38		      sec
     29  5200		       fd ac 8c 	      sbc	pgFirst,x
     30  5203		       dd c3 8c 	      cmp	pgCount,x
     31  5206		       90 06		      bcc	.in
     32  5208		       bd ac 8c 	      lda	pgFirst,x
     33  520b		       8d 8a c4 	      sta	menuRow
     34  520e				   .in
     35  520e		       ae 8a c4 	      ldx	menuRow	; (a hidden line or text: the first one to choose)
     36  5211		       20 33 53 	      jsr	ItemShown
     37  5214		       f0 07		      beq	.f
     38  5216		       bd d1 84 	      lda	mKind,x
     39  5219		       c9 04		      cmp	#4
     40  521b		       d0 2b		      bne	.vis
