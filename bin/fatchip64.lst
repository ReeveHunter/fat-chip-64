      0  4567					      include	"menu.asm"
      1  4567							; Fat Chip 64 - the menu (v0.14): RETURN in, SHIFT+RETURN back out
      2  4567							;
      3  4567							; Three pages: the main one (SOUND, PLAYING), ADVANCED SOUND and DEVICE SYNC
      4  4567							; (RETURN on their lines opens them, SHIFT+RETURN comes back).
      5  4567							; CRSR DOWN / SHIFT+CRSR DOWN (up): choose a setting. CRSR RIGHT / SHIFT+CRSR
      6  4567							; RIGHT: its next / previous value. Every other key works as usual (notes
      7  4567							; play; V, F keys, = ... too: the values here follow).
      8  4567							; The play screen pauses while the menu is up and redraws when it closes.
      9  4567
     10  4567		       00 17	   MENU_VALCOL equ	23
     11  4567
