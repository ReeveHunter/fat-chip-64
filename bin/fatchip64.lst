------- FILE midiin.asm LEVEL 2 PASS 3
      0  38ca					      include	"midiin.asm"
      1  38ca							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  38ca							;
      3  38ca							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  38ca							; The main loop parses them (running status; realtime and system bytes are
      5  38ca							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  38ca							; notes mode, latch, arp and K + note.
      7  38ca							;
      8  38ca							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  38ca							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  38ca							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  38ca							;
     12  38ca							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  38ca							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  38ca							;
     15  38ca							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  38ca							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  38ca							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  38ca							; MIDI in is passed on to the Game Boy or NES.
     19  38ca
     20  38ca							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  38ca							; Uses A, X.
     22  38ca							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  38ca							; with the time; a Start ($FA) makes the next clock a beat.
     24  38ca				   RxByte
     25  38ca					      subroutine
     26  38ca		       ad 06 de 	      lda	ACIA_STAT
     27  38cd		       4a		      lsr		; RDRF -> carry
     28  38ce		       90 2b		      bcc	.x
     29  38d0				   RxGot
     30  38d0		       ad 07 de 	      lda	ACIA_RX
     31  38d3		       c9 f8		      cmp	#$F8
     32  38d5		       f0 25		      beq	.clk
     33  38d7		       c9 fa		      cmp	#$FA
     34  38d9		       d0 0e		      bne	.buf
     35  38db		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  38dd		       8e ed c5 	      stx	clkPhase
     37  38e0		       8e f5 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  38e3							;  the main loop could measure it)
     39  38e3		       ae ee c5 	      ldx	clkBeat
     40  38e6		       8e 00 c6 	      stx	clkStartBeat
     41  38e9				   .buf
     42  38e9		       ae 29 c4 	      ldx	rxHead
     43  38ec		       9d e9 c3 	      sta	rxBuf,x
     44  38ef		       e8		      inx
     45  38f0		       8a		      txa
     46  38f1		       29 3f		      and	#63
     47  38f3		       cd 2a c4 	      cmp	rxTail
     48  38f6		       f0 03		      beq	.x	; full: dropped
     49  38f8		       8d 29 c4 	      sta	rxHead
     50  38fb				   .x
     51  38fb		       60		      rts
     52  38fc				   .clk
     53  38fc		       ee e9 c5 	      inc	clkCount
     54  38ff		       ae ed c5 	      ldx	clkPhase
     55  3902		       e8		      inx
     56  3903		       e0 18		      cpx	#24
     57  3905		       90 1b		      bcc	.ph
     58  3907		       a5 10		      lda	ticks
     59  3909		       8d f0 c5 	      sta	clkAtL
     60  390c		       a5 11		      lda	ticks+1
     61  390e		       8d f1 c5 	      sta	clkAtH
     62  3911		       a5 2d		      lda	subTick
     63  3913		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  3915		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  3917		       ad 05 dc 	      lda	CIA1_TAHI
     66  391a				   .q
     67  391a		       8d f2 c5 	      sta	clkAtS
     68  391d		       ee ee c5 	      inc	clkBeat
     69  3920		       a2 00		      ldx	#0
     70  3922				   .ph
     71  3922		       8e ed c5 	      stx	clkPhase
     72  3925		       60		      rts
     73  3926
     74  3926							; Main loop, every pass: parse what came in.
