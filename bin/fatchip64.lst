      0  6b6c					      include	"screen.asm"
      1  6b6c							; Fat Chip 64 - screen
      2  6b6c							;
      3  6b6c							;  row 0      header
      4  6b6c							;  row 2      sound, POLY / MONO, Fat Bass
      5  6b6c							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  6b6c							;	       each plays (row 7: a channel overlap warning)
      7  6b6c							;  row 9      key, notes mode, latch
      8  6b6c							;  row 10     arp
      9  6b6c							;  row 12     tempo, beat, mute
     10  6b6c							;  row 13     SPACE's action, octave (the lowest key)
     11  6b6c							;  row 15     held notes
     12  6b6c							;  row 16     MIDI in
     13  6b6c							;  row 24     F keys
     14  6b6c
