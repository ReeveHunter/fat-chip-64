    228  0cdc							; Put a message on the wire (IRQ only): A = status, Y = data 1, irqT = data 2.
    229  0cdc							; Program change / channel pressure have one data byte.
    230  0cdc				   WireMsg
    231  0cdc					      subroutine
    232  0cdc		       c5 14		      cmp	lastStatus
    233  0cde		       f0 05		      beq	.rs
    234  0ce0		       85 14		      sta	lastStatus
    235  0ce2		       20 ff 0c 	      jsr	WirePut
    236  0ce5				   .rs
    237  0ce5		       98		      tya
    238  0ce6		       20 ff 0c 	      jsr	WirePut
    239  0ce9		       a5 14		      lda	lastStatus
    240  0ceb		       29 e0		      and	#$E0
    241  0ced		       c9 c0		      cmp	#$C0	; $Cx and $Dx: one data byte
    242  0cef		       f0 05		      beq	.done
    243  0cf1		       a5 2c		      lda	irqT
    244  0cf3		       20 ff 0c 	      jsr	WirePut
    245  0cf6				   .done
    246  0cf6		       ee 34 c3 	      inc	statSent
    247  0cf9		       d0 03		      bne	.x
    248  0cfb		       ee 35 c3 	      inc	statSent+1
    249  0cfe				   .x
    250  0cfe		       60		      rts
