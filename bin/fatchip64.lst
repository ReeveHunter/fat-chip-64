    391  3ada		       ae 21 c8 	      ldx	sxCmd
    392  3add		       e0 02		      cpx	#2
    393  3adf		       f0 0d		      beq	.dev
    394  3ae1		       ae 52 c7 	      ldx	sxPos
    395  3ae4		       e0 d5		      cpx	#SX_LEN
    396  3ae6		       d0 05		      bne	.x
    397  3ae8		       48		      pha
    398  3ae9		       20 7f 3b 	      jsr	PatchReceived
    399  3aec		       68		      pla
    400  3aed				   .x
