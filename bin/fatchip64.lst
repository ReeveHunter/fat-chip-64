      0  4083					      include	"drums.asm"
      1  4083							; Fat Chip 64 - drums on the MidiNES
      2  4083							;
      3  4083							; Two sources, one kit:
      4  4083							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  4083							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  4083							;			   64 = hit, 56 = ghost)
      7  4083							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  4083							;			   RETURN starts / stops it, at its own tempo (B taps
      9  4083							;			   a new one)
     10  4083							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  4083							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  4083							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  4083							; a note-on, then a note-off after the sound's length, the level set with
     14  4083							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  4083							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  4083
     17  4083		       00 0c	   KIT_SIZE   equ	12
     18  4083		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  4083		       00 00	   DK_KICK    equ	0
     20  4083		       00 01	   DK_SNARE   equ	1
     21  4083		       00 02	   DK_CH      equ	2
     22  4083		       00 03	   DK_OH      equ	3
     23  4083		       00 04	   DK_CY      equ	4
     24  4083		       00 05	   DK_TOM     equ	5
     25  4083		       00 06	   DK_PERC    equ	6
     26  4083
     27  4083							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  4083				   DrumHit
     29  4083					      subroutine
     30  4083		       8d 82 c4 	      sta	drumKind
     31  4086		       8e 81 c4 	      stx	drumLvl
     32  4089		       8c 83 c4 	      sty	drumTom
     33  408c		       c9 00		      cmp	#DK_KICK
     34  408e		       d0 05		      bne	.nk
     35  4090		       a9 01		      lda	#1
     36  4092		       8d 3f c6 	      sta	vizKick	; (the visualizer's border flash)
     37  4095				   .nk
     38  4095		       ad 27 c3 	      lda	devOn+DEV_NES
     39  4098		       d0 01		      bne	.on
     40  409a		       60		      rts
     41  409b				   .on
     42  409b		       20 e7 1c 	      jsr	GetTicks
     43  409e		       ad 82 c4 	      lda	drumKind
