    370  0ad4							; With the MIDI chip's interrupts (midiIrq, v0.16): the chip interrupts when
    371  0ad4							; a byte has come in or the next can go out; the CIA timer ticks each ms.
    372  0ad4				   IrqMidi
    373  0ad4					      subroutine
    374  0ad4		       48		      pha
    375  0ad5		       8a		      txa
    376  0ad6		       48		      pha
    377  0ad7		       ad 06 de 	      lda	ACIA_STAT
    378  0ada		       10 23		      bpl	.tim	; (not the MIDI chip)
    379  0adc		       4a		      lsr		; a byte in?
    380  0add		       90 03		      bcc	.tx
    381  0adf		       20 e0 2e 	      jsr	RxGot
    382  0ae2				   .tx
    383  0ae2		       ad 06 de 	      lda	ACIA_STAT
    384  0ae5		       29 02		      and	#ACIA_TDRE
    385  0ae7		       f0 16		      beq	.tim
    386  0ae9		       a6 16		      ldx	wireTail
    387  0aeb		       e4 15		      cpx	wireHead
    388  0aed		       f0 0b		      beq	.quiet
