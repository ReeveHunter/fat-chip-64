     47  737f		       d0 01		      bne	.on
     48  7381				   .q
     49  7381		       60		      rts
     50  7382				   .on
     51  7382		       a5 10		      lda	ticks
     52  7384		       38		      sec
     53  7385		       ed 28 c5 	      sbc	nfxLast
     54  7388		       c9 08		      cmp	#NFX_EVERY
     55  738a		       b0 01		      bcs	.go
     56  738c		       60		      rts
     57  738d				   .go
     58  738d		       4a		      lsr
     59  738e		       4a		      lsr		; 4 ms steps
     60  738f		       c9 08		      cmp	#8
