------- FILE repeat.asm LEVEL 2 PASS 3
      0  419d					      include	"repeat.asm"
      1  419d							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  419d							;
      3  419d							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  419d							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  419d							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  419d							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  419d							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  419d							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  419d							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  419d							; 3/4 of the time between echoes. The SID doesn't echo.
     11  419d							;
     12  419d							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  419d							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  419d							; or a keytar button).
     15  419d							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  419d							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  419d
     18  419d		       00 10	   RP_SLOTS   equ	16
     19  419d		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  419d
     21  419d							; REPEAT is on now?
     22  419d				   RepeatActive
     23  419d		       ad 4b c5 	      lda	repeatOn
     24  41a0		       0d ab c4 	      ora	actCnt+A_REPEAT
     25  41a3		       60		      rts
