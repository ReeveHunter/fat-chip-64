      0  7453					      include	"screen.asm"
      1  7453							; Fat Chip 64 - screen
      2  7453							;
      3  7453							;  row 0      header
      4  7453							;  row 2      sound, POLY / MONO, Fat Bass
      5  7453							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  7453							;	       each plays (row 7: a channel overlap warning)
      7  7453							;  row 9      key, notes mode, latch
      8  7453							;  row 10     arp
      9  7453							;  row 12     tempo, beat, mute
     10  7453							;  row 13     SPACE's action, octave (the lowest key), transpose
     11  7453							;  row 14     v0.40: the effect the C= keys work on, its setting
     12  7453							;  row 15     held notes
     13  7453							;  row 16     MIDI in
     14  7453							;  row 24     F keys
     15  7453
