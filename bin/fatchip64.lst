    111  1d8e		       8d c6 c3 	      sta	triOn
    112  1d91		       a5 25		      lda	t1	; bend back to centre for the next note
    113  1d93		       09 e0		      ora	#$E0
    114  1d95		       85 21		      sta	mS
    115  1d97		       a9 00		      lda	#0
    116  1d99		       85 22		      sta	mD1
    117  1d9b		       a9 40		      lda	#$40
    118  1d9d		       85 23		      sta	mD2
    119  1d9f		       4c 28 0b 	      jmp	NesPut
    120  1da2				   .x
