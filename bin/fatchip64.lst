     48  638f				   .q
     49  638f		       60		      rts
     50  6390				   .on
     51  6390		       a5 10		      lda	ticks
     52  6392		       38		      sec
     53  6393		       ed 25 c5 	      sbc	nfxLast
     54  6396		       c9 08		      cmp	#NFX_EVERY
     55  6398		       b0 01		      bcs	.go
     56  639a		       60		      rts
     57  639b				   .go
     58  639b		       4a		      lsr
     59  639c		       4a		      lsr		; 4 ms steps
     60  639d		       c9 08		      cmp	#8
     61  639f		       90 02		      bcc	.n
     62  63a1		       a9 08		      lda	#8
     63  63a3				   .n
