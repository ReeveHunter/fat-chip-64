------- FILE main.asm
------- FILE drums.asm LEVEL 2 PASS 3
      0  4caa					      include	"drums.asm"
      1  4caa							; Fat Chip 64 - drums on the MidiNES
      2  4caa							;
      3  4caa							; Two sources, one kit:
      4  4caa							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  4caa							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  4caa							;			   64 = hit, 56 = ghost)
      7  4caa							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  4caa							;			   RETURN starts / stops it, at its own tempo (B taps
      9  4caa							;			   a new one)
     10  4caa							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  4caa							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  4caa							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  4caa							; a note-on, then a note-off after the sound's length, the level set with
     14  4caa							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  4caa							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  4caa
     17  4caa		       00 0c	   KIT_SIZE   equ	12
     18  4caa		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  4caa		       00 00	   DK_KICK    equ	0
     20  4caa		       00 01	   DK_SNARE   equ	1
     21  4caa		       00 02	   DK_CH      equ	2
     22  4caa		       00 03	   DK_OH      equ	3
     23  4caa		       00 04	   DK_CY      equ	4
     24  4caa		       00 05	   DK_TOM     equ	5
     25  4caa		       00 06	   DK_PERC    equ	6
     26  4caa
     27  4caa							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  4caa				   DrumHit
     29  4caa					      subroutine
     30  4caa		       8d 83 c4 	      sta	drumKind
     31  4cad		       8e 82 c4 	      stx	drumLvl
     32  4cb0		       8c 84 c4 	      sty	drumTom
     33  4cb3		       c9 00		      cmp	#DK_KICK
     34  4cb5		       d0 05		      bne	.nk
     35  4cb7		       a9 01		      lda	#1
     36  4cb9		       8d 40 c6 	      sta	vizKick	; (the visualizer's border flash)
     37  4cbc				   .nk
     38  4cbc		       ad 27 c3 	      lda	devOn+DEV_NES
     39  4cbf		       d0 01		      bne	.on
     40  4cc1		       60		      rts
     41  4cc2				   .on
     42  4cc2		       20 09 23 	      jsr	GetTicks
     43  4cc5		       ad 83 c4 	      lda	drumKind
     44  4cc8		       c9 02		      cmp	#DK_CH
     45  4cca		       90 07		      bcc	.dmc
     46  4ccc		       c9 05		      cmp	#DK_TOM
     47  4cce		       b0 03		      bcs	.dmc
     48  4cd0		       4c 85 4d 	      jmp	NoiseHit
     49  4cd3				   .dmc
     50  4cd3		       ae 83 c4 	      ldx	drumKind
     51  4cd6		       bd 6c 4d 	      lda	dmcPrioT,x
     52  4cd9		       85 24		      sta	t0
     53  4cdb		       ad 3f c3 	      lda	nowL
     54  4cde		       38		      sec
     55  4cdf		       ed 7a c4 	      sbc	dmcAt
     56  4ce2		       a8		      tay
     57  4ce3		       ad 40 c3 	      lda	nowH
     58  4ce6		       ed 7b c4 	      sbc	dmcAt+1
     59  4ce9		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  4ceb		       c0 0c		      cpy	#DRUM_WINDOW
     61  4ced		       b0 08		      bcs	.ok
     62  4cef		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     63  4cf1		       cd 79 c4 	      cmp	dmcPrio
     64  4cf4		       90 01		      bcc	.ok
     65  4cf6		       60		      rts
     66  4cf7				   .ok
     67  4cf7							; the sample: kit[beat][kitOfs[kind] + level, or + tom]
     68  4cf7		       ae 83 c4 	      ldx	drumKind
     69  4cfa		       bd 73 4d 	      lda	kitOfs,x
     70  4cfd		       e0 05		      cpx	#DK_TOM
     71  4cff		       d0 07		      bne	.lv
     72  4d01		       18		      clc
     73  4d02		       6d 84 c4 	      adc	drumTom
     74  4d05		       4c 0c 4d 	      jmp	.k
     75  4d08				   .lv
     76  4d08		       18		      clc
     77  4d09		       6d 82 c4 	      adc	drumLvl
     78  4d0c				   .k
     79  4d0c		       85 25		      sta	t1
     80  4d0e		       ad 6e c4 	      lda	beatSel	; x 12
     81  4d11		       0a		      asl
     82  4d12		       0a		      asl
     83  4d13		       85 26		      sta	t2
     84  4d15		       0a		      asl
     85  4d16		       65 26		      adc	t2
     86  4d18		       65 25		      adc	t1
     87  4d1a		       aa		      tax
     88  4d1b		       bd cb a6 	      lda	kits,x
     89  4d1e		       85 25		      sta	t1
     90  4d20							; bank (CC14 on the sample channel) when it changes
     91  4d20		       a9 04		      lda	#4
     92  4d22		       20 7a 4d 	      jsr	NesChStatus	; mS = CC, sample channel
     93  4d25		       a9 00		      lda	#0
     94  4d27		       a6 25		      ldx	t1
     95  4d29		       10 02		      bpl	.a
     96  4d2b		       a9 7f		      lda	#127
     97  4d2d				   .a
     98  4d2d		       cd 78 c4 	      cmp	dmcBank
     99  4d30		       f0 0c		      beq	.note
    100  4d32		       8d 78 c4 	      sta	dmcBank
    101  4d35		       85 23		      sta	mD2
    102  4d37		       a9 0e		      lda	#14
    103  4d39		       85 22		      sta	mD1
    104  4d3b		       20 37 0d 	      jsr	NesPut
    105  4d3e				   .note
    106  4d3e		       a5 21		      lda	mS
    107  4d40		       29 0f		      and	#$0F
    108  4d42		       85 26		      sta	t2	; channel
    109  4d44		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    110  4d46							;  cuts it anyway, and the hit lands 1 ms sooner)
    111  4d46		       29 7f		      and	#$7F
    112  4d48		       8d 85 c4 	      sta	dmcNote
    113  4d4b		       85 22		      sta	mD1
    114  4d4d		       a5 26		      lda	t2
    115  4d4f		       09 90		      ora	#$90
    116  4d51		       85 21		      sta	mS
    117  4d53		       a9 7f		      lda	#127
