------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  434c					      include	"sync.asm"
      1  434c							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  434c							;
      3  434c							; Menu, DEVICE SYNC (defaults first):
      4  434c							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  434c							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  434c							;		     sets the tempo, averaged over beats (the clock jitters about
      7  434c							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  434c							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  434c							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  434c							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  434c							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  434c							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  434c							;		     picks a beat demo (styleBeat)
     14  434c							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  434c							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  434c							;		     key channel) picks a sound (voiceSound)
     17  434c							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  434c							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  434c							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  434c							;
     21  434c							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  434c							; 1/4 ms); a Start makes the next clock a beat.
     23  434c
     24  434c		       00 00	   TEMPO_KEYTAR equ	0
     25  434c		       00 01	   TEMPO_OWN  equ	1
     26  434c		       00 02	   TEMPO_SC   equ	2
     27  434c		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  434c
     29  434c
     30  434c
     31  434c							; ------------------------------------------------------------ clock
