     95  6d80		       ca		      dex
     96  6d81		       ca		      dex
     97  6d82		       ca		      dex
     98  6d83		       10 de		      bpl	.v
     99  6d85							; ---- the NES queue needs room
    100  6d85		       a5 1a		      lda	nesqHead
    101  6d87		       38		      sec
    102  6d88		       e5 1b		      sbc	nesqTail
    103  6d8a		       29 3f		      and	#63
    104  6d8c		       c9 08		      cmp	#Q_BACKLOG
    105  6d8e		       b0 51		      bcs	.x
    106  6d90							; ---- the next NES voice: a bend if its effects moved
    107  6d90		       ad 2d c5 	      lda	nfxRun	; (a few rounds after an effects change)
    108  6d93		       f0 03		      beq	.r
    109  6d95		       ce 2d c5 	      dec	nfxRun
    110  6d98				   .r
    111  6d98		       ae 29 c5 	      ldx	nfxV	; (2, 5, 8)
    112  6d9b		       e8		      inx
    113  6d9c		       e8		      inx
