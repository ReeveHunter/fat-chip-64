      0  0bae					      include	"midi.asm"
      1  0bae							; Fat Chip 64 - MIDI out
      2  0bae							;
      3  0bae							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0bae							; at most one message per device onto the wire buffer, no sooner than that
      5  0bae							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0bae							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0bae							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0bae							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0bae							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0bae
     11  0bae				   MidiInit
     12  0bae					      subroutine
     13  0bae		       a9 03		      lda	#ACIA_RESET
     14  0bb0		       8d 04 de 	      sta	ACIA_CTRL
     15  0bb3		       a9 16		      lda	#ACIA_MODE
     16  0bb5		       8d 04 de 	      sta	ACIA_CTRL
     17  0bb8							; (fall into the test)
     18  0bb8
     19  0bb8							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0bb8							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0bb8							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0bb8							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0bb8							; before. Interrupts are off when this is called.
     24  0bb8				   MidiIrqTest
     25  0bb8					      subroutine
     26  0bb8		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0bba		       8d 0d dc 	      sta	CIA1_ICR
     28  0bbd		       ad 0d dc 	      lda	CIA1_ICR
     29  0bc0		       a9 08		      lda	#<IrqTest
     30  0bc2		       8d fe ff 	      sta	$FFFE
     31  0bc5		       a9 0c		      lda	#>IrqTest
     32  0bc7		       8d ff ff 	      sta	$FFFF
     33  0bca		       a9 00		      lda	#0
     34  0bcc		       85 2f		      sta	midiIrq
     35  0bce		       a9 b6		      lda	#ACIA_MODE_TX
     36  0bd0		       8d 04 de 	      sta	ACIA_CTRL
     37  0bd3		       58		      cli
     38  0bd4		       a2 00		      ldx	#0
     39  0bd6				   .w
     40  0bd6		       ca		      dex
     41  0bd7		       d0 fd		      bne	.w
     42  0bd9		       78		      sei
     43  0bda		       a6 2f		      ldx	midiIrq
     44  0bdc		       bd 14 0c 	      lda	midiCtl,x
     45  0bdf		       8d 04 de 	      sta	ACIA_CTRL
     46  0be2		       bd 16 0c 	      lda	irqLo,x
     47  0be5		       8d fe ff 	      sta	$FFFE
     48  0be8		       bd 18 0c 	      lda	irqHi,x
     49  0beb		       8d ff ff 	      sta	$FFFF
     50  0bee		       bd 1a 0c 	      lda	latchLo,x
     51  0bf1		       8d 04 dc 	      sta	CIA1_TALO
     52  0bf4		       bd 1c 0c 	      lda	latchHi,x
     53  0bf7		       8d 05 dc 	      sta	CIA1_TAHI
     54  0bfa		       a9 11		      lda	#$11	; start, force load, continuous
     55  0bfc		       8d 0e dc 	      sta	CIA1_CRA
