------- FILE lead.asm LEVEL 2 PASS 3
      0  63ce					      include	"lead.asm"
      1  63ce							; Fat Chip 64 - CHORD + LEAD (v0.28): a chord and a lead at once, each its
      2  63ce							; own patch.
      3  63ce							;   LOW NOTE  the first key pressed is the chord's root (POLY: just it;
      4  63ce							;	       SMART CHORD: its 5TH, TRIAD...; DRONE: the drone); every other
      5  63ce							;	       key is the lead, while the chord key is held
      6  63ce							;   LATCH 3   three keys pressed together latch as the chord (let go, it
      7  63ce							;	       keeps sounding); everything else is the lead. L clears it.
      8  63ce							; The lead is one note (the last key pressed) on one voice per chip (SID 3,
      9  63ce							; Game Boy pulse 1, NES pulse 1), only while it plays: the rest of the time
     10  63ce							; those voices are the chord's. Its patch: SHIFT + A S D F G / Z X C V B.
     11  63ce							; The lead's own: the SID's waveform, width, envelope and octave, the Game
     12  63ce							; Boy pulse's CCs, the NES pulse's duty. Shared with the chord: the effects
     13  63ce							; (vibrato, filter, tremolo...), the NES envelope.
     14  63ce
     15  63ce		       00 06	   LEAD_SID   equ	6	; the lead's voices: SID 3, GB pulse 1, NES pulse 1
     16  63ce		       00 01	   LEAD_GB    equ	1
     17  63ce		       00 02	   LEAD_NES   equ	2
     18  63ce
     19  63ce							; NoteDown, CHORD + LEAD on: key X pressed. Carry set: it's the lead (the
     20  63ce							; latch styles leave it alone).
