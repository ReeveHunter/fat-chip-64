    433  3678		       48		      pha
    434  3679		       8a		      txa
    435  367a		       38		      sec
    436  367b		       e9 05		      sbc	#SX_HEAD
    437  367d		       4a		      lsr
    438  367e		       a8		      tay		; byte number
    439  367f		       68		      pla
    440  3680		       29 0f		      and	#15
    441  3682		       b0 0b		      bcs	.lo
    442  3684		       0a		      asl
    443  3685		       0a		      asl
    444  3686		       0a		      asl
    445  3687		       0a		      asl
