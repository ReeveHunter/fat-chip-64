      0  5448					      include	"patchedit.asm"
      1  5448							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  5448							; the dice. The settings and their steps come from tools/gen_menu.py
      3  5448							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  5448							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  5448							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  5448							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  5448							; (EnvDerive).
      8  5448
      9  5448		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  5448		       00 30	   LFO_LAST   equ	FLD_gbLDelay
