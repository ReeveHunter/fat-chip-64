    368  3602		       c9 f0		      cmp	#$F0
    369  3604		       d0 0e		      bne	.end
    370  3606		       a2 01		      ldx	#1
    371  3608		       8e 4c c7 	      stx	sxOn
    372  360b		       8e 1c c8 	      stx	sxCmd
    373  360e		       a2 00		      ldx	#0
    374  3610		       8e 4d c7 	      stx	sxPos
    375  3613		       60		      rts
    376  3614				   .end
    377  3614		       ae 4c c7 	      ldx	sxOn
    378  3617		       f0 1c		      beq	.x
    379  3619		       a2 00		      ldx	#0
    380  361b		       8e 4c c7 	      stx	sxOn
    381  361e		       c9 f7		      cmp	#$F7
    382  3620		       d0 13		      bne	.x
    383  3622		       ae 1c c8 	      ldx	sxCmd
    384  3625		       e0 02		      cpx	#2
    385  3627		       f0 0d		      beq	.dev
    386  3629		       ae 4d c7 	      ldx	sxPos
    387  362c		       e0 cf		      cpx	#SX_LEN
    388  362e		       d0 05		      bne	.x
    389  3630		       48		      pha
    390  3631		       20 c7 36 	      jsr	PatchReceived
    391  3634		       68		      pla
    392  3635				   .x
    393  3635		       60		      rts
    394  3636				   .dev
    395  3636		       ae 4d c7 	      ldx	sxPos
    396  3639		       e0 05		      cpx	#5
    397  363b		       d0 f8		      bne	.x
