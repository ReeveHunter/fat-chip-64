    103  0bac							; IRQ: pace device queues onto the wire.
    104  0bac							;
    105  0bac							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0bac							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0bac							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0bac							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0bac							;
    110  0bac							; When the Game Boy is on, everything on the wire also passes through the
    111  0bac							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0bac							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0bac							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0bac							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0bac							; message, the rate measured clean.
    116  0bac				   Schedule
    117  0bac					      subroutine
    118  0bac		       ad 26 c3 	      lda	devOn+DEV_GB
    119  0baf		       f0 10		      beq	.gb
    120  0bb1		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0bb3		       f0 0c		      beq	.gb
    122  0bb5		       c6 2e		      dec	linkLoad
    123  0bb7		       f0 08		      beq	.gb
    124  0bb9		       a5 10		      lda	ticks
    125  0bbb		       29 01		      and	#1
    126  0bbd		       f0 02		      beq	.gb
    127  0bbf		       c6 2e		      dec	linkLoad
    128  0bc1				   .gb
    129  0bc1							; ---- Game Boy
    130  0bc1		       a5 18		      lda	gbqTail
    131  0bc3		       c5 17		      cmp	gbqHead
    132  0bc5		       f0 36		      beq	.nes
    133  0bc7		       a5 19		      lda	gbNext
    134  0bc9		       38		      sec
    135  0bca		       e5 10		      sbc	ticks
    136  0bcc		       f0 04		      beq	.gbDue
    137  0bce		       c9 04		      cmp	#GB_GAP+1
    138  0bd0		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0bd2				   .gbDue
    140  0bd2							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0bd2							; bytes already waiting would otherwise delay this one and squeeze it
    142  0bd2							; against the next). While a Game Boy message is due, the NES doesn't
    143  0bd2							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0bd2							; holding its notes back.
    145  0bd2		       a5 15		      lda	wireHead
    146  0bd4		       c5 16		      cmp	wireTail
    147  0bd6		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0bd8		       20 3e 0c 	      jsr	LinkRoom
    149  0bdb		       90 20		      bcc	.nes
    150  0bdd		       a6 18		      ldx	gbqTail
    151  0bdf		       bd 00 c1 	      lda	gbqS,x
    152  0be2		       bc 80 c1 	      ldy	gbqD2,x
    153  0be5		       84 2c		      sty	irqT
    154  0be7		       bc 40 c1 	      ldy	gbqD1,x
    155  0bea		       20 5a 0c 	      jsr	WireMsg
    156  0bed		       a5 18		      lda	gbqTail
    157  0bef		       18		      clc
    158  0bf0		       69 01		      adc	#1
    159  0bf2		       29 3f		      and	#63
    160  0bf4		       85 18		      sta	gbqTail
    161  0bf6		       a5 10		      lda	ticks
    162  0bf8		       18		      clc
    163  0bf9		       69 03		      adc	#GB_GAP
    164  0bfb		       85 19		      sta	gbNext
    165  0bfd				   .nes
    166  0bfd		       20 1f 2c 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0c00		       a5 1b		      lda	nesqTail
    168  0c02		       c5 1a		      cmp	nesqHead
    169  0c04		       f0 37		      beq	.done
    170  0c06		       a5 1c		      lda	nesNext
    171  0c08		       38		      sec
    172  0c09		       e5 10		      sbc	ticks
    173  0c0b		       f0 04		      beq	.nesDue
    174  0c0d		       c9 02		      cmp	#NES_GAP+1
    175  0c0f		       90 2c		      bcc	.done
    176  0c11				   .nesDue
    177  0c11		       20 51 0c 	      jsr	WireFree
    178  0c14		       c9 03		      cmp	#3
    179  0c16		       90 25		      bcc	.done
    180  0c18		       20 3e 0c 	      jsr	LinkRoom
    181  0c1b		       90 20		      bcc	.done
    182  0c1d		       a6 1b		      ldx	nesqTail
    183  0c1f		       bd c0 c1 	      lda	nesqS,x
    184  0c22		       bc 40 c2 	      ldy	nesqD2,x
    185  0c25		       84 2c		      sty	irqT
    186  0c27		       bc 00 c2 	      ldy	nesqD1,x
    187  0c2a		       20 5a 0c 	      jsr	WireMsg
    188  0c2d		       a5 1b		      lda	nesqTail
    189  0c2f		       18		      clc
    190  0c30		       69 01		      adc	#1
    191  0c32		       29 3f		      and	#63
    192  0c34		       85 1b		      sta	nesqTail
    193  0c36		       a5 10		      lda	ticks
    194  0c38		       18		      clc
    195  0c39		       69 01		      adc	#NES_GAP
    196  0c3b		       85 1c		      sta	nesNext
    197  0c3d				   .done
