    219  0a8a				   NesPut
    220  0a8a					      subroutine
    221  0a8a							; write the slot at head first (always free: one slot stays empty),
    222  0a8a							; then publish head unless the queue is full. Uses only A and X.
    223  0a8a		       a6 19		      ldx	nesqHead
    224  0a8c		       a5 20		      lda	mS
    225  0a8e		       9d c0 c1 	      sta	nesqS,x
    226  0a91		       a5 21		      lda	mD1
    227  0a93		       9d 00 c2 	      sta	nesqD1,x
    228  0a96		       a5 22		      lda	mD2
    229  0a98		       9d 40 c2 	      sta	nesqD2,x
    230  0a9b		       8a		      txa
