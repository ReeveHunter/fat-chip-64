      0  0ec5					      include	"keys.asm"
      1  0ec5							; Fat Chip 64 - keyboard and RESTORE
      2  0ec5
      3  0ec5							; Scan the whole matrix, turn changes into key events.
      4  0ec5							;
      5  0ec5							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0ec5							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0ec5							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0ec5							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0ec5							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0ec5							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0ec5							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0ec5							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0ec5							; chords whose ghost lands on another used key lose their newest note.
     14  0ec5				   KeyScan
     15  0ec5					      subroutine
     16  0ec5		       a2 07		      ldx	#7
     17  0ec7				   .col
     18  0ec7		       bd 0b 7e 	      lda	colSelect,x
     19  0eca		       8d 00 dc 	      sta	CIA1_PRA
     20  0ecd		       ad 01 dc 	      lda	CIA1_PRB
     21  0ed0		       49 ff		      eor	#$FF
     22  0ed2		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0ed5		       9d 80 c2 	      sta	keyNow,x
     24  0ed8		       ca		      dex
     25  0ed9		       10 ec		      bpl	.col
     26  0edb		       a9 ff		      lda	#$FF
     27  0edd		       8d 00 dc 	      sta	CIA1_PRA
     28  0ee0							; ---- every column as accepted (nothing pressed or let go): done
     29  0ee0		       a2 07		      ldx	#7
     30  0ee2				   .same
     31  0ee2		       bd 80 c2 	      lda	keyNow,x
     32  0ee5		       dd 90 c2 	      cmp	keyAcc,x
     33  0ee8		       d0 04		      bne	.changed
     34  0eea		       ca		      dex
     35  0eeb		       10 f5		      bpl	.same
     36  0eed		       60		      rts
     37  0eee				   .changed
     38  0eee							; ---- releases first: accepted keys that are up now
     39  0eee		       a2 00		      ldx	#0
     40  0ef0				   .rc
     41  0ef0		       8e 38 c3 	      stx	ksCol
     42  0ef3		       bd 80 c2 	      lda	keyNow,x
     43  0ef6		       49 ff		      eor	#$FF
     44  0ef8		       3d 90 c2 	      and	keyAcc,x
     45  0efb		       8d 37 c3 	      sta	ksBits
     46  0efe		       a9 00		      lda	#0
     47  0f00		       8d 39 c3 	      sta	ksRow
     48  0f03				   .rb
     49  0f03		       ad 37 c3 	      lda	ksBits
     50  0f06		       f0 21		      beq	.rcn
     51  0f08		       4e 37 c3 	      lsr	ksBits
     52  0f0b		       90 17		      bcc	.rbn
     53  0f0d		       ae 38 c3 	      ldx	ksCol
     54  0f10		       ac 39 c3 	      ldy	ksRow
     55  0f13		       b9 13 7e 	      lda	rowBit,y
     56  0f16		       49 ff		      eor	#$FF
     57  0f18		       3d 90 c2 	      and	keyAcc,x
     58  0f1b		       9d 90 c2 	      sta	keyAcc,x
     59  0f1e		       20 c4 0f 	      jsr	KeyCode
     60  0f21		       20 59 18 	      jsr	KeyUp
     61  0f24				   .rbn
     62  0f24		       ee 39 c3 	      inc	ksRow
     63  0f27		       d0 da		      bne	.rb
     64  0f29				   .rcn
     65  0f29		       ae 38 c3 	      ldx	ksCol
     66  0f2c		       e8		      inx
     67  0f2d		       e0 08		      cpx	#8
     68  0f2f		       d0 bf		      bne	.rc
     69  0f31							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0f31							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0f31							; still count as a combination.
     72  0f31		       a9 00		      lda	#0
     73  0f33		       8d 3b c3 	      sta	ksPass
     74  0f36				   .pass
     75  0f36		       a2 00		      ldx	#0
     76  0f38				   .pc
     77  0f38		       8e 38 c3 	      stx	ksCol
     78  0f3b		       bd 90 c2 	      lda	keyAcc,x
     79  0f3e		       49 ff		      eor	#$FF
     80  0f40		       3d 80 c2 	      and	keyNow,x
     81  0f43		       8d 37 c3 	      sta	ksBits
     82  0f46		       a9 00		      lda	#0
     83  0f48		       8d 39 c3 	      sta	ksRow
     84  0f4b				   .pb
     85  0f4b		       ad 37 c3 	      lda	ksBits
     86  0f4e		       f0 49		      beq	.pcn
     87  0f50		       4e 37 c3 	      lsr	ksBits
     88  0f53		       90 3f		      bcc	.pbn
     89  0f55		       ad 3c c3 	      lda	ghostFilter
     90  0f58		       d0 0c		      bne	.chk	; filter off (default): phantom notes play...
     91  0f5a		       20 c4 0f 	      jsr	KeyCode
     92  0f5d		       c9 18		      cmp	#24
     93  0f5f		       90 0a		      bcc	.accept
     94  0f61		       20 ad 0f 	      jsr	IsModifier
     95  0f64		       f0 05		      beq	.accept
     96  0f66				   .chk 		; ...but a command key never comes from a phantom
     97  0f66		       20 d2 0f 	      jsr	Suspect	;  (v0.40: Q + E held, then C=, read C= + S too)
     98  0f69		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     99  0f6b				   .accept
    100  0f6b		       20 c4 0f 	      jsr	KeyCode
    101  0f6e		       20 ad 0f 	      jsr	IsModifier	; Z set = modifier
    102  0f71		       f0 07		      beq	.mod
    103  0f73		       ad 3b c3 	      lda	ksPass
    104  0f76		       f0 1c		      beq	.pbn	; pass 0: modifiers only
    105  0f78		       d0 05		      bne	.take
    106  0f7a				   .mod
    107  0f7a		       ad 3b c3 	      lda	ksPass
    108  0f7d		       d0 15		      bne	.pbn	; (taken in pass 0)
    109  0f7f				   .take
    110  0f7f		       ae 38 c3 	      ldx	ksCol
    111  0f82		       ac 39 c3 	      ldy	ksRow
    112  0f85		       b9 13 7e 	      lda	rowBit,y
    113  0f88		       1d 90 c2 	      ora	keyAcc,x
    114  0f8b		       9d 90 c2 	      sta	keyAcc,x
    115  0f8e		       20 c4 0f 	      jsr	KeyCode
    116  0f91		       20 03 10 	      jsr	KeyDown
    117  0f94				   .pbn
    118  0f94		       ee 39 c3 	      inc	ksRow
    119  0f97		       d0 b2		      bne	.pb
    120  0f99				   .pcn
    121  0f99		       ae 38 c3 	      ldx	ksCol
    122  0f9c		       e8		      inx
    123  0f9d		       e0 08		      cpx	#8
    124  0f9f		       d0 97		      bne	.pc
    125  0fa1		       ad 3b c3 	      lda	ksPass
    126  0fa4		       d0 06		      bne	.done
    127  0fa6		       ee 3b c3 	      inc	ksPass
    128  0fa9		       4c 36 0f 	      jmp	.pass
    129  0fac				   .done
    130  0fac		       60		      rts
    131  0fad
    132  0fad							; Z set if key code A is a modifier. Keeps A.
    133  0fad				   IsModifier
    134  0fad		       c9 88		      cmp	#K_LSHIFT
    135  0faf		       f0 12		      beq	.y
    136  0fb1		       c9 89		      cmp	#K_RSHIFT
    137  0fb3		       f0 0e		      beq	.y
    138  0fb5		       c9 8c		      cmp	#K_CTRL
    139  0fb7		       f0 0a		      beq	.y
    140  0fb9		       c9 a2		      cmp	#K_CBM
    141  0fbb		       f0 06		      beq	.y
    142  0fbd		       c9 a3		      cmp	#K_STOP
    143  0fbf		       f0 02		      beq	.y
    144  0fc1		       c9 9a		      cmp	#K_K
    145  0fc3				   .y
    146  0fc3		       60		      rts
