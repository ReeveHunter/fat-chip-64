      0  4c0b					      include	"menu.asm"
      1  4c0b							; Fat Chip 64 - the menu (v0.14): RETURN in, SHIFT+RETURN back out
      2  4c0b							;
      3  4c0b							; Three pages: the main one (SOUND, PLAYING), ADVANCED SOUND and DEVICE SYNC
      4  4c0b							; (RETURN on their lines opens them, SHIFT+RETURN comes back).
      5  4c0b							; CRSR DOWN / SHIFT+CRSR DOWN (up): choose a setting. CRSR RIGHT / SHIFT+CRSR
      6  4c0b							; RIGHT: its next / previous value. Every other key works as usual (notes
      7  4c0b							; play; V, F keys, = ... too: the values here follow).
      8  4c0b							; The play screen pauses while the menu is up and redraws when it closes.
