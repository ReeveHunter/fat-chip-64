    370  3850							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    371  3850							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    372  3850							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    373  3850							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    374  3850		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    375  3854		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    376  385b		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    377  3862		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    378  3867		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    379  386b		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    380  386f		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
    381  3874		       05 0a 0f 14*uTremRH    .byte.b	>1311, >2621, >3932, >5243, >6554
