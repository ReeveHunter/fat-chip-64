------- FILE main.asm
------- FILE devices.asm LEVEL 2 PASS 3
      0  5cff					      include	"devices.asm"
      1  5cff							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  5cff							; are in use, and each one in use gets its page on the main menu.
      3  5cff							;
      4  5cff							; YAMAHA SHS-10 (the keytar)
      5  5cff							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  5cff							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  5cff							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  5cff							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  5cff							;		     can play at once.)
     10  5cff							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  5cff							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  5cff							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  5cff							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  5cff							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  5cff							;		     louder (the SID and the NES; the Game Boy would click) or
     16  5cff							;		     brighter (the SID's filter: switched on if the patch has
     17  5cff							;		     none)
     18  5cff							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  5cff							;		     the patch's, or the ADVANCED amounts if it has none;
     20  5cff							;		     FILTER), or an action held while blowing hard
     21  5cff							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  5cff							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  5cff							;   PORTAMENTO BUTTON	an action (CC 65)
     24  5cff							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  5cff							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  5cff							; ATARI SYNTHCART
     27  5cff							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  5cff							;		     about 3% while held, SHIFT + , . step through the ten
     29  5cff							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  5cff							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  5cff							;		     sound's cents (the Synthcart manual's table: each Atari
     32  5cff							;		     sound plays its scales in its own key, a little off)
     33  5cff							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  5cff
     35  5cff		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  5cff		       00 28	   BREATH_LO  equ	40
     37  5cff		       00 01	   BFX_VIB    equ	1
     38  5cff		       00 02	   BFX_WARB   equ	2
     39  5cff		       00 03	   BFX_DET    equ	3
     40  5cff		       00 04	   BFX_FILT   equ	4
     41  5cff		       00 05	   BFX_HELD   equ	5
     42  5cff
