      0  2976					      include	"nesenv.asm"
      1  2976							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  2976							;
      3  2976							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  2976							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  2976							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  2976							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  2976							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  2976							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  2976							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  2976							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  2976							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  2976							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  2976							; would wrap to a high pitch).
     14  2976							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  2976
     16  2976							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  2976							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  2976							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  2976							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  2976							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  2976		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  2976		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  2976							; NES channels too, and can't take a bend every 4 ms
     24  2976		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  2976		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  2976
     27  2976							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  2976		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  297f		       02 05	   slotVoice  .byte.b	2,5
     30  2981
     31  2981							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  2981							; note keeps sounding for now). X = voice (= t0).
     33  2981				   NesSoftRelease
     34  2981					      subroutine
     35  2981		       4c 86 29 	      jmp	.go
     36  2984				   .nope
     37  2984		       18		      clc
