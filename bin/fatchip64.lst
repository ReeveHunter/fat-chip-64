    396  3f72							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    397  3f72							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    398  3f72							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    399  3f72							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    400  3f72		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    401  3f76		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    402  3f7d		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    403  3f84		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    404  3f89		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    405  3f8d		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
