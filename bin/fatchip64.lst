------- FILE pads.asm LEVEL 2 PASS 2
      0  198c					      include	"pads.asm"
      1  198c							; Fat Chip 64 - sound: FAT (default) or PADS (V)
      2  198c							;
      3  198c							; PADS, per the brief's ambient pads: some voices swell and glide into each
      4  198c							; chord, others keep sharp defined attacks.
      5  198c							;   SID       slow attack (500 ms), long release (2.4 s), pulse wave with its
      6  198c							;	       width wobbling (each voice its own phase), through a low-pass
      7  198c							;	       filter that sweeps slowly (about 8 s up and down)
      8  198c							;   Game Boy  slow attack and release on pulses + wave, pulse 2 glides
      9  198c							;	       into each new note, deeper warble
     10  198c							;   MidiNES   unchanged: the sharp attacks under the swell
     11  198c
     12  198c				   SoundApply
     13  198c					      subroutine
     14  198c		       a2 02		      ldx	#2
     15  198e				   .v
     16  198e		       bc fd 20 	      ldy	sidOfs,x
     17  1991		       ad 7d c3 	      lda	padSound
     18  1994		       f0 0e		      beq	.fat
     19  1996		       a9 a0		      lda	#$A0	; attack 500 ms, decay -
     20  1998		       99 05 d4 	      sta	SID+5,y
     21  199b		       a9 fb		      lda	#$FB	; sustain 15, release 2.4 s
     22  199d		       99 06 d4 	      sta	SID+6,y
     23  19a0		       a9 40		      lda	#$40	; pulse
     24  19a2		       d0 16		      bne	.w
     25  19a4				   .fat
     26  19a4		       a9 19		      lda	#$19
     27  19a6		       99 05 d4 	      sta	SID+5,y
     28  19a9		       a9 c9		      lda	#$C9
     29  19ab		       99 06 d4 	      sta	SID+6,y
     30  19ae		       a9 08		      lda	#$08	; pulse width back to 50%
     31  19b0		       99 03 d4 	      sta	SID+3,y
     32  19b3		       a9 00		      lda	#0
     33  19b5		       99 02 d4 	      sta	SID+2,y
     34  19b8		       a9 20		      lda	#$20	; saw
     35  19ba				   .w
     36  19ba		       85 23		      sta	t0
     37  19bc		       bd 19 c3 	      lda	sidGate,x
     38  19bf		       29 01		      and	#1
     39  19c1		       05 23		      ora	t0
     40  19c3		       9d 19 c3 	      sta	sidGate,x
     41  19c6		       99 04 d4 	      sta	SID+4,y
     42  19c9		       ca		      dex
