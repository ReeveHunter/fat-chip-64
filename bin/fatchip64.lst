     59  83b7 ????	       00 0c	   OCT_BOTTOM equ	12	; F1 / F3: the lowest key goes C0 ..
     60  83b7 ????	       00 54	   OCT_TOP    equ	84	;  .. C6
     61  83b7 ????	       00 64	   VELOCITY   equ	100
