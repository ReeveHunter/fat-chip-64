    154  0fc1							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    155  0fc1							; keys: some other column has a key in this row and shares another row with
    156  0fc1							; this column.
    157  0fc1				   Suspect
    158  0fc1					      subroutine
    159  0fc1		       ac 38 c3 	      ldy	ksRow
    160  0fc4		       b9 76 77 	      lda	rowBit,y
    161  0fc7		       49 ff		      eor	#$FF
    162  0fc9		       ae 37 c3 	      ldx	ksCol
    163  0fcc		       3d 80 c2 	      and	keyNow,x
    164  0fcf		       8d 39 c3 	      sta	ksMask	; this column's other held rows
    165  0fd2		       f0 1c		      beq	.no
    166  0fd4		       a2 07		      ldx	#7
    167  0fd6				   .c
    168  0fd6		       ec 37 c3 	      cpx	ksCol
