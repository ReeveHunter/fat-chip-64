    458  6578		       ad 55 c8 	      lda	fineTune
    459  657b		       38		      sec
    460  657c		       e9 32		      sbc	#50
    461  657e		       18		      clc
    462  657f		       7d 95 66 	      adc	scCents,x
    463  6582		       50 00		      bvc	.c	; (can't overflow: -85..+60)
