------- FILE midiin.asm LEVEL 2 PASS 3
      0  2ba6					      include	"midiin.asm"
      1  2ba6							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  2ba6							;
      3  2ba6							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  2ba6							; The main loop parses them (running status; realtime and system bytes are
      5  2ba6							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  2ba6							; notes mode, latch, arp and K + note.
      7  2ba6							;
      8  2ba6							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  2ba6							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  2ba6							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  2ba6							;
     12  2ba6							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  2ba6							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  2ba6							;
     15  2ba6							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  2ba6							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  2ba6							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  2ba6							; MIDI in is passed on to the Game Boy or NES.
     19  2ba6
     20  2ba6							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  2ba6							; Uses A, X.
     22  2ba6							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  2ba6							; with the time; a Start ($FA) makes the next clock a beat.
     24  2ba6				   RxByte
     25  2ba6					      subroutine
     26  2ba6		       ad 06 de 	      lda	ACIA_STAT
     27  2ba9		       4a		      lsr		; RDRF -> carry
     28  2baa		       90 2b		      bcc	.x
     29  2bac				   RxGot
     30  2bac		       ad 07 de 	      lda	ACIA_RX
     31  2baf		       c9 f8		      cmp	#$F8
     32  2bb1		       f0 25		      beq	.clk
     33  2bb3		       c9 fa		      cmp	#$FA
     34  2bb5		       d0 0e		      bne	.buf
     35  2bb7		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  2bb9		       8e e9 c5 	      stx	clkPhase
     37  2bbc		       8e f1 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  2bbf							;  the main loop could measure it)
     39  2bbf		       ae ea c5 	      ldx	clkBeat
     40  2bc2		       8e fc c5 	      stx	clkStartBeat
     41  2bc5				   .buf
     42  2bc5		       ae 25 c4 	      ldx	rxHead
     43  2bc8		       9d e5 c3 	      sta	rxBuf,x
     44  2bcb		       e8		      inx
     45  2bcc		       8a		      txa
     46  2bcd		       29 3f		      and	#63
     47  2bcf		       cd 26 c4 	      cmp	rxTail
     48  2bd2		       f0 03		      beq	.x	; full: dropped
     49  2bd4		       8d 25 c4 	      sta	rxHead
     50  2bd7				   .x
     51  2bd7		       60		      rts
     52  2bd8				   .clk
     53  2bd8		       ee e5 c5 	      inc	clkCount
     54  2bdb		       ae e9 c5 	      ldx	clkPhase
     55  2bde		       e8		      inx
     56  2bdf		       e0 18		      cpx	#24
     57  2be1		       90 1b		      bcc	.ph
     58  2be3		       a5 10		      lda	ticks
     59  2be5		       8d ec c5 	      sta	clkAtL
     60  2be8		       a5 11		      lda	ticks+1
     61  2bea		       8d ed c5 	      sta	clkAtH
     62  2bed		       a5 2d		      lda	subTick
     63  2bef		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  2bf1		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  2bf3		       ad 05 dc 	      lda	CIA1_TAHI
     66  2bf6				   .q
     67  2bf6		       8d ee c5 	      sta	clkAtS
     68  2bf9		       ee ea c5 	      inc	clkBeat
     69  2bfc		       a2 00		      ldx	#0
     70  2bfe				   .ph
     71  2bfe		       8e e9 c5 	      stx	clkPhase
     72  2c01		       60		      rts
     73  2c02
     74  2c02							; Main loop, every pass: parse what came in.
     75  2c02				   MidiInService
     76  2c02					      subroutine
     77  2c02				   .next
     78  2c02		       ae 26 c4 	      ldx	rxTail
     79  2c05		       ec 25 c4 	      cpx	rxHead
     80  2c08		       d0 01		      bne	.byte
     81  2c0a		       60		      rts
     82  2c0b				   .byte
     83  2c0b		       bd e5 c3 	      lda	rxBuf,x
     84  2c0e		       a8		      tay
     85  2c0f		       e8		      inx
     86  2c10		       8a		      txa
     87  2c11		       29 3f		      and	#63
     88  2c13		       8d 26 c4 	      sta	rxTail
     89  2c16		       98		      tya
     90  2c17		       10 14		      bpl	.data
     91  2c19		       c9 f8		      cmp	#$F8
     92  2c1b		       b0 34		      bcs	.rt	; realtime (clocks are counted by RxByte)
     93  2c1d		       c9 f0		      cmp	#$F0
     94  2c1f		       90 02		      bcc	.status
     95  2c21		       a9 00		      lda	#0	; system: no running status until the next one
     96  2c23				   .status
     97  2c23		       8d 27 c4 	      sta	rxStatus
     98  2c26		       a9 00		      lda	#0
     99  2c28		       8d 28 c4 	      sta	rxCnt
    100  2c2b		       f0 d5		      beq	.next
    101  2c2d				   .data
    102  2c2d		       ae 27 c4 	      ldx	rxStatus
    103  2c30		       f0 d0		      beq	.next	; no status yet
    104  2c32		       ae 28 c4 	      ldx	rxCnt
    105  2c35		       d0 2e		      bne	.second
    106  2c37		       8d 29 c4 	      sta	rxD1
    107  2c3a		       ee 28 c4 	      inc	rxCnt
    108  2c3d		       ad 27 c4 	      lda	rxStatus
    109  2c40		       29 e0		      and	#$E0
    110  2c42		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
    111  2c44		       d0 bc		      bne	.next
    112  2c46		       a9 00		      lda	#0
    113  2c48		       8d 28 c4 	      sta	rxCnt
    114  2c4b		       20 73 2c 	      jsr	MidiInMsg
    115  2c4e		       4c 02 2c 	      jmp	.next
    116  2c51				   .rt
    117  2c51		       c9 fa		      cmp	#$FA
    118  2c53		       d0 06		      bne	.rt2
    119  2c55		       20 7b 44 	      jsr	KeytarStart
    120  2c58		       4c 02 2c 	      jmp	.next
    121  2c5b				   .rt2
    122  2c5b		       c9 fc		      cmp	#$FC
    123  2c5d		       d0 03		      bne	.rt3
    124  2c5f		       20 9c 44 	      jsr	KeytarStop
    125  2c62				   .rt3
    126  2c62		       4c 02 2c 	      jmp	.next
    127  2c65				   .second
    128  2c65		       8d 2a c4 	      sta	rxD2
    129  2c68		       a9 00		      lda	#0
    130  2c6a		       8d 28 c4 	      sta	rxCnt
    131  2c6d		       20 73 2c 	      jsr	MidiInMsg
    132  2c70		       4c 02 2c 	      jmp	.next
    133  2c73
    134  2c73							; A full message: rxStatus, rxD1, rxD2
    135  2c73				   MidiInMsg
    136  2c73					      subroutine
    137  2c73		       ad 27 c4 	      lda	rxStatus
    138  2c76		       29 0f		      and	#15
    139  2c78		       c9 0f		      cmp	#DRUM_CH_IN	; channel 16: the keytar's rhythm
    140  2c7a		       d0 1d		      bne	.notes
    141  2c7c		       ad 27 c4 	      lda	rxStatus
    142  2c7f		       29 f0		      and	#$F0
