     34  3d02		       d0 05		      bne	.nk
     35  3d04		       a9 01		      lda	#1
     36  3d06		       8d 40 c6 	      sta	vizKick	; (the visualizer's border flash)
     37  3d09				   .nk
     38  3d09		       ad 27 c3 	      lda	devOn+DEV_NES
     39  3d0c		       d0 01		      bne	.on
     40  3d0e		       60		      rts
     41  3d0f				   .on
     42  3d0f		       20 92 1a 	      jsr	GetTicks
     43  3d12		       ad 83 c4 	      lda	drumKind
     44  3d15		       c9 02		      cmp	#DK_CH
     45  3d17		       90 07		      bcc	.dmc
     46  3d19		       c9 05		      cmp	#DK_TOM
     47  3d1b		       b0 03		      bcs	.dmc
     48  3d1d		       4c d2 3d 	      jmp	NoiseHit
     49  3d20				   .dmc
     50  3d20		       ae 83 c4 	      ldx	drumKind
     51  3d23		       bd b9 3d 	      lda	dmcPrioT,x
     52  3d26		       85 24		      sta	t0
     53  3d28		       ad 3e c3 	      lda	nowL
