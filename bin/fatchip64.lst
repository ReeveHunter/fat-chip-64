------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  3b0d					      include	"sounds.asm"
      1  3b0d							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  3b0d							;
      3  3b0d							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  3b0d							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  3b0d							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  3b0d							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  3b0d							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  3b0d							;
      9  3b0d							; Each sound has a mono default and a Fat Bass default:
     10  3b0d							;   MONO      one note (the last key pressed and still held) on every voice;
     11  3b0d							;	       a new key while another is held changes the pitch without a
     12  3b0d							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  3b0d							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  3b0d							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  3b0d							;	       the other voices
     16  3b0d							;
     17  3b0d							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  3b0d							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  3b0d							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  3b0d
     21  3b0d							; ------------------------------------------------------------ choosing
     22  3b0d							; V: next sound (SHIFT+V: previous)
     23  3b0d				   SoundKey
     24  3b0d					      subroutine
     25  3b0d		       20 9d 3b 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3b10		       ae 95 c3 	      ldx	soundMode
     27  3b13		       ad 2a c3 	      lda	shiftDown
     28  3b16		       d0 09		      bne	.prev
     29  3b18		       e8		      inx
     30  3b19		       e0 13		      cpx	#NUM_SOUNDS
