    178 U001a		       00	   nesqHead   ds	1
    179 U001b		       00	   nesqTail   ds	1
    180 U001c		       00	   nesNext    ds	1
    181 U001d		       00	   nmiCount   ds	1	; RESTORE presses seen by the NMI handler
    182 U001e		       00 00	   nmiTick    ds	2
    183 U0020		       00	   nmiSeen    ds	1
    184 U0021		       00	   mS	      ds	1	; message being queued: status, data 1, data 2
    185 U0022		       00	   mD1	      ds	1
    186 U0023		       00	   mD2	      ds	1
    187 U0024		       00	   t0	      ds	1
