     51  7a59		       99 aa c8 	      sta	sidBaseLo,y
     52  7a5c		       b9 2b c9 	      lda	sidTgtHi,y
     53  7a5f		       99 ad c8 	      sta	sidBaseHi,y
     54  7a62		       a9 00		      lda	#0
