    379  30ac		       d0 05		      bne	.x
    380  30ae		       48		      pha
    381  30af		       20 f4 30 	      jsr	PatchReceived
    382  30b2		       68		      pla
    383  30b3				   .x
    384  30b3		       60		      rts
    385  30b4
    386  30b4							; A data byte (A) inside a SysEx
    387  30b4				   SysexByte
    388  30b4					      subroutine
    389  30b4		       ae 4d c7 	      ldx	sxPos
