      0  571b					      include	"patchedit.asm"
      1  571b							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  571b							; the dice. The settings and their steps come from tools/gen_menu.py
      3  571b							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  571b							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  571b							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  571b							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  571b							; (EnvDerive).
      8  571b
      9  571b		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  571b		       00 30	   LFO_LAST   equ	FLD_gbLDelay
