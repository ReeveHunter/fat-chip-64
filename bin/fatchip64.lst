     77  3742		       6d 82 c4 	      adc	drumLvl
     78  3745				   .k
     79  3745		       85 25		      sta	t1
     80  3747		       ad 6e c4 	      lda	beatSel	; x 12
     81  374a		       0a		      asl
     82  374b		       0a		      asl
     83  374c		       85 26		      sta	t2
     84  374e		       0a		      asl
     85  374f		       65 26		      adc	t2
     86  3751		       65 25		      adc	t1
     87  3753		       aa		      tax
     88  3754		       bd 5b 6b 	      lda	kits,x
     89  3757		       85 25		      sta	t1
     90  3759							; bank (CC14 on the sample channel) when it changes
     91  3759		       a9 04		      lda	#4
     92  375b		       20 b3 37 	      jsr	NesChStatus	; mS = CC, sample channel
     93  375e		       a9 00		      lda	#0
     94  3760		       a6 25		      ldx	t1
     95  3762		       10 02		      bpl	.a
     96  3764		       a9 7f		      lda	#127
     97  3766				   .a
     98  3766		       cd 78 c4 	      cmp	dmcBank
     99  3769		       f0 0c		      beq	.note
    100  376b		       8d 78 c4 	      sta	dmcBank
    101  376e		       85 23		      sta	mD2
    102  3770		       a9 0e		      lda	#14
    103  3772		       85 22		      sta	mD1
    104  3774		       20 b9 0b 	      jsr	NesPut
    105  3777				   .note
    106  3777		       a5 21		      lda	mS
    107  3779		       29 0f		      and	#$0F
    108  377b		       85 26		      sta	t2	; channel
    109  377d		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    110  377f							;  cuts it anyway, and the hit lands 1 ms sooner)
    111  377f		       29 7f		      and	#$7F
    112  3781		       8d 85 c4 	      sta	dmcNote
    113  3784		       85 22		      sta	mD1
    114  3786		       a5 26		      lda	t2
    115  3788		       09 90		      ora	#$90
    116  378a		       85 21		      sta	mS
    117  378c		       a9 7f		      lda	#127
    118  378e		       85 23		      sta	mD2
    119  3790		       20 b9 0b 	      jsr	NesPut
    120  3793		       a5 24		      lda	t0
    121  3795		       8d 79 c4 	      sta	dmcPrio
    122  3798		       ad 3e c3 	      lda	nowL
    123  379b		       8d 7a c4 	      sta	dmcAt
