     64  0bd4							; A = key code
     65  0bd4							;   overlay	    notes (latch: = )
     66  0bd4							;   F1/F3/F5/F7    octave: C4 / C3 / C2 / C1 on the lowest key
     67  0bd4							;   SHIFT+F1/F3/F5 SID / Game Boy / MidiNES on-off	SHIFT+F7 panic
     68  0bd4							;   CTRL+F3/F5     Game Boy / MidiNES: next channel block
     69  0bd4							;   M		    mute the SID (kills the C64's hum)
