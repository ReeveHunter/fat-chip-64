------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  5312					      include	"sync.asm"
      1  5312							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  5312							;
      3  5312							; Menu, DEVICE SYNC (defaults first):
      4  5312							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  5312							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  5312							;		     sets the tempo, averaged over beats (the clock jitters about
      7  5312							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  5312							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  5312							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  5312							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  5312							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  5312							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  5312							;		     picks a beat demo (styleBeat)
     14  5312							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  5312							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  5312							;		     key channel) picks a sound (voiceSound)
     17  5312							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  5312							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  5312							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  5312							;
     21  5312							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  5312							; 1/4 ms); a Start makes the next clock a beat.
     23  5312
     24  5312		       00 00	   TEMPO_KEYTAR equ	0
     25  5312		       00 01	   TEMPO_OWN  equ	1
     26  5312		       00 02	   TEMPO_SC   equ	2
     27  5312		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  5312
     29  5312
     30  5312
     31  5312							; ------------------------------------------------------------ clock
     32  5312							; Main loop, every pass
     33  5312				   ClockTick
     34  5312					      subroutine
     35  5312		       ad e5 c5 	      lda	clkCount	; any clock lately?
     36  5315		       cd e6 c5 	      cmp	clkCountSeen
     37  5318		       f0 15		      beq	.alive
     38  531a		       8d e6 c5 	      sta	clkCountSeen
     39  531d		       20 0a 23 	      jsr	GetTicks
     40  5320		       ad 3f c3 	      lda	nowL
     41  5323		       8d e7 c5 	      sta	clkSeenL
     42  5326		       ad 40 c3 	      lda	nowH
     43  5329		       8d e8 c5 	      sta	clkSeenH
     44  532c		       4c 50 53 	      jmp	.beatq
     45  532f				   .alive
     46  532f		       ad f2 c5 	      lda	clkHave	; none for a while: start measuring afresh
     47  5332		       f0 1c		      beq	.beatq
     48  5334		       20 0a 23 	      jsr	GetTicks
     49  5337		       ad 3f c3 	      lda	nowL
     50  533a		       38		      sec
     51  533b		       ed e7 c5 	      sbc	clkSeenL
     52  533e		       aa		      tax
     53  533f		       ad 40 c3 	      lda	nowH
     54  5342		       ed e8 c5 	      sbc	clkSeenH
     55  5345		       d0 04		      bne	.lost
     56  5347		       e0 2c		      cpx	#<CLK_ALIVE
     57  5349		       90 05		      bcc	.beatq
     58  534b				   .lost
     59  534b		       a9 00		      lda	#0
     60  534d		       8d f2 c5 	      sta	clkHave
     61  5350				   .beatq
     62  5350		       ad ea c5 	      lda	clkBeat
     63  5353		       cd eb c5 	      cmp	clkBeatSeen
     64  5356		       d0 01		      bne	.beat
