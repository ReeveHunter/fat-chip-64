    142  4d1a				   NoiseHit
    143  4d1a					      subroutine
    144  4d1a		       ad 83 c4 	      lda	drumKind
    145  4d1d		       38		      sec
    146  4d1e		       e9 02		      sbc	#DK_CH
    147  4d20		       85 24		      sta	t0	; 0 closed, 1 open, 2 cymbal
    148  4d22		       a9 02		      lda	#2
    149  4d24		       38		      sec
