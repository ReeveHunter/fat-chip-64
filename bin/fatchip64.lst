     97  7a10		       d0 08		      bne	.ok
     98  7a12				   .dn
     99  7a12		       18		      clc
    100  7a13		       7d ce c7 	      adc	vWant,x
    101  7a16		       b0 02		      bcs	.ok	; (no borrow: 0 or more)
    102  7a18		       a9 00		      lda	#0
    103  7a1a				   .ok
    104  7a1a		       20 ee 21 	      jsr	SidPitch	; -> ptr
    105  7a1d		       a5 28		      lda	ptr
    106  7a1f		       99 aa c8 	      sta	sidBaseLo,y
    107  7a22		       a5 29		      lda	ptr+1
    108  7a24		       99 ad c8 	      sta	sidBaseHi,y
    109  7a27		       ad 63 cb 	      lda	sndPenvK
    110  7a2a		       ae 5f cb 	      ldx	sndStep
    111  7a2d		       f0 02		      beq	.k
    112  7a2f		       a9 ff		      lda	#$FF	; (STEP: held; AtkStep jumps)
    113  7a31				   .k
    114  7a31		       99 2e ce 	      sta	sK,y
    115  7a34				   .x
    116  7a34		       60		      rts
