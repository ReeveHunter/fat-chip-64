    132  0fc1							; Z set if key code A is a modifier. Keeps A.
    133  0fc1				   IsModifier
    134  0fc1		       c9 88		      cmp	#K_LSHIFT
    135  0fc3		       f0 12		      beq	.y
    136  0fc5		       c9 89		      cmp	#K_RSHIFT
    137  0fc7		       f0 0e		      beq	.y
    138  0fc9		       c9 8c		      cmp	#K_CTRL
    139  0fcb		       f0 0a		      beq	.y
    140  0fcd		       c9 a2		      cmp	#K_CBM
    141  0fcf		       f0 06		      beq	.y
    142  0fd1		       c9 a3		      cmp	#K_STOP
    143  0fd3		       f0 02		      beq	.y
    144  0fd5		       c9 9a		      cmp	#K_K
    145  0fd7				   .y
