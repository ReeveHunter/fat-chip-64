------- FILE midiin.asm LEVEL 2 PASS 3
      0  308e					      include	"midiin.asm"
      1  308e							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  308e							;
      3  308e							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  308e							; The main loop parses them (running status; realtime and system bytes are
      5  308e							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  308e							; notes mode, latch, arp and K + note.
      7  308e							;
      8  308e							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  308e							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  308e							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  308e							;
     12  308e							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  308e							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  308e							;
     15  308e							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  308e							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  308e							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  308e							; MIDI in is passed on to the Game Boy or NES.
     19  308e
     20  308e							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  308e							; Uses A, X.
     22  308e							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  308e							; with the time; a Start ($FA) makes the next clock a beat.
