    335  0a9a		       4a		      lsr
    336  0a9b		       90 03		      bcc	.noRx
    337  0a9d		       20 e0 2e 	      jsr	RxGot
    338  0aa0				   .noRx
    339  0aa0		       a6 16		      ldx	wireTail
    340  0aa2		       e4 15		      cpx	wireHead
    341  0aa4		       f0 0f		      beq	.noByte
    342  0aa6		       ad 06 de 	      lda	ACIA_STAT
    343  0aa9		       29 02		      and	#ACIA_TDRE
    344  0aab		       f0 08		      beq	.noByte
