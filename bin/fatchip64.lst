      0  0b17					      include	"midi.asm"
      1  0b17							; Fat Chip 64 - MIDI out
      2  0b17							;
      3  0b17							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0b17							; at most one message per device onto the wire buffer, no sooner than that
      5  0b17							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0b17							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0b17							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0b17							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0b17							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0b17
     11  0b17				   MidiInit
     12  0b17					      subroutine
     13  0b17		       a9 03		      lda	#ACIA_RESET
     14  0b19		       8d 04 de 	      sta	ACIA_CTRL
     15  0b1c		       a9 16		      lda	#ACIA_MODE
     16  0b1e		       8d 04 de 	      sta	ACIA_CTRL
     17  0b21							; (fall into the test)
     18  0b21
     19  0b21							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0b21							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0b21							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0b21							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0b21							; before. Interrupts are off when this is called.
     24  0b21				   MidiIrqTest
     25  0b21					      subroutine
     26  0b21		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0b23		       8d 0d dc 	      sta	CIA1_ICR
     28  0b26		       ad 0d dc 	      lda	CIA1_ICR
     29  0b29		       a9 71		      lda	#<IrqTest
     30  0b2b		       8d fe ff 	      sta	$FFFE
     31  0b2e		       a9 0b		      lda	#>IrqTest
     32  0b30		       8d ff ff 	      sta	$FFFF
     33  0b33		       a9 00		      lda	#0
     34  0b35		       85 2f		      sta	midiIrq
     35  0b37		       a9 b6		      lda	#ACIA_MODE_TX
     36  0b39		       8d 04 de 	      sta	ACIA_CTRL
     37  0b3c		       58		      cli
     38  0b3d		       a2 00		      ldx	#0
     39  0b3f				   .w
     40  0b3f		       ca		      dex
     41  0b40		       d0 fd		      bne	.w
     42  0b42		       78		      sei
     43  0b43		       a6 2f		      ldx	midiIrq
     44  0b45		       bd 7d 0b 	      lda	midiCtl,x
     45  0b48		       8d 04 de 	      sta	ACIA_CTRL
     46  0b4b		       bd 7f 0b 	      lda	irqLo,x
     47  0b4e		       8d fe ff 	      sta	$FFFE
     48  0b51		       bd 81 0b 	      lda	irqHi,x
     49  0b54		       8d ff ff 	      sta	$FFFF
     50  0b57		       bd 83 0b 	      lda	latchLo,x
     51  0b5a		       8d 04 dc 	      sta	CIA1_TALO
     52  0b5d		       bd 85 0b 	      lda	latchHi,x
     53  0b60		       8d 05 dc 	      sta	CIA1_TAHI
     54  0b63		       a9 11		      lda	#$11	; start, force load, continuous
     55  0b65		       8d 0e dc 	      sta	CIA1_CRA
     56  0b68		       ad 0d dc 	      lda	CIA1_ICR
