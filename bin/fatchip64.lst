    387  0b16		       a9 03		      lda	#3
    388  0b18		       85 2d		      sta	subTick
    389  0b1a		       98		      tya
    390  0b1b		       48		      pha
    391  0b1c		       e6 10		      inc	ticks
    392  0b1e		       d0 02		      bne	.t
    393  0b20		       e6 11		      inc	ticks+1
