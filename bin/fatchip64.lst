    144  3b30							; A full message: rxStatus, rxD1, rxD2
    145  3b30				   MidiInMsg
    146  3b30					      subroutine
    147  3b30		       ad 33 c8 	      lda	rxStatus
    148  3b33		       29 0f		      and	#15
