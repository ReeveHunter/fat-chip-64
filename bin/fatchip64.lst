     45  40a3		       90 07		      bcc	.dmc
     46  40a5		       c9 05		      cmp	#DK_TOM
     47  40a7		       b0 03		      bcs	.dmc
     48  40a9		       4c 5e 41 	      jmp	NoiseHit
     49  40ac				   .dmc
     50  40ac		       ae 82 c4 	      ldx	drumKind
