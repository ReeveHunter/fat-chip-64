------- FILE arp.asm LEVEL 2 PASS 3
      0  23ae					      include	"arp.asm"
      1  23ae							; Fat Chip 64 - tempo and arpeggiator
      2  23ae							;
      3  23ae							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  23ae							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  23ae							;
      6  23ae							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  23ae							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  23ae							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  23ae							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  23ae							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  23ae							;	     until its voice's next turn.
     12  23ae							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  23ae							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  23ae							;   J faster; either one also picks FREE).
     15  23ae							;
     16  23ae							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  23ae							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  23ae
     19  23ae							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  23ae							; between the two bytes: $22FF read as $23FF)
     21  23ae				   GetTicks
     22  23ae					      subroutine
     23  23ae		       08		      php
     24  23af		       78		      sei
     25  23b0		       a5 10		      lda	ticks
     26  23b2		       8d 3f c3 	      sta	nowL
     27  23b5		       a5 11		      lda	ticks+1
     28  23b7		       8d 40 c3 	      sta	nowH
     29  23ba		       28		      plp
     30  23bb		       60		      rts
     31  23bc
