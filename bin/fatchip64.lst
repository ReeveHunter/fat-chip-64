      0  7594					      include	"nesfx.asm"
      1  7594							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7594							;
      3  7594							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7594							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7594							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7594							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7594							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7594							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7594							;   glide    a new note starts bent back to the voice's last note and slides
     10  7594							;	      in the way the SID's does (all three channels)
     11  7594							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7594							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7594							; semitone, so these are a little stepped.
     14  7594
     15  7594		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7594							;  (the pulses, and the triangle while it glides)
     17  7594
     18  7594							; A = 1 (not Z) when a NesFxTick step is due
     19  7594				   NesFxDue
     20  7594					      subroutine
     21  7594		       ad 27 c3 	      lda	devOn+DEV_NES
     22  7597		       f0 19		      beq	.x
     23  7599		       ad ff c5 	      lda	vibDepth
     24  759c		       0d 2d c5 	      ora	nfxGlide
     25  759f		       0d 2e c5 	      ora	nfxRun
     26  75a2		       f0 0e		      beq	.x
     27  75a4		       a5 10		      lda	ticks
     28  75a6		       38		      sec
     29  75a7		       ed 29 c5 	      sbc	nfxLast
     30  75aa		       c9 08		      cmp	#NFX_EVERY
     31  75ac		       a9 00		      lda	#0
     32  75ae		       90 02		      bcc	.x
     33  75b0		       a9 01		      lda	#1
     34  75b2				   .x
     35  75b2		       60		      rts
     36  75b3
     37  75b3							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  75b3							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  75b3							; quick return.
