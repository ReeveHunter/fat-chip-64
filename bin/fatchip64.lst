     33  15b9		       a9 19		      lda	#$19	; attack 1, decay 9
     34  15bb		       99 05 d4 	      sta	SID+5,y
     35  15be		       a9 c9		      lda	#$C9	; sustain 12, release 9
     36  15c0		       99 06 d4 	      sta	SID+6,y
     37  15c3		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     38  15c5		       99 03 d4 	      sta	SID+3,y
     39  15c8		       a9 20		      lda	#$20	; sawtooth, gate off
     40  15ca		       9d 31 c3 	      sta	sidGate,x
     41  15cd		       99 04 d4 	      sta	SID+4,y
     42  15d0		       ca		      dex
