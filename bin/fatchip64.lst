     22  726e				   .c
     23  726e		       b1 28		      lda	(ptr),y
     24  7270		       f0 0e		      beq	.done
     25  7272		       c9 40		      cmp	#64
     26  7274		       90 03		      bcc	.noLetter
     27  7276		       38		      sec
     28  7277		       e9 40		      sbc	#64
     29  7279				   .noLetter
