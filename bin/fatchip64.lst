    185  0fcd							; A = key code (v0.22 layout)
    186  0fcd							;   overlay	    notes
    187  0fcd							;   A S D F G	    bank (FAT PADS LEADS BASS FX): switches at once, same slot
    188  0fcd							;   Z X C V B	    patch 1-5 in the bank
    189  0fcd							;   L		    latch on / off	      K, then a note or a shape: key + scale
    190  0fcd							;   =		    tap tempo		      , / .  tempo -1 / +1 (SHIFT: 10)
    191  0fcd							;   /		    mute		      SHIFT+/  the dice
    192  0fcd							;   ; / :	    free arp speed	      SPACE  its action
    193  0fcd							;   F1 / F3	    octave up / down	      F5  arp on / off	  F7  visualizer
    194  0fcd							;   RETURN	    the menu		      CTRL+F3/F5  GB / NES channel block
    195  0fcd							;   C= +  A S D F  arp type / pattern / speed / SPARKLE octave
    196  0fcd							;	   Z X C    notes mode / extensions / POLY-MONO     L  latch style
    197  0fcd							;	   , .	    SPACE's action	      ; :  MIDI in octave down / up
    198  0fcd							;	   /	    undo the dice	      F1 F3 F5	SID / GB / NES on-off
    199  0fcd							;	   F7	    panic		      (SHIFT + F keys too, as before)
