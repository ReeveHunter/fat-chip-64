------- FILE main.asm
------- FILE nesfx.asm LEVEL 2 PASS 3
      0  7e0c					      include	"nesfx.asm"
      1  7e0c							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7e0c							;
      3  7e0c							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7e0c							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7e0c							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7e0c							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7e0c							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7e0c							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7e0c							;   glide    a new note starts bent back to the voice's last note and slides
     10  7e0c							;	      in the way the SID's does (all three channels)
     11  7e0c							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7e0c							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7e0c							; semitone, so these are a little stepped.
     14  7e0c
     15  7e0c		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7e0c							;  (the pulses, and the triangle while it glides)
     17  7e0c
     18  7e0c							; A = 1 (not Z) when a NesFxTick step is due
     19  7e0c				   NesFxDue
     20  7e0c					      subroutine
     21  7e0c		       ad 27 c3 	      lda	devOn+DEV_NES
     22  7e0f		       f0 1c		      beq	.x
     23  7e11		       ad 03 c6 	      lda	vibDepth
     24  7e14		       0d 31 c5 	      ora	nfxGlide
     25  7e17		       0d 32 c5 	      ora	nfxRun
     26  7e1a		       0d e7 c9 	      ora	nfxWarb
     27  7e1d		       f0 0e		      beq	.x
     28  7e1f		       a5 10		      lda	ticks
     29  7e21		       38		      sec
     30  7e22		       ed 2d c5 	      sbc	nfxLast
     31  7e25		       c9 08		      cmp	#NFX_EVERY
     32  7e27		       a9 00		      lda	#0
     33  7e29		       90 02		      bcc	.x
     34  7e2b		       a9 01		      lda	#1
     35  7e2d				   .x
     36  7e2d		       60		      rts
     37  7e2e
     38  7e2e							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     39  7e2e							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     40  7e2e							; quick return.
     41  7e2e				   NesFxTick
     42  7e2e					      subroutine
     43  7e2e		       ad 27 c3 	      lda	devOn+DEV_NES
     44  7e31		       f0 0e		      beq	.q
