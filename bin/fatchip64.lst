      0  0bbe					      include	"midi.asm"
      1  0bbe							; Fat Chip 64 - MIDI out
      2  0bbe							;
      3  0bbe							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0bbe							; at most one message per device onto the wire buffer, no sooner than that
      5  0bbe							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0bbe							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0bbe							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0bbe							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0bbe							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0bbe
     11  0bbe				   MidiInit
     12  0bbe					      subroutine
     13  0bbe		       a9 03		      lda	#ACIA_RESET
     14  0bc0		       8d 04 de 	      sta	ACIA_CTRL
     15  0bc3		       a9 16		      lda	#ACIA_MODE
     16  0bc5		       8d 04 de 	      sta	ACIA_CTRL
     17  0bc8							; (fall into the test)
     18  0bc8
     19  0bc8							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0bc8							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0bc8							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0bc8							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0bc8							; before. Interrupts are off when this is called.
     24  0bc8				   MidiIrqTest
     25  0bc8					      subroutine
     26  0bc8		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0bca		       8d 0d dc 	      sta	CIA1_ICR
     28  0bcd		       ad 0d dc 	      lda	CIA1_ICR
     29  0bd0		       a9 18		      lda	#<IrqTest
     30  0bd2		       8d fe ff 	      sta	$FFFE
     31  0bd5		       a9 0c		      lda	#>IrqTest
     32  0bd7		       8d ff ff 	      sta	$FFFF
     33  0bda		       a9 00		      lda	#0
     34  0bdc		       85 2f		      sta	midiIrq
     35  0bde		       a9 b6		      lda	#ACIA_MODE_TX
     36  0be0		       8d 04 de 	      sta	ACIA_CTRL
     37  0be3		       58		      cli
     38  0be4		       a2 00		      ldx	#0
     39  0be6				   .w
     40  0be6		       ca		      dex
     41  0be7		       d0 fd		      bne	.w
     42  0be9		       78		      sei
     43  0bea		       a6 2f		      ldx	midiIrq
     44  0bec		       bd 24 0c 	      lda	midiCtl,x
     45  0bef		       8d 04 de 	      sta	ACIA_CTRL
     46  0bf2		       bd 26 0c 	      lda	irqLo,x
     47  0bf5		       8d fe ff 	      sta	$FFFE
     48  0bf8		       bd 28 0c 	      lda	irqHi,x
     49  0bfb		       8d ff ff 	      sta	$FFFF
     50  0bfe		       bd 2a 0c 	      lda	latchLo,x
     51  0c01		       8d 04 dc 	      sta	CIA1_TALO
     52  0c04		       bd 2c 0c 	      lda	latchHi,x
     53  0c07		       8d 05 dc 	      sta	CIA1_TAHI
     54  0c0a		       a9 11		      lda	#$11	; start, force load, continuous
     55  0c0c		       8d 0e dc 	      sta	CIA1_CRA
     56  0c0f		       ad 0d dc 	      lda	CIA1_ICR
     57  0c12		       a9 81		      lda	#$81	; timer A interrupt on
     58  0c14		       8d 0d dc 	      sta	CIA1_ICR
