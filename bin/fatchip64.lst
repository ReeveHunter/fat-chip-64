      0  0ed1					      include	"keys.asm"
      1  0ed1							; Fat Chip 64 - keyboard and RESTORE
      2  0ed1
      3  0ed1							; Scan the whole matrix, turn changes into key events.
      4  0ed1							;
      5  0ed1							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0ed1							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0ed1							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0ed1							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0ed1							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0ed1							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0ed1							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0ed1							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0ed1							; chords whose ghost lands on another used key lose their newest note.
     14  0ed1				   KeyScan
     15  0ed1					      subroutine
     16  0ed1		       a2 07		      ldx	#7
     17  0ed3				   .col
     18  0ed3		       bd f4 83 	      lda	colSelect,x
     19  0ed6		       8d 00 dc 	      sta	CIA1_PRA
     20  0ed9		       ad 01 dc 	      lda	CIA1_PRB
     21  0edc		       49 ff		      eor	#$FF
     22  0ede		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0ee1		       9d 80 c2 	      sta	keyNow,x
     24  0ee4		       ca		      dex
     25  0ee5		       10 ec		      bpl	.col
     26  0ee7		       a9 ff		      lda	#$FF
     27  0ee9		       8d 00 dc 	      sta	CIA1_PRA
     28  0eec							; ---- every column as accepted (nothing pressed or let go): done
     29  0eec		       a2 07		      ldx	#7
     30  0eee				   .same
     31  0eee		       bd 80 c2 	      lda	keyNow,x
     32  0ef1		       dd 90 c2 	      cmp	keyAcc,x
     33  0ef4		       d0 04		      bne	.changed
     34  0ef6		       ca		      dex
     35  0ef7		       10 f5		      bpl	.same
     36  0ef9		       60		      rts
     37  0efa				   .changed
     38  0efa							; ---- releases first: accepted keys that are up now
     39  0efa		       a2 00		      ldx	#0
     40  0efc				   .rc
     41  0efc		       8e 3c c3 	      stx	ksCol
     42  0eff		       bd 80 c2 	      lda	keyNow,x
     43  0f02		       49 ff		      eor	#$FF
     44  0f04		       3d 90 c2 	      and	keyAcc,x
     45  0f07		       8d 3b c3 	      sta	ksBits
     46  0f0a		       a9 00		      lda	#0
     47  0f0c		       8d 3d c3 	      sta	ksRow
     48  0f0f				   .rb
     49  0f0f		       ad 3b c3 	      lda	ksBits
     50  0f12		       f0 21		      beq	.rcn
     51  0f14		       4e 3b c3 	      lsr	ksBits
     52  0f17		       90 17		      bcc	.rbn
     53  0f19		       ae 3c c3 	      ldx	ksCol
     54  0f1c		       ac 3d c3 	      ldy	ksRow
     55  0f1f		       b9 fc 83 	      lda	rowBit,y
     56  0f22		       49 ff		      eor	#$FF
     57  0f24		       3d 90 c2 	      and	keyAcc,x
     58  0f27		       9d 90 c2 	      sta	keyAcc,x
     59  0f2a		       20 d0 0f 	      jsr	KeyCode
     60  0f2d		       20 e1 18 	      jsr	KeyUp
     61  0f30				   .rbn
     62  0f30		       ee 3d c3 	      inc	ksRow
     63  0f33		       d0 da		      bne	.rb
     64  0f35				   .rcn
     65  0f35		       ae 3c c3 	      ldx	ksCol
     66  0f38		       e8		      inx
     67  0f39		       e0 08		      cpx	#8
     68  0f3b		       d0 bf		      bne	.rc
     69  0f3d							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0f3d							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0f3d							; still count as a combination.
     72  0f3d		       a9 00		      lda	#0
     73  0f3f		       8d 3f c3 	      sta	ksPass
     74  0f42				   .pass
     75  0f42		       a2 00		      ldx	#0
     76  0f44				   .pc
     77  0f44		       8e 3c c3 	      stx	ksCol
     78  0f47		       bd 90 c2 	      lda	keyAcc,x
     79  0f4a		       49 ff		      eor	#$FF
     80  0f4c		       3d 80 c2 	      and	keyNow,x
     81  0f4f		       8d 3b c3 	      sta	ksBits
     82  0f52		       a9 00		      lda	#0
     83  0f54		       8d 3d c3 	      sta	ksRow
     84  0f57				   .pb
     85  0f57		       ad 3b c3 	      lda	ksBits
     86  0f5a		       f0 49		      beq	.pcn
     87  0f5c		       4e 3b c3 	      lsr	ksBits
     88  0f5f		       90 3f		      bcc	.pbn
     89  0f61		       ad 40 c3 	      lda	ghostFilter
     90  0f64		       d0 0c		      bne	.chk	; filter off (default): phantom notes play...
     91  0f66		       20 d0 0f 	      jsr	KeyCode
     92  0f69		       c9 18		      cmp	#24
     93  0f6b		       90 0a		      bcc	.accept
     94  0f6d		       20 b9 0f 	      jsr	IsModifier
     95  0f70		       f0 05		      beq	.accept
     96  0f72				   .chk 		; ...but a command key never comes from a phantom
     97  0f72		       20 de 0f 	      jsr	Suspect	;  (v0.40: Q + E held, then C=, read C= + S too)
     98  0f75		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     99  0f77				   .accept
    100  0f77		       20 d0 0f 	      jsr	KeyCode
    101  0f7a		       20 b9 0f 	      jsr	IsModifier	; Z set = modifier
    102  0f7d		       f0 07		      beq	.mod
    103  0f7f		       ad 3f c3 	      lda	ksPass
    104  0f82		       f0 1c		      beq	.pbn	; pass 0: modifiers only
    105  0f84		       d0 05		      bne	.take
    106  0f86				   .mod
    107  0f86		       ad 3f c3 	      lda	ksPass
    108  0f89		       d0 15		      bne	.pbn	; (taken in pass 0)
    109  0f8b				   .take
    110  0f8b		       ae 3c c3 	      ldx	ksCol
    111  0f8e		       ac 3d c3 	      ldy	ksRow
    112  0f91		       b9 fc 83 	      lda	rowBit,y
    113  0f94		       1d 90 c2 	      ora	keyAcc,x
    114  0f97		       9d 90 c2 	      sta	keyAcc,x
    115  0f9a		       20 d0 0f 	      jsr	KeyCode
    116  0f9d		       20 0f 10 	      jsr	KeyDown
    117  0fa0				   .pbn
    118  0fa0		       ee 3d c3 	      inc	ksRow
    119  0fa3		       d0 b2		      bne	.pb
    120  0fa5				   .pcn
    121  0fa5		       ae 3c c3 	      ldx	ksCol
    122  0fa8		       e8		      inx
    123  0fa9		       e0 08		      cpx	#8
    124  0fab		       d0 97		      bne	.pc
    125  0fad		       ad 3f c3 	      lda	ksPass
    126  0fb0		       d0 06		      bne	.done
    127  0fb2		       ee 3f c3 	      inc	ksPass
    128  0fb5		       4c 42 0f 	      jmp	.pass
    129  0fb8				   .done
    130  0fb8		       60		      rts
    131  0fb9
    132  0fb9							; Z set if key code A is a modifier. Keeps A.
    133  0fb9				   IsModifier
    134  0fb9		       c9 88		      cmp	#K_LSHIFT
    135  0fbb		       f0 12		      beq	.y
    136  0fbd		       c9 89		      cmp	#K_RSHIFT
    137  0fbf		       f0 0e		      beq	.y
    138  0fc1		       c9 8c		      cmp	#K_CTRL
    139  0fc3		       f0 0a		      beq	.y
    140  0fc5		       c9 a2		      cmp	#K_CBM
    141  0fc7		       f0 06		      beq	.y
    142  0fc9		       c9 a3		      cmp	#K_STOP
    143  0fcb		       f0 02		      beq	.y
    144  0fcd		       c9 9a		      cmp	#K_K
    145  0fcf				   .y
    146  0fcf		       60		      rts
    147  0fd0
    148  0fd0							; A = key code at ksCol / ksRow
