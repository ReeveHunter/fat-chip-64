------- FILE main.asm
------- FILE viz.asm LEVEL 2 PASS 3
      0  7b65					      include	"viz.asm"
      1  7b65							; Fat Chip 64 - the visualizer (F7: GLITCH on / off; v0.28 dropped the BARS)
      2  7b65							;
      3  7b65							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
      4  7b65							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
      5  7b65							; keep spattering more; runs of the screen get copied over other places
      6  7b65							; (datamosh) and wiped away, so it fills while you play and dissolves when
      7  7b65							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
      8  7b65							; the background. VINYL STOP drags it down the screen.
      9  7b65
     10  7b65		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     11  7b65		       00 16	   VIZ_NAMES  equ	22	; note names
     12  7b65		       00 a0	   VIZ_FULL   equ	160	; reversed space
     13  7b65		       00 62	   VIZ_HALF   equ	98	; lower half block
     14  7b65
