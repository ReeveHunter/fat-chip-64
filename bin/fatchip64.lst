------- FILE attack.asm LEVEL 2 PASS 3
      0  7096					      include	"attack.asm"
      1  7096							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  7096							; how each note starts and ends in pitch
      3  7096							;
      4  7096							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  7096							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  7096							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  7096							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  7096							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  7096							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  7096							;   (v0.42) as long as TIME.
     11  7096							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  7096							;   release rings.
     13  7096
     14  7096							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  7096							; jumps to the note
     16  7096				   AtkStep
     17  7096					      subroutine
     18  7096		       ac c3 c3 	      ldy	envY
     19  7099		       b9 69 c9 	      lda	atkT,y
     20  709c		       18		      clc
     21  709d		       6d 52 c4 	      adc	fxN
     22  70a0		       90 02		      bcc	.t
     23  70a2		       a9 ff		      lda	#255
     24  70a4				   .t
     25  70a4		       99 69 c9 	      sta	atkT,y
     26  70a7		       b9 6c c9 	      lda	clickOn,y
     27  70aa		       f0 21		      beq	.s
     28  70ac		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  70ae		       ae 95 c6 	      ldx	sndClick
     30  70b1		       e0 02		      cpx	#2
     31  70b3		       90 03		      bcc	.cl
     32  70b5		       ad 94 c6 	      lda	sndStepT
     33  70b8				   .cl
     34  70b8		       d9 69 c9 	      cmp	atkT,y
     35  70bb		       f0 02		      beq	.ce
     36  70bd		       b0 0e		      bcs	.s
     37  70bf				   .ce
     38  70bf		       a9 00		      lda	#0
     39  70c1		       99 6c c9 	      sta	clickOn,y
     40  70c4		       be 0d 80 	      ldx	sidOfs,y
     41  70c7		       b9 32 c3 	      lda	sidGate,y
     42  70ca		       9d 04 d4 	      sta	SID+4,x
     43  70cd				   .s
     44  70cd		       b9 62 c9 	      lda	sK,y
     45  70d0		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  70d2		       d0 19		      bne	.x
     47  70d4		       b9 69 c9 	      lda	atkT,y
     48  70d7		       cd 94 c6 	      cmp	sndStepT
     49  70da		       90 11		      bcc	.x
     50  70dc		       b9 5c c4 	      lda	sidTgtLo,y	; TIME's up: the note
