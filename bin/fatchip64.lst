      0  1170					      include	"voices.asm"
      1  1170							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  1170							;
      3  1170							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  1170							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  1170							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  1170							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  1170							; Allocation, whenever the held notes change:
      8  1170							;   1. bass voices play the lowest note, an octave down
      9  1170							;   2. every other note gets one voice, lowest notes first
     10  1170							;   3. leftover voices stack on the lowest two notes, alternating
     11  1170							; So one note = a nine-voice unison across three chips, and in chords the
     12  1170							; bottom of the chord is fattest. Disabled devices get no notes.
     13  1170
     14  1170							; ------------------------------------------------------------ SID
     15  1170				   SidInit
     16  1170					      subroutine
     17  1170		       a2 18		      ldx	#24
     18  1172		       a9 00		      lda	#0
     19  1174				   .clr
