------- FILE nesenv.asm LEVEL 2 PASS 3
      0  2a55					      include	"nesenv.asm"
      1  2a55							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  2a55							;
      3  2a55							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  2a55							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  2a55							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  2a55							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  2a55							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  2a55							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  2a55							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  2a55							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  2a55							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  2a55							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  2a55							; would wrap to a high pitch).
     14  2a55							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  2a55
     16  2a55							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  2a55							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  2a55							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  2a55							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  2a55							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  2a55		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  2a55		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  2a55							; NES channels too, and can't take a bend every 4 ms
     24  2a55		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  2a55		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  2a55
     27  2a55							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  2a55		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  2a5e		       02 05	   slotVoice  .byte.b	2,5
     30  2a60
     31  2a60							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  2a60							; note keeps sounding for now). X = voice (= t0).
     33  2a60				   NesSoftRelease
     34  2a60					      subroutine
     35  2a60		       4c 65 2a 	      jmp	.go
     36  2a63				   .nope
     37  2a63		       18		      clc
     38  2a64		       60		      rts
     39  2a65				   .go
     40  2a65		       ad 58 c8 	      lda	muteNow
     41  2a68		       0d 97 c8 	      ora	hardCut
     42  2a6b		       d0 f6		      bne	.nope
     43  2a6d		       ad eb c7 	      lda	devOn+DEV_NES
     44  2a70		       f0 f1		      beq	.nope
     45  2a72		       bd 16 99 	      lda	vDev,x
     46  2a75		       c9 02		      cmp	#DEV_NES
     47  2a77		       d0 ea		      bne	.nope
     48  2a79		       bd 5f c8 	      lda	vOut,x
     49  2a7c		       c9 ff		      cmp	#NO_NOTE
     50  2a7e		       f0 e3		      beq	.nope
     51  2a80		       ad 13 c9 	      lda	nesEnvOn
     52  2a83		       f0 78		      beq	.fo	; (no envelope: BEND OUT's fall-off, if any)
     53  2a85		       bc 55 2a 	      ldy	vEnvSlot,x
     54  2a88		       30 41		      bmi	.tri
     55  2a8a							; pulse: release from the current level; step = level x factor / 4 + 1
     56  2a8a							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
