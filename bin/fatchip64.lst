    102  0bc8
    103  0bc8							; IRQ: pace device queues onto the wire.
    104  0bc8							;
    105  0bc8							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0bc8							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0bc8							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0bc8							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0bc8							;
    110  0bc8							; When the Game Boy is on, everything on the wire also passes through the
    111  0bc8							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0bc8							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0bc8							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0bc8							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0bc8							; message, the rate measured clean.
    116  0bc8				   Schedule
    117  0bc8					      subroutine
    118  0bc8		       ad 26 c3 	      lda	devOn+DEV_GB
    119  0bcb		       f0 10		      beq	.gb
    120  0bcd		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0bcf		       f0 0c		      beq	.gb
    122  0bd1		       c6 2e		      dec	linkLoad
    123  0bd3		       f0 08		      beq	.gb
    124  0bd5		       a5 10		      lda	ticks
    125  0bd7		       29 01		      and	#1
    126  0bd9		       f0 02		      beq	.gb
    127  0bdb		       c6 2e		      dec	linkLoad
    128  0bdd				   .gb
    129  0bdd							; ---- Game Boy
    130  0bdd		       a5 18		      lda	gbqTail
    131  0bdf		       c5 17		      cmp	gbqHead
    132  0be1		       f0 36		      beq	.nes
    133  0be3		       a5 19		      lda	gbNext
    134  0be5		       38		      sec
    135  0be6		       e5 10		      sbc	ticks
    136  0be8		       f0 04		      beq	.gbDue
    137  0bea		       c9 04		      cmp	#GB_GAP+1
    138  0bec		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0bee				   .gbDue
    140  0bee							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0bee							; bytes already waiting would otherwise delay this one and squeeze it
    142  0bee							; against the next). While a Game Boy message is due, the NES doesn't
    143  0bee							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0bee							; holding its notes back.
    145  0bee		       a5 15		      lda	wireHead
    146  0bf0		       c5 16		      cmp	wireTail
    147  0bf2		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0bf4		       20 5a 0c 	      jsr	LinkRoom
    149  0bf7		       90 20		      bcc	.nes
    150  0bf9		       a6 18		      ldx	gbqTail
    151  0bfb		       bd 00 c1 	      lda	gbqS,x
    152  0bfe		       bc 80 c1 	      ldy	gbqD2,x
    153  0c01		       84 2c		      sty	irqT
    154  0c03		       bc 40 c1 	      ldy	gbqD1,x
    155  0c06		       20 76 0c 	      jsr	WireMsg
    156  0c09		       a5 18		      lda	gbqTail
    157  0c0b		       18		      clc
    158  0c0c		       69 01		      adc	#1
    159  0c0e		       29 3f		      and	#63
    160  0c10		       85 18		      sta	gbqTail
    161  0c12		       a5 10		      lda	ticks
    162  0c14		       18		      clc
    163  0c15		       69 03		      adc	#GB_GAP
    164  0c17		       85 19		      sta	gbNext
    165  0c19				   .nes
    166  0c19		       20 c5 2e 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0c1c		       a5 1b		      lda	nesqTail
    168  0c1e		       c5 1a		      cmp	nesqHead
    169  0c20		       f0 37		      beq	.done
    170  0c22		       a5 1c		      lda	nesNext
    171  0c24		       38		      sec
    172  0c25		       e5 10		      sbc	ticks
    173  0c27		       f0 04		      beq	.nesDue
    174  0c29		       c9 02		      cmp	#NES_GAP+1
    175  0c2b		       90 2c		      bcc	.done
    176  0c2d				   .nesDue
    177  0c2d		       20 6d 0c 	      jsr	WireFree
    178  0c30		       c9 03		      cmp	#3
    179  0c32		       90 25		      bcc	.done
    180  0c34		       20 5a 0c 	      jsr	LinkRoom
    181  0c37		       90 20		      bcc	.done
    182  0c39		       a6 1b		      ldx	nesqTail
    183  0c3b		       bd c0 c1 	      lda	nesqS,x
    184  0c3e		       bc 40 c2 	      ldy	nesqD2,x
    185  0c41		       84 2c		      sty	irqT
    186  0c43		       bc 00 c2 	      ldy	nesqD1,x
    187  0c46		       20 76 0c 	      jsr	WireMsg
    188  0c49		       a5 1b		      lda	nesqTail
    189  0c4b		       18		      clc
    190  0c4c		       69 01		      adc	#1
    191  0c4e		       29 3f		      and	#63
    192  0c50		       85 1b		      sta	nesqTail
    193  0c52		       a5 10		      lda	ticks
    194  0c54		       18		      clc
    195  0c55		       69 01		      adc	#NES_GAP
    196  0c57		       85 1c		      sta	nesNext
    197  0c59				   .done
    198  0c59		       60		      rts
