------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  36d2					      include	"sounds.asm"
      1  36d2							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  36d2							;
      3  36d2							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  36d2							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  36d2							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  36d2							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  36d2							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  36d2							;
      9  36d2							; Each sound has a mono default and a Fat Bass default:
     10  36d2							;   MONO      one note (the last key pressed and still held) on every voice;
     11  36d2							;	       a new key while another is held changes the pitch without a
     12  36d2							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  36d2							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  36d2							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  36d2							;	       the other voices
     16  36d2							;
     17  36d2							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  36d2							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  36d2							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  36d2
     21  36d2							; ------------------------------------------------------------ choosing
     22  36d2							; V: next sound (SHIFT+V: previous)
     23  36d2				   SoundKey
     24  36d2					      subroutine
     25  36d2		       20 4c 37 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  36d5		       ae 94 c3 	      ldx	soundMode
     27  36d8		       ad 2a c3 	      lda	shiftDown
     28  36db		       d0 09		      bne	.prev
     29  36dd		       e8		      inx
     30  36de		       e0 13		      cpx	#NUM_SOUNDS
     31  36e0		       90 09		      bcc	.s
     32  36e2		       a2 00		      ldx	#0
     33  36e4		       f0 05		      beq	.s
     34  36e6				   .prev
     35  36e6		       ca		      dex
     36  36e7		       10 02		      bpl	.s
     37  36e9		       a2 12		      ldx	#NUM_SOUNDS-1
     38  36eb				   .s
