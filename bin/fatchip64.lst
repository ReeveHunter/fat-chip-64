     74  0bca							; IRQ: send one wire byte if the ACIA is ready.
     75  0bca				   TxByte
     76  0bca					      subroutine
     77  0bca		       a6 16		      ldx	wireTail
     78  0bcc		       e4 15		      cpx	wireHead
     79  0bce		       f0 0f		      beq	.done
     80  0bd0		       ad 06 de 	      lda	ACIA_STAT
     81  0bd3		       29 02		      and	#ACIA_TDRE
     82  0bd5		       f0 08		      beq	.done
     83  0bd7		       bd 00 c0 	      lda	wireBuf,x
     84  0bda		       8d 05 de 	      sta	ACIA_TX
     85  0bdd		       e6 16		      inc	wireTail
     86  0bdf				   .done
     87  0bdf		       60		      rts
     88  0be0
     89  0be0							; Main loop: same, with interrupts off around it.
     90  0be0				   TxService
     91  0be0					      subroutine
     92  0be0		       a5 2f		      lda	midiIrq	; (the MIDI chip's interrupts do it)
     93  0be2		       f0 01		      beq	.poll
     94  0be4		       60		      rts
     95  0be5				   .poll
     96  0be5		       08		      php
     97  0be6		       78		      sei
     98  0be7		       20 ca 0b 	      jsr	TxByte
     99  0bea		       20 d1 2f 	      jsr	RxByte
    100  0bed		       28		      plp
    101  0bee		       60		      rts
    102  0bef
    103  0bef							; IRQ: pace device queues onto the wire.
    104  0bef							;
    105  0bef							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0bef							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0bef							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0bef							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0bef							;
    110  0bef							; When the Game Boy is on, everything on the wire also passes through the
    111  0bef							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0bef							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0bef							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0bef							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0bef							; message, the rate measured clean.
    116  0bef				   Schedule
    117  0bef					      subroutine
    118  0bef		       ad 26 c3 	      lda	devOn+DEV_GB
    119  0bf2		       f0 10		      beq	.gb
    120  0bf4		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0bf6		       f0 0c		      beq	.gb
    122  0bf8		       c6 2e		      dec	linkLoad
