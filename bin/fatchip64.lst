     58  3d33		       ed 7b c4 	      sbc	dmcAt+1
     59  3d36		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  3d38		       c0 0c		      cpy	#DRUM_WINDOW
     61  3d3a		       b0 08		      bcs	.ok
     62  3d3c		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     63  3d3e		       cd 79 c4 	      cmp	dmcPrio
     64  3d41		       90 01		      bcc	.ok
     65  3d43		       60		      rts
     66  3d44				   .ok
