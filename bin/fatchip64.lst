      0  0bc3					      include	"midi.asm"
      1  0bc3							; Fat Chip 64 - MIDI out
      2  0bc3							;
      3  0bc3							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0bc3							; at most one message per device onto the wire buffer, no sooner than that
      5  0bc3							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0bc3							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0bc3							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0bc3							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0bc3							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0bc3
     11  0bc3				   MidiInit
     12  0bc3					      subroutine
     13  0bc3		       a9 03		      lda	#ACIA_RESET
     14  0bc5		       8d 04 de 	      sta	ACIA_CTRL
     15  0bc8		       a9 16		      lda	#ACIA_MODE
     16  0bca		       8d 04 de 	      sta	ACIA_CTRL
     17  0bcd							; (fall into the test)
     18  0bcd
     19  0bcd							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0bcd							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0bcd							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0bcd							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0bcd							; before. Interrupts are off when this is called.
     24  0bcd				   MidiIrqTest
     25  0bcd					      subroutine
     26  0bcd		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0bcf		       8d 0d dc 	      sta	CIA1_ICR
     28  0bd2		       ad 0d dc 	      lda	CIA1_ICR
     29  0bd5		       a9 1d		      lda	#<IrqTest
     30  0bd7		       8d fe ff 	      sta	$FFFE
     31  0bda		       a9 0c		      lda	#>IrqTest
     32  0bdc		       8d ff ff 	      sta	$FFFF
     33  0bdf		       a9 00		      lda	#0
     34  0be1		       85 2f		      sta	midiIrq
     35  0be3		       a9 b6		      lda	#ACIA_MODE_TX
     36  0be5		       8d 04 de 	      sta	ACIA_CTRL
     37  0be8		       58		      cli
     38  0be9		       a2 00		      ldx	#0
     39  0beb				   .w
     40  0beb		       ca		      dex
     41  0bec		       d0 fd		      bne	.w
     42  0bee		       78		      sei
     43  0bef		       a6 2f		      ldx	midiIrq
     44  0bf1		       bd 29 0c 	      lda	midiCtl,x
     45  0bf4		       8d 04 de 	      sta	ACIA_CTRL
     46  0bf7		       bd 2b 0c 	      lda	irqLo,x
     47  0bfa		       8d fe ff 	      sta	$FFFE
     48  0bfd		       bd 2d 0c 	      lda	irqHi,x
     49  0c00		       8d ff ff 	      sta	$FFFF
     50  0c03		       bd 2f 0c 	      lda	latchLo,x
     51  0c06		       8d 04 dc 	      sta	CIA1_TALO
     52  0c09		       bd 31 0c 	      lda	latchHi,x
     53  0c0c		       8d 05 dc 	      sta	CIA1_TAHI
     54  0c0f		       a9 11		      lda	#$11	; start, force load, continuous
     55  0c11		       8d 0e dc 	      sta	CIA1_CRA
     56  0c14		       ad 0d dc 	      lda	CIA1_ICR
     57  0c17		       a9 81		      lda	#$81	; timer A interrupt on
     58  0c19		       8d 0d dc 	      sta	CIA1_ICR
     59  0c1c		       60		      rts
     60  0c1d				   IrqTest
     61  0c1d		       48		      pha
     62  0c1e		       a9 01		      lda	#1
     63  0c20		       85 2f		      sta	midiIrq
     64  0c22		       a9 16		      lda	#ACIA_MODE	; (quiet again)
     65  0c24		       8d 04 de 	      sta	ACIA_CTRL
     66  0c27		       68		      pla
     67  0c28		       40		      rti
     68  0c29		       16 96	   midiCtl    .byte.b	ACIA_MODE, ACIA_MODE_RX
     69  0c2b		       03 51	   irqLo      .byte.b	<Irq, <IrqMidi
     70  0c2d		       0b 0b	   irqHi      .byte.b	>Irq, >IrqMidi
     71  0c2f		       ff ff	   latchLo    .byte.b	<TICK_LATCH, <TICK_LATCH_MS
     72  0c31		       00 03	   latchHi    .byte.b	>TICK_LATCH, >TICK_LATCH_MS
