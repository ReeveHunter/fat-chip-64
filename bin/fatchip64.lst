    334  0a95		       20 cb 2e 	      jsr	RxGot
    335  0a98				   .noRx
    336  0a98		       a6 16		      ldx	wireTail
    337  0a9a		       e4 15		      cpx	wireHead
    338  0a9c		       f0 0f		      beq	.noByte
    339  0a9e		       ad 06 de 	      lda	ACIA_STAT
    340  0aa1		       29 02		      and	#ACIA_TDRE
