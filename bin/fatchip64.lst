     55  3718		       ed 7a c4 	      sbc	dmcAt
     56  371b		       a8		      tay
     57  371c		       ad 3f c3 	      lda	nowH
     58  371f		       ed 7b c4 	      sbc	dmcAt+1
     59  3722		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  3724		       c0 0c		      cpy	#DRUM_WINDOW
     61  3726		       b0 08		      bcs	.ok
     62  3728		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     63  372a		       cd 79 c4 	      cmp	dmcPrio
     64  372d		       90 01		      bcc	.ok
     65  372f		       60		      rts
     66  3730				   .ok
     67  3730							; the sample: kit[beat][kitOfs[kind] + level, or + tom]
     68  3730		       ae 83 c4 	      ldx	drumKind
     69  3733		       bd ac 37 	      lda	kitOfs,x
     70  3736		       e0 05		      cpx	#DK_TOM
     71  3738		       d0 07		      bne	.lv
