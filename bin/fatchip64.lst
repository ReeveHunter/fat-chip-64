------- FILE repeat.asm LEVEL 2 PASS 3
      0  4379					      include	"repeat.asm"
      1  4379							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  4379							;
      3  4379							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  4379							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  4379							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  4379							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  4379							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  4379							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  4379							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  4379							; 3/4 of the time between echoes. The SID doesn't echo.
     11  4379							;
     12  4379							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  4379							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  4379							; or a keytar button).
     15  4379							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  4379							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  4379
     18  4379		       00 10	   RP_SLOTS   equ	16
     19  4379		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  4379
     21  4379							; REPEAT is on now?
     22  4379				   RepeatActive
     23  4379		       ad 4c c5 	      lda	repeatOn
     24  437c		       0d ac c4 	      ora	actCnt+A_REPEAT
     25  437f		       60		      rts
