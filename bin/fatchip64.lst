    103  0c48
    104  0c48							; IRQ: pace device queues onto the wire.
    105  0c48							;
    106  0c48							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    107  0c48							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    108  0c48							; times as signed numbers, so after 33 s of silence every queue froze for
    109  0c48							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    110  0c48							;
    111  0c48							; When the Game Boy is on, everything on the wire also passes through the
    112  0c48							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    113  0c48							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    114  0c48							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    115  0c48							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    116  0c48							; message, the rate measured clean.
    117  0c48				   Schedule
    118  0c48					      subroutine
    119  0c48		       ad ea c7 	      lda	devOn+DEV_GB
    120  0c4b		       f0 10		      beq	.gb
    121  0c4d		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    122  0c4f		       f0 0c		      beq	.gb
    123  0c51		       c6 2e		      dec	linkLoad
    124  0c53		       f0 08		      beq	.gb
    125  0c55		       a5 10		      lda	ticks
    126  0c57		       29 01		      and	#1
    127  0c59		       f0 02		      beq	.gb
    128  0c5b		       c6 2e		      dec	linkLoad
    129  0c5d				   .gb
    130  0c5d							; ---- Game Boy
    131  0c5d		       a5 18		      lda	gbqTail
    132  0c5f		       c5 17		      cmp	gbqHead
    133  0c61		       f0 3d		      beq	.nes
    134  0c63		       a5 19		      lda	gbNext
    135  0c65		       38		      sec
    136  0c66		       e5 10		      sbc	ticks
    137  0c68		       f0 04		      beq	.gbDue
    138  0c6a		       c9 04		      cmp	#GB_GAP+1
    139  0c6c		       90 32		      bcc	.nes	; 1..GB_GAP ms to go
    140  0c6e				   .gbDue
    141  0c6e							; only onto an empty wire, so the gap holds on the cable itself (NES
    142  0c6e							; bytes already waiting would otherwise delay this one and squeeze it
    143  0c6e							; against the next). While a Game Boy message is due, the NES doesn't
    144  0c6e							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    145  0c6e							; holding its notes back.
    146  0c6e		       20 6d 3a 	      jsr	RxByte	; (v0.66: MIDI in now too: the Game Boy's message
    147  0c71							;  and the NES's after it outlast a byte's time)
    148  0c71		       a5 15		      lda	wireHead
    149  0c73		       c5 16		      cmp	wireTail
    150  0c75		       d0 69		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    151  0c77		       20 e1 0c 	      jsr	LinkRoom
    152  0c7a		       90 24		      bcc	.nes
    153  0c7c		       a9 ff		      lda	#$FF	; v0.64: every Game Boy message carries its status
    154  0c7e		       85 14		      sta	lastStatus	; byte (no running status): the link drops a byte
    155  0c80		       a6 18		      ldx	gbqTail	; now and then, and in a run of nothing but drum
    156  0c82		       bd 00 c5 	      lda	gbqS,x	; notes that left every later note out of step
    157  0c85		       bc 00 c6 	      ldy	gbqD2,x
    158  0c88		       84 2c		      sty	irqT
    159  0c8a		       bc 80 c5 	      ldy	gbqD1,x
    160  0c8d		       20 fd 0c 	      jsr	WireMsg
    161  0c90		       a5 18		      lda	gbqTail
    162  0c92		       18		      clc
    163  0c93		       69 01		      adc	#1
    164  0c95		       29 7f		      and	#127
    165  0c97		       85 18		      sta	gbqTail
    166  0c99		       a5 10		      lda	ticks
    167  0c9b		       18		      clc
    168  0c9c		       69 03		      adc	#GB_GAP
    169  0c9e		       85 19		      sta	gbNext
    170  0ca0				   .nes
    171  0ca0		       20 6d 3a 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    172  0ca3		       a5 1b		      lda	nesqTail
    173  0ca5		       c5 1a		      cmp	nesqHead
    174  0ca7		       f0 37		      beq	.done
    175  0ca9		       a5 1c		      lda	nesNext
    176  0cab		       38		      sec
    177  0cac		       e5 10		      sbc	ticks
    178  0cae		       f0 04		      beq	.nesDue
    179  0cb0		       c9 02		      cmp	#NES_GAP+1
    180  0cb2		       90 2c		      bcc	.done
    181  0cb4				   .nesDue
    182  0cb4		       20 f4 0c 	      jsr	WireFree
    183  0cb7		       c9 03		      cmp	#3
    184  0cb9		       90 25		      bcc	.done
