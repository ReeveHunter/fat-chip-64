------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  4d81					      include	"sync.asm"
      1  4d81							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  4d81							;
      3  4d81							; Menu, DEVICE SYNC (defaults first):
      4  4d81							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  4d81							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  4d81							;		     sets the tempo, averaged over beats (the clock jitters about
      7  4d81							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  4d81							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  4d81							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  4d81							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  4d81							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  4d81							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  4d81							;		     picks a beat demo (styleBeat)
     14  4d81							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  4d81							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  4d81							;		     key channel) picks a sound (voiceSound)
     17  4d81							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  4d81							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  4d81							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  4d81							;
     21  4d81							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  4d81							; 1/4 ms); a Start makes the next clock a beat.
     23  4d81
     24  4d81		       00 00	   TEMPO_KEYTAR equ	0
     25  4d81		       00 01	   TEMPO_OWN  equ	1
     26  4d81		       00 02	   TEMPO_SC   equ	2
     27  4d81		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  4d81
     29  4d81
     30  4d81
