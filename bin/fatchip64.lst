------- FILE main.asm LEVEL 1 PASS 2
      1  25e1 ????						; Fat Chip 64 - main program
      2  25e1 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  25e1 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  25e1 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  25e1 ????
      6  25e1 ????				      processor	6502
