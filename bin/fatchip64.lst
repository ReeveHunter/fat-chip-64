      0  8a2b					      include	"nestables.asm"
      1  8a2b							; generated by tools/gen_tables.py (NES part) - do not edit
      2  8a2b							; MidiNES triangle release drop: -24 semitones over 50 steps (5 ms each = 250 ms), slow at first
      3  8a2b							; triPb: MidiNES triangle bend scale per MIDI note, p(n) = 1710 * 0.5^((n - 36) / 12)
      4  8a2b							; triDropH: (2 * 2^(s/12) - 2) * 1024 for the drop s at each step; bend = -(p * h) / 1024
      5  8a2b							; triDropS8: the drop at each step in eighths of a semitone (for the floor check)
      6  8a2b		       00 32	   TRI_STEPS  equ	50
