    411  3afb							; A data byte (A) inside a SysEx
    412  3afb				   SysexByte
    413  3afb					      subroutine
    414  3afb		       ae 52 c7 	      ldx	sxPos
    415  3afe		       e0 03		      cpx	#3	; the command: 1 a patch, 2 the chips on / off
    416  3b00		       d0 0b		      bne	.nc
    417  3b02		       c9 02		      cmp	#2
    418  3b04		       d0 07		      bne	.nc
    419  3b06		       8d 21 c8 	      sta	sxCmd
    420  3b09		       ee 52 c7 	      inc	sxPos
    421  3b0c		       60		      rts
    422  3b0d				   .nc
    423  3b0d		       ac 21 c8 	      ldy	sxCmd
    424  3b10		       c0 02		      cpy	#2
    425  3b12		       d0 0b		      bne	.pat
    426  3b14		       e0 04		      cpx	#4	; 2: one byte, bit 0 SID, 1 Game Boy, 2 NES
    427  3b16		       d0 39		      bne	.no
    428  3b18		       8d 22 c8 	      sta	sxArg
    429  3b1b		       ee 52 c7 	      inc	sxPos
