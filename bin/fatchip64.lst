------- FILE main.asm
------- FILE repeat.asm LEVEL 2 PASS 3
      0  49b2					      include	"repeat.asm"
      1  49b2							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  49b2							;
      3  49b2							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  49b2							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  49b2							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  49b2							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  49b2							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  49b2							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  49b2							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  49b2							; 3/4 of the time between echoes. The SID doesn't echo.
     11  49b2							;
     12  49b2							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  49b2							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  49b2							; or a keytar button).
     15  49b2							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  49b2							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  49b2
     18  49b2		       00 10	   RP_SLOTS   equ	16
     19  49b2		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  49b2
     21  49b2							; REPEAT is on now?
     22  49b2				   RepeatActive
     23  49b2		       ad 50 c5 	      lda	repeatOn
     24  49b5		       0d b0 c4 	      ora	actCnt+A_REPEAT
     25  49b8		       60		      rts
     26  49b9
