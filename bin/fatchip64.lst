      0  7766					      include	"viz.asm"
      1  7766							; Fat Chip 64 - the visualizer (F7: GLITCH on / off; v0.28 dropped the BARS)
      2  7766							;
      3  7766							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
      4  7766							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
      5  7766							; keep spattering more; runs of the screen get copied over other places
      6  7766							; (datamosh) and wiped away, so it fills while you play and dissolves when
      7  7766							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
      8  7766							; the background. VINYL STOP drags it down the screen.
      9  7766
     10  7766		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     11  7766		       00 16	   VIZ_NAMES  equ	22	; note names
     12  7766		       00 a0	   VIZ_FULL   equ	160	; reversed space
     13  7766		       00 62	   VIZ_HALF   equ	98	; lower half block
     14  7766
