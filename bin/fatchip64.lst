      1  0ed9							; Fat Chip 64 - keyboard and RESTORE
      2  0ed9
      3  0ed9							; Scan the whole matrix, turn changes into key events.
      4  0ed9							;
      5  0ed9							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0ed9							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0ed9							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0ed9							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0ed9							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0ed9							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0ed9							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0ed9							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0ed9							; chords whose ghost lands on another used key lose their newest note.
     14  0ed9				   KeyScan
     15  0ed9					      subroutine
     16  0ed9		       a2 07		      ldx	#7
     17  0edb				   .col
     18  0edb		       bd 1b 82 	      lda	colSelect,x
     19  0ede		       8d 00 dc 	      sta	CIA1_PRA
     20  0ee1		       ad 01 dc 	      lda	CIA1_PRB
     21  0ee4		       49 ff		      eor	#$FF
     22  0ee6		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0ee9		       9d 80 c2 	      sta	keyNow,x
     24  0eec		       ca		      dex
     25  0eed		       10 ec		      bpl	.col
     26  0eef		       a9 ff		      lda	#$FF
     27  0ef1		       8d 00 dc 	      sta	CIA1_PRA
     28  0ef4							; ---- every column as accepted (nothing pressed or let go): done
     29  0ef4		       a2 07		      ldx	#7
     30  0ef6				   .same
     31  0ef6		       bd 80 c2 	      lda	keyNow,x
     32  0ef9		       dd 90 c2 	      cmp	keyAcc,x
     33  0efc		       d0 04		      bne	.changed
     34  0efe		       ca		      dex
     35  0eff		       10 f5		      bpl	.same
     36  0f01		       60		      rts
     37  0f02				   .changed
     38  0f02							; ---- releases first: accepted keys that are up now
     39  0f02		       a2 00		      ldx	#0
     40  0f04				   .rc
     41  0f04		       8e 38 c3 	      stx	ksCol
     42  0f07		       bd 80 c2 	      lda	keyNow,x
     43  0f0a		       49 ff		      eor	#$FF
     44  0f0c		       3d 90 c2 	      and	keyAcc,x
     45  0f0f		       8d 37 c3 	      sta	ksBits
     46  0f12		       a9 00		      lda	#0
     47  0f14		       8d 39 c3 	      sta	ksRow
     48  0f17				   .rb
     49  0f17		       ad 37 c3 	      lda	ksBits
     50  0f1a		       f0 21		      beq	.rcn
     51  0f1c		       4e 37 c3 	      lsr	ksBits
     52  0f1f		       90 17		      bcc	.rbn
     53  0f21		       ae 38 c3 	      ldx	ksCol
     54  0f24		       ac 39 c3 	      ldy	ksRow
     55  0f27		       b9 23 82 	      lda	rowBit,y
     56  0f2a		       49 ff		      eor	#$FF
     57  0f2c		       3d 90 c2 	      and	keyAcc,x
     58  0f2f		       9d 90 c2 	      sta	keyAcc,x
     59  0f32		       20 d8 0f 	      jsr	KeyCode
     60  0f35		       20 e9 18 	      jsr	KeyUp
     61  0f38				   .rbn
     62  0f38		       ee 39 c3 	      inc	ksRow
     63  0f3b		       d0 da		      bne	.rb
     64  0f3d				   .rcn
     65  0f3d		       ae 38 c3 	      ldx	ksCol
     66  0f40		       e8		      inx
     67  0f41		       e0 08		      cpx	#8
     68  0f43		       d0 bf		      bne	.rc
     69  0f45							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0f45							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0f45							; still count as a combination.
     72  0f45		       a9 00		      lda	#0
     73  0f47		       8d 3b c3 	      sta	ksPass
     74  0f4a				   .pass
     75  0f4a		       a2 00		      ldx	#0
     76  0f4c				   .pc
     77  0f4c		       8e 38 c3 	      stx	ksCol
     78  0f4f		       bd 90 c2 	      lda	keyAcc,x
     79  0f52		       49 ff		      eor	#$FF
     80  0f54		       3d 80 c2 	      and	keyNow,x
     81  0f57		       8d 37 c3 	      sta	ksBits
     82  0f5a		       a9 00		      lda	#0
     83  0f5c		       8d 39 c3 	      sta	ksRow
     84  0f5f				   .pb
     85  0f5f		       ad 37 c3 	      lda	ksBits
     86  0f62		       f0 49		      beq	.pcn
     87  0f64		       4e 37 c3 	      lsr	ksBits
     88  0f67		       90 3f		      bcc	.pbn
     89  0f69		       ad 3c c3 	      lda	ghostFilter
     90  0f6c		       d0 0c		      bne	.chk	; filter off (default): phantom notes play...
     91  0f6e		       20 d8 0f 	      jsr	KeyCode
     92  0f71		       c9 18		      cmp	#24
     93  0f73		       90 0a		      bcc	.accept
     94  0f75		       20 c1 0f 	      jsr	IsModifier
     95  0f78		       f0 05		      beq	.accept
     96  0f7a				   .chk 		; ...but a command key never comes from a phantom
     97  0f7a		       20 e6 0f 	      jsr	Suspect	;  (v0.40: Q + E held, then C=, read C= + S too)
     98  0f7d		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     99  0f7f				   .accept
    100  0f7f		       20 d8 0f 	      jsr	KeyCode
    101  0f82		       20 c1 0f 	      jsr	IsModifier	; Z set = modifier
    102  0f85		       f0 07		      beq	.mod
    103  0f87		       ad 3b c3 	      lda	ksPass
    104  0f8a		       f0 1c		      beq	.pbn	; pass 0: modifiers only
    105  0f8c		       d0 05		      bne	.take
    106  0f8e				   .mod
    107  0f8e		       ad 3b c3 	      lda	ksPass
    108  0f91		       d0 15		      bne	.pbn	; (taken in pass 0)
    109  0f93				   .take
    110  0f93		       ae 38 c3 	      ldx	ksCol
    111  0f96		       ac 39 c3 	      ldy	ksRow
    112  0f99		       b9 23 82 	      lda	rowBit,y
    113  0f9c		       1d 90 c2 	      ora	keyAcc,x
    114  0f9f		       9d 90 c2 	      sta	keyAcc,x
    115  0fa2		       20 d8 0f 	      jsr	KeyCode
    116  0fa5		       20 17 10 	      jsr	KeyDown
    117  0fa8				   .pbn
    118  0fa8		       ee 39 c3 	      inc	ksRow
    119  0fab		       d0 b2		      bne	.pb
    120  0fad				   .pcn
    121  0fad		       ae 38 c3 	      ldx	ksCol
    122  0fb0		       e8		      inx
    123  0fb1		       e0 08		      cpx	#8
    124  0fb3		       d0 97		      bne	.pc
    125  0fb5		       ad 3b c3 	      lda	ksPass
    126  0fb8		       d0 06		      bne	.done
    127  0fba		       ee 3b c3 	      inc	ksPass
    128  0fbd		       4c 4a 0f 	      jmp	.pass
    129  0fc0				   .done
    130  0fc0		       60		      rts
