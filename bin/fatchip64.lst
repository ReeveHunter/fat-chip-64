------- FILE bend.asm LEVEL 2 PASS 3
      0  227b					      include	"bend.asm"
      1  227b							; Fat Chip 64 - bends (SPACE / the keytar's buttons and wheel), v0.13
      2  227b							;
      3  227b							; What everything is bent by: m = 0-192 sixteenths of a semitone (an octave
      4  227b							; at most), up or down (bendMag, bendUp), from three things added together:
      5  227b							;   the BEND DOWN / BEND UP actions (SPACE or a keytar button, held): bendLvl
      6  227b							;     0-255 ramps up over about 1 s while held, back over about 0.5 s; full =
      7  227b							;     the menu's BEND RANGE (1-12 semitones, default 2)
      8  227b							;   the keytar's wheel: wheelMag 0-255 up or down, full = BEND RANGE
      9  227b							;   VINYL STOP (held): vinylLvl 0-255 the same way, full = an octave down
     10  227b							;     (and the beat demo and arp slow to half speed with it)
     11  227b							; Then:
     12  227b							;   SID       its frequency x 2^(+-m/192), from tables (bendtab.asm)
     13  227b							;   Game Boy  bend range 12 (CC 85, sent with the sound), bend = 8192 +- m x 8192 / 192
     14  227b							;   MidiNES   p(n) x the table / 8192 for the triangle, twice for the pulses
     15  227b							;	       (p = the MidiNES triangle bend scale, 1710 at MIDI 36); notes
     16  227b							;	       without room at the bottom of the NES range don't bend down.
     17  227b							; Bends go out every BEND_TICK ms at most, and before each new NES note.
     18  227b
     19  227b							; , : SPACE's action back
     20  227b				   SpaceBack
     21  227b					      subroutine
     22  227b		       ae d4 c3 	      ldx	spaceAct
