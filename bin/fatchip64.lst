    373  0af5		       ad 06 de 	      lda	ACIA_STAT
    374  0af8		       29 02		      and	#ACIA_TDRE
    375  0afa		       f0 08		      beq	.noByte
    376  0afc		       bd 00 c0 	      lda	wireBuf,x
    377  0aff		       8d 05 de 	      sta	ACIA_TX
    378  0b02		       e6 16		      inc	wireTail
    379  0b04				   .noByte
    380  0b04		       c6 2d		      dec	subTick
    381  0b06		       10 22		      bpl	.out
    382  0b08		       a9 03		      lda	#3
    383  0b0a		       85 2d		      sta	subTick
    384  0b0c		       98		      tya
    385  0b0d		       48		      pha
    386  0b0e		       e6 10		      inc	ticks
    387  0b10		       d0 02		      bne	.t
    388  0b12		       e6 11		      inc	ticks+1
    389  0b14				   .t
    390  0b14		       ad 99 c9 	      lda	sidVolNow	; (the SID's volume: a step towards its target)
    391  0b17		       cd 9a c9 	      cmp	sidVolTgt
    392  0b1a		       f0 03		      beq	.vs
    393  0b1c		       20 75 1a 	      jsr	VolSlew
