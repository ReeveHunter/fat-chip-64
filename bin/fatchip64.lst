     46  8027		       0d 39 c5 	      ora	nfxGlide
     47  802a		       0d 3a c5 	      ora	nfxRun
     48  802d		       0d f3 c9 	      ora	nfxWarb
     49  8030		       d0 01		      bne	.on
     50  8032				   .q
     51  8032		       60		      rts
     52  8033				   .on
     53  8033		       a5 10		      lda	ticks
     54  8035		       38		      sec
     55  8036		       ed 35 c5 	      sbc	nfxLast
     56  8039		       c9 08		      cmp	#NFX_EVERY
     57  803b		       b0 01		      bcs	.go
     58  803d		       60		      rts
     59  803e				   .go
