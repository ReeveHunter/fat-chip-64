    388  3cb8		       8e 19 cc 	      stx	sxOn
    389  3cbb		       c9 f7		      cmp	#$F7
    390  3cbd		       d0 13		      bne	.x
    391  3cbf		       ae e9 cc 	      ldx	sxCmd
    392  3cc2		       e0 02		      cpx	#2
    393  3cc4		       f0 0d		      beq	.dev
    394  3cc6		       ae 1a cc 	      ldx	sxPos
    395  3cc9		       e0 db		      cpx	#SX_LEN
    396  3ccb		       d0 05		      bne	.x
    397  3ccd		       48		      pha
    398  3cce		       20 64 3d 	      jsr	PatchReceived
    399  3cd1		       68		      pla
    400  3cd2				   .x
