    393  3cc3							; A data byte (A) inside a SysEx
    394  3cc3				   SysexByte
    395  3cc3					      subroutine
    396  3cc3		       ae 18 cc 	      ldx	sxPos
    397  3cc6		       e0 03		      cpx	#3	; the command: 1 a patch, 2 the chips on / off
    398  3cc8		       d0 0b		      bne	.nc
    399  3cca		       c9 02		      cmp	#2
    400  3ccc		       d0 07		      bne	.nc
    401  3cce		       8d e7 cc 	      sta	sxCmd
    402  3cd1		       ee 18 cc 	      inc	sxPos
    403  3cd4		       60		      rts
    404  3cd5				   .nc
    405  3cd5		       ac e7 cc 	      ldy	sxCmd
    406  3cd8		       c0 02		      cpy	#2
    407  3cda		       d0 0b		      bne	.pat
    408  3cdc		       e0 04		      cpx	#4	; 2: one byte, bit 0 SID, 1 Game Boy, 2 NES
    409  3cde		       d0 39		      bne	.no
