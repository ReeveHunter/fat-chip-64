      2  3cf7							;
      3  3cf7							; Two sources, one kit:
      4  3cf7							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  3cf7							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  3cf7							;			   64 = hit, 56 = ghost)
      7  3cf7							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  3cf7							;			   RETURN starts / stops it, at its own tempo (B taps
      9  3cf7							;			   a new one)
     10  3cf7							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  3cf7							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  3cf7							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  3cf7							; a note-on, then a note-off after the sound's length, the level set with
     14  3cf7							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  3cf7							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  3cf7
     17  3cf7		       00 0c	   KIT_SIZE   equ	12
     18  3cf7		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  3cf7		       00 00	   DK_KICK    equ	0
     20  3cf7		       00 01	   DK_SNARE   equ	1
     21  3cf7		       00 02	   DK_CH      equ	2
     22  3cf7		       00 03	   DK_OH      equ	3
     23  3cf7		       00 04	   DK_CY      equ	4
     24  3cf7		       00 05	   DK_TOM     equ	5
     25  3cf7		       00 06	   DK_PERC    equ	6
     26  3cf7
     27  3cf7							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  3cf7				   DrumHit
     29  3cf7					      subroutine
     30  3cf7		       8d 83 c4 	      sta	drumKind
