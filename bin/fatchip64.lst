------- FILE main.asm
------- FILE voices.asm LEVEL 2 PASS 3
      0  19eb					      include	"voices.asm"
      1  19eb							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  19eb							;
      3  19eb							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  19eb							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  19eb							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  19eb							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  19eb							; Allocation, whenever the held notes change. Who comes first (v0.21):
      8  19eb							; Polyphony > Fat Bass > the patch's effects (REPEAT's echoes) > stacking.
      9  19eb							;   1. every note gets a voice (SPARKLE's arp pair is what you play, so it
     10  19eb							;	counts as notes and goes first)
     11  19eb							;   2. Fat Bass: as many bass voices as are spare play the lowest note,
     12  19eb							;	folded into the bass range (one note fewer needs a voice, so with
     13  19eb							;	Fat Bass the bottom of the chord is the bass)
     14  19eb							;   3. REPEAT's echo voices: one or two of what's still spare
     15  19eb							;   4. leftover voices stack on the lowest two notes, alternating
     16  19eb							; So one note = a nine-voice unison across three chips, and in chords the
     17  19eb							; bottom of the chord is fattest. Disabled devices, and voices the drums
     18  19eb							; hold (vDrum), get no notes.
     19  19eb
     20  19eb							; ------------------------------------------------------------ SID
     21  19eb				   SidInit
     22  19eb					      subroutine
     23  19eb		       a2 18		      ldx	#24
     24  19ed		       a9 00		      lda	#0
     25  19ef				   .clr
     26  19ef		       9d 00 d4 	      sta	SID,x
     27  19f2		       ca		      dex
     28  19f3		       10 fa		      bpl	.clr
     29  19f5		       20 18 1a 	      jsr	SidVolume
     30  19f8		       a2 02		      ldx	#2
     31  19fa				   .v
     32  19fa		       bc 97 80 	      ldy	sidOfs,x
     33  19fd		       a9 19		      lda	#$19	; attack 1, decay 9
     34  19ff		       99 05 d4 	      sta	SID+5,y
     35  1a02		       a9 c9		      lda	#$C9	; sustain 12, release 9
     36  1a04		       99 06 d4 	      sta	SID+6,y
     37  1a07		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     38  1a09		       99 03 d4 	      sta	SID+3,y
     39  1a0c		       a9 20		      lda	#$20	; sawtooth, gate off
     40  1a0e		       9d 32 c3 	      sta	sidGate,x
     41  1a11		       99 04 d4 	      sta	SID+4,y
     42  1a14		       ca		      dex
     43  1a15		       10 e3		      bpl	.v
     44  1a17		       60		      rts
     45  1a18
     46  1a18							; Volume 15, or 0 (silent, no hum) when the SID is off or muted (M).
     47  1a18							; Volume 15, or 0 when the SID is off or muted. Keeps the filter mode bits.
     48  1a18				   SidVolume
     49  1a18					      subroutine
     50  1a18		       ad 25 c3 	      lda	devOn+DEV_SID
