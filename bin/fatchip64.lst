------- FILE lead.asm LEVEL 2 PASS 3
      0  6e1e					      include	"lead.asm"
      1  6e1e							; Fat Chip 64 - CHORD + LEAD (v0.28): a chord and a lead at once, each its
      2  6e1e							; own patch.
      3  6e1e							;   BASS      (was LOW NOTE) the first key pressed is the chord's root
      4  6e1e							;	       (POLY: just it; SMART CHORD: its 5TH, TRIAD...; DRONE: the
      5  6e1e							;	       drone); every other key is the lead, while the chord key is held
      6  6e1e							;   TRIAD     (was LATCH 3) three keys pressed together are the chord while
      7  6e1e							;	       they're held (v0.36: with LATCH on, it keeps sounding after you
      8  6e1e							;	       let go); every other key is the lead.
      9  6e1e							; v0.36: the lead is LEAD OCTAVE up in every mode (+1 at first; SHIFT + F1 /
     10  6e1e							; F3; v0.43: One Key Play too). v0.43: SHIFT + F5 SPLIT on / off, SHIFT + F7
     11  6e1e							; its mode, SHIFT + K then a note: the split point. LATCH holds KEY's chord side and TRIAD's chord.
     12  6e1e							; The lead is one note (the last key pressed) on one voice per chip (SID 3,
     13  6e1e							; Game Boy pulse 1, NES pulse 1), only while it plays: the rest of the time
     14  6e1e							; those voices are the chord's. Its patch: SHIFT + A S D F G / Z X C V B.
     15  6e1e							; The lead's own: the SID's waveform, width, envelope and octave, the Game
     16  6e1e							; Boy pulse's CCs, the NES pulse's duty. Shared with the chord: the effects
     17  6e1e							; (vibrato, filter, tremolo...), the NES envelope.
     18  6e1e
     19  6e1e							;   KEY       (v0.32) a keyboard split: keys below the split point are the
     20  6e1e							;	       chord (as the mode plays them), keys from it up the lead (LEAD
     21  6e1e							;	       OCTAVE, +1 at first). On the C64's keys the split is a key (it
     22  6e1e							;	       stays put when the octave changes); over MIDI, a note as sent
     23  6e1e							;	       (before MIDI IN OCTAVE). SHIFT + F5 held + a note sets either.
     24  6e1e		       00 01	   CL_KEY     equ	1	; SPLIT (clMode)
     25  6e1e		       00 02	   CL_BASS    equ	2
     26  6e1e		       00 03	   CL_L3      equ	3	; (TRIAD)
     27  6e1e		       00 06	   LEAD_SID   equ	6	; the lead's voices: SID 3, GB pulse 1, NES pulse 1
     28  6e1e		       00 01	   LEAD_GB    equ	1
     29  6e1e		       00 02	   LEAD_NES   equ	2
     30  6e1e
     31  6e1e							; NoteDown, CHORD + LEAD on: key X pressed. Carry set: it's the lead (the
     32  6e1e							; latch styles leave it alone).
