     81  0f43		       8d 37 c3 	      sta	ksBits
     82  0f46		       a9 00		      lda	#0
     83  0f48		       8d 39 c3 	      sta	ksRow
     84  0f4b				   .pb
     85  0f4b		       ad 37 c3 	      lda	ksBits
