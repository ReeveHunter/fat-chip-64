    126  4159		       60		      rts
    127  415a
    128  415a		       00 01 00 00*dmcPrioT   .byte.b	0,1,0,0,0,2,3	; kick, snare, -, -, -, tom, perc
    129  4161		       00 03 00 00*kitOfs     .byte.b	0,3,0,0,0,6,9
    130  4168
    131  4168							; mS = control change on MidiNES channel nesBase + A
    132  4168				   NesChStatus
    133  4168					      subroutine
    134  4168		       18		      clc
