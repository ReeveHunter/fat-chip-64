------- FILE midiin.asm LEVEL 2 PASS 3
      0  26cb					      include	"midiin.asm"
      1  26cb							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  26cb							;
      3  26cb							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  26cb							; The main loop parses them (running status; realtime and system bytes are
      5  26cb							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  26cb							; notes mode, latch, arp and K + note.
      7  26cb							;
      8  26cb							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  26cb							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  26cb							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  26cb							;
     12  26cb							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  26cb							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  26cb							;
     15  26cb							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  26cb							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  26cb							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  26cb							; MIDI in is passed on to the Game Boy or NES.
     19  26cb
     20  26cb							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  26cb							; Uses A, X.
     22  26cb							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  26cb							; with the time; a Start ($FA) makes the next clock a beat.
     24  26cb				   RxByte
     25  26cb					      subroutine
     26  26cb		       ad 06 de 	      lda	ACIA_STAT
     27  26ce		       4a		      lsr		; RDRF -> carry
     28  26cf		       90 2b		      bcc	.x
     29  26d1				   RxGot
     30  26d1		       ad 07 de 	      lda	ACIA_RX
     31  26d4		       c9 f8		      cmp	#$F8
     32  26d6		       f0 25		      beq	.clk
     33  26d8		       c9 fa		      cmp	#$FA
     34  26da		       d0 0e		      bne	.buf
     35  26dc		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  26de		       8e 5c c5 	      stx	clkPhase
     37  26e1		       8e 64 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  26e4							;  the main loop could measure it)
     39  26e4		       ae 5d c5 	      ldx	clkBeat
     40  26e7		       8e 6f c5 	      stx	clkStartBeat
     41  26ea				   .buf
     42  26ea		       ae 25 c4 	      ldx	rxHead
     43  26ed		       9d e5 c3 	      sta	rxBuf,x
     44  26f0		       e8		      inx
     45  26f1		       8a		      txa
     46  26f2		       29 3f		      and	#63
     47  26f4		       cd 26 c4 	      cmp	rxTail
     48  26f7		       f0 03		      beq	.x	; full: dropped
     49  26f9		       8d 25 c4 	      sta	rxHead
     50  26fc				   .x
     51  26fc		       60		      rts
     52  26fd				   .clk
     53  26fd		       ee 58 c5 	      inc	clkCount
     54  2700		       ae 5c c5 	      ldx	clkPhase
     55  2703		       e8		      inx
     56  2704		       e0 18		      cpx	#24
     57  2706		       90 14		      bcc	.ph
     58  2708		       a5 10		      lda	ticks
     59  270a		       8d 5f c5 	      sta	clkAtL
     60  270d		       a5 11		      lda	ticks+1
     61  270f		       8d 60 c5 	      sta	clkAtH
     62  2712		       a5 2d		      lda	subTick
     63  2714		       8d 61 c5 	      sta	clkAtS
     64  2717		       ee 5d c5 	      inc	clkBeat
     65  271a		       a2 00		      ldx	#0
     66  271c				   .ph
     67  271c		       8e 5c c5 	      stx	clkPhase
     68  271f		       60		      rts
     69  2720
     70  2720							; Main loop, every pass: parse what came in.
     71  2720				   MidiInService
     72  2720					      subroutine
     73  2720				   .next
     74  2720		       ae 26 c4 	      ldx	rxTail
     75  2723		       ec 25 c4 	      cpx	rxHead
     76  2726		       d0 01		      bne	.byte
     77  2728		       60		      rts
     78  2729				   .byte
     79  2729		       bd e5 c3 	      lda	rxBuf,x
     80  272c		       a8		      tay
     81  272d		       e8		      inx
     82  272e		       8a		      txa
     83  272f		       29 3f		      and	#63
     84  2731		       8d 26 c4 	      sta	rxTail
     85  2734		       98		      tya
     86  2735		       10 14		      bpl	.data
     87  2737		       c9 f8		      cmp	#$F8
     88  2739		       b0 34		      bcs	.rt	; realtime (clocks are counted by RxByte)
     89  273b		       c9 f0		      cmp	#$F0
     90  273d		       90 02		      bcc	.status
     91  273f		       a9 00		      lda	#0	; system: no running status until the next one
     92  2741				   .status
     93  2741		       8d 27 c4 	      sta	rxStatus
     94  2744		       a9 00		      lda	#0
     95  2746		       8d 28 c4 	      sta	rxCnt
     96  2749		       f0 d5		      beq	.next
     97  274b				   .data
     98  274b		       ae 27 c4 	      ldx	rxStatus
     99  274e		       f0 d0		      beq	.next	; no status yet
    100  2750		       ae 28 c4 	      ldx	rxCnt
    101  2753		       d0 2e		      bne	.second
    102  2755		       8d 29 c4 	      sta	rxD1
    103  2758		       ee 28 c4 	      inc	rxCnt
    104  275b		       ad 27 c4 	      lda	rxStatus
    105  275e		       29 e0		      and	#$E0
    106  2760		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
    107  2762		       d0 bc		      bne	.next
    108  2764		       a9 00		      lda	#0
    109  2766		       8d 28 c4 	      sta	rxCnt
    110  2769		       20 91 27 	      jsr	MidiInMsg
    111  276c		       4c 20 27 	      jmp	.next
    112  276f				   .rt
    113  276f		       c9 fa		      cmp	#$FA
    114  2771		       d0 06		      bne	.rt2
    115  2773		       20 8f 3b 	      jsr	KeytarStart
    116  2776		       4c 20 27 	      jmp	.next
    117  2779				   .rt2
    118  2779		       c9 fc		      cmp	#$FC
    119  277b		       d0 03		      bne	.rt3
    120  277d		       20 b0 3b 	      jsr	KeytarStop
    121  2780				   .rt3
    122  2780		       4c 20 27 	      jmp	.next
    123  2783				   .second
    124  2783		       8d 2a c4 	      sta	rxD2
    125  2786		       a9 00		      lda	#0
    126  2788		       8d 28 c4 	      sta	rxCnt
    127  278b		       20 91 27 	      jsr	MidiInMsg
    128  278e		       4c 20 27 	      jmp	.next
