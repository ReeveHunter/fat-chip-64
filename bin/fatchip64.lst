------- FILE nesfx.asm LEVEL 2 PASS 3
      0  667a					      include	"nesfx.asm"
      1  667a							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  667a							;
      3  667a							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  667a							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  667a							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  667a							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  667a							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  667a							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  667a							;   glide    a new note starts bent back to the voice's last note and slides
     10  667a							;	      in the way the SID's does (all three channels)
     11  667a							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  667a							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  667a							; semitone, so these are a little stepped.
     14  667a
     15  667a		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  667a							;  (the pulses, and the triangle while it glides)
     17  667a
     18  667a							; A = 1 (not Z) when a NesFxTick step is due
     19  667a				   NesFxDue
     20  667a					      subroutine
     21  667a		       ad 27 c3 	      lda	devOn+DEV_NES
     22  667d		       f0 19		      beq	.x
     23  667f		       ad ff c5 	      lda	vibDepth
     24  6682		       0d 2d c5 	      ora	nfxGlide
     25  6685		       0d 2e c5 	      ora	nfxRun
     26  6688		       f0 0e		      beq	.x
     27  668a		       a5 10		      lda	ticks
     28  668c		       38		      sec
     29  668d		       ed 29 c5 	      sbc	nfxLast
     30  6690		       c9 08		      cmp	#NFX_EVERY
     31  6692		       a9 00		      lda	#0
     32  6694		       90 02		      bcc	.x
     33  6696		       a9 01		      lda	#1
     34  6698				   .x
     35  6698		       60		      rts
     36  6699
     37  6699							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  6699							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  6699							; quick return.
     40  6699				   NesFxTick
     41  6699					      subroutine
     42  6699		       ad 27 c3 	      lda	devOn+DEV_NES
     43  669c		       f0 0b		      beq	.q
