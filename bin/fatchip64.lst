------- FILE midi.asm LEVEL 2 PASS 3
      0  0b99					      include	"midi.asm"
      1  0b99							; Fat Chip 64 - MIDI out
      2  0b99							;
      3  0b99							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0b99							; at most one message per device onto the wire buffer, no sooner than that
      5  0b99							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0b99							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0b99							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0b99							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0b99							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0b99
     11  0b99				   MidiInit
     12  0b99					      subroutine
     13  0b99		       a9 03		      lda	#ACIA_RESET
     14  0b9b		       8d 04 de 	      sta	ACIA_CTRL
     15  0b9e		       a9 16		      lda	#ACIA_MODE
     16  0ba0		       8d 04 de 	      sta	ACIA_CTRL
     17  0ba3							; (fall into the test)
     18  0ba3
     19  0ba3							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0ba3							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0ba3							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0ba3							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0ba3							; before. Interrupts are off when this is called.
     24  0ba3				   MidiIrqTest
     25  0ba3					      subroutine
     26  0ba3		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0ba5		       8d 0d dc 	      sta	CIA1_ICR
