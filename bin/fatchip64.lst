------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  5482					      include	"sync.asm"
      1  5482							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  5482							;
      3  5482							; Menu, DEVICE SYNC (defaults first):
      4  5482							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  5482							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  5482							;		     sets the tempo, averaged over beats (the clock jitters about
      7  5482							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  5482							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  5482							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  5482							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  5482							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  5482							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  5482							;		     picks a beat demo (styleBeat)
     14  5482							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  5482							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  5482							;		     key channel) picks a sound (voiceSound)
     17  5482							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  5482							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  5482							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  5482							;
     21  5482							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  5482							; 1/4 ms); a Start makes the next clock a beat.
     23  5482
     24  5482		       00 00	   TEMPO_KEYTAR equ	0
     25  5482		       00 01	   TEMPO_OWN  equ	1
     26  5482		       00 02	   TEMPO_SC   equ	2
     27  5482		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  5482
     29  5482
     30  5482
     31  5482							; ------------------------------------------------------------ clock
     32  5482							; Main loop, every pass
     33  5482				   ClockTick
     34  5482					      subroutine
     35  5482		       ad f1 c5 	      lda	clkCount	; any clock lately?
     36  5485		       cd f2 c5 	      cmp	clkCountSeen
