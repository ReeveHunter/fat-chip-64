------- FILE lead.asm LEVEL 2 PASS 3
      0  6f95					      include	"lead.asm"
      1  6f95							; Fat Chip 64 - CHORD + LEAD (v0.28): a chord and a lead at once, each its
      2  6f95							; own patch.
      3  6f95							;   BASS      (was LOW NOTE) the first key pressed is the chord's root
      4  6f95							;	       (POLY: just it; SMART CHORD: its 5TH, TRIAD...; DRONE: the
      5  6f95							;	       drone); every other key is the lead, while the chord key is held
      6  6f95							;   TRIAD     (was LATCH 3) three keys pressed together are the chord while
      7  6f95							;	       they're held (v0.36: with LATCH on, it keeps sounding after you
      8  6f95							;	       let go); every other key is the lead.
      9  6f95							; v0.36: the lead is LEAD OCTAVE up in every mode (+1 at first; SHIFT + F1 /
     10  6f95							; F3; v0.43: One Key Play too). v0.43: SHIFT + F5 SPLIT on / off, SHIFT + F7
     11  6f95							; its mode, SHIFT + K then a note: the split point. LATCH holds KEY's chord side and TRIAD's chord.
     12  6f95							; The lead is one note (the last key pressed) on one voice per chip (SID 3,
     13  6f95							; Game Boy pulse 1, NES pulse 1), only while it plays: the rest of the time
     14  6f95							; those voices are the chord's. Its patch: SHIFT + A S D F G / Z X C V B.
     15  6f95							; The lead's own: the SID's waveform, width, envelope and octave, the Game
     16  6f95							; Boy pulse's CCs, the NES pulse's duty. Shared with the chord: the effects
     17  6f95							; (vibrato, filter, tremolo...), the NES envelope.
     18  6f95
     19  6f95							;   KEY       (v0.32) a keyboard split: keys below the split point are the
     20  6f95							;	       chord (as the mode plays them), keys from it up the lead (LEAD
     21  6f95							;	       OCTAVE, +1 at first). On the C64's keys the split is a key (it
     22  6f95							;	       stays put when the octave changes); over MIDI, a note as sent
     23  6f95							;	       (before MIDI IN OCTAVE). SHIFT + F5 held + a note sets either.
     24  6f95		       00 01	   CL_KEY     equ	1	; SPLIT (clMode)
     25  6f95		       00 02	   CL_BASS    equ	2
     26  6f95		       00 03	   CL_L3      equ	3	; (TRIAD)
     27  6f95		       00 06	   LEAD_SID   equ	6	; the lead's voices: SID 3, GB pulse 1, NES pulse 1
     28  6f95		       00 01	   LEAD_GB    equ	1
     29  6f95		       00 02	   LEAD_NES   equ	2
     30  6f95
