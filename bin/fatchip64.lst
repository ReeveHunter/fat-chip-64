     97  7e09		       ca		      dex
     98  7e0a		       ca		      dex
     99  7e0b		       ca		      dex
    100  7e0c		       10 de		      bpl	.v
    101  7e0e							; ---- the NES queue needs room
    102  7e0e		       a5 1a		      lda	nesqHead
    103  7e10		       38		      sec
    104  7e11		       e5 1b		      sbc	nesqTail
    105  7e13		       29 3f		      and	#63
    106  7e15		       c9 08		      cmp	#Q_BACKLOG
