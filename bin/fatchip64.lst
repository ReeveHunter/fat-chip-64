------- FILE main.asm
------- FILE patchedit.asm LEVEL 2 PASS 3
      0  67bf					      include	"patchedit.asm"
      1  67bf							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  67bf							; the dice. The settings and their steps come from tools/gen_menu.py
      3  67bf							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  67bf							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  67bf							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  67bf							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  67bf							; (EnvDerive).
      8  67bf
      9  67bf		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  67bf		       00 30	   LFO_LAST   equ	FLD_gbLDelay
     11  67bf
     12  67bf							; X = param -> A = the step the live patch is nearest to
     13  67bf				   ParamNearest
     14  67bf					      subroutine
     15  67bf		       8e 2c cc 	      stx	pnP
