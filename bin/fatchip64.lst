     68  3b3f		       ee b4 ca 	      inc	clkBeat
     69  3b42		       a2 00		      ldx	#0
     70  3b44				   .ph
     71  3b44		       8e b3 ca 	      stx	clkPhase
     72  3b47		       60		      rts
