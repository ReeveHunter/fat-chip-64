------- FILE main.asm
------- FILE nesfx.asm LEVEL 2 PASS 3
      0  80b4					      include	"nesfx.asm"
      1  80b4							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  80b4							;
      3  80b4							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  80b4							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  80b4							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  80b4							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  80b4							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  80b4							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  80b4							;   glide    a new note starts bent back to the voice's last note and slides
     10  80b4							;	      in the way the SID's does (all three channels)
     11  80b4							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  80b4							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  80b4							; semitone, so these are a little stepped.
     14  80b4
     15  80b4		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  80b4							;  (the pulses, and the triangle while it glides)
     17  80b4
     18  80b4							; A = 1 (not Z) when a NesFxTick step is due
     19  80b4				   NesFxDue
     20  80b4					      subroutine
     21  80b4		       ad 2b c3 	      lda	devOn+DEV_NES
     22  80b7		       f0 1c		      beq	.x
     23  80b9		       ad 0b c6 	      lda	vibDepth
     24  80bc		       0d 39 c5 	      ora	nfxGlide
     25  80bf		       0d 3a c5 	      ora	nfxRun
     26  80c2		       0d f9 c9 	      ora	nfxWarb
     27  80c5		       f0 0e		      beq	.x
     28  80c7		       a5 10		      lda	ticks
     29  80c9		       38		      sec
     30  80ca		       ed 35 c5 	      sbc	nfxLast
     31  80cd		       c9 08		      cmp	#NFX_EVERY
     32  80cf		       a9 00		      lda	#0
     33  80d1		       90 02		      bcc	.x
     34  80d3		       a9 01		      lda	#1
     35  80d5				   .x
     36  80d5		       60		      rts
     37  80d6
     38  80d6							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     39  80d6							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     40  80d6							; quick return.
     41  80d6				   NesFxTick
     42  80d6					      subroutine
     43  80d6		       ad 2b c3 	      lda	devOn+DEV_NES
     44  80d9		       f0 0e		      beq	.q
     45  80db		       ad 0b c6 	      lda	vibDepth
     46  80de		       0d 39 c5 	      ora	nfxGlide
     47  80e1		       0d 3a c5 	      ora	nfxRun
     48  80e4		       0d f9 c9 	      ora	nfxWarb
     49  80e7		       d0 01		      bne	.on
     50  80e9				   .q
     51  80e9		       60		      rts
     52  80ea				   .on
     53  80ea		       a5 10		      lda	ticks
     54  80ec		       38		      sec
     55  80ed		       ed 35 c5 	      sbc	nfxLast
     56  80f0		       c9 08		      cmp	#NFX_EVERY
     57  80f2		       b0 01		      bcs	.go
     58  80f4		       60		      rts
     59  80f5				   .go
     60  80f5		       4a		      lsr
     61  80f6		       4a		      lsr		; 4 ms steps
     62  80f7		       c9 08		      cmp	#8
     63  80f9		       90 02		      bcc	.n
