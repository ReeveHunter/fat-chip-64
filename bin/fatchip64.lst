     74  0c18							; IRQ: send one wire byte if the ACIA is ready.
     75  0c18				   TxByte
     76  0c18					      subroutine
     77  0c18		       a6 16		      ldx	wireTail
     78  0c1a		       e4 15		      cpx	wireHead
     79  0c1c		       f0 0f		      beq	.done
     80  0c1e		       ad 06 de 	      lda	ACIA_STAT
     81  0c21		       29 02		      and	#ACIA_TDRE
     82  0c23		       f0 08		      beq	.done
     83  0c25		       bd 00 c0 	      lda	wireBuf,x
     84  0c28		       8d 05 de 	      sta	ACIA_TX
     85  0c2b		       e6 16		      inc	wireTail
     86  0c2d				   .done
     87  0c2d		       60		      rts
