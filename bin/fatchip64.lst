------- FILE main.asm
------- FILE menu.asm LEVEL 2 PASS 3
      0  58f0					      include	"menu.asm"
      1  58f0							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  58f0							;
      3  58f0							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  58f0							;   page   RETURN opens a page
      5  58f0							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  58f0							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  58f0							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  58f0							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  58f0							; device pages, until DEVICES says the device is in use).
     10  58f0							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  58f0							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  58f0							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  58f0
     14  58f0		       00 17	   MENU_VALCOL equ	23
     15  58f0
     16  58f0				   MenuOpen
     17  58f0		       20 fe 7a 	      jsr	GlitchCalm	; (GLITCH may have the picture shaking)
     18  58f3		       a9 01		      lda	#1
     19  58f5		       8d e7 c9 	      sta	colDirty	; (the play screen's dark rows: light green again)
     20  58f8		       8d 8a c4 	      sta	menuOn
     21  58fb		       a9 00		      lda	#0
     22  58fd		       8d 8b c4 	      sta	menuRow
     23  5900		       8d e6 c9 	      sta	menuJump
