------- FILE main.asm
------- FILE sampler.asm LEVEL 2 PASS 3
      0  8257					      include	"sampler.asm"
      1  8257							; Fat Chip 64 - SAMPLER MODE, stage 1 (v0.68): 16 pads and the sample browser
      2  8257							;
      3  8257							; RUN/STOP + RETURN switches between the play screen and the sampler. Its
      4  8257							; 16 pads are 1234 / QWER / ASDF / ZXCV (PAD KEYS GRID) or the overlay's
      5  8257							; lowest 16 notes, Z's pad on Q (C3) and on up ZXCV ASDF QWER 1234 (OVERLAY).
      6  8257							; A pad plays its MidiNES sample at its rate, and on the Game Boy the drum its
      7  8257							; hit type matches, as the beats would (BEATS ON, BOTH LAYER / SPLIT); tonal,
      8  8257							; FX and vocal samples play on the MidiNES only. SHIFT + a pad: accented.
      9  8257							; Notes on PAD MIDI CHANNEL from PAD BASE NOTE up play the pads too (any
     10  8257							; screen), with their velocity on the Game Boy.
     11  8257							;
     12  8257							; The browser (the MidiNES's 256 samples, A0-A127, B0-B127):
     13  8257							;   CRSR DOWN (SHIFT: back)   the next sample of the TYPE, played
     14  8257							;   C= + CRSR DOWN	       TYPE: ALL, K, S, H, P, L, T, F, V
     15  8257							;   CRSR RIGHT (SHIFT: down)  its rate, 0-15 (MidiNES CC 3 = rate x 8 + 7)
     16  8257							;   SPACE		       play it again
     17  8257							;   RETURN, then a pad        the pad gets it at that rate; RETURN, then SPACE:
     18  8257							;			       all 16, the rates low to high up the pads
     19  8257							;   C= + F1 / F3	       pad kit 2 / 1 (two, kept until reset)
     20  8257							;   C= + RETURN	       the menu (its SAMPLER page has the settings)
     21  8257							; Kit 1 starts as the beat's MidiNES kit on the standard pads (Z kick, X snare,
     22  8257							; C V hats, A S accents, D F R toms, E perc), the first time the sampler opens.
     23  8257
     24  8257		       00 7f	   SMP_ACCENT equ	127	; the Game Boy's velocity: SHIFT + a pad, else
     25  8257		       00 64	   SMP_NORMAL equ	100
     26  8257		       00 5a	   SMP_LIT_MS equ	90	; a pad lights this long
     27  8257
