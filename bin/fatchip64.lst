     81  6f3b				   .go
     82  6f3b		       bd 0a c3 	      lda	vWant,x
     83  6f3e		       18		      clc
     84  6f3f		       6d 96 c6 	      adc	sndPenv
     85  6f42		       20 8c 6f 	      jsr	NoteClamp
     86  6f45		       20 cc 1f 	      jsr	SidPitch	; -> ptr
     87  6f48		       a5 28		      lda	ptr
     88  6f4a		       99 de c3 	      sta	sidBaseLo,y
     89  6f4d		       a5 29		      lda	ptr+1
     90  6f4f		       99 e1 c3 	      sta	sidBaseHi,y
     91  6f52		       ad 97 c6 	      lda	sndPenvK
     92  6f55		       ae 93 c6 	      ldx	sndStep
     93  6f58		       f0 02		      beq	.k
     94  6f5a		       a9 ff		      lda	#$FF	; (STEP: held; AtkStep jumps)
     95  6f5c				   .k
     96  6f5c		       99 62 c9 	      sta	sK,y
     97  6f5f				   .x
     98  6f5f		       60		      rts
     99  6f60
    100  6f60							; VoiceSet, a SID voice let go (X = the voice, Y = SID voice): BEND OUT
    101  6f60				   RelDrop
    102  6f60					      subroutine
    103  6f60		       ad 9a c6 	      lda	sndRdrop
