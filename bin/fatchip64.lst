------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  4662					      include	"sync.asm"
      1  4662							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  4662							;
      3  4662							; Menu, DEVICE SYNC (defaults first):
      4  4662							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  4662							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  4662							;		     sets the tempo, averaged over beats (the clock jitters about
      7  4662							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  4662							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  4662							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  4662							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  4662							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  4662							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  4662							;		     picks a beat demo (styleBeat)
     14  4662							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  4662							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  4662							;		     key channel) picks a sound (voiceSound)
     17  4662							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  4662							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  4662							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  4662							;
     21  4662							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  4662							; 1/4 ms); a Start makes the next clock a beat.
     23  4662
     24  4662		       00 00	   TEMPO_KEYTAR equ	0
     25  4662		       00 01	   TEMPO_OWN  equ	1
     26  4662		       00 02	   TEMPO_SC   equ	2
     27  4662		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  4662
     29  4662
     30  4662
     31  4662							; ------------------------------------------------------------ clock
     32  4662							; Main loop, every pass
