    141  4f7c							; hats and cymbals: NES noise (one at a time; cymbal > open > closed)
    142  4f7c				   NoiseHit
    143  4f7c					      subroutine
    144  4f7c		       ad 8f c4 	      lda	drumKind
    145  4f7f		       38		      sec
    146  4f80		       e9 02		      sbc	#DK_CH
    147  4f82		       85 24		      sta	t0	; 0 closed, 1 open, 2 cymbal
    148  4f84		       a9 02		      lda	#2
    149  4f86		       38		      sec
    150  4f87		       e5 24		      sbc	t0
    151  4f89		       85 27		      sta	t3	; priority (0 = most important)
    152  4f8b		       ad 43 c3 	      lda	nowL
    153  4f8e		       38		      sec
    154  4f8f		       ed 89 c4 	      sbc	nzAt
    155  4f92		       a8		      tay
    156  4f93		       ad 44 c3 	      lda	nowH
    157  4f96		       ed 8a c4 	      sbc	nzAt+1
    158  4f99		       d0 0c		      bne	.ok
    159  4f9b		       c0 0c		      cpy	#DRUM_WINDOW
    160  4f9d		       b0 08		      bcs	.ok
    161  4f9f		       a5 27		      lda	t3
    162  4fa1		       cd 88 c4 	      cmp	nzPrio
    163  4fa4		       90 01		      bcc	.ok
    164  4fa6		       60		      rts
    165  4fa7				   .ok
    166  4fa7		       a5 24		      lda	t0	; preset = sound x 3 + level
    167  4fa9		       0a		      asl
    168  4faa		       65 24		      adc	t0
    169  4fac		       6d 8e c4 	      adc	drumLvl
    170  4faf		       aa		      tax
    171  4fb0		       bd 7a 50 	      lda	nzNoteT,x
    172  4fb3		       85 25		      sta	t1
    173  4fb5		       bd 83 50 	      lda	nzVolT,x
