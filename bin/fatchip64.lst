------- FILE main.asm
------- FILE keys.asm LEVEL 2 PASS 2
      0  0b87					      include	"keys.asm"
      1  0b87							; Fat Chip 64 - keyboard and RESTORE
      2  0b87
      3  0b87							; Scan the whole matrix, turn changes into key events.
      4  0b87							;
      5  0b87							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0b87							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0b87							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0b87							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0b87							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0b87							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0b87							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0b87							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0b87							; chords whose ghost lands on another used key lose their newest note.
     14  0b87				   KeyScan
     15  0b87					      subroutine
     16  0b87		       a2 07		      ldx	#7
     17  0b89				   .col
     18  0b89		       bd 55 15 	      lda	colSelect,x
     19  0b8c		       8d 00 dc 	      sta	CIA1_PRA
     20  0b8f		       ad 01 dc 	      lda	CIA1_PRB
     21  0b92		       49 ff		      eor	#$FF
     22  0b94		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0b97		       9d 80 c2 	      sta	keyNow,x
     24  0b9a		       ca		      dex
     25  0b9b		       10 ec		      bpl	.col
     26  0b9d		       a9 ff		      lda	#$FF
     27  0b9f		       8d 00 dc 	      sta	CIA1_PRA
     28  0ba2							; ---- releases first: accepted keys that are up now
     29  0ba2		       a2 00		      ldx	#0
     30  0ba4				   .rc
     31  0ba4		       8e 1f c3 	      stx	ksCol
     32  0ba7		       bd 80 c2 	      lda	keyNow,x
     33  0baa		       49 ff		      eor	#$FF
     34  0bac		       3d 90 c2 	      and	keyAcc,x
     35  0baf		       8d 1e c3 	      sta	ksBits
     36  0bb2		       a9 00		      lda	#0
     37  0bb4		       8d 20 c3 	      sta	ksRow
     38  0bb7				   .rb
     39  0bb7		       ad 1e c3 	      lda	ksBits
     40  0bba		       f0 21		      beq	.rcn
