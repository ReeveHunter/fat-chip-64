    121  0b07		       20 2d 0b 	      jsr	LinkRoom
    122  0b0a		       90 20		      bcc	.done
    123  0b0c		       a6 1b		      ldx	nesqTail
    124  0b0e		       bd c0 c1 	      lda	nesqS,x
    125  0b11		       bc 40 c2 	      ldy	nesqD2,x
    126  0b14		       84 2c		      sty	irqT
    127  0b16		       bc 00 c2 	      ldy	nesqD1,x
    128  0b19		       20 49 0b 	      jsr	WireMsg
    129  0b1c		       a5 1b		      lda	nesqTail
    130  0b1e		       18		      clc
    131  0b1f		       69 01		      adc	#1
    132  0b21		       29 3f		      and	#63
    133  0b23		       85 1b		      sta	nesqTail
    134  0b25		       a5 10		      lda	ticks
    135  0b27		       18		      clc
    136  0b28		       69 01		      adc	#NES_GAP
    137  0b2a		       85 1c		      sta	nesNext
    138  0b2c				   .done
    139  0b2c		       60		      rts
    140  0b2d
    141  0b2d							; Carry set if the Teensyboy has room for a message (always, with the Game
    142  0b2d							; Boy off), and counts it.
    143  0b2d				   LinkRoom
    144  0b2d					      subroutine
    145  0b2d		       ad 26 c3 	      lda	devOn+DEV_GB
    146  0b30		       f0 0a		      beq	.yes
    147  0b32		       a5 2e		      lda	linkLoad
    148  0b34		       c9 2d		      cmp	#LINK_MAX
    149  0b36		       b0 06		      bcs	.no
    150  0b38		       69 03		      adc	#3
    151  0b3a		       85 2e		      sta	linkLoad
    152  0b3c				   .yes
    153  0b3c		       38		      sec
    154  0b3d		       60		      rts
    155  0b3e				   .no
    156  0b3e		       18		      clc
    157  0b3f		       60		      rts
