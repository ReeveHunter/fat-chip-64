     83  1d63		       a9 01		      lda	#1
     84  1d65		       8d c6 c3 	      sta	triOn
     85  1d68		       38		      sec
     86  1d69		       60		      rts
     87  1d6a				   .no
     88  1d6a		       18		      clc
     89  1d6b		       60		      rts
