------- FILE midiin.asm LEVEL 2 PASS 3
      0  33c2					      include	"midiin.asm"
      1  33c2							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  33c2							;
      3  33c2							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  33c2							; The main loop parses them (running status; realtime and system bytes are
      5  33c2							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  33c2							; notes mode, latch, arp and K + note.
      7  33c2							;
      8  33c2							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  33c2							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  33c2							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  33c2							;
     12  33c2							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  33c2							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  33c2							;
     15  33c2							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  33c2							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  33c2							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  33c2							; MIDI in is passed on to the Game Boy or NES.
     19  33c2
     20  33c2							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  33c2							; Uses A, X.
     22  33c2							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  33c2							; with the time; a Start ($FA) makes the next clock a beat.
     24  33c2				   RxByte
     25  33c2					      subroutine
     26  33c2		       ad 06 de 	      lda	ACIA_STAT
     27  33c5		       4a		      lsr		; RDRF -> carry
     28  33c6		       90 2b		      bcc	.x
     29  33c8				   RxGot
     30  33c8		       ad 07 de 	      lda	ACIA_RX
     31  33cb		       c9 f8		      cmp	#$F8
     32  33cd		       f0 25		      beq	.clk
     33  33cf		       c9 fa		      cmp	#$FA
     34  33d1		       d0 0e		      bne	.buf
     35  33d3		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  33d5		       8e e8 c5 	      stx	clkPhase
     37  33d8		       8e f0 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  33db							;  the main loop could measure it)
     39  33db		       ae e9 c5 	      ldx	clkBeat
     40  33de		       8e fb c5 	      stx	clkStartBeat
     41  33e1				   .buf
     42  33e1		       ae 24 c4 	      ldx	rxHead
     43  33e4		       9d e4 c3 	      sta	rxBuf,x
     44  33e7		       e8		      inx
     45  33e8		       8a		      txa
     46  33e9		       29 3f		      and	#63
     47  33eb		       cd 25 c4 	      cmp	rxTail
     48  33ee		       f0 03		      beq	.x	; full: dropped
     49  33f0		       8d 24 c4 	      sta	rxHead
     50  33f3				   .x
     51  33f3		       60		      rts
     52  33f4				   .clk
     53  33f4		       ee e4 c5 	      inc	clkCount
     54  33f7		       ae e8 c5 	      ldx	clkPhase
     55  33fa		       e8		      inx
     56  33fb		       e0 18		      cpx	#24
     57  33fd		       90 1b		      bcc	.ph
     58  33ff		       a5 10		      lda	ticks
     59  3401		       8d eb c5 	      sta	clkAtL
     60  3404		       a5 11		      lda	ticks+1
     61  3406		       8d ec c5 	      sta	clkAtH
     62  3409		       a5 2d		      lda	subTick
     63  340b		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  340d		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  340f		       ad 05 dc 	      lda	CIA1_TAHI
     66  3412				   .q
