------- FILE main.asm
------- FILE devices.asm LEVEL 2 PASS 3
      0  6c92					      include	"devices.asm"
      1  6c92							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  6c92							; are in use, and each one in use gets its page on the main menu.
      3  6c92							;
      4  6c92							; YAMAHA SHS-10 (the keytar)
      5  6c92							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  6c92							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  6c92							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  6c92							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  6c92							;		     can play at once.)
     10  6c92							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  6c92							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  6c92							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  6c92							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  6c92							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  6c92							;		     louder (the SID and the NES; the Game Boy would click) or
     16  6c92							;		     brighter (the SID's filter: switched on if the patch has
     17  6c92							;		     none)
     18  6c92							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  6c92							;		     the patch's, or the ADVANCED amounts if it has none;
     20  6c92							;		     FILTER), or an action held while blowing hard
     21  6c92							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  6c92							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  6c92							;   PORTAMENTO BUTTON	an action (CC 65)
     24  6c92							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  6c92							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  6c92							; ATARI SYNTHCART
     27  6c92							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  6c92							;		     about 3% while held, SHIFT + , . step through the ten
     29  6c92							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  6c92							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  6c92							;		     sound's cents (the Synthcart manual's table: each Atari
     32  6c92							;		     sound plays its scales in its own key, a little off)
     33  6c92							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  6c92
     35  6c92		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  6c92		       00 28	   BREATH_LO  equ	40
     37  6c92		       00 01	   BFX_VIB    equ	1
     38  6c92		       00 02	   BFX_WARB   equ	2
     39  6c92		       00 03	   BFX_DET    equ	3
     40  6c92		       00 04	   BFX_FILT   equ	4
     41  6c92		       00 05	   BFX_HELD   equ	5
     42  6c92
