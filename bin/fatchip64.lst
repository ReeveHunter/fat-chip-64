------- FILE main.asm
------- FILE arp.asm LEVEL 2 PASS 3
      0  24a8					      include	"arp.asm"
      1  24a8							; Fat Chip 64 - tempo and arpeggiator
      2  24a8							;
      3  24a8							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  24a8							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  24a8							;
      6  24a8							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  24a8							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  24a8							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  24a8							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  24a8							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  24a8							;	     until its voice's next turn.
     12  24a8							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  24a8							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  24a8							;   J faster; either one also picks FREE).
     15  24a8							;
     16  24a8							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  24a8							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  24a8
     19  24a8							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  24a8							; between the two bytes: $22FF read as $23FF)
     21  24a8				   GetTicks
     22  24a8					      subroutine
     23  24a8		       08		      php
     24  24a9		       78		      sei
     25  24aa		       a5 10		      lda	ticks
     26  24ac		       8d 03 c8 	      sta	nowL
     27  24af		       a5 11		      lda	ticks+1
     28  24b1		       8d 04 c8 	      sta	nowH
     29  24b4		       28		      plp
     30  24b5		       60		      rts
     31  24b6
     32  24b6							; ------------------------------------------------------------ tempo
     33  24b6				   TapTempo
     34  24b6					      subroutine
     35  24b6		       20 8c 5c 	      jsr	FollowActive	; the keytar's clock sets the tempo: taps do nothing
     36  24b9		       f0 01		      beq	.tap
     37  24bb		       60		      rts
     38  24bc				   .tap
     39  24bc		       a9 00		      lda	#0
     40  24be		       8d e7 ca 	      sta	beatFresh	; (a tempo of your own: a beat starting keeps it)
     41  24c1		       20 a8 24 	      jsr	GetTicks
     42  24c4		       ad 03 c8 	      lda	nowL
     43  24c7		       38		      sec
     44  24c8		       ed 08 c8 	      sbc	tapLast
     45  24cb		       85 24		      sta	t0
     46  24cd		       ad 04 c8 	      lda	nowH
