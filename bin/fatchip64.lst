------- FILE main.asm
------- FILE viz.asm LEVEL 2 PASS 3
      0  7a5a					      include	"viz.asm"
      1  7a5a							; Fat Chip 64 - the visualizer (F7: GLITCH on / off; v0.28 dropped the BARS)
      2  7a5a							;
      3  7a5a							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
      4  7a5a							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
      5  7a5a							; keep spattering more; runs of the screen get copied over other places
      6  7a5a							; (datamosh) and wiped away, so it fills while you play and dissolves when
      7  7a5a							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
      8  7a5a							; the background. VINYL STOP drags it down the screen.
      9  7a5a
     10  7a5a		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     11  7a5a		       00 16	   VIZ_NAMES  equ	22	; note names
     12  7a5a		       00 a0	   VIZ_FULL   equ	160	; reversed space
     13  7a5a		       00 62	   VIZ_HALF   equ	98	; lower half block
     14  7a5a
