    317  30ea							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    318  30ea							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    319  30ea							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    320  30ea							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    321  30ea		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    322  30ee		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    323  30f5		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    324  30fc		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    325  3101		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    326  3105		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    327  3109		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
    328  310e		       05 0a 0f 14*uTremRH    .byte.b	>1311, >2621, >3932, >5243, >6554
