     29  6861		       90 0e		      bcc	.x
     30  6863		       a9 00		      lda	#0
     31  6865		       99 61 c9 	      sta	clickOn,y
     32  6868		       be a3 76 	      ldx	sidOfs,y
     33  686b		       b9 31 c3 	      lda	sidGate,y
     34  686e		       9d 04 d4 	      sta	SID+4,x
     35  6871				   .x
     36  6871		       60		      rts
