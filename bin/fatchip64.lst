     26  72a7		       b9 70 c9 	      lda	clickOn,y
     27  72aa		       f0 21		      beq	.s
     28  72ac		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  72ae		       ae 99 c6 	      ldx	sndClick
     30  72b1		       e0 02		      cpx	#2
     31  72b3		       90 03		      bcc	.cl
     32  72b5		       ad 98 c6 	      lda	sndStepT
     33  72b8				   .cl
     34  72b8		       d9 6d c9 	      cmp	atkT,y
     35  72bb		       f0 02		      beq	.ce
     36  72bd		       b0 0e		      bcs	.s
     37  72bf				   .ce
     38  72bf		       a9 00		      lda	#0
     39  72c1		       99 70 c9 	      sta	clickOn,y
     40  72c4		       be 12 82 	      ldx	sidOfs,y
     41  72c7		       b9 32 c3 	      lda	sidGate,y
     42  72ca		       9d 04 d4 	      sta	SID+4,x
     43  72cd				   .s
     44  72cd		       b9 66 c9 	      lda	sK,y
     45  72d0		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  72d2		       d0 19		      bne	.x
     47  72d4		       b9 6d c9 	      lda	atkT,y
     48  72d7		       cd 98 c6 	      cmp	sndStepT
