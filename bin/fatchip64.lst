    120  7e2e				   .nv
    121  7e2e		       e0 08		      cpx	#8	; the triangle only while it glides or is bent
    122  7e30		       d0 10		      bne	.t
    123  7e32		       bd c4 c4 	      lda	nesGlL,x
    124  7e35		       1d cd c4 	      ora	nesGlH,x
    125  7e38		       1d f1 c4 	      ora	nesBent,x
    126  7e3b		       1d 79 c9 	      ora	nesRd,x
    127  7e3e		       d0 02		      bne	.t
    128  7e40		       a2 02		      ldx	#2
    129  7e42				   .t
    130  7e42		       8e 2a c5 	      stx	nfxV
    131  7e45		       86 24		      stx	t0
    132  7e47		       bd 97 c3 	      lda	vOut,x
    133  7e4a		       c9 ff		      cmp	#NO_NOTE
    134  7e4c		       f0 20		      beq	.x
    135  7e4e		       20 d1 7f 	      jsr	NesFxVal
    136  7e51		       a6 24		      ldx	t0
    137  7e53		       ad 33 c5 	      lda	nfxL
    138  7e56		       dd df c4 	      cmp	nesFxSL,x
    139  7e59		       d0 08		      bne	.send
    140  7e5b		       ad 34 c5 	      lda	nfxH
    141  7e5e		       dd e8 c4 	      cmp	nesFxSH,x
    142  7e61		       f0 0b		      beq	.x
    143  7e63				   .send
    144  7e63		       a9 01		      lda	#1
    145  7e65		       8d 2b c5 	      sta	nfxHave	; (NesBendVoice: nfx is this voice's already)
    146  7e68		       bd 97 c3 	      lda	vOut,x
    147  7e6b		       4c e2 34 	      jmp	NesBendVoice
    148  7e6e				   .x
    149  7e6e		       60		      rts
    150  7e6f
    151  7e6f							; voice X's glide offset closer to 0: by off / 2^glideK for each 4 ms step
    152  7e6f							; (worked out once: d = off >> k, off -= d x n; past 0 or nothing left to
    153  7e6f							; move by: there). Keeps X.
    154  7e6f				   NesGlideStep
    155  7e6f					      subroutine
    156  7e6f		       bd c4 c4 	      lda	nesGlL,x
    157  7e72		       1d cd c4 	      ora	nesGlH,x
    158  7e75		       d0 01		      bne	.go
    159  7e77		       60		      rts
    160  7e78				   .go
    161  7e78		       bd 70 c9 	      lda	nesK,x
    162  7e7b		       c9 ff		      cmp	#$FF	; (v0.41: BEND IN STEP: held for TIME, then the note)
    163  7e7d		       d0 0c		      bne	.slide
    164  7e7f		       bd d6 c4 	      lda	nesVT,x
    165  7e82		       cd 94 c6 	      cmp	sndStepT
    166  7e85		       b0 01		      bcs	.jump
    167  7e87		       60		      rts
    168  7e88				   .jump
    169  7e88		       4c 16 7f 	      jmp	.snap
    170  7e8b				   .slide
    171  7e8b		       bd c4 c4 	      lda	nesGlL,x
    172  7e8e		       8d 33 c5 	      sta	nfxL
    173  7e91		       bd cd c4 	      lda	nesGlH,x
    174  7e94		       8d 34 c5 	      sta	nfxH
    175  7e97		       bc 70 c9 	      ldy	nesK,x	; (BEND IN: its own)
    176  7e9a		       d0 07		      bne	.sh
    177  7e9c		       ac 04 c6 	      ldy	glideK
    178  7e9f		       d0 02		      bne	.sh
    179  7ea1		       a0 02		      ldy	#2	; (glide switched off mid-slide: finish quickly)
    180  7ea3				   .sh
    181  7ea3		       ad 34 c5 	      lda	nfxH
    182  7ea6		       c9 80		      cmp	#$80
    183  7ea8		       6e 34 c5 	      ror	nfxH
    184  7eab		       6e 33 c5 	      ror	nfxL
    185  7eae		       88		      dey
    186  7eaf		       d0 f2		      bne	.sh
    187  7eb1		       ad 33 c5 	      lda	nfxL	; d = 0 or -1: there
    188  7eb4		       0d 34 c5 	      ora	nfxH
    189  7eb7		       f0 5d		      beq	.snap
