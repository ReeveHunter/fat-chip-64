    364  3a2a							; ------------------------------------------------------------ SysEx: a patch from Chip Lab (v0.20)
    365  3a2a							; (v0.23: F0 7D 46 43 02 m F7 sets the chips on / off: DevicesReceived)
    366  3a2a							; F0 7D 46 43 01 PATCH_SIZE, then the patch (PATCH_SIZE bytes, the live patch's layout:
    367  3a2a							; tools/gen_patches.py) as two 4-bit halves each, high first, then F7. It
    368  3a2a							; arrives in sxBuf; only a complete one goes into the live patch, which then
    369  3a2a							; sounds at once (like choosing a sound). Anything else is ignored.
    370  3a2a		       00 05	   SX_HEAD    equ	5
    371  3a2a		       00 d5	   SX_LEN     equ	SX_HEAD + PATCH_SIZE * 2
    372  3a2a
    373  3a2a							; A status byte in A (F0-F7); keeps A
    374  3a2a				   SysexStatus
    375  3a2a					      subroutine
    376  3a2a		       c9 f0		      cmp	#$F0
    377  3a2c		       d0 0e		      bne	.end
    378  3a2e		       a2 01		      ldx	#1
    379  3a30		       8e 4d c7 	      stx	sxOn
    380  3a33		       8e 1d c8 	      stx	sxCmd
    381  3a36		       a2 00		      ldx	#0
    382  3a38		       8e 4e c7 	      stx	sxPos
    383  3a3b		       60		      rts
    384  3a3c				   .end
    385  3a3c		       ae 4d c7 	      ldx	sxOn
    386  3a3f		       f0 1c		      beq	.x
    387  3a41		       a2 00		      ldx	#0
    388  3a43		       8e 4d c7 	      stx	sxOn
    389  3a46		       c9 f7		      cmp	#$F7
    390  3a48		       d0 13		      bne	.x
    391  3a4a		       ae 1d c8 	      ldx	sxCmd
    392  3a4d		       e0 02		      cpx	#2
    393  3a4f		       f0 0d		      beq	.dev
    394  3a51		       ae 4e c7 	      ldx	sxPos
    395  3a54		       e0 d5		      cpx	#SX_LEN
    396  3a56		       d0 05		      bne	.x
    397  3a58		       48		      pha
    398  3a59		       20 ef 3a 	      jsr	PatchReceived
    399  3a5c		       68		      pla
    400  3a5d				   .x
    401  3a5d		       60		      rts
    402  3a5e				   .dev
    403  3a5e		       ae 4e c7 	      ldx	sxPos
