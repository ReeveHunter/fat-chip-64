------- FILE midiin.asm LEVEL 2 PASS 2
      0  2350					      include	"midiin.asm"
      1  2350							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  2350							;
      3  2350							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  2350							; The main loop parses them (running status; realtime and system bytes are
      5  2350							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  2350							; notes mode, latch, arp and K + note.
      7  2350							;
      8  2350							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  2350							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  2350							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  2350							;
     12  2350							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  2350							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  2350							;
     15  2350							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  2350							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  2350							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  2350							; MIDI in is passed on to the Game Boy or NES.
     19  2350
     20  2350							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  2350							; Uses A, X.
     22  2350				   RxByte
     23  2350					      subroutine
     24  2350		       ad 06 de 	      lda	ACIA_STAT
     25  2353		       4a		      lsr		; RDRF -> carry
     26  2354		       90 15		      bcc	.x
     27  2356		       ad 07 de 	      lda	ACIA_RX
     28  2359		       ae 25 c4 	      ldx	rxHead
     29  235c		       9d e5 c3 	      sta	rxBuf,x
     30  235f		       e8		      inx
     31  2360		       8a		      txa
     32  2361		       29 3f		      and	#63
     33  2363		       cd 26 c4 	      cmp	rxTail
     34  2366		       f0 03		      beq	.x	; full: dropped
     35  2368		       8d 25 c4 	      sta	rxHead
     36  236b				   .x
     37  236b		       60		      rts
     38  236c
     39  236c							; Main loop, every pass: parse what came in.
     40  236c				   MidiInService
     41  236c					      subroutine
     42  236c				   .next
     43  236c		       ae 26 c4 	      ldx	rxTail
     44  236f		       ec 25 c4 	      cpx	rxHead
     45  2372		       d0 01		      bne	.byte
     46  2374		       60		      rts
     47  2375				   .byte
     48  2375		       bd e5 c3 	      lda	rxBuf,x
     49  2378		       a8		      tay
     50  2379		       e8		      inx
     51  237a		       8a		      txa
     52  237b		       29 3f		      and	#63
     53  237d		       8d 26 c4 	      sta	rxTail
     54  2380		       98		      tya
     55  2381		       10 14		      bpl	.data
     56  2383		       c9 f8		      cmp	#$F8
     57  2385		       b0 e5		      bcs	.next	; realtime (clock, active sensing...): skip
     58  2387		       c9 f0		      cmp	#$F0
     59  2389		       90 02		      bcc	.status
     60  238b		       a9 00		      lda	#0	; system: no running status until the next one
     61  238d				   .status
     62  238d		       8d 27 c4 	      sta	rxStatus
     63  2390		       a9 00		      lda	#0
     64  2392		       8d 28 c4 	      sta	rxCnt
     65  2395		       f0 d5		      beq	.next
     66  2397				   .data
     67  2397		       ae 27 c4 	      ldx	rxStatus
     68  239a		       f0 d0		      beq	.next	; no status yet
     69  239c		       ae 28 c4 	      ldx	rxCnt
     70  239f		       d0 16		      bne	.second
     71  23a1		       8d 29 c4 	      sta	rxD1
     72  23a4		       ee 28 c4 	      inc	rxCnt
     73  23a7		       ad 27 c4 	      lda	rxStatus
     74  23aa		       29 e0		      and	#$E0
     75  23ac		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
     76  23ae		       d0 bc		      bne	.next
     77  23b0		       a9 00		      lda	#0
     78  23b2		       8d 28 c4 	      sta	rxCnt
     79  23b5		       f0 b5		      beq	.next
     80  23b7				   .second
     81  23b7		       8d 2a c4 	      sta	rxD2
     82  23ba		       a9 00		      lda	#0
     83  23bc		       8d 28 c4 	      sta	rxCnt
     84  23bf		       20 c5 23 	      jsr	MidiInMsg
     85  23c2		       4c 6c 23 	      jmp	.next
     86  23c5
     87  23c5							; A full message: rxStatus, rxD1, rxD2
     88  23c5				   MidiInMsg
     89  23c5					      subroutine
     90  23c5		       ad 27 c4 	      lda	rxStatus
     91  23c8		       29 0f		      and	#15
     92  23ca		       c9 0f		      cmp	#DRUM_CH_IN	; channel 16: the keytar's rhythm -> MidiNES drums
     93  23cc		       d0 11		      bne	.notes
     94  23ce		       ad 27 c4 	      lda	rxStatus
     95  23d1		       29 f0		      and	#$F0
     96  23d3		       c9 90		      cmp	#$90
     97  23d5		       d0 26		      bne	.x
     98  23d7		       ad 2a c4 	      lda	rxD2
     99  23da		       f0 21		      beq	.x
    100  23dc		       4c 99 2d 	      jmp	KeytarDrum
    101  23df				   .notes
    102  23df		       c9 0b		      cmp	#MIDI_IN_CHANS
    103  23e1		       b0 1a		      bcs	.x	; channels 12-16: the keytar's accompaniment
    104  23e3		       85 27		      sta	t3
    105  23e5		       ad 27 c4 	      lda	rxStatus
    106  23e8		       29 f0		      and	#$F0
    107  23ea		       c9 80		      cmp	#$80
    108  23ec		       f0 0c		      beq	.off
    109  23ee		       c9 90		      cmp	#$90
    110  23f0		       d0 0b		      bne	.x
    111  23f2		       ad 2a c4 	      lda	rxD2
    112  23f5		       f0 03		      beq	.off	; note-on velocity 0 = note-off
    113  23f7		       4c fe 23 	      jmp	MidiNoteOn
    114  23fa				   .off
    115  23fa		       4c 83 24 	      jmp	MidiNoteOff
    116  23fd				   .x
    117  23fd		       60		      rts
    118  23fe
    119  23fe							; Note-on rxD1 on channel t3
    120  23fe				   MidiNoteOn
    121  23fe					      subroutine
    122  23fe		       ad 29 c4 	      lda	rxD1
    123  2401		       8d 3c c4 	      sta	lastInNote
    124  2404		       a5 27		      lda	t3
    125  2406		       8d 3d c4 	      sta	lastInCh
    126  2409		       a9 01		      lda	#1
    127  240b		       8d 2c c3 	      sta	screenDirty
    128  240e							; already down (a repeated note-on)? ignore
    129  240e		       a2 07		      ldx	#MIDI_SLOTS-1
    130  2410				   .dup
    131  2410		       bd d0 c2 	      lda	physKey+MIDI_FIRST,x
    132  2413		       f0 09		      beq	.dn
    133  2415		       bd 33 c4 	      lda	midiSrc,x
    134  2418		       cd 29 c4 	      cmp	rxD1
    135  241b		       d0 01		      bne	.dn
    136  241d		       60		      rts
    137  241e				   .dn
    138  241e		       ca		      dex
    139  241f		       10 ef		      bpl	.dup
    140  2421							; the note it plays: + midiOct octaves, 0-127 or it's ignored
    141  2421		       ad 3b c4 	      lda	midiOct
    142  2424		       0a		      asl
    143  2425		       0a		      asl		; x 4
    144  2426		       85 24		      sta	t0
    145  2428		       0a		      asl		; x 8
    146  2429		       18		      clc
    147  242a		       65 24		      adc	t0	; x 12 (signed, -48..+48)
    148  242c		       85 24		      sta	t0
    149  242e		       30 08		      bmi	.neg
    150  2430		       18		      clc
    151  2431		       6d 29 c4 	      adc	rxD1
    152  2434		       30 35		      bmi	.no	; over 127
    153  2436		       10 06		      bpl	.got
    154  2438				   .neg
    155  2438		       18		      clc
    156  2439		       6d 29 c4 	      adc	rxD1
    157  243c		       90 2d		      bcc	.no	; under 0
    158  243e				   .got
    159  243e		       85 25		      sta	t1	; note
    160  2440		       20 5b 1c 	      jsr	PlayPrune	; (a freed slot may still be in playOrder)
    161  2443							; a latched slot already playing this note (so ADD latch can take it
    162  2443							; out), else a free slot, else the first one not held down
    163  2443		       a2 07		      ldx	#MIDI_SLOTS-1
    164  2445				   .same
    165  2445		       bd b0 c2 	      lda	noteHeld+MIDI_FIRST,x
    166  2448		       f0 07		      beq	.sn
    167  244a		       bd 2b c4 	      lda	midiNote,x
    168  244d		       c5 25		      cmp	t1
    169  244f		       f0 20		      beq	.use
    170  2451				   .sn
    171  2451		       ca		      dex
    172  2452		       10 f1		      bpl	.same
    173  2454		       a2 07		      ldx	#MIDI_SLOTS-1
    174  2456				   .free
    175  2456		       bd b0 c2 	      lda	noteHeld+MIDI_FIRST,x
    176  2459		       1d d0 c2 	      ora	physKey+MIDI_FIRST,x
    177  245c		       f0 13		      beq	.use
    178  245e		       ca		      dex
    179  245f		       10 f5		      bpl	.free
    180  2461		       a2 07		      ldx	#MIDI_SLOTS-1
    181  2463				   .up
    182  2463		       bd d0 c2 	      lda	physKey+MIDI_FIRST,x
    183  2466		       f0 04		      beq	.steal
    184  2468		       ca		      dex
    185  2469		       10 f8		      bpl	.up
    186  246b				   .no
    187  246b		       60		      rts		; all eight held down: ignored
    188  246c				   .steal
    189  246c		       a9 00		      lda	#0
    190  246e		       9d b0 c2 	      sta	noteHeld+MIDI_FIRST,x
    191  2471				   .use
    192  2471		       a5 25		      lda	t1
    193  2473		       9d 2b c4 	      sta	midiNote,x
    194  2476		       ad 29 c4 	      lda	rxD1
    195  2479		       9d 33 c4 	      sta	midiSrc,x
    196  247c		       8a		      txa
    197  247d		       18		      clc
    198  247e		       69 18		      adc	#MIDI_FIRST
    199  2480		       4c f3 0d 	      jmp	NoteDown
    200  2483
    201  2483							; Note-off rxD1
    202  2483				   MidiNoteOff
    203  2483					      subroutine
    204  2483		       a2 07		      ldx	#MIDI_SLOTS-1
    205  2485				   .f
    206  2485		       bd d0 c2 	      lda	physKey+MIDI_FIRST,x
    207  2488		       f0 08		      beq	.n
    208  248a		       bd 33 c4 	      lda	midiSrc,x
    209  248d		       cd 29 c4 	      cmp	rxD1
    210  2490		       f0 04		      beq	.up
    211  2492				   .n
    212  2492		       ca		      dex
    213  2493		       10 f0		      bpl	.f
    214  2495		       60		      rts
    215  2496				   .up
    216  2496		       8a		      txa
    217  2497		       18		      clc
    218  2498		       69 18		      adc	#MIDI_FIRST
    219  249a		       4c 3f 10 	      jmp	NoteUp
    220  249d
    221  249d							; Panic: every MIDI slot let go (a lost note-off can't keep one down)
    222  249d				   MidiInRelease
    223  249d					      subroutine
    224  249d		       a2 07		      ldx	#MIDI_SLOTS-1
    225  249f				   .l
    226  249f		       bd d0 c2 	      lda	physKey+MIDI_FIRST,x
    227  24a2		       f0 0d		      beq	.n
    228  24a4		       a9 00		      lda	#0
    229  24a6		       9d d0 c2 	      sta	physKey+MIDI_FIRST,x
    230  24a9		       ad d8 c2 	      lda	physCount
    231  24ac		       f0 03		      beq	.n
    232  24ae		       ce d8 c2 	      dec	physCount
    233  24b1				   .n
    234  24b1		       ca		      dex
    235  24b2		       10 eb		      bpl	.l
    236  24b4		       60		      rts
    237  24b5
    238  24b5							; H / J: incoming notes an octave down / up
    239  24b5				   MidiOctDown
    240  24b5					      subroutine
    241  24b5		       ad 3b c4 	      lda	midiOct
    242  24b8		       c9 fc		      cmp	#256-MIDI_OCT_MAX
    243  24ba		       f0 03		      beq	.x
