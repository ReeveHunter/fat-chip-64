------- FILE screen.asm LEVEL 2 PASS 3
      0  7af8					      include	"screen.asm"
      1  7af8							; Fat Chip 64 - screen
      2  7af8							;
      3  7af8							;  row 0      header
      4  7af8							;  row 2      sound, POLY / MONO, Fat Bass
      5  7af8							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  7af8							;	       each plays (row 7: a channel overlap warning)
      7  7af8							;  row 9      key, notes mode, latch
      8  7af8							;  row 10     arp
      9  7af8							;  row 12     tempo, beat, mute
     10  7af8							;  row 13     SPACE's action, octave (the lowest key), transpose
     11  7af8							;  row 14     v0.40: the effect the C= keys work on, its setting
     12  7af8							;  row 15     held notes
     13  7af8							;  row 16     MIDI in
     14  7af8							;  row 24     F keys
     15  7af8
     16  7af8							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     17  7af8							; Letters become screen codes; bit 7 of t2 reverses.
