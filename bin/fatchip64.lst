      0  3b36					      include	"menu.asm"
      1  3b36							; Fat Chip 64 - the menu (v0.13): SHIFT+RETURN in and out
      2  3b36							;
      3  3b36							; CRSR DOWN / SHIFT+CRSR DOWN (up): choose a setting. CRSR RIGHT or RETURN /
      4  3b36							; SHIFT+CRSR RIGHT: its next / previous value. Every other key works as
      5  3b36							; usual (notes play; V, F keys, = ... too: the values here follow).
      6  3b36							; The play screen pauses while the menu is up and redraws when it closes.
      7  3b36
