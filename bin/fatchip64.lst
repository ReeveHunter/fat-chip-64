      0  5488					      include	"patchedit.asm"
      1  5488							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  5488							; the dice. The settings and their steps come from tools/gen_menu.py
      3  5488							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  5488							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  5488							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  5488							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  5488							; (EnvDerive).
      8  5488
      9  5488		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  5488		       00 30	   LFO_LAST   equ	FLD_gbLDelay
