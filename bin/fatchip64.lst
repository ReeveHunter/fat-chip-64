      0  693c					      include	"wander.asm"
      1  693c							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  693c							;
      3  693c							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  693c							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  693c							;   ATTACK   as always: the new notes start
      6  693c							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  693c							;	      has none)
      8  693c							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  693c							;	      start again
     10  693c							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  693c							;	      late; some glide, some start again (fade out, come back in)
     12  693c							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  693c							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  693c							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  693c							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  693c
     17  693c		       00 01	   CHG_ATTACK equ	1
     18  693c		       00 02	   CHG_GLIDE  equ	2
     19  693c		       00 03	   CHG_STAGGER equ	3
     20  693c		       00 04	   CHG_WANDER equ	4
     21  693c		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  693c		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  693c
     24  693c							; A = the chord change style now (keeps X, Y)
