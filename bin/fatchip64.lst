      0  0cf4					      include	"keys.asm"
      1  0cf4							; Fat Chip 64 - keyboard and RESTORE
      2  0cf4
      3  0cf4							; Scan the whole matrix, turn changes into key events.
      4  0cf4							;
      5  0cf4							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0cf4							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0cf4							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0cf4							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0cf4							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0cf4							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0cf4							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0cf4							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0cf4							; chords whose ghost lands on another used key lose their newest note.
     14  0cf4				   KeyScan
     15  0cf4					      subroutine
     16  0cf4		       a2 07		      ldx	#7
     17  0cf6				   .col
     18  0cf6		       bd e8 4f 	      lda	colSelect,x
     19  0cf9		       8d 00 dc 	      sta	CIA1_PRA
     20  0cfc		       ad 01 dc 	      lda	CIA1_PRB
     21  0cff		       49 ff		      eor	#$FF
     22  0d01		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0d04		       9d 80 c2 	      sta	keyNow,x
     24  0d07		       ca		      dex
     25  0d08		       10 ec		      bpl	.col
     26  0d0a		       a9 ff		      lda	#$FF
     27  0d0c		       8d 00 dc 	      sta	CIA1_PRA
     28  0d0f							; ---- releases first: accepted keys that are up now
     29  0d0f		       a2 00		      ldx	#0
     30  0d11				   .rc
     31  0d11		       8e 37 c3 	      stx	ksCol
     32  0d14		       bd 80 c2 	      lda	keyNow,x
     33  0d17		       49 ff		      eor	#$FF
     34  0d19		       3d 90 c2 	      and	keyAcc,x
     35  0d1c		       8d 36 c3 	      sta	ksBits
     36  0d1f		       a9 00		      lda	#0
     37  0d21		       8d 38 c3 	      sta	ksRow
     38  0d24				   .rb
     39  0d24		       ad 36 c3 	      lda	ksBits
     40  0d27		       f0 21		      beq	.rcn
     41  0d29		       4e 36 c3 	      lsr	ksBits
     42  0d2c		       90 17		      bcc	.rbn
     43  0d2e		       ae 37 c3 	      ldx	ksCol
     44  0d31		       ac 38 c3 	      ldy	ksRow
     45  0d34		       b9 f0 4f 	      lda	rowBit,y
     46  0d37		       49 ff		      eor	#$FF
     47  0d39		       3d 90 c2 	      and	keyAcc,x
     48  0d3c		       9d 90 c2 	      sta	keyAcc,x
     49  0d3f		       20 d1 0d 	      jsr	KeyCode
     50  0d42		       20 77 10 	      jsr	KeyUp
     51  0d45				   .rbn
     52  0d45		       ee 38 c3 	      inc	ksRow
     53  0d48		       d0 da		      bne	.rb
     54  0d4a				   .rcn
     55  0d4a		       ae 37 c3 	      ldx	ksCol
     56  0d4d		       e8		      inx
     57  0d4e		       e0 08		      cpx	#8
     58  0d50		       d0 bf		      bne	.rc
     59  0d52							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     60  0d52							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     61  0d52							; still count as a combination.
     62  0d52		       a9 00		      lda	#0
     63  0d54		       8d 3a c3 	      sta	ksPass
     64  0d57				   .pass
     65  0d57		       a2 00		      ldx	#0
     66  0d59				   .pc
     67  0d59		       8e 37 c3 	      stx	ksCol
     68  0d5c		       bd 90 c2 	      lda	keyAcc,x
     69  0d5f		       49 ff		      eor	#$FF
     70  0d61		       3d 80 c2 	      and	keyNow,x
     71  0d64		       8d 36 c3 	      sta	ksBits
     72  0d67		       a9 00		      lda	#0
     73  0d69		       8d 38 c3 	      sta	ksRow
     74  0d6c				   .pb
     75  0d6c		       ad 36 c3 	      lda	ksBits
     76  0d6f		       f0 3d		      beq	.pcn
     77  0d71		       4e 36 c3 	      lsr	ksBits
     78  0d74		       90 33		      bcc	.pbn
     79  0d76		       ad 3b c3 	      lda	ghostFilter
     80  0d79		       f0 05		      beq	.accept	; filter off (default): phantoms play
     81  0d7b		       20 df 0d 	      jsr	Suspect
     82  0d7e		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     83  0d80				   .accept
     84  0d80		       20 d1 0d 	      jsr	KeyCode
     85  0d83		       20 c2 0d 	      jsr	IsModifier	; Z set = modifier
     86  0d86		       f0 07		      beq	.mod
     87  0d88		       ad 3a c3 	      lda	ksPass
     88  0d8b		       f0 1c		      beq	.pbn	; pass 0: modifiers only
     89  0d8d		       d0 05		      bne	.take
     90  0d8f				   .mod
     91  0d8f		       ad 3a c3 	      lda	ksPass
     92  0d92		       d0 15		      bne	.pbn	; (taken in pass 0)
     93  0d94				   .take
     94  0d94		       ae 37 c3 	      ldx	ksCol
     95  0d97		       ac 38 c3 	      ldy	ksRow
     96  0d9a		       b9 f0 4f 	      lda	rowBit,y
     97  0d9d		       1d 90 c2 	      ora	keyAcc,x
     98  0da0		       9d 90 c2 	      sta	keyAcc,x
     99  0da3		       20 d1 0d 	      jsr	KeyCode
    100  0da6		       20 10 0e 	      jsr	KeyDown
    101  0da9				   .pbn
    102  0da9		       ee 38 c3 	      inc	ksRow
    103  0dac		       d0 be		      bne	.pb
    104  0dae				   .pcn
    105  0dae		       ae 37 c3 	      ldx	ksCol
    106  0db1		       e8		      inx
    107  0db2		       e0 08		      cpx	#8
    108  0db4		       d0 a3		      bne	.pc
    109  0db6		       ad 3a c3 	      lda	ksPass
    110  0db9		       d0 06		      bne	.done
    111  0dbb		       ee 3a c3 	      inc	ksPass
    112  0dbe		       4c 57 0d 	      jmp	.pass
    113  0dc1				   .done
    114  0dc1		       60		      rts
