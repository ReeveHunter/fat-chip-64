      0  633b					      include	"patchedit.asm"
      1  633b							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  633b							; the dice. The settings and their steps come from tools/gen_menu.py
      3  633b							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  633b							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  633b							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  633b							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  633b							; (EnvDerive).
      8  633b
      9  633b		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  633b		       00 30	   LFO_LAST   equ	FLD_gbLDelay
