     57  40bc		       ad 3f c3 	      lda	nowH
     58  40bf		       ed 7a c4 	      sbc	dmcAt+1
     59  40c2		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  40c4		       c0 0c		      cpy	#DRUM_WINDOW
     61  40c6		       b0 08		      bcs	.ok
