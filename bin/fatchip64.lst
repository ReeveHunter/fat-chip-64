      0  0c0c					      include	"keys.asm"
      1  0c0c							; Fat Chip 64 - keyboard and RESTORE
      2  0c0c
      3  0c0c							; Scan the whole matrix, turn changes into key events.
      4  0c0c							;
      5  0c0c							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0c0c							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0c0c							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0c0c							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0c0c							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0c0c							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0c0c							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0c0c							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0c0c							; chords whose ghost lands on another used key lose their newest note.
     14  0c0c				   KeyScan
     15  0c0c					      subroutine
     16  0c0c		       a2 07		      ldx	#7
     17  0c0e				   .col
     18  0c0e		       bd 89 24 	      lda	colSelect,x
     19  0c11		       8d 00 dc 	      sta	CIA1_PRA
     20  0c14		       ad 01 dc 	      lda	CIA1_PRB
     21  0c17		       49 ff		      eor	#$FF
     22  0c19		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0c1c		       9d 80 c2 	      sta	keyNow,x
     24  0c1f		       ca		      dex
     25  0c20		       10 ec		      bpl	.col
     26  0c22		       a9 ff		      lda	#$FF
     27  0c24		       8d 00 dc 	      sta	CIA1_PRA
     28  0c27							; ---- releases first: accepted keys that are up now
     29  0c27		       a2 00		      ldx	#0
     30  0c29				   .rc
     31  0c29		       8e 1f c3 	      stx	ksCol
     32  0c2c		       bd 80 c2 	      lda	keyNow,x
     33  0c2f		       49 ff		      eor	#$FF
     34  0c31		       3d 90 c2 	      and	keyAcc,x
     35  0c34		       8d 1e c3 	      sta	ksBits
     36  0c37		       a9 00		      lda	#0
     37  0c39		       8d 20 c3 	      sta	ksRow
     38  0c3c				   .rb
     39  0c3c		       ad 1e c3 	      lda	ksBits
     40  0c3f		       f0 21		      beq	.rcn
     41  0c41		       4e 1e c3 	      lsr	ksBits
     42  0c44		       90 17		      bcc	.rbn
     43  0c46		       ae 1f c3 	      ldx	ksCol
     44  0c49		       ac 20 c3 	      ldy	ksRow
     45  0c4c		       b9 91 24 	      lda	rowBit,y
     46  0c4f		       49 ff		      eor	#$FF
     47  0c51		       3d 90 c2 	      and	keyAcc,x
     48  0c54		       9d 90 c2 	      sta	keyAcc,x
     49  0c57		       20 e9 0c 	      jsr	KeyCode
     50  0c5a		       20 64 0f 	      jsr	KeyUp
     51  0c5d				   .rbn
     52  0c5d		       ee 20 c3 	      inc	ksRow
     53  0c60		       d0 da		      bne	.rb
     54  0c62				   .rcn
     55  0c62		       ae 1f c3 	      ldx	ksCol
     56  0c65		       e8		      inx
     57  0c66		       e0 08		      cpx	#8
     58  0c68		       d0 bf		      bne	.rc
     59  0c6a							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     60  0c6a							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     61  0c6a							; still count as a combination.
     62  0c6a		       a9 00		      lda	#0
     63  0c6c		       8d 22 c3 	      sta	ksPass
     64  0c6f				   .pass
     65  0c6f		       a2 00		      ldx	#0
     66  0c71				   .pc
     67  0c71		       8e 1f c3 	      stx	ksCol
     68  0c74		       bd 90 c2 	      lda	keyAcc,x
     69  0c77		       49 ff		      eor	#$FF
     70  0c79		       3d 80 c2 	      and	keyNow,x
     71  0c7c		       8d 1e c3 	      sta	ksBits
     72  0c7f		       a9 00		      lda	#0
     73  0c81		       8d 20 c3 	      sta	ksRow
     74  0c84				   .pb
     75  0c84		       ad 1e c3 	      lda	ksBits
     76  0c87		       f0 3d		      beq	.pcn
     77  0c89		       4e 1e c3 	      lsr	ksBits
     78  0c8c		       90 33		      bcc	.pbn
     79  0c8e		       ad 23 c3 	      lda	ghostFilter
     80  0c91		       f0 05		      beq	.accept	; filter off (default): phantoms play
     81  0c93		       20 f7 0c 	      jsr	Suspect
     82  0c96		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     83  0c98				   .accept
     84  0c98		       20 e9 0c 	      jsr	KeyCode
     85  0c9b		       20 da 0c 	      jsr	IsModifier	; Z set = modifier
     86  0c9e		       f0 07		      beq	.mod
     87  0ca0		       ad 22 c3 	      lda	ksPass
     88  0ca3		       f0 1c		      beq	.pbn	; pass 0: modifiers only
     89  0ca5		       d0 05		      bne	.take
     90  0ca7				   .mod
     91  0ca7		       ad 22 c3 	      lda	ksPass
     92  0caa		       d0 15		      bne	.pbn	; (taken in pass 0)
     93  0cac				   .take
     94  0cac		       ae 1f c3 	      ldx	ksCol
     95  0caf		       ac 20 c3 	      ldy	ksRow
     96  0cb2		       b9 91 24 	      lda	rowBit,y
     97  0cb5		       1d 90 c2 	      ora	keyAcc,x
     98  0cb8		       9d 90 c2 	      sta	keyAcc,x
     99  0cbb		       20 e9 0c 	      jsr	KeyCode
    100  0cbe		       20 28 0d 	      jsr	KeyDown
    101  0cc1				   .pbn
    102  0cc1		       ee 20 c3 	      inc	ksRow
    103  0cc4		       d0 be		      bne	.pb
    104  0cc6				   .pcn
    105  0cc6		       ae 1f c3 	      ldx	ksCol
    106  0cc9		       e8		      inx
    107  0cca		       e0 08		      cpx	#8
    108  0ccc		       d0 a3		      bne	.pc
    109  0cce		       ad 22 c3 	      lda	ksPass
    110  0cd1		       d0 06		      bne	.done
    111  0cd3		       ee 22 c3 	      inc	ksPass
    112  0cd6		       4c 6f 0c 	      jmp	.pass
    113  0cd9				   .done
