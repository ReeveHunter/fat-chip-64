     46  60ad		       c9 ff		      cmp	#NO_NOTE	;  voice's last note, like a portamento)
     47  60af		       f0 25		      beq	.now0
     48  60b1		       ad ca c3 	      lda	hardCut
     49  60b4		       0d 44 c4 	      ora	monoMode
     50  60b7		       d0 1d		      bne	.now0
