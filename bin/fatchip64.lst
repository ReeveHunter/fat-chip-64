     98  7226		       99 e1 c3 	      sta	sidBaseHi,y
     99  7229		       ad 97 c6 	      lda	sndPenvK
    100  722c		       ae 93 c6 	      ldx	sndStep
    101  722f		       f0 02		      beq	.k
    102  7231		       a9 ff		      lda	#$FF	; (STEP: held; AtkStep jumps)
    103  7233				   .k
    104  7233		       99 62 c9 	      sta	sK,y
    105  7236				   .x
    106  7236		       60		      rts
