      0  5759					      include	"menu.asm"
      1  5759							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  5759							;
      3  5759							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  5759							;   page   RETURN opens a page
      5  5759							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  5759							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  5759							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  5759							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  5759							; device pages, until DEVICES says the device is in use).
     10  5759							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  5759							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  5759							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  5759
     14  5759		       00 17	   MENU_VALCOL equ	23
     15  5759
