------- FILE keys.asm LEVEL 2 PASS 3
      0  0efb					      include	"keys.asm"
      1  0efb							; Fat Chip 64 - keyboard and RESTORE
      2  0efb
      3  0efb							; Scan the whole matrix, turn changes into key events.
      4  0efb							;
      5  0efb							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0efb							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0efb							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0efb							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0efb							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0efb							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0efb							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0efb							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0efb							; chords whose ghost lands on another used key lose their newest note.
     14  0efb				   KeyScan
     15  0efb					      subroutine
     16  0efb		       a2 07		      ldx	#7
     17  0efd				   .col
     18  0efd		       bd 94 88 	      lda	colSelect,x
     19  0f00		       8d 00 dc 	      sta	CIA1_PRA
     20  0f03		       ad 01 dc 	      lda	CIA1_PRB
     21  0f06		       49 ff		      eor	#$FF
     22  0f08		       3d 48 c7 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0f0b		       9d 40 c7 	      sta	keyNow,x
     24  0f0e		       ca		      dex
     25  0f0f		       10 ec		      bpl	.col
     26  0f11		       a9 ff		      lda	#$FF
     27  0f13		       8d 00 dc 	      sta	CIA1_PRA
     28  0f16							; ---- every column as accepted (nothing pressed or let go): done
     29  0f16		       a2 07		      ldx	#7
     30  0f18				   .same
     31  0f18		       bd 40 c7 	      lda	keyNow,x
     32  0f1b		       dd 50 c7 	      cmp	keyAcc,x
     33  0f1e		       d0 04		      bne	.changed
     34  0f20		       ca		      dex
     35  0f21		       10 f5		      bpl	.same
     36  0f23		       60		      rts
     37  0f24				   .changed
     38  0f24							; ---- releases first: accepted keys that are up now
     39  0f24		       a2 00		      ldx	#0
     40  0f26				   .rc
     41  0f26		       8e fc c7 	      stx	ksCol
     42  0f29		       bd 40 c7 	      lda	keyNow,x
     43  0f2c		       49 ff		      eor	#$FF
     44  0f2e		       3d 50 c7 	      and	keyAcc,x
     45  0f31		       8d fb c7 	      sta	ksBits
     46  0f34		       a9 00		      lda	#0
     47  0f36		       8d fd c7 	      sta	ksRow
     48  0f39				   .rb
     49  0f39		       ad fb c7 	      lda	ksBits
     50  0f3c		       f0 21		      beq	.rcn
     51  0f3e		       4e fb c7 	      lsr	ksBits
     52  0f41		       90 17		      bcc	.rbn
     53  0f43		       ae fc c7 	      ldx	ksCol
     54  0f46		       ac fd c7 	      ldy	ksRow
     55  0f49		       b9 9c 88 	      lda	rowBit,y
     56  0f4c		       49 ff		      eor	#$FF
     57  0f4e		       3d 50 c7 	      and	keyAcc,x
     58  0f51		       9d 50 c7 	      sta	keyAcc,x
     59  0f54		       20 fa 0f 	      jsr	KeyCode
     60  0f57		       20 68 19 	      jsr	KeyUp
     61  0f5a				   .rbn
     62  0f5a		       ee fd c7 	      inc	ksRow
     63  0f5d		       d0 da		      bne	.rb
     64  0f5f				   .rcn
     65  0f5f		       ae fc c7 	      ldx	ksCol
     66  0f62		       e8		      inx
     67  0f63		       e0 08		      cpx	#8
     68  0f65		       d0 bf		      bne	.rc
     69  0f67							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0f67							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0f67							; still count as a combination.
     72  0f67		       a9 00		      lda	#0
     73  0f69		       8d ff c7 	      sta	ksPass
     74  0f6c				   .pass
     75  0f6c		       a2 00		      ldx	#0
     76  0f6e				   .pc
     77  0f6e		       8e fc c7 	      stx	ksCol
     78  0f71		       bd 50 c7 	      lda	keyAcc,x
     79  0f74		       49 ff		      eor	#$FF
     80  0f76		       3d 40 c7 	      and	keyNow,x
     81  0f79		       8d fb c7 	      sta	ksBits
     82  0f7c		       a9 00		      lda	#0
     83  0f7e		       8d fd c7 	      sta	ksRow
     84  0f81				   .pb
     85  0f81		       ad fb c7 	      lda	ksBits
     86  0f84		       f0 49		      beq	.pcn
     87  0f86		       4e fb c7 	      lsr	ksBits
     88  0f89		       90 3f		      bcc	.pbn
     89  0f8b		       ad 00 c8 	      lda	ghostFilter
     90  0f8e		       d0 0c		      bne	.chk	; filter off (default): phantom notes play...
     91  0f90		       20 fa 0f 	      jsr	KeyCode
     92  0f93		       c9 18		      cmp	#24
     93  0f95		       90 0a		      bcc	.accept
     94  0f97		       20 e3 0f 	      jsr	IsModifier
