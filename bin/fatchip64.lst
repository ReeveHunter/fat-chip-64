     80  4ca3		       ad 6e c4 	      lda	beatSel	; x 12
     81  4ca6		       0a		      asl
     82  4ca7		       0a		      asl
     83  4ca8		       85 26		      sta	t2
     84  4caa		       0a		      asl
     85  4cab		       65 26		      adc	t2
     86  4cad		       65 25		      adc	t1
     87  4caf		       aa		      tax
     88  4cb0		       bd fa a4 	      lda	kits,x
     89  4cb3		       85 25		      sta	t1
     90  4cb5							; bank (CC14 on the sample channel) when it changes
     91  4cb5		       a9 04		      lda	#4
     92  4cb7		       20 0f 4d 	      jsr	NesChStatus	; mS = CC, sample channel
     93  4cba		       a9 00		      lda	#0
     94  4cbc		       a6 25		      ldx	t1
     95  4cbe		       10 02		      bpl	.a
     96  4cc0		       a9 7f		      lda	#127
     97  4cc2				   .a
     98  4cc2		       cd 78 c4 	      cmp	dmcBank
     99  4cc5		       f0 0c		      beq	.note
    100  4cc7		       8d 78 c4 	      sta	dmcBank
    101  4cca		       85 23		      sta	mD2
    102  4ccc		       a9 0e		      lda	#14
    103  4cce		       85 22		      sta	mD1
    104  4cd0		       20 32 0d 	      jsr	NesPut
    105  4cd3				   .note
    106  4cd3		       a5 21		      lda	mS
    107  4cd5		       29 0f		      and	#$0F
    108  4cd7		       85 26		      sta	t2	; channel
    109  4cd9		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    110  4cdb							;  cuts it anyway, and the hit lands 1 ms sooner)
    111  4cdb		       29 7f		      and	#$7F
    112  4cdd		       8d 85 c4 	      sta	dmcNote
