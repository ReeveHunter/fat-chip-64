    466  415d		       48 50 54 58*gbVibRateT .byte.b	72, 80, 84, 88, 92, 96, 100
    467  4164		       00 08 10 20*gbVibDelT  .byte.b	0, 8, 16, 32, 64
    468  4169		       10 20 30 40 gbGlideT   .byte.b	16, 32, 48, 64
    469  416d		       03 06 0a 10 gbDetT     .byte.b	3, 6, 10, 16
