------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  35c8					      include	"sync.asm"
      1  35c8							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  35c8							;
      3  35c8							; Menu, DEVICE SYNC (defaults first):
      4  35c8							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  35c8							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  35c8							;		     sets the tempo, averaged over beats (the clock jitters about
      7  35c8							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  35c8							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  35c8							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  35c8							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  35c8							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  35c8							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  35c8							;		     picks a beat demo (styleBeat)
     14  35c8							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  35c8							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  35c8							;		     key channel) picks a sound (voiceSound)
     17  35c8							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  35c8							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  35c8							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  35c8							;
     21  35c8							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  35c8							; 1/4 ms); a Start makes the next clock a beat.
     23  35c8
     24  35c8		       00 00	   TEMPO_KEYTAR equ	0
     25  35c8		       00 01	   TEMPO_OWN  equ	1
     26  35c8		       00 02	   TEMPO_SC   equ	2
     27  35c8		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  35c8
     29  35c8
     30  35c8
     31  35c8							; ------------------------------------------------------------ clock
     32  35c8							; Main loop, every pass
