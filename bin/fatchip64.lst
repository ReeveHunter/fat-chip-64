     96 U001f		       00 00	   nmiTick    ds	2
     97 U0021		       00	   nmiSeen    ds	1
     98 U0022		       00	   mS	      ds	1	; message being queued: status, data 1, data 2
     99 U0023		       00	   mD1	      ds	1
    100 U0024		       00	   mD2	      ds	1
    101 U0025		       00	   t0	      ds	1
    102 U0026		       00	   t1	      ds	1
    103 U0027		       00	   t2	      ds	1
    104 U0028		       00	   t3	      ds	1
    105 U0029		       00 00	   ptr	      ds	2
    106 U002b		       00 00	   ptr2       ds	2
    107 U002d		       00	   irqT       ds	1	; IRQ-only temporary
    108 U002e		       00	   subTick    ds	1	; IRQs since the last 1 ms tick (0-2)
