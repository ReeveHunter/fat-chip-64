      0  37eb					      include	"midiin.asm"
      1  37eb							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  37eb							;
      3  37eb							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  37eb							; The main loop parses them (running status; realtime and system bytes are
      5  37eb							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  37eb							; notes mode, latch, arp and K + note.
      7  37eb							;
      8  37eb							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  37eb							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  37eb							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  37eb							;
     12  37eb							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  37eb							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  37eb							;
     15  37eb							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  37eb							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  37eb							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  37eb							; MIDI in is passed on to the Game Boy or NES.
     19  37eb
     20  37eb							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  37eb							; Uses A, X.
     22  37eb							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  37eb							; with the time; a Start ($FA) makes the next clock a beat.
     24  37eb				   RxByte
     25  37eb					      subroutine
     26  37eb		       ad 06 de 	      lda	ACIA_STAT
     27  37ee		       4a		      lsr		; RDRF -> carry
     28  37ef		       90 2b		      bcc	.x
     29  37f1				   RxGot
     30  37f1		       ad 07 de 	      lda	ACIA_RX
     31  37f4		       c9 f8		      cmp	#$F8
     32  37f6		       f0 25		      beq	.clk
     33  37f8		       c9 fa		      cmp	#$FA
     34  37fa		       d0 0e		      bne	.buf
     35  37fc		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  37fe		       8e e9 c5 	      stx	clkPhase
     37  3801		       8e f1 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3804							;  the main loop could measure it)
     39  3804		       ae ea c5 	      ldx	clkBeat
     40  3807		       8e fc c5 	      stx	clkStartBeat
     41  380a				   .buf
     42  380a		       ae 25 c4 	      ldx	rxHead
     43  380d		       9d e5 c3 	      sta	rxBuf,x
     44  3810		       e8		      inx
     45  3811		       8a		      txa
     46  3812		       29 3f		      and	#63
     47  3814		       cd 26 c4 	      cmp	rxTail
     48  3817		       f0 03		      beq	.x	; full: dropped
     49  3819		       8d 25 c4 	      sta	rxHead
     50  381c				   .x
     51  381c		       60		      rts
     52  381d				   .clk
     53  381d		       ee e5 c5 	      inc	clkCount
     54  3820		       ae e9 c5 	      ldx	clkPhase
     55  3823		       e8		      inx
     56  3824		       e0 18		      cpx	#24
     57  3826		       90 1b		      bcc	.ph
     58  3828		       a5 10		      lda	ticks
     59  382a		       8d ec c5 	      sta	clkAtL
     60  382d		       a5 11		      lda	ticks+1
     61  382f		       8d ed c5 	      sta	clkAtH
     62  3832		       a5 2d		      lda	subTick
     63  3834		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  3836		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  3838		       ad 05 dc 	      lda	CIA1_TAHI
     66  383b				   .q
     67  383b		       8d ee c5 	      sta	clkAtS
     68  383e		       ee ea c5 	      inc	clkBeat
     69  3841		       a2 00		      ldx	#0
     70  3843				   .ph
     71  3843		       8e e9 c5 	      stx	clkPhase
     72  3846		       60		      rts
