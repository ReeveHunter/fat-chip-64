    103  0ba6							; IRQ: pace device queues onto the wire.
    104  0ba6							;
    105  0ba6							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0ba6							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0ba6							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0ba6							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0ba6							;
    110  0ba6							; When the Game Boy is on, everything on the wire also passes through the
    111  0ba6							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0ba6							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0ba6							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0ba6							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0ba6							; message, the rate measured clean.
    116  0ba6				   Schedule
    117  0ba6					      subroutine
    118  0ba6		       ad 26 c3 	      lda	devOn+DEV_GB
    119  0ba9		       f0 10		      beq	.gb
    120  0bab		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0bad		       f0 0c		      beq	.gb
    122  0baf		       c6 2e		      dec	linkLoad
    123  0bb1		       f0 08		      beq	.gb
    124  0bb3		       a5 10		      lda	ticks
    125  0bb5		       29 01		      and	#1
    126  0bb7		       f0 02		      beq	.gb
    127  0bb9		       c6 2e		      dec	linkLoad
    128  0bbb				   .gb
    129  0bbb							; ---- Game Boy
    130  0bbb		       a5 18		      lda	gbqTail
    131  0bbd		       c5 17		      cmp	gbqHead
    132  0bbf		       f0 36		      beq	.nes
    133  0bc1		       a5 19		      lda	gbNext
    134  0bc3		       38		      sec
    135  0bc4		       e5 10		      sbc	ticks
    136  0bc6		       f0 04		      beq	.gbDue
    137  0bc8		       c9 04		      cmp	#GB_GAP+1
    138  0bca		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0bcc				   .gbDue
    140  0bcc							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0bcc							; bytes already waiting would otherwise delay this one and squeeze it
    142  0bcc							; against the next). While a Game Boy message is due, the NES doesn't
    143  0bcc							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0bcc							; holding its notes back.
    145  0bcc		       a5 15		      lda	wireHead
    146  0bce		       c5 16		      cmp	wireTail
    147  0bd0		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0bd2		       20 38 0c 	      jsr	LinkRoom
    149  0bd5		       90 20		      bcc	.nes
    150  0bd7		       a6 18		      ldx	gbqTail
    151  0bd9		       bd 00 c1 	      lda	gbqS,x
    152  0bdc		       bc 80 c1 	      ldy	gbqD2,x
    153  0bdf		       84 2c		      sty	irqT
    154  0be1		       bc 40 c1 	      ldy	gbqD1,x
    155  0be4		       20 54 0c 	      jsr	WireMsg
    156  0be7		       a5 18		      lda	gbqTail
    157  0be9		       18		      clc
    158  0bea		       69 01		      adc	#1
    159  0bec		       29 3f		      and	#63
    160  0bee		       85 18		      sta	gbqTail
    161  0bf0		       a5 10		      lda	ticks
    162  0bf2		       18		      clc
    163  0bf3		       69 03		      adc	#GB_GAP
    164  0bf5		       85 19		      sta	gbNext
    165  0bf7				   .nes
    166  0bf7		       20 a6 2b 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0bfa		       a5 1b		      lda	nesqTail
    168  0bfc		       c5 1a		      cmp	nesqHead
    169  0bfe		       f0 37		      beq	.done
    170  0c00		       a5 1c		      lda	nesNext
    171  0c02		       38		      sec
    172  0c03		       e5 10		      sbc	ticks
    173  0c05		       f0 04		      beq	.nesDue
    174  0c07		       c9 02		      cmp	#NES_GAP+1
    175  0c09		       90 2c		      bcc	.done
    176  0c0b				   .nesDue
    177  0c0b		       20 4b 0c 	      jsr	WireFree
    178  0c0e		       c9 03		      cmp	#3
    179  0c10		       90 25		      bcc	.done
    180  0c12		       20 38 0c 	      jsr	LinkRoom
    181  0c15		       90 20		      bcc	.done
    182  0c17		       a6 1b		      ldx	nesqTail
    183  0c19		       bd c0 c1 	      lda	nesqS,x
    184  0c1c		       bc 40 c2 	      ldy	nesqD2,x
    185  0c1f		       84 2c		      sty	irqT
    186  0c21		       bc 00 c2 	      ldy	nesqD1,x
    187  0c24		       20 54 0c 	      jsr	WireMsg
    188  0c27		       a5 1b		      lda	nesqTail
    189  0c29		       18		      clc
    190  0c2a		       69 01		      adc	#1
    191  0c2c		       29 3f		      and	#63
    192  0c2e		       85 1b		      sta	nesqTail
    193  0c30		       a5 10		      lda	ticks
    194  0c32		       18		      clc
    195  0c33		       69 01		      adc	#NES_GAP
    196  0c35		       85 1c		      sta	nesNext
    197  0c37				   .done
