    148  6de2							; voice X's glide offset closer to 0: by off / 2^glideK for each 4 ms step
    149  6de2							; (worked out once: d = off >> k, off -= d x n; past 0 or nothing left to
    150  6de2							; move by: there). Keeps X.
    151  6de2				   NesGlideStep
    152  6de2					      subroutine
    153  6de2		       bd c3 c4 	      lda	nesGlL,x
