------- FILE main.asm LEVEL 1 PASS 3
      1  ca8c ????						; Fat Chip 64 - main program
      2  ca8c ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  ca8c ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  ca8c ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  ca8c ????
      6  ca8c ????				      processor	6502
