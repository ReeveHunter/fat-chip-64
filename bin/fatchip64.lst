    389  0dd6		       a9 67		      lda	#GCC_TUNE
    390  0dd8		       20 5b 0d 	      jsr	GbGlobal
    391  0ddb		       a9 68		      lda	#GCC_WARBLE	; a little drift so stacked voices breathe
    392  0ddd		       a2 18		      ldx	#24
    393  0ddf		       20 5b 0d 	      jsr	GbGlobal
    394  0de2		       a9 69		      lda	#GCC_WSPEED
