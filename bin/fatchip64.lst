      0  6776					      include	"nesfx.asm"
      1  6776							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  6776							;
      3  6776							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  6776							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  6776							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  6776							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  6776							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  6776							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  6776							;   glide    a new note starts bent back to the voice's last note and slides
     10  6776							;	      in the way the SID's does (all three channels)
     11  6776							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  6776							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  6776							; semitone, so these are a little stepped.
     14  6776
     15  6776		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  6776							;  (the pulses, and the triangle while it glides)
     17  6776
     18  6776							; A = 1 (not Z) when a NesFxTick step is due
     19  6776				   NesFxDue
     20  6776					      subroutine
