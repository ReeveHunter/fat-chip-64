     73  230a		       a5 24		      lda	t0
     74  230c		       9d 49 c3 	      sta	tapRingLo,x
     75  230f		       a5 25		      lda	t1
     76  2311		       9d 4d c3 	      sta	tapRingHi,x
     77  2314		       e8		      inx
     78  2315		       8a		      txa
     79  2316		       29 03		      and	#3
