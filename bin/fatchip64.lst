    878 Ucf77		       00	   gbTremOff  ds	1	; v0.66: 1 while the Game Boy's tremolo is held off for its beats
    879 Ucf78		       00	   fxE	      ds	1	; v0.66: the effect FxOn / FxOff work on (FxMode can change peE)
    880 Ucf79		       00	   beatLoop   ds	1	; loops of the cycle played (A<->B)
    881 Ucf7a		       00	   cycLen     ds	1	; the cycle (the time signature over the beat's 32 steps)
    882 Ucf7b		       00 00 00 00*cycSrc     ds	32	;  each step's place in the beat
    883 Ucf9b		       00 00 00 00*cycPos     ds	32	;  its place in its bar
    884 Ucfbb		       00 00 00 00*cycBar     ds	32	;  which bar
    885 Ucfdb		       00	   hitLo      ds	1	; this step's lanes (bit = LANES order: kick .. hi hat)
    886 Ucfdc		       00	   hitHi      ds	1	;  (open hat .. clave)
    887 Ucfdd		       00	   hitSt      ds	1	; its accent: 0 soft, 1 normal, 2 strong
    888 Ucfde		       00	   hitFill    ds	1	; (a fill: the levels are its own)
    889 Ucfdf		       00	   tripK      ds	1	; triplet hats: the next of the beat's three (3 = none)
    890 Ucfe0		       00	   tripJ      ds	1	;  the first one's place in the layer's 12
    891 Ucfe1		       00 00	   tripMs     ds	2	;  a third of a beat, ms
    892 Ucfe3		       00	   tripAtL    ds	1
    893 Ucfe4		       00	   tripAtH    ds	1
    894 Ucfe5		       00	   gbKitSent  ds	1	; the Game Boy drum kit (CC 70) last sent + 1 (0: not yet)
    895 Ucfe6		       00	   gbHatSent  ds	1	; its HATS (CC 71) + 1
    896 Ucfe7				   ramEnd     ds	0
    897 Ucfe7				  -	      if	ramEnd > $D000
    898 Ucfe7				  -	      echo	"RAM variables run past $D000 (the I/O)"
    899 Ucfe7				  -	      err
    900 Ucfe7					      endif
