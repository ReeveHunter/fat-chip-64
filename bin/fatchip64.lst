------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  46bd					      include	"sync.asm"
      1  46bd							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  46bd							;
      3  46bd							; Menu, DEVICE SYNC (defaults first):
      4  46bd							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  46bd							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  46bd							;		     sets the tempo, averaged over beats (the clock jitters about
      7  46bd							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  46bd							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  46bd							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  46bd							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  46bd							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  46bd							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  46bd							;		     picks a beat demo (styleBeat)
     14  46bd							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  46bd							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  46bd							;		     key channel) picks a sound (voiceSound)
     17  46bd							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  46bd							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  46bd							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  46bd							;
     21  46bd							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  46bd							; 1/4 ms); a Start makes the next clock a beat.
     23  46bd
     24  46bd		       00 00	   TEMPO_KEYTAR equ	0
     25  46bd		       00 01	   TEMPO_OWN  equ	1
     26  46bd		       00 02	   TEMPO_SC   equ	2
     27  46bd		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  46bd
     29  46bd
     30  46bd
     31  46bd							; ------------------------------------------------------------ clock
     32  46bd							; Main loop, every pass
