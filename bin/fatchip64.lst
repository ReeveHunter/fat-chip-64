------- FILE midi.asm LEVEL 2 PASS 3
      0  0a97					      include	"midi.asm"
      1  0a97							; Fat Chip 64 - MIDI out
      2  0a97							;
      3  0a97							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0a97							; at most one message per device onto the wire buffer, no sooner than that
      5  0a97							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0a97							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0a97							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0a97							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0a97							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0a97
     11  0a97				   MidiInit
     12  0a97					      subroutine
     13  0a97		       a9 03		      lda	#ACIA_RESET
     14  0a99		       8d 04 de 	      sta	ACIA_CTRL
     15  0a9c		       a9 16		      lda	#ACIA_MODE
     16  0a9e		       8d 04 de 	      sta	ACIA_CTRL
     17  0aa1		       60		      rts
     18  0aa2
     19  0aa2							; IRQ: send one wire byte if the ACIA is ready.
     20  0aa2				   TxByte
     21  0aa2					      subroutine
     22  0aa2		       a6 16		      ldx	wireTail
     23  0aa4		       e4 15		      cpx	wireHead
     24  0aa6		       f0 0f		      beq	.done
     25  0aa8		       ad 06 de 	      lda	ACIA_STAT
     26  0aab		       29 02		      and	#ACIA_TDRE
     27  0aad		       f0 08		      beq	.done
     28  0aaf		       bd 00 c0 	      lda	wireBuf,x
     29  0ab2		       8d 05 de 	      sta	ACIA_TX
     30  0ab5		       e6 16		      inc	wireTail
     31  0ab7				   .done
     32  0ab7		       60		      rts
     33  0ab8
     34  0ab8							; Main loop: same, with interrupts off around it.
     35  0ab8				   TxService
     36  0ab8					      subroutine
     37  0ab8		       08		      php
     38  0ab9		       78		      sei
     39  0aba		       20 a2 0a 	      jsr	TxByte
     40  0abd		       20 3b 27 	      jsr	RxByte
     41  0ac0		       28		      plp
     42  0ac1		       60		      rts
     43  0ac2
     44  0ac2							; IRQ: pace device queues onto the wire.
     45  0ac2							;
     46  0ac2							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
     47  0ac2							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
     48  0ac2							; times as signed numbers, so after 33 s of silence every queue froze for
     49  0ac2							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
     50  0ac2							;
     51  0ac2							; When the Game Boy is on, everything on the wire also passes through the
     52  0ac2							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
     53  0ac2							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
     54  0ac2							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
     55  0ac2							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
     56  0ac2							; message, the rate measured clean.
     57  0ac2				   Schedule
     58  0ac2					      subroutine
     59  0ac2		       ad 26 c3 	      lda	devOn+DEV_GB
     60  0ac5		       f0 10		      beq	.gb
     61  0ac7		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
     62  0ac9		       f0 0c		      beq	.gb
     63  0acb		       c6 2e		      dec	linkLoad
     64  0acd		       f0 08		      beq	.gb
     65  0acf		       a5 10		      lda	ticks
     66  0ad1		       29 01		      and	#1
     67  0ad3		       f0 02		      beq	.gb
     68  0ad5		       c6 2e		      dec	linkLoad
     69  0ad7				   .gb
     70  0ad7							; ---- Game Boy
     71  0ad7		       a5 18		      lda	gbqTail
     72  0ad9		       c5 17		      cmp	gbqHead
     73  0adb		       f0 36		      beq	.nes
     74  0add		       a5 19		      lda	gbNext
     75  0adf		       38		      sec
     76  0ae0		       e5 10		      sbc	ticks
     77  0ae2		       f0 04		      beq	.gbDue
     78  0ae4		       c9 04		      cmp	#GB_GAP+1
     79  0ae6		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
     80  0ae8				   .gbDue
     81  0ae8							; only onto an empty wire, so the gap holds on the cable itself (NES
     82  0ae8							; bytes already waiting would otherwise delay this one and squeeze it
     83  0ae8							; against the next). While a Game Boy message is due, the NES doesn't
     84  0ae8							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
     85  0ae8							; holding its notes back.
     86  0ae8		       a5 15		      lda	wireHead
     87  0aea		       c5 16		      cmp	wireTail
     88  0aec		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
     89  0aee		       20 54 0b 	      jsr	LinkRoom
     90  0af1		       90 20		      bcc	.nes
     91  0af3		       a6 18		      ldx	gbqTail
     92  0af5		       bd 00 c1 	      lda	gbqS,x
     93  0af8		       bc 80 c1 	      ldy	gbqD2,x
     94  0afb		       84 2c		      sty	irqT
     95  0afd		       bc 40 c1 	      ldy	gbqD1,x
     96  0b00		       20 70 0b 	      jsr	WireMsg
     97  0b03		       a5 18		      lda	gbqTail
     98  0b05		       18		      clc
     99  0b06		       69 01		      adc	#1
    100  0b08		       29 3f		      and	#63
    101  0b0a		       85 18		      sta	gbqTail
    102  0b0c		       a5 10		      lda	ticks
    103  0b0e		       18		      clc
    104  0b0f		       69 03		      adc	#GB_GAP
    105  0b11		       85 19		      sta	gbNext
    106  0b13				   .nes
    107  0b13		       20 3b 27 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    108  0b16		       a5 1b		      lda	nesqTail
    109  0b18		       c5 1a		      cmp	nesqHead
    110  0b1a		       f0 37		      beq	.done
    111  0b1c		       a5 1c		      lda	nesNext
    112  0b1e		       38		      sec
    113  0b1f		       e5 10		      sbc	ticks
    114  0b21		       f0 04		      beq	.nesDue
    115  0b23		       c9 02		      cmp	#NES_GAP+1
    116  0b25		       90 2c		      bcc	.done
    117  0b27				   .nesDue
    118  0b27		       20 67 0b 	      jsr	WireFree
    119  0b2a		       c9 03		      cmp	#3
