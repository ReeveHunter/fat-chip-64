    119  2f74		       29 e0		      and	#$E0
    120  2f76		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
    121  2f78		       d0 a7		      bne	.next
    122  2f7a		       a9 00		      lda	#0
    123  2f7c		       8d 27 c4 	      sta	rxCnt
    124  2f7f		       20 a7 2f 	      jsr	MidiInMsg
    125  2f82		       4c 21 2f 	      jmp	.next
    126  2f85				   .rt
    127  2f85		       c9 fa		      cmp	#$FA
    128  2f87		       d0 06		      bne	.rt2
    129  2f89		       20 6c 49 	      jsr	KeytarStart
    130  2f8c		       4c 21 2f 	      jmp	.next
    131  2f8f				   .rt2
