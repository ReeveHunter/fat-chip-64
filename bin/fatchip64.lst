     46  7e36		       0d 31 c5 	      ora	nfxGlide
     47  7e39		       0d 32 c5 	      ora	nfxRun
     48  7e3c		       0d e7 c9 	      ora	nfxWarb
     49  7e3f		       d0 01		      bne	.on
     50  7e41				   .q
     51  7e41		       60		      rts
     52  7e42				   .on
     53  7e42		       a5 10		      lda	ticks
     54  7e44		       38		      sec
     55  7e45		       ed 2d c5 	      sbc	nfxLast
     56  7e48		       c9 08		      cmp	#NFX_EVERY
     57  7e4a		       b0 01		      bcs	.go
     58  7e4c		       60		      rts
     59  7e4d				   .go
     60  7e4d		       4a		      lsr
     61  7e4e		       4a		      lsr		; 4 ms steps
     62  7e4f		       c9 08		      cmp	#8
     63  7e51		       90 02		      bcc	.n
