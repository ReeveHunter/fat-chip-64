------- FILE main.asm
------- FILE nesfx.asm LEVEL 2 PASS 3
      0  6360					      include	"nesfx.asm"
      1  6360							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  6360							;
      3  6360							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  6360							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  6360							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  6360							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  6360							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  6360							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  6360							;   glide    a new note starts bent back to the voice's last note and slides
     10  6360							;	      in the way the SID's does (all three channels)
     11  6360							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  6360							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  6360							; semitone, so these are a little stepped.
     14  6360
     15  6360		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  6360							;  (the pulses, and the triangle while it glides)
     17  6360
     18  6360							; A = 1 (not Z) when a NesFxTick step is due
     19  6360				   NesFxDue
     20  6360					      subroutine
     21  6360		       ad 27 c3 	      lda	devOn+DEV_NES
     22  6363		       f0 19		      beq	.x
     23  6365		       ad fb c5 	      lda	vibDepth
     24  6368		       0d 29 c5 	      ora	nfxGlide
     25  636b		       0d 2a c5 	      ora	nfxRun
     26  636e		       f0 0e		      beq	.x
     27  6370		       a5 10		      lda	ticks
     28  6372		       38		      sec
     29  6373		       ed 25 c5 	      sbc	nfxLast
     30  6376		       c9 08		      cmp	#NFX_EVERY
     31  6378		       a9 00		      lda	#0
     32  637a		       90 02		      bcc	.x
     33  637c		       a9 01		      lda	#1
     34  637e				   .x
     35  637e		       60		      rts
     36  637f
     37  637f							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  637f							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  637f							; quick return.
     40  637f				   NesFxTick
     41  637f					      subroutine
     42  637f		       ad 27 c3 	      lda	devOn+DEV_NES
     43  6382		       f0 0b		      beq	.q
