    126  0af5		       84 2c		      sty	irqT
    127  0af7		       bc 00 c2 	      ldy	nesqD1,x
    128  0afa		       20 2a 0b 	      jsr	WireMsg
    129  0afd		       a5 1b		      lda	nesqTail
    130  0aff		       18		      clc
    131  0b00		       69 01		      adc	#1
    132  0b02		       29 3f		      and	#63
