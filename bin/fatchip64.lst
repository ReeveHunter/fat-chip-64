    160  0fd2							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    161  0fd2							; keys: some other column has a key in this row and shares another row with
    162  0fd2							; this column.
    163  0fd2				   Suspect
    164  0fd2					      subroutine
    165  0fd2		       ac 39 c3 	      ldy	ksRow
    166  0fd5		       b9 13 7e 	      lda	rowBit,y
    167  0fd8		       49 ff		      eor	#$FF
    168  0fda		       ae 38 c3 	      ldx	ksCol
    169  0fdd		       3d 80 c2 	      and	keyNow,x
    170  0fe0		       8d 3a c3 	      sta	ksMask	; this column's other held rows
    171  0fe3		       f0 1c		      beq	.no
    172  0fe5		       a2 07		      ldx	#7
    173  0fe7				   .c
    174  0fe7		       ec 38 c3 	      cpx	ksCol
    175  0fea		       f0 12		      beq	.n
    176  0fec		       bd 80 c2 	      lda	keyNow,x
    177  0fef		       39 13 7e 	      and	rowBit,y
    178  0ff2		       f0 0a		      beq	.n
    179  0ff4		       bd 80 c2 	      lda	keyNow,x
    180  0ff7		       2d 3a c3 	      and	ksMask
    181  0ffa		       f0 02		      beq	.n
    182  0ffc		       38		      sec
    183  0ffd		       60		      rts
    184  0ffe				   .n
    185  0ffe		       ca		      dex
    186  0fff		       10 e6		      bpl	.c
    187  1001				   .no
    188  1001		       18		      clc
    189  1002		       60		      rts
    190  1003
    191  1003							; A = key code (v0.22 layout)
    192  1003							;   overlay	    notes
    193  1003							;   A S D F G	    bank (FAT PADS LEADS BASS FX): switches at once, same slot
    194  1003							;   Z X C V B	    patch 1-5 in the bank
    195  1003							;   L		    latch on / off	      K, then a note or a shape: key + scale
    196  1003							;   =		    tap tempo		      , / .  tempo -1 / +1 (SHIFT: 10)
    197  1003							;   /		    mute		      SHIFT+/  the dice
    198  1003							;   ; / :	    free arp speed	      SPACE  its action
    199  1003							;   F1 / F3	    octave up / down	      F5  arp on / off	  F7  visualizer
    200  1003							;   RETURN	    the menu		      CTRL+F3/F5  GB / NES channel block
    201  1003							;   C= +  A S D F  arp type / pattern / speed / SPARKLE octave
    202  1003							;	   Z X C    notes mode / extensions / POLY-MONO     L  latch style
    203  1003							;	   , .	    SPACE's action	      ; :  MIDI in octave down / up
    204  1003							;	   /	    undo the dice	      F1 F3 F5	SID / GB / NES on-off
    205  1003							;	   F7	    panic		      (SHIFT + F keys too, as before)
    206  1003							;   RUN/STOP	    tapped: beat start / stop; held + A S D F G H: pick a beat
    207  1003				   KeyDown
    208  1003					      subroutine
    209  1003		       c9 18		      cmp	#24
    210  1005		       90 03		      bcc	NoteDown
    211  1007		       4c b4 10 	      jmp	.cmd
    212  100a				   NoteDown		; A = note index (overlay key 0-23, MIDI slot 24-31)
    213  100a		       aa		      tax
    214  100b		       ad bd c8 	      lda	spArm
    215  100e		       f0 03		      beq	.nsp
    216  1010		       4c 14 6c 	      jmp	SplitSet	; (C= + V held: this note sets the split, it doesn't play)
    217  1013				   .nsp
    218  1013		       ad 71 c7 	      lda	kArm
    219  1016		       f0 03		      beq	.note
    220  1018		       4c f2 16 	      jmp	KeyShapeNote	; (K tapped: this note picks the key, it doesn't play)
    221  101b				   .note
    222  101b		       a9 01		      lda	#1
    223  101d		       9d b8 c2 	      sta	physKey,x
    224  1020		       ee d8 c2 	      inc	physCount
    225  1023		       20 92 47 	      jsr	RepeatPress	; REPEAT: its echoes (keeps X)
    226  1026		       20 ae 22 	      jsr	GetTicks
    227  1029		       20 b3 17 	      jsr	ApplySettings	; (changes waiting for this note)
    228  102c		       ad ae c8 	      lda	clMode	; CHORD + LEAD: the chord's key, or the lead
    229  102f		       f0 08		      beq	.ncl
    230  1031		       20 76 6a 	      jsr	ClPress
    231  1034		       90 03		      bcc	.ncl
    232  1036		       4c 8a 10 	      jmp	.add	; (the lead: no latch styles)
    233  1039				   .ncl
    234  1039		       ad 8c c3 	      lda	newPending	; NEXT or a setting change: this note starts a new chord
    235  103c		       f0 0b		      beq	.styles
    236  103e		       a9 00		      lda	#0
    237  1040		       8d 8c c3 	      sta	newPending
    238  1043		       20 4e 18 	      jsr	ClearNotes
    239  1046		       4c 8a 10 	      jmp	.add
    240  1049				   .styles
    241  1049		       ad 40 c4 	      lda	latch
    242  104c		       c9 03		      cmp	#LATCH_ADD
    243  104e		       f0 54		      beq	.addStyle
    244  1050		       c9 02		      cmp	#LATCH_HOLD
    245  1052		       f0 2c		      beq	.hold
