------- FILE attack.asm LEVEL 2 PASS 3
      0  740d					      include	"attack.asm"
      1  740d							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  740d							; how each note starts and ends in pitch
      3  740d							;
      4  740d							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  740d							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  740d							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  740d							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  740d							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  740d							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  740d							;   (v0.42) as long as TIME.
     11  740d							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  740d							;   release rings.
     13  740d
     14  740d							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  740d							; jumps to the note
     16  740d				   AtkStep
     17  740d					      subroutine
     18  740d		       ac cb c3 	      ldy	envY
     19  7410		       b9 75 c9 	      lda	atkT,y
     20  7413		       18		      clc
     21  7414		       6d 5e c4 	      adc	fxN
     22  7417		       90 02		      bcc	.t
     23  7419		       a9 ff		      lda	#255
     24  741b				   .t
     25  741b		       99 75 c9 	      sta	atkT,y
     26  741e		       b9 78 c9 	      lda	clickOn,y
     27  7421		       f0 21		      beq	.s
     28  7423		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  7425		       ae a1 c6 	      ldx	sndClick
     30  7428		       e0 02		      cpx	#2
     31  742a		       90 03		      bcc	.cl
     32  742c		       ad a0 c6 	      lda	sndStepT
     33  742f				   .cl
     34  742f		       d9 75 c9 	      cmp	atkT,y
     35  7432		       f0 02		      beq	.ce
     36  7434		       b0 0e		      bcs	.s
     37  7436				   .ce
     38  7436		       a9 00		      lda	#0
     39  7438		       99 78 c9 	      sta	clickOn,y
     40  743b		       be 89 83 	      ldx	sidOfs,y
     41  743e		       b9 36 c3 	      lda	sidGate,y
     42  7441		       9d 04 d4 	      sta	SID+4,x
     43  7444				   .s
     44  7444		       b9 6e c9 	      lda	sK,y
     45  7447		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  7449		       d0 19		      bne	.x
     47  744b		       b9 75 c9 	      lda	atkT,y
     48  744e		       cd a0 c6 	      cmp	sndStepT
     49  7451		       90 11		      bcc	.x
     50  7453		       b9 68 c4 	      lda	sidTgtLo,y	; TIME's up: the note
     51  7456		       99 ea c3 	      sta	sidBaseLo,y
     52  7459		       b9 6b c4 	      lda	sidTgtHi,y
     53  745c		       99 ed c3 	      sta	sidBaseHi,y
     54  745f		       a9 00		      lda	#0
     55  7461		       99 6e c9 	      sta	sK,y
     56  7464				   .x
     57  7464		       60		      rts
     58  7465
     59  7465							; a SID voice's gate went on (Y = SID voice, t2 = its registers): the CLICK
     60  7465							; starts. Keeps Y.
     61  7465				   ClickOn
     62  7465					      subroutine
     63  7465		       ad a1 c6 	      lda	sndClick
     64  7468		       f0 11		      beq	.x
