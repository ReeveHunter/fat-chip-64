------- FILE nesenv.asm LEVEL 2 PASS 3
      0  1d9b					      include	"nesenv.asm"
      1  1d9b							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  1d9b							;
      3  1d9b							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  1d9b							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  1d9b							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  1d9b							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  1d9b							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  1d9b							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  1d9b							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  1d9b							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  1d9b							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  1d9b							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  1d9b							; would wrap to a high pitch).
     14  1d9b							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  1d9b
     16  1d9b							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  1d9b							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  1d9b							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  1d9b							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  1d9b							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  1d9b		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  1d9b		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  1d9b							; NES channels too, and can't take a bend every 4 ms
     24  1d9b		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  1d9b		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  1d9b
     27  1d9b							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  1d9b		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  1da4		       02 05	   slotVoice  .byte.b	2,5
     30  1da6
     31  1da6							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  1da6							; note keeps sounding for now). X = voice (= t0).
     33  1da6				   NesSoftRelease
     34  1da6					      subroutine
     35  1da6		       4c ab 1d 	      jmp	.go
     36  1da9				   .nope
     37  1da9		       18		      clc
     38  1daa		       60		      rts
     39  1dab				   .go
     40  1dab		       ad 47 c4 	      lda	nesEnvOn
     41  1dae		       f0 f9		      beq	.nope
     42  1db0		       ad 90 c3 	      lda	muteNow
     43  1db3		       0d cb c3 	      ora	hardCut
     44  1db6		       d0 f1		      bne	.nope
     45  1db8		       ad 27 c3 	      lda	devOn+DEV_NES
     46  1dbb		       f0 ec		      beq	.nope
     47  1dbd		       bd 4a 5e 	      lda	vDev,x
     48  1dc0		       c9 02		      cmp	#DEV_NES
     49  1dc2		       d0 7f		      bne	.no
     50  1dc4		       bd 97 c3 	      lda	vOut,x
     51  1dc7		       c9 ff		      cmp	#NO_NOTE
     52  1dc9		       f0 78		      beq	.no
     53  1dcb		       bc 9b 1d 	      ldy	vEnvSlot,x
     54  1dce		       30 3e		      bmi	.tri
     55  1dd0							; pulse: release from the current level; step = level x factor / 4 + 1
     56  1dd0							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  1dd0							; about 2 s). Factor 0: no release, cut.
     58  1dd0		       ad 6a c4 	      lda	envRelV
     59  1dd3		       f0 6e		      beq	.no
     60  1dd5		       86 26		      stx	t2
     61  1dd7		       84 27		      sty	t3
