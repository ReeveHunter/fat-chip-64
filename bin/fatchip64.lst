------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  4c0c					      include	"sync.asm"
      1  4c0c							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  4c0c							;
      3  4c0c							; Menu, DEVICE SYNC (defaults first):
      4  4c0c							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  4c0c							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  4c0c							;		     sets the tempo, averaged over beats (the clock jitters about
      7  4c0c							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  4c0c							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  4c0c							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  4c0c							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  4c0c							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  4c0c							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  4c0c							;		     picks a beat demo (styleBeat)
     14  4c0c							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  4c0c							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  4c0c							;		     key channel) picks a sound (voiceSound)
     17  4c0c							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  4c0c							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  4c0c							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  4c0c							;
     21  4c0c							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  4c0c							; 1/4 ms); a Start makes the next clock a beat.
     23  4c0c
     24  4c0c		       00 00	   TEMPO_KEYTAR equ	0
     25  4c0c		       00 01	   TEMPO_OWN  equ	1
     26  4c0c		       00 02	   TEMPO_SC   equ	2
     27  4c0c		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  4c0c
     29  4c0c
     30  4c0c
     31  4c0c							; ------------------------------------------------------------ clock
     32  4c0c							; Main loop, every pass
     33  4c0c				   ClockTick
     34  4c0c					      subroutine
     35  4c0c		       ad e4 c5 	      lda	clkCount	; any clock lately?
     36  4c0f		       cd e5 c5 	      cmp	clkCountSeen
     37  4c12		       f0 15		      beq	.alive
     38  4c14		       8d e5 c5 	      sta	clkCountSeen
     39  4c17		       20 96 1e 	      jsr	GetTicks
     40  4c1a		       ad 3e c3 	      lda	nowL
     41  4c1d		       8d e6 c5 	      sta	clkSeenL
     42  4c20		       ad 3f c3 	      lda	nowH
     43  4c23		       8d e7 c5 	      sta	clkSeenH
     44  4c26		       4c 4a 4c 	      jmp	.beatq
     45  4c29				   .alive
     46  4c29		       ad f1 c5 	      lda	clkHave	; none for a while: start measuring afresh
     47  4c2c		       f0 1c		      beq	.beatq
     48  4c2e		       20 96 1e 	      jsr	GetTicks
     49  4c31		       ad 3e c3 	      lda	nowL
     50  4c34		       38		      sec
     51  4c35		       ed e6 c5 	      sbc	clkSeenL
     52  4c38		       aa		      tax
     53  4c39		       ad 3f c3 	      lda	nowH
     54  4c3c		       ed e7 c5 	      sbc	clkSeenH
     55  4c3f		       d0 04		      bne	.lost
     56  4c41		       e0 2c		      cpx	#<CLK_ALIVE
     57  4c43		       90 05		      bcc	.beatq
     58  4c45				   .lost
     59  4c45		       a9 00		      lda	#0
     60  4c47		       8d f1 c5 	      sta	clkHave
     61  4c4a				   .beatq
     62  4c4a		       ad e9 c5 	      lda	clkBeat
     63  4c4d		       cd ea c5 	      cmp	clkBeatSeen
     64  4c50		       d0 01		      bne	.beat
     65  4c52		       60		      rts
