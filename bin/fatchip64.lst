------- FILE lead.asm LEVEL 2 PASS 3
      0  606c					      include	"lead.asm"
      1  606c							; Fat Chip 64 - CHORD + LEAD (v0.28): a chord and a lead at once, each its
      2  606c							; own patch.
      3  606c							;   LOW NOTE  the first key pressed is the chord's root (POLY: just it;
      4  606c							;	       SMART CHORD: its 5TH, TRIAD...; DRONE: the drone); every other
      5  606c							;	       key is the lead, while the chord key is held
      6  606c							;   LATCH 3   three keys pressed together latch as the chord (let go, it
      7  606c							;	       keeps sounding); everything else is the lead. L clears it.
      8  606c							; The lead is one note (the last key pressed) on one voice per chip (SID 3,
      9  606c							; Game Boy pulse 1, NES pulse 1), only while it plays: the rest of the time
     10  606c							; those voices are the chord's. Its patch: SHIFT + A S D F G / Z X C V B.
     11  606c							; The lead's own: the SID's waveform, width, envelope and octave, the Game
     12  606c							; Boy pulse's CCs, the NES pulse's duty. Shared with the chord: the effects
     13  606c							; (vibrato, filter, tremolo...), the NES envelope.
     14  606c
     15  606c		       00 06	   LEAD_SID   equ	6	; the lead's voices: SID 3, GB pulse 1, NES pulse 1
     16  606c		       00 01	   LEAD_GB    equ	1
     17  606c		       00 02	   LEAD_NES   equ	2
     18  606c
