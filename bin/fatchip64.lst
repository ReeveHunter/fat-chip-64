    185  0ff2							; A = key code (v0.22 layout)
    186  0ff2							;   overlay	    notes
    187  0ff2							;   A S D F G	    bank (FAT PADS LEADS BASS FX): switches at once, same slot
    188  0ff2							;   Z X C V B	    patch 1-5 in the bank
    189  0ff2							;   L		    latch on / off	      K, then a note or a shape: key + scale
    190  0ff2							;   =		    tap tempo		      , / .  tempo -1 / +1 (SHIFT: 10)
    191  0ff2							;   /		    mute		      SHIFT+/  the dice
    192  0ff2							;   ; / :	    free arp speed	      SPACE  its action
    193  0ff2							;   F1 / F3	    octave up / down	      F5  arp on / off	  F7  visualizer
    194  0ff2							;   RETURN	    the menu		      CTRL+F3/F5  GB / NES channel block
    195  0ff2							;   C= +  A S D F  arp type / pattern / speed / SPARKLE octave
    196  0ff2							;	   Z X C    notes mode / extensions / POLY-MONO     L  latch style
    197  0ff2							;	   V	    SPLIT (tapped: OFF KEY LOW NOTE LATCH 3; held + a note:
    198  0ff2							;		    the split point there, on the C64's keys or over MIDI)
    199  0ff2							;	   , .	    SPACE's action	      ; :  MIDI in octave down / up
    200  0ff2							;	   /	    undo the dice	      F1 F3 F5	SID / GB / NES on-off
    201  0ff2							;	   F7	    panic		      (SHIFT + F keys too, as before)
    202  0ff2							;   RUN/STOP	    tapped: beat start / stop; held + A S D F G H: pick a beat
    203  0ff2				   KeyDown
