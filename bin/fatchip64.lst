------- FILE nesenv.asm LEVEL 2 PASS 3
      0  29f5					      include	"nesenv.asm"
      1  29f5							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  29f5							;
      3  29f5							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  29f5							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  29f5							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  29f5							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  29f5							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  29f5							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  29f5							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  29f5							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  29f5							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  29f5							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  29f5							; would wrap to a high pitch).
     14  29f5							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  29f5
     16  29f5							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  29f5							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  29f5							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  29f5							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  29f5							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  29f5		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  29f5		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  29f5							; NES channels too, and can't take a bend every 4 ms
     24  29f5		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  29f5		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  29f5
     27  29f5							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  29f5		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  29fe		       02 05	   slotVoice  .byte.b	2,5
     30  2a00
     31  2a00							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  2a00							; note keeps sounding for now). X = voice (= t0).
     33  2a00				   NesSoftRelease
     34  2a00					      subroutine
     35  2a00		       4c 05 2a 	      jmp	.go
     36  2a03				   .nope
     37  2a03		       18		      clc
     38  2a04		       60		      rts
     39  2a05				   .go
     40  2a05		       ad 58 c8 	      lda	muteNow
     41  2a08		       0d 97 c8 	      ora	hardCut
     42  2a0b		       d0 f6		      bne	.nope
     43  2a0d		       ad eb c7 	      lda	devOn+DEV_NES
     44  2a10		       f0 f1		      beq	.nope
     45  2a12		       bd 77 89 	      lda	vDev,x
     46  2a15		       c9 02		      cmp	#DEV_NES
     47  2a17		       d0 ea		      bne	.nope
     48  2a19		       bd 5f c8 	      lda	vOut,x
     49  2a1c		       c9 ff		      cmp	#NO_NOTE
     50  2a1e		       f0 e3		      beq	.nope
     51  2a20		       ad 13 c9 	      lda	nesEnvOn
     52  2a23		       f0 78		      beq	.fo	; (no envelope: BEND OUT's fall-off, if any)
     53  2a25		       bc f5 29 	      ldy	vEnvSlot,x
     54  2a28		       30 41		      bmi	.tri
     55  2a2a							; pulse: release from the current level; step = level x factor / 4 + 1
     56  2a2a							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  2a2a							; about 2 s). Factor 0: no release, cut.
     58  2a2a		       ad 36 c9 	      lda	envRelV
     59  2a2d		       f0 6e		      beq	.fo
     60  2a2f		       86 26		      stx	t2
     61  2a31		       84 27		      sty	t3
     62  2a33		       b9 85 c8 	      lda	envLvH,y
     63  2a36		       ac 36 c9 	      ldy	envRelV
     64  2a39		       20 9c 4b 	      jsr	Mul8
     65  2a3c		       4e 39 c9 	      lsr	mt16+1
     66  2a3f		       6e 38 c9 	      ror	mt16
     67  2a42		       4e 39 c9 	      lsr	mt16+1
     68  2a45		       6e 38 c9 	      ror	mt16
     69  2a48		       a4 27		      ldy	t3
     70  2a4a		       a6 26		      ldx	t2
     71  2a4c		       ad 39 c9 	      lda	mt16+1
     72  2a4f		       d0 0b		      bne	.max
     73  2a51		       ad 38 c9 	      lda	mt16
     74  2a54		       c9 ff		      cmp	#255
     75  2a56		       b0 04		      bcs	.max
     76  2a58		       69 01		      adc	#1
     77  2a5a		       d0 02		      bne	.rel
     78  2a5c				   .max
     79  2a5c		       a9 ff		      lda	#255
     80  2a5e				   .rel
     81  2a5e		       99 89 c8 	      sta	envRel,y
     82  2a61		       a9 04		      lda	#ENV_R
     83  2a63		       99 81 c8 	      sta	envPh,y
     84  2a66		       20 b4 2a 	      jsr	RdBend	; BEND OUT: it sags as it fades
     85  2a69		       38		      sec
     86  2a6a		       60		      rts
     87  2a6b				   .tri
     88  2a6b					      if	TRI_DROP_PADS == 0
     89  2a6b		       4c 9d 2a 	      jmp	.fo	; PADS: the bass just stops (Reeve, 2026-11-01)
     90  2a6e					      endif
     91  2a6e		       bd 80 89 	      lda	vIdx,x
