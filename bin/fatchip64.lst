------- FILE main.asm
------- FILE nesfx.asm LEVEL 2 PASS 3
      0  80b8					      include	"nesfx.asm"
      1  80b8							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  80b8							;
      3  80b8							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  80b8							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  80b8							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  80b8							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  80b8							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  80b8							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  80b8							;   glide    a new note starts bent back to the voice's last note and slides
     10  80b8							;	      in the way the SID's does (all three channels)
     11  80b8							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  80b8							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  80b8							; semitone, so these are a little stepped.
     14  80b8
     15  80b8		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  80b8							;  (the pulses, and the triangle while it glides)
     17  80b8
     18  80b8							; A = 1 (not Z) when a NesFxTick step is due
     19  80b8				   NesFxDue
     20  80b8					      subroutine
     21  80b8		       ad 2b c3 	      lda	devOn+DEV_NES
     22  80bb		       f0 1c		      beq	.x
     23  80bd		       ad 0b c6 	      lda	vibDepth
     24  80c0		       0d 39 c5 	      ora	nfxGlide
     25  80c3		       0d 3a c5 	      ora	nfxRun
     26  80c6		       0d f9 c9 	      ora	nfxWarb
     27  80c9		       f0 0e		      beq	.x
     28  80cb		       a5 10		      lda	ticks
     29  80cd		       38		      sec
     30  80ce		       ed 35 c5 	      sbc	nfxLast
     31  80d1		       c9 08		      cmp	#NFX_EVERY
     32  80d3		       a9 00		      lda	#0
     33  80d5		       90 02		      bcc	.x
     34  80d7		       a9 01		      lda	#1
     35  80d9				   .x
     36  80d9		       60		      rts
     37  80da
     38  80da							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     39  80da							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     40  80da							; quick return.
     41  80da				   NesFxTick
     42  80da					      subroutine
     43  80da		       ad 2b c3 	      lda	devOn+DEV_NES
     44  80dd		       f0 0e		      beq	.q
     45  80df		       ad 0b c6 	      lda	vibDepth
     46  80e2		       0d 39 c5 	      ora	nfxGlide
     47  80e5		       0d 3a c5 	      ora	nfxRun
     48  80e8		       0d f9 c9 	      ora	nfxWarb
     49  80eb		       d0 01		      bne	.on
     50  80ed				   .q
     51  80ed		       60		      rts
     52  80ee				   .on
     53  80ee		       a5 10		      lda	ticks
     54  80f0		       38		      sec
     55  80f1		       ed 35 c5 	      sbc	nfxLast
     56  80f4		       c9 08		      cmp	#NFX_EVERY
     57  80f6		       b0 01		      bcs	.go
     58  80f8		       60		      rts
     59  80f9				   .go
     60  80f9		       4a		      lsr
     61  80fa		       4a		      lsr		; 4 ms steps
     62  80fb		       c9 08		      cmp	#8
     63  80fd		       90 02		      bcc	.n
     64  80ff		       a9 08		      lda	#8
     65  8101				   .n
     66  8101		       8d 3b c5 	      sta	nfxN
     67  8104		       a5 10		      lda	ticks
     68  8106		       8d 35 c5 	      sta	nfxLast
