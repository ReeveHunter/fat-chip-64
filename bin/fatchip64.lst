    133  741e		       20 87 75 	      jsr	NesFxVal
    134  7421		       a6 24		      ldx	t0
    135  7423		       ad 32 c5 	      lda	nfxL
    136  7426		       dd de c4 	      cmp	nesFxSL,x
    137  7429		       d0 08		      bne	.send
    138  742b		       ad 33 c5 	      lda	nfxH
    139  742e		       dd e7 c4 	      cmp	nesFxSH,x
    140  7431		       f0 0b		      beq	.x
    141  7433				   .send
    142  7433		       a9 01		      lda	#1
    143  7435		       8d 2a c5 	      sta	nfxHave	; (NesBendVoice: nfx is this voice's already)
    144  7438		       bd 96 c3 	      lda	vOut,x
