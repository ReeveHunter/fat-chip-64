    287  0d3d				   NesPut
    288  0d3d					      subroutine
    289  0d3d							; write the slot at head first (always free: one slot stays empty),
    290  0d3d							; then publish head unless the queue is full. Uses only A and X.
    291  0d3d		       a6 1a		      ldx	nesqHead
    292  0d3f		       a5 21		      lda	mS
    293  0d41		       9d c0 c1 	      sta	nesqS,x
    294  0d44		       a5 22		      lda	mD1
    295  0d46		       9d 00 c2 	      sta	nesqD1,x
    296  0d49		       a5 23		      lda	mD2
    297  0d4b		       9d 40 c2 	      sta	nesqD2,x
    298  0d4e		       8a		      txa
    299  0d4f		       18		      clc
    300  0d50		       69 01		      adc	#1
    301  0d52		       29 3f		      and	#63
