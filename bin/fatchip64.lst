     89  4ed2		       85 25		      sta	t1
     90  4ed4							; bank (CC14 on the sample channel) when it changes
     91  4ed4		       a9 04		      lda	#4
     92  4ed6		       20 2e 4f 	      jsr	NesChStatus	; mS = CC, sample channel
     93  4ed9		       a9 00		      lda	#0
     94  4edb		       a6 25		      ldx	t1
     95  4edd		       10 02		      bpl	.a
     96  4edf		       a9 7f		      lda	#127
     97  4ee1				   .a
     98  4ee1		       cd 84 c4 	      cmp	dmcBank
     99  4ee4		       f0 0c		      beq	.note
    100  4ee6		       8d 84 c4 	      sta	dmcBank
    101  4ee9		       85 23		      sta	mD2
    102  4eeb		       a9 0e		      lda	#14
    103  4eed		       85 22		      sta	mD1
    104  4eef		       20 3a 0d 	      jsr	NesPut
    105  4ef2				   .note
    106  4ef2		       a5 21		      lda	mS
    107  4ef4		       29 0f		      and	#$0F
    108  4ef6		       85 26		      sta	t2	; channel
    109  4ef8		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    110  4efa							;  cuts it anyway, and the hit lands 1 ms sooner)
    111  4efa		       29 7f		      and	#$7F
    112  4efc		       8d 91 c4 	      sta	dmcNote
    113  4eff		       85 22		      sta	mD1
    114  4f01		       a5 26		      lda	t2
    115  4f03		       09 90		      ora	#$90
