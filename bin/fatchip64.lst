    626 Uc74f		       00	   sxCount    ds	1	; patches received
    627 Uc750		       00 00 00 00*vFat       ds	NUM_VOICES	; v0.21: this bass voice plays Fat Bass now
    628 Uc759		       00 00 00 00*vDrum      ds	NUM_VOICES	; v0.21: held by the drums (none yet)
    629 Uc762		       00	   allocFree  ds	1	; voices spare after the notes and Fat Bass
    630 Uc763		       00 00 00 00*vSent      ds	NUM_VOICES	; v0.21: the note number each MIDI voice was sent
    631 Uc76c		       00	   mlNew      ds	1
