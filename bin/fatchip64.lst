    161  80f9		       bd 7c c9 	      lda	nesK,x
    162  80fc		       c9 ff		      cmp	#$FF	; (v0.41: BEND IN STEP: held for TIME, then the note)
    163  80fe		       d0 0c		      bne	.slide
    164  8100		       bd e2 c4 	      lda	nesVT,x
    165  8103		       cd a0 c6 	      cmp	sndStepT
    166  8106		       b0 01		      bcs	.jump
    167  8108		       60		      rts
    168  8109				   .jump
    169  8109		       4c 9c 81 	      jmp	.snap
    170  810c				   .slide
