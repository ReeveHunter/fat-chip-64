     90  399c		       10 1e		      bpl	.data
     91  399e		       c9 f8		      cmp	#$F8
     92  39a0		       b0 49		      bcs	.rt	; realtime (clocks are counted by RxByte)
     93  39a2		       c9 f0		      cmp	#$F0
     94  39a4		       b0 07		      bcs	.sys
     95  39a6		       a2 00		      ldx	#0	; a channel message ends any SysEx
     96  39a8		       8e 59 c7 	      stx	sxOn
     97  39ab		       f0 05		      beq	.status
     98  39ad				   .sys
     99  39ad		       20 65 3b 	      jsr	SysexStatus	; F0 starts a SysEx, F7 ends it (v0.20)
    100  39b0		       a9 00		      lda	#0	; system: no running status until the next one
    101  39b2				   .status
