    130  8130		       8e 36 c5 	      stx	nfxV
    131  8133		       86 24		      stx	t0
    132  8135		       bd 9f c3 	      lda	vOut,x
    133  8138		       c9 ff		      cmp	#NO_NOTE
    134  813a		       f0 20		      beq	.x
    135  813c		       20 c4 82 	      jsr	NesFxVal
    136  813f		       a6 24		      ldx	t0
    137  8141		       ad 3f c5 	      lda	nfxL
    138  8144		       dd eb c4 	      cmp	nesFxSL,x
