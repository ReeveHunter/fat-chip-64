------- FILE main.asm
------- FILE nesfx.asm LEVEL 2 PASS 3
      0  7d7b					      include	"nesfx.asm"
      1  7d7b							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7d7b							;
      3  7d7b							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7d7b							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7d7b							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7d7b							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7d7b							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7d7b							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7d7b							;   glide    a new note starts bent back to the voice's last note and slides
     10  7d7b							;	      in the way the SID's does (all three channels)
     11  7d7b							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7d7b							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7d7b							; semitone, so these are a little stepped.
     14  7d7b
     15  7d7b		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7d7b							;  (the pulses, and the triangle while it glides)
     17  7d7b
     18  7d7b							; A = 1 (not Z) when a NesFxTick step is due
     19  7d7b				   NesFxDue
     20  7d7b					      subroutine
     21  7d7b		       ad 27 c3 	      lda	devOn+DEV_NES
     22  7d7e		       f0 1c		      beq	.x
     23  7d80		       ad ff c5 	      lda	vibDepth
     24  7d83		       0d 2d c5 	      ora	nfxGlide
     25  7d86		       0d 2e c5 	      ora	nfxRun
     26  7d89		       0d e3 c9 	      ora	nfxWarb
     27  7d8c		       f0 0e		      beq	.x
     28  7d8e		       a5 10		      lda	ticks
     29  7d90		       38		      sec
     30  7d91		       ed 29 c5 	      sbc	nfxLast
     31  7d94		       c9 08		      cmp	#NFX_EVERY
     32  7d96		       a9 00		      lda	#0
     33  7d98		       90 02		      bcc	.x
     34  7d9a		       a9 01		      lda	#1
     35  7d9c				   .x
     36  7d9c		       60		      rts
     37  7d9d
     38  7d9d							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     39  7d9d							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     40  7d9d							; quick return.
     41  7d9d				   NesFxTick
     42  7d9d					      subroutine
     43  7d9d		       ad 27 c3 	      lda	devOn+DEV_NES
     44  7da0		       f0 0e		      beq	.q
