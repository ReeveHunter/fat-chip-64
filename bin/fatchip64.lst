------- FILE arp.asm LEVEL 2 PASS 3
      0  241e					      include	"arp.asm"
      1  241e							; Fat Chip 64 - tempo and arpeggiator
      2  241e							;
      3  241e							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  241e							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  241e							;
      6  241e							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  241e							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  241e							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  241e							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  241e							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  241e							;	     until its voice's next turn.
     12  241e							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  241e							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  241e							;   J faster; either one also picks FREE).
     15  241e							;
     16  241e							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  241e							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  241e
     19  241e							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  241e							; between the two bytes: $22FF read as $23FF)
     21  241e				   GetTicks
     22  241e					      subroutine
     23  241e		       08		      php
     24  241f		       78		      sei
     25  2420		       a5 10		      lda	ticks
     26  2422		       8d 43 c3 	      sta	nowL
     27  2425		       a5 11		      lda	ticks+1
     28  2427		       8d 44 c3 	      sta	nowH
     29  242a		       28		      plp
     30  242b		       60		      rts
     31  242c
