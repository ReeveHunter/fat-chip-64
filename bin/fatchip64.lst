      0  5e53					      include	"patchedit.asm"
      1  5e53							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  5e53							; the dice. The settings and their steps come from tools/gen_menu.py
      3  5e53							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  5e53							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  5e53							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  5e53							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  5e53							; (EnvDerive).
      8  5e53
