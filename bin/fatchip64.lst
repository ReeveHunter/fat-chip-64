     42  0bc8		       78		      sei
     43  0bc9		       a6 2f		      ldx	midiIrq
     44  0bcb		       bd 03 0c 	      lda	midiCtl,x
     45  0bce		       8d 04 de 	      sta	ACIA_CTRL
     46  0bd1		       bd 05 0c 	      lda	irqLo,x
     47  0bd4		       8d fe ff 	      sta	$FFFE
     48  0bd7		       bd 07 0c 	      lda	irqHi,x
     49  0bda		       8d ff ff 	      sta	$FFFF
     50  0bdd		       bd 09 0c 	      lda	latchLo,x
     51  0be0		       8d 04 dc 	      sta	CIA1_TALO
     52  0be3		       bd 0b 0c 	      lda	latchHi,x
     53  0be6		       8d 05 dc 	      sta	CIA1_TAHI
     54  0be9		       a9 11		      lda	#$11	; start, force load, continuous
     55  0beb		       8d 0e dc 	      sta	CIA1_CRA
     56  0bee		       ad 0d dc 	      lda	CIA1_ICR
