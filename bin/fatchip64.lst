      0  6075					      include	"patchedit.asm"
      1  6075							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  6075							; the dice. The settings and their steps come from tools/gen_menu.py
      3  6075							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  6075							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  6075							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  6075							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  6075							; (EnvDerive).
      8  6075
