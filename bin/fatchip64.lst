------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  5afa					      include	"sync.asm"
      1  5afa							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  5afa							;
      3  5afa							; Menu, DEVICE SYNC (defaults first):
      4  5afa							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  5afa							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  5afa							;		     sets the tempo, averaged over beats (the clock jitters about
      7  5afa							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  5afa							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  5afa							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  5afa							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  5afa							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  5afa							;   RHYTHM BUTTONS  IN ORDER / BY FEEL / IGNORE: its rhythm (Program Change on
     13  5afa							;		     channel 16, the keytar's 00-44) picks beat n (bank n / 5), or
     14  5afa							;		     the beat nearest its style (styleBeat)
     15  5afa							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     16  5afa							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     17  5afa							;		     key channel) picks a sound (voiceSound)
     18  5afa							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     19  5afa							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     20  5afa							;		     127 held, 0 let go), the same list as SPACE (actions below)
     21  5afa							;
     22  5afa							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     23  5afa							; 1/4 ms); a Start makes the next clock a beat.
     24  5afa
     25  5afa		       00 00	   TEMPO_KEYTAR equ	0
     26  5afa		       00 01	   TEMPO_OWN  equ	1
     27  5afa		       00 02	   TEMPO_SC   equ	2
     28  5afa		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     29  5afa
     30  5afa
     31  5afa
     32  5afa							; ------------------------------------------------------------ clock
