    124  47a3		       a5 27		      lda	t3
    125  47a5		       c9 03		      cmp	#>1000
    126  47a7		       90 10		      bcc	.bad0
    127  47a9		       d0 06		      bne	.hi
    128  47ab		       a5 26		      lda	t2
