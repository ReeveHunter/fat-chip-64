    148  719d							; voice X's glide offset closer to 0: by off / 2^glideK for each 4 ms step
    149  719d							; (worked out once: d = off >> k, off -= d x n; past 0 or nothing left to
    150  719d							; move by: there). Keeps X.
    151  719d				   NesGlideStep
    152  719d					      subroutine
    153  719d		       bd c3 c4 	      lda	nesGlL,x
