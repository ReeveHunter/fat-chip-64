    293  0a2a		       98		      tya
    294  0a2b		       48		      pha
    295  0a2c		       e6 10		      inc	ticks
    296  0a2e		       d0 02		      bne	.t
    297  0a30		       e6 11		      inc	ticks+1
    298  0a32				   .t
