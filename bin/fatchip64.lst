     89  2f4a		       98		      tya
     90  2f4b		       10 1e		      bpl	.data
     91  2f4d		       c9 f8		      cmp	#$F8
     92  2f4f		       b0 49		      bcs	.rt	; realtime (clocks are counted by RxByte)
     93  2f51		       c9 f0		      cmp	#$F0
     94  2f53		       b0 07		      bcs	.sys
     95  2f55		       a2 00		      ldx	#0	; a channel message ends any SysEx
     96  2f57		       8e 4c c7 	      stx	sxOn
     97  2f5a		       f0 05		      beq	.status
     98  2f5c				   .sys
     99  2f5c		       20 07 31 	      jsr	SysexStatus	; F0 starts a SysEx, F7 ends it (v0.20)
    100  2f5f		       a9 00		      lda	#0	; system: no running status until the next one
    101  2f61				   .status
    102  2f61		       8d 26 c4 	      sta	rxStatus
    103  2f64		       a9 00		      lda	#0
    104  2f66		       8d 27 c4 	      sta	rxCnt
    105  2f69		       f0 cb		      beq	.next
    106  2f6b				   .data
