      0  5f24					      include	"wander.asm"
      1  5f24							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  5f24							;
      3  5f24							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  5f24							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  5f24							;   ATTACK   as always: the new notes start
      6  5f24							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  5f24							;	      has none)
      8  5f24							;   SPLIT    the SID and the bass voices glide, the Game Boy and NES pulses
      9  5f24							;	      start again
     10  5f24							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  5f24							;	      late; some glide, some start again (fade out, come back in)
     12  5f24							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  5f24							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  5f24							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  5f24							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  5f24
     17  5f24		       00 01	   CHG_ATTACK equ	1
     18  5f24		       00 02	   CHG_GLIDE  equ	2
     19  5f24		       00 03	   CHG_SPLIT  equ	3
     20  5f24		       00 04	   CHG_WANDER equ	4
     21  5f24		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  5f24
