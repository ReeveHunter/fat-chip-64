------- FILE nesenv.asm LEVEL 2 PASS 3
      0  23cd					      include	"nesenv.asm"
      1  23cd							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  23cd							;
      3  23cd							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  23cd							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  23cd							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  23cd							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  23cd							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  23cd							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  23cd							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  23cd							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  23cd							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  23cd							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  23cd							; would wrap to a high pitch).
     14  23cd							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  23cd
     16  23cd							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  23cd							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  23cd							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  23cd							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  23cd							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  23cd		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  23cd		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  23cd							; NES channels too, and can't take a bend every 4 ms
     24  23cd		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  23cd		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  23cd
     27  23cd							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  23cd		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  23d6		       02 05	   slotVoice  .byte.b	2,5
     30  23d8
     31  23d8							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  23d8							; note keeps sounding for now). X = voice (= t0).
     33  23d8				   NesSoftRelease
     34  23d8					      subroutine
     35  23d8		       4c dd 23 	      jmp	.go
     36  23db				   .nope
     37  23db		       18		      clc
     38  23dc		       60		      rts
     39  23dd				   .go
     40  23dd		       ad 8f c3 	      lda	muteNow
     41  23e0		       0d ca c3 	      ora	hardCut
     42  23e3		       d0 f6		      bne	.nope
     43  23e5		       ad 27 c3 	      lda	devOn+DEV_NES
     44  23e8		       f0 f1		      beq	.nope
     45  23ea		       bd d6 74 	      lda	vDev,x
     46  23ed		       c9 02		      cmp	#DEV_NES
     47  23ef		       d0 ea		      bne	.nope
     48  23f1		       bd 96 c3 	      lda	vOut,x
     49  23f4		       c9 ff		      cmp	#NO_NOTE
     50  23f6		       f0 e3		      beq	.nope
     51  23f8		       ad 46 c4 	      lda	nesEnvOn
     52  23fb		       f0 78		      beq	.fo	; (no envelope: BEND OUT's fall-off, if any)
     53  23fd		       bc cd 23 	      ldy	vEnvSlot,x
     54  2400		       30 41		      bmi	.tri
     55  2402							; pulse: release from the current level; step = level x factor / 4 + 1
     56  2402							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  2402							; about 2 s). Factor 0: no release, cut.
     58  2402		       ad 69 c4 	      lda	envRelV
     59  2405		       f0 6e		      beq	.fo
     60  2407		       86 26		      stx	t2
     61  2409		       84 27		      sty	t3
     62  240b		       b9 bc c3 	      lda	envLvH,y
     63  240e		       ac 69 c4 	      ldy	envRelV
     64  2411		       20 6c 40 	      jsr	Mul8
     65  2414		       4e 6c c4 	      lsr	mt16+1
     66  2417		       6e 6b c4 	      ror	mt16
     67  241a		       4e 6c c4 	      lsr	mt16+1
     68  241d		       6e 6b c4 	      ror	mt16
     69  2420		       a4 27		      ldy	t3
     70  2422		       a6 26		      ldx	t2
     71  2424		       ad 6c c4 	      lda	mt16+1
     72  2427		       d0 0b		      bne	.max
     73  2429		       ad 6b c4 	      lda	mt16
