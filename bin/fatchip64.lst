    255  0cdb		       9d 00 c0 	      sta	wireBuf,x
    256  0cde		       e6 15		      inc	wireHead
    257  0ce0		       a5 2f		      lda	midiIrq	; the MIDI chip: interrupt when it can take it
    258  0ce2		       f0 05		      beq	.x
    259  0ce4		       a9 b6		      lda	#ACIA_MODE_TX
