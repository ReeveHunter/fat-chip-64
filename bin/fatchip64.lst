------- FILE voices.asm LEVEL 2 PASS 2
      0  0fa3					      include	"voices.asm"
      1  0fa3							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  0fa3							;
      3  0fa3							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  0fa3							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  0fa3							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  0fa3							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  0fa3							; Allocation, whenever the held notes change:
      8  0fa3							;   1. bass voices play the lowest note, an octave down
      9  0fa3							;   2. every other note gets one voice, lowest notes first
     10  0fa3							;   3. leftover voices stack on the lowest two notes, alternating
     11  0fa3							; So one note = a nine-voice unison across three chips, and in chords the
     12  0fa3							; bottom of the chord is fattest. Disabled devices get no notes.
     13  0fa3
     14  0fa3							; ------------------------------------------------------------ SID
     15  0fa3				   SidInit
     16  0fa3					      subroutine
     17  0fa3		       a2 18		      ldx	#24
     18  0fa5		       a9 00		      lda	#0
     19  0fa7				   .clr
