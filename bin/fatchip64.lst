------- FILE menu.asm LEVEL 2 PASS 3
      0  3e78					      include	"menu.asm"
      1  3e78							; Fat Chip 64 - the menu (v0.13): SHIFT+RETURN in and out
      2  3e78							;
      3  3e78							; CRSR DOWN / SHIFT+CRSR DOWN (up): choose a setting. CRSR RIGHT or RETURN /
      4  3e78							; SHIFT+CRSR RIGHT: its next / previous value. Every other key works as
      5  3e78							; usual (notes play; V, F keys, = ... too: the values here follow).
      6  3e78							; The play screen pauses while the menu is up and redraws when it closes.
      7  3e78
      8  3e78		       00 11	   MENU_ITEMS equ	17
      9  3e78		       00 17	   MENU_VALCOL equ	23
     10  3e78
     11  3e78
