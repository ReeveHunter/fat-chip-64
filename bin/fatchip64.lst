     51  0f11		       4e 3b c3 	      lsr	ksBits
     52  0f14		       90 17		      bcc	.rbn
     53  0f16		       ae 3c c3 	      ldx	ksCol
     54  0f19		       ac 3d c3 	      ldy	ksRow
     55  0f1c		       b9 a9 82 	      lda	rowBit,y
     56  0f1f		       49 ff		      eor	#$FF
     57  0f21		       3d 90 c2 	      and	keyAcc,x
     58  0f24		       9d 90 c2 	      sta	keyAcc,x
     59  0f27		       20 cd 0f 	      jsr	KeyCode
     60  0f2a		       20 de 18 	      jsr	KeyUp
     61  0f2d				   .rbn
     62  0f2d		       ee 3d c3 	      inc	ksRow
     63  0f30		       d0 da		      bne	.rb
     64  0f32				   .rcn
     65  0f32		       ae 3c c3 	      ldx	ksCol
     66  0f35		       e8		      inx
     67  0f36		       e0 08		      cpx	#8
     68  0f38		       d0 bf		      bne	.rc
     69  0f3a							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0f3a							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0f3a							; still count as a combination.
     72  0f3a		       a9 00		      lda	#0
     73  0f3c		       8d 3f c3 	      sta	ksPass
     74  0f3f				   .pass
     75  0f3f		       a2 00		      ldx	#0
     76  0f41				   .pc
     77  0f41		       8e 3c c3 	      stx	ksCol
     78  0f44		       bd 90 c2 	      lda	keyAcc,x
     79  0f47		       49 ff		      eor	#$FF
     80  0f49		       3d 80 c2 	      and	keyNow,x
     81  0f4c		       8d 3b c3 	      sta	ksBits
     82  0f4f		       a9 00		      lda	#0
     83  0f51		       8d 3d c3 	      sta	ksRow
     84  0f54				   .pb
     85  0f54		       ad 3b c3 	      lda	ksBits
     86  0f57		       f0 49		      beq	.pcn
     87  0f59		       4e 3b c3 	      lsr	ksBits
     88  0f5c		       90 3f		      bcc	.pbn
     89  0f5e		       ad 40 c3 	      lda	ghostFilter
     90  0f61		       d0 0c		      bne	.chk	; filter off (default): phantom notes play...
     91  0f63		       20 cd 0f 	      jsr	KeyCode
     92  0f66		       c9 18		      cmp	#24
     93  0f68		       90 0a		      bcc	.accept
     94  0f6a		       20 b6 0f 	      jsr	IsModifier
     95  0f6d		       f0 05		      beq	.accept
     96  0f6f				   .chk 		; ...but a command key never comes from a phantom
     97  0f6f		       20 db 0f 	      jsr	Suspect	;  (v0.40: Q + E held, then C=, read C= + S too)
     98  0f72		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     99  0f74				   .accept
    100  0f74		       20 cd 0f 	      jsr	KeyCode
    101  0f77		       20 b6 0f 	      jsr	IsModifier	; Z set = modifier
    102  0f7a		       f0 07		      beq	.mod
    103  0f7c		       ad 3f c3 	      lda	ksPass
    104  0f7f		       f0 1c		      beq	.pbn	; pass 0: modifiers only
    105  0f81		       d0 05		      bne	.take
    106  0f83				   .mod
    107  0f83		       ad 3f c3 	      lda	ksPass
    108  0f86		       d0 15		      bne	.pbn	; (taken in pass 0)
    109  0f88				   .take
    110  0f88		       ae 3c c3 	      ldx	ksCol
    111  0f8b		       ac 3d c3 	      ldy	ksRow
    112  0f8e		       b9 a9 82 	      lda	rowBit,y
    113  0f91		       1d 90 c2 	      ora	keyAcc,x
    114  0f94		       9d 90 c2 	      sta	keyAcc,x
    115  0f97		       20 cd 0f 	      jsr	KeyCode
    116  0f9a		       20 0c 10 	      jsr	KeyDown
    117  0f9d				   .pbn
    118  0f9d		       ee 3d c3 	      inc	ksRow
    119  0fa0		       d0 b2		      bne	.pb
    120  0fa2				   .pcn
    121  0fa2		       ae 3c c3 	      ldx	ksCol
    122  0fa5		       e8		      inx
    123  0fa6		       e0 08		      cpx	#8
    124  0fa8		       d0 97		      bne	.pc
    125  0faa		       ad 3f c3 	      lda	ksPass
    126  0fad		       d0 06		      bne	.done
    127  0faf		       ee 3f c3 	      inc	ksPass
    128  0fb2		       4c 3f 0f 	      jmp	.pass
    129  0fb5				   .done
    130  0fb5		       60		      rts
    131  0fb6
    132  0fb6							; Z set if key code A is a modifier. Keeps A.
    133  0fb6				   IsModifier
    134  0fb6		       c9 88		      cmp	#K_LSHIFT
    135  0fb8		       f0 12		      beq	.y
    136  0fba		       c9 89		      cmp	#K_RSHIFT
    137  0fbc		       f0 0e		      beq	.y
    138  0fbe		       c9 8c		      cmp	#K_CTRL
    139  0fc0		       f0 0a		      beq	.y
    140  0fc2		       c9 a2		      cmp	#K_CBM
    141  0fc4		       f0 06		      beq	.y
    142  0fc6		       c9 a3		      cmp	#K_STOP
    143  0fc8		       f0 02		      beq	.y
    144  0fca		       c9 9a		      cmp	#K_K
    145  0fcc				   .y
