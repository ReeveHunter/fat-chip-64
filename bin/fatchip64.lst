      0  230a					      include	"arp.asm"
      1  230a							; Fat Chip 64 - tempo and arpeggiator
      2  230a							;
      3  230a							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  230a							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  230a							;
      6  230a							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  230a							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  230a							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  230a							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  230a							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  230a							;	     until its voice's next turn.
     12  230a							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  230a							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  230a							;   J faster; either one also picks FREE).
     15  230a							;
     16  230a							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  230a							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  230a
     19  230a							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  230a							; between the two bytes: $22FF read as $23FF)
     21  230a				   GetTicks
     22  230a					      subroutine
     23  230a		       08		      php
     24  230b		       78		      sei
     25  230c		       a5 10		      lda	ticks
     26  230e		       8d 3f c3 	      sta	nowL
     27  2311		       a5 11		      lda	ticks+1
     28  2313		       8d 40 c3 	      sta	nowH
     29  2316		       28		      plp
     30  2317		       60		      rts
     31  2318
