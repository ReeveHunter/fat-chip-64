      0  0e0e					      include	"keys.asm"
      1  0e0e							; Fat Chip 64 - keyboard and RESTORE
      2  0e0e
      3  0e0e							; Scan the whole matrix, turn changes into key events.
      4  0e0e							;
      5  0e0e							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0e0e							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0e0e							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0e0e							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0e0e							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0e0e							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0e0e							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0e0e							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0e0e							; chords whose ghost lands on another used key lose their newest note.
     14  0e0e				   KeyScan
     15  0e0e					      subroutine
     16  0e0e		       a2 07		      ldx	#7
     17  0e10				   .col
     18  0e10		       bd 7b 6a 	      lda	colSelect,x
     19  0e13		       8d 00 dc 	      sta	CIA1_PRA
     20  0e16		       ad 01 dc 	      lda	CIA1_PRB
     21  0e19		       49 ff		      eor	#$FF
     22  0e1b		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0e1e		       9d 80 c2 	      sta	keyNow,x
     24  0e21		       ca		      dex
     25  0e22		       10 ec		      bpl	.col
     26  0e24		       a9 ff		      lda	#$FF
     27  0e26		       8d 00 dc 	      sta	CIA1_PRA
     28  0e29							; ---- every column as accepted (nothing pressed or let go): done
     29  0e29		       a2 07		      ldx	#7
     30  0e2b				   .same
     31  0e2b		       bd 80 c2 	      lda	keyNow,x
     32  0e2e		       dd 90 c2 	      cmp	keyAcc,x
     33  0e31		       d0 04		      bne	.changed
     34  0e33		       ca		      dex
     35  0e34		       10 f5		      bpl	.same
     36  0e36		       60		      rts
     37  0e37				   .changed
     38  0e37							; ---- releases first: accepted keys that are up now
     39  0e37		       a2 00		      ldx	#0
     40  0e39				   .rc
     41  0e39		       8e 37 c3 	      stx	ksCol
     42  0e3c		       bd 80 c2 	      lda	keyNow,x
     43  0e3f		       49 ff		      eor	#$FF
     44  0e41		       3d 90 c2 	      and	keyAcc,x
     45  0e44		       8d 36 c3 	      sta	ksBits
     46  0e47		       a9 00		      lda	#0
     47  0e49		       8d 38 c3 	      sta	ksRow
     48  0e4c				   .rb
     49  0e4c		       ad 36 c3 	      lda	ksBits
     50  0e4f		       f0 21		      beq	.rcn
     51  0e51		       4e 36 c3 	      lsr	ksBits
     52  0e54		       90 17		      bcc	.rbn
     53  0e56		       ae 37 c3 	      ldx	ksCol
     54  0e59		       ac 38 c3 	      ldy	ksRow
     55  0e5c		       b9 83 6a 	      lda	rowBit,y
     56  0e5f		       49 ff		      eor	#$FF
     57  0e61		       3d 90 c2 	      and	keyAcc,x
     58  0e64		       9d 90 c2 	      sta	keyAcc,x
     59  0e67		       20 f9 0e 	      jsr	KeyCode
     60  0e6a		       20 bb 11 	      jsr	KeyUp
     61  0e6d				   .rbn
     62  0e6d		       ee 38 c3 	      inc	ksRow
     63  0e70		       d0 da		      bne	.rb
     64  0e72				   .rcn
     65  0e72		       ae 37 c3 	      ldx	ksCol
     66  0e75		       e8		      inx
     67  0e76		       e0 08		      cpx	#8
     68  0e78		       d0 bf		      bne	.rc
     69  0e7a							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0e7a							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0e7a							; still count as a combination.
     72  0e7a		       a9 00		      lda	#0
     73  0e7c		       8d 3a c3 	      sta	ksPass
     74  0e7f				   .pass
     75  0e7f		       a2 00		      ldx	#0
     76  0e81				   .pc
     77  0e81		       8e 37 c3 	      stx	ksCol
     78  0e84		       bd 90 c2 	      lda	keyAcc,x
     79  0e87		       49 ff		      eor	#$FF
     80  0e89		       3d 80 c2 	      and	keyNow,x
     81  0e8c		       8d 36 c3 	      sta	ksBits
     82  0e8f		       a9 00		      lda	#0
     83  0e91		       8d 38 c3 	      sta	ksRow
     84  0e94				   .pb
     85  0e94		       ad 36 c3 	      lda	ksBits
     86  0e97		       f0 3d		      beq	.pcn
     87  0e99		       4e 36 c3 	      lsr	ksBits
     88  0e9c		       90 33		      bcc	.pbn
     89  0e9e		       ad 3b c3 	      lda	ghostFilter
     90  0ea1		       f0 05		      beq	.accept	; filter off (default): phantoms play
     91  0ea3		       20 07 0f 	      jsr	Suspect
     92  0ea6		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     93  0ea8				   .accept
     94  0ea8		       20 f9 0e 	      jsr	KeyCode
     95  0eab		       20 ea 0e 	      jsr	IsModifier	; Z set = modifier
     96  0eae		       f0 07		      beq	.mod
     97  0eb0		       ad 3a c3 	      lda	ksPass
     98  0eb3		       f0 1c		      beq	.pbn	; pass 0: modifiers only
     99  0eb5		       d0 05		      bne	.take
    100  0eb7				   .mod
    101  0eb7		       ad 3a c3 	      lda	ksPass
    102  0eba		       d0 15		      bne	.pbn	; (taken in pass 0)
    103  0ebc				   .take
    104  0ebc		       ae 37 c3 	      ldx	ksCol
    105  0ebf		       ac 38 c3 	      ldy	ksRow
    106  0ec2		       b9 83 6a 	      lda	rowBit,y
    107  0ec5		       1d 90 c2 	      ora	keyAcc,x
    108  0ec8		       9d 90 c2 	      sta	keyAcc,x
    109  0ecb		       20 f9 0e 	      jsr	KeyCode
    110  0ece		       20 38 0f 	      jsr	KeyDown
    111  0ed1				   .pbn
    112  0ed1		       ee 38 c3 	      inc	ksRow
    113  0ed4		       d0 be		      bne	.pb
    114  0ed6				   .pcn
    115  0ed6		       ae 37 c3 	      ldx	ksCol
    116  0ed9		       e8		      inx
    117  0eda		       e0 08		      cpx	#8
    118  0edc		       d0 a3		      bne	.pc
