------- FILE main.asm
------- FILE repeat.asm LEVEL 2 PASS 3
      0  4c8a					      include	"repeat.asm"
      1  4c8a							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  4c8a							;
      3  4c8a							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  4c8a							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  4c8a							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  4c8a							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  4c8a							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  4c8a							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  4c8a							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  4c8a							; 3/4 of the time between echoes. The SID doesn't echo.
     11  4c8a							;
     12  4c8a							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  4c8a							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  4c8a							; or a keytar button).
     15  4c8a							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  4c8a							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  4c8a
     18  4c8a		       00 10	   RP_SLOTS   equ	16
     19  4c8a		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  4c8a
     21  4c8a							; REPEAT is on now?
     22  4c8a				   RepeatActive
     23  4c8a		       ad 16 ca 	      lda	repeatOn
     24  4c8d		       0d 76 c9 	      ora	actCnt+A_REPEAT
     25  4c90		       60		      rts
     26  4c91
     27  4c91							; Allocate, after SPARKLE took its pair: the echo voices (vSkip keeps them
     28  4c91							; out of the chord, vEcho marks them)
     29  4c91				   RepeatSet
     30  4c91					      subroutine
     31  4c91		       a2 08		      ldx	#NUM_VOICES-1
     32  4c93		       a9 00		      lda	#0
     33  4c95				   .c
