    137  0a56							; Carry set if the Teensyboy has room for a message (always, with the Game
    138  0a56							; Boy off), and counts it.
    139  0a56				   LinkRoom
    140  0a56					      subroutine
    141  0a56		       ad 0e c3 	      lda	devOn+DEV_GB
    142  0a59		       f0 0a		      beq	.yes
    143  0a5b		       a5 2d		      lda	linkLoad
    144  0a5d		       c9 2d		      cmp	#LINK_MAX
    145  0a5f		       b0 06		      bcs	.no
    146  0a61		       69 03		      adc	#3
    147  0a63		       85 2d		      sta	linkLoad
    148  0a65				   .yes
    149  0a65		       38		      sec
    150  0a66		       60		      rts
    151  0a67				   .no
    152  0a67		       18		      clc
    153  0a68		       60		      rts
