    109  7a37		       ad 61 cb 	      lda	sndPenvK
    110  7a3a		       ae 5d cb 	      ldx	sndStep
    111  7a3d		       f0 02		      beq	.k
    112  7a3f		       a9 ff		      lda	#$FF	; (STEP: held; AtkStep jumps)
    113  7a41				   .k
