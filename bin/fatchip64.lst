      0  0cec					      include	"keys.asm"
      1  0cec							; Fat Chip 64 - keyboard and RESTORE
      2  0cec
      3  0cec							; Scan the whole matrix, turn changes into key events.
      4  0cec							;
      5  0cec							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0cec							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0cec							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0cec							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0cec							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0cec							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0cec							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0cec							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0cec							; chords whose ghost lands on another used key lose their newest note.
     14  0cec				   KeyScan
     15  0cec					      subroutine
     16  0cec		       a2 07		      ldx	#7
     17  0cee				   .col
     18  0cee		       bd d7 49 	      lda	colSelect,x
     19  0cf1		       8d 00 dc 	      sta	CIA1_PRA
     20  0cf4		       ad 01 dc 	      lda	CIA1_PRB
     21  0cf7		       49 ff		      eor	#$FF
     22  0cf9		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0cfc		       9d 80 c2 	      sta	keyNow,x
     24  0cff		       ca		      dex
     25  0d00		       10 ec		      bpl	.col
     26  0d02		       a9 ff		      lda	#$FF
     27  0d04		       8d 00 dc 	      sta	CIA1_PRA
     28  0d07							; ---- releases first: accepted keys that are up now
     29  0d07		       a2 00		      ldx	#0
     30  0d09				   .rc
     31  0d09		       8e 37 c3 	      stx	ksCol
     32  0d0c		       bd 80 c2 	      lda	keyNow,x
     33  0d0f		       49 ff		      eor	#$FF
     34  0d11		       3d 90 c2 	      and	keyAcc,x
     35  0d14		       8d 36 c3 	      sta	ksBits
     36  0d17		       a9 00		      lda	#0
     37  0d19		       8d 38 c3 	      sta	ksRow
     38  0d1c				   .rb
     39  0d1c		       ad 36 c3 	      lda	ksBits
     40  0d1f		       f0 21		      beq	.rcn
     41  0d21		       4e 36 c3 	      lsr	ksBits
     42  0d24		       90 17		      bcc	.rbn
     43  0d26		       ae 37 c3 	      ldx	ksCol
     44  0d29		       ac 38 c3 	      ldy	ksRow
     45  0d2c		       b9 df 49 	      lda	rowBit,y
     46  0d2f		       49 ff		      eor	#$FF
     47  0d31		       3d 90 c2 	      and	keyAcc,x
     48  0d34		       9d 90 c2 	      sta	keyAcc,x
     49  0d37		       20 c9 0d 	      jsr	KeyCode
     50  0d3a		       20 6c 10 	      jsr	KeyUp
     51  0d3d				   .rbn
     52  0d3d		       ee 38 c3 	      inc	ksRow
     53  0d40		       d0 da		      bne	.rb
     54  0d42				   .rcn
     55  0d42		       ae 37 c3 	      ldx	ksCol
     56  0d45		       e8		      inx
     57  0d46		       e0 08		      cpx	#8
     58  0d48		       d0 bf		      bne	.rc
     59  0d4a							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     60  0d4a							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     61  0d4a							; still count as a combination.
     62  0d4a		       a9 00		      lda	#0
     63  0d4c		       8d 3a c3 	      sta	ksPass
     64  0d4f				   .pass
     65  0d4f		       a2 00		      ldx	#0
     66  0d51				   .pc
     67  0d51		       8e 37 c3 	      stx	ksCol
     68  0d54		       bd 90 c2 	      lda	keyAcc,x
     69  0d57		       49 ff		      eor	#$FF
     70  0d59		       3d 80 c2 	      and	keyNow,x
     71  0d5c		       8d 36 c3 	      sta	ksBits
     72  0d5f		       a9 00		      lda	#0
     73  0d61		       8d 38 c3 	      sta	ksRow
     74  0d64				   .pb
     75  0d64		       ad 36 c3 	      lda	ksBits
     76  0d67		       f0 3d		      beq	.pcn
     77  0d69		       4e 36 c3 	      lsr	ksBits
     78  0d6c		       90 33		      bcc	.pbn
     79  0d6e		       ad 3b c3 	      lda	ghostFilter
     80  0d71		       f0 05		      beq	.accept	; filter off (default): phantoms play
     81  0d73		       20 d7 0d 	      jsr	Suspect
     82  0d76		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     83  0d78				   .accept
     84  0d78		       20 c9 0d 	      jsr	KeyCode
     85  0d7b		       20 ba 0d 	      jsr	IsModifier	; Z set = modifier
     86  0d7e		       f0 07		      beq	.mod
     87  0d80		       ad 3a c3 	      lda	ksPass
     88  0d83		       f0 1c		      beq	.pbn	; pass 0: modifiers only
     89  0d85		       d0 05		      bne	.take
     90  0d87				   .mod
     91  0d87		       ad 3a c3 	      lda	ksPass
     92  0d8a		       d0 15		      bne	.pbn	; (taken in pass 0)
     93  0d8c				   .take
     94  0d8c		       ae 37 c3 	      ldx	ksCol
     95  0d8f		       ac 38 c3 	      ldy	ksRow
     96  0d92		       b9 df 49 	      lda	rowBit,y
     97  0d95		       1d 90 c2 	      ora	keyAcc,x
     98  0d98		       9d 90 c2 	      sta	keyAcc,x
     99  0d9b		       20 c9 0d 	      jsr	KeyCode
    100  0d9e		       20 08 0e 	      jsr	KeyDown
    101  0da1				   .pbn
    102  0da1		       ee 38 c3 	      inc	ksRow
    103  0da4		       d0 be		      bne	.pb
    104  0da6				   .pcn
    105  0da6		       ae 37 c3 	      ldx	ksCol
    106  0da9		       e8		      inx
    107  0daa		       e0 08		      cpx	#8
    108  0dac		       d0 a3		      bne	.pc
    109  0dae		       ad 3a c3 	      lda	ksPass
    110  0db1		       d0 06		      bne	.done
    111  0db3		       ee 3a c3 	      inc	ksPass
    112  0db6		       4c 4f 0d 	      jmp	.pass
    113  0db9				   .done
    114  0db9		       60		      rts
    115  0dba
    116  0dba							; Z set if key code A is a modifier. Keeps A.
    117  0dba				   IsModifier
    118  0dba		       c9 88		      cmp	#K_LSHIFT
    119  0dbc		       f0 0a		      beq	.y
    120  0dbe		       c9 89		      cmp	#K_RSHIFT
    121  0dc0		       f0 06		      beq	.y
    122  0dc2		       c9 8c		      cmp	#K_CTRL
    123  0dc4		       f0 02		      beq	.y
    124  0dc6		       c9 9a		      cmp	#K_K
    125  0dc8				   .y
