------- FILE drums.asm LEVEL 2 PASS 3
      0  4dba					      include	"drums.asm"
      1  4dba							; Fat Chip 64 - drums on the MidiNES
      2  4dba							;
      3  4dba							; Two sources, one kit:
      4  4dba							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  4dba							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  4dba							;			   64 = hit, 56 = ghost)
      7  4dba							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  4dba							;			   RETURN starts / stops it, at its own tempo (B taps
      9  4dba							;			   a new one)
     10  4dba							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  4dba							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  4dba							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  4dba							; a note-on, then a note-off after the sound's length, the level set with
     14  4dba							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  4dba							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  4dba
     17  4dba		       00 0c	   KIT_SIZE   equ	12
     18  4dba		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  4dba		       00 00	   DK_KICK    equ	0
     20  4dba		       00 01	   DK_SNARE   equ	1
     21  4dba		       00 02	   DK_CH      equ	2
     22  4dba		       00 03	   DK_OH      equ	3
     23  4dba		       00 04	   DK_CY      equ	4
     24  4dba		       00 05	   DK_TOM     equ	5
     25  4dba		       00 06	   DK_PERC    equ	6
     26  4dba
     27  4dba							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  4dba				   DrumHit
     29  4dba					      subroutine
     30  4dba		       8d 87 c4 	      sta	drumKind
     31  4dbd		       8e 86 c4 	      stx	drumLvl
     32  4dc0		       8c 88 c4 	      sty	drumTom
     33  4dc3		       c9 00		      cmp	#DK_KICK
     34  4dc5		       d0 05		      bne	.nk
     35  4dc7		       a9 01		      lda	#1
     36  4dc9		       8d 44 c6 	      sta	vizKick	; (the visualizer's border flash)
     37  4dcc				   .nk
     38  4dcc		       ad 27 c3 	      lda	devOn+DEV_NES
     39  4dcf		       d0 01		      bne	.on
     40  4dd1		       60		      rts
     41  4dd2				   .on
     42  4dd2		       20 53 23 	      jsr	GetTicks
     43  4dd5		       ad 87 c4 	      lda	drumKind
     44  4dd8		       c9 02		      cmp	#DK_CH
