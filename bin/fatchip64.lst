     65  1cea				   .lt2000
     66  1cea		       a5 25		      lda	t1
     67  1cec		       d0 06		      bne	.ok
     68  1cee		       a5 24		      lda	t0
     69  1cf0		       c9 f0		      cmp	#240
     70  1cf2		       90 68		      bcc	.x	; too fast: a bounce, ignore
     71  1cf4				   .ok
     72  1cf4		       ae 47 c3 	      ldx	tapPos
     73  1cf7		       a5 24		      lda	t0
