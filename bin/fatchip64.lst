------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  53a2					      include	"sync.asm"
      1  53a2							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  53a2							;
      3  53a2							; Menu, DEVICE SYNC (defaults first):
      4  53a2							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  53a2							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  53a2							;		     sets the tempo, averaged over beats (the clock jitters about
      7  53a2							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  53a2							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  53a2							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  53a2							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  53a2							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  53a2							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  53a2							;		     picks a beat demo (styleBeat)
     14  53a2							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  53a2							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  53a2							;		     key channel) picks a sound (voiceSound)
     17  53a2							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  53a2							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  53a2							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  53a2							;
     21  53a2							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  53a2							; 1/4 ms); a Start makes the next clock a beat.
     23  53a2
     24  53a2		       00 00	   TEMPO_KEYTAR equ	0
     25  53a2		       00 01	   TEMPO_OWN  equ	1
     26  53a2		       00 02	   TEMPO_SC   equ	2
     27  53a2		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  53a2
     29  53a2
     30  53a2
     31  53a2							; ------------------------------------------------------------ clock
