------- FILE screen.asm LEVEL 2 PASS 3
      0  54c0					      include	"screen.asm"
      1  54c0							; Fat Chip 64 - screen
      2  54c0							;
      3  54c0							;  row 0      header
      4  54c0							;  row 2      sound, POLY / MONO, Fat Bass
      5  54c0							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  54c0							;	       each plays (row 7: a channel overlap warning)
      7  54c0							;  row 9      key, notes mode, latch
      8  54c0							;  row 10     arp
      9  54c0							;  row 12     tempo, beat, mute
     10  54c0							;  row 13     SPACE's action, octave (the lowest key)
     11  54c0							;  row 15     held notes
     12  54c0							;  row 16     MIDI in
     13  54c0							;  row 24     F keys
     14  54c0
     15  54c0							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     16  54c0							; Letters become screen codes; bit 7 of t2 reverses.
     17  54c0				   PrintAt
     18  54c0					      subroutine
     19  54c0		       20 d8 54 	      jsr	ScreenAddr
     20  54c3		       a0 00		      ldy	#0
     21  54c5				   .c
     22  54c5		       b1 28		      lda	(ptr),y
     23  54c7		       f0 0e		      beq	.done
     24  54c9		       c9 40		      cmp	#64
     25  54cb		       90 03		      bcc	.noLetter
     26  54cd		       38		      sec
     27  54ce		       e9 40		      sbc	#64
     28  54d0				   .noLetter
     29  54d0		       05 26		      ora	t2
     30  54d2		       91 2a		      sta	(ptr2),y
     31  54d4		       c8		      iny
     32  54d5		       d0 ee		      bne	.c
     33  54d7				   .done
     34  54d7		       60		      rts
     35  54d8
     36  54d8							; ptr2 = SCREEN + 40*Y + X (row table: no loop)
     37  54d8				   ScreenAddr
     38  54d8					      subroutine
     39  54d8		       8a		      txa
     40  54d9		       18		      clc
     41  54da		       79 e9 54 	      adc	rowAddrLo,y
     42  54dd		       85 2a		      sta	ptr2
     43  54df		       b9 02 55 	      lda	rowAddrHi,y
     44  54e2		       69 00		      adc	#0
     45  54e4		       85 2b		      sta	ptr2+1
     46  54e6		       a0 00		      ldy	#0	; (callers expect Y = 0, as the old loop left it)
     47  54e8		       60		      rts
     48  54e9				   rowAddrLo
     49  54e9		       00 28 50 78*	      .byte.b	<(SCREEN+0),<(SCREEN+40),<(SCREEN+80),<(SCREEN+120),<(SCREEN+160),<(SCREEN+200),<(SCREEN+240),<(SCREEN+280),<(SCREEN+320),<(SCREEN+360),<(SCREEN+400),<(SCREEN+440),<(SCREEN+480),<(SCREEN+520),<(SCREEN+560),<(SCREEN+600),<(SCREEN+640),<(SCREEN+680),<(SCREEN+720),<(SCREEN+760),<(SCREEN+800),<(SCREEN+840),<(SCREEN+880),<(SCREEN+920),<(SCREEN+960)
     50  5502				   rowAddrHi
     51  5502		       04 04 04 04*	      .byte.b	>(SCREEN+0),>(SCREEN+40),>(SCREEN+80),>(SCREEN+120),>(SCREEN+160),>(SCREEN+200),>(SCREEN+240),>(SCREEN+280),>(SCREEN+320),>(SCREEN+360),>(SCREEN+400),>(SCREEN+440),>(SCREEN+480),>(SCREEN+520),>(SCREEN+560),>(SCREEN+600),>(SCREEN+640),>(SCREEN+680),>(SCREEN+720),>(SCREEN+760),>(SCREEN+800),>(SCREEN+840),>(SCREEN+880),>(SCREEN+920),>(SCREEN+960)
     52  551b
     53  551b							; macro-ish helper: PRINT row, col, label
     54  551b					      mac	print
     55  551b					      ldx	#{2}
     56  551b					      ldy	#{1}
     57  551b					      lda	#<{3}
     58  551b					      sta	ptr
     59  551b					      lda	#>{3}
     60  551b					      sta	ptr+1
     61  551b					      jsr	PrintAt
     62  551b					      endm
     63  551b
     64  551b							; Put the character in A at column X of the row in ptr2 (ScreenAddr first).
