    124  758f		       ad a7 c6 	      lda	sndRdropK
    125  7592		       99 6e c9 	      sta	sK,y
    126  7595		       a9 01		      lda	#1
    127  7597		       99 72 c9 	      sta	rdOn,y
    128  759a				   .x
    129  759a		       60		      rts
    130  759b
    131  759b							; A = a note, kept within the SID's table (0-127; a signed overflow: 0)
    132  759b				   NoteClamp
    133  759b					      subroutine
    134  759b		       c9 00		      cmp	#0
    135  759d		       10 02		      bpl	.x
    136  759f		       a9 00		      lda	#0
    137  75a1				   .x
