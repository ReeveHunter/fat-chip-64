     57  4df3		       ad 40 c3 	      lda	nowH
     58  4df6		       ed 7f c4 	      sbc	dmcAt+1
     59  4df9		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  4dfb		       c0 0c		      cpy	#DRUM_WINDOW
     61  4dfd		       b0 08		      bcs	.ok
     62  4dff		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     63  4e01		       cd 7d c4 	      cmp	dmcPrio
     64  4e04		       90 01		      bcc	.ok
