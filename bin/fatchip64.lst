    100  1d78		       30 06		      bmi	.tri
    101  1d7a		       a9 00		      lda	#ENV_IDLE
    102  1d7c		       99 ba c3 	      sta	envPh,y
    103  1d7f		       60		      rts
    104  1d80				   .tri
    105  1d80		       bd ce 2a 	      lda	vIdx,x
    106  1d83		       c9 02		      cmp	#2
