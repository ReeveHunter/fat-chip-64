     43  0a31
     44  0a31							; IRQ: pace device queues onto the wire.
     45  0a31							;
     46  0a31							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
     47  0a31							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
     48  0a31							; times as signed numbers, so after 33 s of silence every queue froze for
     49  0a31							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
     50  0a31							;
     51  0a31							; When the Game Boy is on, everything on the wire also passes through the
     52  0a31							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
     53  0a31							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
     54  0a31							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
     55  0a31							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
     56  0a31							; message, the rate measured clean.
     57  0a31				   Schedule
     58  0a31					      subroutine
     59  0a31		       ad 26 c3 	      lda	devOn+DEV_GB
     60  0a34		       f0 10		      beq	.gb
     61  0a36		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
     62  0a38		       f0 0c		      beq	.gb
     63  0a3a		       c6 2e		      dec	linkLoad
     64  0a3c		       f0 08		      beq	.gb
     65  0a3e		       a5 10		      lda	ticks
     66  0a40		       29 01		      and	#1
     67  0a42		       f0 02		      beq	.gb
     68  0a44		       c6 2e		      dec	linkLoad
     69  0a46				   .gb
     70  0a46							; ---- Game Boy
     71  0a46		       a5 18		      lda	gbqTail
     72  0a48		       c5 17		      cmp	gbqHead
     73  0a4a		       f0 36		      beq	.nes
     74  0a4c		       a5 19		      lda	gbNext
     75  0a4e		       38		      sec
     76  0a4f		       e5 10		      sbc	ticks
     77  0a51		       f0 04		      beq	.gbDue
     78  0a53		       c9 04		      cmp	#GB_GAP+1
     79  0a55		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
     80  0a57				   .gbDue
     81  0a57							; only onto an empty wire, so the gap holds on the cable itself (NES
     82  0a57							; bytes already waiting would otherwise delay this one and squeeze it
     83  0a57							; against the next). While a Game Boy message is due, the NES doesn't
     84  0a57							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
     85  0a57							; holding its notes back.
     86  0a57		       a5 15		      lda	wireHead
     87  0a59		       c5 16		      cmp	wireTail
     88  0a5b		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
     89  0a5d		       20 c3 0a 	      jsr	LinkRoom
     90  0a60		       90 20		      bcc	.nes
     91  0a62		       a6 18		      ldx	gbqTail
     92  0a64		       bd 00 c1 	      lda	gbqS,x
     93  0a67		       bc 80 c1 	      ldy	gbqD2,x
     94  0a6a		       84 2c		      sty	irqT
     95  0a6c		       bc 40 c1 	      ldy	gbqD1,x
     96  0a6f		       20 df 0a 	      jsr	WireMsg
     97  0a72		       a5 18		      lda	gbqTail
     98  0a74		       18		      clc
     99  0a75		       69 01		      adc	#1
    100  0a77		       29 3f		      and	#63
    101  0a79		       85 18		      sta	gbqTail
    102  0a7b		       a5 10		      lda	ticks
    103  0a7d		       18		      clc
    104  0a7e		       69 03		      adc	#GB_GAP
