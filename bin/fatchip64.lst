------- FILE sounds.asm LEVEL 2 PASS 3
      0  28ca					      include	"sounds.asm"
      1  28ca							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  28ca							;
      3  28ca							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  28ca							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  28ca							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  28ca							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  28ca							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  28ca							;
      9  28ca							; Each sound has a mono default and a Fat Bass default:
     10  28ca							;   MONO      one note (the last key pressed and still held) on every voice;
     11  28ca							;	       a new key while another is held changes the pitch without a
     12  28ca							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  28ca							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  28ca							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  28ca							;	       the other voices
     16  28ca							;
     17  28ca							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  28ca							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  28ca							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  28ca
     21  28ca							; ------------------------------------------------------------ choosing
     22  28ca							; V: next sound (SHIFT+V: previous)
     23  28ca				   SoundKey
     24  28ca					      subroutine
     25  28ca		       20 0c 29 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  28cd		       ae 95 c3 	      ldx	soundMode
     27  28d0		       ad 2a c3 	      lda	shiftDown
     28  28d3		       d0 09		      bne	.prev
     29  28d5		       e8		      inx
     30  28d6		       e0 13		      cpx	#NUM_SOUNDS
     31  28d8		       90 09		      bcc	.s
     32  28da		       a2 00		      ldx	#0
     33  28dc		       f0 05		      beq	.s
     34  28de				   .prev
