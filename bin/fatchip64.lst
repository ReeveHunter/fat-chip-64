------- FILE patchedit.asm LEVEL 2 PASS 3
      0  5888					      include	"patchedit.asm"
      1  5888							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  5888							; the dice. The settings and their steps come from tools/gen_menu.py
      3  5888							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  5888							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  5888							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  5888							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  5888							; (EnvDerive).
      8  5888
      9  5888		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  5888		       00 30	   LFO_LAST   equ	FLD_gbLDelay
     11  5888
     12  5888							; X = param -> A = the step the live patch is nearest to
