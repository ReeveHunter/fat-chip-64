    553  dff6		       fd 08	   fxMem      equ	hiEnd
    554  dff6		       fd 48	   fxMemOk    equ	hiEnd+64
    555  dff6							; v0.68: the sampler's (sampler.asm), cleared at start too
    556  dff6		       fd 58	   SMP	      equ	fxMemOk+16
    557  dff6		       fd 58	   smpOn      equ	SMP+0	; 1: the sampler's screen and keys
    558  dff6		       fd 59	   smpInit    equ	SMP+1	; kit 1 made from the beat's kit
    559  dff6		       fd 5a	   smpArm     equ	SMP+2	; RETURN: the next pad gets the browser's sample
    560  dff6		       fd 5b	   smpKit     equ	SMP+3	; 0 / 1: kit 1 / 2
    561  dff6		       fd 5c	   smpSel     equ	SMP+4	; the browser's sample (bit 7: bank B)
    562  dff6		       fd 5d	   smpRate    equ	SMP+5	; its rate, 0-15
    563  dff6		       fd 5e	   smpFilt    equ	SMP+6	; TYPE: 0 ALL, 1-8 K S H P L T F V
    564  dff6		       fd 5f	   padKeys    equ	SMP+7	; PAD KEYS: 0 GRID, 1 OVERLAY
    565  dff6		       fd 60	   padCh      equ	SMP+8	; PAD MIDI CHANNEL: 0 OFF, 1-16
    566  dff6		       fd 61	   padBase    equ	SMP+9	; PAD BASE NOTE
    567  dff6		       fd 62	   dmcRate    equ	SMP+10	; the MidiNES's sample rate (CC 3) last sent
    568  dff6		       fd 63	   padLitP    equ	SMP+11	; the lit pad ($FF none), since padLitT
    569  dff6		       fd 64	   padLitT    equ	SMP+12
    570  dff6		       fd 65	   padVel     equ	SMP+13
    571  dff6		       fd 66	   padNow     equ	SMP+14
    572  dff6		       fd 67	   padCC      equ	SMP+15
    573  dff6		       fd 68	   padLane    equ	SMP+16
    574  dff6		       fd 69	   smpCode    equ	SMP+17
    575  dff6		       fd 6a	   smpTmp     equ	SMP+18
    576  dff6		       fd 6b	   smpI       equ	SMP+19
    577  dff6		       fd 6c	   smpN       equ	SMP+20
    578  dff6		       fd 6d	   smpX       equ	SMP+21
    579  dff6		       fd 6e	   smpY       equ	SMP+22
    580  dff6		       fd 6f	   smpR       equ	SMP+23
    581  dff6		       fd 70	   smpS       equ	SMP+24
    582  dff6		       fd 71	   smpX2      equ	SMP+25
    583  dff6		       fd 72	   smpN2      equ	SMP+26
    584  dff6		       fd 73	   smpTaken   equ	SMP+27	; 8: the keys whose press the sampler took
    585  dff6		       fd 80	   padKit     equ	SMP+40	; 2 kits x 16 pads x (sample or $FF, rate)
    586  dff6		       fd c0	   SMP_END    equ	SMP+104
    587  dff6				  -	      if	SMP_END > $FFF0
    588  dff6				  -	      echo	"fxMem runs into the vectors"
    589  dff6				  -	      err
    590  dff6					      endif
    591  dff6					      rend
    592  dff6				  -	      if	hiEnd > $FFFA
    593  dff6				  -	      echo	"the $E000 tables run into the CPU's vectors"
    594  dff6				  -	      err
    595  dff6					      endif
    596  dff6
    597  dff6							; ---- v0.60: data in the RAM under the I/O ($D000-$DFFF): packed apart too,
    598  dff6							; unpacked there with the I/O switched out; read with BeatLoad's copy
    599  dff6				   ioPhys
    600  dff6					      rorg	$D000
    601  dff6				   ioStart
