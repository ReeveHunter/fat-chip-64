------- FILE main.asm
------- FILE patchedit.asm LEVEL 2 PASS 3
      0  58bc					      include	"patchedit.asm"
      1  58bc							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  58bc							; the dice. The settings and their steps come from tools/gen_menu.py
      3  58bc							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  58bc							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  58bc							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  58bc							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  58bc							; (EnvDerive).
      8  58bc
      9  58bc		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  58bc		       00 30	   LFO_LAST   equ	FLD_gbLDelay
     11  58bc
     12  58bc							; X = param -> A = the step the live patch is nearest to
     13  58bc				   ParamNearest
     14  58bc					      subroutine
     15  58bc		       8e 1f c8 	      stx	pnP
     16  58bf		       bc 73 93 	      ldy	prKey,x
     17  58c2		       b9 4c c6 	      lda	livePatch,y
     18  58c5		       3d db 93 	      and	prKeyM,x
     19  58c8		       8d 23 c8 	      sta	pnVL
     20  58cb		       a9 00		      lda	#0
     21  58cd		       8d 24 c8 	      sta	pnVH
     22  58d0		       bc a7 93 	      ldy	prKeyH,x
