    362  0daa							; ------------------------------------------------------------ device setup
    363  0daa							; Fat Chip GB startup / resync (protocol section 2)
    364  0daa				   GbStartup
    365  0daa					      subroutine
    366  0daa		       ad 26 c3 	      lda	devOn+DEV_GB
    367  0dad		       f0 66		      beq	.done
