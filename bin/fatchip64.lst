     81  2c0d		       60		      rts
     82  2c0e				   .byte
     83  2c0e		       bd e5 c3 	      lda	rxBuf,x
     84  2c11		       a8		      tay
     85  2c12		       e8		      inx
     86  2c13		       8a		      txa
     87  2c14		       29 3f		      and	#63
     88  2c16		       8d 26 c4 	      sta	rxTail
     89  2c19		       98		      tya
     90  2c1a		       10 1e		      bpl	.data
     91  2c1c		       c9 f8		      cmp	#$F8
     92  2c1e		       b0 49		      bcs	.rt	; realtime (clocks are counted by RxByte)
     93  2c20		       c9 f0		      cmp	#$F0
     94  2c22		       b0 07		      bcs	.sys
     95  2c24		       a2 00		      ldx	#0	; a channel message ends any SysEx
     96  2c26		       8e 4d c7 	      stx	sxOn
     97  2c29		       f0 05		      beq	.status
     98  2c2b				   .sys
     99  2c2b		       20 cf 2d 	      jsr	SysexStatus	; F0 starts a SysEx, F7 ends it (v0.20)
    100  2c2e		       a9 00		      lda	#0	; system: no running status until the next one
    101  2c30				   .status
    102  2c30		       8d 27 c4 	      sta	rxStatus
    103  2c33		       a9 00		      lda	#0
    104  2c35		       8d 28 c4 	      sta	rxCnt
    105  2c38		       f0 cb		      beq	.next
    106  2c3a				   .data
    107  2c3a		       ae 4d c7 	      ldx	sxOn
    108  2c3d		       f0 06		      beq	.nosx
    109  2c3f		       20 f9 2d 	      jsr	SysexByte
    110  2c42		       4c 05 2c 	      jmp	.next
    111  2c45				   .nosx
    112  2c45		       ae 27 c4 	      ldx	rxStatus
    113  2c48		       f0 bb		      beq	.next	; no status yet
    114  2c4a		       ae 28 c4 	      ldx	rxCnt
    115  2c4d		       d0 2e		      bne	.second
    116  2c4f		       8d 29 c4 	      sta	rxD1
    117  2c52		       ee 28 c4 	      inc	rxCnt
    118  2c55		       ad 27 c4 	      lda	rxStatus
    119  2c58		       29 e0		      and	#$E0
    120  2c5a		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
    121  2c5c		       d0 a7		      bne	.next
    122  2c5e		       a9 00		      lda	#0
    123  2c60		       8d 28 c4 	      sta	rxCnt
    124  2c63		       20 8b 2c 	      jsr	MidiInMsg
    125  2c66		       4c 05 2c 	      jmp	.next
    126  2c69				   .rt
    127  2c69		       c9 fa		      cmp	#$FA
    128  2c6b		       d0 06		      bne	.rt2
    129  2c6d		       20 81 45 	      jsr	KeytarStart
