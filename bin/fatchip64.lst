      0  1cfc					      include	"arp.asm"
      1  1cfc							; Fat Chip 64 - tempo and arpeggiator
      2  1cfc							;
      3  1cfc							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1cfc							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1cfc							;
      6  1cfc							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1cfc							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1cfc							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1cfc							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1cfc							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1cfc							;	     until its voice's next turn.
     12  1cfc							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1cfc							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1cfc							;   J faster; either one also picks FREE).
     15  1cfc							;
     16  1cfc							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1cfc							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1cfc
     19  1cfc							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1cfc							; between the two bytes: $22FF read as $23FF)
     21  1cfc				   GetTicks
     22  1cfc					      subroutine
     23  1cfc		       08		      php
     24  1cfd		       78		      sei
     25  1cfe		       a5 10		      lda	ticks
     26  1d00		       8d 3e c3 	      sta	nowL
     27  1d03		       a5 11		      lda	ticks+1
     28  1d05		       8d 3f c3 	      sta	nowH
     29  1d08		       28		      plp
     30  1d09		       60		      rts
