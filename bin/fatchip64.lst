------- FILE attack.asm LEVEL 2 PASS 3
      0  7959					      include	"attack.asm"
      1  7959							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  7959							; how each note starts and ends in pitch
      3  7959							;
      4  7959							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  7959							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  7959							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  7959							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  7959							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  7959							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  7959							;   (v0.42) as long as TIME.
     11  7959							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  7959							;   release rings.
     13  7959
     14  7959							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  7959							; jumps to the note
     16  7959				   AtkStep
     17  7959					      subroutine
     18  7959		       ac cb c7 	      ldy	envY
     19  795c		       b9 75 cd 	      lda	atkT,y
     20  795f		       18		      clc
     21  7960		       6d 5e c8 	      adc	fxN
     22  7963		       90 02		      bcc	.t
     23  7965		       a9 ff		      lda	#255
     24  7967				   .t
     25  7967		       99 75 cd 	      sta	atkT,y
     26  796a		       b9 78 cd 	      lda	clickOn,y
     27  796d		       f0 21		      beq	.s
     28  796f		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  7971		       ae a1 ca 	      ldx	sndClick
     30  7974		       e0 02		      cpx	#2
     31  7976		       90 03		      bcc	.cl
     32  7978		       ad a0 ca 	      lda	sndStepT
     33  797b				   .cl
     34  797b		       d9 75 cd 	      cmp	atkT,y
     35  797e		       f0 02		      beq	.ce
     36  7980		       b0 0e		      bcs	.s
     37  7982				   .ce
     38  7982		       a9 00		      lda	#0
     39  7984		       99 78 cd 	      sta	clickOn,y
     40  7987		       be c2 88 	      ldx	sidOfs,y
     41  798a		       b9 36 c7 	      lda	sidGate,y
     42  798d		       9d 04 d4 	      sta	SID+4,x
     43  7990				   .s
     44  7990		       b9 6e cd 	      lda	sK,y
     45  7993		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  7995		       d0 19		      bne	.x
     47  7997		       b9 75 cd 	      lda	atkT,y
     48  799a		       cd a0 ca 	      cmp	sndStepT
     49  799d		       90 11		      bcc	.x
     50  799f		       b9 68 c8 	      lda	sidTgtLo,y	; TIME's up: the note
     51  79a2		       99 ea c7 	      sta	sidBaseLo,y
     52  79a5		       b9 6b c8 	      lda	sidTgtHi,y
     53  79a8		       99 ed c7 	      sta	sidBaseHi,y
     54  79ab		       a9 00		      lda	#0
     55  79ad		       99 6e cd 	      sta	sK,y
     56  79b0				   .x
     57  79b0		       60		      rts
     58  79b1
     59  79b1							; a SID voice's gate went on (Y = SID voice, t2 = its registers): the CLICK
     60  79b1							; starts. Keeps Y.
     61  79b1				   ClickOn
     62  79b1					      subroutine
     63  79b1		       ad a1 ca 	      lda	sndClick
     64  79b4		       f0 11		      beq	.x
     65  79b6		       a9 01		      lda	#1
     66  79b8		       99 78 cd 	      sta	clickOn,y
     67  79bb		       b9 36 c7 	      lda	sidGate,y
     68  79be		       29 01		      and	#1
     69  79c0		       09 80		      ora	#$80	; noise
     70  79c2		       a6 26		      ldx	t2
     71  79c4		       9d 04 d4 	      sta	SID+4,x
     72  79c7				   .x
     73  79c7		       60		      rts
     74  79c8
     75  79c8							; VoiceSet, a SID voice's new note (Y = SID voice, t0 = the voice, t3 = a new
     76  79c8							; press): BEND IN starts it away from its pitch
     77  79c8				   BendIn
     78  79c8					      subroutine
     79  79c8		       ad a2 ca 	      lda	sndPenv
     80  79cb		       f0 45		      beq	.x
     81  79cd		       a6 24		      ldx	t0
     82  79cf		       ad 54 c8 	      lda	legatoNow
     83  79d2		       d0 3e		      bne	.x	; (legato: no new start)
     84  79d4		       bd 17 c7 	      lda	vNote,x
     85  79d7		       c9 ff		      cmp	#NO_NOTE
     86  79d9		       f0 04		      beq	.go	; from silence
     87  79db		       a5 27		      lda	t3
     88  79dd		       f0 33		      beq	.x	; (a glide to a new note, no new attack)
     89  79df				   .go
     90  79df		       ad a2 ca 	      lda	sndPenv	; (v0.59: up to 4 octaves away: kept in 0-115)
     91  79e2		       30 0c		      bmi	.dn
     92  79e4		       18		      clc
     93  79e5		       7d 0e c7 	      adc	vWant,x
     94  79e8		       c9 74		      cmp	#116
     95  79ea		       90 0c		      bcc	.ok
     96  79ec		       a9 73		      lda	#115
     97  79ee		       d0 08		      bne	.ok
     98  79f0				   .dn
     99  79f0		       18		      clc
    100  79f1		       7d 0e c7 	      adc	vWant,x
    101  79f4		       b0 02		      bcs	.ok	; (no borrow: 0 or more)
    102  79f6		       a9 00		      lda	#0
    103  79f8				   .ok
    104  79f8		       20 d7 21 	      jsr	SidPitch	; -> ptr
    105  79fb		       a5 28		      lda	ptr
    106  79fd		       99 ea c7 	      sta	sidBaseLo,y
    107  7a00		       a5 29		      lda	ptr+1
    108  7a02		       99 ed c7 	      sta	sidBaseHi,y
    109  7a05		       ad a3 ca 	      lda	sndPenvK
    110  7a08		       ae 9f ca 	      ldx	sndStep
    111  7a0b		       f0 02		      beq	.k
    112  7a0d		       a9 ff		      lda	#$FF	; (STEP: held; AtkStep jumps)
    113  7a0f				   .k
    114  7a0f		       99 6e cd 	      sta	sK,y
    115  7a12				   .x
    116  7a12		       60		      rts
