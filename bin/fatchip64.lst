    369  381c
    370  381c							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    371  381c							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    372  381c							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    373  381c							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    374  381c		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    375  3820		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    376  3827		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    377  382e		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    378  3833		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    379  3837		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    380  383b		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
    381  3840		       05 0a 0f 14*uTremRH    .byte.b	>1311, >2621, >3932, >5243, >6554
    382  3845		       04 08 0c 10 uDetT      .byte.b	4, 8, 12, 16
    383  3849		       18 38 64    uWarbT     .byte.b	24, 56, 100
    384  384c							; ... and the Game Boy's CCs for them (LFO depth CC 1, rate CC 76, delay
    385  384c							; CC 79, glide CC 5, detune +- from 64 on CC 94)
    386  384c		       10 18 1c 20 gbVibDepT  .byte.b	16, 24, 28, 32
    387  3850		       48 50 54 58*gbVibRateT .byte.b	72, 80, 84, 88, 92, 96, 100
    388  3857		       00 08 10 20*gbVibDelT  .byte.b	0, 8, 16, 32, 64
    389  385c		       10 20 30 40 gbGlideT   .byte.b	16, 32, 48, 64
    390  3860		       03 06 0a 10 gbDetT     .byte.b	3, 6, 10, 16
    391  3864
