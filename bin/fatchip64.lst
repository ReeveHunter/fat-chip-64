      0  0b14					      include	"midi.asm"
      1  0b14							; Fat Chip 64 - MIDI out
      2  0b14							;
      3  0b14							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0b14							; at most one message per device onto the wire buffer, no sooner than that
      5  0b14							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0b14							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0b14							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0b14							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0b14							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0b14
     11  0b14				   MidiInit
     12  0b14					      subroutine
     13  0b14		       a9 03		      lda	#ACIA_RESET
     14  0b16		       8d 04 de 	      sta	ACIA_CTRL
     15  0b19		       a9 16		      lda	#ACIA_MODE
     16  0b1b		       8d 04 de 	      sta	ACIA_CTRL
     17  0b1e							; (fall into the test)
     18  0b1e
     19  0b1e							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0b1e							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0b1e							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0b1e							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0b1e							; before. Interrupts are off when this is called.
     24  0b1e				   MidiIrqTest
     25  0b1e					      subroutine
     26  0b1e		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0b20		       8d 0d dc 	      sta	CIA1_ICR
     28  0b23		       ad 0d dc 	      lda	CIA1_ICR
     29  0b26		       a9 6e		      lda	#<IrqTest
     30  0b28		       8d fe ff 	      sta	$FFFE
     31  0b2b		       a9 0b		      lda	#>IrqTest
     32  0b2d		       8d ff ff 	      sta	$FFFF
     33  0b30		       a9 00		      lda	#0
     34  0b32		       85 2f		      sta	midiIrq
     35  0b34		       a9 b6		      lda	#ACIA_MODE_TX
     36  0b36		       8d 04 de 	      sta	ACIA_CTRL
