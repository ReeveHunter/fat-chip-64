------- FILE drums.asm LEVEL 2 PASS 3
      0  4c3f					      include	"drums.asm"
      1  4c3f							; Fat Chip 64 - drums on the MidiNES
      2  4c3f							;
      3  4c3f							; Two sources, one kit:
      4  4c3f							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  4c3f							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  4c3f							;			   64 = hit, 56 = ghost)
      7  4c3f							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  4c3f							;			   RETURN starts / stops it, at its own tempo (B taps
      9  4c3f							;			   a new one)
     10  4c3f							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  4c3f							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  4c3f							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  4c3f							; a note-on, then a note-off after the sound's length, the level set with
     14  4c3f							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  4c3f							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  4c3f
     17  4c3f		       00 0c	   KIT_SIZE   equ	12
     18  4c3f		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  4c3f		       00 00	   DK_KICK    equ	0
     20  4c3f		       00 01	   DK_SNARE   equ	1
     21  4c3f		       00 02	   DK_CH      equ	2
     22  4c3f		       00 03	   DK_OH      equ	3
     23  4c3f		       00 04	   DK_CY      equ	4
     24  4c3f		       00 05	   DK_TOM     equ	5
     25  4c3f		       00 06	   DK_PERC    equ	6
     26  4c3f
     27  4c3f							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  4c3f				   DrumHit
     29  4c3f					      subroutine
     30  4c3f		       8d 83 c4 	      sta	drumKind
     31  4c42		       8e 82 c4 	      stx	drumLvl
     32  4c45		       8c 84 c4 	      sty	drumTom
