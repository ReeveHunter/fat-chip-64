     41  279e		       e0 14		      cpx	#NUM_ACTS
     42  27a0		       90 02		      bcc	SpaceSet
     43  27a2		       a2 00		      ldx	#0
     44  27a4				   SpaceSet
     45  27a4		       8e d3 c3 	      stx	spaceAct	; (one held now ends with its own action: spaceHeld)
     46  27a7		       4c c0 13 	      jmp	Dirty
     47  27aa
     48  27aa							; Main loop, every pass.
     49  27aa				   BendTick
     50  27aa					      subroutine
     51  27aa							; nothing bending, nothing to undo: just keep the clock (quick pass)
     52  27aa		       ad d4 c3 	      lda	bendLvl
