      0  2309					      include	"arp.asm"
      1  2309							; Fat Chip 64 - tempo and arpeggiator
      2  2309							;
      3  2309							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  2309							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  2309							;
      6  2309							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  2309							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  2309							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  2309							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  2309							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  2309							;	     until its voice's next turn.
     12  2309							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  2309							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  2309							;   J faster; either one also picks FREE).
     15  2309							;
     16  2309							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  2309							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  2309
     19  2309							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  2309							; between the two bytes: $22FF read as $23FF)
     21  2309				   GetTicks
     22  2309					      subroutine
     23  2309		       08		      php
     24  230a		       78		      sei
     25  230b		       a5 10		      lda	ticks
     26  230d		       8d 3f c3 	      sta	nowL
     27  2310		       a5 11		      lda	ticks+1
     28  2312		       8d 40 c3 	      sta	nowH
     29  2315		       28		      plp
     30  2316		       60		      rts
     31  2317
