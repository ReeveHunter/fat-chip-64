------- FILE main.asm
------- FILE drums.asm LEVEL 2 PASS 3
      0  460a					      include	"drums.asm"
      1  460a							; Fat Chip 64 - drums on the MidiNES
      2  460a							;
      3  460a							; Two sources, one kit:
      4  460a							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  460a							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  460a							;			   64 = hit, 56 = ghost)
      7  460a							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  460a							;			   RETURN starts / stops it, at its own tempo (B taps
      9  460a							;			   a new one)
     10  460a							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  460a							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  460a							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  460a							; a note-on, then a note-off after the sound's length, the level set with
     14  460a							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  460a							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  460a
     17  460a		       00 0c	   KIT_SIZE   equ	12
     18  460a		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  460a		       00 00	   DK_KICK    equ	0
     20  460a		       00 01	   DK_SNARE   equ	1
     21  460a		       00 02	   DK_CH      equ	2
     22  460a		       00 03	   DK_OH      equ	3
     23  460a		       00 04	   DK_CY      equ	4
     24  460a		       00 05	   DK_TOM     equ	5
     25  460a		       00 06	   DK_PERC    equ	6
     26  460a
     27  460a							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  460a				   DrumHit
     29  460a					      subroutine
     30  460a		       8d 82 c4 	      sta	drumKind
     31  460d		       8e 81 c4 	      stx	drumLvl
     32  4610		       8c 83 c4 	      sty	drumTom
     33  4613		       c9 00		      cmp	#DK_KICK
     34  4615		       d0 05		      bne	.nk
     35  4617		       a9 01		      lda	#1
     36  4619		       8d 3f c6 	      sta	vizKick	; (the visualizer's border flash)
     37  461c				   .nk
     38  461c		       ad 27 c3 	      lda	devOn+DEV_NES
     39  461f		       d0 01		      bne	.on
     40  4621		       60		      rts
     41  4622				   .on
     42  4622		       20 c7 1e 	      jsr	GetTicks
     43  4625		       ad 82 c4 	      lda	drumKind
     44  4628		       c9 02		      cmp	#DK_CH
     45  462a		       90 07		      bcc	.dmc
     46  462c		       c9 05		      cmp	#DK_TOM
     47  462e		       b0 03		      bcs	.dmc
     48  4630		       4c e5 46 	      jmp	NoiseHit
     49  4633				   .dmc
     50  4633		       ae 82 c4 	      ldx	drumKind
     51  4636		       bd cc 46 	      lda	dmcPrioT,x
     52  4639		       85 24		      sta	t0
     53  463b		       ad 3e c3 	      lda	nowL
     54  463e		       38		      sec
     55  463f		       ed 79 c4 	      sbc	dmcAt
     56  4642		       a8		      tay
     57  4643		       ad 3f c3 	      lda	nowH
     58  4646		       ed 7a c4 	      sbc	dmcAt+1
     59  4649		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  464b		       c0 0c		      cpy	#DRUM_WINDOW
     61  464d		       b0 08		      bcs	.ok
     62  464f		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     63  4651		       cd 78 c4 	      cmp	dmcPrio
     64  4654		       90 01		      bcc	.ok
     65  4656		       60		      rts
     66  4657				   .ok
