------- FILE nesfx.asm LEVEL 2 PASS 3
      0  7ffd					      include	"nesfx.asm"
      1  7ffd							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7ffd							;
      3  7ffd							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7ffd							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7ffd							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7ffd							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7ffd							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7ffd							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7ffd							;   glide    a new note starts bent back to the voice's last note and slides
     10  7ffd							;	      in the way the SID's does (all three channels)
     11  7ffd							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7ffd							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7ffd							; semitone, so these are a little stepped.
     14  7ffd
     15  7ffd		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7ffd							;  (the pulses, and the triangle while it glides)
     17  7ffd
     18  7ffd							; A = 1 (not Z) when a NesFxTick step is due
     19  7ffd				   NesFxDue
     20  7ffd					      subroutine
     21  7ffd		       ad 2b c3 	      lda	devOn+DEV_NES
     22  8000		       f0 1c		      beq	.x
     23  8002		       ad 0b c6 	      lda	vibDepth
     24  8005		       0d 39 c5 	      ora	nfxGlide
     25  8008		       0d 3a c5 	      ora	nfxRun
     26  800b		       0d f3 c9 	      ora	nfxWarb
     27  800e		       f0 0e		      beq	.x
     28  8010		       a5 10		      lda	ticks
     29  8012		       38		      sec
     30  8013		       ed 35 c5 	      sbc	nfxLast
     31  8016		       c9 08		      cmp	#NFX_EVERY
     32  8018		       a9 00		      lda	#0
     33  801a		       90 02		      bcc	.x
     34  801c		       a9 01		      lda	#1
     35  801e				   .x
     36  801e		       60		      rts
     37  801f
     38  801f							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     39  801f							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     40  801f							; quick return.
     41  801f				   NesFxTick
     42  801f					      subroutine
     43  801f		       ad 2b c3 	      lda	devOn+DEV_NES
     44  8022		       f0 0e		      beq	.q
