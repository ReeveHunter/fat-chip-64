    370  0aef							;------------------------------------------------------------- interrupts
    371  0aef							; Every 1/4 ms: take a MIDI-in byte, feed the ACIA one byte (fast path).
    372  0aef							; Every fourth time (1 ms):
    373  0aef							; count a tick and move paced messages onto the wire.
    374  0aef				   Irq
    375  0aef					      subroutine
    376  0aef		       48		      pha
    377  0af0		       8a		      txa
    378  0af1		       48		      pha
    379  0af2		       ad 0d dc 	      lda	CIA1_ICR	; acknowledge
    380  0af5		       ad 06 de 	      lda	ACIA_STAT	; MIDI in: a received byte? (quick check inline)
    381  0af8		       4a		      lsr
    382  0af9		       90 03		      bcc	.noRx
    383  0afb		       20 53 32 	      jsr	RxGot
    384  0afe				   .noRx
    385  0afe		       a6 16		      ldx	wireTail
    386  0b00		       e4 15		      cpx	wireHead
    387  0b02		       f0 0f		      beq	.noByte
    388  0b04		       ad 06 de 	      lda	ACIA_STAT
    389  0b07		       29 02		      and	#ACIA_TDRE
    390  0b09		       f0 08		      beq	.noByte
    391  0b0b		       bd 00 c0 	      lda	wireBuf,x
    392  0b0e		       8d 05 de 	      sta	ACIA_TX
    393  0b11		       e6 16		      inc	wireTail
    394  0b13				   .noByte
    395  0b13		       c6 2d		      dec	subTick
    396  0b15		       10 17		      bpl	.out
    397  0b17		       a9 03		      lda	#3
    398  0b19		       85 2d		      sta	subTick
    399  0b1b		       98		      tya
    400  0b1c		       48		      pha
    401  0b1d		       e6 10		      inc	ticks
    402  0b1f		       d0 02		      bne	.t
    403  0b21		       e6 11		      inc	ticks+1
    404  0b23				   .t
    405  0b23		       20 2e 0c 	      jsr	Schedule
    406  0b26		       20 09 0c 	      jsr	TxByte	; start a just-scheduled message now if the ACIA is free
    407  0b29		       20 4d 32 	      jsr	RxByte	; (again: this pass was long, a byte may be in)
    408  0b2c		       68		      pla
    409  0b2d		       a8		      tay
    410  0b2e				   .out
    411  0b2e		       68		      pla
    412  0b2f		       aa		      tax
    413  0b30		       68		      pla
    414  0b31		       40		      rti
    415  0b32
    416  0b32							; With the MIDI chip's interrupts (midiIrq, v0.16): the chip interrupts when
    417  0b32							; a byte has come in or the next can go out; the CIA timer ticks each ms.
    418  0b32				   IrqMidi
    419  0b32					      subroutine
    420  0b32		       48		      pha
    421  0b33		       8a		      txa
    422  0b34		       48		      pha
    423  0b35		       ad 06 de 	      lda	ACIA_STAT
    424  0b38		       10 23		      bpl	.tim	; (not the MIDI chip)
    425  0b3a		       4a		      lsr		; a byte in?
    426  0b3b		       90 03		      bcc	.tx
    427  0b3d		       20 53 32 	      jsr	RxGot
    428  0b40				   .tx
    429  0b40		       ad 06 de 	      lda	ACIA_STAT
    430  0b43		       29 02		      and	#ACIA_TDRE
    431  0b45		       f0 16		      beq	.tim
    432  0b47		       a6 16		      ldx	wireTail
    433  0b49		       e4 15		      cpx	wireHead
    434  0b4b		       f0 0b		      beq	.quiet
    435  0b4d		       bd 00 c0 	      lda	wireBuf,x
    436  0b50		       8d 05 de 	      sta	ACIA_TX
    437  0b53		       e6 16		      inc	wireTail
    438  0b55		       4c 5d 0b 	      jmp	.tim
    439  0b58				   .quiet
    440  0b58		       a9 96		      lda	#ACIA_MODE_RX	; nothing to send: no more "ready" interrupts
    441  0b5a		       8d 04 de 	      sta	ACIA_CTRL
    442  0b5d				   .tim
    443  0b5d		       ad 0d dc 	      lda	CIA1_ICR	; the 1 ms tick?
    444  0b60		       4a		      lsr
    445  0b61		       90 16		      bcc	.out
    446  0b63		       98		      tya
    447  0b64		       48		      pha
    448  0b65		       e6 10		      inc	ticks
    449  0b67		       d0 02		      bne	.t
    450  0b69		       e6 11		      inc	ticks+1
    451  0b6b				   .t
    452  0b6b		       20 2e 0c 	      jsr	Schedule
    453  0b6e		       20 4d 32 	      jsr	RxByte	; (a long tick: a byte may be waiting, and
    454  0b71		       20 09 0c 	      jsr	TxByte	;  the MIDI chip holds only one)
    455  0b74		       20 4d 32 	      jsr	RxByte
    456  0b77		       68		      pla
    457  0b78		       a8		      tay
    458  0b79				   .out
    459  0b79		       68		      pla
    460  0b7a		       aa		      tax
    461  0b7b		       68		      pla
    462  0b7c		       40		      rti
    463  0b7d
    464  0b7d							; RESTORE: the only NMI source. Count presses; the main loop acts on them.
    465  0b7d							; (A MIDI chip wired to NMI instead could fire one during MidiIrqTest: that
    466  0b7d							; isn't a press.)
    467  0b7d				   Nmi
    468  0b7d					      subroutine
    469  0b7d		       48		      pha
    470  0b7e		       ad 06 de 	      lda	ACIA_STAT
    471  0b81		       10 07		      bpl	.r
    472  0b83		       a9 16		      lda	#ACIA_MODE
    473  0b85		       8d 04 de 	      sta	ACIA_CTRL
    474  0b88		       68		      pla
    475  0b89		       40		      rti
    476  0b8a				   .r
    477  0b8a		       ad 0d dd 	      lda	CIA2_ICR	; acknowledge anything CIA 2 holds, so the NMI
    478  0b8d							; line is free for the next RESTORE edge
    479  0b8d		       e6 1d		      inc	nmiCount
    480  0b8f		       a5 10		      lda	ticks
    481  0b91		       85 1e		      sta	nmiTick
    482  0b93		       a5 11		      lda	ticks+1
    483  0b95		       85 1f		      sta	nmiTick+1
    484  0b97		       68		      pla
    485  0b98		       40		      rti
