    200  0b74							; ------------------------------------------------------------ queueing (main loop)
    201  0b74							; Message in mS / mD1 / mD2. Dropped if the queue is full (63 messages).
    202  0b74				   GbPut
    203  0b74					      subroutine
    204  0b74							; write the slot at head first (always free: one slot stays empty),
    205  0b74							; then publish head unless the queue is full. Uses only A and X.
