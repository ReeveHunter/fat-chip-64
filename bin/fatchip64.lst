      0  6123					      include	"menu.asm"
      1  6123							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  6123							;
      3  6123							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  6123							;   page   RETURN opens a page
      5  6123							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  6123							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  6123							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  6123							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  6123							; device pages, until DEVICES says the device is in use).
     10  6123							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  6123							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  6123							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  6123
     14  6123		       00 17	   MENU_VALCOL equ	23
     15  6123
