------- FILE midi.asm LEVEL 2 PASS 2
      0  09c5					      include	"midi.asm"
      1  09c5							; Fat Chip 64 - MIDI out
      2  09c5							;
      3  09c5							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  09c5							; at most one message per device onto the wire buffer, no sooner than that
      5  09c5							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  09c5							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  09c5							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  09c5							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  09c5							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  09c5
     11  09c5				   MidiInit
     12  09c5					      subroutine
     13  09c5		       a9 03		      lda	#ACIA_RESET
     14  09c7		       8d 04 de 	      sta	ACIA_CTRL
     15  09ca		       a9 16		      lda	#ACIA_MODE
     16  09cc		       8d 04 de 	      sta	ACIA_CTRL
     17  09cf		       60		      rts
     18  09d0
     19  09d0							; IRQ: send one wire byte if the ACIA is ready.
     20  09d0				   TxByte
     21  09d0					      subroutine
     22  09d0		       a6 15		      ldx	wireTail
     23  09d2		       e4 14		      cpx	wireHead
     24  09d4		       f0 0f		      beq	.done
     25  09d6		       ad 06 de 	      lda	ACIA_STAT
     26  09d9		       29 02		      and	#ACIA_TDRE
     27  09db		       f0 08		      beq	.done
     28  09dd		       bd 00 c0 	      lda	wireBuf,x
     29  09e0		       8d 05 de 	      sta	ACIA_TX
     30  09e3		       e6 15		      inc	wireTail
     31  09e5				   .done
     32  09e5		       60		      rts
     33  09e6
     34  09e6							; Main loop: same, with interrupts off around it.
     35  09e6				   TxService
     36  09e6					      subroutine
     37  09e6		       08		      php
     38  09e7		       78		      sei
     39  09e8		       20 d0 09 	      jsr	TxByte
     40  09eb		       28		      plp
     41  09ec		       60		      rts
     42  09ed
     43  09ed							; IRQ: pace device queues onto the wire.
     44  09ed							;
     45  09ed							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
     46  09ed							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
     47  09ed							; times as signed numbers, so after 33 s of silence every queue froze for
     48  09ed							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
     49  09ed							;
     50  09ed							; When the Game Boy is on, everything on the wire also passes through the
     51  09ed							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
     52  09ed							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
     53  09ed							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
     54  09ed							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
     55  09ed							; message, the rate measured clean.
     56  09ed				   Schedule
     57  09ed					      subroutine
     58  09ed		       ad 0e c3 	      lda	devOn+DEV_GB
     59  09f0		       f0 10		      beq	.gb
     60  09f2		       a5 2d		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
     61  09f4		       f0 0c		      beq	.gb
     62  09f6		       c6 2d		      dec	linkLoad
     63  09f8		       f0 08		      beq	.gb
     64  09fa		       a5 10		      lda	ticks
     65  09fc		       29 01		      and	#1
     66  09fe		       f0 02		      beq	.gb
     67  0a00		       c6 2d		      dec	linkLoad
     68  0a02				   .gb
     69  0a02							; ---- Game Boy
     70  0a02		       a5 17		      lda	gbqTail
     71  0a04		       c5 16		      cmp	gbqHead
     72  0a06		       f0 36		      beq	.nes
     73  0a08		       a5 18		      lda	gbNext
     74  0a0a		       38		      sec
     75  0a0b		       e5 10		      sbc	ticks
     76  0a0d		       f0 04		      beq	.gbDue
     77  0a0f		       c9 04		      cmp	#GB_GAP+1
     78  0a11		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
     79  0a13				   .gbDue
     80  0a13							; only onto an empty wire, so the gap holds on the cable itself (NES
     81  0a13							; bytes already waiting would otherwise delay this one and squeeze it
     82  0a13							; against the next)
     83  0a13		       a5 14		      lda	wireHead
     84  0a15		       c5 15		      cmp	wireTail
     85  0a17		       d0 25		      bne	.nes
     86  0a19		       20 7c 0a 	      jsr	LinkRoom
     87  0a1c		       90 20		      bcc	.nes
     88  0a1e		       a6 17		      ldx	gbqTail
     89  0a20		       bd 00 c1 	      lda	gbqS,x
     90  0a23		       bc 80 c1 	      ldy	gbqD2,x
     91  0a26		       84 2b		      sty	irqT
     92  0a28		       bc 40 c1 	      ldy	gbqD1,x
     93  0a2b		       20 98 0a 	      jsr	WireMsg
     94  0a2e		       a5 17		      lda	gbqTail
     95  0a30		       18		      clc
     96  0a31		       69 01		      adc	#1
     97  0a33		       29 3f		      and	#63
     98  0a35		       85 17		      sta	gbqTail
     99  0a37		       a5 10		      lda	ticks
    100  0a39		       18		      clc
    101  0a3a		       69 03		      adc	#GB_GAP
    102  0a3c		       85 18		      sta	gbNext
    103  0a3e				   .nes
    104  0a3e		       a5 1a		      lda	nesqTail
    105  0a40		       c5 19		      cmp	nesqHead
    106  0a42		       f0 37		      beq	.done
    107  0a44		       a5 1b		      lda	nesNext
    108  0a46		       38		      sec
    109  0a47		       e5 10		      sbc	ticks
    110  0a49		       f0 04		      beq	.nesDue
    111  0a4b		       c9 02		      cmp	#NES_GAP+1
    112  0a4d		       90 2c		      bcc	.done
    113  0a4f				   .nesDue
    114  0a4f		       20 8f 0a 	      jsr	WireFree
    115  0a52		       c9 03		      cmp	#3
    116  0a54		       90 25		      bcc	.done
    117  0a56		       20 7c 0a 	      jsr	LinkRoom
    118  0a59		       90 20		      bcc	.done
    119  0a5b		       a6 1a		      ldx	nesqTail
    120  0a5d		       bd c0 c1 	      lda	nesqS,x
    121  0a60		       bc 40 c2 	      ldy	nesqD2,x
    122  0a63		       84 2b		      sty	irqT
    123  0a65		       bc 00 c2 	      ldy	nesqD1,x
    124  0a68		       20 98 0a 	      jsr	WireMsg
    125  0a6b		       a5 1a		      lda	nesqTail
    126  0a6d		       18		      clc
    127  0a6e		       69 01		      adc	#1
    128  0a70		       29 3f		      and	#63
    129  0a72		       85 1a		      sta	nesqTail
    130  0a74		       a5 10		      lda	ticks
    131  0a76		       18		      clc
    132  0a77		       69 01		      adc	#NES_GAP
    133  0a79		       85 1b		      sta	nesNext
    134  0a7b				   .done
    135  0a7b		       60		      rts
    136  0a7c
    137  0a7c							; Carry set if the Teensyboy has room for a message (always, with the Game
    138  0a7c							; Boy off), and counts it.
    139  0a7c				   LinkRoom
    140  0a7c					      subroutine
    141  0a7c		       ad 0e c3 	      lda	devOn+DEV_GB
    142  0a7f		       f0 0a		      beq	.yes
    143  0a81		       a5 2d		      lda	linkLoad
    144  0a83		       c9 2d		      cmp	#LINK_MAX
    145  0a85		       b0 06		      bcs	.no
    146  0a87		       69 03		      adc	#3
    147  0a89		       85 2d		      sta	linkLoad
    148  0a8b				   .yes
    149  0a8b		       38		      sec
    150  0a8c		       60		      rts
    151  0a8d				   .no
    152  0a8d		       18		      clc
    153  0a8e		       60		      rts
    154  0a8f
    155  0a8f							; A = free bytes in the wire ring
    156  0a8f				   WireFree
    157  0a8f					      subroutine
    158  0a8f		       a5 15		      lda	wireTail
    159  0a91		       38		      sec
    160  0a92		       e5 14		      sbc	wireHead
    161  0a94		       38		      sec
    162  0a95		       e9 01		      sbc	#1
    163  0a97		       60		      rts
    164  0a98
    165  0a98							; Put a message on the wire (IRQ only): A = status, Y = data 1, irqT = data 2.
    166  0a98							; Program change / channel pressure have one data byte.
    167  0a98				   WireMsg
    168  0a98					      subroutine
    169  0a98		       c5 13		      cmp	lastStatus
    170  0a9a		       f0 05		      beq	.rs
    171  0a9c		       85 13		      sta	lastStatus
    172  0a9e		       20 bb 0a 	      jsr	WirePut
    173  0aa1				   .rs
    174  0aa1		       98		      tya
    175  0aa2		       20 bb 0a 	      jsr	WirePut
    176  0aa5		       a5 13		      lda	lastStatus
    177  0aa7		       29 e0		      and	#$E0
    178  0aa9		       c9 c0		      cmp	#$C0	; $Cx and $Dx: one data byte
