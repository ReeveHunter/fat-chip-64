     21  3022		       00 02	   DK_CH      equ	2
     22  3022		       00 03	   DK_OH      equ	3
     23  3022		       00 04	   DK_CY      equ	4
     24  3022		       00 05	   DK_TOM     equ	5
     25  3022		       00 06	   DK_PERC    equ	6
