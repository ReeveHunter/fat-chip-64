------- FILE screen.asm LEVEL 2 PASS 3
      0  7016					      include	"screen.asm"
      1  7016							; Fat Chip 64 - screen
      2  7016							;
      3  7016							;  row 0      header
      4  7016							;  row 2      sound, POLY / MONO, Fat Bass
      5  7016							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  7016							;	       each plays (row 7: a channel overlap warning)
      7  7016							;  row 9      key, notes mode, latch
      8  7016							;  row 10     arp
      9  7016							;  row 12     tempo, beat, mute
     10  7016							;  row 13     SPACE's action, octave (the lowest key), transpose
     11  7016							;  row 14     v0.40: the effect the C= keys work on, its setting
     12  7016							;  row 15     held notes
     13  7016							;  row 16     MIDI in
     14  7016							;  row 24     F keys
     15  7016
