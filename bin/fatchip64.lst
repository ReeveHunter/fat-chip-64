      0  5eef					      include	"patchedit.asm"
      1  5eef							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  5eef							; the dice. The settings and their steps come from tools/gen_menu.py
      3  5eef							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  5eef							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  5eef							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  5eef							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  5eef							; (EnvDerive).
      8  5eef
      9  5eef		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  5eef		       00 30	   LFO_LAST   equ	FLD_gbLDelay
     11  5eef
     12  5eef							; X = param -> A = the step the live patch is nearest to
     13  5eef				   ParamNearest
     14  5eef					      subroutine
     15  5eef		       8e 20 c8 	      stx	pnP
