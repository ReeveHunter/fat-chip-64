    104  0c4d							; IRQ: pace device queues onto the wire.
    105  0c4d							;
    106  0c4d							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    107  0c4d							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    108  0c4d							; times as signed numbers, so after 33 s of silence every queue froze for
    109  0c4d							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    110  0c4d							;
    111  0c4d							; When the Game Boy is on, everything on the wire also passes through the
    112  0c4d							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    113  0c4d							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    114  0c4d							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    115  0c4d							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    116  0c4d							; message, the rate measured clean.
    117  0c4d				   Schedule
    118  0c4d					      subroutine
    119  0c4d		       ad ea c7 	      lda	devOn+DEV_GB
    120  0c50		       f0 10		      beq	.gb
    121  0c52		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    122  0c54		       f0 0c		      beq	.gb
    123  0c56		       c6 2e		      dec	linkLoad
    124  0c58		       f0 08		      beq	.gb
    125  0c5a		       a5 10		      lda	ticks
    126  0c5c		       29 01		      and	#1
    127  0c5e		       f0 02		      beq	.gb
    128  0c60		       c6 2e		      dec	linkLoad
    129  0c62				   .gb
    130  0c62							; ---- Game Boy
    131  0c62		       a5 18		      lda	gbqTail
    132  0c64		       c5 17		      cmp	gbqHead
    133  0c66		       f0 3d		      beq	.nes
    134  0c68		       a5 19		      lda	gbNext
    135  0c6a		       38		      sec
    136  0c6b		       e5 10		      sbc	ticks
    137  0c6d		       f0 04		      beq	.gbDue
    138  0c6f		       c9 04		      cmp	#GB_GAP+1
    139  0c71		       90 32		      bcc	.nes	; 1..GB_GAP ms to go
    140  0c73				   .gbDue
    141  0c73							; only onto an empty wire, so the gap holds on the cable itself (NES
    142  0c73							; bytes already waiting would otherwise delay this one and squeeze it
    143  0c73							; against the next). While a Game Boy message is due, the NES doesn't
    144  0c73							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    145  0c73							; holding its notes back.
    146  0c73		       20 72 3a 	      jsr	RxByte	; (v0.66: MIDI in now too: the Game Boy's message
    147  0c76							;  and the NES's after it outlast a byte's time)
    148  0c76		       a5 15		      lda	wireHead
    149  0c78		       c5 16		      cmp	wireTail
    150  0c7a		       d0 69		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    151  0c7c		       20 e6 0c 	      jsr	LinkRoom
    152  0c7f		       90 24		      bcc	.nes
    153  0c81		       a9 ff		      lda	#$FF	; v0.64: every Game Boy message carries its status
    154  0c83		       85 14		      sta	lastStatus	; byte (no running status): the link drops a byte
    155  0c85		       a6 18		      ldx	gbqTail	; now and then, and in a run of nothing but drum
    156  0c87		       bd 00 c5 	      lda	gbqS,x	; notes that left every later note out of step
    157  0c8a		       bc 00 c6 	      ldy	gbqD2,x
    158  0c8d		       84 2c		      sty	irqT
    159  0c8f		       bc 80 c5 	      ldy	gbqD1,x
    160  0c92		       20 02 0d 	      jsr	WireMsg
    161  0c95		       a5 18		      lda	gbqTail
    162  0c97		       18		      clc
    163  0c98		       69 01		      adc	#1
    164  0c9a		       29 7f		      and	#127
    165  0c9c		       85 18		      sta	gbqTail
    166  0c9e		       a5 10		      lda	ticks
    167  0ca0		       18		      clc
    168  0ca1		       69 03		      adc	#GB_GAP
    169  0ca3		       85 19		      sta	gbNext
    170  0ca5				   .nes
    171  0ca5		       20 72 3a 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    172  0ca8		       a5 1b		      lda	nesqTail
    173  0caa		       c5 1a		      cmp	nesqHead
    174  0cac		       f0 37		      beq	.done
    175  0cae		       a5 1c		      lda	nesNext
    176  0cb0		       38		      sec
    177  0cb1		       e5 10		      sbc	ticks
    178  0cb3		       f0 04		      beq	.nesDue
    179  0cb5		       c9 02		      cmp	#NES_GAP+1
    180  0cb7		       90 2c		      bcc	.done
    181  0cb9				   .nesDue
    182  0cb9		       20 f9 0c 	      jsr	WireFree
    183  0cbc		       c9 03		      cmp	#3
    184  0cbe		       90 25		      bcc	.done
    185  0cc0		       20 e6 0c 	      jsr	LinkRoom
    186  0cc3		       90 20		      bcc	.done
    187  0cc5		       a6 1b		      ldx	nesqTail
    188  0cc7		       bd 80 c6 	      lda	nesqS,x
    189  0cca		       bc 00 c7 	      ldy	nesqD2,x
    190  0ccd		       84 2c		      sty	irqT
    191  0ccf		       bc c0 c6 	      ldy	nesqD1,x
    192  0cd2		       20 02 0d 	      jsr	WireMsg
    193  0cd5		       a5 1b		      lda	nesqTail
    194  0cd7		       18		      clc
    195  0cd8		       69 01		      adc	#1
    196  0cda		       29 3f		      and	#63
    197  0cdc		       85 1b		      sta	nesqTail
    198  0cde		       a5 10		      lda	ticks
    199  0ce0		       18		      clc
    200  0ce1		       69 01		      adc	#NES_GAP
    201  0ce3		       85 1c		      sta	nesNext
    202  0ce5				   .done
    203  0ce5		       60		      rts
