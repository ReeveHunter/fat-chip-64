    351  2dcf
    352  2dcf							; ------------------------------------------------------------ SysEx: a patch from Chip Lab (v0.20)
    353  2dcf							; F0 7D 46 43 01 PATCH_SIZE, then the patch (PATCH_SIZE bytes, the live patch's layout:
    354  2dcf							; tools/gen_patches.py) as two 4-bit halves each, high first, then F7. It
    355  2dcf							; arrives in sxBuf; only a complete one goes into the live patch, which then
    356  2dcf							; sounds at once (like choosing a sound). Anything else is ignored.
    357  2dcf		       00 05	   SX_HEAD    equ	5
    358  2dcf		       00 ab	   SX_LEN     equ	SX_HEAD + PATCH_SIZE * 2
    359  2dcf
    360  2dcf							; A status byte in A (F0-F7); keeps A
    361  2dcf				   SysexStatus
    362  2dcf					      subroutine
    363  2dcf		       c9 f0		      cmp	#$F0
    364  2dd1		       d0 0b		      bne	.end
    365  2dd3		       a2 01		      ldx	#1
    366  2dd5		       8e 4d c7 	      stx	sxOn
    367  2dd8		       a2 00		      ldx	#0
    368  2dda		       8e 4e c7 	      stx	sxPos
    369  2ddd		       60		      rts
    370  2dde				   .end
    371  2dde		       ae 4d c7 	      ldx	sxOn
    372  2de1		       f0 15		      beq	.x
    373  2de3		       a2 00		      ldx	#0
    374  2de5		       8e 4d c7 	      stx	sxOn
    375  2de8		       c9 f7		      cmp	#$F7
    376  2dea		       d0 0c		      bne	.x
    377  2dec		       ae 4e c7 	      ldx	sxPos
    378  2def		       e0 ab		      cpx	#SX_LEN
    379  2df1		       d0 05		      bne	.x
    380  2df3		       48		      pha
    381  2df4		       20 39 2e 	      jsr	PatchReceived
    382  2df7		       68		      pla
    383  2df8				   .x
    384  2df8		       60		      rts
    385  2df9
    386  2df9							; A data byte (A) inside a SysEx
    387  2df9				   SysexByte
    388  2df9					      subroutine
    389  2df9		       ae 4e c7 	      ldx	sxPos
    390  2dfc		       e0 05		      cpx	#SX_HEAD
    391  2dfe		       b0 09		      bcs	.body
    392  2e00		       dd 34 2e 	      cmp	sxHead,x	; the header must match, or the rest is ignored
    393  2e03		       d0 29		      bne	.no
    394  2e05		       ee 4e c7 	      inc	sxPos
    395  2e08		       60		      rts
    396  2e09				   .body
    397  2e09		       e0 ab		      cpx	#SX_LEN
    398  2e0b		       b0 21		      bcs	.no	; too long
    399  2e0d		       48		      pha
    400  2e0e		       8a		      txa
    401  2e0f		       38		      sec
    402  2e10		       e9 05		      sbc	#SX_HEAD
    403  2e12		       4a		      lsr
    404  2e13		       a8		      tay		; byte number
    405  2e14		       68		      pla
    406  2e15		       29 0f		      and	#15
    407  2e17		       b0 0b		      bcs	.lo
    408  2e19		       0a		      asl
    409  2e1a		       0a		      asl
    410  2e1b		       0a		      asl
    411  2e1c		       0a		      asl
    412  2e1d		       99 cd c6 	      sta	sxBuf,y
    413  2e20		       ee 4e c7 	      inc	sxPos
    414  2e23		       60		      rts
    415  2e24				   .lo
    416  2e24		       19 cd c6 	      ora	sxBuf,y
    417  2e27		       99 cd c6 	      sta	sxBuf,y
    418  2e2a		       ee 4e c7 	      inc	sxPos
    419  2e2d		       60		      rts
    420  2e2e				   .no
    421  2e2e		       a9 00		      lda	#0
    422  2e30		       8d 4d c7 	      sta	sxOn
    423  2e33		       60		      rts
    424  2e34		       7d 46 43 01*sxHead     .byte.b	$7D, $46, $43, $01, PATCH_SIZE	; (the size: a Chip Lab with another layout is ignored)
    425  2e39
    426  2e39							; the received patch -> the live patch, heard at once
    427  2e39				   PatchReceived
    428  2e39					      subroutine
    429  2e39		       20 b5 2e 	      jsr	SoundRelease
    430  2e3c		       a0 52		      ldy	#PATCH_SIZE-1
