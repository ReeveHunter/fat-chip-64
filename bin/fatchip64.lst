    475  464b							; ------------------------------------------------------------ actions
    476  464b							; What SPACE and the keytar's buttons do (menu: SPACE, ... BUTTON):
    477  464b							;   held     MUTE, BEND DOWN, BEND UP, VIBRATO, TREMOLO, ARP, STUTTER,
    478  464b							;	      VINYL STOP, GLIDE, SUSTAIN, OCTAVE UP, REPEAT, FILTER SWEEP,
    479  464b							;	      BEAT FILL, TAPE WOBBLE, WIDE
