------- FILE midi.asm LEVEL 2 PASS 3
      0  0b6e					      include	"midi.asm"
      1  0b6e							; Fat Chip 64 - MIDI out
      2  0b6e							;
      3  0b6e							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0b6e							; at most one message per device onto the wire buffer, no sooner than that
      5  0b6e							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0b6e							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0b6e							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0b6e							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0b6e							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0b6e
     11  0b6e				   MidiInit
     12  0b6e					      subroutine
     13  0b6e		       a9 03		      lda	#ACIA_RESET
     14  0b70		       8d 04 de 	      sta	ACIA_CTRL
     15  0b73		       a9 16		      lda	#ACIA_MODE
     16  0b75		       8d 04 de 	      sta	ACIA_CTRL
     17  0b78							; (fall into the test)
     18  0b78
     19  0b78							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0b78							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0b78							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0b78							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0b78							; before. Interrupts are off when this is called.
     24  0b78				   MidiIrqTest
     25  0b78					      subroutine
     26  0b78		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0b7a		       8d 0d dc 	      sta	CIA1_ICR
     28  0b7d		       ad 0d dc 	      lda	CIA1_ICR
     29  0b80		       a9 c8		      lda	#<IrqTest
     30  0b82		       8d fe ff 	      sta	$FFFE
     31  0b85		       a9 0b		      lda	#>IrqTest
     32  0b87		       8d ff ff 	      sta	$FFFF
     33  0b8a		       a9 00		      lda	#0
     34  0b8c		       85 2f		      sta	midiIrq
     35  0b8e		       a9 b6		      lda	#ACIA_MODE_TX
     36  0b90		       8d 04 de 	      sta	ACIA_CTRL
     37  0b93		       58		      cli
     38  0b94		       a2 00		      ldx	#0
     39  0b96				   .w
     40  0b96		       ca		      dex
     41  0b97		       d0 fd		      bne	.w
     42  0b99		       78		      sei
     43  0b9a		       a6 2f		      ldx	midiIrq
     44  0b9c		       bd d4 0b 	      lda	midiCtl,x
     45  0b9f		       8d 04 de 	      sta	ACIA_CTRL
     46  0ba2		       bd d6 0b 	      lda	irqLo,x
     47  0ba5		       8d fe ff 	      sta	$FFFE
     48  0ba8		       bd d8 0b 	      lda	irqHi,x
     49  0bab		       8d ff ff 	      sta	$FFFF
     50  0bae		       bd da 0b 	      lda	latchLo,x
     51  0bb1		       8d 04 dc 	      sta	CIA1_TALO
     52  0bb4		       bd dc 0b 	      lda	latchHi,x
     53  0bb7		       8d 05 dc 	      sta	CIA1_TAHI
     54  0bba		       a9 11		      lda	#$11	; start, force load, continuous
     55  0bbc		       8d 0e dc 	      sta	CIA1_CRA
     56  0bbf		       ad 0d dc 	      lda	CIA1_ICR
     57  0bc2		       a9 81		      lda	#$81	; timer A interrupt on
     58  0bc4		       8d 0d dc 	      sta	CIA1_ICR
