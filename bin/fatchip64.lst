    134  7a51		       ad 67 cb 	      lda	sndRdropK
    135  7a54		       99 2e ce 	      sta	sK,y
    136  7a57		       a9 01		      lda	#1
    137  7a59		       99 32 ce 	      sta	rdOn,y
    138  7a5c				   .x
