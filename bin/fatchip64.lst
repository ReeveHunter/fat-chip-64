      0  294f					      include	"nesenv.asm"
      1  294f							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  294f							;
      3  294f							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  294f							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  294f							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  294f							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  294f							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  294f							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  294f							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  294f							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  294f							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  294f							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  294f							; would wrap to a high pitch).
     14  294f							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  294f
     16  294f							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  294f							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  294f							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  294f							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  294f							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  294f		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  294f		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  294f							; NES channels too, and can't take a bend every 4 ms
     24  294f		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  294f		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  294f
     27  294f							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  294f		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  2958		       02 05	   slotVoice  .byte.b	2,5
     30  295a
     31  295a							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  295a							; note keeps sounding for now). X = voice (= t0).
     33  295a				   NesSoftRelease
     34  295a					      subroutine
     35  295a		       4c 5f 29 	      jmp	.go
