      0  70ce					      include	"wander.asm"
      1  70ce							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  70ce							;
      3  70ce							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  70ce							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  70ce							;   ATTACK   as always: the new notes start
      6  70ce							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  70ce							;	      has none)
      8  70ce							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  70ce							;	      start again
     10  70ce							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  70ce							;	      late; some glide, some start again (fade out, come back in)
     12  70ce							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  70ce							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  70ce							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  70ce							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  70ce
     17  70ce		       00 01	   CHG_ATTACK equ	1
     18  70ce		       00 02	   CHG_GLIDE  equ	2
     19  70ce		       00 03	   CHG_STAGGER equ	3
     20  70ce		       00 04	   CHG_WANDER equ	4
     21  70ce		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  70ce		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  70ce
