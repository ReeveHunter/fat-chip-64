    132  7b51		       f0 20		      beq	.x
    133  7b53		       20 d6 7c 	      jsr	NesFxVal
    134  7b56		       a6 24		      ldx	t0
    135  7b58		       ad 33 c5 	      lda	nfxL
    136  7b5b		       dd df c4 	      cmp	nesFxSL,x
    137  7b5e		       d0 08		      bne	.send
    138  7b60		       ad 34 c5 	      lda	nfxH
    139  7b63		       dd e8 c4 	      cmp	nesFxSH,x
    140  7b66		       f0 0b		      beq	.x
    141  7b68				   .send
    142  7b68		       a9 01		      lda	#1
    143  7b6a		       8d 2b c5 	      sta	nfxHave	; (NesBendVoice: nfx is this voice's already)
    144  7b6d		       bd 97 c3 	      lda	vOut,x
