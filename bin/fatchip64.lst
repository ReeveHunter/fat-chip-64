------- FILE nesfx.asm LEVEL 2 PASS 3
      0  7352					      include	"nesfx.asm"
      1  7352							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7352							;
      3  7352							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7352							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7352							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7352							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7352							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7352							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7352							;   glide    a new note starts bent back to the voice's last note and slides
     10  7352							;	      in the way the SID's does (all three channels)
     11  7352							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7352							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7352							; semitone, so these are a little stepped.
     14  7352
     15  7352		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7352							;  (the pulses, and the triangle while it glides)
     17  7352
     18  7352							; A = 1 (not Z) when a NesFxTick step is due
     19  7352				   NesFxDue
     20  7352					      subroutine
     21  7352		       ad 27 c3 	      lda	devOn+DEV_NES
     22  7355		       f0 19		      beq	.x
     23  7357		       ad fe c5 	      lda	vibDepth
     24  735a		       0d 2c c5 	      ora	nfxGlide
     25  735d		       0d 2d c5 	      ora	nfxRun
     26  7360		       f0 0e		      beq	.x
     27  7362		       a5 10		      lda	ticks
     28  7364		       38		      sec
     29  7365		       ed 28 c5 	      sbc	nfxLast
     30  7368		       c9 08		      cmp	#NFX_EVERY
     31  736a		       a9 00		      lda	#0
     32  736c		       90 02		      bcc	.x
     33  736e		       a9 01		      lda	#1
     34  7370				   .x
     35  7370		       60		      rts
     36  7371
     37  7371							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  7371							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  7371							; quick return.
     40  7371				   NesFxTick
