------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  324d					      include	"midiin.asm"
      1  324d							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  324d							;
      3  324d							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  324d							; The main loop parses them (running status; realtime and system bytes are
      5  324d							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  324d							; notes mode, latch, arp and K + note.
      7  324d							;
      8  324d							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  324d							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  324d							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  324d							;
     12  324d							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  324d							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  324d							;
     15  324d							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  324d							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  324d							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  324d							; MIDI in is passed on to the Game Boy or NES.
     19  324d
     20  324d							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  324d							; Uses A, X.
     22  324d							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  324d							; with the time; a Start ($FA) makes the next clock a beat.
     24  324d				   RxByte
     25  324d					      subroutine
     26  324d		       ad 06 de 	      lda	ACIA_STAT
     27  3250		       4a		      lsr		; RDRF -> carry
     28  3251		       90 2b		      bcc	.x
     29  3253				   RxGot
     30  3253		       ad 07 de 	      lda	ACIA_RX
     31  3256		       c9 f8		      cmp	#$F8
     32  3258		       f0 25		      beq	.clk
     33  325a		       c9 fa		      cmp	#$FA
     34  325c		       d0 0e		      bne	.buf
     35  325e		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  3260		       8e e8 c5 	      stx	clkPhase
     37  3263		       8e f0 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3266							;  the main loop could measure it)
     39  3266		       ae e9 c5 	      ldx	clkBeat
     40  3269		       8e fb c5 	      stx	clkStartBeat
     41  326c				   .buf
     42  326c		       ae 24 c4 	      ldx	rxHead
     43  326f		       9d e4 c3 	      sta	rxBuf,x
     44  3272		       e8		      inx
     45  3273		       8a		      txa
     46  3274		       29 3f		      and	#63
     47  3276		       cd 25 c4 	      cmp	rxTail
     48  3279		       f0 03		      beq	.x	; full: dropped
     49  327b		       8d 24 c4 	      sta	rxHead
     50  327e				   .x
     51  327e		       60		      rts
     52  327f				   .clk
     53  327f		       ee e4 c5 	      inc	clkCount
     54  3282		       ae e8 c5 	      ldx	clkPhase
     55  3285		       e8		      inx
     56  3286		       e0 18		      cpx	#24
     57  3288		       90 1b		      bcc	.ph
     58  328a		       a5 10		      lda	ticks
     59  328c		       8d eb c5 	      sta	clkAtL
     60  328f		       a5 11		      lda	ticks+1
     61  3291		       8d ec c5 	      sta	clkAtH
     62  3294		       a5 2d		      lda	subTick
     63  3296		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  3298		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  329a		       ad 05 dc 	      lda	CIA1_TAHI
     66  329d				   .q
     67  329d		       8d ed c5 	      sta	clkAtS
     68  32a0		       ee e9 c5 	      inc	clkBeat
     69  32a3		       a2 00		      ldx	#0
     70  32a5				   .ph
     71  32a5		       8e e8 c5 	      stx	clkPhase
     72  32a8		       60		      rts
