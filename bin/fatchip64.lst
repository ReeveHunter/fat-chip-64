------- FILE voices.asm LEVEL 2 PASS 2
      0  0fcf					      include	"voices.asm"
      1  0fcf							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  0fcf							;
      3  0fcf							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  0fcf							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  0fcf							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  0fcf							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  0fcf							; Allocation, whenever the held notes change:
      8  0fcf							;   1. bass voices play the lowest note, an octave down
      9  0fcf							;   2. every other note gets one voice, lowest notes first
     10  0fcf							;   3. leftover voices stack on the lowest two notes, alternating
     11  0fcf							; So one note = a nine-voice unison across three chips, and in chords the
     12  0fcf							; bottom of the chord is fattest. Disabled devices get no notes.
     13  0fcf
     14  0fcf							; ------------------------------------------------------------ SID
     15  0fcf				   SidInit
     16  0fcf					      subroutine
     17  0fcf		       a2 18		      ldx	#24
     18  0fd1		       a9 00		      lda	#0
     19  0fd3				   .clr
     20  0fd3		       9d 00 d4 	      sta	SID,x
     21  0fd6		       ca		      dex
     22  0fd7		       10 fa		      bpl	.clr
     23  0fd9		       20 fc 0f 	      jsr	SidVolume
     24  0fdc		       a2 02		      ldx	#2
     25  0fde				   .v
     26  0fde		       bc fd 20 	      ldy	sidOfs,x
     27  0fe1		       a9 19		      lda	#$19	; attack 1, decay 9
     28  0fe3		       99 05 d4 	      sta	SID+5,y
     29  0fe6		       a9 c9		      lda	#$C9	; sustain 12, release 9
     30  0fe8		       99 06 d4 	      sta	SID+6,y
     31  0feb		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     32  0fed		       99 03 d4 	      sta	SID+3,y
     33  0ff0		       a9 20		      lda	#$20	; sawtooth, gate off
     34  0ff2		       9d 19 c3 	      sta	sidGate,x
     35  0ff5		       99 04 d4 	      sta	SID+4,y
     36  0ff8		       ca		      dex
     37  0ff9		       10 e3		      bpl	.v
