------- FILE screen.asm LEVEL 2 PASS 3
      0  7afd					      include	"screen.asm"
      1  7afd							; Fat Chip 64 - screen
      2  7afd							;
      3  7afd							;  row 0      header
      4  7afd							;  row 2      sound, POLY / MONO, Fat Bass
      5  7afd							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  7afd							;	       each plays (row 7: a channel overlap warning)
      7  7afd							;  row 9      key, notes mode, latch
      8  7afd							;  row 10     arp
      9  7afd							;  row 12     tempo, beat, mute
     10  7afd							;  row 13     SPACE's action, octave (the lowest key), transpose
     11  7afd							;  row 14     v0.40: the effect the C= keys work on, its setting
     12  7afd							;  row 15     held notes
     13  7afd							;  row 16     MIDI in
     14  7afd							;  row 24     F keys
     15  7afd
     16  7afd							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     17  7afd							; Letters become screen codes; bit 7 of t2 reverses.
     18  7afd				   PrintAt
     19  7afd					      subroutine
     20  7afd		       20 15 7b 	      jsr	ScreenAddr
     21  7b00		       a0 00		      ldy	#0
     22  7b02				   .c
     23  7b02		       b1 28		      lda	(ptr),y
     24  7b04		       f0 0e		      beq	.done
     25  7b06		       c9 40		      cmp	#64
     26  7b08		       90 03		      bcc	.noLetter
     27  7b0a		       38		      sec
     28  7b0b		       e9 40		      sbc	#64
     29  7b0d				   .noLetter
     30  7b0d		       05 26		      ora	t2
     31  7b0f		       91 2a		      sta	(ptr2),y
     32  7b11		       c8		      iny
     33  7b12		       d0 ee		      bne	.c
     34  7b14				   .done
     35  7b14		       60		      rts
     36  7b15
     37  7b15							; ptr2 = SCREEN + 40*Y + X (row table: no loop)
