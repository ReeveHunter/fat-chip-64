    137  0a64							; Carry set if the Teensyboy has room for a message (always, with the Game
    138  0a64							; Boy off), and counts it.
    139  0a64				   LinkRoom
    140  0a64					      subroutine
    141  0a64		       ad 0e c3 	      lda	devOn+DEV_GB
    142  0a67		       f0 0a		      beq	.yes
    143  0a69		       a5 2d		      lda	linkLoad
    144  0a6b		       c9 2d		      cmp	#LINK_MAX
    145  0a6d		       b0 06		      bcs	.no
    146  0a6f		       69 03		      adc	#3
    147  0a71		       85 2d		      sta	linkLoad
    148  0a73				   .yes
    149  0a73		       38		      sec
    150  0a74		       60		      rts
    151  0a75				   .no
    152  0a75		       18		      clc
    153  0a76		       60		      rts
