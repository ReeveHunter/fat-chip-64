------- FILE main.asm
------- FILE nesfx.asm LEVEL 2 PASS 3
      0  6bab					      include	"nesfx.asm"
      1  6bab							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  6bab							;
      3  6bab							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  6bab							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  6bab							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  6bab							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  6bab							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  6bab							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  6bab							;   glide    a new note starts bent back to the voice's last note and slides
     10  6bab							;	      in the way the SID's does (all three channels)
     11  6bab							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  6bab							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  6bab							; semitone, so these are a little stepped.
     14  6bab
     15  6bab		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  6bab							;  (the pulses, and the triangle while it glides)
     17  6bab
     18  6bab							; A = 1 (not Z) when a NesFxTick step is due
     19  6bab				   NesFxDue
     20  6bab					      subroutine
     21  6bab		       ad 27 c3 	      lda	devOn+DEV_NES
     22  6bae		       f0 19		      beq	.x
     23  6bb0		       ad fe c5 	      lda	vibDepth
     24  6bb3		       0d 2c c5 	      ora	nfxGlide
     25  6bb6		       0d 2d c5 	      ora	nfxRun
     26  6bb9		       f0 0e		      beq	.x
     27  6bbb		       a5 10		      lda	ticks
     28  6bbd		       38		      sec
     29  6bbe		       ed 28 c5 	      sbc	nfxLast
     30  6bc1		       c9 08		      cmp	#NFX_EVERY
     31  6bc3		       a9 00		      lda	#0
     32  6bc5		       90 02		      bcc	.x
     33  6bc7		       a9 01		      lda	#1
     34  6bc9				   .x
     35  6bc9		       60		      rts
     36  6bca
     37  6bca							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  6bca							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  6bca							; quick return.
     40  6bca				   NesFxTick
     41  6bca					      subroutine
     42  6bca		       ad 27 c3 	      lda	devOn+DEV_NES
     43  6bcd		       f0 0b		      beq	.q
     44  6bcf		       ad fe c5 	      lda	vibDepth
     45  6bd2		       0d 2c c5 	      ora	nfxGlide
     46  6bd5		       0d 2d c5 	      ora	nfxRun
     47  6bd8		       d0 01		      bne	.on
     48  6bda				   .q
     49  6bda		       60		      rts
     50  6bdb				   .on
     51  6bdb		       a5 10		      lda	ticks
     52  6bdd		       38		      sec
     53  6bde		       ed 28 c5 	      sbc	nfxLast
     54  6be1		       c9 08		      cmp	#NFX_EVERY
     55  6be3		       b0 01		      bcs	.go
     56  6be5		       60		      rts
     57  6be6				   .go
     58  6be6		       4a		      lsr
     59  6be7		       4a		      lsr		; 4 ms steps
     60  6be8		       c9 08		      cmp	#8
     61  6bea		       90 02		      bcc	.n
     62  6bec		       a9 08		      lda	#8
     63  6bee				   .n
     64  6bee		       8d 2e c5 	      sta	nfxN
     65  6bf1		       a5 10		      lda	ticks
     66  6bf3		       8d 28 c5 	      sta	nfxLast
     67  6bf6							; ---- vibrato phase, the voices' delay counters, glides
     68  6bf6		       ac 2e c5 	      ldy	nfxN
     69  6bf9				   .ph
     70  6bf9		       ad 34 c5 	      lda	nvPhL
     71  6bfc		       18		      clc
