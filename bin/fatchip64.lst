------- FILE main.asm
------- FILE menu.asm LEVEL 2 PASS 3
      0  5ae7					      include	"menu.asm"
      1  5ae7							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  5ae7							;
      3  5ae7							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  5ae7							;   page   RETURN opens a page
      5  5ae7							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  5ae7							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  5ae7							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  5ae7							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  5ae7							; device pages, until DEVICES says the device is in use).
     10  5ae7							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  5ae7							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  5ae7							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  5ae7
     14  5ae7		       00 17	   MENU_VALCOL equ	23
     15  5ae7
     16  5ae7				   MenuOpen
     17  5ae7		       20 e8 7c 	      jsr	GlitchCalm	; (GLITCH may have the picture shaking)
     18  5aea		       a9 01		      lda	#1
