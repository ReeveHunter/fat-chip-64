     86  1e0e				   .tri
     87  1e0e					      if	TRI_DROP_PADS == 0
     88  1e0e		       4c 43 1e 	      jmp	.no	; PADS: the bass just stops (Reeve, 2026-11-01)
     89  1e11					      endif
     90  1e11		       bd 53 5e 	      lda	vIdx,x
     91  1e14		       c9 02		      cmp	#2
