      0  0ea4					      include	"keys.asm"
      1  0ea4							; Fat Chip 64 - keyboard and RESTORE
      2  0ea4
      3  0ea4							; Scan the whole matrix, turn changes into key events.
      4  0ea4							;
      5  0ea4							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0ea4							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0ea4							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0ea4							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0ea4							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0ea4							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0ea4							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0ea4							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0ea4							; chords whose ghost lands on another used key lose their newest note.
     14  0ea4				   KeyScan
     15  0ea4					      subroutine
     16  0ea4		       a2 07		      ldx	#7
     17  0ea6				   .col
     18  0ea6		       bd b2 80 	      lda	colSelect,x
     19  0ea9		       8d 00 dc 	      sta	CIA1_PRA
     20  0eac		       ad 01 dc 	      lda	CIA1_PRB
     21  0eaf		       49 ff		      eor	#$FF
     22  0eb1		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0eb4		       9d 80 c2 	      sta	keyNow,x
     24  0eb7		       ca		      dex
     25  0eb8		       10 ec		      bpl	.col
     26  0eba		       a9 ff		      lda	#$FF
     27  0ebc		       8d 00 dc 	      sta	CIA1_PRA
     28  0ebf							; ---- every column as accepted (nothing pressed or let go): done
     29  0ebf		       a2 07		      ldx	#7
     30  0ec1				   .same
     31  0ec1		       bd 80 c2 	      lda	keyNow,x
     32  0ec4		       dd 90 c2 	      cmp	keyAcc,x
     33  0ec7		       d0 04		      bne	.changed
     34  0ec9		       ca		      dex
     35  0eca		       10 f5		      bpl	.same
     36  0ecc		       60		      rts
     37  0ecd				   .changed
     38  0ecd							; ---- releases first: accepted keys that are up now
     39  0ecd		       a2 00		      ldx	#0
     40  0ecf				   .rc
     41  0ecf		       8e 38 c3 	      stx	ksCol
     42  0ed2		       bd 80 c2 	      lda	keyNow,x
     43  0ed5		       49 ff		      eor	#$FF
     44  0ed7		       3d 90 c2 	      and	keyAcc,x
     45  0eda		       8d 37 c3 	      sta	ksBits
     46  0edd		       a9 00		      lda	#0
     47  0edf		       8d 39 c3 	      sta	ksRow
     48  0ee2				   .rb
     49  0ee2		       ad 37 c3 	      lda	ksBits
     50  0ee5		       f0 21		      beq	.rcn
     51  0ee7		       4e 37 c3 	      lsr	ksBits
     52  0eea		       90 17		      bcc	.rbn
     53  0eec		       ae 38 c3 	      ldx	ksCol
     54  0eef		       ac 39 c3 	      ldy	ksRow
     55  0ef2		       b9 ba 80 	      lda	rowBit,y
     56  0ef5		       49 ff		      eor	#$FF
     57  0ef7		       3d 90 c2 	      and	keyAcc,x
     58  0efa		       9d 90 c2 	      sta	keyAcc,x
     59  0efd		       20 a3 0f 	      jsr	KeyCode
     60  0f00		       20 b4 18 	      jsr	KeyUp
     61  0f03				   .rbn
     62  0f03		       ee 39 c3 	      inc	ksRow
     63  0f06		       d0 da		      bne	.rb
     64  0f08				   .rcn
     65  0f08		       ae 38 c3 	      ldx	ksCol
     66  0f0b		       e8		      inx
     67  0f0c		       e0 08		      cpx	#8
     68  0f0e		       d0 bf		      bne	.rc
     69  0f10							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0f10							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0f10							; still count as a combination.
     72  0f10		       a9 00		      lda	#0
     73  0f12		       8d 3b c3 	      sta	ksPass
     74  0f15				   .pass
     75  0f15		       a2 00		      ldx	#0
     76  0f17				   .pc
     77  0f17		       8e 38 c3 	      stx	ksCol
     78  0f1a		       bd 90 c2 	      lda	keyAcc,x
     79  0f1d		       49 ff		      eor	#$FF
     80  0f1f		       3d 80 c2 	      and	keyNow,x
     81  0f22		       8d 37 c3 	      sta	ksBits
     82  0f25		       a9 00		      lda	#0
     83  0f27		       8d 39 c3 	      sta	ksRow
     84  0f2a				   .pb
     85  0f2a		       ad 37 c3 	      lda	ksBits
     86  0f2d		       f0 49		      beq	.pcn
     87  0f2f		       4e 37 c3 	      lsr	ksBits
     88  0f32		       90 3f		      bcc	.pbn
     89  0f34		       ad 3c c3 	      lda	ghostFilter
     90  0f37		       d0 0c		      bne	.chk	; filter off (default): phantom notes play...
     91  0f39		       20 a3 0f 	      jsr	KeyCode
     92  0f3c		       c9 18		      cmp	#24
     93  0f3e		       90 0a		      bcc	.accept
     94  0f40		       20 8c 0f 	      jsr	IsModifier
     95  0f43		       f0 05		      beq	.accept
     96  0f45				   .chk 		; ...but a command key never comes from a phantom
     97  0f45		       20 b1 0f 	      jsr	Suspect	;  (v0.40: Q + E held, then C=, read C= + S too)
     98  0f48		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     99  0f4a				   .accept
    100  0f4a		       20 a3 0f 	      jsr	KeyCode
    101  0f4d		       20 8c 0f 	      jsr	IsModifier	; Z set = modifier
    102  0f50		       f0 07		      beq	.mod
    103  0f52		       ad 3b c3 	      lda	ksPass
    104  0f55		       f0 1c		      beq	.pbn	; pass 0: modifiers only
    105  0f57		       d0 05		      bne	.take
    106  0f59				   .mod
    107  0f59		       ad 3b c3 	      lda	ksPass
    108  0f5c		       d0 15		      bne	.pbn	; (taken in pass 0)
    109  0f5e				   .take
    110  0f5e		       ae 38 c3 	      ldx	ksCol
    111  0f61		       ac 39 c3 	      ldy	ksRow
    112  0f64		       b9 ba 80 	      lda	rowBit,y
    113  0f67		       1d 90 c2 	      ora	keyAcc,x
    114  0f6a		       9d 90 c2 	      sta	keyAcc,x
    115  0f6d		       20 a3 0f 	      jsr	KeyCode
    116  0f70		       20 e2 0f 	      jsr	KeyDown
    117  0f73				   .pbn
    118  0f73		       ee 39 c3 	      inc	ksRow
    119  0f76		       d0 b2		      bne	.pb
    120  0f78				   .pcn
    121  0f78		       ae 38 c3 	      ldx	ksCol
    122  0f7b		       e8		      inx
    123  0f7c		       e0 08		      cpx	#8
    124  0f7e		       d0 97		      bne	.pc
    125  0f80		       ad 3b c3 	      lda	ksPass
    126  0f83		       d0 06		      bne	.done
    127  0f85		       ee 3b c3 	      inc	ksPass
    128  0f88		       4c 15 0f 	      jmp	.pass
    129  0f8b				   .done
    130  0f8b		       60		      rts
    131  0f8c
    132  0f8c							; Z set if key code A is a modifier. Keeps A.
    133  0f8c				   IsModifier
    134  0f8c		       c9 88		      cmp	#K_LSHIFT
    135  0f8e		       f0 12		      beq	.y
    136  0f90		       c9 89		      cmp	#K_RSHIFT
    137  0f92		       f0 0e		      beq	.y
    138  0f94		       c9 8c		      cmp	#K_CTRL
    139  0f96		       f0 0a		      beq	.y
    140  0f98		       c9 a2		      cmp	#K_CBM
    141  0f9a		       f0 06		      beq	.y
    142  0f9c		       c9 a3		      cmp	#K_STOP
    143  0f9e		       f0 02		      beq	.y
    144  0fa0		       c9 9a		      cmp	#K_K
    145  0fa2				   .y
