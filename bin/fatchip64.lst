    414  3696				   .nc
    415  3696		       ac 1d c8 	      ldy	sxCmd
    416  3699		       c0 02		      cpy	#2
    417  369b		       d0 0b		      bne	.pat
    418  369d		       e0 04		      cpx	#4	; 2: one byte, bit 0 SID, 1 Game Boy, 2 NES
