------- FILE main.asm
------- FILE voices.asm LEVEL 2 PASS 3
      0  1479					      include	"voices.asm"
      1  1479							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  1479							;
      3  1479							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  1479							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  1479							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  1479							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  1479							; Allocation, whenever the held notes change. Who comes first (v0.21):
      8  1479							; Polyphony > Fat Bass > the patch's effects (REPEAT's echoes) > stacking.
      9  1479							;   1. every note gets a voice (SPARKLE's arp pair is what you play, so it
     10  1479							;	counts as notes and goes first)
     11  1479							;   2. Fat Bass: as many bass voices as are spare play the lowest note,
     12  1479							;	folded into the bass range (one note fewer needs a voice, so with
     13  1479							;	Fat Bass the bottom of the chord is the bass)
     14  1479							;   3. REPEAT's echo voices: one or two of what's still spare
     15  1479							;   4. leftover voices stack on the lowest two notes, alternating
     16  1479							; So one note = a nine-voice unison across three chips, and in chords the
     17  1479							; bottom of the chord is fattest. Disabled devices, and voices the drums
     18  1479							; hold (vDrum), get no notes.
     19  1479
     20  1479							; ------------------------------------------------------------ SID
     21  1479				   SidInit
     22  1479					      subroutine
     23  1479		       a2 18		      ldx	#24
     24  147b		       a9 00		      lda	#0
     25  147d				   .clr
     26  147d		       9d 00 d4 	      sta	SID,x
     27  1480		       ca		      dex
     28  1481		       10 fa		      bpl	.clr
     29  1483		       20 a6 14 	      jsr	SidVolume
     30  1486		       a2 02		      ldx	#2
     31  1488				   .v
     32  1488		       bc 9e 6e 	      ldy	sidOfs,x
     33  148b		       a9 19		      lda	#$19	; attack 1, decay 9
     34  148d		       99 05 d4 	      sta	SID+5,y
     35  1490		       a9 c9		      lda	#$C9	; sustain 12, release 9
     36  1492		       99 06 d4 	      sta	SID+6,y
     37  1495		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     38  1497		       99 03 d4 	      sta	SID+3,y
     39  149a		       a9 20		      lda	#$20	; sawtooth, gate off
     40  149c		       9d 31 c3 	      sta	sidGate,x
     41  149f		       99 04 d4 	      sta	SID+4,y
     42  14a2		       ca		      dex
     43  14a3		       10 e3		      bpl	.v
     44  14a5		       60		      rts
     45  14a6
     46  14a6							; Volume 15, or 0 (silent, no hum) when the SID is off or muted (M).
     47  14a6							; Volume 15, or 0 when the SID is off or muted. Keeps the filter mode bits.
     48  14a6				   SidVolume
     49  14a6					      subroutine
     50  14a6		       ad 25 c3 	      lda	devOn+DEV_SID
     51  14a9		       f0 1a		      beq	.z
     52  14ab		       ad 8f c3 	      lda	muteNow
     53  14ae		       d0 13		      bne	.off
     54  14b0		       ad b1 c4 	      lda	vinylLvl	; VINYL STOP fades the SID out from 192
     55  14b3		       c9 c0		      cmp	#192
     56  14b5		       90 08		      bcc	.full
     57  14b7		       49 ff		      eor	#$FF	; (255 - lvl) / 4
     58  14b9		       4a		      lsr
     59  14ba		       4a		      lsr
     60  14bb		       c9 10		      cmp	#16
     61  14bd		       90 06		      bcc	.z
     62  14bf				   .full
     63  14bf		       a9 0f		      lda	#$0F
     64  14c1		       d0 02		      bne	.z
