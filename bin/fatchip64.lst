      0  0f03					      include	"keys.asm"
      1  0f03							; Fat Chip 64 - keyboard and RESTORE
      2  0f03
      3  0f03							; Scan the whole matrix, turn changes into key events.
      4  0f03							;
      5  0f03							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0f03							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0f03							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0f03							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0f03							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0f03							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0f03							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0f03							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0f03							; chords whose ghost lands on another used key lose their newest note.
     14  0f03				   KeyScan
     15  0f03					      subroutine
     16  0f03		       a2 07		      ldx	#7
     17  0f05				   .col
     18  0f05		       bd 2d 88 	      lda	colSelect,x
     19  0f08		       8d 00 dc 	      sta	CIA1_PRA
     20  0f0b		       ad 01 dc 	      lda	CIA1_PRB
     21  0f0e		       49 ff		      eor	#$FF
     22  0f10		       3d 48 c7 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0f13		       9d 40 c7 	      sta	keyNow,x
     24  0f16		       ca		      dex
     25  0f17		       10 ec		      bpl	.col
     26  0f19		       a9 ff		      lda	#$FF
     27  0f1b		       8d 00 dc 	      sta	CIA1_PRA
     28  0f1e							; ---- every column as accepted (nothing pressed or let go): done
     29  0f1e		       a2 07		      ldx	#7
     30  0f20				   .same
     31  0f20		       bd 40 c7 	      lda	keyNow,x
     32  0f23		       dd 50 c7 	      cmp	keyAcc,x
     33  0f26		       d0 04		      bne	.changed
     34  0f28		       ca		      dex
     35  0f29		       10 f5		      bpl	.same
     36  0f2b		       60		      rts
     37  0f2c				   .changed
     38  0f2c							; ---- releases first: accepted keys that are up now
     39  0f2c		       a2 00		      ldx	#0
     40  0f2e				   .rc
     41  0f2e		       8e fc c7 	      stx	ksCol
     42  0f31		       bd 40 c7 	      lda	keyNow,x
     43  0f34		       49 ff		      eor	#$FF
     44  0f36		       3d 50 c7 	      and	keyAcc,x
     45  0f39		       8d fb c7 	      sta	ksBits
     46  0f3c		       a9 00		      lda	#0
     47  0f3e		       8d fd c7 	      sta	ksRow
     48  0f41				   .rb
     49  0f41		       ad fb c7 	      lda	ksBits
     50  0f44		       f0 21		      beq	.rcn
     51  0f46		       4e fb c7 	      lsr	ksBits
     52  0f49		       90 17		      bcc	.rbn
     53  0f4b		       ae fc c7 	      ldx	ksCol
     54  0f4e		       ac fd c7 	      ldy	ksRow
     55  0f51		       b9 35 88 	      lda	rowBit,y
     56  0f54		       49 ff		      eor	#$FF
     57  0f56		       3d 50 c7 	      and	keyAcc,x
     58  0f59		       9d 50 c7 	      sta	keyAcc,x
     59  0f5c		       20 02 10 	      jsr	KeyCode
     60  0f5f		       20 70 19 	      jsr	KeyUp
     61  0f62				   .rbn
     62  0f62		       ee fd c7 	      inc	ksRow
     63  0f65		       d0 da		      bne	.rb
     64  0f67				   .rcn
     65  0f67		       ae fc c7 	      ldx	ksCol
     66  0f6a		       e8		      inx
     67  0f6b		       e0 08		      cpx	#8
     68  0f6d		       d0 bf		      bne	.rc
     69  0f6f							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0f6f							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0f6f							; still count as a combination.
     72  0f6f		       a9 00		      lda	#0
     73  0f71		       8d ff c7 	      sta	ksPass
     74  0f74				   .pass
     75  0f74		       a2 00		      ldx	#0
     76  0f76				   .pc
     77  0f76		       8e fc c7 	      stx	ksCol
     78  0f79		       bd 50 c7 	      lda	keyAcc,x
     79  0f7c		       49 ff		      eor	#$FF
     80  0f7e		       3d 40 c7 	      and	keyNow,x
     81  0f81		       8d fb c7 	      sta	ksBits
     82  0f84		       a9 00		      lda	#0
     83  0f86		       8d fd c7 	      sta	ksRow
     84  0f89				   .pb
     85  0f89		       ad fb c7 	      lda	ksBits
     86  0f8c		       f0 49		      beq	.pcn
     87  0f8e		       4e fb c7 	      lsr	ksBits
     88  0f91		       90 3f		      bcc	.pbn
