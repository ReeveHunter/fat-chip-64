------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  3dff					      include	"sounds.asm"
      1  3dff							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  3dff							;
      3  3dff							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  3dff							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  3dff							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  3dff							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  3dff							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  3dff							;
      9  3dff							; Each sound has a mono default and a Fat Bass default:
     10  3dff							;   MONO      one note (the last key pressed and still held) on every voice;
     11  3dff							;	       a new key while another is held changes the pitch without a
     12  3dff							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  3dff							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  3dff							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  3dff							;	       the other voices
     16  3dff							;
     17  3dff							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  3dff							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  3dff							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  3dff
     21  3dff							; ------------------------------------------------------------ choosing
     22  3dff							; V: next sound (SHIFT+V: previous)
     23  3dff				   SoundKey
     24  3dff					      subroutine
     25  3dff		       20 e1 3e 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3e02		       ae 5d c8 	      ldx	soundMode
     27  3e05		       ad ee c7 	      lda	shiftDown
     28  3e08		       d0 09		      bne	.prev
     29  3e0a		       e8		      inx
     30  3e0b		       e0 19		      cpx	#NUM_SOUNDS
     31  3e0d		       90 09		      bcc	.s
