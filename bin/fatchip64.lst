    123  3de1							; 250 ms .. 2 s (1000 .. 8000 quarters), else start the average again
    124  3de1		       a5 27		      lda	t3
    125  3de3		       c9 03		      cmp	#>1000
    126  3de5		       90 10		      bcc	.bad0
    127  3de7		       d0 06		      bne	.hi
    128  3de9		       a5 26		      lda	t2
