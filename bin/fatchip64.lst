------- FILE main.asm
------- FILE devices.asm LEVEL 2 PASS 3
      0  5e81					      include	"devices.asm"
      1  5e81							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  5e81							; are in use, and each one in use gets its page on the main menu.
      3  5e81							;
      4  5e81							; YAMAHA SHS-10 (the keytar)
      5  5e81							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  5e81							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  5e81							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  5e81							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  5e81							;		     can play at once.)
     10  5e81							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  5e81							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  5e81							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  5e81							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  5e81							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  5e81							;		     louder (the SID and the NES; the Game Boy would click) or
     16  5e81							;		     brighter (the SID's filter: switched on if the patch has
     17  5e81							;		     none)
     18  5e81							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  5e81							;		     the patch's, or the ADVANCED amounts if it has none;
     20  5e81							;		     FILTER), or an action held while blowing hard
     21  5e81							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  5e81							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  5e81							;   PORTAMENTO BUTTON	an action (CC 65)
     24  5e81							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  5e81							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  5e81							; ATARI SYNTHCART
     27  5e81							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  5e81							;		     about 3% while held, SHIFT + , . step through the ten
     29  5e81							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  5e81							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  5e81							;		     sound's cents (the Synthcart manual's table: each Atari
     32  5e81							;		     sound plays its scales in its own key, a little off)
     33  5e81							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  5e81
     35  5e81		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  5e81		       00 28	   BREATH_LO  equ	40
     37  5e81		       00 01	   BFX_VIB    equ	1
     38  5e81		       00 02	   BFX_WARB   equ	2
     39  5e81		       00 03	   BFX_DET    equ	3
     40  5e81		       00 04	   BFX_FILT   equ	4
     41  5e81		       00 05	   BFX_HELD   equ	5
     42  5e81
