     39  c861 ????	       03 ff	   TICK_LATCH_MS equ	1023	; with the MIDI chip's interrupts (midiIrq): 1 ms
     40  c861 ????	       00 ff	   TICK_LATCH equ	255	; CIA1 timer A: 256 cycles = 1/4 ms (NTSC), quicker
