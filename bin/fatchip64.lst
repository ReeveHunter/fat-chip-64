    430  6e91							; ------------------------------------------------------------ tuning
    431  6e91							; tuneC = PLAYING's FINE TUNE + the Synthcart's TUNE TO (while it's in use),
    432  6e91							; in cents (-100..+100). The Game Boy gets it as master tune (CC 103), the
    433  6e91							; NES in its bends (tuneN, 1/64 semitones), the SID in its note frequencies
    434  6e91							; (SidTune; the notes sounding move at once). MATCH KEY sets the key's root
    435  6e91							; once, when it changes.
    436  6e91				   ScTune
    437  6e91					      subroutine
    438  6e91		       a9 00		      lda	#0
    439  6e93		       ae 01 cd 	      ldx	useSc
    440  6e96		       f0 03		      beq	.t
    441  6e98		       ad 17 cd 	      lda	scSound
    442  6e9b				   .t
