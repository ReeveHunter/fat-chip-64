      0  7a46					      include	"screen.asm"
      1  7a46							; Fat Chip 64 - screen
      2  7a46							;
      3  7a46							;  row 0      header
      4  7a46							;  row 2      sound, POLY / MONO, Fat Bass
      5  7a46							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  7a46							;	       each plays (row 7: a channel overlap warning)
      7  7a46							;  row 9      key, notes mode, latch
      8  7a46							;  row 10     arp
      9  7a46							;  row 12     tempo, beat, mute
     10  7a46							;  row 13     SPACE's action, octave (the lowest key), transpose
     11  7a46							;  row 14     v0.40: the effect the C= keys work on, its setting
     12  7a46							;  row 15     held notes
     13  7a46							;  row 16     MIDI in
     14  7a46							;  row 24     F keys
     15  7a46
