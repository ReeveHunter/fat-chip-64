    246  102e		       c9 01		      cmp	#LATCH_SMART
    247  1030		       d0 32		      bne	.add
    248  1032							; smart: a key still down, or a press soon after the last one, adds to
    249  1032							; the chord; after a pause the next note starts a new chord
    250  1032		       ad d8 c2 	      lda	physCount
    251  1035		       c9 01		      cmp	#1
    252  1037		       d0 2b		      bne	.add
