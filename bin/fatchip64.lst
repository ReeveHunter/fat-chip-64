    350  33da		       48 50 54 58*gbVibRateT .byte.b	72, 80, 84, 88, 92, 96, 100
    351  33e1		       00 08 10 20*gbVibDelT  .byte.b	0, 8, 16, 32, 64
    352  33e6		       10 20 30 40 gbGlideT   .byte.b	16, 32, 48, 64
