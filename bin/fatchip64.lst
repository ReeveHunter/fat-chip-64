------- FILE screen.asm LEVEL 2 PASS 3
      0  74eb					      include	"screen.asm"
      1  74eb							; Fat Chip 64 - screen
      2  74eb							;
      3  74eb							;  row 0      header
      4  74eb							;  row 2      sound, POLY / MONO, Fat Bass
      5  74eb							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  74eb							;	       each plays (row 7: a channel overlap warning)
      7  74eb							;  row 9      key, notes mode, latch
      8  74eb							;  row 10     arp
      9  74eb							;  row 12     tempo, beat, mute
     10  74eb							;  row 13     SPACE's action, octave (the lowest key), transpose
     11  74eb							;  row 14     v0.40: the effect the C= keys work on, its setting
     12  74eb							;  row 15     held notes
     13  74eb							;  row 16     MIDI in
     14  74eb							;  row 24     F keys
     15  74eb
     16  74eb							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     17  74eb							; Letters become screen codes; bit 7 of t2 reverses.
