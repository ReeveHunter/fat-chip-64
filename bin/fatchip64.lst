     48  0f73				   .rb
     49  0f73		       ad fb c7 	      lda	ksBits
     50  0f76		       f0 21		      beq	.rcn
     51  0f78		       4e fb c7 	      lsr	ksBits
     52  0f7b		       90 17		      bcc	.rbn
     53  0f7d		       ae fc c7 	      ldx	ksCol
     54  0f80		       ac fd c7 	      ldy	ksRow
     55  0f83		       b9 cb 98 	      lda	rowBit,y
     56  0f86		       49 ff		      eor	#$FF
     57  0f88		       3d 50 c7 	      and	keyAcc,x
     58  0f8b		       9d 50 c7 	      sta	keyAcc,x
     59  0f8e		       20 34 10 	      jsr	KeyCode
     60  0f91		       20 cf 19 	      jsr	KeyUp
     61  0f94				   .rbn
     62  0f94		       ee fd c7 	      inc	ksRow
     63  0f97		       d0 da		      bne	.rb
     64  0f99				   .rcn
