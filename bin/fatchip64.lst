------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  3cb2					      include	"sounds.asm"
      1  3cb2							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  3cb2							;
      3  3cb2							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  3cb2							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  3cb2							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  3cb2							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  3cb2							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  3cb2							;
      9  3cb2							; Each sound has a mono default and a Fat Bass default:
     10  3cb2							;   MONO      one note (the last key pressed and still held) on every voice;
     11  3cb2							;	       a new key while another is held changes the pitch without a
     12  3cb2							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  3cb2							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  3cb2							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  3cb2							;	       the other voices
     16  3cb2							;
     17  3cb2							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  3cb2							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  3cb2							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  3cb2
     21  3cb2							; ------------------------------------------------------------ choosing
     22  3cb2							; V: next sound (SHIFT+V: previous)
     23  3cb2				   SoundKey
     24  3cb2					      subroutine
     25  3cb2		       20 42 3d 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3cb5		       ae 9d c3 	      ldx	soundMode
