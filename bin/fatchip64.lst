      0  7f22					      include	"nesfx.asm"
      1  7f22							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7f22							;
      3  7f22							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7f22							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7f22							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7f22							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7f22							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7f22							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7f22							;   glide    a new note starts bent back to the voice's last note and slides
     10  7f22							;	      in the way the SID's does (all three channels)
     11  7f22							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7f22							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7f22							; semitone, so these are a little stepped.
     14  7f22
     15  7f22		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7f22							;  (the pulses, and the triangle while it glides)
     17  7f22
     18  7f22							; A = 1 (not Z) when a NesFxTick step is due
     19  7f22				   NesFxDue
     20  7f22					      subroutine
     21  7f22		       ad 2b c3 	      lda	devOn+DEV_NES
     22  7f25		       f0 1c		      beq	.x
     23  7f27		       ad 0b c6 	      lda	vibDepth
     24  7f2a		       0d 39 c5 	      ora	nfxGlide
     25  7f2d		       0d 3a c5 	      ora	nfxRun
     26  7f30		       0d ef c9 	      ora	nfxWarb
     27  7f33		       f0 0e		      beq	.x
     28  7f35		       a5 10		      lda	ticks
     29  7f37		       38		      sec
     30  7f38		       ed 35 c5 	      sbc	nfxLast
     31  7f3b		       c9 08		      cmp	#NFX_EVERY
     32  7f3d		       a9 00		      lda	#0
     33  7f3f		       90 02		      bcc	.x
     34  7f41		       a9 01		      lda	#1
     35  7f43				   .x
     36  7f43		       60		      rts
     37  7f44
