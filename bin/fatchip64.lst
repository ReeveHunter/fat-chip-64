------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  5311					      include	"sync.asm"
      1  5311							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  5311							;
      3  5311							; Menu, DEVICE SYNC (defaults first):
      4  5311							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  5311							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  5311							;		     sets the tempo, averaged over beats (the clock jitters about
      7  5311							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  5311							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  5311							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  5311							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  5311							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  5311							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  5311							;		     picks a beat demo (styleBeat)
     14  5311							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  5311							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  5311							;		     key channel) picks a sound (voiceSound)
     17  5311							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  5311							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  5311							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  5311							;
     21  5311							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  5311							; 1/4 ms); a Start makes the next clock a beat.
     23  5311
     24  5311		       00 00	   TEMPO_KEYTAR equ	0
     25  5311		       00 01	   TEMPO_OWN  equ	1
     26  5311		       00 02	   TEMPO_SC   equ	2
     27  5311		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  5311
     29  5311
     30  5311
     31  5311							; ------------------------------------------------------------ clock
     32  5311							; Main loop, every pass
     33  5311				   ClockTick
     34  5311					      subroutine
     35  5311		       ad e5 c5 	      lda	clkCount	; any clock lately?
     36  5314		       cd e6 c5 	      cmp	clkCountSeen
     37  5317		       f0 15		      beq	.alive
     38  5319		       8d e6 c5 	      sta	clkCountSeen
     39  531c		       20 09 23 	      jsr	GetTicks
     40  531f		       ad 3f c3 	      lda	nowL
     41  5322		       8d e7 c5 	      sta	clkSeenL
     42  5325		       ad 40 c3 	      lda	nowH
     43  5328		       8d e8 c5 	      sta	clkSeenH
     44  532b		       4c 4f 53 	      jmp	.beatq
     45  532e				   .alive
     46  532e		       ad f2 c5 	      lda	clkHave	; none for a while: start measuring afresh
     47  5331		       f0 1c		      beq	.beatq
     48  5333		       20 09 23 	      jsr	GetTicks
     49  5336		       ad 3f c3 	      lda	nowL
     50  5339		       38		      sec
     51  533a		       ed e7 c5 	      sbc	clkSeenL
     52  533d		       aa		      tax
     53  533e		       ad 40 c3 	      lda	nowH
     54  5341		       ed e8 c5 	      sbc	clkSeenH
     55  5344		       d0 04		      bne	.lost
     56  5346		       e0 2c		      cpx	#<CLK_ALIVE
     57  5348		       90 05		      bcc	.beatq
     58  534a				   .lost
     59  534a		       a9 00		      lda	#0
     60  534c		       8d f2 c5 	      sta	clkHave
     61  534f				   .beatq
     62  534f		       ad ea c5 	      lda	clkBeat
     63  5352		       cd eb c5 	      cmp	clkBeatSeen
     64  5355		       d0 01		      bne	.beat
     65  5357		       60		      rts
     66  5358				   .beat
     67  5358		       8d eb c5 	      sta	clkBeatSeen
     68  535b
