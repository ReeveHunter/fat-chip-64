    371  310d		       8e 4c c7 	      stx	sxOn
    372  3110		       8e 1c c8 	      stx	sxCmd
    373  3113		       a2 00		      ldx	#0
    374  3115		       8e 4d c7 	      stx	sxPos
    375  3118		       60		      rts
