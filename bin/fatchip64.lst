------- FILE sounds.asm LEVEL 2 PASS 3
      0  2c6c					      include	"sounds.asm"
      1  2c6c							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  2c6c							;
      3  2c6c							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  2c6c							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  2c6c							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  2c6c							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  2c6c							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  2c6c							;
      9  2c6c							; Each sound has a mono default and a Fat Bass default:
     10  2c6c							;   MONO      one note (the last key pressed and still held) on every voice;
     11  2c6c							;	       a new key while another is held changes the pitch without a
     12  2c6c							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  2c6c							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  2c6c							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  2c6c							;	       the other voices
     16  2c6c							;
     17  2c6c							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  2c6c							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  2c6c							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  2c6c
     21  2c6c							; ------------------------------------------------------------ choosing
     22  2c6c							; V: next sound (SHIFT+V: previous)
     23  2c6c				   SoundKey
     24  2c6c					      subroutine
     25  2c6c		       20 ae 2c 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  2c6f		       ae 95 c3 	      ldx	soundMode
     27  2c72		       ad 2a c3 	      lda	shiftDown
     28  2c75		       d0 09		      bne	.prev
     29  2c77		       e8		      inx
     30  2c78		       e0 13		      cpx	#NUM_SOUNDS
     31  2c7a		       90 09		      bcc	.s
     32  2c7c		       a2 00		      ldx	#0
     33  2c7e		       f0 05		      beq	.s
     34  2c80				   .prev
     35  2c80		       ca		      dex
     36  2c81		       10 02		      bpl	.s
     37  2c83		       a2 12		      ldx	#NUM_SOUNDS-1
     38  2c85				   .s
