    234  6391							; ------------------------------------------------------------ One Key Play
    235  6391							; CRSR DOWN or CRSR RIGHT (A = 1 / 2: which) pressed, ONE KEY PLAY on: the
    236  6391							; phrase's next step sounds. PENTATONIC PAIRS: two notes of the key's
    237  6391							; pentatonic scale, one apart (a third or a fourth), across the overlay's two
    238  6391							; octaves. CHORD NOTES: one note of the chord (the keys held or latched),
    239  6391							; over two octaves. EACH PRESS CUTS the last step or lets it RING ON (until
    240  6391							; the next). The notes sound while either key is down (latch: until the next
    241  6391							; press).
    242  6391				   OkpPress
    243  6391					      subroutine
    244  6391		       0d 79 c8 	      ora	okpDown
    245  6394		       8d 79 c8 	      sta	okpDown
    246  6397		       ad 76 c8 	      lda	okpRing	; RINGS ON: the last step stays
    247  639a		       f0 15		      beq	.cut
    248  639c		       ad 7a c8 	      lda	okpCount
    249  639f		       f0 10		      beq	.cut
    250  63a1		       ad 7b c8 	      lda	okpNotes
    251  63a4		       8d 7d c8 	      sta	okpNotes+2
    252  63a7		       ad 7c c8 	      lda	okpNotes+1
    253  63aa		       8d 7e c8 	      sta	okpNotes+3
    254  63ad		       a9 04		      lda	#4
