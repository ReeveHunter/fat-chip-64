      3  0eaa							; Scan the whole matrix, turn changes into key events.
      4  0eaa							;
      5  0eaa							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0eaa							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0eaa							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0eaa							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0eaa							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0eaa							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0eaa							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0eaa							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0eaa							; chords whose ghost lands on another used key lose their newest note.
     14  0eaa				   KeyScan
     15  0eaa					      subroutine
     16  0eaa		       a2 07		      ldx	#7
     17  0eac				   .col
     18  0eac		       bd 1f 76 	      lda	colSelect,x
