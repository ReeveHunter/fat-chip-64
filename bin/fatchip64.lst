    267  2d3f							; noise presets: closed hat, open hat, cymbal x ghost / hit / accent
    268  2d3f							; (MidiNES long-mode noise: note = 51 - period; the Beat Lab's closed hat
    269  2d3f							; is period 1, open 2, crash 3)
    270  2d3f		       32 32 32 31*nzNoteT    .byte.b	50,50,50, 49,49,49, 48,48,48
    271  2d48		       04 06 08 05*nzVolT     .byte.b	4,6,8, 5,6,7, 5,6,7
    272  2d51		       08 0b 0f 32*nzLenT     .byte.b	8,11,15, 50,65,80, 150,225,255
    273  2d5a
    274  2d5a							; main loop: the noise note's time is up
