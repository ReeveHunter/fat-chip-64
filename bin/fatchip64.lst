------- FILE main.asm
------- FILE nesfx.asm LEVEL 2 PASS 3
      0  64f6					      include	"nesfx.asm"
      1  64f6							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  64f6							;
      3  64f6							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  64f6							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  64f6							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  64f6							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  64f6							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  64f6							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  64f6							;   glide    a new note starts bent back to the voice's last note and slides
     10  64f6							;	      in the way the SID's does (all three channels)
     11  64f6							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  64f6							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  64f6							; semitone, so these are a little stepped.
     14  64f6
     15  64f6		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  64f6							;  (the pulses, and the triangle while it glides)
     17  64f6
     18  64f6							; A = 1 (not Z) when a NesFxTick step is due
     19  64f6				   NesFxDue
     20  64f6					      subroutine
     21  64f6		       ad 27 c3 	      lda	devOn+DEV_NES
     22  64f9		       f0 19		      beq	.x
     23  64fb		       ad fe c5 	      lda	vibDepth
     24  64fe		       0d 2c c5 	      ora	nfxGlide
     25  6501		       0d 2d c5 	      ora	nfxRun
     26  6504		       f0 0e		      beq	.x
     27  6506		       a5 10		      lda	ticks
     28  6508		       38		      sec
     29  6509		       ed 28 c5 	      sbc	nfxLast
     30  650c		       c9 08		      cmp	#NFX_EVERY
     31  650e		       a9 00		      lda	#0
     32  6510		       90 02		      bcc	.x
     33  6512		       a9 01		      lda	#1
     34  6514				   .x
     35  6514		       60		      rts
     36  6515
     37  6515							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  6515							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  6515							; quick return.
     40  6515				   NesFxTick
     41  6515					      subroutine
     42  6515		       ad 27 c3 	      lda	devOn+DEV_NES
     43  6518		       f0 0b		      beq	.q
     44  651a		       ad fe c5 	      lda	vibDepth
     45  651d		       0d 2c c5 	      ora	nfxGlide
     46  6520		       0d 2d c5 	      ora	nfxRun
     47  6523		       d0 01		      bne	.on
     48  6525				   .q
     49  6525		       60		      rts
     50  6526				   .on
     51  6526		       a5 10		      lda	ticks
     52  6528		       38		      sec
     53  6529		       ed 28 c5 	      sbc	nfxLast
     54  652c		       c9 08		      cmp	#NFX_EVERY
     55  652e		       b0 01		      bcs	.go
     56  6530		       60		      rts
     57  6531				   .go
     58  6531		       4a		      lsr
     59  6532		       4a		      lsr		; 4 ms steps
     60  6533		       c9 08		      cmp	#8
     61  6535		       90 02		      bcc	.n
     62  6537		       a9 08		      lda	#8
     63  6539				   .n
