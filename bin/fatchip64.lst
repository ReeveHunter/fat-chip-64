------- FILE main.asm
------- FILE arp.asm LEVEL 2 PASS 3
      0  24a4					      include	"arp.asm"
      1  24a4							; Fat Chip 64 - tempo and arpeggiator
      2  24a4							;
      3  24a4							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  24a4							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  24a4							;
      6  24a4							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  24a4							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  24a4							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  24a4							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  24a4							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  24a4							;	     until its voice's next turn.
     12  24a4							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  24a4							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  24a4							;   J faster; either one also picks FREE).
     15  24a4							;
     16  24a4							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  24a4							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  24a4
     19  24a4							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  24a4							; between the two bytes: $22FF read as $23FF)
     21  24a4				   GetTicks
     22  24a4					      subroutine
     23  24a4		       08		      php
     24  24a5		       78		      sei
     25  24a6		       a5 10		      lda	ticks
     26  24a8		       8d 03 c8 	      sta	nowL
     27  24ab		       a5 11		      lda	ticks+1
     28  24ad		       8d 04 c8 	      sta	nowH
     29  24b0		       28		      plp
     30  24b1		       60		      rts
     31  24b2
     32  24b2							; ------------------------------------------------------------ tempo
     33  24b2				   TapTempo
     34  24b2					      subroutine
     35  24b2		       20 88 5c 	      jsr	FollowActive	; the keytar's clock sets the tempo: taps do nothing
     36  24b5		       f0 01		      beq	.tap
     37  24b7		       60		      rts
     38  24b8				   .tap
     39  24b8		       a9 00		      lda	#0
     40  24ba		       8d e7 ca 	      sta	beatFresh	; (a tempo of your own: a beat starting keeps it)
     41  24bd		       20 a4 24 	      jsr	GetTicks
     42  24c0		       ad 03 c8 	      lda	nowL
     43  24c3		       38		      sec
     44  24c4		       ed 08 c8 	      sbc	tapLast
     45  24c7		       85 24		      sta	t0
     46  24c9		       ad 04 c8 	      lda	nowH
     47  24cc		       ed 09 c8 	      sbc	tapLast+1
     48  24cf		       85 25		      sta	t1
     49  24d1		       ad 03 c8 	      lda	nowL
     50  24d4		       8d 08 c8 	      sta	tapLast
     51  24d7		       ad 04 c8 	      lda	nowH
     52  24da		       8d 09 c8 	      sta	tapLast+1
     53  24dd		       ad 0a c8 	      lda	tapCount
     54  24e0		       d0 03		      bne	.had
     55  24e2		       4c 66 25 	      jmp	.first
     56  24e5				   .had
     57  24e5							; 240 ms (250 BPM) <= gap < 2000 ms (30 BPM)
     58  24e5		       a5 25		      lda	t1
     59  24e7		       c9 07		      cmp	#>2000
