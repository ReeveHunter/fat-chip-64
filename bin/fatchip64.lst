      0  6273					      include	"patchedit.asm"
      1  6273							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  6273							; the dice. The settings and their steps come from tools/gen_menu.py
      3  6273							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  6273							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  6273							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  6273							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  6273							; (EnvDerive).
      8  6273
