    160  0fdb							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    161  0fdb							; keys: some other column has a key in this row and shares another row with
    162  0fdb							; this column.
    163  0fdb				   Suspect
    164  0fdb					      subroutine
    165  0fdb		       ac 3d c3 	      ldy	ksRow
    166  0fde		       b9 a9 82 	      lda	rowBit,y
    167  0fe1		       49 ff		      eor	#$FF
    168  0fe3		       ae 3c c3 	      ldx	ksCol
    169  0fe6		       3d 80 c2 	      and	keyNow,x
    170  0fe9		       8d 3e c3 	      sta	ksMask	; this column's other held rows
    171  0fec		       f0 1c		      beq	.no
    172  0fee		       a2 07		      ldx	#7
    173  0ff0				   .c
