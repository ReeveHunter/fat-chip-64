     52  236d		       f0 75		      beq	.no
     53  236f		       bc 3f 23 	      ldy	vEnvSlot,x
     54  2372		       30 3e		      bmi	.tri
     55  2374							; pulse: release from the current level; step = level x factor / 4 + 1
     56  2374							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  2374							; about 2 s). Factor 0: no release, cut.
     58  2374		       ad 69 c4 	      lda	envRelV
     59  2377		       f0 6b		      beq	.no
     60  2379		       86 26		      stx	t2
