    408  40a7		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    409  40ac		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    410  40b0		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    411  40b4		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
    412  40b9		       05 0a 0f 14*uTremRH    .byte.b	>1311, >2621, >3932, >5243, >6554
    413  40be		       04 08 0c 10 uDetT      .byte.b	4, 8, 12, 16
    414  40c2		       18 38 64    uWarbT     .byte.b	24, 56, 100
