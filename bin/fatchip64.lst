    126  0eed							; Z set if key code A is a modifier. Keeps A.
    127  0eed				   IsModifier
    128  0eed		       c9 88		      cmp	#K_LSHIFT
    129  0eef		       f0 12		      beq	.y
    130  0ef1		       c9 89		      cmp	#K_RSHIFT
    131  0ef3		       f0 0e		      beq	.y
    132  0ef5		       c9 8c		      cmp	#K_CTRL
    133  0ef7		       f0 0a		      beq	.y
    134  0ef9		       c9 a2		      cmp	#K_CBM
    135  0efb		       f0 06		      beq	.y
    136  0efd		       c9 a3		      cmp	#K_STOP
    137  0eff		       f0 02		      beq	.y
    138  0f01		       c9 9a		      cmp	#K_K
    139  0f03				   .y
    140  0f03		       60		      rts
