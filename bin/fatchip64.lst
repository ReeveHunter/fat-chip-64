------- FILE main.asm
------- FILE viz.asm LEVEL 2 PASS 3
      0  5f4d					      include	"viz.asm"
      1  5f4d							; Fat Chip 64 - the visualizers (F7: BARS, GLITCH, back to play), demos
      2  5f4d							;
      3  5f4d							; BARS:
      4  5f4d							; Nine bars, one per voice, in three groups: SID, Game Boy, MidiNES. A new
      5  5f4d							; note throws its bar to the top; it falls back to a height set by the
      6  5f4d							; note's pitch (higher notes stand taller) while the note sounds, and to
      7  5f4d							; nothing when it stops. The tremolo makes the bars breathe. Each bar takes
      8  5f4d							; the colour of its note's pitch class (C red ... B white). Kick drums flash
      9  5f4d							; the border in the key's colour; row 24 has the sound, the tempo and, while
     10  5f4d							; a beat plays, which beat of the bar it's on.
     11  5f4d							;
     12  5f4d							; One bar is drawn per screen step (about every 8 ms), so the screen stays
     13  5f4d							; out of the way of the keyboard and the arp: about 13 frames a second.
     14  5f4d							;
     15  5f4d							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
     16  5f4d							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
     17  5f4d							; keep spattering more; runs of the screen get copied over other places
     18  5f4d							; (datamosh) and wiped away, so it fills while you play and dissolves when
     19  5f4d							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
     20  5f4d							; the background. VINYL STOP drags it down the screen.
     21  5f4d
     22  5f4d		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     23  5f4d		       00 16	   VIZ_NAMES  equ	22	; note names
     24  5f4d		       00 a0	   VIZ_FULL   equ	160	; reversed space
     25  5f4d		       00 62	   VIZ_HALF   equ	98	; lower half block
     26  5f4d
     27  5f4d							; F7: BARS -> GLITCH -> the play screen (not from the menu)
     28  5f4d				   VizKey
     29  5f4d					      subroutine
     30  5f4d		       ad 89 c4 	      lda	menuOn
     31  5f50		       d0 2f		      bne	.x
     32  5f52		       20 79 62 	      jsr	GlitchCalm
     33  5f55		       ae 23 c6 	      ldx	vizOn
     34  5f58		       e8		      inx
     35  5f59		       e0 03		      cpx	#3
