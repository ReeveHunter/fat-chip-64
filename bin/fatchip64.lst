     81  0e80		       8d 36 c3 	      sta	ksBits
     82  0e83		       a9 00		      lda	#0
     83  0e85		       8d 38 c3 	      sta	ksRow
     84  0e88				   .pb
     85  0e88		       ad 36 c3 	      lda	ksBits
