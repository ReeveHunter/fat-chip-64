------- FILE devices.asm LEVEL 2 PASS 3
      0  646a					      include	"devices.asm"
      1  646a							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  646a							; are in use, and each one in use gets its page on the main menu.
      3  646a							;
      4  646a							; YAMAHA SHS-10 (the keytar)
      5  646a							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  646a							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  646a							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  646a							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  646a							;		     can play at once.)
     10  646a							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  646a							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  646a							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  646a							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  646a							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  646a							;		     louder (the SID and the NES; the Game Boy would click) or
     16  646a							;		     brighter (the SID's filter: switched on if the patch has
     17  646a							;		     none)
     18  646a							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  646a							;		     the patch's, or the ADVANCED amounts if it has none;
     20  646a							;		     FILTER), or an action held while blowing hard
     21  646a							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  646a							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  646a							;   PORTAMENTO BUTTON	an action (CC 65)
     24  646a							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  646a							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  646a							; ATARI SYNTHCART
     27  646a							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  646a							;		     about 3% while held, SHIFT + , . step through the ten
     29  646a							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  646a							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  646a							;		     sound's cents (the Synthcart manual's table: each Atari
     32  646a							;		     sound plays its scales in its own key, a little off)
     33  646a							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  646a
     35  646a		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  646a		       00 28	   BREATH_LO  equ	40
     37  646a		       00 01	   BFX_VIB    equ	1
     38  646a		       00 02	   BFX_WARB   equ	2
     39  646a		       00 03	   BFX_DET    equ	3
     40  646a		       00 04	   BFX_FILT   equ	4
     41  646a		       00 05	   BFX_HELD   equ	5
     42  646a
