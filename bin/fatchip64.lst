------- FILE attack.asm LEVEL 2 PASS 3
      0  6a87					      include	"attack.asm"
      1  6a87							; Fat Chip 64 - ATTACK, BEND IN, BEND OUT (v0.30): how each note starts and
      2  6a87							; ends in pitch
      3  6a87							;
      4  6a87							; ATTACK (the SID): BLIP: an octave up for one BLIP STEP, then the note
      5  6a87							;   (OCTAVE + 5TH: an octave, a fifth, the note; 2 OCTAVES: two up, one up,
      6  6a87							;   the note); CLICK: the first 20 ms as noise.
      7  6a87							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      8  6a87							;   a scoop) and bends to its pitch over TIME: the SID and NES slide it (the
      9  6a87							;   SID per voice, the NES with its glide), the Game Boy has its own pitch
     10  6a87							;   envelope (CC 80 / 81).
     11  6a87							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  6a87							;   release rings.
     13  6a87
     14  6a87							; SidFxs pitch loop, SID voice envY: ATTACK's clock; the CLICK ends
     15  6a87				   AtkStep
     16  6a87					      subroutine
