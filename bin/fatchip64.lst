      1  0e11							; Fat Chip 64 - keyboard and RESTORE
      2  0e11
      3  0e11							; Scan the whole matrix, turn changes into key events.
      4  0e11							;
      5  0e11							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0e11							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0e11							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0e11							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0e11							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0e11							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0e11							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0e11							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0e11							; chords whose ghost lands on another used key lose their newest note.
     14  0e11				   KeyScan
     15  0e11					      subroutine
     16  0e11		       a2 07		      ldx	#7
     17  0e13				   .col
     18  0e13		       bd 4e 6e 	      lda	colSelect,x
     19  0e16		       8d 00 dc 	      sta	CIA1_PRA
     20  0e19		       ad 01 dc 	      lda	CIA1_PRB
     21  0e1c		       49 ff		      eor	#$FF
     22  0e1e		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0e21		       9d 80 c2 	      sta	keyNow,x
     24  0e24		       ca		      dex
     25  0e25		       10 ec		      bpl	.col
     26  0e27		       a9 ff		      lda	#$FF
     27  0e29		       8d 00 dc 	      sta	CIA1_PRA
     28  0e2c							; ---- every column as accepted (nothing pressed or let go): done
     29  0e2c		       a2 07		      ldx	#7
     30  0e2e				   .same
     31  0e2e		       bd 80 c2 	      lda	keyNow,x
     32  0e31		       dd 90 c2 	      cmp	keyAcc,x
     33  0e34		       d0 04		      bne	.changed
     34  0e36		       ca		      dex
     35  0e37		       10 f5		      bpl	.same
     36  0e39		       60		      rts
     37  0e3a				   .changed
     38  0e3a							; ---- releases first: accepted keys that are up now
     39  0e3a		       a2 00		      ldx	#0
     40  0e3c				   .rc
     41  0e3c		       8e 37 c3 	      stx	ksCol
     42  0e3f		       bd 80 c2 	      lda	keyNow,x
     43  0e42		       49 ff		      eor	#$FF
     44  0e44		       3d 90 c2 	      and	keyAcc,x
     45  0e47		       8d 36 c3 	      sta	ksBits
     46  0e4a		       a9 00		      lda	#0
     47  0e4c		       8d 38 c3 	      sta	ksRow
     48  0e4f				   .rb
     49  0e4f		       ad 36 c3 	      lda	ksBits
     50  0e52		       f0 21		      beq	.rcn
     51  0e54		       4e 36 c3 	      lsr	ksBits
     52  0e57		       90 17		      bcc	.rbn
     53  0e59		       ae 37 c3 	      ldx	ksCol
     54  0e5c		       ac 38 c3 	      ldy	ksRow
     55  0e5f		       b9 56 6e 	      lda	rowBit,y
     56  0e62		       49 ff		      eor	#$FF
     57  0e64		       3d 90 c2 	      and	keyAcc,x
     58  0e67		       9d 90 c2 	      sta	keyAcc,x
     59  0e6a		       20 04 0f 	      jsr	KeyCode
     60  0e6d		       20 96 13 	      jsr	KeyUp
     61  0e70				   .rbn
     62  0e70		       ee 38 c3 	      inc	ksRow
     63  0e73		       d0 da		      bne	.rb
     64  0e75				   .rcn
     65  0e75		       ae 37 c3 	      ldx	ksCol
     66  0e78		       e8		      inx
     67  0e79		       e0 08		      cpx	#8
     68  0e7b		       d0 bf		      bne	.rc
     69  0e7d							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0e7d							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0e7d							; still count as a combination.
     72  0e7d		       a9 00		      lda	#0
     73  0e7f		       8d 3a c3 	      sta	ksPass
     74  0e82				   .pass
     75  0e82		       a2 00		      ldx	#0
     76  0e84				   .pc
     77  0e84		       8e 37 c3 	      stx	ksCol
     78  0e87		       bd 90 c2 	      lda	keyAcc,x
     79  0e8a		       49 ff		      eor	#$FF
     80  0e8c		       3d 80 c2 	      and	keyNow,x
     81  0e8f		       8d 36 c3 	      sta	ksBits
     82  0e92		       a9 00		      lda	#0
     83  0e94		       8d 38 c3 	      sta	ksRow
     84  0e97				   .pb
     85  0e97		       ad 36 c3 	      lda	ksBits
     86  0e9a		       f0 3d		      beq	.pcn
     87  0e9c		       4e 36 c3 	      lsr	ksBits
     88  0e9f		       90 33		      bcc	.pbn
     89  0ea1		       ad 3b c3 	      lda	ghostFilter
     90  0ea4		       f0 05		      beq	.accept	; filter off (default): phantoms play
     91  0ea6		       20 12 0f 	      jsr	Suspect
     92  0ea9		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     93  0eab				   .accept
     94  0eab		       20 04 0f 	      jsr	KeyCode
     95  0eae		       20 ed 0e 	      jsr	IsModifier	; Z set = modifier
     96  0eb1		       f0 07		      beq	.mod
     97  0eb3		       ad 3a c3 	      lda	ksPass
     98  0eb6		       f0 1c		      beq	.pbn	; pass 0: modifiers only
     99  0eb8		       d0 05		      bne	.take
    100  0eba				   .mod
    101  0eba		       ad 3a c3 	      lda	ksPass
    102  0ebd		       d0 15		      bne	.pbn	; (taken in pass 0)
    103  0ebf				   .take
    104  0ebf		       ae 37 c3 	      ldx	ksCol
    105  0ec2		       ac 38 c3 	      ldy	ksRow
    106  0ec5		       b9 56 6e 	      lda	rowBit,y
    107  0ec8		       1d 90 c2 	      ora	keyAcc,x
    108  0ecb		       9d 90 c2 	      sta	keyAcc,x
    109  0ece		       20 04 0f 	      jsr	KeyCode
    110  0ed1		       20 43 0f 	      jsr	KeyDown
    111  0ed4				   .pbn
    112  0ed4		       ee 38 c3 	      inc	ksRow
    113  0ed7		       d0 be		      bne	.pb
    114  0ed9				   .pcn
