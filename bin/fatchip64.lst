------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  3cf5					      include	"sounds.asm"
      1  3cf5							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  3cf5							;
      3  3cf5							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  3cf5							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  3cf5							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  3cf5							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  3cf5							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  3cf5							;
      9  3cf5							; Each sound has a mono default and a Fat Bass default:
     10  3cf5							;   MONO      one note (the last key pressed and still held) on every voice;
     11  3cf5							;	       a new key while another is held changes the pitch without a
     12  3cf5							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  3cf5							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  3cf5							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  3cf5							;	       the other voices
     16  3cf5							;
     17  3cf5							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  3cf5							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  3cf5							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  3cf5
     21  3cf5							; ------------------------------------------------------------ choosing
     22  3cf5							; V: next sound (SHIFT+V: previous)
     23  3cf5				   SoundKey
     24  3cf5					      subroutine
     25  3cf5		       20 85 3d 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3cf8		       ae 9d c3 	      ldx	soundMode
     27  3cfb		       ad 2e c3 	      lda	shiftDown
     28  3cfe		       d0 09		      bne	.prev
