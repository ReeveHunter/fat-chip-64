------- FILE devices.asm LEVEL 2 PASS 3
      0  65db					      include	"devices.asm"
      1  65db							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  65db							; are in use, and each one in use gets its page on the main menu.
      3  65db							;
      4  65db							; YAMAHA SHS-10 (the keytar)
      5  65db							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  65db							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  65db							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  65db							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  65db							;		     can play at once.)
     10  65db							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  65db							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  65db							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  65db							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  65db							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  65db							;		     louder (the SID and the NES; the Game Boy would click) or
     16  65db							;		     brighter (the SID's filter: switched on if the patch has
     17  65db							;		     none)
     18  65db							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  65db							;		     the patch's, or the ADVANCED amounts if it has none;
     20  65db							;		     FILTER), or an action held while blowing hard
     21  65db							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  65db							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  65db							;   PORTAMENTO BUTTON	an action (CC 65)
     24  65db							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  65db							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  65db							; ATARI SYNTHCART
     27  65db							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  65db							;		     about 3% while held, SHIFT + , . step through the ten
     29  65db							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  65db							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  65db							;		     sound's cents (the Synthcart manual's table: each Atari
     32  65db							;		     sound plays its scales in its own key, a little off)
     33  65db							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  65db
     35  65db		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  65db		       00 28	   BREATH_LO  equ	40
     37  65db		       00 01	   BFX_VIB    equ	1
     38  65db		       00 02	   BFX_WARB   equ	2
     39  65db		       00 03	   BFX_DET    equ	3
     40  65db		       00 04	   BFX_FILT   equ	4
     41  65db		       00 05	   BFX_HELD   equ	5
     42  65db
