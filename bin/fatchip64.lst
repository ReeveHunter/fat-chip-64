    396  0de6		       20 5b 0d 	      jsr	GbGlobal
    397  0de9							; detune the two pulses apart: CC 94 is scaled 0-127 (64 = centre,
    398  0de9							; +-50 cents), so 58 / 70 = about -5 / +5 cents
    399  0de9		       ad 28 c3 	      lda	gbBase
