------- FILE menu.asm LEVEL 2 PASS 3
      0  4cc9					      include	"menu.asm"
      1  4cc9							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  4cc9							;
      3  4cc9							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  4cc9							;   page   RETURN opens a page
      5  4cc9							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  4cc9							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  4cc9							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  4cc9							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  4cc9							; device pages, until DEVICES says the device is in use).
     10  4cc9							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  4cc9							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  4cc9							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  4cc9
     14  4cc9		       00 17	   MENU_VALCOL equ	23
     15  4cc9
     16  4cc9				   MenuOpen
     17  4cc9		       20 32 63 	      jsr	GlitchCalm	; (GLITCH may have the picture shaking)
