      0  3f14					      include	"repeat.asm"
      1  3f14							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  3f14							;
      3  3f14							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  3f14							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  3f14							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  3f14							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  3f14							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  3f14							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  3f14							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  3f14							; 3/4 of the time between echoes. The SID doesn't echo.
     11  3f14							;
     12  3f14							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  3f14							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  3f14							; or a keytar button).
     15  3f14							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  3f14							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  3f14
     18  3f14		       00 10	   RP_SLOTS   equ	16
     19  3f14		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  3f14
     21  3f14							; REPEAT is on now?
     22  3f14				   RepeatActive
     23  3f14		       ad 4b c5 	      lda	repeatOn
     24  3f17		       0d ab c4 	      ora	actCnt+A_REPEAT
     25  3f1a		       60		      rts
