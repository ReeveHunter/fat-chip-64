    350  0abf				   .noRx
    351  0abf		       a6 16		      ldx	wireTail
    352  0ac1		       e4 15		      cpx	wireHead
    353  0ac3		       f0 0f		      beq	.noByte
    354  0ac5		       ad 06 de 	      lda	ACIA_STAT
    355  0ac8		       29 02		      and	#ACIA_TDRE
    356  0aca		       f0 08		      beq	.noByte
