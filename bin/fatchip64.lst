------- FILE attack.asm LEVEL 2 PASS 3
      0  6812					      include	"attack.asm"
      1  6812							; Fat Chip 64 - ATTACK, BEND IN, BEND OUT (v0.30): how each note starts and
      2  6812							; ends in pitch
      3  6812							;
      4  6812							; ATTACK (the SID): BLIP: an octave up for one BLIP STEP, then the note
      5  6812							;   (OCTAVE + 5TH: an octave, a fifth, the note; 2 OCTAVES: two up, one up,
      6  6812							;   the note); CLICK: the first 20 ms as noise.
      7  6812							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      8  6812							;   a scoop) and bends to its pitch over TIME: the SID and NES slide it (the
      9  6812							;   SID per voice, the NES with its glide), the Game Boy has its own pitch
     10  6812							;   envelope (CC 80 / 81).
     11  6812							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  6812							;   release rings.
     13  6812
     14  6812							; SidFxs pitch loop, SID voice envY: ATTACK's clock; the CLICK ends
     15  6812				   AtkStep
     16  6812					      subroutine
     17  6812		       ac c2 c3 	      ldy	envY
