    252  0cd4				   WirePut
    253  0cd4					      subroutine
    254  0cd4		       a6 15		      ldx	wireHead
    255  0cd6		       9d 00 c0 	      sta	wireBuf,x
    256  0cd9		       e6 15		      inc	wireHead
    257  0cdb		       a5 2f		      lda	midiIrq	; the MIDI chip: interrupt when it can take it
    258  0cdd		       f0 05		      beq	.x
    259  0cdf		       a9 b6		      lda	#ACIA_MODE_TX
    260  0ce1		       8d 04 de 	      sta	ACIA_CTRL
    261  0ce4				   .x
    262  0ce4		       60		      rts
