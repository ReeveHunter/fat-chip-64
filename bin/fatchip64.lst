------- FILE repeat.asm LEVEL 2 PASS 3
      0  4202					      include	"repeat.asm"
      1  4202							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  4202							;
      3  4202							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  4202							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  4202							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  4202							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  4202							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  4202							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  4202							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  4202							; 3/4 of the time between echoes. The SID doesn't echo.
     11  4202							;
     12  4202							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  4202							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  4202							; or a keytar button).
     15  4202							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  4202							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  4202
     18  4202		       00 10	   RP_SLOTS   equ	16
     19  4202		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  4202
     21  4202							; REPEAT is on now?
     22  4202				   RepeatActive
     23  4202		       ad 4b c5 	      lda	repeatOn
     24  4205		       0d ab c4 	      ora	actCnt+A_REPEAT
     25  4208		       60		      rts
     26  4209
