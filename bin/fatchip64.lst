     29  7234		       ae 99 c6 	      ldx	sndClick
     30  7237		       e0 02		      cpx	#2
     31  7239		       90 03		      bcc	.cl
     32  723b		       ad 98 c6 	      lda	sndStepT
     33  723e				   .cl
     34  723e		       d9 6d c9 	      cmp	atkT,y
     35  7241		       f0 02		      beq	.ce
     36  7243		       b0 0e		      bcs	.s
     37  7245				   .ce
     38  7245		       a9 00		      lda	#0
     39  7247		       99 70 c9 	      sta	clickOn,y
     40  724a		       be 98 81 	      ldx	sidOfs,y
     41  724d		       b9 32 c3 	      lda	sidGate,y
     42  7250		       9d 04 d4 	      sta	SID+4,x
     43  7253				   .s
     44  7253		       b9 66 c9 	      lda	sK,y
     45  7256		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  7258		       d0 19		      bne	.x
