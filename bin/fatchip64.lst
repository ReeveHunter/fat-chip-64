------- FILE attack.asm LEVEL 2 PASS 3
      0  74c4					      include	"attack.asm"
      1  74c4							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  74c4							; how each note starts and ends in pitch
      3  74c4							;
      4  74c4							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  74c4							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  74c4							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  74c4							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  74c4							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  74c4							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  74c4							;   (v0.42) as long as TIME.
     11  74c4							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  74c4							;   release rings.
     13  74c4
     14  74c4							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  74c4							; jumps to the note
     16  74c4				   AtkStep
     17  74c4					      subroutine
     18  74c4		       ac cb c3 	      ldy	envY
     19  74c7		       b9 75 c9 	      lda	atkT,y
     20  74ca		       18		      clc
     21  74cb		       6d 5e c4 	      adc	fxN
     22  74ce		       90 02		      bcc	.t
     23  74d0		       a9 ff		      lda	#255
     24  74d2				   .t
     25  74d2		       99 75 c9 	      sta	atkT,y
     26  74d5		       b9 78 c9 	      lda	clickOn,y
     27  74d8		       f0 21		      beq	.s
     28  74da		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  74dc		       ae a1 c6 	      ldx	sndClick
     30  74df		       e0 02		      cpx	#2
     31  74e1		       90 03		      bcc	.cl
     32  74e3		       ad a0 c6 	      lda	sndStepT
     33  74e6				   .cl
     34  74e6		       d9 75 c9 	      cmp	atkT,y
     35  74e9		       f0 02		      beq	.ce
     36  74eb		       b0 0e		      bcs	.s
     37  74ed				   .ce
     38  74ed		       a9 00		      lda	#0
     39  74ef		       99 78 c9 	      sta	clickOn,y
     40  74f2		       be 40 84 	      ldx	sidOfs,y
     41  74f5		       b9 36 c3 	      lda	sidGate,y
     42  74f8		       9d 04 d4 	      sta	SID+4,x
     43  74fb				   .s
     44  74fb		       b9 6e c9 	      lda	sK,y
     45  74fe		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  7500		       d0 19		      bne	.x
     47  7502		       b9 75 c9 	      lda	atkT,y
     48  7505		       cd a0 c6 	      cmp	sndStepT
     49  7508		       90 11		      bcc	.x
     50  750a		       b9 68 c4 	      lda	sidTgtLo,y	; TIME's up: the note
     51  750d		       99 ea c3 	      sta	sidBaseLo,y
     52  7510		       b9 6b c4 	      lda	sidTgtHi,y
     53  7513		       99 ed c3 	      sta	sidBaseHi,y
     54  7516		       a9 00		      lda	#0
     55  7518		       99 6e c9 	      sta	sK,y
     56  751b				   .x
     57  751b		       60		      rts
     58  751c
     59  751c							; a SID voice's gate went on (Y = SID voice, t2 = its registers): the CLICK
     60  751c							; starts. Keeps Y.
     61  751c				   ClickOn
     62  751c					      subroutine
     63  751c		       ad a1 c6 	      lda	sndClick
