     94  67ba		       c9 02		      cmp	#2
     95  67bc		       f0 4a		      beq	.glide
     96  67be		       d0 37		      bne	.attack
     97  67c0				   .wander
     98  67c0		       bd 5e c8 	      lda	vWaitOn,x
