------- FILE attack.asm LEVEL 2 PASS 3
      0  6a44					      include	"attack.asm"
      1  6a44							; Fat Chip 64 - ATTACK, BEND IN, BEND OUT (v0.30): how each note starts and
      2  6a44							; ends in pitch
      3  6a44							;
      4  6a44							; ATTACK (the SID): BLIP: an octave up for one BLIP STEP, then the note
      5  6a44							;   (OCTAVE + 5TH: an octave, a fifth, the note; 2 OCTAVES: two up, one up,
      6  6a44							;   the note); CLICK: the first 20 ms as noise.
      7  6a44							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      8  6a44							;   a scoop) and bends to its pitch over TIME: the SID and NES slide it (the
      9  6a44							;   SID per voice, the NES with its glide), the Game Boy has its own pitch
     10  6a44							;   envelope (CC 80 / 81).
     11  6a44							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  6a44							;   release rings.
     13  6a44
     14  6a44							; SidFxs pitch loop, SID voice envY: ATTACK's clock; the CLICK ends
     15  6a44				   AtkStep
     16  6a44					      subroutine
     17  6a44		       ac c2 c3 	      ldy	envY
     18  6a47		       b9 68 c9 	      lda	atkT,y
     19  6a4a		       18		      clc
     20  6a4b		       6d 51 c4 	      adc	fxN
     21  6a4e		       90 02		      bcc	.t
     22  6a50		       a9 ff		      lda	#255
     23  6a52				   .t
     24  6a52		       99 68 c9 	      sta	atkT,y
     25  6a55		       b9 6b c9 	      lda	clickOn,y
     26  6a58		       f0 15		      beq	.x
