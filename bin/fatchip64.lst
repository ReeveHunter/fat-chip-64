     39  ca8c ????	       03 ff	   TICK_LATCH_MS equ	1023	; with the MIDI chip's interrupts (midiIrq): 1 ms
     40  ca8c ????	       00 ff	   TICK_LATCH equ	255	; CIA1 timer A: 256 cycles = 1/4 ms (NTSC), quicker
     41  ca8c ????						; than a MIDI byte (327 cycles), so the ACIA is fed
     42  ca8c ????						; and read (MIDI in) even while the main loop is
