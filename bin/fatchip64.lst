------- FILE main.asm LEVEL 1 PASS 2
      1  2f14 ????						; Fat Chip 64 - main program
      2  2f14 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  2f14 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  2f14 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  2f14 ????
      6  2f14 ????				      processor	6502
