------- FILE main.asm
------- FILE devices.asm LEVEL 2 PASS 3
      0  5e2d					      include	"devices.asm"
      1  5e2d							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  5e2d							; are in use, and each one in use gets its page on the main menu.
      3  5e2d							;
      4  5e2d							; YAMAHA SHS-10 (the keytar)
      5  5e2d							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  5e2d							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  5e2d							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  5e2d							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  5e2d							;		     can play at once.)
     10  5e2d							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  5e2d							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  5e2d							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  5e2d							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  5e2d							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  5e2d							;		     louder (the SID and the NES; the Game Boy would click) or
     16  5e2d							;		     brighter (the SID's filter: switched on if the patch has
     17  5e2d							;		     none)
     18  5e2d							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  5e2d							;		     the patch's, or the ADVANCED amounts if it has none;
     20  5e2d							;		     FILTER), or an action held while blowing hard
     21  5e2d							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  5e2d							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  5e2d							;   PORTAMENTO BUTTON	an action (CC 65)
     24  5e2d							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  5e2d							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  5e2d							; ATARI SYNTHCART
     27  5e2d							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  5e2d							;		     about 3% while held, SHIFT + , . step through the ten
     29  5e2d							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  5e2d							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  5e2d							;		     sound's cents (the Synthcart manual's table: each Atari
     32  5e2d							;		     sound plays its scales in its own key, a little off)
     33  5e2d							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  5e2d
     35  5e2d		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  5e2d		       00 28	   BREATH_LO  equ	40
     37  5e2d		       00 01	   BFX_VIB    equ	1
     38  5e2d		       00 02	   BFX_WARB   equ	2
     39  5e2d		       00 03	   BFX_DET    equ	3
     40  5e2d		       00 04	   BFX_FILT   equ	4
     41  5e2d		       00 05	   BFX_HELD   equ	5
     42  5e2d
     43  5e2d							; the devices' settings -> what the MIDI code checks
     44  5e2d				   SyncDerive
     45  5e2d					      subroutine
     46  5e2d		       a2 01		      ldx	#TEMPO_OWN
     47  5e2f		       ad 35 c8 	      lda	useShs
     48  5e32		       f0 09		      beq	.t1
     49  5e34		       ad 38 c8 	      lda	shsTempo
     50  5e37		       d0 04		      bne	.t1
     51  5e39		       a2 00		      ldx	#TEMPO_KEYTAR
     52  5e3b		       d0 0c		      bne	.t
     53  5e3d				   .t1
     54  5e3d		       ad 37 c8 	      lda	useSc
     55  5e40		       f0 07		      beq	.t
     56  5e42		       ad 42 c8 	      lda	scSync
     57  5e45		       f0 02		      beq	.t
     58  5e47		       a2 02		      ldx	#TEMPO_SC
