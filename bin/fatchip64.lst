    147  555a		       a5 26		      lda	t2
    148  555c		       8d f7 c5 	      sta	clk16L
    149  555f		       a5 27		      lda	t3
    150  5561		       8d f8 c5 	      sta	clk16H
    151  5564		       a9 02		      lda	#2
