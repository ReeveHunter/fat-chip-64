------- FILE attack.asm LEVEL 2 PASS 3
      0  7375					      include	"attack.asm"
      1  7375							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  7375							; how each note starts and ends in pitch
      3  7375							;
      4  7375							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  7375							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  7375							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  7375							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  7375							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  7375							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  7375							;   (v0.42) as long as TIME.
     11  7375							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  7375							;   release rings.
     13  7375
     14  7375							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  7375							; jumps to the note
     16  7375				   AtkStep
     17  7375					      subroutine
     18  7375		       ac cb c3 	      ldy	envY
     19  7378		       b9 75 c9 	      lda	atkT,y
     20  737b		       18		      clc
     21  737c		       6d 5e c4 	      adc	fxN
     22  737f		       90 02		      bcc	.t
     23  7381		       a9 ff		      lda	#255
     24  7383				   .t
     25  7383		       99 75 c9 	      sta	atkT,y
     26  7386		       b9 78 c9 	      lda	clickOn,y
     27  7389		       f0 21		      beq	.s
     28  738b		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  738d		       ae a1 c6 	      ldx	sndClick
     30  7390		       e0 02		      cpx	#2
     31  7392		       90 03		      bcc	.cl
     32  7394		       ad a0 c6 	      lda	sndStepT
     33  7397				   .cl
     34  7397		       d9 75 c9 	      cmp	atkT,y
     35  739a		       f0 02		      beq	.ce
     36  739c		       b0 0e		      bcs	.s
     37  739e				   .ce
     38  739e		       a9 00		      lda	#0
     39  73a0		       99 78 c9 	      sta	clickOn,y
     40  73a3		       be f1 82 	      ldx	sidOfs,y
     41  73a6		       b9 36 c3 	      lda	sidGate,y
     42  73a9		       9d 04 d4 	      sta	SID+4,x
     43  73ac				   .s
     44  73ac		       b9 6e c9 	      lda	sK,y
     45  73af		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  73b1		       d0 19		      bne	.x
     47  73b3		       b9 75 c9 	      lda	atkT,y
     48  73b6		       cd a0 c6 	      cmp	sndStepT
     49  73b9		       90 11		      bcc	.x
     50  73bb		       b9 68 c4 	      lda	sidTgtLo,y	; TIME's up: the note
     51  73be		       99 ea c3 	      sta	sidBaseLo,y
     52  73c1		       b9 6b c4 	      lda	sidTgtHi,y
     53  73c4		       99 ed c3 	      sta	sidBaseHi,y
     54  73c7		       a9 00		      lda	#0
     55  73c9		       99 6e c9 	      sta	sK,y
     56  73cc				   .x
     57  73cc		       60		      rts
     58  73cd
     59  73cd							; a SID voice's gate went on (Y = SID voice, t2 = its registers): the CLICK
     60  73cd							; starts. Keeps Y.
     61  73cd				   ClickOn
     62  73cd					      subroutine
     63  73cd		       ad a1 c6 	      lda	sndClick
     64  73d0		       f0 11		      beq	.x
     65  73d2		       a9 01		      lda	#1
     66  73d4		       99 78 c9 	      sta	clickOn,y
     67  73d7		       b9 36 c3 	      lda	sidGate,y
     68  73da		       29 01		      and	#1
