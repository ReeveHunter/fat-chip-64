------- FILE drums.asm LEVEL 2 PASS 3
      0  400d					      include	"drums.asm"
      1  400d							; Fat Chip 64 - drums on the MidiNES
      2  400d							;
      3  400d							; Two sources, one kit:
      4  400d							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  400d							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  400d							;			   64 = hit, 56 = ghost)
      7  400d							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  400d							;			   RETURN starts / stops it, at its own tempo (B taps
      9  400d							;			   a new one)
     10  400d							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  400d							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  400d							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  400d							; a note-on, then a note-off after the sound's length, the level set with
     14  400d							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  400d							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  400d
     17  400d		       00 0c	   KIT_SIZE   equ	12
     18  400d		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  400d		       00 00	   DK_KICK    equ	0
     20  400d		       00 01	   DK_SNARE   equ	1
     21  400d		       00 02	   DK_CH      equ	2
     22  400d		       00 03	   DK_OH      equ	3
     23  400d		       00 04	   DK_CY      equ	4
     24  400d		       00 05	   DK_TOM     equ	5
     25  400d		       00 06	   DK_PERC    equ	6
     26  400d
