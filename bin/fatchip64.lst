    134  34b4		       20 5d 50 	      jsr	KeytarStop
    135  34b7				   .rt3
    136  34b7		       4c 42 34 	      jmp	.next
    137  34ba				   .second
    138  34ba		       8d 29 c4 	      sta	rxD2
    139  34bd		       a9 00		      lda	#0
