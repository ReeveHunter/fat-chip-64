    109  2f5b		       20 33 31 	      jsr	SysexByte
    110  2f5e		       4c 21 2f 	      jmp	.next
    111  2f61				   .nosx
    112  2f61		       ae 26 c4 	      ldx	rxStatus
    113  2f64		       f0 bb		      beq	.next	; no status yet
    114  2f66		       ae 27 c4 	      ldx	rxCnt
    115  2f69		       d0 2e		      bne	.second
    116  2f6b		       8d 28 c4 	      sta	rxD1
