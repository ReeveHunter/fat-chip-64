    445  0b76		       4a		      lsr		; a byte in?
    446  0b77		       90 03		      bcc	.tx
    447  0b79		       20 f2 3a 	      jsr	RxGot
    448  0b7c				   .tx
    449  0b7c		       ad 06 de 	      lda	ACIA_STAT
    450  0b7f		       29 02		      and	#ACIA_TDRE
    451  0b81		       f0 16		      beq	.tim
