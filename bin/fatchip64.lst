    164  3988				   .notes
    165  3988		       c9 0b		      cmp	#MIDI_IN_CHANS
    166  398a		       b0 36		      bcs	.x	; channels 12-15: the keytar's accompaniment
    167  398c		       85 27		      sta	t3
    168  398e		       ad 2b c4 	      lda	rxStatus
    169  3991		       29 f0		      and	#$F0
