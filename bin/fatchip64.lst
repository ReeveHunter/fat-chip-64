------- FILE main.asm
------- FILE drums.asm LEVEL 2 PASS 3
      0  4f9e					      include	"drums.asm"
      1  4f9e							; Fat Chip 64 - drums on the MidiNES
      2  4f9e							;
      3  4f9e							; Two sources, one kit:
      4  4f9e							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  4f9e							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  4f9e							;			   64 = hit, 56 = ghost)
      7  4f9e							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  4f9e							;			   RETURN starts / stops it, at its own tempo (B taps
      9  4f9e							;			   a new one)
     10  4f9e							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  4f9e							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  4f9e							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  4f9e							; a note-on, then a note-off after the sound's length, the level set with
     14  4f9e							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  4f9e							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  4f9e
     17  4f9e		       00 0c	   KIT_SIZE   equ	12
     18  4f9e		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  4f9e		       00 00	   DK_KICK    equ	0
     20  4f9e		       00 01	   DK_SNARE   equ	1
     21  4f9e		       00 02	   DK_CH      equ	2
     22  4f9e		       00 03	   DK_OH      equ	3
     23  4f9e		       00 04	   DK_CY      equ	4
     24  4f9e		       00 05	   DK_TOM     equ	5
     25  4f9e		       00 06	   DK_PERC    equ	6
     26  4f9e
