     85  0898		       8d fe ff 	      sta	$FFFE
     86  089b		       a9 09		      lda	#>Irq
     87  089d		       8d ff ff 	      sta	$FFFF
     88  08a0		       a9 3d		      lda	#<Nmi
     89  08a2		       8d fa ff 	      sta	$FFFA
     90  08a5		       a9 09		      lda	#>Nmi
     91  08a7		       8d fb ff 	      sta	$FFFB
     92  08aa							; 1 ms timer
     93  08aa		       a9 54		      lda	#<TICK_LATCH
     94  08ac		       8d 04 dc 	      sta	CIA1_TALO
     95  08af		       a9 01		      lda	#>TICK_LATCH
     96  08b1		       8d 05 dc 	      sta	CIA1_TAHI
