     64  2a2c		       20 77 4b 	      jsr	Mul8
     65  2a2f		       4e 39 c9 	      lsr	mt16+1
     66  2a32		       6e 38 c9 	      ror	mt16
     67  2a35		       4e 39 c9 	      lsr	mt16+1
     68  2a38		       6e 38 c9 	      ror	mt16
     69  2a3b		       a4 27		      ldy	t3
     70  2a3d		       a6 26		      ldx	t2
     71  2a3f		       ad 39 c9 	      lda	mt16+1
     72  2a42		       d0 0b		      bne	.max
     73  2a44		       ad 38 c9 	      lda	mt16
     74  2a47		       c9 ff		      cmp	#255
     75  2a49		       b0 04		      bcs	.max
     76  2a4b		       69 01		      adc	#1
     77  2a4d		       d0 02		      bne	.rel
     78  2a4f				   .max
     79  2a4f		       a9 ff		      lda	#255
     80  2a51				   .rel
     81  2a51		       99 89 c8 	      sta	envRel,y
     82  2a54		       a9 04		      lda	#ENV_R
     83  2a56		       99 81 c8 	      sta	envPh,y
     84  2a59		       20 a7 2a 	      jsr	RdBend	; BEND OUT: it sags as it fades
     85  2a5c		       38		      sec
     86  2a5d		       60		      rts
     87  2a5e				   .tri
     88  2a5e					      if	TRI_DROP_PADS == 0
     89  2a5e		       4c 90 2a 	      jmp	.fo	; PADS: the bass just stops (Reeve, 2026-11-01)
     90  2a61					      endif
     91  2a61		       bd f0 88 	      lda	vIdx,x
     92  2a64		       c9 02		      cmp	#2
     93  2a66		       d0 3d		      bne	.no
     94  2a68		       bd 2f cc 	      lda	vSent,x	; the note actually sounding
     95  2a6b		       c9 16		      cmp	#TRI_FLOOR+1
     96  2a6d		       90 36		      bcc	.no	; already at the bottom: just cut
     97  2a6f		       8d 93 c8 	      sta	triNote
     98  2a72		       a9 00		      lda	#0
     99  2a74		       8d 92 c8 	      sta	triK
    100  2a77		       20 a8 24 	      jsr	GetTicks
    101  2a7a		       ad 03 c8 	      lda	nowL
    102  2a7d		       8d 94 c8 	      sta	triLast
