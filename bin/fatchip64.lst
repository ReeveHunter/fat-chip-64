------- FILE drums.asm LEVEL 2 PASS 3
      0  3b8f					      include	"drums.asm"
      1  3b8f							; Fat Chip 64 - drums on the MidiNES
      2  3b8f							;
      3  3b8f							; Two sources, one kit:
      4  3b8f							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  3b8f							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  3b8f							;			   64 = hit, 56 = ghost)
      7  3b8f							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  3b8f							;			   RETURN starts / stops it, at its own tempo (B taps
      9  3b8f							;			   a new one)
     10  3b8f							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  3b8f							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  3b8f							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  3b8f							; a note-on, then a note-off after the sound's length, the level set with
     14  3b8f							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  3b8f							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  3b8f
     17  3b8f		       00 0c	   KIT_SIZE   equ	12
     18  3b8f		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  3b8f		       00 00	   DK_KICK    equ	0
     20  3b8f		       00 01	   DK_SNARE   equ	1
     21  3b8f		       00 02	   DK_CH      equ	2
     22  3b8f		       00 03	   DK_OH      equ	3
     23  3b8f		       00 04	   DK_CY      equ	4
     24  3b8f		       00 05	   DK_TOM     equ	5
     25  3b8f		       00 06	   DK_PERC    equ	6
     26  3b8f
     27  3b8f							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  3b8f				   DrumHit
     29  3b8f					      subroutine
     30  3b8f		       8d 83 c4 	      sta	drumKind
     31  3b92		       8e 82 c4 	      stx	drumLvl
     32  3b95		       8c 84 c4 	      sty	drumTom
