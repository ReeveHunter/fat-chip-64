------- FILE main.asm LEVEL 1 PASS 2
      1  211d ????						; Fat Chip 64 - main program
      2  211d ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  211d ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  211d ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  211d ????
      6  211d ????				      processor	6502
