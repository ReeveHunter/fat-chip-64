------- FILE midi.asm LEVEL 2 PASS 2
      0  094a					      include	"midi.asm"
      1  094a							; Fat Chip 64 - MIDI out
      2  094a							;
      3  094a							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  094a							; at most one message per device onto the wire buffer, no sooner than that
      5  094a							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  094a							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  094a							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  094a							; paced; the MidiNES only gets the wire's own limit for now.
      9  094a							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  094a
     11  094a				   MidiInit
     12  094a					      subroutine
     13  094a		       a9 03		      lda	#ACIA_RESET
     14  094c		       8d 04 de 	      sta	ACIA_CTRL
     15  094f		       a9 16		      lda	#ACIA_MODE
     16  0951		       8d 04 de 	      sta	ACIA_CTRL
     17  0954		       60		      rts
     18  0955
     19  0955							; IRQ: send one wire byte if the ACIA is ready.
     20  0955				   TxByte
     21  0955					      subroutine
     22  0955		       a6 15		      ldx	wireTail
     23  0957		       e4 14		      cpx	wireHead
     24  0959		       f0 0f		      beq	.done
     25  095b		       ad 06 de 	      lda	ACIA_STAT
     26  095e		       29 02		      and	#ACIA_TDRE
     27  0960		       f0 08		      beq	.done
     28  0962		       bd 00 c0 	      lda	wireBuf,x
     29  0965		       8d 05 de 	      sta	ACIA_TX
     30  0968		       e6 15		      inc	wireTail
     31  096a				   .done
     32  096a		       60		      rts
     33  096b
     34  096b							; Main loop: same, with interrupts off around it.
     35  096b				   TxService
     36  096b					      subroutine
     37  096b		       08		      php
     38  096c		       78		      sei
     39  096d		       20 55 09 	      jsr	TxByte
     40  0970		       28		      plp
     41  0971		       60		      rts
     42  0972
     43  0972							; IRQ: pace device queues onto the wire.
     44  0972				   Schedule
     45  0972					      subroutine
     46  0972							; ---- Game Boy
     47  0972		       a5 17		      lda	gbqTail
     48  0974		       c5 16		      cmp	gbqHead
     49  0976		       f0 37		      beq	.nes
     50  0978		       a5 10		      lda	ticks	; due? (ticks - gbNext) >= 0
     51  097a		       38		      sec
     52  097b		       e5 18		      sbc	gbNext
     53  097d		       a5 11		      lda	ticks+1
     54  097f		       e5 19		      sbc	gbNext+1
