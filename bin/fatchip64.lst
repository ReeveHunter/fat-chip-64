------- FILE main.asm
------- FILE arp.asm LEVEL 2 PASS 3
      0  18d4					      include	"arp.asm"
      1  18d4							; Fat Chip 64 - tempo and arpeggiator
      2  18d4							;
      3  18d4							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  18d4							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  18d4							;
      6  18d4							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  18d4							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  18d4							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  18d4							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  18d4							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  18d4							;	     until its voice's next turn.
     12  18d4							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  18d4							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  18d4							;   J faster; either one also picks FREE).
     15  18d4							;
     16  18d4							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  18d4							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  18d4
     19  18d4							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  18d4							; between the two bytes: $22FF read as $23FF)
     21  18d4				   GetTicks
     22  18d4					      subroutine
     23  18d4		       08		      php
     24  18d5		       78		      sei
     25  18d6		       a5 10		      lda	ticks
     26  18d8		       8d 3e c3 	      sta	nowL
