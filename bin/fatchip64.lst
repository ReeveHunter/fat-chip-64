     96  4104		       a9 7f		      lda	#127
     97  4106				   .a
     98  4106		       cd 77 c4 	      cmp	dmcBank
     99  4109		       f0 0c		      beq	.note
    100  410b		       8d 77 c4 	      sta	dmcBank
    101  410e		       85 23		      sta	mD2
    102  4110		       a9 0e		      lda	#14
