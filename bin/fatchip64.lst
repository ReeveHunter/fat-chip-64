     23  84c6 ????						; Kerberos MIDI, DATEL emulation (MC6850 ACIA at $DE04-$DE07).
     24  84c6 ????						; Flash Fat Chip 64 with MIDI emulation = DATEL / Siel / JMS.
     25  84c6 ????	       de 04	   ACIA_CTRL  equ	$DE04
     26  84c6 ????	       de 05	   ACIA_TX    equ	$DE05
     27  84c6 ????	       de 06	   ACIA_STAT  equ	$DE06
     28  84c6 ????	       de 07	   ACIA_RX    equ	$DE07
     29  84c6 ????	       00 03	   ACIA_RESET equ	$03	; master reset
     30  84c6 ????	       00 16	   ACIA_MODE  equ	$16	; /64 (31250 baud), 8N1, no interrupts
     31  84c6 ????	       00 96	   ACIA_MODE_RX equ	$96	; ... and an interrupt when a byte comes in
     32  84c6 ????	       00 b6	   ACIA_MODE_TX equ	$B6	; ... and when the next byte can go out too
     33  84c6 ????	       00 02	   ACIA_TDRE  equ	$02	; status: transmit register empty
