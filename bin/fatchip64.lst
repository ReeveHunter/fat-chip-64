------- FILE screen.asm LEVEL 2 PASS 3
      0  75c2					      include	"screen.asm"
      1  75c2							; Fat Chip 64 - screen
      2  75c2							;
      3  75c2							;  row 0      header
      4  75c2							;  row 2      sound, POLY / MONO, Fat Bass
      5  75c2							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  75c2							;	       each plays (row 7: a channel overlap warning)
      7  75c2							;  row 9      key, notes mode, latch
      8  75c2							;  row 10     arp
      9  75c2							;  row 12     tempo, beat, mute
     10  75c2							;  row 13     SPACE's action, octave (the lowest key), transpose
     11  75c2							;  row 14     v0.40: the effect the C= keys work on, its setting
     12  75c2							;  row 15     held notes
     13  75c2							;  row 16     MIDI in
     14  75c2							;  row 24     F keys
     15  75c2
     16  75c2							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
