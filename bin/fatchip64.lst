    144  3b54							; A full message: rxStatus, rxD1, rxD2
    145  3b54				   MidiInMsg
    146  3b54					      subroutine
    147  3b54		       ad f3 c8 	      lda	rxStatus
    148  3b57		       29 0f		      and	#15
    149  3b59		       c9 0f		      cmp	#DRUM_CH_IN	; channel 16: the keytar's rhythm
    150  3b5b		       d0 1d		      bne	.notes
    151  3b5d		       ad f3 c8 	      lda	rxStatus
