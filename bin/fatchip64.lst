     76  1cfe		       9d 4c c3 	      sta	tapRingHi,x
     77  1d01		       e8		      inx
     78  1d02		       8a		      txa
     79  1d03		       29 03		      and	#3
     80  1d05		       8d 47 c3 	      sta	tapPos
