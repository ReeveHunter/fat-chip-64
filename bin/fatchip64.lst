     97  1e22		       8d c7 c3 	      sta	triNote
     98  1e25		       a9 00		      lda	#0
     99  1e27		       8d c6 c3 	      sta	triK
    100  1e2a		       20 d4 18 	      jsr	GetTicks
    101  1e2d		       ad 3e c3 	      lda	nowL
