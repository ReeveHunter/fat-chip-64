------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  376c					      include	"midiin.asm"
      1  376c							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  376c							;
      3  376c							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  376c							; The main loop parses them (running status; realtime and system bytes are
      5  376c							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  376c							; notes mode, latch, arp and K + note.
      7  376c							;
      8  376c							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  376c							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  376c							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  376c							;
     12  376c							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  376c							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  376c							;
     15  376c							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  376c							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  376c							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  376c							; MIDI in is passed on to the Game Boy or NES.
     19  376c
     20  376c							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  376c							; Uses A, X.
     22  376c							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  376c							; with the time; a Start ($FA) makes the next clock a beat.
     24  376c				   RxByte
     25  376c					      subroutine
     26  376c		       ad 06 de 	      lda	ACIA_STAT
     27  376f		       4a		      lsr		; RDRF -> carry
     28  3770		       90 2b		      bcc	.x
     29  3772				   RxGot
     30  3772		       ad 07 de 	      lda	ACIA_RX
     31  3775		       c9 f8		      cmp	#$F8
     32  3777		       f0 25		      beq	.clk
     33  3779		       c9 fa		      cmp	#$FA
     34  377b		       d0 0e		      bne	.buf
     35  377d		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  377f		       8e e9 c5 	      stx	clkPhase
     37  3782		       8e f1 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3785							;  the main loop could measure it)
     39  3785		       ae ea c5 	      ldx	clkBeat
     40  3788		       8e fc c5 	      stx	clkStartBeat
     41  378b				   .buf
