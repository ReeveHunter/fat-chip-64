      0  243f					      include	"nesenv.asm"
      1  243f							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  243f							;
      3  243f							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  243f							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  243f							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  243f							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  243f							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  243f							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  243f							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  243f							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  243f							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  243f							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  243f							; would wrap to a high pitch).
     14  243f							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  243f
     16  243f							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  243f							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  243f							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  243f							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  243f							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  243f		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  243f		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  243f							; NES channels too, and can't take a bend every 4 ms
     24  243f		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  243f		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  243f
     27  243f							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  243f		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  2448		       02 05	   slotVoice  .byte.b	2,5
     30  244a
     31  244a							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  244a							; note keeps sounding for now). X = voice (= t0).
