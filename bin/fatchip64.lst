    121  3b20		       d0 a7		      bne	.next
    122  3b22		       a9 00		      lda	#0
    123  3b24		       8d f4 c8 	      sta	rxCnt
    124  3b27		       20 4f 3b 	      jsr	MidiInMsg
    125  3b2a		       4c c9 3a 	      jmp	.next
    126  3b2d				   .rt
