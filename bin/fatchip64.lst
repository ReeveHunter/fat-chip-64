     89  0bc1							; Main loop: same, with interrupts off around it.
     90  0bc1				   TxService
     91  0bc1					      subroutine
     92  0bc1		       a5 2f		      lda	midiIrq	; (the MIDI chip's interrupts do it)
     93  0bc3		       f0 01		      beq	.poll
     94  0bc5		       60		      rts
     95  0bc6				   .poll
     96  0bc6		       08		      php
     97  0bc7		       78		      sei
