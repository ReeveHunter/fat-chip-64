     86  32b7		       8a		      txa
     87  32b8		       29 3f		      and	#63
     88  32ba		       8d 25 c4 	      sta	rxTail
     89  32bd		       98		      tya
     90  32be		       10 1e		      bpl	.data
     91  32c0		       c9 f8		      cmp	#$F8
     92  32c2		       b0 49		      bcs	.rt	; realtime (clocks are counted by RxByte)
     93  32c4		       c9 f0		      cmp	#$F0
     94  32c6		       b0 07		      bcs	.sys
     95  32c8		       a2 00		      ldx	#0	; a channel message ends any SysEx
     96  32ca		       8e 4c c7 	      stx	sxOn
     97  32cd		       f0 05		      beq	.status
     98  32cf				   .sys
     99  32cf		       20 7a 34 	      jsr	SysexStatus	; F0 starts a SysEx, F7 ends it (v0.20)
    100  32d2		       a9 00		      lda	#0	; system: no running status until the next one
    101  32d4				   .status
    102  32d4		       8d 26 c4 	      sta	rxStatus
    103  32d7		       a9 00		      lda	#0
    104  32d9		       8d 27 c4 	      sta	rxCnt
    105  32dc		       f0 cb		      beq	.next
    106  32de				   .data
