------- FILE menu.asm LEVEL 2 PASS 3
      0  53e1					      include	"menu.asm"
      1  53e1							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  53e1							;
      3  53e1							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  53e1							;   page   RETURN opens a page
      5  53e1							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  53e1							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  53e1							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  53e1							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  53e1							; device pages, until DEVICES says the device is in use).
     10  53e1							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  53e1							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  53e1							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  53e1
     14  53e1		       00 17	   MENU_VALCOL equ	23
     15  53e1
     16  53e1				   MenuOpen
     17  53e1		       20 35 73 	      jsr	GlitchCalm	; (GLITCH may have the picture shaking)
