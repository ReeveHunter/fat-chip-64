      0  68bd					      include	"wander.asm"
      1  68bd							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  68bd							;
      3  68bd							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  68bd							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  68bd							;   ATTACK   as always: the new notes start
      6  68bd							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  68bd							;	      has none)
      8  68bd							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  68bd							;	      start again
     10  68bd							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  68bd							;	      late; some glide, some start again (fade out, come back in)
     12  68bd							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  68bd							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  68bd							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  68bd							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  68bd
     17  68bd		       00 01	   CHG_ATTACK equ	1
     18  68bd		       00 02	   CHG_GLIDE  equ	2
     19  68bd		       00 03	   CHG_STAGGER equ	3
     20  68bd		       00 04	   CHG_WANDER equ	4
     21  68bd		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  68bd		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  68bd
