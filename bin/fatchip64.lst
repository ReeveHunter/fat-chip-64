------- FILE arp.asm LEVEL 2 PASS 3
      0  1a19					      include	"arp.asm"
      1  1a19							; Fat Chip 64 - tempo and arpeggiator
      2  1a19							;
      3  1a19							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1a19							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1a19							;
      6  1a19							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1a19							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1a19							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1a19							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1a19							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1a19							;	     until its voice's next turn.
     12  1a19							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1a19							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1a19							;   J faster; either one also picks FREE).
     15  1a19							;
     16  1a19							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1a19							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1a19
     19  1a19							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1a19							; between the two bytes: $22FF read as $23FF)
     21  1a19				   GetTicks
     22  1a19					      subroutine
     23  1a19		       08		      php
     24  1a1a		       78		      sei
     25  1a1b		       a5 10		      lda	ticks
     26  1a1d		       8d 3e c3 	      sta	nowL
     27  1a20		       a5 11		      lda	ticks+1
     28  1a22		       8d 3f c3 	      sta	nowH
     29  1a25		       28		      plp
     30  1a26		       60		      rts
     31  1a27
