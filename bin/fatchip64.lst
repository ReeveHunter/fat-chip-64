    123  535c							; 250 ms .. 2 s (1000 .. 8000 quarters), else start the average again
    124  535c		       a5 27		      lda	t3
    125  535e		       c9 03		      cmp	#>1000
    126  5360		       90 10		      bcc	.bad0
    127  5362		       d0 06		      bne	.hi
    128  5364		       a5 26		      lda	t2
    129  5366		       c9 e8		      cmp	#<1000
