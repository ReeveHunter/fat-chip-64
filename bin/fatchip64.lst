    142  0f04							; A = key code at ksCol / ksRow
    143  0f04				   KeyCode
    144  0f04					      subroutine
    145  0f04		       ad 37 c3 	      lda	ksCol
    146  0f07		       0a		      asl
    147  0f08		       0a		      asl
    148  0f09		       0a		      asl
    149  0f0a		       0d 38 c3 	      ora	ksRow
    150  0f0d		       a8		      tay
    151  0f0e		       b9 5e 6e 	      lda	keymap,y
    152  0f11		       60		      rts
    153  0f12
    154  0f12							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    155  0f12							; keys: some other column has a key in this row and shares another row with
    156  0f12							; this column.
    157  0f12				   Suspect
    158  0f12					      subroutine
    159  0f12		       ac 38 c3 	      ldy	ksRow
    160  0f15		       b9 56 6e 	      lda	rowBit,y
    161  0f18		       49 ff		      eor	#$FF
    162  0f1a		       ae 37 c3 	      ldx	ksCol
    163  0f1d		       3d 80 c2 	      and	keyNow,x
    164  0f20		       8d 39 c3 	      sta	ksMask	; this column's other held rows
    165  0f23		       f0 1c		      beq	.no
    166  0f25		       a2 07		      ldx	#7
    167  0f27				   .c
    168  0f27		       ec 37 c3 	      cpx	ksCol
    169  0f2a		       f0 12		      beq	.n
    170  0f2c		       bd 80 c2 	      lda	keyNow,x
    171  0f2f		       39 56 6e 	      and	rowBit,y
    172  0f32		       f0 0a		      beq	.n
    173  0f34		       bd 80 c2 	      lda	keyNow,x
    174  0f37		       2d 39 c3 	      and	ksMask
    175  0f3a		       f0 02		      beq	.n
    176  0f3c		       38		      sec
    177  0f3d		       60		      rts
    178  0f3e				   .n
    179  0f3e		       ca		      dex
    180  0f3f		       10 e6		      bpl	.c
    181  0f41				   .no
    182  0f41		       18		      clc
    183  0f42		       60		      rts
    184  0f43
    185  0f43							; A = key code (v0.22 layout)
    186  0f43							;   overlay	    notes
    187  0f43							;   A S D F G	    bank (FAT PADS LEADS BASS FX): switches at once, same slot
    188  0f43							;   Z X C V B	    patch 1-5 in the bank
    189  0f43							;   L		    latch on / off	      K, then a note or a shape: key + scale
    190  0f43							;   =		    tap tempo		      , / .  tempo -1 / +1 (SHIFT: 10)
    191  0f43							;   /		    mute		      SHIFT+/  the dice
    192  0f43							;   ; / :	    free arp speed	      SPACE  its action
    193  0f43							;   F1 / F3	    octave up / down	      F5  arp on / off	  F7  visualizer
    194  0f43							;   RETURN	    the menu		      CTRL+F3/F5  GB / NES channel block
    195  0f43							;   C= +  A S D F  arp type / pattern / speed / SPARKLE octave
    196  0f43							;	   Z X C    notes mode / extensions / POLY-MONO     L  latch style
    197  0f43							;	   , .	    SPACE's action	      ; :  MIDI in octave down / up
    198  0f43							;	   /	    undo the dice	      F1 F3 F5	SID / GB / NES on-off
    199  0f43							;	   F7	    panic		      (SHIFT + F keys too, as before)
    200  0f43							;   RUN/STOP	    tapped: beat start / stop; held + A S D F G H: pick a beat
    201  0f43				   KeyDown
    202  0f43					      subroutine
    203  0f43		       c9 18		      cmp	#24
