     65  1fd4		       4e 6d c4 	      lsr	mt16+1
     66  1fd7		       6e 6c c4 	      ror	mt16
     67  1fda		       4e 6d c4 	      lsr	mt16+1
     68  1fdd		       6e 6c c4 	      ror	mt16
     69  1fe0		       a4 27		      ldy	t3
     70  1fe2		       a6 26		      ldx	t2
     71  1fe4		       ad 6d c4 	      lda	mt16+1
     72  1fe7		       d0 0b		      bne	.max
     73  1fe9		       ad 6c c4 	      lda	mt16
     74  1fec		       c9 ff		      cmp	#255
     75  1fee		       b0 04		      bcs	.max
     76  1ff0		       69 01		      adc	#1
     77  1ff2		       d0 02		      bne	.rel
     78  1ff4				   .max
