    148  0fa6							; A = key code at ksCol / ksRow
    149  0fa6				   KeyCode
    150  0fa6					      subroutine
    151  0fa6		       ad 3c c3 	      lda	ksCol
    152  0fa9		       0a		      asl
    153  0faa		       0a		      asl
    154  0fab		       0a		      asl
    155  0fac		       0d 3d c3 	      ora	ksRow
    156  0faf		       a8		      tay
    157  0fb0		       b9 2b 82 	      lda	keymap,y
    158  0fb3		       60		      rts
