------- FILE midiin.asm LEVEL 2 PASS 3
      0  3a72					      include	"midiin.asm"
      1  3a72							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  3a72							;
      3  3a72							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  3a72							; The main loop parses them (running status; realtime and system bytes are
      5  3a72							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  3a72							; notes mode, latch, arp and K + note.
      7  3a72							;
      8  3a72							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  3a72							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  3a72							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  3a72							;
     12  3a72							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  3a72							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  3a72							;
     15  3a72							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  3a72							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  3a72							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  3a72							; MIDI in is passed on to the Game Boy or NES.
     19  3a72
     20  3a72							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  3a72							; Uses A, X.
     22  3a72							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  3a72							; with the time; a Start ($FA) makes the next clock a beat.
     24  3a72				   RxByte
     25  3a72					      subroutine
     26  3a72		       ad 06 de 	      lda	ACIA_STAT
     27  3a75		       4a		      lsr		; RDRF -> carry
     28  3a76		       90 2b		      bcc	.x
     29  3a78				   RxGot
     30  3a78		       ad 07 de 	      lda	ACIA_RX
     31  3a7b		       c9 f8		      cmp	#$F8
     32  3a7d		       f0 25		      beq	.clk
     33  3a7f		       c9 fa		      cmp	#$FA
     34  3a81		       d0 0e		      bne	.buf
     35  3a83		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  3a85		       8e b5 ca 	      stx	clkPhase
     37  3a88		       8e bd ca 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3a8b							;  the main loop could measure it)
     39  3a8b		       ae b6 ca 	      ldx	clkBeat
     40  3a8e		       8e c8 ca 	      stx	clkStartBeat
     41  3a91				   .buf
     42  3a91		       ae f1 c8 	      ldx	rxHead
     43  3a94		       9d b1 c8 	      sta	rxBuf,x
     44  3a97		       e8		      inx
     45  3a98		       8a		      txa
     46  3a99		       29 3f		      and	#63
     47  3a9b		       cd f2 c8 	      cmp	rxTail
     48  3a9e		       f0 03		      beq	.x	; full: dropped
     49  3aa0		       8d f1 c8 	      sta	rxHead
     50  3aa3				   .x
     51  3aa3		       60		      rts
     52  3aa4				   .clk
     53  3aa4		       ee b1 ca 	      inc	clkCount
     54  3aa7		       ae b5 ca 	      ldx	clkPhase
     55  3aaa		       e8		      inx
     56  3aab		       e0 18		      cpx	#24
     57  3aad		       90 1b		      bcc	.ph
     58  3aaf		       a5 10		      lda	ticks
     59  3ab1		       8d b8 ca 	      sta	clkAtL
     60  3ab4		       a5 11		      lda	ticks+1
     61  3ab6		       8d b9 ca 	      sta	clkAtH
     62  3ab9		       a5 2d		      lda	subTick
     63  3abb		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  3abd		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  3abf		       ad 05 dc 	      lda	CIA1_TAHI
     66  3ac2				   .q
     67  3ac2		       8d ba ca 	      sta	clkAtS
     68  3ac5		       ee b6 ca 	      inc	clkBeat
     69  3ac8		       a2 00		      ldx	#0
     70  3aca				   .ph
     71  3aca		       8e b5 ca 	      stx	clkPhase
     72  3acd		       60		      rts
