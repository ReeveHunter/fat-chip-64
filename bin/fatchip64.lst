------- FILE main.asm
------- FILE menu.asm LEVEL 2 PASS 3
      0  60cb					      include	"menu.asm"
      1  60cb							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  60cb							;
      3  60cb							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  60cb							;   page   RETURN opens a page
      5  60cb							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  60cb							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  60cb							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  60cb							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  60cb							; device pages, until DEVICES says the device is in use).
     10  60cb							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  60cb							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  60cb							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  60cb
     14  60cb		       00 17	   MENU_VALCOL equ	23
     15  60cb
     16  60cb				   MenuOpen
     17  60cb		       20 b9 82 	      jsr	GlitchCalm	; (GLITCH may have the picture shaking)
     18  60ce		       a9 01		      lda	#1
     19  60d0		       8d fd cd 	      sta	colDirty	; (the play screen's dark rows: light green again)
     20  60d3		       8d 96 c8 	      sta	menuOn
     21  60d6		       a9 00		      lda	#0
     22  60d8		       8d 97 c8 	      sta	menuRow
     23  60db		       8d fc cd 	      sta	menuJump
     24  60de							; page A on screen (the cursor stays on its line if it's on this page)
