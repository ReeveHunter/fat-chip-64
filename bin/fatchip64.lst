     96  62ee				   .wander
     97  62ee		       bd 5e c8 	      lda	vWaitOn,x
     98  62f1		       d0 11		      bne	.waiting
     99  62f3		       a9 01		      lda	#1
    100  62f5		       9d 5e c8 	      sta	vWaitOn,x
