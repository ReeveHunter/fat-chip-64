     78  1d02		       8a		      txa
     79  1d03		       29 03		      and	#3
     80  1d05		       8d 47 c3 	      sta	tapPos
     81  1d08		       ad 46 c3 	      lda	tapN
     82  1d0b		       c9 04		      cmp	#4
     83  1d0d		       b0 03		      bcs	.avg
