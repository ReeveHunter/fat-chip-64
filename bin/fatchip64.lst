    162  6c4f		       ac 03 c6 	      ldy	glideK
    163  6c52		       d0 02		      bne	.sh
    164  6c54		       a0 02		      ldy	#2	; (glide switched off mid-slide: finish quickly)
    165  6c56				   .sh
    166  6c56		       ad 33 c5 	      lda	nfxH
    167  6c59		       c9 80		      cmp	#$80
    168  6c5b		       6e 33 c5 	      ror	nfxH
