------- FILE sounds.asm LEVEL 2 PASS 3
      0  339e					      include	"sounds.asm"
      1  339e							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  339e							;
      3  339e							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  339e							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  339e							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  339e							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  339e							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  339e							;
      9  339e							; Each sound has a mono default and a Fat Bass default:
     10  339e							;   MONO      one note (the last key pressed and still held) on every voice;
     11  339e							;	       a new key while another is held changes the pitch without a
     12  339e							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  339e							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  339e							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  339e							;	       the other voices
     16  339e							;
     17  339e							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  339e							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  339e							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  339e
     21  339e							; ------------------------------------------------------------ choosing
     22  339e							; V: next sound (SHIFT+V: previous)
     23  339e				   SoundKey
     24  339e					      subroutine
     25  339e		       20 18 34 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  33a1		       ae 94 c3 	      ldx	soundMode
     27  33a4		       ad 2a c3 	      lda	shiftDown
     28  33a7		       d0 09		      bne	.prev
     29  33a9		       e8		      inx
     30  33aa		       e0 13		      cpx	#NUM_SOUNDS
     31  33ac		       90 09		      bcc	.s
     32  33ae		       a2 00		      ldx	#0
     33  33b0		       f0 05		      beq	.s
     34  33b2				   .prev
     35  33b2		       ca		      dex
     36  33b3		       10 02		      bpl	.s
