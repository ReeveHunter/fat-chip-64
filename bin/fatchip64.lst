    125  7a3b		       f0 1f		      beq	.x
    126  7a3d		       38		      sec
    127  7a3e		       ed 66 cb 	      sbc	sndRdrop
    128  7a41		       20 5d 7a 	      jsr	NoteClamp
    129  7a44		       20 ea 21 	      jsr	SidPitch
    130  7a47		       a5 28		      lda	ptr
