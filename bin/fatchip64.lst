    444  6faa		       aa		      tax
    445  6fab		       ad 1d cd 	      lda	fineTune
    446  6fae		       38		      sec
    447  6faf		       e9 32		      sbc	#50
    448  6fb1		       18		      clc
    449  6fb2		       7d c8 70 	      adc	scCents,x
    450  6fb5		       50 00		      bvc	.c	; (can't overflow: -85..+60)
    451  6fb7				   .c
