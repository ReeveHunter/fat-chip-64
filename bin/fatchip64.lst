     76  3926					      subroutine
     77  3926				   .next
     78  3926		       ae 2a c4 	      ldx	rxTail
     79  3929		       ec 29 c4 	      cpx	rxHead
     80  392c		       d0 01		      bne	.byte
     81  392e		       60		      rts
     82  392f				   .byte
     83  392f		       bd e9 c3 	      lda	rxBuf,x
     84  3932		       a8		      tay
     85  3933		       e8		      inx
     86  3934		       8a		      txa
     87  3935		       29 3f		      and	#63
     88  3937		       8d 2a c4 	      sta	rxTail
     89  393a		       98		      tya
     90  393b		       10 1e		      bpl	.data
     91  393d		       c9 f8		      cmp	#$F8
     92  393f		       b0 49		      bcs	.rt	; realtime (clocks are counted by RxByte)
     93  3941		       c9 f0		      cmp	#$F0
     94  3943		       b0 07		      bcs	.sys
     95  3945		       a2 00		      ldx	#0	; a channel message ends any SysEx
     96  3947		       8e 51 c7 	      stx	sxOn
     97  394a		       f0 05		      beq	.status
     98  394c				   .sys
     99  394c		       20 04 3b 	      jsr	SysexStatus	; F0 starts a SysEx, F7 ends it (v0.20)
    100  394f		       a9 00		      lda	#0	; system: no running status until the next one
    101  3951				   .status
    102  3951		       8d 2b c4 	      sta	rxStatus
    103  3954		       a9 00		      lda	#0
    104  3956		       8d 2c c4 	      sta	rxCnt
    105  3959		       f0 cb		      beq	.next
    106  395b				   .data
    107  395b		       ae 51 c7 	      ldx	sxOn
    108  395e		       f0 06		      beq	.nosx
    109  3960		       20 45 3b 	      jsr	SysexByte
    110  3963		       4c 26 39 	      jmp	.next
    111  3966				   .nosx
    112  3966		       ae 2b c4 	      ldx	rxStatus
    113  3969		       f0 bb		      beq	.next	; no status yet
    114  396b		       ae 2c c4 	      ldx	rxCnt
    115  396e		       d0 2e		      bne	.second
    116  3970		       8d 2d c4 	      sta	rxD1
    117  3973		       ee 2c c4 	      inc	rxCnt
    118  3976		       ad 2b c4 	      lda	rxStatus
    119  3979		       29 e0		      and	#$E0
    120  397b		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
    121  397d		       d0 a7		      bne	.next
    122  397f		       a9 00		      lda	#0
    123  3981		       8d 2c c4 	      sta	rxCnt
    124  3984		       20 ac 39 	      jsr	MidiInMsg
    125  3987		       4c 26 39 	      jmp	.next
    126  398a				   .rt
    127  398a		       c9 fa		      cmp	#$FA
    128  398c		       d0 06		      bne	.rt2
    129  398e		       20 b8 56 	      jsr	KeytarStart
    130  3991		       4c 26 39 	      jmp	.next
    131  3994				   .rt2
    132  3994		       c9 fc		      cmp	#$FC
    133  3996		       d0 03		      bne	.rt3
    134  3998		       20 d9 56 	      jsr	KeytarStop
    135  399b				   .rt3
    136  399b		       4c 26 39 	      jmp	.next
    137  399e				   .second
    138  399e		       8d 2e c4 	      sta	rxD2
    139  39a1		       a9 00		      lda	#0
    140  39a3		       8d 2c c4 	      sta	rxCnt
    141  39a6		       20 ac 39 	      jsr	MidiInMsg
    142  39a9		       4c 26 39 	      jmp	.next
