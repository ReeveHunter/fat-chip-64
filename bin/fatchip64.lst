    455  60bc		       aa		      tax
    456  60bd		       ad 54 c8 	      lda	fineTune
    457  60c0		       38		      sec
    458  60c1		       e9 32		      sbc	#50
    459  60c3		       18		      clc
    460  60c4		       7d da 61 	      adc	scCents,x
    461  60c7		       50 00		      bvc	.c	; (can't overflow: -85..+60)
    462  60c9				   .c
    463  60c9		       cd 55 c8 	      cmp	tuneC
    464  60cc		       f0 1b		      beq	.k
    465  60ce		       8d 55 c8 	      sta	tuneC
    466  60d1		       20 02 61 	      jsr	TuneUnits
    467  60d4		       ae 57 c8 	      ldx	gbTune
    468  60d7		       a9 67		      lda	#GCC_TUNE
    469  60d9		       20 71 0d 	      jsr	GbGlobal
    470  60dc		       a9 08		      lda	#8
    471  60de		       8d 2d c5 	      sta	nfxRun	; (the NES bends again)
    472  60e1		       a9 00		      lda	#0
    473  60e3		       8d 5c c8 	      sta	vsGlide
    474  60e6		       20 00 3a 	      jsr	SidRetune	; (the SID's notes sounding: there at once)
    475  60e9				   .k
