    137  0a67							; Carry set if the Teensyboy has room for a message (always, with the Game
    138  0a67							; Boy off), and counts it.
    139  0a67				   LinkRoom
    140  0a67					      subroutine
    141  0a67		       ad 0e c3 	      lda	devOn+DEV_GB
    142  0a6a		       f0 0a		      beq	.yes
    143  0a6c		       a5 2d		      lda	linkLoad
    144  0a6e		       c9 2d		      cmp	#LINK_MAX
    145  0a70		       b0 06		      bcs	.no
    146  0a72		       69 03		      adc	#3
    147  0a74		       85 2d		      sta	linkLoad
    148  0a76				   .yes
    149  0a76		       38		      sec
    150  0a77		       60		      rts
    151  0a78				   .no
    152  0a78		       18		      clc
    153  0a79		       60		      rts
