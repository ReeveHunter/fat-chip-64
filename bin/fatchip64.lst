      0  6247					      include	"wander.asm"
      1  6247							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  6247							;
      3  6247							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  6247							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  6247							;   ATTACK   as always: the new notes start
      6  6247							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  6247							;	      has none)
      8  6247							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  6247							;	      start again
     10  6247							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  6247							;	      late; some glide, some start again (fade out, come back in)
     12  6247							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  6247							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  6247							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  6247							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  6247
     17  6247		       00 01	   CHG_ATTACK equ	1
     18  6247		       00 02	   CHG_GLIDE  equ	2
     19  6247		       00 03	   CHG_STAGGER equ	3
     20  6247		       00 04	   CHG_WANDER equ	4
     21  6247		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  6247
     23  6247							; A = the chord change style now (keeps X, Y)
