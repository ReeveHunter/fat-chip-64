------- FILE nesfx.asm LEVEL 2 PASS 3
      0  6c24					      include	"nesfx.asm"
      1  6c24							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  6c24							;
      3  6c24							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  6c24							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  6c24							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  6c24							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  6c24							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  6c24							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  6c24							;   glide    a new note starts bent back to the voice's last note and slides
     10  6c24							;	      in the way the SID's does (all three channels)
     11  6c24							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  6c24							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  6c24							; semitone, so these are a little stepped.
     14  6c24
     15  6c24		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  6c24							;  (the pulses, and the triangle while it glides)
     17  6c24
     18  6c24							; A = 1 (not Z) when a NesFxTick step is due
     19  6c24				   NesFxDue
     20  6c24					      subroutine
     21  6c24		       ad 27 c3 	      lda	devOn+DEV_NES
     22  6c27		       f0 19		      beq	.x
     23  6c29		       ad fe c5 	      lda	vibDepth
     24  6c2c		       0d 2c c5 	      ora	nfxGlide
     25  6c2f		       0d 2d c5 	      ora	nfxRun
     26  6c32		       f0 0e		      beq	.x
     27  6c34		       a5 10		      lda	ticks
     28  6c36		       38		      sec
     29  6c37		       ed 28 c5 	      sbc	nfxLast
     30  6c3a		       c9 08		      cmp	#NFX_EVERY
     31  6c3c		       a9 00		      lda	#0
     32  6c3e		       90 02		      bcc	.x
     33  6c40		       a9 01		      lda	#1
     34  6c42				   .x
     35  6c42		       60		      rts
     36  6c43
     37  6c43							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  6c43							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  6c43							; quick return.
     40  6c43				   NesFxTick
     41  6c43					      subroutine
     42  6c43		       ad 27 c3 	      lda	devOn+DEV_NES
     43  6c46		       f0 0b		      beq	.q
