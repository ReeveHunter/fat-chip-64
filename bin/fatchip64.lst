     59  45e4		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  45e6		       c0 0c		      cpy	#DRUM_WINDOW
     61  45e8		       b0 08		      bcs	.ok
