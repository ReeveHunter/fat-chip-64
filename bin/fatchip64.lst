    120  0ae1		       90 25		      bcc	.done
    121  0ae3		       20 09 0b 	      jsr	LinkRoom
    122  0ae6		       90 20		      bcc	.done
    123  0ae8		       a6 1b		      ldx	nesqTail
    124  0aea		       bd c0 c1 	      lda	nesqS,x
    125  0aed		       bc 40 c2 	      ldy	nesqD2,x
    126  0af0		       84 2c		      sty	irqT
    127  0af2		       bc 00 c2 	      ldy	nesqD1,x
    128  0af5		       20 25 0b 	      jsr	WireMsg
    129  0af8		       a5 1b		      lda	nesqTail
    130  0afa		       18		      clc
    131  0afb		       69 01		      adc	#1
    132  0afd		       29 3f		      and	#63
    133  0aff		       85 1b		      sta	nesqTail
    134  0b01		       a5 10		      lda	ticks
    135  0b03		       18		      clc
