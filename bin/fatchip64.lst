     29  0b1d		       a9 65		      lda	#<IrqTest
     30  0b1f		       8d fe ff 	      sta	$FFFE
     31  0b22		       a9 0b		      lda	#>IrqTest
     32  0b24		       8d ff ff 	      sta	$FFFF
     33  0b27		       a9 00		      lda	#0
     34  0b29		       85 2f		      sta	midiIrq
     35  0b2b		       a9 b6		      lda	#ACIA_MODE_TX
     36  0b2d		       8d 04 de 	      sta	ACIA_CTRL
