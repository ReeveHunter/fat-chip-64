    401  0b06		       48		      pha
    402  0b07		       e6 10		      inc	ticks
    403  0b09		       d0 02		      bne	.t
    404  0b0b		       e6 11		      inc	ticks+1
    405  0b0d				   .t
    406  0b0d		       20 d0 0b 	      jsr	Schedule
    407  0b10		       20 da 2e 	      jsr	RxByte	; (a long tick: a byte may be waiting, and
    408  0b13		       20 ab 0b 	      jsr	TxByte	;  the MIDI chip holds only one)
