    408  3a68		       68		      pla
    409  3a69		       60		      rts
    410  3a6a
    411  3a6a							; A data byte (A) inside a SysEx
    412  3a6a				   SysexByte
    413  3a6a					      subroutine
    414  3a6a		       ae 4e c7 	      ldx	sxPos
    415  3a6d		       e0 03		      cpx	#3	; the command: 1 a patch, 2 the chips on / off
    416  3a6f		       d0 0b		      bne	.nc
    417  3a71		       c9 02		      cmp	#2
    418  3a73		       d0 07		      bne	.nc
    419  3a75		       8d 1d c8 	      sta	sxCmd
    420  3a78		       ee 4e c7 	      inc	sxPos
    421  3a7b		       60		      rts
    422  3a7c				   .nc
    423  3a7c		       ac 1d c8 	      ldy	sxCmd
    424  3a7f		       c0 02		      cpy	#2
    425  3a81		       d0 0b		      bne	.pat
    426  3a83		       e0 04		      cpx	#4	; 2: one byte, bit 0 SID, 1 Game Boy, 2 NES
    427  3a85		       d0 39		      bne	.no
