------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  5227					      include	"sync.asm"
      1  5227							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  5227							;
      3  5227							; Menu, DEVICE SYNC (defaults first):
      4  5227							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  5227							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  5227							;		     sets the tempo, averaged over beats (the clock jitters about
      7  5227							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  5227							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  5227							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  5227							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  5227							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  5227							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  5227							;		     picks a beat demo (styleBeat)
     14  5227							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  5227							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  5227							;		     key channel) picks a sound (voiceSound)
     17  5227							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  5227							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  5227							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  5227							;
     21  5227							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  5227							; 1/4 ms); a Start makes the next clock a beat.
     23  5227
     24  5227		       00 00	   TEMPO_KEYTAR equ	0
     25  5227		       00 01	   TEMPO_OWN  equ	1
     26  5227		       00 02	   TEMPO_SC   equ	2
     27  5227		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  5227
     29  5227
     30  5227
     31  5227							; ------------------------------------------------------------ clock
     32  5227							; Main loop, every pass
