    443  6606							; ------------------------------------------------------------ tuning
    444  6606							; tuneC = PLAYING's FINE TUNE + the Synthcart's TUNE TO (while it's in use),
    445  6606							; in cents (-100..+100). The Game Boy gets it as master tune (CC 103), the
    446  6606							; NES in its bends (tuneN, 1/64 semitones), the SID in its note frequencies
    447  6606							; (SidTune; the notes sounding move at once). MATCH KEY sets the key's root
    448  6606							; once, when it changes.
    449  6606				   ScTune
    450  6606					      subroutine
    451  6606		       a9 00		      lda	#0
    452  6608		       ae 38 c8 	      ldx	useSc
