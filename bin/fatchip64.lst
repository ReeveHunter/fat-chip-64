      0  60f4					      include	"patchedit.asm"
      1  60f4							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  60f4							; the dice. The settings and their steps come from tools/gen_menu.py
      3  60f4							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  60f4							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  60f4							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  60f4							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  60f4							; (EnvDerive).
      8  60f4
