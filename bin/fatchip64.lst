    506  517a							; ------------------------------------------------------------ actions
    507  517a							; What SPACE and the keytar's buttons do (menu: SPACE, ... BUTTON):
    508  517a							;   held     MUTE, BEND DOWN, BEND UP, VIBRATO, TREMOLO, ARP, STUTTER,
    509  517a							;	      VINYL STOP, GLIDE, SUSTAIN, OCTAVE UP, REPEAT, FILTER SWEEP,
    510  517a							;	      BEAT FILL, TAPE WOBBLE, WIDE
