    396  3f4b							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    397  3f4b							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    398  3f4b							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    399  3f4b							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    400  3f4b		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    401  3f4f		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    402  3f56		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    403  3f5d		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    404  3f62		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    405  3f66		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    406  3f6a		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
    407  3f6f		       05 0a 0f 14*uTremRH    .byte.b	>1311, >2621, >3932, >5243, >6554
    408  3f74		       04 08 0c 10 uDetT      .byte.b	4, 8, 12, 16
    409  3f78		       18 38 64    uWarbT     .byte.b	24, 56, 100
