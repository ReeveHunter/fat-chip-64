     84  7dec				   .v
     85  7dec		       bd d6 c4 	      lda	nesVT,x
     86  7def		       18		      clc
     87  7df0		       6d 2f c5 	      adc	nfxN
     88  7df3		       90 02		      bcc	.vt
     89  7df5		       a9 ff		      lda	#255
     90  7df7				   .vt
