     87  4e85		       aa		      tax
     88  4e86		       bd 34 a8 	      lda	kits,x
     89  4e89		       85 25		      sta	t1
     90  4e8b							; bank (CC14 on the sample channel) when it changes
     91  4e8b		       a9 04		      lda	#4
     92  4e8d		       20 e5 4e 	      jsr	NesChStatus	; mS = CC, sample channel
     93  4e90		       a9 00		      lda	#0
     94  4e92		       a6 25		      ldx	t1
     95  4e94		       10 02		      bpl	.a
     96  4e96		       a9 7f		      lda	#127
     97  4e98				   .a
     98  4e98		       cd 7c c4 	      cmp	dmcBank
     99  4e9b		       f0 0c		      beq	.note
    100  4e9d		       8d 7c c4 	      sta	dmcBank
    101  4ea0		       85 23		      sta	mD2
    102  4ea2		       a9 0e		      lda	#14
    103  4ea4		       85 22		      sta	mD1
    104  4ea6		       20 3a 0d 	      jsr	NesPut
