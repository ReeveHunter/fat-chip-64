------- FILE main.asm
------- FILE wander.asm LEVEL 2 PASS 3
      0  6abb					      include	"wander.asm"
      1  6abb							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  6abb							;
      3  6abb							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  6abb							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  6abb							;   ATTACK   as always: the new notes start
      6  6abb							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  6abb							;	      has none)
      8  6abb							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  6abb							;	      start again
     10  6abb							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  6abb							;	      late; some glide, some start again (fade out, come back in)
     12  6abb							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  6abb							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  6abb							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  6abb							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  6abb
     17  6abb		       00 01	   CHG_ATTACK equ	1
     18  6abb		       00 02	   CHG_GLIDE  equ	2
     19  6abb		       00 03	   CHG_STAGGER equ	3
