     41  229f		       20 86 22 	      jsr	GetTicks
     42  22a2		       ad 3f c3 	      lda	nowL
     43  22a5		       38		      sec
     44  22a6		       ed 44 c3 	      sbc	tapLast
     45  22a9		       85 24		      sta	t0
     46  22ab		       ad 40 c3 	      lda	nowH
