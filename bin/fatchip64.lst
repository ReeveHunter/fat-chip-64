    325  0a7b		       e4 15		      cpx	wireHead
    326  0a7d		       f0 0f		      beq	.noByte
    327  0a7f		       ad 06 de 	      lda	ACIA_STAT
    328  0a82		       29 02		      and	#ACIA_TDRE
    329  0a84		       f0 08		      beq	.noByte
