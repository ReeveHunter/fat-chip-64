------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  41f6					      include	"sync.asm"
      1  41f6							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  41f6							;
      3  41f6							; Menu, DEVICE SYNC (defaults first):
      4  41f6							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  41f6							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  41f6							;		     sets the tempo, averaged over beats (the clock jitters about
      7  41f6							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  41f6							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  41f6							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  41f6							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  41f6							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  41f6							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  41f6							;		     picks a beat demo (styleBeat)
     14  41f6							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  41f6							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  41f6							;		     key channel) picks a sound (voiceSound)
     17  41f6							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  41f6							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  41f6							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  41f6							;
     21  41f6							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  41f6							; 1/4 ms); a Start makes the next clock a beat.
     23  41f6
     24  41f6		       00 00	   TEMPO_KEYTAR equ	0
     25  41f6		       00 01	   TEMPO_OWN  equ	1
     26  41f6		       00 02	   TEMPO_SC   equ	2
     27  41f6		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  41f6
     29  41f6
     30  41f6
