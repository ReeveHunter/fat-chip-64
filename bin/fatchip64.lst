------- FILE main.asm
    531  d78e				   hiEnd
    532  d78e							; v0.66: under the KERNAL, past its tables (cleared at start): each patch
    533  d78e							; setting's step when its effect was last switched off, and per effect
    534  d78e							; whether that's been kept (patchedit.asm FxOff / FxOn)
    535  d78e		       fc ea	   fxMem      equ	hiEnd
    536  d78e		       fd 2a	   fxMemOk    equ	hiEnd+64
    537  d78e				  -	      if	fxMemOk+16 > $FFF0
    538  d78e				  -	      echo	"fxMem runs into the vectors"
    539  d78e				  -	      err
    540  d78e					      endif
    541  d78e					      rend
    542  d78e				  -	      if	hiEnd > $FFFA
    543  d78e				  -	      echo	"the $E000 tables run into the CPU's vectors"
    544  d78e				  -	      err
    545  d78e					      endif
    546  d78e
    547  d78e							; ---- v0.60: data in the RAM under the I/O ($D000-$DFFF): packed apart too,
    548  d78e							; unpacked there with the I/O switched out; read with BeatLoad's copy
    549  d78e				   ioPhys
    550  d78e					      rorg	$D000
    551  d78e				   ioStart
