     85  1d12				   .avg
     86  1d12							; sum the last tapN gaps
     87  1d12		       a9 00		      lda	#0
     88  1d14		       8d 50 c3 	      sta	dvdL
     89  1d17		       8d 51 c3 	      sta	dvdH
     90  1d1a		       a2 03		      ldx	#3
     91  1d1c				   .s
     92  1d1c		       ec 46 c3 	      cpx	tapN
     93  1d1f		       b0 13		      bcs	.sn	; only slots 0..tapN-1 are filled
     94  1d21		       ad 50 c3 	      lda	dvdL
     95  1d24		       18		      clc
     96  1d25		       7d 48 c3 	      adc	tapRingLo,x
     97  1d28		       8d 50 c3 	      sta	dvdL
     98  1d2b		       ad 51 c3 	      lda	dvdH
     99  1d2e		       7d 4c c3 	      adc	tapRingHi,x
    100  1d31		       8d 51 c3 	      sta	dvdH
    101  1d34				   .sn
