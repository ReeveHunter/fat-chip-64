      0  5a5b					      include	"menu.asm"
      1  5a5b							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  5a5b							;
      3  5a5b							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  5a5b							;   page   RETURN opens a page
      5  5a5b							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  5a5b							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  5a5b							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  5a5b							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  5a5b							; device pages, until DEVICES says the device is in use).
     10  5a5b							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  5a5b							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  5a5b							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  5a5b
     14  5a5b		       00 17	   MENU_VALCOL equ	23
     15  5a5b
