      0  2353					      include	"arp.asm"
      1  2353							; Fat Chip 64 - tempo and arpeggiator
      2  2353							;
      3  2353							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  2353							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  2353							;
      6  2353							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  2353							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  2353							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  2353							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  2353							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  2353							;	     until its voice's next turn.
     12  2353							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  2353							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  2353							;   J faster; either one also picks FREE).
     15  2353							;
     16  2353							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  2353							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  2353
     19  2353							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  2353							; between the two bytes: $22FF read as $23FF)
     21  2353				   GetTicks
     22  2353					      subroutine
     23  2353		       08		      php
     24  2354		       78		      sei
     25  2355		       a5 10		      lda	ticks
     26  2357		       8d 3f c3 	      sta	nowL
     27  235a		       a5 11		      lda	ticks+1
     28  235c		       8d 40 c3 	      sta	nowH
     29  235f		       28		      plp
     30  2360		       60		      rts
     31  2361
