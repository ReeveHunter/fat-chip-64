------- FILE main.asm
------- FILE arp.asm LEVEL 2 PASS 3
      0  1894					      include	"arp.asm"
      1  1894							; Fat Chip 64 - tempo and arpeggiator
      2  1894							;
      3  1894							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1894							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1894							;
      6  1894							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1894							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1894							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1894							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1894							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1894							;	     until its voice's next turn.
     12  1894							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1894							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1894							;   J faster; either one also picks FREE).
     15  1894							;
     16  1894							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1894							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1894
     19  1894							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1894							; between the two bytes: $22FF read as $23FF)
     21  1894				   GetTicks
     22  1894					      subroutine
     23  1894		       08		      php
     24  1895		       78		      sei
     25  1896		       a5 10		      lda	ticks
     26  1898		       8d 3e c3 	      sta	nowL
     27  189b		       a5 11		      lda	ticks+1
     28  189d		       8d 3f c3 	      sta	nowH
     29  18a0		       28		      plp
     30  18a1		       60		      rts
     31  18a2
