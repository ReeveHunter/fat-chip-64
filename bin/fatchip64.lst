     90  0c3e							; Main loop: same, with interrupts off around it.
     91  0c3e				   TxService
     92  0c3e					      subroutine
     93  0c3e		       a5 2f		      lda	midiIrq	; (the MIDI chip's interrupts do it)
     94  0c40		       f0 01		      beq	.poll
     95  0c42		       60		      rts
     96  0c43				   .poll
     97  0c43		       08		      php
