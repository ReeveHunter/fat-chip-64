    144  34c8							; A full message: rxStatus, rxD1, rxD2
    145  34c8				   MidiInMsg
    146  34c8					      subroutine
    147  34c8		       ad 26 c4 	      lda	rxStatus
    148  34cb		       29 0f		      and	#15
    149  34cd		       c9 0f		      cmp	#DRUM_CH_IN	; channel 16: the keytar's rhythm
    150  34cf		       d0 1d		      bne	.notes
    151  34d1		       ad 26 c4 	      lda	rxStatus
