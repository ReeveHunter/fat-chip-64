------- FILE drums.asm LEVEL 2 PASS 3
      0  44d6					      include	"drums.asm"
      1  44d6							; Fat Chip 64 - drums on the MidiNES
      2  44d6							;
      3  44d6							; Two sources, one kit:
      4  44d6							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  44d6							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  44d6							;			   64 = hit, 56 = ghost)
      7  44d6							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  44d6							;			   RETURN starts / stops it, at its own tempo (B taps
      9  44d6							;			   a new one)
     10  44d6							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  44d6							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  44d6							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  44d6							; a note-on, then a note-off after the sound's length, the level set with
     14  44d6							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  44d6							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  44d6
     17  44d6		       00 0c	   KIT_SIZE   equ	12
     18  44d6		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  44d6		       00 00	   DK_KICK    equ	0
     20  44d6		       00 01	   DK_SNARE   equ	1
     21  44d6		       00 02	   DK_CH      equ	2
     22  44d6		       00 03	   DK_OH      equ	3
     23  44d6		       00 04	   DK_CY      equ	4
     24  44d6		       00 05	   DK_TOM     equ	5
     25  44d6		       00 06	   DK_PERC    equ	6
     26  44d6
     27  44d6							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  44d6				   DrumHit
     29  44d6					      subroutine
     30  44d6		       8d 82 c4 	      sta	drumKind
