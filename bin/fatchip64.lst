------- FILE main.asm
------- FILE wander.asm LEVEL 2 PASS 3
      0  7025					      include	"wander.asm"
      1  7025							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  7025							;
      3  7025							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  7025							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  7025							;   ATTACK   as always: the new notes start
      6  7025							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  7025							;	      has none)
      8  7025							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  7025							;	      start again
     10  7025							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  7025							;	      late; some glide, some start again (fade out, come back in)
     12  7025							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  7025							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  7025							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  7025							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  7025
     17  7025		       00 01	   CHG_ATTACK equ	1
     18  7025		       00 02	   CHG_GLIDE  equ	2
     19  7025		       00 03	   CHG_STAGGER equ	3
     20  7025		       00 04	   CHG_WANDER equ	4
     21  7025		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  7025		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  7025
     24  7025							; A = the chord change style now (keeps X, Y)
     25  7025				   ChgEff
     26  7025					      subroutine
     27  7025		       ad 25 cd 	      lda	chgMode
