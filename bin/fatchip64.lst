      0  0ea7					      include	"keys.asm"
      1  0ea7							; Fat Chip 64 - keyboard and RESTORE
      2  0ea7
      3  0ea7							; Scan the whole matrix, turn changes into key events.
      4  0ea7							;
      5  0ea7							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0ea7							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0ea7							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0ea7							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0ea7							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0ea7							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0ea7							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0ea7							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0ea7							; chords whose ghost lands on another used key lose their newest note.
     14  0ea7				   KeyScan
     15  0ea7					      subroutine
     16  0ea7		       a2 07		      ldx	#7
     17  0ea9				   .col
     18  0ea9		       bd 1b 82 	      lda	colSelect,x
     19  0eac		       8d 00 dc 	      sta	CIA1_PRA
     20  0eaf		       ad 01 dc 	      lda	CIA1_PRB
     21  0eb2		       49 ff		      eor	#$FF
     22  0eb4		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0eb7		       9d 80 c2 	      sta	keyNow,x
     24  0eba		       ca		      dex
     25  0ebb		       10 ec		      bpl	.col
     26  0ebd		       a9 ff		      lda	#$FF
     27  0ebf		       8d 00 dc 	      sta	CIA1_PRA
     28  0ec2							; ---- every column as accepted (nothing pressed or let go): done
     29  0ec2		       a2 07		      ldx	#7
     30  0ec4				   .same
     31  0ec4		       bd 80 c2 	      lda	keyNow,x
     32  0ec7		       dd 90 c2 	      cmp	keyAcc,x
     33  0eca		       d0 04		      bne	.changed
     34  0ecc		       ca		      dex
     35  0ecd		       10 f5		      bpl	.same
     36  0ecf		       60		      rts
     37  0ed0				   .changed
     38  0ed0							; ---- releases first: accepted keys that are up now
     39  0ed0		       a2 00		      ldx	#0
     40  0ed2				   .rc
     41  0ed2		       8e 3c c3 	      stx	ksCol
     42  0ed5		       bd 80 c2 	      lda	keyNow,x
     43  0ed8		       49 ff		      eor	#$FF
     44  0eda		       3d 90 c2 	      and	keyAcc,x
     45  0edd		       8d 3b c3 	      sta	ksBits
     46  0ee0		       a9 00		      lda	#0
     47  0ee2		       8d 3d c3 	      sta	ksRow
     48  0ee5				   .rb
     49  0ee5		       ad 3b c3 	      lda	ksBits
     50  0ee8		       f0 21		      beq	.rcn
     51  0eea		       4e 3b c3 	      lsr	ksBits
     52  0eed		       90 17		      bcc	.rbn
     53  0eef		       ae 3c c3 	      ldx	ksCol
     54  0ef2		       ac 3d c3 	      ldy	ksRow
     55  0ef5		       b9 23 82 	      lda	rowBit,y
     56  0ef8		       49 ff		      eor	#$FF
     57  0efa		       3d 90 c2 	      and	keyAcc,x
     58  0efd		       9d 90 c2 	      sta	keyAcc,x
     59  0f00		       20 a6 0f 	      jsr	KeyCode
     60  0f03		       20 b7 18 	      jsr	KeyUp
     61  0f06				   .rbn
     62  0f06		       ee 3d c3 	      inc	ksRow
     63  0f09		       d0 da		      bne	.rb
     64  0f0b				   .rcn
     65  0f0b		       ae 3c c3 	      ldx	ksCol
     66  0f0e		       e8		      inx
     67  0f0f		       e0 08		      cpx	#8
     68  0f11		       d0 bf		      bne	.rc
     69  0f13							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0f13							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0f13							; still count as a combination.
     72  0f13		       a9 00		      lda	#0
     73  0f15		       8d 3f c3 	      sta	ksPass
     74  0f18				   .pass
     75  0f18		       a2 00		      ldx	#0
     76  0f1a				   .pc
     77  0f1a		       8e 3c c3 	      stx	ksCol
     78  0f1d		       bd 90 c2 	      lda	keyAcc,x
     79  0f20		       49 ff		      eor	#$FF
     80  0f22		       3d 80 c2 	      and	keyNow,x
     81  0f25		       8d 3b c3 	      sta	ksBits
     82  0f28		       a9 00		      lda	#0
     83  0f2a		       8d 3d c3 	      sta	ksRow
     84  0f2d				   .pb
     85  0f2d		       ad 3b c3 	      lda	ksBits
     86  0f30		       f0 49		      beq	.pcn
     87  0f32		       4e 3b c3 	      lsr	ksBits
     88  0f35		       90 3f		      bcc	.pbn
     89  0f37		       ad 40 c3 	      lda	ghostFilter
     90  0f3a		       d0 0c		      bne	.chk	; filter off (default): phantom notes play...
     91  0f3c		       20 a6 0f 	      jsr	KeyCode
     92  0f3f		       c9 18		      cmp	#24
     93  0f41		       90 0a		      bcc	.accept
     94  0f43		       20 8f 0f 	      jsr	IsModifier
     95  0f46		       f0 05		      beq	.accept
     96  0f48				   .chk 		; ...but a command key never comes from a phantom
     97  0f48		       20 b4 0f 	      jsr	Suspect	;  (v0.40: Q + E held, then C=, read C= + S too)
     98  0f4b		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     99  0f4d				   .accept
    100  0f4d		       20 a6 0f 	      jsr	KeyCode
    101  0f50		       20 8f 0f 	      jsr	IsModifier	; Z set = modifier
    102  0f53		       f0 07		      beq	.mod
    103  0f55		       ad 3f c3 	      lda	ksPass
    104  0f58		       f0 1c		      beq	.pbn	; pass 0: modifiers only
    105  0f5a		       d0 05		      bne	.take
    106  0f5c				   .mod
    107  0f5c		       ad 3f c3 	      lda	ksPass
    108  0f5f		       d0 15		      bne	.pbn	; (taken in pass 0)
    109  0f61				   .take
    110  0f61		       ae 3c c3 	      ldx	ksCol
    111  0f64		       ac 3d c3 	      ldy	ksRow
    112  0f67		       b9 23 82 	      lda	rowBit,y
    113  0f6a		       1d 90 c2 	      ora	keyAcc,x
    114  0f6d		       9d 90 c2 	      sta	keyAcc,x
    115  0f70		       20 a6 0f 	      jsr	KeyCode
    116  0f73		       20 e5 0f 	      jsr	KeyDown
    117  0f76				   .pbn
    118  0f76		       ee 3d c3 	      inc	ksRow
    119  0f79		       d0 b2		      bne	.pb
    120  0f7b				   .pcn
    121  0f7b		       ae 3c c3 	      ldx	ksCol
    122  0f7e		       e8		      inx
    123  0f7f		       e0 08		      cpx	#8
    124  0f81		       d0 97		      bne	.pc
    125  0f83		       ad 3f c3 	      lda	ksPass
    126  0f86		       d0 06		      bne	.done
    127  0f88		       ee 3f c3 	      inc	ksPass
    128  0f8b		       4c 18 0f 	      jmp	.pass
    129  0f8e				   .done
    130  0f8e		       60		      rts
    131  0f8f
    132  0f8f							; Z set if key code A is a modifier. Keeps A.
    133  0f8f				   IsModifier
    134  0f8f		       c9 88		      cmp	#K_LSHIFT
    135  0f91		       f0 12		      beq	.y
    136  0f93		       c9 89		      cmp	#K_RSHIFT
    137  0f95		       f0 0e		      beq	.y
    138  0f97		       c9 8c		      cmp	#K_CTRL
    139  0f99		       f0 0a		      beq	.y
    140  0f9b		       c9 a2		      cmp	#K_CBM
    141  0f9d		       f0 06		      beq	.y
    142  0f9f		       c9 a3		      cmp	#K_STOP
    143  0fa1		       f0 02		      beq	.y
    144  0fa3		       c9 9a		      cmp	#K_K
    145  0fa5				   .y
    146  0fa5		       60		      rts
