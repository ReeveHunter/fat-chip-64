     48  80d3		       0d f9 c9 	      ora	nfxWarb
     49  80d6		       d0 01		      bne	.on
     50  80d8				   .q
     51  80d8		       60		      rts
     52  80d9				   .on
     53  80d9		       a5 10		      lda	ticks
     54  80db		       38		      sec
     55  80dc		       ed 35 c5 	      sbc	nfxLast
     56  80df		       c9 08		      cmp	#NFX_EVERY
     57  80e1		       b0 01		      bcs	.go
     58  80e3		       60		      rts
     59  80e4				   .go
