    198  0d40		       20 a2 15 	      jsr	GetTicks
    199  0d43		       20 e3 0e 	      jsr	ApplySettings	; (changes waiting for this note)
    200  0d46		       ad 74 c3 	      lda	newPending	; N or a setting change: this note starts a new chord
    201  0d49		       f0 0b		      beq	.styles
    202  0d4b		       a9 00		      lda	#0
    203  0d4d		       8d 74 c3 	      sta	newPending
