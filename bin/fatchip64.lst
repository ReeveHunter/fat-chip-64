------- FILE menu.asm LEVEL 2 PASS 3
      0  5885					      include	"menu.asm"
      1  5885							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  5885							;
      3  5885							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  5885							;   page   RETURN opens a page
      5  5885							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  5885							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  5885							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  5885							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  5885							; device pages, until DEVICES says the device is in use).
     10  5885							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  5885							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  5885							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  5885
     14  5885		       00 17	   MENU_VALCOL equ	23
     15  5885
     16  5885				   MenuOpen
     17  5885		       20 93 7a 	      jsr	GlitchCalm	; (GLITCH may have the picture shaking)
     18  5888		       a9 01		      lda	#1
