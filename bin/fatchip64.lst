------- FILE arp.asm LEVEL 2 PASS 3
      0  23f7					      include	"arp.asm"
      1  23f7							; Fat Chip 64 - tempo and arpeggiator
      2  23f7							;
      3  23f7							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  23f7							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  23f7							;
      6  23f7							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  23f7							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  23f7							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  23f7							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  23f7							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  23f7							;	     until its voice's next turn.
     12  23f7							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  23f7							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  23f7							;   J faster; either one also picks FREE).
     15  23f7							;
     16  23f7							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  23f7							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  23f7
     19  23f7							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  23f7							; between the two bytes: $22FF read as $23FF)
     21  23f7				   GetTicks
     22  23f7					      subroutine
     23  23f7		       08		      php
     24  23f8		       78		      sei
     25  23f9		       a5 10		      lda	ticks
     26  23fb		       8d 43 c3 	      sta	nowL
     27  23fe		       a5 11		      lda	ticks+1
     28  2400		       8d 44 c3 	      sta	nowH
     29  2403		       28		      plp
     30  2404		       60		      rts
     31  2405
