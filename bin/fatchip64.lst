    272  4cec							; noise presets: closed hat, open hat, cymbal x ghost / hit / accent
    273  4cec							; (MidiNES long-mode noise: note = 51 - period; the Beat Lab's closed hat
    274  4cec							; is period 1, open 2, crash 3)
    275  4cec		       32 32 32 31*nzNoteT    .byte.b	50,50,50, 49,49,49, 48,48,48
