    174  8670		       8d 00 ca 	      sta	nfxH
    175  8673		       bc 3c ce 	      ldy	nesK,x	; (BEND IN: its own)
    176  8676		       d0 07		      bne	.sh
    177  8678		       ac d0 ca 	      ldy	glideK
    178  867b		       d0 02		      bne	.sh
    179  867d		       a0 02		      ldy	#2	; (glide switched off mid-slide: finish quickly)
    180  867f				   .sh
    181  867f		       ad 00 ca 	      lda	nfxH
    182  8682		       c9 80		      cmp	#$80
