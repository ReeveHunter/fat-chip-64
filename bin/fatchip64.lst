     26  1e9a		       8d 3e c3 	      sta	nowL
     27  1e9d		       a5 11		      lda	ticks+1
     28  1e9f		       8d 3f c3 	      sta	nowH
     29  1ea2		       28		      plp
     30  1ea3		       60		      rts
