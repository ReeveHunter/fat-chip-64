    195 U001e		       00 00	   nmiTick    ds	2
    196 U0020		       00	   nmiSeen    ds	1
    197 U0021		       00	   mS	      ds	1	; message being queued: status, data 1, data 2
    198 U0022		       00	   mD1	      ds	1
    199 U0023		       00	   mD2	      ds	1
    200 U0024		       00	   t0	      ds	1
