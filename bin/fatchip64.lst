------- FILE main.asm
------- FILE menu.asm LEVEL 2 PASS 3
      0  60ed					      include	"menu.asm"
      1  60ed							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  60ed							;
      3  60ed							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  60ed							;   page   RETURN opens a page
      5  60ed							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  60ed							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  60ed							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  60ed							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  60ed							; device pages, until DEVICES says the device is in use).
     10  60ed							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  60ed							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  60ed							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  60ed
     14  60ed		       00 17	   MENU_VALCOL equ	23
     15  60ed
     16  60ed				   MenuOpen
     17  60ed		       20 db 82 	      jsr	GlitchCalm	; (GLITCH may have the picture shaking)
     18  60f0		       a9 01		      lda	#1
     19  60f2		       8d bd ce 	      sta	colDirty	; (the play screen's dark rows: light green again)
     20  60f5		       8d 56 c9 	      sta	menuOn
     21  60f8		       a9 00		      lda	#0
     22  60fa		       8d 57 c9 	      sta	menuRow
     23  60fd		       8d bc ce 	      sta	menuJump
     24  6100							; page A on screen (the cursor stays on its line if it's on this page)
     25  6100				   MenuPage
     26  6100					      subroutine
     27  6100		       8d e8 ca 	      sta	menuPage
