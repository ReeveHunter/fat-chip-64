      0  5ff3					      include	"wander.asm"
      1  5ff3							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  5ff3							;
      3  5ff3							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  5ff3							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  5ff3							;   ATTACK   as always: the new notes start
      6  5ff3							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  5ff3							;	      has none)
      8  5ff3							;   SPLIT    the SID and the bass voices glide, the Game Boy and NES pulses
      9  5ff3							;	      start again
     10  5ff3							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  5ff3							;	      late; some glide, some start again (fade out, come back in)
     12  5ff3							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  5ff3							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  5ff3							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  5ff3							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  5ff3
     17  5ff3		       00 01	   CHG_ATTACK equ	1
     18  5ff3		       00 02	   CHG_GLIDE  equ	2
     19  5ff3		       00 03	   CHG_SPLIT  equ	3
     20  5ff3		       00 04	   CHG_WANDER equ	4
     21  5ff3		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  5ff3
     23  5ff3							; A = the chord change style now (keeps X, Y)
     24  5ff3				   ChgEff
     25  5ff3					      subroutine
     26  5ff3		       ad 58 c8 	      lda	chgMode
     27  5ff6		       d0 0c		      bne	.x
     28  5ff8		       ad aa c3 	      lda	effMode
     29  5ffb		       c9 02		      cmp	#MODE_DRONE
     30  5ffd		       d0 03		      bne	.a
     31  5fff		       a9 04		      lda	#CHG_WANDER
     32  6001		       60		      rts
     33  6002				   .a
     34  6002		       a9 01		      lda	#CHG_ATTACK
     35  6004				   .x
     36  6004		       60		      rts
