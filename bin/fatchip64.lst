------- FILE main.asm LEVEL 1 PASS 3
      1  d7d9 ????						; Fat Chip 64 - main program
      2  d7d9 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  d7d9 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  d7d9 ????						; Build: ./build.sh (dasm makes bin/fatchip64-image.prg; tools/crunch.py packs it
      5  d7d9 ????						; into bin/fatchip64.prg)
      6  d7d9 ????
      7  d7d9 ????				      processor	6502
