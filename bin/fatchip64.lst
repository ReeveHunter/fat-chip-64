      0  1a9f					      include	"voices.asm"
      1  1a9f							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  1a9f							;
      3  1a9f							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  1a9f							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  1a9f							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  1a9f							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  1a9f							; Allocation, whenever the held notes change. Who comes first (v0.21):
      8  1a9f							; Polyphony > Fat Bass > the patch's effects (REPEAT's echoes) > stacking.
      9  1a9f							;   1. every note gets a voice (SPARKLE's arp pair is what you play, so it
     10  1a9f							;	counts as notes and goes first)
     11  1a9f							;   2. Fat Bass: as many bass voices as are spare play the lowest note,
     12  1a9f							;	folded into the bass range (one note fewer needs a voice, so with
     13  1a9f							;	Fat Bass the bottom of the chord is the bass)
     14  1a9f							;   3. REPEAT's echo voices: one or two of what's still spare
     15  1a9f							;   4. leftover voices stack on the lowest two notes, alternating
     16  1a9f							; So one note = a nine-voice unison across three chips, and in chords the
     17  1a9f							; bottom of the chord is fattest. Disabled devices, and voices the drums
     18  1a9f							; hold (vDrum), get no notes.
     19  1a9f
     20  1a9f							; ------------------------------------------------------------ SID
     21  1a9f				   SidInit
     22  1a9f					      subroutine
     23  1a9f		       a2 18		      ldx	#24
