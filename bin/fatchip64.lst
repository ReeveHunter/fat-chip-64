------- FILE nesenv.asm LEVEL 2 PASS 3
      0  29e8					      include	"nesenv.asm"
      1  29e8							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  29e8							;
      3  29e8							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  29e8							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  29e8							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  29e8							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  29e8							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  29e8							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  29e8							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  29e8							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  29e8							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  29e8							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  29e8							; would wrap to a high pitch).
     14  29e8							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  29e8
     16  29e8							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  29e8							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  29e8							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  29e8							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  29e8							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  29e8		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  29e8		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  29e8							; NES channels too, and can't take a bend every 4 ms
     24  29e8		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  29e8		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  29e8
     27  29e8							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  29e8		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  29f1		       02 05	   slotVoice  .byte.b	2,5
     30  29f3
     31  29f3							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  29f3							; note keeps sounding for now). X = voice (= t0).
     33  29f3				   NesSoftRelease
     34  29f3					      subroutine
     35  29f3		       4c f8 29 	      jmp	.go
     36  29f6				   .nope
     37  29f6		       18		      clc
     38  29f7		       60		      rts
     39  29f8				   .go
     40  29f8		       ad 58 c8 	      lda	muteNow
     41  29fb		       0d 97 c8 	      ora	hardCut
     42  29fe		       d0 f6		      bne	.nope
     43  2a00		       ad eb c7 	      lda	devOn+DEV_NES
     44  2a03		       f0 f1		      beq	.nope
     45  2a05		       bd e7 88 	      lda	vDev,x
     46  2a08		       c9 02		      cmp	#DEV_NES
     47  2a0a		       d0 ea		      bne	.nope
     48  2a0c		       bd 5f c8 	      lda	vOut,x
     49  2a0f		       c9 ff		      cmp	#NO_NOTE
     50  2a11		       f0 e3		      beq	.nope
     51  2a13		       ad 13 c9 	      lda	nesEnvOn
     52  2a16		       f0 78		      beq	.fo	; (no envelope: BEND OUT's fall-off, if any)
     53  2a18		       bc e8 29 	      ldy	vEnvSlot,x
     54  2a1b		       30 41		      bmi	.tri
     55  2a1d							; pulse: release from the current level; step = level x factor / 4 + 1
     56  2a1d							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  2a1d							; about 2 s). Factor 0: no release, cut.
     58  2a1d		       ad 36 c9 	      lda	envRelV
     59  2a20		       f0 6e		      beq	.fo
     60  2a22		       86 26		      stx	t2
     61  2a24		       84 27		      sty	t3
     62  2a26		       b9 85 c8 	      lda	envLvH,y
