    184 U0013		       00	   scrAt      ds	1	; ... for the next screen step
    185 U0014		       00	   lastStatus ds	1	; running status on the wire
    186 U0015		       00	   wireHead   ds	1	; wire ring: head = write, tail = read
    187 U0016		       00	   wireTail   ds	1
