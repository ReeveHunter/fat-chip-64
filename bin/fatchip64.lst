------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  2449					      include	"midiin.asm"
      1  2449							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  2449							;
      3  2449							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  2449							; The main loop parses them (running status; realtime and system bytes are
      5  2449							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  2449							; notes mode, latch, arp and K + note.
      7  2449							;
      8  2449							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  2449							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  2449							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  2449							;
     12  2449							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  2449							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  2449							;
     15  2449							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  2449							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  2449							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  2449							; MIDI in is passed on to the Game Boy or NES.
     19  2449
     20  2449							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  2449							; Uses A, X.
     22  2449							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  2449							; with the time; a Start ($FA) makes the next clock a beat.
     24  2449				   RxByte
     25  2449					      subroutine
     26  2449		       ad 06 de 	      lda	ACIA_STAT
     27  244c		       4a		      lsr		; RDRF -> carry
     28  244d		       90 28		      bcc	.x
     29  244f				   RxGot
     30  244f		       ad 07 de 	      lda	ACIA_RX
     31  2452		       c9 f8		      cmp	#$F8
     32  2454		       f0 22		      beq	.clk
     33  2456		       c9 fa		      cmp	#$FA
     34  2458		       d0 0b		      bne	.buf
     35  245a		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  245c		       8e a9 c4 	      stx	clkPhase
     37  245f		       ae aa c4 	      ldx	clkBeat
     38  2462		       8e bc c4 	      stx	clkStartBeat
     39  2465				   .buf
     40  2465		       ae 25 c4 	      ldx	rxHead
     41  2468		       9d e5 c3 	      sta	rxBuf,x
     42  246b		       e8		      inx
     43  246c		       8a		      txa
     44  246d		       29 3f		      and	#63
     45  246f		       cd 26 c4 	      cmp	rxTail
     46  2472		       f0 03		      beq	.x	; full: dropped
     47  2474		       8d 25 c4 	      sta	rxHead
     48  2477				   .x
     49  2477		       60		      rts
     50  2478				   .clk
     51  2478		       ee a5 c4 	      inc	clkCount
     52  247b		       ae a9 c4 	      ldx	clkPhase
     53  247e		       e8		      inx
     54  247f		       e0 18		      cpx	#24
     55  2481		       90 14		      bcc	.ph
     56  2483		       a5 10		      lda	ticks
     57  2485		       8d ac c4 	      sta	clkAtL
     58  2488		       a5 11		      lda	ticks+1
     59  248a		       8d ad c4 	      sta	clkAtH
     60  248d		       a5 2d		      lda	subTick
     61  248f		       8d ae c4 	      sta	clkAtS
     62  2492		       ee aa c4 	      inc	clkBeat
     63  2495		       a2 00		      ldx	#0
     64  2497				   .ph
     65  2497		       8e a9 c4 	      stx	clkPhase
     66  249a		       60		      rts
