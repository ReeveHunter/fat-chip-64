    138  0ef3							; A = key code at ksCol / ksRow
    139  0ef3				   KeyCode
    140  0ef3					      subroutine
    141  0ef3		       ad 37 c3 	      lda	ksCol
    142  0ef6		       0a		      asl
    143  0ef7		       0a		      asl
    144  0ef8		       0a		      asl
    145  0ef9		       0d 38 c3 	      ora	ksRow
    146  0efc		       a8		      tay
    147  0efd		       b9 35 69 	      lda	keymap,y
