     56  3bd9		       a8		      tay
     57  3bda		       ad 3f c3 	      lda	nowH
     58  3bdd		       ed 7b c4 	      sbc	dmcAt+1
     59  3be0		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  3be2		       c0 0c		      cpy	#DRUM_WINDOW
     61  3be4		       b0 08		      bcs	.ok
     62  3be6		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     63  3be8		       cd 79 c4 	      cmp	dmcPrio
     64  3beb		       90 01		      bcc	.ok
