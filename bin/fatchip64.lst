     96  5329							; the period since the last beat clock (none yet: this one is the start)
     97  5329		       a5 24		      lda	t0
     98  532b		       38		      sec
     99  532c		       ed ef c5 	      sbc	clkLastQL
    100  532f		       85 26		      sta	t2
