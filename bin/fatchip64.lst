------- FILE lead.asm LEVEL 2 PASS 3
      0  646c					      include	"lead.asm"
      1  646c							; Fat Chip 64 - CHORD + LEAD (v0.28): a chord and a lead at once, each its
      2  646c							; own patch.
      3  646c							;   LOW NOTE  the first key pressed is the chord's root (POLY: just it;
      4  646c							;	       SMART CHORD: its 5TH, TRIAD...; DRONE: the drone); every other
      5  646c							;	       key is the lead, while the chord key is held
      6  646c							;   LATCH 3   three keys pressed together latch as the chord (let go, it
      7  646c							;	       keeps sounding); everything else is the lead. L clears it.
      8  646c							; The lead is one note (the last key pressed) on one voice per chip (SID 3,
      9  646c							; Game Boy pulse 1, NES pulse 1), only while it plays: the rest of the time
     10  646c							; those voices are the chord's. Its patch: SHIFT + A S D F G / Z X C V B.
     11  646c							; The lead's own: the SID's waveform, width, envelope and octave, the Game
     12  646c							; Boy pulse's CCs, the NES pulse's duty. Shared with the chord: the effects
     13  646c							; (vibrato, filter, tremolo...), the NES envelope.
     14  646c
     15  646c							;   KEY       (v0.32) a keyboard split: keys below the split point are the
     16  646c							;	       chord (as the mode plays them), keys from it up the lead (LEAD
     17  646c							;	       OCTAVE, +1 at first). On the C64's keys the split is a key (it
     18  646c							;	       stays put when the octave changes); over MIDI, a note as sent
     19  646c							;	       (before MIDI IN OCTAVE). C= + V held + a note sets either.
     20  646c		       00 01	   CL_KEY     equ	1	; SPLIT (clMode)
     21  646c		       00 02	   CL_LOW     equ	2
     22  646c		       00 03	   CL_L3      equ	3
     23  646c		       00 06	   LEAD_SID   equ	6	; the lead's voices: SID 3, GB pulse 1, NES pulse 1
     24  646c		       00 01	   LEAD_GB    equ	1
     25  646c		       00 02	   LEAD_NES   equ	2
     26  646c
     27  646c							; NoteDown, CHORD + LEAD on: key X pressed. Carry set: it's the lead (the
     28  646c							; latch styles leave it alone).
     29  646c				   ClPress
     30  646c					      subroutine
     31  646c		       8e b0 c3 	      stx	exI
     32  646f		       ad ad c8 	      lda	clMode
