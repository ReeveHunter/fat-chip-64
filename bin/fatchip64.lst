------- FILE drums.asm LEVEL 2 PASS 3
      0  5092					      include	"drums.asm"
      1  5092							; Fat Chip 64 - drums on the MidiNES
      2  5092							;
      3  5092							; Two sources, one kit:
      4  5092							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  5092							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  5092							;			   64 = hit, 56 = ghost)
      7  5092							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  5092							;			   RETURN starts / stops it, at its own tempo (B taps
      9  5092							;			   a new one)
     10  5092							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  5092							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  5092							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  5092							; a note-on, then a note-off after the sound's length, the level set with
     14  5092							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  5092							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  5092
     17  5092		       00 0c	   KIT_SIZE   equ	12
     18  5092		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  5092		       00 00	   DK_KICK    equ	0
     20  5092		       00 01	   DK_SNARE   equ	1
     21  5092		       00 02	   DK_CH      equ	2
     22  5092		       00 03	   DK_OH      equ	3
     23  5092		       00 04	   DK_CY      equ	4
     24  5092		       00 05	   DK_TOM     equ	5
     25  5092		       00 06	   DK_PERC    equ	6
     26  5092
     27  5092							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
