      0  71fe					      include	"screen.asm"
      1  71fe							; Fat Chip 64 - screen
      2  71fe							;
      3  71fe							;  row 0      header
      4  71fe							;  row 2      sound, POLY / MONO, Fat Bass
      5  71fe							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  71fe							;	       each plays (row 7: a channel overlap warning)
      7  71fe							;  row 9      key, notes mode, latch
      8  71fe							;  row 10     arp
      9  71fe							;  row 12     tempo, beat, mute
     10  71fe							;  row 13     SPACE's action, octave (the lowest key), transpose
     11  71fe							;  row 14     v0.40: the effect the C= keys work on, its setting
     12  71fe							;  row 15     held notes
     13  71fe							;  row 16     MIDI in
     14  71fe							;  row 24     F keys
     15  71fe
     16  71fe							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     17  71fe							; Letters become screen codes; bit 7 of t2 reverses.
