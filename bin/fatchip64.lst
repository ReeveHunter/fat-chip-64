    231  0cf5							; Put a message on the wire (IRQ only): A = status, Y = data 1, irqT = data 2.
    232  0cf5							; Program change / channel pressure have one data byte.
    233  0cf5				   WireMsg
    234  0cf5					      subroutine
    235  0cf5		       c5 14		      cmp	lastStatus
    236  0cf7		       f0 05		      beq	.rs
    237  0cf9		       85 14		      sta	lastStatus
    238  0cfb		       20 18 0d 	      jsr	WirePut
    239  0cfe				   .rs
