    405  3a63		       d0 f8		      bne	.x
    406  3a65		       48		      pha
    407  3a66		       20 cc 3a 	      jsr	DevicesReceived
    408  3a69		       68		      pla
    409  3a6a		       60		      rts
    410  3a6b
    411  3a6b							; A data byte (A) inside a SysEx
    412  3a6b				   SysexByte
    413  3a6b					      subroutine
    414  3a6b		       ae 4e c7 	      ldx	sxPos
    415  3a6e		       e0 03		      cpx	#3	; the command: 1 a patch, 2 the chips on / off
    416  3a70		       d0 0b		      bne	.nc
    417  3a72		       c9 02		      cmp	#2
    418  3a74		       d0 07		      bne	.nc
    419  3a76		       8d 1d c8 	      sta	sxCmd
    420  3a79		       ee 4e c7 	      inc	sxPos
    421  3a7c		       60		      rts
    422  3a7d				   .nc
    423  3a7d		       ac 1d c8 	      ldy	sxCmd
    424  3a80		       c0 02		      cpy	#2
    425  3a82		       d0 0b		      bne	.pat
    426  3a84		       e0 04		      cpx	#4	; 2: one byte, bit 0 SID, 1 Game Boy, 2 NES
    427  3a86		       d0 39		      bne	.no
    428  3a88		       8d 1e c8 	      sta	sxArg
    429  3a8b		       ee 4e c7 	      inc	sxPos
