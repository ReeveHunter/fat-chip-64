      0  572c					      include	"menu.asm"
      1  572c							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  572c							;
      3  572c							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  572c							;   page   RETURN opens a page
      5  572c							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  572c							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  572c							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  572c							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  572c							; device pages, until DEVICES says the device is in use).
     10  572c							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  572c							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  572c							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  572c
     14  572c		       00 17	   MENU_VALCOL equ	23
     15  572c
