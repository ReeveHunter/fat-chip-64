      0  61e0					      include	"wander.asm"
      1  61e0							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  61e0							;
      3  61e0							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  61e0							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  61e0							;   ATTACK   as always: the new notes start
      6  61e0							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  61e0							;	      has none)
      8  61e0							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  61e0							;	      start again
     10  61e0							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  61e0							;	      late; some glide, some start again (fade out, come back in)
     12  61e0							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  61e0							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  61e0							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  61e0							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  61e0
     17  61e0		       00 01	   CHG_ATTACK equ	1
     18  61e0		       00 02	   CHG_GLIDE  equ	2
     19  61e0		       00 03	   CHG_STAGGER equ	3
     20  61e0		       00 04	   CHG_WANDER equ	4
     21  61e0		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  61e0
