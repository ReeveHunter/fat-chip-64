    137  0a25							; Carry set if the Teensyboy has room for a message (always, with the Game
    138  0a25							; Boy off), and counts it.
    139  0a25				   LinkRoom
    140  0a25					      subroutine
    141  0a25		       ad 0e c3 	      lda	devOn+DEV_GB
    142  0a28		       f0 0a		      beq	.yes
    143  0a2a		       a5 2d		      lda	linkLoad
    144  0a2c		       c9 2d		      cmp	#LINK_MAX
    145  0a2e		       b0 06		      bcs	.no
    146  0a30		       69 03		      adc	#3
    147  0a32		       85 2d		      sta	linkLoad
    148  0a34				   .yes
    149  0a34		       38		      sec
    150  0a35		       60		      rts
    151  0a36				   .no
    152  0a36		       18		      clc
    153  0a37		       60		      rts
    154  0a38
    155  0a38							; A = free bytes in the wire ring
    156  0a38				   WireFree
    157  0a38					      subroutine
    158  0a38		       a5 15		      lda	wireTail
    159  0a3a		       38		      sec
    160  0a3b		       e5 14		      sbc	wireHead
    161  0a3d		       38		      sec
    162  0a3e		       e9 01		      sbc	#1
    163  0a40		       60		      rts
