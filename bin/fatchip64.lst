    137  0a25							; Carry set if the Teensyboy has room for a message (always, with the Game
    138  0a25							; Boy off), and counts it.
    139  0a25				   LinkRoom
    140  0a25					      subroutine
    141  0a25		       ad 0e c3 	      lda	devOn+DEV_GB
    142  0a28		       f0 0a		      beq	.yes
    143  0a2a		       a5 2d		      lda	linkLoad
    144  0a2c		       c9 2d		      cmp	#LINK_MAX
    145  0a2e		       b0 06		      bcs	.no
    146  0a30		       69 03		      adc	#3
    147  0a32		       85 2d		      sta	linkLoad
    148  0a34				   .yes
    149  0a34		       38		      sec
    150  0a35		       60		      rts
    151  0a36				   .no
    152  0a36		       18		      clc
    153  0a37		       60		      rts
