     87  3c11		       aa		      tax
     88  3c12		       bd 9c 76 	      lda	kits,x
     89  3c15		       85 25		      sta	t1
     90  3c17							; bank (CC14 on the sample channel) when it changes
     91  3c17		       a9 04		      lda	#4
     92  3c19		       20 71 3c 	      jsr	NesChStatus	; mS = CC, sample channel
     93  3c1c		       a9 00		      lda	#0
     94  3c1e		       a6 25		      ldx	t1
     95  3c20		       10 02		      bpl	.a
     96  3c22		       a9 7f		      lda	#127
     97  3c24				   .a
     98  3c24		       cd 78 c4 	      cmp	dmcBank
     99  3c27		       f0 0c		      beq	.note
    100  3c29		       8d 78 c4 	      sta	dmcBank
    101  3c2c		       85 23		      sta	mD2
    102  3c2e		       a9 0e		      lda	#14
    103  3c30		       85 22		      sta	mD1
    104  3c32		       20 a6 0c 	      jsr	NesPut
