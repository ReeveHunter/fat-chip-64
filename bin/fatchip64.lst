------- FILE main.asm
------- FILE voices.asm LEVEL 2 PASS 2
      0  0e3e					      include	"voices.asm"
      1  0e3e							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  0e3e							;
      3  0e3e							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  0e3e							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  0e3e							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  0e3e							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  0e3e							; Allocation, whenever the held notes change:
      8  0e3e							;   1. bass voices play the lowest note, an octave down
      9  0e3e							;   2. every other note gets one voice, lowest notes first
     10  0e3e							;   3. leftover voices stack on the lowest two notes, alternating
     11  0e3e							; So one note = a nine-voice unison across three chips, and in chords the
     12  0e3e							; bottom of the chord is fattest. Disabled devices get no notes.
     13  0e3e
     14  0e3e							; ------------------------------------------------------------ SID
     15  0e3e				   SidInit
     16  0e3e					      subroutine
     17  0e3e		       a2 18		      ldx	#24
     18  0e40		       a9 00		      lda	#0
     19  0e42				   .clr
     20  0e42		       9d 00 d4 	      sta	SID,x
     21  0e45		       ca		      dex
     22  0e46		       10 fa		      bpl	.clr
     23  0e48		       20 6b 0e 	      jsr	SidVolume
     24  0e4b		       a2 02		      ldx	#2
     25  0e4d				   .v
     26  0e4d		       bc f1 15 	      ldy	sidOfs,x
     27  0e50		       a9 19		      lda	#$19	; attack 1, decay 9
     28  0e52		       99 05 d4 	      sta	SID+5,y
