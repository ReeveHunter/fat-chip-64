      0  0b1a					      include	"midi.asm"
      1  0b1a							; Fat Chip 64 - MIDI out
      2  0b1a							;
      3  0b1a							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0b1a							; at most one message per device onto the wire buffer, no sooner than that
      5  0b1a							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0b1a							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0b1a							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0b1a							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0b1a							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0b1a
     11  0b1a				   MidiInit
     12  0b1a					      subroutine
     13  0b1a		       a9 03		      lda	#ACIA_RESET
     14  0b1c		       8d 04 de 	      sta	ACIA_CTRL
     15  0b1f		       a9 16		      lda	#ACIA_MODE
     16  0b21		       8d 04 de 	      sta	ACIA_CTRL
     17  0b24							; (fall into the test)
     18  0b24
     19  0b24							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0b24							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0b24							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0b24							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0b24							; before. Interrupts are off when this is called.
     24  0b24				   MidiIrqTest
     25  0b24					      subroutine
     26  0b24		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0b26		       8d 0d dc 	      sta	CIA1_ICR
