     82  66e5				   .v
     83  66e5		       bd d6 c4 	      lda	nesVT,x
     84  66e8		       18		      clc
     85  66e9		       6d 2f c5 	      adc	nfxN
     86  66ec		       90 02		      bcc	.vt
