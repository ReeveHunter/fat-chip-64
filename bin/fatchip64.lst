    149  7b74							; voice X's glide offset closer to 0: by off / 2^glideK for each 4 ms step
    150  7b74							; (worked out once: d = off >> k, off -= d x n; past 0 or nothing left to
    151  7b74							; move by: there). Keeps X.
    152  7b74				   NesGlideStep
    153  7b74					      subroutine
