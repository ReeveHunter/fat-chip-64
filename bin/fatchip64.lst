------- FILE main.asm
------- FILE arp.asm LEVEL 2 PASS 3
      0  24b0					      include	"arp.asm"
      1  24b0							; Fat Chip 64 - tempo and arpeggiator
      2  24b0							;
      3  24b0							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  24b0							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  24b0							;
      6  24b0							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  24b0							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  24b0							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  24b0							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  24b0							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  24b0							;	     until its voice's next turn.
     12  24b0							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  24b0							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  24b0							;   J faster; either one also picks FREE).
     15  24b0							;
     16  24b0							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  24b0							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  24b0
     19  24b0							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  24b0							; between the two bytes: $22FF read as $23FF)
     21  24b0				   GetTicks
     22  24b0					      subroutine
     23  24b0		       08		      php
     24  24b1		       78		      sei
     25  24b2		       a5 10		      lda	ticks
     26  24b4		       8d 03 c8 	      sta	nowL
     27  24b7		       a5 11		      lda	ticks+1
     28  24b9		       8d 04 c8 	      sta	nowH
     29  24bc		       28		      plp
     30  24bd		       60		      rts
     31  24be
     32  24be							; ------------------------------------------------------------ tempo
     33  24be				   TapTempo
     34  24be					      subroutine
     35  24be		       20 67 5c 	      jsr	FollowActive	; the keytar's clock sets the tempo: taps do nothing
     36  24c1		       f0 01		      beq	.tap
     37  24c3		       60		      rts
     38  24c4				   .tap
     39  24c4		       a9 00		      lda	#0
     40  24c6		       8d e5 ca 	      sta	beatFresh	; (a tempo of your own: a beat starting keeps it)
     41  24c9		       20 b0 24 	      jsr	GetTicks
     42  24cc		       ad 03 c8 	      lda	nowL
     43  24cf		       38		      sec
