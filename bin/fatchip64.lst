     38  d442 ????						; ------------------------------------------------------------ timing
     39  d442 ????	       03 ff	   TICK_LATCH_MS equ	1023	; with the MIDI chip's interrupts (midiIrq): 1 ms
     40  d442 ????	       00 ff	   TICK_LATCH equ	255	; CIA1 timer A: 256 cycles = 1/4 ms (NTSC), quicker
     41  d442 ????						; than a MIDI byte (327 cycles), so the ACIA is fed
     42  d442 ????						; and read (MIDI in) even while the main loop is
