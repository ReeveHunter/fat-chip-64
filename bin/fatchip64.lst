------- FILE midi.asm LEVEL 2 PASS 2
      0  0a06					      include	"midi.asm"
      1  0a06							; Fat Chip 64 - MIDI out
      2  0a06							;
      3  0a06							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0a06							; at most one message per device onto the wire buffer, no sooner than that
      5  0a06							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0a06							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0a06							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0a06							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0a06							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0a06
     11  0a06				   MidiInit
     12  0a06					      subroutine
     13  0a06		       a9 03		      lda	#ACIA_RESET
     14  0a08		       8d 04 de 	      sta	ACIA_CTRL
     15  0a0b		       a9 16		      lda	#ACIA_MODE
     16  0a0d		       8d 04 de 	      sta	ACIA_CTRL
     17  0a10		       60		      rts
     18  0a11
     19  0a11							; IRQ: send one wire byte if the ACIA is ready.
     20  0a11				   TxByte
     21  0a11					      subroutine
     22  0a11		       a6 16		      ldx	wireTail
     23  0a13		       e4 15		      cpx	wireHead
     24  0a15		       f0 0f		      beq	.done
     25  0a17		       ad 06 de 	      lda	ACIA_STAT
     26  0a1a		       29 02		      and	#ACIA_TDRE
     27  0a1c		       f0 08		      beq	.done
     28  0a1e		       bd 00 c0 	      lda	wireBuf,x
     29  0a21		       8d 05 de 	      sta	ACIA_TX
     30  0a24		       e6 16		      inc	wireTail
     31  0a26				   .done
     32  0a26		       60		      rts
     33  0a27
