------- FILE main.asm
------- FILE repeat.asm LEVEL 2 PASS 3
      0  3656					      include	"repeat.asm"
      1  3656							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  3656							;
      3  3656							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  3656							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  3656							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  3656							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  3656							; 1s), taken out of the chord while REPEAT is on - unless the notes held need
      8  3656							; them (then held notes come first and the echoes wait). Each echo sounds for
      9  3656							; 3/4 of the time between echoes. The SID doesn't echo.
     10  3656							;
     11  3656							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     12  3656							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     13  3656							; or a keytar button).
     14  3656							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     15  3656							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     16  3656
     17  3656		       00 10	   RP_SLOTS   equ	16
     18  3656		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     19  3656
     20  3656							; REPEAT is on now?
     21  3656				   RepeatActive
     22  3656		       ad 48 c5 	      lda	repeatOn
     23  3659		       0d ac c4 	      ora	actCnt+A_REPEAT
     24  365c		       60		      rts
     25  365d
