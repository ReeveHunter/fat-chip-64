------- FILE main.asm LEVEL 1 PASS 2
      1  2c2d ????						; Fat Chip 64 - main program
      2  2c2d ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  2c2d ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  2c2d ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  2c2d ????
      6  2c2d ????				      processor	6502
