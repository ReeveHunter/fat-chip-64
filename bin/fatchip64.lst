------- FILE main.asm
------- FILE repeat.asm LEVEL 2 PASS 3
      0  3731					      include	"repeat.asm"
      1  3731							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  3731							;
      3  3731							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  3731							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  3731							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  3731							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  3731							; 1s), taken out of the chord while REPEAT is on - unless the notes held need
      8  3731							; them (then held notes come first and the echoes wait). Each echo sounds for
      9  3731							; 3/4 of the time between echoes. The SID doesn't echo.
     10  3731							;
     11  3731							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     12  3731							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     13  3731							; or a keytar button).
     14  3731							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     15  3731							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     16  3731
     17  3731		       00 10	   RP_SLOTS   equ	16
     18  3731		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     19  3731
     20  3731							; REPEAT is on now?
     21  3731				   RepeatActive
     22  3731		       ad 48 c5 	      lda	repeatOn
     23  3734		       0d ac c4 	      ora	actCnt+A_REPEAT
     24  3737		       60		      rts
     25  3738
