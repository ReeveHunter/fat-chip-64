    333  311a		       10 18 1c 20 gbVibDepT  .byte.b	16, 24, 28, 32
    334  311e		       48 50 54 58*gbVibRateT .byte.b	72, 80, 84, 88, 92, 96, 100
    335  3125		       00 08 10 20*gbVibDelT  .byte.b	0, 8, 16, 32, 64
    336  312a		       10 20 30 40 gbGlideT   .byte.b	16, 32, 48, 64
    337  312e		       03 06 0a 10 gbDetT     .byte.b	3, 6, 10, 16
