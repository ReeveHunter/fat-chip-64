------- FILE voices.asm LEVEL 2 PASS 2
      0  10e6					      include	"voices.asm"
      1  10e6							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  10e6							;
      3  10e6							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  10e6							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  10e6							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  10e6							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  10e6							; Allocation, whenever the held notes change:
      8  10e6							;   1. bass voices play the lowest note, an octave down
      9  10e6							;   2. every other note gets one voice, lowest notes first
     10  10e6							;   3. leftover voices stack on the lowest two notes, alternating
     11  10e6							; So one note = a nine-voice unison across three chips, and in chords the
     12  10e6							; bottom of the chord is fattest. Disabled devices get no notes.
     13  10e6
     14  10e6							; ------------------------------------------------------------ SID
     15  10e6				   SidInit
     16  10e6					      subroutine
     17  10e6		       a2 18		      ldx	#24
     18  10e8		       a9 00		      lda	#0
