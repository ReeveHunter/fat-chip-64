    123  55be							; 250 ms .. 2 s (1000 .. 8000 quarters), else start the average again
    124  55be		       a5 27		      lda	t3
    125  55c0		       c9 03		      cmp	#>1000
    126  55c2		       90 10		      bcc	.bad0
    127  55c4		       d0 06		      bne	.hi
    128  55c6		       a5 26		      lda	t2
    129  55c8		       c9 e8		      cmp	#<1000
