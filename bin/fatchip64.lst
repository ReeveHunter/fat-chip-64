    101  0c3c		       60		      rts
    102  0c3d
    103  0c3d							; IRQ: pace device queues onto the wire.
    104  0c3d							;
    105  0c3d							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0c3d							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0c3d							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0c3d							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0c3d							;
    110  0c3d							; When the Game Boy is on, everything on the wire also passes through the
    111  0c3d							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0c3d							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0c3d							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0c3d							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0c3d							; message, the rate measured clean.
    116  0c3d				   Schedule
    117  0c3d					      subroutine
    118  0c3d		       ad 26 c3 	      lda	devOn+DEV_GB
    119  0c40		       f0 10		      beq	.gb
    120  0c42		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0c44		       f0 0c		      beq	.gb
    122  0c46		       c6 2e		      dec	linkLoad
    123  0c48		       f0 08		      beq	.gb
    124  0c4a		       a5 10		      lda	ticks
    125  0c4c		       29 01		      and	#1
    126  0c4e		       f0 02		      beq	.gb
    127  0c50		       c6 2e		      dec	linkLoad
    128  0c52				   .gb
    129  0c52							; ---- Game Boy
    130  0c52		       a5 18		      lda	gbqTail
    131  0c54		       c5 17		      cmp	gbqHead
    132  0c56		       f0 36		      beq	.nes
    133  0c58		       a5 19		      lda	gbNext
    134  0c5a		       38		      sec
    135  0c5b		       e5 10		      sbc	ticks
    136  0c5d		       f0 04		      beq	.gbDue
    137  0c5f		       c9 04		      cmp	#GB_GAP+1
    138  0c61		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0c63				   .gbDue
    140  0c63							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0c63							; bytes already waiting would otherwise delay this one and squeeze it
    142  0c63							; against the next). While a Game Boy message is due, the NES doesn't
    143  0c63							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0c63							; holding its notes back.
    145  0c63		       a5 15		      lda	wireHead
    146  0c65		       c5 16		      cmp	wireTail
    147  0c67		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0c69		       20 cf 0c 	      jsr	LinkRoom
    149  0c6c		       90 20		      bcc	.nes
    150  0c6e		       a6 18		      ldx	gbqTail
    151  0c70		       bd 00 c1 	      lda	gbqS,x
    152  0c73		       bc 80 c1 	      ldy	gbqD2,x
    153  0c76		       84 2c		      sty	irqT
    154  0c78		       bc 40 c1 	      ldy	gbqD1,x
    155  0c7b		       20 eb 0c 	      jsr	WireMsg
    156  0c7e		       a5 18		      lda	gbqTail
    157  0c80		       18		      clc
    158  0c81		       69 01		      adc	#1
    159  0c83		       29 3f		      and	#63
    160  0c85		       85 18		      sta	gbqTail
    161  0c87		       a5 10		      lda	ticks
    162  0c89		       18		      clc
    163  0c8a		       69 03		      adc	#GB_GAP
    164  0c8c		       85 19		      sta	gbNext
    165  0c8e				   .nes
    166  0c8e		       20 7e 32 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0c91		       a5 1b		      lda	nesqTail
    168  0c93		       c5 1a		      cmp	nesqHead
    169  0c95		       f0 37		      beq	.done
    170  0c97		       a5 1c		      lda	nesNext
    171  0c99		       38		      sec
    172  0c9a		       e5 10		      sbc	ticks
    173  0c9c		       f0 04		      beq	.nesDue
    174  0c9e		       c9 02		      cmp	#NES_GAP+1
    175  0ca0		       90 2c		      bcc	.done
    176  0ca2				   .nesDue
    177  0ca2		       20 e2 0c 	      jsr	WireFree
    178  0ca5		       c9 03		      cmp	#3
    179  0ca7		       90 25		      bcc	.done
    180  0ca9		       20 cf 0c 	      jsr	LinkRoom
    181  0cac		       90 20		      bcc	.done
    182  0cae		       a6 1b		      ldx	nesqTail
    183  0cb0		       bd c0 c1 	      lda	nesqS,x
    184  0cb3		       bc 40 c2 	      ldy	nesqD2,x
    185  0cb6		       84 2c		      sty	irqT
    186  0cb8		       bc 00 c2 	      ldy	nesqD1,x
    187  0cbb		       20 eb 0c 	      jsr	WireMsg
    188  0cbe		       a5 1b		      lda	nesqTail
    189  0cc0		       18		      clc
    190  0cc1		       69 01		      adc	#1
    191  0cc3		       29 3f		      and	#63
    192  0cc5		       85 1b		      sta	nesqTail
    193  0cc7		       a5 10		      lda	ticks
    194  0cc9		       18		      clc
    195  0cca		       69 01		      adc	#NES_GAP
    196  0ccc		       85 1c		      sta	nesNext
    197  0cce				   .done
    198  0cce		       60		      rts
