    181  0c18		       90 20		      bcc	.done
    182  0c1a		       a6 1b		      ldx	nesqTail
    183  0c1c		       bd c0 c1 	      lda	nesqS,x
    184  0c1f		       bc 40 c2 	      ldy	nesqD2,x
    185  0c22		       84 2c		      sty	irqT
    186  0c24		       bc 00 c2 	      ldy	nesqD1,x
    187  0c27		       20 57 0c 	      jsr	WireMsg
