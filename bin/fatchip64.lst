     67  8068		       a5 10		      lda	ticks
     68  806a		       8d 35 c5 	      sta	nfxLast
     69  806d							; ---- vibrato phase, the voices' delay counters, glides
     70  806d		       ac 3b c5 	      ldy	nfxN
     71  8070				   .ph
     72  8070		       ad 41 c5 	      lda	nvPhL
     73  8073		       18		      clc
