     89  2b4a							; ---- BEND DOWN / BEND UP held: up to 255; let go: back twice as fast
     90  2b4a		       ad a1 c4 	      lda	actCnt+A_BENDDN
     91  2b4d		       0d a2 c4 	      ora	actCnt+A_BENDUP
     92  2b50		       f0 18		      beq	.bup
