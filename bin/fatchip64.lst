     77  5149		       6d 4e c9 	      adc	drumLvl
     78  514c				   .k
     79  514c		       aa		      tax
     80  514d		       bd d9 ce 	      lda	kitBuf,x
     81  5150		       85 25		      sta	t1
     82  5152		       a9 7f		      lda	#127	; (full rate: a pad may have changed it)
     83  5154		       20 69 51 	      jsr	DmcPlay
     84  5157		       a5 24		      lda	t0
     85  5159		       8d 45 c9 	      sta	dmcPrio
     86  515c		       ad 03 c8 	      lda	nowL
     87  515f		       8d 46 c9 	      sta	dmcAt
     88  5162		       ad 04 c8 	      lda	nowH
     89  5165		       8d 47 c9 	      sta	dmcAt+1
     90  5168		       60		      rts
     91  5169
     92  5169							; t1 = sample (bit 7: bank B), A = its rate (CC 3): the MidiNES plays it, the
     93  5169							; bank (CC 14) and the rate first when they change (v0.68: DrumHit's, and the
     94  5169							; sampler's). No note-off for the last sample: a note-on cuts it anyway.
     95  5169				   DmcPlay
     96  5169					      subroutine
     97  5169		       85 27		      sta	t3
     98  516b		       ad eb c7 	      lda	devOn+DEV_NES
     99  516e		       f0 49		      beq	.x
    100  5170		       a9 04		      lda	#4
    101  5172		       20 c8 51 	      jsr	NesChStatus	; mS = CC, sample channel
    102  5175		       a9 00		      lda	#0
    103  5177		       a6 25		      ldx	t1
    104  5179		       10 02		      bpl	.a
    105  517b		       a9 7f		      lda	#127
    106  517d				   .a
    107  517d		       cd 44 c9 	      cmp	dmcBank
    108  5180		       f0 0c		      beq	.r
    109  5182		       8d 44 c9 	      sta	dmcBank
    110  5185		       85 23		      sta	mD2
    111  5187		       a9 0e		      lda	#14
