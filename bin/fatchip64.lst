    103  0c35							; IRQ: pace device queues onto the wire.
    104  0c35							;
    105  0c35							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0c35							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0c35							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0c35							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0c35							;
    110  0c35							; When the Game Boy is on, everything on the wire also passes through the
    111  0c35							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0c35							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0c35							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0c35							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0c35							; message, the rate measured clean.
    116  0c35				   Schedule
    117  0c35					      subroutine
    118  0c35		       ad 2a c3 	      lda	devOn+DEV_GB
    119  0c38		       f0 10		      beq	.gb
    120  0c3a		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0c3c		       f0 0c		      beq	.gb
    122  0c3e		       c6 2e		      dec	linkLoad
    123  0c40		       f0 08		      beq	.gb
    124  0c42		       a5 10		      lda	ticks
    125  0c44		       29 01		      and	#1
    126  0c46		       f0 02		      beq	.gb
    127  0c48		       c6 2e		      dec	linkLoad
    128  0c4a				   .gb
    129  0c4a							; ---- Game Boy
    130  0c4a		       a5 18		      lda	gbqTail
    131  0c4c		       c5 17		      cmp	gbqHead
    132  0c4e		       f0 36		      beq	.nes
    133  0c50		       a5 19		      lda	gbNext
    134  0c52		       38		      sec
    135  0c53		       e5 10		      sbc	ticks
    136  0c55		       f0 04		      beq	.gbDue
    137  0c57		       c9 04		      cmp	#GB_GAP+1
    138  0c59		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0c5b				   .gbDue
    140  0c5b							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0c5b							; bytes already waiting would otherwise delay this one and squeeze it
    142  0c5b							; against the next). While a Game Boy message is due, the NES doesn't
    143  0c5b							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0c5b							; holding its notes back.
    145  0c5b		       a5 15		      lda	wireHead
    146  0c5d		       c5 16		      cmp	wireTail
    147  0c5f		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0c61		       20 c7 0c 	      jsr	LinkRoom
    149  0c64		       90 20		      bcc	.nes
    150  0c66		       a6 18		      ldx	gbqTail
    151  0c68		       bd 00 c1 	      lda	gbqS,x
