    464  0b92							; RESTORE: the only NMI source. Count presses; the main loop acts on them.
    465  0b92							; (A MIDI chip wired to NMI instead could fire one during MidiIrqTest: that
    466  0b92							; isn't a press.)
    467  0b92				   Nmi
    468  0b92					      subroutine
    469  0b92		       48		      pha
    470  0b93		       ad 06 de 	      lda	ACIA_STAT
    471  0b96		       10 07		      bpl	.r
    472  0b98		       a9 16		      lda	#ACIA_MODE
    473  0b9a		       8d 04 de 	      sta	ACIA_CTRL
    474  0b9d		       68		      pla
    475  0b9e		       40		      rti
    476  0b9f				   .r
