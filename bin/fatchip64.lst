      0  2eda					      include	"midiin.asm"
      1  2eda							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  2eda							;
      3  2eda							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  2eda							; The main loop parses them (running status; realtime and system bytes are
      5  2eda							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  2eda							; notes mode, latch, arp and K + note.
      7  2eda							;
      8  2eda							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  2eda							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  2eda							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  2eda							;
     12  2eda							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  2eda							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  2eda							;
     15  2eda							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  2eda							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  2eda							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  2eda							; MIDI in is passed on to the Game Boy or NES.
     19  2eda
     20  2eda							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  2eda							; Uses A, X.
     22  2eda							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  2eda							; with the time; a Start ($FA) makes the next clock a beat.
     24  2eda				   RxByte
     25  2eda					      subroutine
     26  2eda		       ad 06 de 	      lda	ACIA_STAT
     27  2edd		       4a		      lsr		; RDRF -> carry
     28  2ede		       90 2b		      bcc	.x
     29  2ee0				   RxGot
     30  2ee0		       ad 07 de 	      lda	ACIA_RX
     31  2ee3		       c9 f8		      cmp	#$F8
     32  2ee5		       f0 25		      beq	.clk
     33  2ee7		       c9 fa		      cmp	#$FA
     34  2ee9		       d0 0e		      bne	.buf
     35  2eeb		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  2eed		       8e e8 c5 	      stx	clkPhase
     37  2ef0		       8e f0 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  2ef3							;  the main loop could measure it)
     39  2ef3		       ae e9 c5 	      ldx	clkBeat
     40  2ef6		       8e fb c5 	      stx	clkStartBeat
     41  2ef9				   .buf
     42  2ef9		       ae 24 c4 	      ldx	rxHead
     43  2efc		       9d e4 c3 	      sta	rxBuf,x
     44  2eff		       e8		      inx
     45  2f00		       8a		      txa
     46  2f01		       29 3f		      and	#63
     47  2f03		       cd 25 c4 	      cmp	rxTail
     48  2f06		       f0 03		      beq	.x	; full: dropped
     49  2f08		       8d 24 c4 	      sta	rxHead
     50  2f0b				   .x
     51  2f0b		       60		      rts
     52  2f0c				   .clk
     53  2f0c		       ee e4 c5 	      inc	clkCount
     54  2f0f		       ae e8 c5 	      ldx	clkPhase
     55  2f12		       e8		      inx
     56  2f13		       e0 18		      cpx	#24
     57  2f15		       90 1b		      bcc	.ph
     58  2f17		       a5 10		      lda	ticks
     59  2f19		       8d eb c5 	      sta	clkAtL
     60  2f1c		       a5 11		      lda	ticks+1
     61  2f1e		       8d ec c5 	      sta	clkAtH
     62  2f21		       a5 2d		      lda	subTick
     63  2f23		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  2f25		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  2f27		       ad 05 dc 	      lda	CIA1_TAHI
     66  2f2a				   .q
     67  2f2a		       8d ed c5 	      sta	clkAtS
     68  2f2d		       ee e9 c5 	      inc	clkBeat
     69  2f30		       a2 00		      ldx	#0
     70  2f32				   .ph
     71  2f32		       8e e8 c5 	      stx	clkPhase
     72  2f35		       60		      rts
