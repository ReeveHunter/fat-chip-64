------- FILE screen.asm LEVEL 2 PASS 3
      0  5a7f					      include	"screen.asm"
      1  5a7f							; Fat Chip 64 - screen
      2  5a7f							;
      3  5a7f							;  row 0      header
      4  5a7f							;  row 2      sound, POLY / MONO, Fat Bass
      5  5a7f							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  5a7f							;	       each plays (row 7: a channel overlap warning)
      7  5a7f							;  row 9      key, notes mode, latch
      8  5a7f							;  row 10     arp
      9  5a7f							;  row 12     tempo, beat, mute
     10  5a7f							;  row 13     SPACE's action, octave (the lowest key)
     11  5a7f							;  row 15     held notes
     12  5a7f							;  row 16     MIDI in
     13  5a7f							;  row 24     F keys
     14  5a7f
     15  5a7f							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     16  5a7f							; Letters become screen codes; bit 7 of t2 reverses.
     17  5a7f				   PrintAt
     18  5a7f					      subroutine
     19  5a7f		       20 97 5a 	      jsr	ScreenAddr
     20  5a82		       a0 00		      ldy	#0
     21  5a84				   .c
     22  5a84		       b1 28		      lda	(ptr),y
     23  5a86		       f0 0e		      beq	.done
     24  5a88		       c9 40		      cmp	#64
     25  5a8a		       90 03		      bcc	.noLetter
     26  5a8c		       38		      sec
     27  5a8d		       e9 40		      sbc	#64
     28  5a8f				   .noLetter
     29  5a8f		       05 26		      ora	t2
     30  5a91		       91 2a		      sta	(ptr2),y
     31  5a93		       c8		      iny
     32  5a94		       d0 ee		      bne	.c
     33  5a96				   .done
     34  5a96		       60		      rts
     35  5a97
     36  5a97							; ptr2 = SCREEN + 40*Y + X (row table: no loop)
     37  5a97				   ScreenAddr
     38  5a97					      subroutine
     39  5a97		       8a		      txa
     40  5a98		       18		      clc
