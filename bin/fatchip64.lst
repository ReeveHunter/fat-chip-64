    164  3b56				   .notes
    165  3b56		       c9 0b		      cmp	#MIDI_IN_CHANS
    166  3b58		       b0 36		      bcs	.x	; channels 12-15: the keytar's accompaniment
    167  3b5a		       85 27		      sta	t3
    168  3b5c		       ad 33 c8 	      lda	rxStatus
    169  3b5f		       29 f0		      and	#$F0
    170  3b61		       c9 b0		      cmp	#$B0
