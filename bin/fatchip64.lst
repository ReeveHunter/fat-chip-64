     82  1ff9		       a9 04		      lda	#ENV_R
     83  1ffb		       99 b9 c3 	      sta	envPh,y
     84  1ffe		       38		      sec
     85  1fff		       60		      rts
     86  2000				   .tri
     87  2000					      if	TRI_DROP_PADS == 0
     88  2000		       4c 32 20 	      jmp	.no	; PADS: the bass just stops (Reeve, 2026-11-01)
     89  2003					      endif
     90  2003		       bd d7 6a 	      lda	vIdx,x
     91  2006		       c9 02		      cmp	#2
     92  2008		       d0 28		      bne	.no
     93  200a		       bd 63 c7 	      lda	vSent,x	; the note actually sounding
     94  200d		       c9 16		      cmp	#TRI_FLOOR+1
     95  200f		       90 21		      bcc	.no	; already at the bottom: just cut
     96  2011		       8d c7 c3 	      sta	triNote
