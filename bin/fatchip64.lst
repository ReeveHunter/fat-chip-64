      0  1096					      include	"voices.asm"
      1  1096							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  1096							;
      3  1096							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  1096							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  1096							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  1096							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  1096							; Allocation, whenever the held notes change:
      8  1096							;   1. bass voices play the lowest note, an octave down
      9  1096							;   2. every other note gets one voice, lowest notes first
     10  1096							;   3. leftover voices stack on the lowest two notes, alternating
     11  1096							; So one note = a nine-voice unison across three chips, and in chords the
     12  1096							; bottom of the chord is fattest. Disabled devices get no notes.
     13  1096
     14  1096							; ------------------------------------------------------------ SID
     15  1096				   SidInit
     16  1096					      subroutine
     17  1096		       a2 18		      ldx	#24
     18  1098		       a9 00		      lda	#0
     19  109a				   .clr
