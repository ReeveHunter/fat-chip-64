    181  0f35							; A = key code
    182  0f35							;   overlay	    notes (K held + a note: set the key)
    183  0f35							;   F1 / F3	    octave up / down		F5  beat start / stop
    184  0f35							;   F7 	    visualizer on / off 	RETURN	the menu
    185  0f35							;   SHIFT+F1/F3/F5 SID / Game Boy / MidiNES on-off	SHIFT+F7 panic
    186  0f35							;   CTRL+F3/F5     Game Boy / MidiNES: next channel block
    187  0f35							;   M		    mute everything	   SPACE  its action
    188  0f35							;   =		    latch on (the menu's LATCH STYLE); latched with notes:
    189  0f35							;		    NEXT (the next key starts a new chord); again: off
    190  0f35							;   Z / X	    notes mode (POLY, CHORD, EXT) / extensions (7 9 11 13)
    191  0f35							;   K + note / L   key root / major-minor
    192  0f35							;   V / SHIFT+V    next / previous sound	    C  POLY / MONO
    193  0f35							;   G		    next beat (and drum kit)
    194  0f35							;   A / S / D / F  arp mode / pattern / speed / SPARKLE octave
    195  0f35							;   ; / :	    free arp speed	      B  tap tempo
    196  0f35							;   , / .	    SPACE mode (MUTES / BENDS)
    197  0f35							;   H / J	    MIDI in octave down / up
    198  0f35							;   (the phantom-key filter stays off: GhostKey is kept for a setup menu)
    199  0f35				   KeyDown
    200  0f35					      subroutine
    201  0f35		       c9 18		      cmp	#24
    202  0f37		       90 03		      bcc	NoteDown
    203  0f39		       4c d1 0f 	      jmp	.cmd
