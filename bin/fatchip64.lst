    354  344f							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    355  344f							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    356  344f							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    357  344f							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    358  344f		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    359  3453		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    360  345a		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    361  3461		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    362  3466		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    363  346a		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    364  346e		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
    365  3473		       05 0a 0f 14*uTremRH    .byte.b	>1311, >2621, >3932, >5243, >6554
    366  3478		       04 08 0c 10 uDetT      .byte.b	4, 8, 12, 16
    367  347c		       18 38 64    uWarbT     .byte.b	24, 56, 100
    368  347f							; ... and the Game Boy's CCs for them (LFO depth CC 1, rate CC 76, delay
    369  347f							; CC 79, glide CC 5, detune +- from 64 on CC 94)
