      0  3d64					      include	"repeat.asm"
      1  3d64							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  3d64							;
      3  3d64							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  3d64							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  3d64							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  3d64							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  3d64							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  3d64							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  3d64							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  3d64							; 3/4 of the time between echoes. The SID doesn't echo.
     11  3d64							;
     12  3d64							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  3d64							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  3d64							; or a keytar button).
     15  3d64							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  3d64							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  3d64
     18  3d64		       00 10	   RP_SLOTS   equ	16
     19  3d64		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  3d64
     21  3d64							; REPEAT is on now?
     22  3d64				   RepeatActive
     23  3d64		       ad 4b c5 	      lda	repeatOn
     24  3d67		       0d ab c4 	      ora	actCnt+A_REPEAT
     25  3d6a		       60		      rts
