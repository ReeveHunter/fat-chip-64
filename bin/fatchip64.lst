------- FILE main.asm
------- FILE nesfx.asm LEVEL 2 PASS 3
      0  7480					      include	"nesfx.asm"
      1  7480							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7480							;
      3  7480							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7480							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7480							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7480							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7480							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7480							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7480							;   glide    a new note starts bent back to the voice's last note and slides
     10  7480							;	      in the way the SID's does (all three channels)
     11  7480							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7480							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7480							; semitone, so these are a little stepped.
     14  7480
     15  7480		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7480							;  (the pulses, and the triangle while it glides)
     17  7480
     18  7480							; A = 1 (not Z) when a NesFxTick step is due
     19  7480				   NesFxDue
     20  7480					      subroutine
     21  7480		       ad 27 c3 	      lda	devOn+DEV_NES
     22  7483		       f0 19		      beq	.x
     23  7485		       ad fe c5 	      lda	vibDepth
     24  7488		       0d 2c c5 	      ora	nfxGlide
     25  748b		       0d 2d c5 	      ora	nfxRun
     26  748e		       f0 0e		      beq	.x
     27  7490		       a5 10		      lda	ticks
     28  7492		       38		      sec
     29  7493		       ed 28 c5 	      sbc	nfxLast
     30  7496		       c9 08		      cmp	#NFX_EVERY
     31  7498		       a9 00		      lda	#0
     32  749a		       90 02		      bcc	.x
     33  749c		       a9 01		      lda	#1
     34  749e				   .x
     35  749e		       60		      rts
     36  749f
     37  749f							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  749f							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
