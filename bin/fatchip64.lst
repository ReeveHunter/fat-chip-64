     42  0bcb		       78		      sei
     43  0bcc		       a6 2f		      ldx	midiIrq
     44  0bce		       bd 06 0c 	      lda	midiCtl,x
     45  0bd1		       8d 04 de 	      sta	ACIA_CTRL
     46  0bd4		       bd 08 0c 	      lda	irqLo,x
     47  0bd7		       8d fe ff 	      sta	$FFFE
     48  0bda		       bd 0a 0c 	      lda	irqHi,x
     49  0bdd		       8d ff ff 	      sta	$FFFF
     50  0be0		       bd 0c 0c 	      lda	latchLo,x
     51  0be3		       8d 04 dc 	      sta	CIA1_TALO
     52  0be6		       bd 0e 0c 	      lda	latchHi,x
     53  0be9		       8d 05 dc 	      sta	CIA1_TAHI
     54  0bec		       a9 11		      lda	#$11	; start, force load, continuous
     55  0bee		       8d 0e dc 	      sta	CIA1_CRA
