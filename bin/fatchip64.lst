------- FILE nesenv.asm LEVEL 2 PASS 2
      0  1b40					      include	"nesenv.asm"
      1  1b40							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  1b40							;
      3  1b40							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  1b40							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  1b40							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  1b40							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  1b40							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  1b40							; The triangle has no volume, so its release is a pitch drop (Reeve's
      9  1b40							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     10  1b40							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     11  1b40							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     12  1b40							; would wrap to a high pitch).
     13  1b40							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     14  1b40
     15  1b40		       00 40	   ENV_ATK    equ	64	; 8.8 level per 10 ms: 15 levels in 0.6 s
     16  1b40		       00 1a	   ENV_DEC    equ	26	; 4 levels (15 -> 11) in 0.4 s
     17  1b40		       00 0b	   ENV_SUS    equ	11
     18  1b40		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     19  1b40		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     20  1b40							; NES channels too, and can't take a bend every 4 ms
     21  1b40		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     22  1b40
     23  1b40							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     24  1b40		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     25  1b49		       02 05	   slotVoice  .byte.b	2,5
     26  1b4b
     27  1b4b							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     28  1b4b							; note keeps sounding for now). X = voice (= t0).
     29  1b4b				   NesSoftRelease
     30  1b4b					      subroutine
     31  1b4b		       ad 7d c3 	      lda	padSound
     32  1b4e		       f0 6d		      beq	.no
     33  1b50		       ad 78 c3 	      lda	muteNow
     34  1b53		       0d b3 c3 	      ora	hardCut
     35  1b56		       d0 65		      bne	.no
     36  1b58		       ad 0f c3 	      lda	devOn+DEV_NES
     37  1b5b		       f0 60		      beq	.no
     38  1b5d		       bd dc 24 	      lda	vDev,x
     39  1b60		       c9 02		      cmp	#DEV_NES
     40  1b62		       d0 59		      bne	.no
     41  1b64		       bd 7f c3 	      lda	vOut,x
     42  1b67		       c9 ff		      cmp	#NO_NOTE
     43  1b69		       f0 52		      beq	.no
     44  1b6b		       bc 40 1b 	      ldy	vEnvSlot,x
     45  1b6e		       30 1b		      bmi	.tri
     46  1b70							; pulse: release from the current level; step = 1.25 x level + 1 (8.8),
     47  1b70							; so any level fades out in about 2 s
     48  1b70		       b9 a5 c3 	      lda	envLvH,y
     49  1b73		       4a		      lsr
     50  1b74		       4a		      lsr
     51  1b75		       99 a9 c3 	      sta	envRel,y
     52  1b78		       b9 a5 c3 	      lda	envLvH,y
     53  1b7b		       18		      clc
     54  1b7c		       79 a9 c3 	      adc	envRel,y
     55  1b7f		       69 01		      adc	#1
     56  1b81		       99 a9 c3 	      sta	envRel,y
     57  1b84		       a9 04		      lda	#ENV_R
     58  1b86		       99 a1 c3 	      sta	envPh,y
     59  1b89		       38		      sec
     60  1b8a		       60		      rts
