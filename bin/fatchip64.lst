    487  0e4e		       00 01 03 00*nesInitCh  .byte.b	0,1,3, 0,1, 0,1, 4
    488  0e56		       0b 0b 0b 0d*nesInitCC  .byte.b	11,11,11, 13,13, 15,15, 3
