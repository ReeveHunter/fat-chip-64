     81  6c14		       a2 08		      ldx	#8	; (the NES voices: 2, 5, 8)
     82  6c16				   .v
     83  6c16		       bd d5 c4 	      lda	nesVT,x
     84  6c19		       18		      clc
     85  6c1a		       6d 2e c5 	      adc	nfxN
     86  6c1d		       90 02		      bcc	.vt
     87  6c1f		       a9 ff		      lda	#255
     88  6c21				   .vt
     89  6c21		       9d d5 c4 	      sta	nesVT,x
     90  6c24		       20 95 6c 	      jsr	NesGlideStep
     91  6c27		       bd c3 c4 	      lda	nesGlL,x
     92  6c2a		       1d cc c4 	      ora	nesGlH,x
     93  6c2d		       0d 2c c5 	      ora	nfxGlide
