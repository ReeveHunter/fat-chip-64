     44  4e02		       4c 26 4e 	      jmp	.beatq
     45  4e05				   .alive
     46  4e05		       ad f2 c5 	      lda	clkHave	; none for a while: start measuring afresh
     47  4e08		       f0 1c		      beq	.beatq
     48  4e0a		       20 49 1f 	      jsr	GetTicks
     49  4e0d		       ad 3f c3 	      lda	nowL
     50  4e10		       38		      sec
     51  4e11		       ed e7 c5 	      sbc	clkSeenL
     52  4e14		       aa		      tax
     53  4e15		       ad 40 c3 	      lda	nowH
     54  4e18		       ed e8 c5 	      sbc	clkSeenH
     55  4e1b		       d0 04		      bne	.lost
     56  4e1d		       e0 2c		      cpx	#<CLK_ALIVE
     57  4e1f		       90 05		      bcc	.beatq
     58  4e21				   .lost
     59  4e21		       a9 00		      lda	#0
