     98  6caf		       10 de		      bpl	.v
     99  6cb1							; ---- the NES queue needs room
    100  6cb1		       a5 1a		      lda	nesqHead
    101  6cb3		       38		      sec
    102  6cb4		       e5 1b		      sbc	nesqTail
    103  6cb6		       29 3f		      and	#63
    104  6cb8		       c9 08		      cmp	#Q_BACKLOG
    105  6cba		       b0 51		      bcs	.x
    106  6cbc							; ---- the next NES voice: a bend if its effects moved
