    103  0baf							; IRQ: pace device queues onto the wire.
    104  0baf							;
    105  0baf							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0baf							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0baf							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0baf							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0baf							;
    110  0baf							; When the Game Boy is on, everything on the wire also passes through the
    111  0baf							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0baf							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0baf							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0baf							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0baf							; message, the rate measured clean.
    116  0baf				   Schedule
    117  0baf					      subroutine
    118  0baf		       ad 26 c3 	      lda	devOn+DEV_GB
    119  0bb2		       f0 10		      beq	.gb
    120  0bb4		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0bb6		       f0 0c		      beq	.gb
    122  0bb8		       c6 2e		      dec	linkLoad
    123  0bba		       f0 08		      beq	.gb
    124  0bbc		       a5 10		      lda	ticks
    125  0bbe		       29 01		      and	#1
    126  0bc0		       f0 02		      beq	.gb
    127  0bc2		       c6 2e		      dec	linkLoad
    128  0bc4				   .gb
    129  0bc4							; ---- Game Boy
    130  0bc4		       a5 18		      lda	gbqTail
    131  0bc6		       c5 17		      cmp	gbqHead
    132  0bc8		       f0 36		      beq	.nes
    133  0bca		       a5 19		      lda	gbNext
    134  0bcc		       38		      sec
    135  0bcd		       e5 10		      sbc	ticks
    136  0bcf		       f0 04		      beq	.gbDue
    137  0bd1		       c9 04		      cmp	#GB_GAP+1
    138  0bd3		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0bd5				   .gbDue
    140  0bd5							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0bd5							; bytes already waiting would otherwise delay this one and squeeze it
    142  0bd5							; against the next). While a Game Boy message is due, the NES doesn't
    143  0bd5							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0bd5							; holding its notes back.
    145  0bd5		       a5 15		      lda	wireHead
    146  0bd7		       c5 16		      cmp	wireTail
    147  0bd9		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0bdb		       20 41 0c 	      jsr	LinkRoom
    149  0bde		       90 20		      bcc	.nes
    150  0be0		       a6 18		      ldx	gbqTail
    151  0be2		       bd 00 c1 	      lda	gbqS,x
    152  0be5		       bc 80 c1 	      ldy	gbqD2,x
    153  0be8		       84 2c		      sty	irqT
    154  0bea		       bc 40 c1 	      ldy	gbqD1,x
    155  0bed		       20 5d 0c 	      jsr	WireMsg
    156  0bf0		       a5 18		      lda	gbqTail
    157  0bf2		       18		      clc
    158  0bf3		       69 01		      adc	#1
    159  0bf5		       29 3f		      and	#63
    160  0bf7		       85 18		      sta	gbqTail
    161  0bf9		       a5 10		      lda	ticks
    162  0bfb		       18		      clc
    163  0bfc		       69 03		      adc	#GB_GAP
    164  0bfe		       85 19		      sta	gbNext
    165  0c00				   .nes
    166  0c00		       20 64 2e 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0c03		       a5 1b		      lda	nesqTail
    168  0c05		       c5 1a		      cmp	nesqHead
    169  0c07		       f0 37		      beq	.done
    170  0c09		       a5 1c		      lda	nesNext
    171  0c0b		       38		      sec
    172  0c0c		       e5 10		      sbc	ticks
    173  0c0e		       f0 04		      beq	.nesDue
    174  0c10		       c9 02		      cmp	#NES_GAP+1
    175  0c12		       90 2c		      bcc	.done
    176  0c14				   .nesDue
