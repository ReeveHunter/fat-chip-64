      0  28ab					      include	"nesenv.asm"
      1  28ab							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  28ab							;
      3  28ab							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  28ab							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  28ab							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  28ab							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  28ab							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  28ab							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  28ab							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  28ab							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  28ab							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  28ab							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  28ab							; would wrap to a high pitch).
     14  28ab							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  28ab
     16  28ab							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  28ab							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  28ab							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  28ab							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  28ab							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  28ab		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  28ab		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  28ab							; NES channels too, and can't take a bend every 4 ms
     24  28ab		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  28ab		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  28ab
     27  28ab							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  28ab		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  28b4		       02 05	   slotVoice  .byte.b	2,5
     30  28b6
     31  28b6							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  28b6							; note keeps sounding for now). X = voice (= t0).
