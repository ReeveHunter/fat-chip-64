      1  0e9f							; Fat Chip 64 - keyboard and RESTORE
      2  0e9f
      3  0e9f							; Scan the whole matrix, turn changes into key events.
      4  0e9f							;
      5  0e9f							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0e9f							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0e9f							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0e9f							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0e9f							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0e9f							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0e9f							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0e9f							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0e9f							; chords whose ghost lands on another used key lose their newest note.
     14  0e9f				   KeyScan
     15  0e9f					      subroutine
     16  0e9f		       a2 07		      ldx	#7
     17  0ea1				   .col
     18  0ea1		       bd 47 80 	      lda	colSelect,x
     19  0ea4		       8d 00 dc 	      sta	CIA1_PRA
     20  0ea7		       ad 01 dc 	      lda	CIA1_PRB
     21  0eaa		       49 ff		      eor	#$FF
     22  0eac		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0eaf		       9d 80 c2 	      sta	keyNow,x
     24  0eb2		       ca		      dex
     25  0eb3		       10 ec		      bpl	.col
     26  0eb5		       a9 ff		      lda	#$FF
     27  0eb7		       8d 00 dc 	      sta	CIA1_PRA
     28  0eba							; ---- every column as accepted (nothing pressed or let go): done
     29  0eba		       a2 07		      ldx	#7
     30  0ebc				   .same
     31  0ebc		       bd 80 c2 	      lda	keyNow,x
     32  0ebf		       dd 90 c2 	      cmp	keyAcc,x
     33  0ec2		       d0 04		      bne	.changed
     34  0ec4		       ca		      dex
     35  0ec5		       10 f5		      bpl	.same
     36  0ec7		       60		      rts
     37  0ec8				   .changed
     38  0ec8							; ---- releases first: accepted keys that are up now
     39  0ec8		       a2 00		      ldx	#0
     40  0eca				   .rc
     41  0eca		       8e 38 c3 	      stx	ksCol
     42  0ecd		       bd 80 c2 	      lda	keyNow,x
     43  0ed0		       49 ff		      eor	#$FF
     44  0ed2		       3d 90 c2 	      and	keyAcc,x
     45  0ed5		       8d 37 c3 	      sta	ksBits
     46  0ed8		       a9 00		      lda	#0
     47  0eda		       8d 39 c3 	      sta	ksRow
     48  0edd				   .rb
     49  0edd		       ad 37 c3 	      lda	ksBits
     50  0ee0		       f0 21		      beq	.rcn
     51  0ee2		       4e 37 c3 	      lsr	ksBits
     52  0ee5		       90 17		      bcc	.rbn
     53  0ee7		       ae 38 c3 	      ldx	ksCol
     54  0eea		       ac 39 c3 	      ldy	ksRow
     55  0eed		       b9 4f 80 	      lda	rowBit,y
     56  0ef0		       49 ff		      eor	#$FF
     57  0ef2		       3d 90 c2 	      and	keyAcc,x
     58  0ef5		       9d 90 c2 	      sta	keyAcc,x
     59  0ef8		       20 9e 0f 	      jsr	KeyCode
     60  0efb		       20 b0 18 	      jsr	KeyUp
     61  0efe				   .rbn
     62  0efe		       ee 39 c3 	      inc	ksRow
     63  0f01		       d0 da		      bne	.rb
     64  0f03				   .rcn
     65  0f03		       ae 38 c3 	      ldx	ksCol
     66  0f06		       e8		      inx
     67  0f07		       e0 08		      cpx	#8
     68  0f09		       d0 bf		      bne	.rc
     69  0f0b							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0f0b							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0f0b							; still count as a combination.
     72  0f0b		       a9 00		      lda	#0
     73  0f0d		       8d 3b c3 	      sta	ksPass
     74  0f10				   .pass
     75  0f10		       a2 00		      ldx	#0
     76  0f12				   .pc
     77  0f12		       8e 38 c3 	      stx	ksCol
     78  0f15		       bd 90 c2 	      lda	keyAcc,x
     79  0f18		       49 ff		      eor	#$FF
     80  0f1a		       3d 80 c2 	      and	keyNow,x
     81  0f1d		       8d 37 c3 	      sta	ksBits
     82  0f20		       a9 00		      lda	#0
     83  0f22		       8d 39 c3 	      sta	ksRow
     84  0f25				   .pb
     85  0f25		       ad 37 c3 	      lda	ksBits
     86  0f28		       f0 49		      beq	.pcn
     87  0f2a		       4e 37 c3 	      lsr	ksBits
     88  0f2d		       90 3f		      bcc	.pbn
     89  0f2f		       ad 3c c3 	      lda	ghostFilter
     90  0f32		       d0 0c		      bne	.chk	; filter off (default): phantom notes play...
     91  0f34		       20 9e 0f 	      jsr	KeyCode
     92  0f37		       c9 18		      cmp	#24
     93  0f39		       90 0a		      bcc	.accept
     94  0f3b		       20 87 0f 	      jsr	IsModifier
     95  0f3e		       f0 05		      beq	.accept
     96  0f40				   .chk 		; ...but a command key never comes from a phantom
     97  0f40		       20 ac 0f 	      jsr	Suspect	;  (v0.40: Q + E held, then C=, read C= + S too)
     98  0f43		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     99  0f45				   .accept
    100  0f45		       20 9e 0f 	      jsr	KeyCode
    101  0f48		       20 87 0f 	      jsr	IsModifier	; Z set = modifier
    102  0f4b		       f0 07		      beq	.mod
    103  0f4d		       ad 3b c3 	      lda	ksPass
    104  0f50		       f0 1c		      beq	.pbn	; pass 0: modifiers only
    105  0f52		       d0 05		      bne	.take
    106  0f54				   .mod
    107  0f54		       ad 3b c3 	      lda	ksPass
    108  0f57		       d0 15		      bne	.pbn	; (taken in pass 0)
    109  0f59				   .take
    110  0f59		       ae 38 c3 	      ldx	ksCol
    111  0f5c		       ac 39 c3 	      ldy	ksRow
    112  0f5f		       b9 4f 80 	      lda	rowBit,y
    113  0f62		       1d 90 c2 	      ora	keyAcc,x
    114  0f65		       9d 90 c2 	      sta	keyAcc,x
    115  0f68		       20 9e 0f 	      jsr	KeyCode
    116  0f6b		       20 dd 0f 	      jsr	KeyDown
    117  0f6e				   .pbn
    118  0f6e		       ee 39 c3 	      inc	ksRow
    119  0f71		       d0 b2		      bne	.pb
    120  0f73				   .pcn
    121  0f73		       ae 38 c3 	      ldx	ksCol
    122  0f76		       e8		      inx
    123  0f77		       e0 08		      cpx	#8
    124  0f79		       d0 97		      bne	.pc
    125  0f7b		       ad 3b c3 	      lda	ksPass
    126  0f7e		       d0 06		      bne	.done
    127  0f80		       ee 3b c3 	      inc	ksPass
    128  0f83		       4c 10 0f 	      jmp	.pass
    129  0f86				   .done
    130  0f86		       60		      rts
    131  0f87
    132  0f87							; Z set if key code A is a modifier. Keeps A.
    133  0f87				   IsModifier
    134  0f87		       c9 88		      cmp	#K_LSHIFT
    135  0f89		       f0 12		      beq	.y
    136  0f8b		       c9 89		      cmp	#K_RSHIFT
    137  0f8d		       f0 0e		      beq	.y
    138  0f8f		       c9 8c		      cmp	#K_CTRL
    139  0f91		       f0 0a		      beq	.y
    140  0f93		       c9 a2		      cmp	#K_CBM
    141  0f95		       f0 06		      beq	.y
    142  0f97		       c9 a3		      cmp	#K_STOP
    143  0f99		       f0 02		      beq	.y
    144  0f9b		       c9 9a		      cmp	#K_K
    145  0f9d				   .y
