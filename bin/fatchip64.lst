      0  5a61					      include	"menu.asm"
      1  5a61							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  5a61							;
      3  5a61							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  5a61							;   page   RETURN opens a page
      5  5a61							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  5a61							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  5a61							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  5a61							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  5a61							; device pages, until DEVICES says the device is in use).
     10  5a61							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  5a61							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  5a61							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  5a61
     14  5a61		       00 17	   MENU_VALCOL equ	23
     15  5a61
