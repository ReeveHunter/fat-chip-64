      0  5097					      include	"drums.asm"
      1  5097							; Fat Chip 64 - drums on the MidiNES
      2  5097							;
      3  5097							; Two sources, one kit:
      4  5097							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  5097							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  5097							;			   64 = hit, 56 = ghost)
      7  5097							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  5097							;			   RETURN starts / stops it, at its own tempo (B taps
      9  5097							;			   a new one)
     10  5097							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  5097							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  5097							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  5097							; a note-on, then a note-off after the sound's length, the level set with
     14  5097							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  5097							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  5097
     17  5097		       00 0c	   KIT_SIZE   equ	12
     18  5097		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  5097		       00 00	   DK_KICK    equ	0
     20  5097		       00 01	   DK_SNARE   equ	1
     21  5097		       00 02	   DK_CH      equ	2
     22  5097		       00 03	   DK_OH      equ	3
     23  5097		       00 04	   DK_CY      equ	4
     24  5097		       00 05	   DK_TOM     equ	5
     25  5097		       00 06	   DK_PERC    equ	6
     26  5097
     27  5097							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
