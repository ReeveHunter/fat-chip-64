     38  7054		       f0 21		      beq	.l3
     39  7056		       c9 01		      cmp	#CL_KEY
     40  7058		       d0 09		      bne	.low
     41  705a		       20 91 71 	      jsr	LeadSide	; KEY: which side of the split
     42  705d		       90 03		      bcc	.ch
     43  705f		       8e cc c8 	      stx	clLeadIdx
     44  7062				   .ch
     45  7062		       60		      rts
     46  7063				   .low
     47  7063							; LOW NOTE: the chord's key, if none is held
