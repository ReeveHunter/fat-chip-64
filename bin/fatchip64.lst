    135  2200		       cd a2 c4 	      cmp	bendSentUp
    136  2203		       f0 45		      beq	.x
    137  2205				   .chg
    138  2205							; not more often than BEND_TICK, unless it's the final centring
    139  2205		       ad a0 c4 	      lda	bendMag
    140  2208		       f0 0b		      beq	.send
    141  220a		       ad 3e c3 	      lda	nowL
    142  220d		       38		      sec
    143  220e		       ed d7 c3 	      sbc	bendSentAt
    144  2211		       c9 14		      cmp	#BEND_TICK
    145  2213		       90 35		      bcc	.x
    146  2215				   .send
    147  2215							; the device queues have to have room (or this waits for the next pass)
    148  2215		       ad 26 c3 	      lda	devOn+DEV_GB
    149  2218		       f0 0b		      beq	.q2
    150  221a		       a5 17		      lda	gbqHead
    151  221c		       38		      sec
    152  221d		       e5 18		      sbc	gbqTail
    153  221f		       29 3f		      and	#63
    154  2221		       c9 08		      cmp	#Q_BACKLOG
    155  2223		       b0 25		      bcs	.x
    156  2225				   .q2
    157  2225		       ad 27 c3 	      lda	devOn+DEV_NES
    158  2228		       f0 0b		      beq	.ok
    159  222a		       a5 1a		      lda	nesqHead
    160  222c		       38		      sec
    161  222d		       e5 1b		      sbc	nesqTail
    162  222f		       29 3f		      and	#63
