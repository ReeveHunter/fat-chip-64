    103  0c38							; IRQ: pace device queues onto the wire.
    104  0c38							;
    105  0c38							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0c38							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0c38							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0c38							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0c38							;
    110  0c38							; When the Game Boy is on, everything on the wire also passes through the
    111  0c38							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0c38							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0c38							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0c38							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0c38							; message, the rate measured clean.
    116  0c38				   Schedule
    117  0c38					      subroutine
    118  0c38		       ad 2a c3 	      lda	devOn+DEV_GB
    119  0c3b		       f0 10		      beq	.gb
    120  0c3d		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0c3f		       f0 0c		      beq	.gb
    122  0c41		       c6 2e		      dec	linkLoad
    123  0c43		       f0 08		      beq	.gb
    124  0c45		       a5 10		      lda	ticks
    125  0c47		       29 01		      and	#1
    126  0c49		       f0 02		      beq	.gb
    127  0c4b		       c6 2e		      dec	linkLoad
    128  0c4d				   .gb
    129  0c4d							; ---- Game Boy
    130  0c4d		       a5 18		      lda	gbqTail
    131  0c4f		       c5 17		      cmp	gbqHead
    132  0c51		       f0 36		      beq	.nes
    133  0c53		       a5 19		      lda	gbNext
    134  0c55		       38		      sec
    135  0c56		       e5 10		      sbc	ticks
    136  0c58		       f0 04		      beq	.gbDue
    137  0c5a		       c9 04		      cmp	#GB_GAP+1
    138  0c5c		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0c5e				   .gbDue
    140  0c5e							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0c5e							; bytes already waiting would otherwise delay this one and squeeze it
    142  0c5e							; against the next). While a Game Boy message is due, the NES doesn't
    143  0c5e							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0c5e							; holding its notes back.
    145  0c5e		       a5 15		      lda	wireHead
    146  0c60		       c5 16		      cmp	wireTail
    147  0c62		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0c64		       20 ca 0c 	      jsr	LinkRoom
    149  0c67		       90 20		      bcc	.nes
    150  0c69		       a6 18		      ldx	gbqTail
    151  0c6b		       bd 00 c1 	      lda	gbqS,x
    152  0c6e		       bc 80 c1 	      ldy	gbqD2,x
    153  0c71		       84 2c		      sty	irqT
    154  0c73		       bc 40 c1 	      ldy	gbqD1,x
    155  0c76		       20 e6 0c 	      jsr	WireMsg
    156  0c79		       a5 18		      lda	gbqTail
    157  0c7b		       18		      clc
    158  0c7c		       69 01		      adc	#1
    159  0c7e		       29 3f		      and	#63
    160  0c80		       85 18		      sta	gbqTail
    161  0c82		       a5 10		      lda	ticks
    162  0c84		       18		      clc
    163  0c85		       69 03		      adc	#GB_GAP
    164  0c87		       85 19		      sta	gbNext
    165  0c89				   .nes
    166  0c89		       20 d8 39 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0c8c		       a5 1b		      lda	nesqTail
    168  0c8e		       c5 1a		      cmp	nesqHead
    169  0c90		       f0 37		      beq	.done
    170  0c92		       a5 1c		      lda	nesNext
    171  0c94		       38		      sec
    172  0c95		       e5 10		      sbc	ticks
    173  0c97		       f0 04		      beq	.nesDue
    174  0c99		       c9 02		      cmp	#NES_GAP+1
