------- FILE midi.asm LEVEL 2 PASS 2
      0  09ad					      include	"midi.asm"
      1  09ad							; Fat Chip 64 - MIDI out
      2  09ad							;
      3  09ad							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  09ad							; at most one message per device onto the wire buffer, no sooner than that
      5  09ad							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  09ad							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  09ad							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  09ad							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  09ad							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  09ad
     11  09ad				   MidiInit
     12  09ad					      subroutine
     13  09ad		       a9 03		      lda	#ACIA_RESET
     14  09af		       8d 04 de 	      sta	ACIA_CTRL
     15  09b2		       a9 16		      lda	#ACIA_MODE
     16  09b4		       8d 04 de 	      sta	ACIA_CTRL
     17  09b7		       60		      rts
     18  09b8
     19  09b8							; IRQ: send one wire byte if the ACIA is ready.
     20  09b8				   TxByte
     21  09b8					      subroutine
     22  09b8		       a6 15		      ldx	wireTail
     23  09ba		       e4 14		      cpx	wireHead
     24  09bc		       f0 0f		      beq	.done
     25  09be		       ad 06 de 	      lda	ACIA_STAT
     26  09c1		       29 02		      and	#ACIA_TDRE
     27  09c3		       f0 08		      beq	.done
     28  09c5		       bd 00 c0 	      lda	wireBuf,x
     29  09c8		       8d 05 de 	      sta	ACIA_TX
     30  09cb		       e6 15		      inc	wireTail
     31  09cd				   .done
     32  09cd		       60		      rts
     33  09ce
     34  09ce							; Main loop: same, with interrupts off around it.
     35  09ce				   TxService
     36  09ce					      subroutine
     37  09ce		       08		      php
     38  09cf		       78		      sei
     39  09d0		       20 b8 09 	      jsr	TxByte
     40  09d3		       28		      plp
     41  09d4		       60		      rts
     42  09d5
     43  09d5							; IRQ: pace device queues onto the wire.
     44  09d5							;
     45  09d5							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
     46  09d5							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
     47  09d5							; times as signed numbers, so after 33 s of silence every queue froze for
     48  09d5							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
     49  09d5							;
     50  09d5							; When the Game Boy is on, everything on the wire also passes through the
     51  09d5							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
     52  09d5							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
     53  09d5							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
     54  09d5							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
     55  09d5							; message, the rate measured clean.
     56  09d5				   Schedule
     57  09d5					      subroutine
     58  09d5		       ad 0e c3 	      lda	devOn+DEV_GB
     59  09d8		       f0 10		      beq	.gb
     60  09da		       a5 2d		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
     61  09dc		       f0 0c		      beq	.gb
     62  09de		       c6 2d		      dec	linkLoad
     63  09e0		       f0 08		      beq	.gb
     64  09e2		       a5 10		      lda	ticks
     65  09e4		       29 01		      and	#1
     66  09e6		       f0 02		      beq	.gb
     67  09e8		       c6 2d		      dec	linkLoad
     68  09ea				   .gb
     69  09ea							; ---- Game Boy
     70  09ea		       a5 17		      lda	gbqTail
     71  09ec		       c5 16		      cmp	gbqHead
     72  09ee		       f0 36		      beq	.nes
     73  09f0		       a5 18		      lda	gbNext
     74  09f2		       38		      sec
     75  09f3		       e5 10		      sbc	ticks
     76  09f5		       f0 04		      beq	.gbDue
     77  09f7		       c9 04		      cmp	#GB_GAP+1
     78  09f9		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
     79  09fb				   .gbDue
     80  09fb							; only onto an empty wire, so the gap holds on the cable itself (NES
     81  09fb							; bytes already waiting would otherwise delay this one and squeeze it
     82  09fb							; against the next)
     83  09fb		       a5 14		      lda	wireHead
     84  09fd		       c5 15		      cmp	wireTail
     85  09ff		       d0 25		      bne	.nes
     86  0a01		       20 64 0a 	      jsr	LinkRoom
     87  0a04		       90 20		      bcc	.nes
     88  0a06		       a6 17		      ldx	gbqTail
     89  0a08		       bd 00 c1 	      lda	gbqS,x
     90  0a0b		       bc 80 c1 	      ldy	gbqD2,x
     91  0a0e		       84 2b		      sty	irqT
     92  0a10		       bc 40 c1 	      ldy	gbqD1,x
     93  0a13		       20 80 0a 	      jsr	WireMsg
     94  0a16		       a5 17		      lda	gbqTail
     95  0a18		       18		      clc
     96  0a19		       69 01		      adc	#1
     97  0a1b		       29 3f		      and	#63
     98  0a1d		       85 17		      sta	gbqTail
     99  0a1f		       a5 10		      lda	ticks
    100  0a21		       18		      clc
    101  0a22		       69 03		      adc	#GB_GAP
    102  0a24		       85 18		      sta	gbNext
    103  0a26				   .nes
    104  0a26		       a5 1a		      lda	nesqTail
    105  0a28		       c5 19		      cmp	nesqHead
    106  0a2a		       f0 37		      beq	.done
    107  0a2c		       a5 1b		      lda	nesNext
    108  0a2e		       38		      sec
    109  0a2f		       e5 10		      sbc	ticks
    110  0a31		       f0 04		      beq	.nesDue
    111  0a33		       c9 02		      cmp	#NES_GAP+1
    112  0a35		       90 2c		      bcc	.done
    113  0a37				   .nesDue
    114  0a37		       20 77 0a 	      jsr	WireFree
    115  0a3a		       c9 03		      cmp	#3
    116  0a3c		       90 25		      bcc	.done
    117  0a3e		       20 64 0a 	      jsr	LinkRoom
    118  0a41		       90 20		      bcc	.done
    119  0a43		       a6 1a		      ldx	nesqTail
    120  0a45		       bd c0 c1 	      lda	nesqS,x
    121  0a48		       bc 40 c2 	      ldy	nesqD2,x
    122  0a4b		       84 2b		      sty	irqT
    123  0a4d		       bc 00 c2 	      ldy	nesqD1,x
    124  0a50		       20 80 0a 	      jsr	WireMsg
    125  0a53		       a5 1a		      lda	nesqTail
    126  0a55		       18		      clc
    127  0a56		       69 01		      adc	#1
    128  0a58		       29 3f		      and	#63
    129  0a5a		       85 1a		      sta	nesqTail
    130  0a5c		       a5 10		      lda	ticks
    131  0a5e		       18		      clc
    132  0a5f		       69 01		      adc	#NES_GAP
    133  0a61		       85 1b		      sta	nesNext
    134  0a63				   .done
    135  0a63		       60		      rts
