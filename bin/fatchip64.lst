     43  0ae2
     44  0ae2							; IRQ: pace device queues onto the wire.
     45  0ae2							;
     46  0ae2							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
     47  0ae2							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
     48  0ae2							; times as signed numbers, so after 33 s of silence every queue froze for
     49  0ae2							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
     50  0ae2							;
     51  0ae2							; When the Game Boy is on, everything on the wire also passes through the
     52  0ae2							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
     53  0ae2							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
     54  0ae2							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
     55  0ae2							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
     56  0ae2							; message, the rate measured clean.
     57  0ae2				   Schedule
     58  0ae2					      subroutine
     59  0ae2		       ad 26 c3 	      lda	devOn+DEV_GB
     60  0ae5		       f0 10		      beq	.gb
     61  0ae7		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
     62  0ae9		       f0 0c		      beq	.gb
     63  0aeb		       c6 2e		      dec	linkLoad
     64  0aed		       f0 08		      beq	.gb
     65  0aef		       a5 10		      lda	ticks
     66  0af1		       29 01		      and	#1
     67  0af3		       f0 02		      beq	.gb
     68  0af5		       c6 2e		      dec	linkLoad
     69  0af7				   .gb
     70  0af7							; ---- Game Boy
     71  0af7		       a5 18		      lda	gbqTail
     72  0af9		       c5 17		      cmp	gbqHead
     73  0afb		       f0 36		      beq	.nes
     74  0afd		       a5 19		      lda	gbNext
     75  0aff		       38		      sec
     76  0b00		       e5 10		      sbc	ticks
     77  0b02		       f0 04		      beq	.gbDue
     78  0b04		       c9 04		      cmp	#GB_GAP+1
     79  0b06		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
     80  0b08				   .gbDue
     81  0b08							; only onto an empty wire, so the gap holds on the cable itself (NES
     82  0b08							; bytes already waiting would otherwise delay this one and squeeze it
     83  0b08							; against the next). While a Game Boy message is due, the NES doesn't
     84  0b08							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
     85  0b08							; holding its notes back.
     86  0b08		       a5 15		      lda	wireHead
     87  0b0a		       c5 16		      cmp	wireTail
     88  0b0c		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
     89  0b0e		       20 74 0b 	      jsr	LinkRoom
     90  0b11		       90 20		      bcc	.nes
     91  0b13		       a6 18		      ldx	gbqTail
     92  0b15		       bd 00 c1 	      lda	gbqS,x
     93  0b18		       bc 80 c1 	      ldy	gbqD2,x
     94  0b1b		       84 2c		      sty	irqT
     95  0b1d		       bc 40 c1 	      ldy	gbqD1,x
     96  0b20		       20 90 0b 	      jsr	WireMsg
     97  0b23		       a5 18		      lda	gbqTail
     98  0b25		       18		      clc
     99  0b26		       69 01		      adc	#1
    100  0b28		       29 3f		      and	#63
    101  0b2a		       85 18		      sta	gbqTail
    102  0b2c		       a5 10		      lda	ticks
    103  0b2e		       18		      clc
    104  0b2f		       69 03		      adc	#GB_GAP
    105  0b31		       85 19		      sta	gbNext
    106  0b33				   .nes
    107  0b33		       20 87 29 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    108  0b36		       a5 1b		      lda	nesqTail
    109  0b38		       c5 1a		      cmp	nesqHead
    110  0b3a		       f0 37		      beq	.done
    111  0b3c		       a5 1c		      lda	nesNext
    112  0b3e		       38		      sec
