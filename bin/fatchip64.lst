    126  0ee4							; Z set if key code A is a modifier. Keeps A.
    127  0ee4				   IsModifier
    128  0ee4		       c9 88		      cmp	#K_LSHIFT
    129  0ee6		       f0 0a		      beq	.y
    130  0ee8		       c9 89		      cmp	#K_RSHIFT
    131  0eea		       f0 06		      beq	.y
    132  0eec		       c9 8c		      cmp	#K_CTRL
    133  0eee		       f0 02		      beq	.y
    134  0ef0		       c9 9a		      cmp	#K_K
    135  0ef2				   .y
