    381  39c7							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    382  39c7							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    383  39c7							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    384  39c7							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    385  39c7		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    386  39cb		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    387  39d2		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    388  39d9		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    389  39de		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    390  39e2		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    391  39e6		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
    392  39eb		       05 0a 0f 14*uTremRH    .byte.b	>1311, >2621, >3932, >5243, >6554
    393  39f0		       04 08 0c 10 uDetT      .byte.b	4, 8, 12, 16
    394  39f4		       18 38 64    uWarbT     .byte.b	24, 56, 100
    395  39f7							; ... and the Game Boy's CCs for them (LFO depth CC 1, rate CC 76, delay
    396  39f7							; CC 79, glide CC 5, detune +- from 64 on CC 94)
    397  39f7		       10 18 1c 20 gbVibDepT  .byte.b	16, 24, 28, 32
    398  39fb		       48 50 54 58*gbVibRateT .byte.b	72, 80, 84, 88, 92, 96, 100
    399  3a02		       00 08 10 20*gbVibDelT  .byte.b	0, 8, 16, 32, 64
