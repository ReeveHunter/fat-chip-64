    364  3a25							; ------------------------------------------------------------ SysEx: a patch from Chip Lab (v0.20)
    365  3a25							; (v0.23: F0 7D 46 43 02 m F7 sets the chips on / off: DevicesReceived)
    366  3a25							; F0 7D 46 43 01 PATCH_SIZE, then the patch (PATCH_SIZE bytes, the live patch's layout:
    367  3a25							; tools/gen_patches.py) as two 4-bit halves each, high first, then F7. It
    368  3a25							; arrives in sxBuf; only a complete one goes into the live patch, which then
    369  3a25							; sounds at once (like choosing a sound). Anything else is ignored.
    370  3a25		       00 05	   SX_HEAD    equ	5
    371  3a25		       00 d5	   SX_LEN     equ	SX_HEAD + PATCH_SIZE * 2
    372  3a25
    373  3a25							; A status byte in A (F0-F7); keeps A
    374  3a25				   SysexStatus
    375  3a25					      subroutine
    376  3a25		       c9 f0		      cmp	#$F0
    377  3a27		       d0 0e		      bne	.end
    378  3a29		       a2 01		      ldx	#1
    379  3a2b		       8e 4d c7 	      stx	sxOn
    380  3a2e		       8e 1d c8 	      stx	sxCmd
    381  3a31		       a2 00		      ldx	#0
    382  3a33		       8e 4e c7 	      stx	sxPos
