------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  3be7					      include	"sounds.asm"
      1  3be7							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  3be7							;
      3  3be7							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  3be7							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  3be7							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  3be7							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  3be7							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  3be7							;
      9  3be7							; Each sound has a mono default and a Fat Bass default:
     10  3be7							;   MONO      one note (the last key pressed and still held) on every voice;
     11  3be7							;	       a new key while another is held changes the pitch without a
     12  3be7							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  3be7							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  3be7							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  3be7							;	       the other voices
     16  3be7							;
     17  3be7							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  3be7							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  3be7							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  3be7
     21  3be7							; ------------------------------------------------------------ choosing
     22  3be7							; V: next sound (SHIFT+V: previous)
     23  3be7				   SoundKey
     24  3be7					      subroutine
     25  3be7		       20 77 3c 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3bea		       ae 95 c3 	      ldx	soundMode
     27  3bed		       ad 2a c3 	      lda	shiftDown
     28  3bf0		       d0 09		      bne	.prev
     29  3bf2		       e8		      inx
     30  3bf3		       e0 13		      cpx	#NUM_SOUNDS
     31  3bf5		       90 09		      bcc	.s
     32  3bf7		       a2 00		      ldx	#0
     33  3bf9		       f0 05		      beq	.s
     34  3bfb				   .prev
     35  3bfb		       ca		      dex
     36  3bfc		       10 02		      bpl	.s
     37  3bfe		       a2 12		      ldx	#NUM_SOUNDS-1
     38  3c00				   .s
