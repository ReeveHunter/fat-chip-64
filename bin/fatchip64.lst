      0  5a6d					      include	"screen.asm"
      1  5a6d							; Fat Chip 64 - screen
      2  5a6d							;
      3  5a6d							;  row 0      header
      4  5a6d							;  row 2      sound, POLY / MONO, Fat Bass
      5  5a6d							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  5a6d							;	       each plays (row 7: a channel overlap warning)
      7  5a6d							;  row 9      key, notes mode, latch
      8  5a6d							;  row 10     arp
      9  5a6d							;  row 12     tempo, beat, mute
     10  5a6d							;  row 13     SPACE's action, octave (the lowest key)
     11  5a6d							;  row 15     held notes
     12  5a6d							;  row 16     MIDI in
     13  5a6d							;  row 24     F keys
     14  5a6d
     15  5a6d							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     16  5a6d							; Letters become screen codes; bit 7 of t2 reverses.
     17  5a6d				   PrintAt
     18  5a6d					      subroutine
     19  5a6d		       20 85 5a 	      jsr	ScreenAddr
     20  5a70		       a0 00		      ldy	#0
     21  5a72				   .c
     22  5a72		       b1 28		      lda	(ptr),y
     23  5a74		       f0 0e		      beq	.done
     24  5a76		       c9 40		      cmp	#64
     25  5a78		       90 03		      bcc	.noLetter
     26  5a7a		       38		      sec
     27  5a7b		       e9 40		      sbc	#64
     28  5a7d				   .noLetter
     29  5a7d		       05 26		      ora	t2
     30  5a7f		       91 2a		      sta	(ptr2),y
     31  5a81		       c8		      iny
     32  5a82		       d0 ee		      bne	.c
     33  5a84				   .done
     34  5a84		       60		      rts
     35  5a85
     36  5a85							; ptr2 = SCREEN + 40*Y + X (row table: no loop)
