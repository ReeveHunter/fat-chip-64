     44  296a		       f0 f1		      beq	.nope
     45  296c		       bd b1 82 	      lda	vDev,x
     46  296f		       c9 02		      cmp	#DEV_NES
     47  2971		       d0 ea		      bne	.nope
     48  2973		       bd 9f c3 	      lda	vOut,x
     49  2976		       c9 ff		      cmp	#NO_NOTE
     50  2978		       f0 e3		      beq	.nope
     51  297a		       ad 53 c4 	      lda	nesEnvOn
     52  297d		       f0 78		      beq	.fo	; (no envelope: BEND OUT's fall-off, if any)
     53  297f		       bc 4f 29 	      ldy	vEnvSlot,x
     54  2982		       30 41		      bmi	.tri
     55  2984							; pulse: release from the current level; step = level x factor / 4 + 1
     56  2984							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  2984							; about 2 s). Factor 0: no release, cut.
