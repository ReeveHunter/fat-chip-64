     39  65e9		       c9 01		      cmp	#CL_KEY
     40  65eb		       d0 09		      bne	.low
     41  65ed		       20 24 67 	      jsr	LeadSide	; KEY: which side of the split
     42  65f0		       90 03		      bcc	.ch
     43  65f2		       8e bf c8 	      stx	clLeadIdx
     44  65f5				   .ch
     45  65f5		       60		      rts
