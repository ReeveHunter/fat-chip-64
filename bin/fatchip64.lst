------- FILE nesenv.asm LEVEL 2 PASS 3
      0  2a2d					      include	"nesenv.asm"
      1  2a2d							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  2a2d							;
      3  2a2d							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  2a2d							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  2a2d							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  2a2d							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  2a2d							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  2a2d							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  2a2d							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  2a2d							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  2a2d							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  2a2d							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  2a2d							; would wrap to a high pitch).
     14  2a2d							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  2a2d
     16  2a2d							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  2a2d							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  2a2d							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  2a2d							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  2a2d							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  2a2d		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  2a2d		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  2a2d							; NES channels too, and can't take a bend every 4 ms
     24  2a2d		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  2a2d		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  2a2d
     27  2a2d							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  2a2d		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  2a36		       02 05	   slotVoice  .byte.b	2,5
     30  2a38
     31  2a38							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  2a38							; note keeps sounding for now). X = voice (= t0).
     33  2a38				   NesSoftRelease
     34  2a38					      subroutine
     35  2a38		       4c 3d 2a 	      jmp	.go
     36  2a3b				   .nope
     37  2a3b		       18		      clc
     38  2a3c		       60		      rts
     39  2a3d				   .go
     40  2a3d		       ad 58 c8 	      lda	muteNow
     41  2a40		       0d 97 c8 	      ora	hardCut
     42  2a43		       d0 f6		      bne	.nope
     43  2a45		       ad eb c7 	      lda	devOn+DEV_NES
     44  2a48		       f0 f1		      beq	.nope
     45  2a4a		       bd 21 90 	      lda	vDev,x
     46  2a4d		       c9 02		      cmp	#DEV_NES
     47  2a4f		       d0 ea		      bne	.nope
     48  2a51		       bd 5f c8 	      lda	vOut,x
     49  2a54		       c9 ff		      cmp	#NO_NOTE
     50  2a56		       f0 e3		      beq	.nope
     51  2a58		       ad 13 c9 	      lda	nesEnvOn
     52  2a5b		       f0 78		      beq	.fo	; (no envelope: BEND OUT's fall-off, if any)
     53  2a5d		       bc 2d 2a 	      ldy	vEnvSlot,x
     54  2a60		       30 41		      bmi	.tri
     55  2a62							; pulse: release from the current level; step = level x factor / 4 + 1
     56  2a62							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  2a62							; about 2 s). Factor 0: no release, cut.
     58  2a62		       ad 36 c9 	      lda	envRelV
     59  2a65		       f0 6e		      beq	.fo
     60  2a67		       86 26		      stx	t2
     61  2a69		       84 27		      sty	t3
     62  2a6b		       b9 85 c8 	      lda	envLvH,y
     63  2a6e		       ac 36 c9 	      ldy	envRelV
     64  2a71		       20 ca 4b 	      jsr	Mul8
     65  2a74		       4e 39 c9 	      lsr	mt16+1
     66  2a77		       6e 38 c9 	      ror	mt16
