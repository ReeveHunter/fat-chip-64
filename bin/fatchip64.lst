    102  0c58
    103  0c58							; IRQ: pace device queues onto the wire.
    104  0c58							;
    105  0c58							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0c58							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0c58							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0c58							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0c58							;
    110  0c58							; When the Game Boy is on, everything on the wire also passes through the
    111  0c58							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0c58							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0c58							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0c58							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0c58							; message, the rate measured clean.
    116  0c58				   Schedule
    117  0c58					      subroutine
    118  0c58		       ad 26 c3 	      lda	devOn+DEV_GB
    119  0c5b		       f0 10		      beq	.gb
    120  0c5d		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0c5f		       f0 0c		      beq	.gb
    122  0c61		       c6 2e		      dec	linkLoad
    123  0c63		       f0 08		      beq	.gb
    124  0c65		       a5 10		      lda	ticks
    125  0c67		       29 01		      and	#1
    126  0c69		       f0 02		      beq	.gb
    127  0c6b		       c6 2e		      dec	linkLoad
    128  0c6d				   .gb
    129  0c6d							; ---- Game Boy
    130  0c6d		       a5 18		      lda	gbqTail
    131  0c6f		       c5 17		      cmp	gbqHead
    132  0c71		       f0 36		      beq	.nes
    133  0c73		       a5 19		      lda	gbNext
    134  0c75		       38		      sec
    135  0c76		       e5 10		      sbc	ticks
    136  0c78		       f0 04		      beq	.gbDue
    137  0c7a		       c9 04		      cmp	#GB_GAP+1
    138  0c7c		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0c7e				   .gbDue
    140  0c7e							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0c7e							; bytes already waiting would otherwise delay this one and squeeze it
    142  0c7e							; against the next). While a Game Boy message is due, the NES doesn't
    143  0c7e							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0c7e							; holding its notes back.
    145  0c7e		       a5 15		      lda	wireHead
    146  0c80		       c5 16		      cmp	wireTail
    147  0c82		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0c84		       20 ea 0c 	      jsr	LinkRoom
    149  0c87		       90 20		      bcc	.nes
    150  0c89		       a6 18		      ldx	gbqTail
    151  0c8b		       bd 00 c1 	      lda	gbqS,x
    152  0c8e		       bc 80 c1 	      ldy	gbqD2,x
    153  0c91		       84 2c		      sty	irqT
    154  0c93		       bc 40 c1 	      ldy	gbqD1,x
    155  0c96		       20 06 0d 	      jsr	WireMsg
    156  0c99		       a5 18		      lda	gbqTail
    157  0c9b		       18		      clc
    158  0c9c		       69 01		      adc	#1
    159  0c9e		       29 3f		      and	#63
    160  0ca0		       85 18		      sta	gbqTail
    161  0ca2		       a5 10		      lda	ticks
    162  0ca4		       18		      clc
    163  0ca5		       69 03		      adc	#GB_GAP
    164  0ca7		       85 19		      sta	gbNext
    165  0ca9				   .nes
    166  0ca9		       20 e6 33 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0cac		       a5 1b		      lda	nesqTail
    168  0cae		       c5 1a		      cmp	nesqHead
    169  0cb0		       f0 37		      beq	.done
    170  0cb2		       a5 1c		      lda	nesNext
    171  0cb4		       38		      sec
    172  0cb5		       e5 10		      sbc	ticks
    173  0cb7		       f0 04		      beq	.nesDue
    174  0cb9		       c9 02		      cmp	#NES_GAP+1
    175  0cbb		       90 2c		      bcc	.done
    176  0cbd				   .nesDue
    177  0cbd		       20 fd 0c 	      jsr	WireFree
    178  0cc0		       c9 03		      cmp	#3
    179  0cc2		       90 25		      bcc	.done
    180  0cc4		       20 ea 0c 	      jsr	LinkRoom
    181  0cc7		       90 20		      bcc	.done
    182  0cc9		       a6 1b		      ldx	nesqTail
    183  0ccb		       bd c0 c1 	      lda	nesqS,x
    184  0cce		       bc 40 c2 	      ldy	nesqD2,x
    185  0cd1		       84 2c		      sty	irqT
    186  0cd3		       bc 00 c2 	      ldy	nesqD1,x
    187  0cd6		       20 06 0d 	      jsr	WireMsg
    188  0cd9		       a5 1b		      lda	nesqTail
    189  0cdb		       18		      clc
    190  0cdc		       69 01		      adc	#1
    191  0cde		       29 3f		      and	#63
    192  0ce0		       85 1b		      sta	nesqTail
    193  0ce2		       a5 10		      lda	ticks
    194  0ce4		       18		      clc
    195  0ce5		       69 01		      adc	#NES_GAP
    196  0ce7		       85 1c		      sta	nesNext
    197  0ce9				   .done
    198  0ce9		       60		      rts
