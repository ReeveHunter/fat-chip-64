    378  0b03							;------------------------------------------------------------- interrupts
    379  0b03							; Every 1/4 ms: take a MIDI-in byte, feed the ACIA one byte (fast path).
    380  0b03							; Every fourth time (1 ms):
    381  0b03							; count a tick and move paced messages onto the wire.
    382  0b03				   Irq
    383  0b03					      subroutine
    384  0b03		       48		      pha
    385  0b04		       8a		      txa
    386  0b05		       48		      pha
    387  0b06		       ad 0d dc 	      lda	CIA1_ICR	; acknowledge
    388  0b09		       ad 06 de 	      lda	ACIA_STAT	; MIDI in: a received byte? (quick check inline)
    389  0b0c		       4a		      lsr
    390  0b0d		       90 03		      bcc	.noRx
    391  0b0f		       20 a2 37 	      jsr	RxGot
    392  0b12				   .noRx
    393  0b12		       a6 16		      ldx	wireTail
    394  0b14		       e4 15		      cpx	wireHead
    395  0b16		       f0 0f		      beq	.noByte
    396  0b18		       ad 06 de 	      lda	ACIA_STAT
    397  0b1b		       29 02		      and	#ACIA_TDRE
    398  0b1d		       f0 08		      beq	.noByte
    399  0b1f		       bd 00 c0 	      lda	wireBuf,x
    400  0b22		       8d 05 de 	      sta	ACIA_TX
    401  0b25		       e6 16		      inc	wireTail
    402  0b27				   .noByte
    403  0b27		       c6 2d		      dec	subTick
    404  0b29		       10 22		      bpl	.out
    405  0b2b		       a9 03		      lda	#3
    406  0b2d		       85 2d		      sta	subTick
    407  0b2f		       98		      tya
    408  0b30		       48		      pha
    409  0b31		       e6 10		      inc	ticks
    410  0b33		       d0 02		      bne	.t
    411  0b35		       e6 11		      inc	ticks+1
    412  0b37				   .t
    413  0b37		       ad 8e c9 	      lda	sidVolNow	; (the SID's volume: a step towards its target)
    414  0b3a		       cd 8f c9 	      cmp	sidVolTgt
    415  0b3d		       f0 03		      beq	.vs
    416  0b3f		       20 f0 19 	      jsr	VolSlew
    417  0b42				   .vs
    418  0b42		       20 58 0c 	      jsr	Schedule
    419  0b45		       20 33 0c 	      jsr	TxByte	; start a just-scheduled message now if the ACIA is free
    420  0b48		       20 9c 37 	      jsr	RxByte	; (again: this pass was long, a byte may be in)
    421  0b4b		       68		      pla
    422  0b4c		       a8		      tay
