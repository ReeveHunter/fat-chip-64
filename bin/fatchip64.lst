    362  355a
    363  355a							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    364  355a							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    365  355a							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    366  355a							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    367  355a		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    368  355e		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    369  3565		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    370  356c		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    371  3571		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    372  3575		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    373  3579		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
    374  357e		       05 0a 0f 14*uTremRH    .byte.b	>1311, >2621, >3932, >5243, >6554
    375  3583		       04 08 0c 10 uDetT      .byte.b	4, 8, 12, 16
    376  3587		       18 38 64    uWarbT     .byte.b	24, 56, 100
    377  358a							; ... and the Game Boy's CCs for them (LFO depth CC 1, rate CC 76, delay
    378  358a							; CC 79, glide CC 5, detune +- from 64 on CC 94)
    379  358a		       10 18 1c 20 gbVibDepT  .byte.b	16, 24, 28, 32
    380  358e		       48 50 54 58*gbVibRateT .byte.b	72, 80, 84, 88, 92, 96, 100
    381  3595		       00 08 10 20*gbVibDelT  .byte.b	0, 8, 16, 32, 64
    382  359a		       10 20 30 40 gbGlideT   .byte.b	16, 32, 48, 64
    383  359e		       03 06 0a 10 gbDetT     .byte.b	3, 6, 10, 16
