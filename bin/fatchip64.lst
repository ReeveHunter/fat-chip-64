------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  3fbe					      include	"sync.asm"
      1  3fbe							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  3fbe							;
      3  3fbe							; Menu, DEVICE SYNC (defaults first):
      4  3fbe							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  3fbe							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  3fbe							;		     sets the tempo, averaged over beats (the clock jitters about
      7  3fbe							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  3fbe							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  3fbe							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  3fbe							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  3fbe							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  3fbe							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  3fbe							;		     picks a beat demo (styleBeat)
     14  3fbe							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  3fbe							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  3fbe							;		     key channel) picks a sound (voiceSound)
     17  3fbe							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  3fbe							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  3fbe							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  3fbe							;
     21  3fbe							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  3fbe							; 1/4 ms); a Start makes the next clock a beat.
     23  3fbe
     24  3fbe		       00 00	   TEMPO_KEYTAR equ	0
     25  3fbe		       00 01	   TEMPO_OWN  equ	1
     26  3fbe		       00 02	   TEMPO_SC   equ	2
     27  3fbe		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  3fbe
     29  3fbe
     30  3fbe
     31  3fbe							; ------------------------------------------------------------ clock
     32  3fbe							; Main loop, every pass
