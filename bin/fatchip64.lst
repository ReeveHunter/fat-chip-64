------- FILE arp.asm LEVEL 2 PASS 2
      0  16b8					      include	"arp.asm"
      1  16b8							; Fat Chip 64 - tempo and arpeggiator
      2  16b8							;
      3  16b8							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  16b8							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  16b8							;
      6  16b8							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  16b8							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  16b8							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  16b8							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  16b8							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  16b8							;	     until its voice's next turn.
     12  16b8							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  16b8							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  16b8							;   J faster; either one also picks FREE).
     15  16b8							;
     16  16b8							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  16b8							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  16b8
     19  16b8							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  16b8							; between the two bytes: $22FF read as $23FF)
     21  16b8				   GetTicks
     22  16b8					      subroutine
     23  16b8		       08		      php
     24  16b9		       78		      sei
     25  16ba		       a5 10		      lda	ticks
     26  16bc		       8d 3e c3 	      sta	nowL
     27  16bf		       a5 11		      lda	ticks+1
     28  16c1		       8d 3f c3 	      sta	nowH
     29  16c4		       28		      plp
     30  16c5		       60		      rts
     31  16c6
     32  16c6							; ------------------------------------------------------------ tempo
     33  16c6				   TapTempo
     34  16c6					      subroutine
