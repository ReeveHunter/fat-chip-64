    142  0fb8							; A = key code at ksCol / ksRow
    143  0fb8				   KeyCode
    144  0fb8					      subroutine
    145  0fb8		       ad 38 c3 	      lda	ksCol
    146  0fbb		       0a		      asl
    147  0fbc		       0a		      asl
    148  0fbd		       0a		      asl
