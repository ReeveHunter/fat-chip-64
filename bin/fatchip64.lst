------- FILE main.asm
------- FILE viz.asm LEVEL 2 PASS 3
      0  5b1f					      include	"viz.asm"
      1  5b1f							; Fat Chip 64 - the visualizer (F7 on / off), a demo
      2  5b1f							;
      3  5b1f							; Nine bars, one per voice, in three groups: SID, Game Boy, MidiNES. A new
      4  5b1f							; note throws its bar to the top; it falls back to a height set by the
      5  5b1f							; note's pitch (higher notes stand taller) while the note sounds, and to
      6  5b1f							; nothing when it stops. The tremolo makes the bars breathe. Each bar takes
      7  5b1f							; the colour of its note's pitch class (C red ... B white). Kick drums flash
      8  5b1f							; the border in the key's colour; row 24 has the sound, the tempo and, while
      9  5b1f							; a beat plays, which beat of the bar it's on.
     10  5b1f							;
     11  5b1f							; One bar is drawn per screen step (about every 8 ms), so the screen stays
     12  5b1f							; out of the way of the keyboard and the arp: about 13 frames a second.
     13  5b1f
     14  5b1f		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     15  5b1f		       00 16	   VIZ_NAMES  equ	22	; note names
     16  5b1f		       00 a0	   VIZ_FULL   equ	160	; reversed space
     17  5b1f		       00 62	   VIZ_HALF   equ	98	; lower half block
     18  5b1f
     19  5b1f							; F7: on / off (not from the menu)
     20  5b1f				   VizKey
     21  5b1f					      subroutine
     22  5b1f		       ad 8a c4 	      lda	menuOn
     23  5b22		       d0 25		      bne	.x
     24  5b24		       ad 9b c5 	      lda	vizOn
     25  5b27		       49 01		      eor	#1
     26  5b29		       8d 9b c5 	      sta	vizOn
     27  5b2c		       f0 03		      beq	.off
     28  5b2e		       4c 6c 5b 	      jmp	VizDraw
     29  5b31				   .off
     30  5b31		       20 d1 43 	      jsr	ClearScreen
     31  5b34		       a9 0d		      lda	#13
     32  5b36		       20 4a 5b 	      jsr	ColourAll
     33  5b39		       20 5c 5b 	      jsr	VizBorderBack
