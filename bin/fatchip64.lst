     93  0e9c				   .accept
     94  0e9c		       20 ed 0e 	      jsr	KeyCode
     95  0e9f		       20 de 0e 	      jsr	IsModifier	; Z set = modifier
     96  0ea2		       f0 07		      beq	.mod
     97  0ea4		       ad 3a c3 	      lda	ksPass
