    130  861e		       8e f6 c9 	      stx	nfxV
    131  8621		       86 24		      stx	t0
    132  8623		       bd 5f c8 	      lda	vOut,x
    133  8626		       c9 ff		      cmp	#NO_NOTE
    134  8628		       f0 20		      beq	.x
    135  862a		       20 b2 87 	      jsr	NesFxVal
    136  862d		       a6 24		      ldx	t0
    137  862f		       ad ff c9 	      lda	nfxL
    138  8632		       dd ab c9 	      cmp	nesFxSL,x
    139  8635		       d0 08		      bne	.send
    140  8637		       ad 00 ca 	      lda	nfxH
    141  863a		       dd b4 c9 	      cmp	nesFxSH,x
    142  863d		       f0 0b		      beq	.x
    143  863f				   .send
    144  863f		       a9 01		      lda	#1
    145  8641		       8d f7 c9 	      sta	nfxHave	; (NesBendVoice: nfx is this voice's already)
    146  8644		       bd 5f c8 	      lda	vOut,x
    147  8647		       4c 57 37 	      jmp	NesBendVoice
    148  864a				   .x
