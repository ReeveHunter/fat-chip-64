      0  6cf8					      include	"nesfx.asm"
      1  6cf8							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  6cf8							;
      3  6cf8							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  6cf8							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  6cf8							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  6cf8							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  6cf8							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  6cf8							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  6cf8							;   glide    a new note starts bent back to the voice's last note and slides
     10  6cf8							;	      in the way the SID's does (all three channels)
     11  6cf8							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  6cf8							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  6cf8							; semitone, so these are a little stepped.
     14  6cf8
     15  6cf8		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  6cf8							;  (the pulses, and the triangle while it glides)
     17  6cf8
     18  6cf8							; A = 1 (not Z) when a NesFxTick step is due
     19  6cf8				   NesFxDue
     20  6cf8					      subroutine
     21  6cf8		       ad 27 c3 	      lda	devOn+DEV_NES
     22  6cfb		       f0 19		      beq	.x
     23  6cfd		       ad fe c5 	      lda	vibDepth
     24  6d00		       0d 2c c5 	      ora	nfxGlide
     25  6d03		       0d 2d c5 	      ora	nfxRun
     26  6d06		       f0 0e		      beq	.x
     27  6d08		       a5 10		      lda	ticks
     28  6d0a		       38		      sec
     29  6d0b		       ed 28 c5 	      sbc	nfxLast
     30  6d0e		       c9 08		      cmp	#NFX_EVERY
     31  6d10		       a9 00		      lda	#0
     32  6d12		       90 02		      bcc	.x
     33  6d14		       a9 01		      lda	#1
     34  6d16				   .x
     35  6d16		       60		      rts
     36  6d17
     37  6d17							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  6d17							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  6d17							; quick return.
     40  6d17				   NesFxTick
     41  6d17					      subroutine
     42  6d17		       ad 27 c3 	      lda	devOn+DEV_NES
     43  6d1a		       f0 0b		      beq	.q
     44  6d1c		       ad fe c5 	      lda	vibDepth
     45  6d1f		       0d 2c c5 	      ora	nfxGlide
     46  6d22		       0d 2d c5 	      ora	nfxRun
     47  6d25		       d0 01		      bne	.on
     48  6d27				   .q
     49  6d27		       60		      rts
     50  6d28				   .on
     51  6d28		       a5 10		      lda	ticks
     52  6d2a		       38		      sec
     53  6d2b		       ed 28 c5 	      sbc	nfxLast
     54  6d2e		       c9 08		      cmp	#NFX_EVERY
     55  6d30		       b0 01		      bcs	.go
     56  6d32		       60		      rts
     57  6d33				   .go
     58  6d33		       4a		      lsr
