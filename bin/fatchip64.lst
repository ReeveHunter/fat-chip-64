    506  5951							; ------------------------------------------------------------ actions
    507  5951							; What SPACE and the keytar's buttons do (menu: SPACE, ... BUTTON):
    508  5951							;   held     MUTE, BEND DOWN, BEND UP, VIBRATO, TREMOLO, ARP, STUTTER,
    509  5951							;	      VINYL STOP, GLIDE, SUSTAIN, OCTAVE UP, REPEAT, FILTER SWEEP,
    510  5951							;	      BEAT FILL, TAPE WOBBLE, WIDE
    511  5951							;   a press  TAP TEMPO, BEAT ON/OFF, NEXT SOUND; or NOTHING
    512  5951							; A held action can be held by several at once; it ends when the last lets go.
    513  5951							;
    514  5951							; A = action, t3 = 1 pressed / 0 let go
