      0  0e37					      include	"keys.asm"
      1  0e37							; Fat Chip 64 - keyboard and RESTORE
      2  0e37
      3  0e37							; Scan the whole matrix, turn changes into key events.
      4  0e37							;
      5  0e37							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0e37							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0e37							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0e37							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0e37							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0e37							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0e37							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0e37							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0e37							; chords whose ghost lands on another used key lose their newest note.
     14  0e37				   KeyScan
     15  0e37					      subroutine
     16  0e37		       a2 07		      ldx	#7
     17  0e39				   .col
     18  0e39		       bd 5d 68 	      lda	colSelect,x
     19  0e3c		       8d 00 dc 	      sta	CIA1_PRA
     20  0e3f		       ad 01 dc 	      lda	CIA1_PRB
     21  0e42		       49 ff		      eor	#$FF
     22  0e44		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0e47		       9d 80 c2 	      sta	keyNow,x
     24  0e4a		       ca		      dex
     25  0e4b		       10 ec		      bpl	.col
     26  0e4d		       a9 ff		      lda	#$FF
     27  0e4f		       8d 00 dc 	      sta	CIA1_PRA
     28  0e52							; ---- every column as accepted (nothing pressed or let go): done
     29  0e52		       a2 07		      ldx	#7
     30  0e54				   .same
     31  0e54		       bd 80 c2 	      lda	keyNow,x
     32  0e57		       dd 90 c2 	      cmp	keyAcc,x
     33  0e5a		       d0 04		      bne	.changed
     34  0e5c		       ca		      dex
     35  0e5d		       10 f5		      bpl	.same
     36  0e5f		       60		      rts
     37  0e60				   .changed
     38  0e60							; ---- releases first: accepted keys that are up now
     39  0e60		       a2 00		      ldx	#0
     40  0e62				   .rc
     41  0e62		       8e 37 c3 	      stx	ksCol
     42  0e65		       bd 80 c2 	      lda	keyNow,x
     43  0e68		       49 ff		      eor	#$FF
     44  0e6a		       3d 90 c2 	      and	keyAcc,x
     45  0e6d		       8d 36 c3 	      sta	ksBits
     46  0e70		       a9 00		      lda	#0
     47  0e72		       8d 38 c3 	      sta	ksRow
     48  0e75				   .rb
     49  0e75		       ad 36 c3 	      lda	ksBits
     50  0e78		       f0 21		      beq	.rcn
     51  0e7a		       4e 36 c3 	      lsr	ksBits
     52  0e7d		       90 17		      bcc	.rbn
     53  0e7f		       ae 37 c3 	      ldx	ksCol
     54  0e82		       ac 38 c3 	      ldy	ksRow
     55  0e85		       b9 65 68 	      lda	rowBit,y
     56  0e88		       49 ff		      eor	#$FF
     57  0e8a		       3d 90 c2 	      and	keyAcc,x
     58  0e8d		       9d 90 c2 	      sta	keyAcc,x
     59  0e90		       20 2a 0f 	      jsr	KeyCode
     60  0e93		       20 de 13 	      jsr	KeyUp
     61  0e96				   .rbn
     62  0e96		       ee 38 c3 	      inc	ksRow
     63  0e99		       d0 da		      bne	.rb
     64  0e9b				   .rcn
     65  0e9b		       ae 37 c3 	      ldx	ksCol
     66  0e9e		       e8		      inx
     67  0e9f		       e0 08		      cpx	#8
     68  0ea1		       d0 bf		      bne	.rc
     69  0ea3							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0ea3							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0ea3							; still count as a combination.
     72  0ea3		       a9 00		      lda	#0
     73  0ea5		       8d 3a c3 	      sta	ksPass
     74  0ea8				   .pass
     75  0ea8		       a2 00		      ldx	#0
     76  0eaa				   .pc
     77  0eaa		       8e 37 c3 	      stx	ksCol
     78  0ead		       bd 90 c2 	      lda	keyAcc,x
     79  0eb0		       49 ff		      eor	#$FF
     80  0eb2		       3d 80 c2 	      and	keyNow,x
     81  0eb5		       8d 36 c3 	      sta	ksBits
     82  0eb8		       a9 00		      lda	#0
     83  0eba		       8d 38 c3 	      sta	ksRow
     84  0ebd				   .pb
     85  0ebd		       ad 36 c3 	      lda	ksBits
     86  0ec0		       f0 3d		      beq	.pcn
     87  0ec2		       4e 36 c3 	      lsr	ksBits
     88  0ec5		       90 33		      bcc	.pbn
     89  0ec7		       ad 3b c3 	      lda	ghostFilter
     90  0eca		       f0 05		      beq	.accept	; filter off (default): phantoms play
     91  0ecc		       20 38 0f 	      jsr	Suspect
     92  0ecf		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     93  0ed1				   .accept
     94  0ed1		       20 2a 0f 	      jsr	KeyCode
     95  0ed4		       20 13 0f 	      jsr	IsModifier	; Z set = modifier
     96  0ed7		       f0 07		      beq	.mod
     97  0ed9		       ad 3a c3 	      lda	ksPass
     98  0edc		       f0 1c		      beq	.pbn	; pass 0: modifiers only
     99  0ede		       d0 05		      bne	.take
    100  0ee0				   .mod
    101  0ee0		       ad 3a c3 	      lda	ksPass
    102  0ee3		       d0 15		      bne	.pbn	; (taken in pass 0)
    103  0ee5				   .take
    104  0ee5		       ae 37 c3 	      ldx	ksCol
    105  0ee8		       ac 38 c3 	      ldy	ksRow
    106  0eeb		       b9 65 68 	      lda	rowBit,y
    107  0eee		       1d 90 c2 	      ora	keyAcc,x
    108  0ef1		       9d 90 c2 	      sta	keyAcc,x
    109  0ef4		       20 2a 0f 	      jsr	KeyCode
    110  0ef7		       20 69 0f 	      jsr	KeyDown
    111  0efa				   .pbn
    112  0efa		       ee 38 c3 	      inc	ksRow
    113  0efd		       d0 be		      bne	.pb
