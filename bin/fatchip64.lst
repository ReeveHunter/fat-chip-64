------- FILE bend.asm LEVEL 2 PASS 3
      0  22eb					      include	"bend.asm"
      1  22eb							; Fat Chip 64 - bends (SPACE / the keytar's buttons and wheel), v0.13
      2  22eb							;
      3  22eb							; What everything is bent by: m = 0-192 sixteenths of a semitone (an octave
      4  22eb							; at most), up or down (bendMag, bendUp), from three things added together:
      5  22eb							;   the BEND DOWN / BEND UP actions (SPACE or a keytar button, held): bendLvl
      6  22eb							;     0-255 ramps up over about 1 s while held, back over about 0.5 s; full =
      7  22eb							;     the menu's BEND RANGE (1-12 semitones, default 2)
      8  22eb							;   the keytar's wheel: wheelMag 0-255 up or down, full = BEND RANGE
      9  22eb							;   VINYL STOP (held): vinylLvl 0-255 the same way, full = an octave down
     10  22eb							;     (and the beat demo and arp slow to half speed with it)
     11  22eb							; Then:
     12  22eb							;   SID       its frequency x 2^(+-m/192), from tables (bendtab.asm)
     13  22eb							;   Game Boy  bend range 12 (CC 85, sent with the sound), bend = 8192 +- m x 8192 / 192
     14  22eb							;   MidiNES   p(n) x the table / 8192 for the triangle, twice for the pulses
     15  22eb							;	       (p = the MidiNES triangle bend scale, 1710 at MIDI 36); notes
     16  22eb							;	       without room at the bottom of the NES range don't bend down.
     17  22eb							; Bends go out every BEND_TICK ms at most, and before each new NES note.
     18  22eb
     19  22eb							; , : SPACE's action back
     20  22eb				   SpaceBack
     21  22eb					      subroutine
