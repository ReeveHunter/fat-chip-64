------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  3350					      include	"sync.asm"
      1  3350							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  3350							;
      3  3350							; Menu, DEVICE SYNC (defaults first):
      4  3350							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  3350							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  3350							;		     sets the tempo, averaged over beats (the clock jitters about
      7  3350							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  3350							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  3350							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  3350							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  3350							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  3350							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  3350							;		     picks a beat demo (styleBeat)
     14  3350							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  3350							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  3350							;		     key channel) picks a sound (voiceSound)
     17  3350							;   WHEEL	     BEND / OFF: +-2 semitones on everything (bend.asm)
     18  3350							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  a task each (CC 1 / 65 / 64, 127
     19  3350							;		     held, 0 let go): VIBRATO, GLIDE, SUSTAIN, MUTE, BEND DOWN,
     20  3350							;		     OCTAVE UP, NEW CHORD, TAP TEMPO, BEAT ON/OFF, NEXT SOUND,
     21  3350							;		     NOTHING. The first six act while held, the rest on a press.
     22  3350							;
     23  3350							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     24  3350							; 1/4 ms); a Start makes the next clock a beat.
     25  3350
     26  3350		       00 00	   TEMPO_KEYTAR equ	0
     27  3350		       00 01	   TEMPO_OWN  equ	1
     28  3350		       00 02	   TEMPO_SC   equ	2
     29  3350		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     30  3350
     31  3350		       00 00	   T_VIBRATO  equ	0
     32  3350		       00 01	   T_GLIDE    equ	1
