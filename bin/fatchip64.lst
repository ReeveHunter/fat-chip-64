    228  0ceb							; Put a message on the wire (IRQ only): A = status, Y = data 1, irqT = data 2.
    229  0ceb							; Program change / channel pressure have one data byte.
    230  0ceb				   WireMsg
    231  0ceb					      subroutine
    232  0ceb		       c5 14		      cmp	lastStatus
    233  0ced		       f0 05		      beq	.rs
    234  0cef		       85 14		      sta	lastStatus
    235  0cf1		       20 0e 0d 	      jsr	WirePut
    236  0cf4				   .rs
    237  0cf4		       98		      tya
    238  0cf5		       20 0e 0d 	      jsr	WirePut
    239  0cf8		       a5 14		      lda	lastStatus
    240  0cfa		       29 e0		      and	#$E0
    241  0cfc		       c9 c0		      cmp	#$C0	; $Cx and $Dx: one data byte
    242  0cfe		       f0 05		      beq	.done
    243  0d00		       a5 2c		      lda	irqT
    244  0d02		       20 0e 0d 	      jsr	WirePut
    245  0d05				   .done
    246  0d05		       ee 34 c3 	      inc	statSent
    247  0d08		       d0 03		      bne	.x
    248  0d0a		       ee 35 c3 	      inc	statSent+1
    249  0d0d				   .x
    250  0d0d		       60		      rts
