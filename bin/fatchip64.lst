     39  d1fa ????	       03 ff	   TICK_LATCH_MS equ	1023	; with the MIDI chip's interrupts (midiIrq): 1 ms
     40  d1fa ????	       00 ff	   TICK_LATCH equ	255	; CIA1 timer A: 256 cycles = 1/4 ms (NTSC), quicker
     41  d1fa ????						; than a MIDI byte (327 cycles), so the ACIA is fed
     42  d1fa ????						; and read (MIDI in) even while the main loop is
