------- FILE drums.asm LEVEL 2 PASS 3
      0  517c					      include	"drums.asm"
      1  517c							; Fat Chip 64 - drums on the MidiNES
      2  517c							;
      3  517c							; Two sources, one kit:
      4  517c							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  517c							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  517c							;			   64 = hit, 56 = ghost)
      7  517c							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  517c							;			   RETURN starts / stops it, at its own tempo (B taps
      9  517c							;			   a new one)
     10  517c							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  517c							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  517c							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  517c							; a note-on, then a note-off after the sound's length, the level set with
     14  517c							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  517c							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  517c
     17  517c		       00 0c	   KIT_SIZE   equ	12
     18  517c		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  517c		       00 00	   DK_KICK    equ	0
     20  517c		       00 01	   DK_SNARE   equ	1
     21  517c		       00 02	   DK_CH      equ	2
     22  517c		       00 03	   DK_OH      equ	3
     23  517c		       00 04	   DK_CY      equ	4
     24  517c		       00 05	   DK_TOM     equ	5
     25  517c		       00 06	   DK_PERC    equ	6
     26  517c
     27  517c							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  517c				   DrumHit
     29  517c					      subroutine
     30  517c		       8d 4f c9 	      sta	drumKind
     31  517f		       8e 4e c9 	      stx	drumLvl
     32  5182		       8c 50 c9 	      sty	drumTom
     33  5185		       c9 00		      cmp	#DK_KICK
     34  5187		       d0 05		      bne	.nk
     35  5189		       a9 01		      lda	#1
     36  518b		       8d 0a cb 	      sta	vizKick	; (the visualizer's border flash)
     37  518e				   .nk
     38  518e		       ad eb c7 	      lda	devOn+DEV_NES
     39  5191		       d0 01		      bne	.on
     40  5193		       60		      rts
     41  5194				   .on
     42  5194		       20 15 25 	      jsr	GetTicks
     43  5197		       ad 4f c9 	      lda	drumKind
     44  519a		       c9 02		      cmp	#DK_CH
     45  519c		       90 07		      bcc	.dmc
     46  519e		       c9 05		      cmp	#DK_TOM
     47  51a0		       b0 03		      bcs	.dmc
     48  51a2		       4c 65 52 	      jmp	NoiseHit
     49  51a5				   .dmc
     50  51a5		       ae 4f c9 	      ldx	drumKind
     51  51a8		       bd 4c 52 	      lda	dmcPrioT,x
     52  51ab		       85 24		      sta	t0
     53  51ad		       ad 03 c8 	      lda	nowL
     54  51b0		       38		      sec
     55  51b1		       ed 46 c9 	      sbc	dmcAt
     56  51b4		       a8		      tay
     57  51b5		       ad 04 c8 	      lda	nowH
     58  51b8		       ed 47 c9 	      sbc	dmcAt+1
     59  51bb		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  51bd		       c0 0c		      cpy	#DRUM_WINDOW
     61  51bf		       b0 08		      bcs	.ok
     62  51c1		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     63  51c3		       cd 45 c9 	      cmp	dmcPrio
     64  51c6		       90 01		      bcc	.ok
     65  51c8		       60		      rts
     66  51c9				   .ok
     67  51c9							; the sample: kit[beat][kitOfs[kind] + level, or + tom]
     68  51c9		       ae 4f c9 	      ldx	drumKind
     69  51cc		       bd 53 52 	      lda	kitOfs,x
     70  51cf		       e0 05		      cpx	#DK_TOM
     71  51d1		       d0 07		      bne	.lv
     72  51d3		       18		      clc
     73  51d4		       6d 50 c9 	      adc	drumTom
     74  51d7		       4c de 51 	      jmp	.k
     75  51da				   .lv
     76  51da		       18		      clc
     77  51db		       6d 4e c9 	      adc	drumLvl
     78  51de				   .k
     79  51de		       aa		      tax
     80  51df		       bd d9 ce 	      lda	kitBuf,x
     81  51e2		       85 25		      sta	t1
     82  51e4		       a9 7f		      lda	#127	; (full rate: a pad may have changed it)
     83  51e6		       20 fb 51 	      jsr	DmcPlay
     84  51e9		       a5 24		      lda	t0
     85  51eb		       8d 45 c9 	      sta	dmcPrio
     86  51ee		       ad 03 c8 	      lda	nowL
     87  51f1		       8d 46 c9 	      sta	dmcAt
     88  51f4		       ad 04 c8 	      lda	nowH
     89  51f7		       8d 47 c9 	      sta	dmcAt+1
     90  51fa		       60		      rts
     91  51fb
     92  51fb							; t1 = sample (bit 7: bank B), A = its rate (CC 3): the MidiNES plays it, the
     93  51fb							; bank (CC 14) and the rate first when they change (v0.68: DrumHit's, and the
     94  51fb							; sampler's). No note-off for the last sample: a note-on cuts it anyway.
     95  51fb				   DmcPlay
     96  51fb					      subroutine
     97  51fb		       85 27		      sta	t3
     98  51fd		       ad eb c7 	      lda	devOn+DEV_NES
     99  5200		       f0 49		      beq	.x
    100  5202		       a9 04		      lda	#4
    101  5204		       20 5a 52 	      jsr	NesChStatus	; mS = CC, sample channel
    102  5207		       a9 00		      lda	#0
    103  5209		       a6 25		      ldx	t1
    104  520b		       10 02		      bpl	.a
    105  520d		       a9 7f		      lda	#127
    106  520f				   .a
    107  520f		       cd 44 c9 	      cmp	dmcBank
    108  5212		       f0 0c		      beq	.r
    109  5214		       8d 44 c9 	      sta	dmcBank
    110  5217		       85 23		      sta	mD2
    111  5219		       a9 0e		      lda	#14
    112  521b		       85 22		      sta	mD1
    113  521d		       20 9e 0d 	      jsr	NesPut
    114  5220				   .r
    115  5220		       a5 27		      lda	t3
    116  5222		       cd 22 fd 	      cmp	dmcRate
    117  5225		       f0 0c		      beq	.note
    118  5227		       8d 22 fd 	      sta	dmcRate
    119  522a		       85 23		      sta	mD2
    120  522c		       a9 03		      lda	#3
    121  522e		       85 22		      sta	mD1
    122  5230		       20 9e 0d 	      jsr	NesPut
    123  5233				   .note
    124  5233		       a5 21		      lda	mS
    125  5235		       29 0f		      and	#$0F
    126  5237		       09 90		      ora	#$90
    127  5239		       85 21		      sta	mS
    128  523b		       a5 25		      lda	t1
    129  523d		       29 7f		      and	#$7F
    130  523f		       8d 51 c9 	      sta	dmcNote
    131  5242		       85 22		      sta	mD1
    132  5244		       a9 7f		      lda	#127
    133  5246		       85 23		      sta	mD2
    134  5248		       4c 9e 0d 	      jmp	NesPut
    135  524b				   .x
    136  524b		       60		      rts
    137  524c
    138  524c		       00 01 00 00*dmcPrioT   .byte.b	0,1,0,0,0,2,3	; kick, snare, -, -, -, tom, perc
    139  5253		       00 03 00 00*kitOfs     .byte.b	0,3,0,0,0,6,9
