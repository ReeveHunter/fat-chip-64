     42  32df		       90 02		      bcc	SpaceSet
     43  32e1		       a2 00		      ldx	#0
     44  32e3				   SpaceSet
     45  32e3		       8e a0 c8 	      stx	spaceAct	; (one held now ends with its own action: spaceHeld)
     46  32e6		       4c 64 19 	      jmp	Dirty
     47  32e9
