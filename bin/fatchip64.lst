     47  69b9		       c9 ff		      cmp	#NO_NOTE	;  voice's last note, like a portamento)
     48  69bb		       f0 2a		      beq	.now0
     49  69bd		       ad d7 c3 	      lda	hardCut
     50  69c0		       0d 51 c4 	      ora	monoMode
