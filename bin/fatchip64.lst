------- FILE midiin.asm LEVEL 2 PASS 3
      0  327e					      include	"midiin.asm"
      1  327e							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  327e							;
      3  327e							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  327e							; The main loop parses them (running status; realtime and system bytes are
      5  327e							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  327e							; notes mode, latch, arp and K + note.
      7  327e							;
      8  327e							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  327e							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  327e							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  327e							;
     12  327e							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  327e							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  327e							;
     15  327e							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  327e							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  327e							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  327e							; MIDI in is passed on to the Game Boy or NES.
     19  327e
     20  327e							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  327e							; Uses A, X.
     22  327e							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  327e							; with the time; a Start ($FA) makes the next clock a beat.
     24  327e				   RxByte
     25  327e					      subroutine
     26  327e		       ad 06 de 	      lda	ACIA_STAT
     27  3281		       4a		      lsr		; RDRF -> carry
     28  3282		       90 2b		      bcc	.x
     29  3284				   RxGot
     30  3284		       ad 07 de 	      lda	ACIA_RX
     31  3287		       c9 f8		      cmp	#$F8
     32  3289		       f0 25		      beq	.clk
     33  328b		       c9 fa		      cmp	#$FA
     34  328d		       d0 0e		      bne	.buf
     35  328f		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  3291		       8e e8 c5 	      stx	clkPhase
     37  3294		       8e f0 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3297							;  the main loop could measure it)
     39  3297		       ae e9 c5 	      ldx	clkBeat
     40  329a		       8e fb c5 	      stx	clkStartBeat
     41  329d				   .buf
     42  329d		       ae 24 c4 	      ldx	rxHead
     43  32a0		       9d e4 c3 	      sta	rxBuf,x
     44  32a3		       e8		      inx
     45  32a4		       8a		      txa
     46  32a5		       29 3f		      and	#63
     47  32a7		       cd 25 c4 	      cmp	rxTail
     48  32aa		       f0 03		      beq	.x	; full: dropped
     49  32ac		       8d 24 c4 	      sta	rxHead
     50  32af				   .x
     51  32af		       60		      rts
     52  32b0				   .clk
     53  32b0		       ee e4 c5 	      inc	clkCount
     54  32b3		       ae e8 c5 	      ldx	clkPhase
     55  32b6		       e8		      inx
     56  32b7		       e0 18		      cpx	#24
     57  32b9		       90 1b		      bcc	.ph
     58  32bb		       a5 10		      lda	ticks
     59  32bd		       8d eb c5 	      sta	clkAtL
     60  32c0		       a5 11		      lda	ticks+1
     61  32c2		       8d ec c5 	      sta	clkAtH
     62  32c5		       a5 2d		      lda	subTick
     63  32c7		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  32c9		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  32cb		       ad 05 dc 	      lda	CIA1_TAHI
     66  32ce				   .q
     67  32ce		       8d ed c5 	      sta	clkAtS
     68  32d1		       ee e9 c5 	      inc	clkBeat
     69  32d4		       a2 00		      ldx	#0
     70  32d6				   .ph
     71  32d6		       8e e8 c5 	      stx	clkPhase
     72  32d9		       60		      rts
     73  32da
     74  32da							; Main loop, every pass: parse what came in.
     75  32da				   MidiInService
     76  32da					      subroutine
     77  32da				   .next
     78  32da		       ae 25 c4 	      ldx	rxTail
     79  32dd		       ec 24 c4 	      cpx	rxHead
     80  32e0		       d0 01		      bne	.byte
     81  32e2		       60		      rts
     82  32e3				   .byte
     83  32e3		       bd e4 c3 	      lda	rxBuf,x
     84  32e6		       a8		      tay
     85  32e7		       e8		      inx
     86  32e8		       8a		      txa
     87  32e9		       29 3f		      and	#63
     88  32eb		       8d 25 c4 	      sta	rxTail
     89  32ee		       98		      tya
     90  32ef		       10 1e		      bpl	.data
     91  32f1		       c9 f8		      cmp	#$F8
     92  32f3		       b0 49		      bcs	.rt	; realtime (clocks are counted by RxByte)
     93  32f5		       c9 f0		      cmp	#$F0
     94  32f7		       b0 07		      bcs	.sys
     95  32f9		       a2 00		      ldx	#0	; a channel message ends any SysEx
     96  32fb		       8e 4c c7 	      stx	sxOn
     97  32fe		       f0 05		      beq	.status
     98  3300				   .sys
