------- FILE main.asm
------- FILE sampler.asm LEVEL 2 PASS 3
      0  82dc					      include	"sampler.asm"
      1  82dc							; Fat Chip 64 - SAMPLER MODE, stage 1 (v0.68): 16 pads and the sample browser
      2  82dc							;
      3  82dc							; RUN/STOP + RETURN switches between the play screen and the sampler. Its
      4  82dc							; 16 pads are 1234 / QWER / ASDF / ZXCV (PAD KEYS GRID) or the overlay's
      5  82dc							; lowest 16 notes, Z's pad on Q (C3) and on up ZXCV ASDF QWER 1234 (OVERLAY).
      6  82dc							; A pad plays its MidiNES sample at its rate, and on the Game Boy the drum its
      7  82dc							; hit type matches, as the beats would (BEATS ON, BOTH LAYER / SPLIT); tonal,
      8  82dc							; FX and vocal samples play on the MidiNES only. SHIFT + a pad: accented.
      9  82dc							; Notes on PAD MIDI CHANNEL from PAD BASE NOTE up play the pads too (any
     10  82dc							; screen), with their velocity on the Game Boy.
     11  82dc							;
     12  82dc							; The browser (the MidiNES's 256 samples, A0-A127, B0-B127):
     13  82dc							;   CRSR DOWN (SHIFT: back)   the next sample of the TYPE, played
     14  82dc							;   C= + CRSR DOWN	       TYPE: ALL, K, S, H, P, L, T, F, V
     15  82dc							;   CRSR RIGHT (SHIFT: down)  its rate, 0-15 (MidiNES CC 3 = rate x 8 + 7)
     16  82dc							;   SPACE		       play it again
     17  82dc							;   RETURN, then a pad        the pad gets it at that rate; RETURN, then SPACE:
     18  82dc							;			       all 16, the rates low to high up the pads
     19  82dc							;   C= + F1 / F3	       pad kit 2 / 1 (two, kept until reset)
     20  82dc							;   C= + RETURN	       the menu (its SAMPLER page has the settings)
     21  82dc							; Kit 1 starts as the beat's MidiNES kit on the standard pads (Z kick, X snare,
     22  82dc							; C V hats, A S accents, D F R toms, E perc), the first time the sampler opens.
     23  82dc
     24  82dc		       00 7f	   SMP_ACCENT equ	127	; the Game Boy's velocity: SHIFT + a pad, else
     25  82dc		       00 64	   SMP_NORMAL equ	100
     26  82dc		       00 5a	   SMP_LIT_MS equ	90	; a pad lights this long
     27  82dc
     28  82dc							; ---- RUN/STOP + RETURN
     29  82dc				   SmpToggle
     30  82dc					      subroutine
     31  82dc		       ad 18 fd 	      lda	smpOn
