      0  750a					      include	"screen.asm"
      1  750a							; Fat Chip 64 - screen
      2  750a							;
      3  750a							;  row 0      header
      4  750a							;  row 2      sound, POLY / MONO, Fat Bass
      5  750a							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  750a							;	       each plays (row 7: a channel overlap warning)
      7  750a							;  row 9      key, notes mode, latch
      8  750a							;  row 10     arp
      9  750a							;  row 12     tempo, beat, mute
     10  750a							;  row 13     SPACE's action, octave (the lowest key), transpose
     11  750a							;  row 14     v0.40: the effect the C= keys work on, its setting
     12  750a							;  row 15     held notes
     13  750a							;  row 16     MIDI in
     14  750a							;  row 24     F keys
     15  750a
     16  750a							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
