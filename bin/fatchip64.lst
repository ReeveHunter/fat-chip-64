      0  59cc					      include	"patchedit.asm"
      1  59cc							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  59cc							; the dice. The settings and their steps come from tools/gen_menu.py
      3  59cc							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  59cc							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  59cc							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  59cc							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  59cc							; (EnvDerive).
      8  59cc
      9  59cc		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  59cc		       00 30	   LFO_LAST   equ	FLD_gbLDelay
     11  59cc
