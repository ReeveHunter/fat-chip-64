      0  594a					      include	"screen.asm"
      1  594a							; Fat Chip 64 - screen
      2  594a							;
      3  594a							;  row 0      header
      4  594a							;  row 2      sound, POLY / MONO, Fat Bass
      5  594a							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  594a							;	       each plays (row 7: a channel overlap warning)
      7  594a							;  row 9      key, notes mode, latch
      8  594a							;  row 10     arp
      9  594a							;  row 12     tempo, beat, mute
     10  594a							;  row 13     SPACE's action, octave (the lowest key)
     11  594a							;  row 15     held notes
     12  594a							;  row 16     MIDI in
     13  594a							;  row 24     F keys
     14  594a
