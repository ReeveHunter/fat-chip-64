    196  0aab							; ------------------------------------------------------------ queueing (main loop)
    197  0aab							; Message in mS / mD1 / mD2. Dropped if the queue is full (63 messages).
    198  0aab				   GbPut
    199  0aab					      subroutine
    200  0aab							; write the slot at head first (always free: one slot stays empty),
    201  0aab							; then publish head unless the queue is full. Uses only A and X.
    202  0aab		       a6 16		      ldx	gbqHead
    203  0aad		       a5 20		      lda	mS
    204  0aaf		       9d 00 c1 	      sta	gbqS,x
    205  0ab2		       a5 21		      lda	mD1
    206  0ab4		       9d 40 c1 	      sta	gbqD1,x
    207  0ab7		       a5 22		      lda	mD2
    208  0ab9		       9d 80 c1 	      sta	gbqD2,x
    209  0abc		       8a		      txa
    210  0abd		       18		      clc
    211  0abe		       69 01		      adc	#1
    212  0ac0		       29 3f		      and	#63
    213  0ac2		       c5 17		      cmp	gbqTail
    214  0ac4		       f0 02		      beq	.full
    215  0ac6		       85 16		      sta	gbqHead
    216  0ac8				   .full
    217  0ac8		       60		      rts
    218  0ac9
    219  0ac9				   NesPut
