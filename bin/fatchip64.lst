    103  0ba9							; IRQ: pace device queues onto the wire.
    104  0ba9							;
    105  0ba9							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0ba9							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0ba9							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0ba9							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0ba9							;
    110  0ba9							; When the Game Boy is on, everything on the wire also passes through the
    111  0ba9							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0ba9							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0ba9							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0ba9							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0ba9							; message, the rate measured clean.
    116  0ba9				   Schedule
    117  0ba9					      subroutine
    118  0ba9		       ad 26 c3 	      lda	devOn+DEV_GB
    119  0bac		       f0 10		      beq	.gb
    120  0bae		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0bb0		       f0 0c		      beq	.gb
    122  0bb2		       c6 2e		      dec	linkLoad
    123  0bb4		       f0 08		      beq	.gb
    124  0bb6		       a5 10		      lda	ticks
    125  0bb8		       29 01		      and	#1
    126  0bba		       f0 02		      beq	.gb
    127  0bbc		       c6 2e		      dec	linkLoad
    128  0bbe				   .gb
    129  0bbe							; ---- Game Boy
    130  0bbe		       a5 18		      lda	gbqTail
    131  0bc0		       c5 17		      cmp	gbqHead
    132  0bc2		       f0 36		      beq	.nes
    133  0bc4		       a5 19		      lda	gbNext
    134  0bc6		       38		      sec
    135  0bc7		       e5 10		      sbc	ticks
    136  0bc9		       f0 04		      beq	.gbDue
    137  0bcb		       c9 04		      cmp	#GB_GAP+1
    138  0bcd		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0bcf				   .gbDue
    140  0bcf							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0bcf							; bytes already waiting would otherwise delay this one and squeeze it
    142  0bcf							; against the next). While a Game Boy message is due, the NES doesn't
    143  0bcf							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0bcf							; holding its notes back.
    145  0bcf		       a5 15		      lda	wireHead
    146  0bd1		       c5 16		      cmp	wireTail
    147  0bd3		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0bd5		       20 3b 0c 	      jsr	LinkRoom
    149  0bd8		       90 20		      bcc	.nes
    150  0bda		       a6 18		      ldx	gbqTail
    151  0bdc		       bd 00 c1 	      lda	gbqS,x
    152  0bdf		       bc 80 c1 	      ldy	gbqD2,x
    153  0be2		       84 2c		      sty	irqT
    154  0be4		       bc 40 c1 	      ldy	gbqD1,x
    155  0be7		       20 57 0c 	      jsr	WireMsg
    156  0bea		       a5 18		      lda	gbqTail
    157  0bec		       18		      clc
    158  0bed		       69 01		      adc	#1
    159  0bef		       29 3f		      and	#63
    160  0bf1		       85 18		      sta	gbqTail
    161  0bf3		       a5 10		      lda	ticks
    162  0bf5		       18		      clc
    163  0bf6		       69 03		      adc	#GB_GAP
    164  0bf8		       85 19		      sta	gbNext
    165  0bfa				   .nes
    166  0bfa		       20 a9 2b 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0bfd		       a5 1b		      lda	nesqTail
    168  0bff		       c5 1a		      cmp	nesqHead
    169  0c01		       f0 37		      beq	.done
    170  0c03		       a5 1c		      lda	nesNext
    171  0c05		       38		      sec
    172  0c06		       e5 10		      sbc	ticks
    173  0c08		       f0 04		      beq	.nesDue
    174  0c0a		       c9 02		      cmp	#NES_GAP+1
    175  0c0c		       90 2c		      bcc	.done
    176  0c0e				   .nesDue
    177  0c0e		       20 4e 0c 	      jsr	WireFree
    178  0c11		       c9 03		      cmp	#3
    179  0c13		       90 25		      bcc	.done
