    100  756d		       7d 0e c3 	      adc	vWant,x
    101  7570		       b0 02		      bcs	.ok	; (no borrow: 0 or more)
    102  7572		       a9 00		      lda	#0
    103  7574				   .ok
    104  7574		       20 64 21 	      jsr	SidPitch	; -> ptr
    105  7577		       a5 28		      lda	ptr
    106  7579		       99 ea c3 	      sta	sidBaseLo,y
    107  757c		       a5 29		      lda	ptr+1
    108  757e		       99 ed c3 	      sta	sidBaseHi,y
    109  7581		       ad a3 c6 	      lda	sndPenvK
    110  7584		       ae 9f c6 	      ldx	sndStep
    111  7587		       f0 02		      beq	.k
    112  7589		       a9 ff		      lda	#$FF	; (STEP: held; AtkStep jumps)
    113  758b				   .k
    114  758b		       99 6e c9 	      sta	sK,y
    115  758e				   .x
    116  758e		       60		      rts
