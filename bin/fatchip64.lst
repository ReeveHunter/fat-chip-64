      0  1631					      include	"arp.asm"
      1  1631							; Fat Chip 64 - tempo and arpeggiator
      2  1631							;
      3  1631							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1631							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1631							;
      6  1631							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1631							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1631							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1631							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1631							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1631							;	     until its voice's next turn.
     12  1631							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1631							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1631							;   J faster; either one also picks FREE).
     15  1631							;
     16  1631							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1631							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1631
     19  1631							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1631							; between the two bytes: $22FF read as $23FF)
     21  1631				   GetTicks
     22  1631					      subroutine
     23  1631		       08		      php
     24  1632		       78		      sei
