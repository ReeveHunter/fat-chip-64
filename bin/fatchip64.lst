     29  6a5f		       90 0e		      bcc	.x
     30  6a61		       a9 00		      lda	#0
     31  6a63		       99 6b c9 	      sta	clickOn,y
     32  6a66		       be a1 78 	      ldx	sidOfs,y
     33  6a69		       b9 31 c3 	      lda	sidGate,y
     34  6a6c		       9d 04 d4 	      sta	SID+4,x
     35  6a6f				   .x
     36  6a6f		       60		      rts
