    151  8647							; voice X's glide offset closer to 0: by off / 2^glideK for each 4 ms step
    152  8647							; (worked out once: d = off >> k, off -= d x n; past 0 or nothing left to
    153  8647							; move by: there). Keeps X.
    154  8647				   NesGlideStep
    155  8647					      subroutine
    156  8647		       bd 90 c9 	      lda	nesGlL,x
    157  864a		       1d 99 c9 	      ora	nesGlH,x
    158  864d		       d0 01		      bne	.go
