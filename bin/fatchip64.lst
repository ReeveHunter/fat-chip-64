------- FILE main.asm
------- FILE devices.asm LEVEL 2 PASS 3
      0  62d9					      include	"devices.asm"
      1  62d9							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  62d9							; are in use, and each one in use gets its page on the main menu.
      3  62d9							;
      4  62d9							; YAMAHA SHS-10 (the keytar)
      5  62d9							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  62d9							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  62d9							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  62d9							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  62d9							;		     can play at once.)
     10  62d9							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  62d9							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  62d9							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  62d9							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  62d9							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  62d9							;		     louder (the SID and the NES; the Game Boy would click) or
     16  62d9							;		     brighter (the SID's filter: switched on if the patch has
     17  62d9							;		     none)
     18  62d9							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  62d9							;		     the patch's, or the ADVANCED amounts if it has none;
     20  62d9							;		     FILTER), or an action held while blowing hard
     21  62d9							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  62d9							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  62d9							;   PORTAMENTO BUTTON	an action (CC 65)
     24  62d9							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  62d9							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  62d9							; ATARI SYNTHCART
     27  62d9							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  62d9							;		     about 3% while held, SHIFT + , . step through the ten
     29  62d9							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  62d9							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  62d9							;		     sound's cents (the Synthcart manual's table: each Atari
     32  62d9							;		     sound plays its scales in its own key, a little off)
     33  62d9							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  62d9
     35  62d9		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  62d9		       00 28	   BREATH_LO  equ	40
     37  62d9		       00 01	   BFX_VIB    equ	1
     38  62d9		       00 02	   BFX_WARB   equ	2
     39  62d9		       00 03	   BFX_DET    equ	3
     40  62d9		       00 04	   BFX_FILT   equ	4
     41  62d9		       00 05	   BFX_HELD   equ	5
     42  62d9
     43  62d9							; the devices' settings -> what the MIDI code checks
     44  62d9				   SyncDerive
     45  62d9					      subroutine
     46  62d9		       a2 01		      ldx	#TEMPO_OWN
     47  62db		       ad 36 c8 	      lda	useShs
     48  62de		       f0 09		      beq	.t1
     49  62e0		       ad 39 c8 	      lda	shsTempo
