    122  0a3d		       84 2b		      sty	irqT
    123  0a3f		       bc 00 c2 	      ldy	nesqD1,x
    124  0a42		       20 72 0a 	      jsr	WireMsg
    125  0a45		       a5 1a		      lda	nesqTail
    126  0a47		       18		      clc
    127  0a48		       69 01		      adc	#1
    128  0a4a		       29 3f		      and	#63
    129  0a4c		       85 1a		      sta	nesqTail
    130  0a4e		       a5 10		      lda	ticks
    131  0a50		       18		      clc
    132  0a51		       69 01		      adc	#NES_GAP
    133  0a53		       85 1b		      sta	nesNext
    134  0a55				   .done
    135  0a55		       60		      rts
