------- FILE lead.asm LEVEL 2 PASS 3
      0  65ce					      include	"lead.asm"
      1  65ce							; Fat Chip 64 - CHORD + LEAD (v0.28): a chord and a lead at once, each its
      2  65ce							; own patch.
      3  65ce							;   LOW NOTE  the first key pressed is the chord's root (POLY: just it;
      4  65ce							;	       SMART CHORD: its 5TH, TRIAD...; DRONE: the drone); every other
      5  65ce							;	       key is the lead, while the chord key is held
      6  65ce							;   LATCH 3   three keys pressed together latch as the chord (let go, it
      7  65ce							;	       keeps sounding); everything else is the lead. L clears it.
      8  65ce							; The lead is one note (the last key pressed) on one voice per chip (SID 3,
      9  65ce							; Game Boy pulse 1, NES pulse 1), only while it plays: the rest of the time
     10  65ce							; those voices are the chord's. Its patch: SHIFT + A S D F G / Z X C V B.
     11  65ce							; The lead's own: the SID's waveform, width, envelope and octave, the Game
     12  65ce							; Boy pulse's CCs, the NES pulse's duty. Shared with the chord: the effects
     13  65ce							; (vibrato, filter, tremolo...), the NES envelope.
     14  65ce
     15  65ce							;   KEY       (v0.32) a keyboard split: keys below the split point are the
     16  65ce							;	       chord (as the mode plays them), keys from it up the lead (LEAD
     17  65ce							;	       OCTAVE, +1 at first). On the C64's keys the split is a key (it
     18  65ce							;	       stays put when the octave changes); over MIDI, a note as sent
     19  65ce							;	       (before MIDI IN OCTAVE). C= + V held + a note sets either.
     20  65ce		       00 01	   CL_KEY     equ	1	; SPLIT (clMode)
     21  65ce		       00 02	   CL_LOW     equ	2
     22  65ce		       00 03	   CL_L3      equ	3
     23  65ce		       00 06	   LEAD_SID   equ	6	; the lead's voices: SID 3, GB pulse 1, NES pulse 1
     24  65ce		       00 01	   LEAD_GB    equ	1
     25  65ce		       00 02	   LEAD_NES   equ	2
     26  65ce
     27  65ce							; NoteDown, CHORD + LEAD on: key X pressed. Carry set: it's the lead (the
     28  65ce							; latch styles leave it alone).
     29  65ce				   ClPress
