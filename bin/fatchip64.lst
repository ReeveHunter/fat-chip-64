     29  7492		       ae a1 c6 	      ldx	sndClick
     30  7495		       e0 02		      cpx	#2
     31  7497		       90 03		      bcc	.cl
     32  7499		       ad a0 c6 	      lda	sndStepT
     33  749c				   .cl
     34  749c		       d9 75 c9 	      cmp	atkT,y
     35  749f		       f0 02		      beq	.ce
     36  74a1		       b0 0e		      bcs	.s
     37  74a3				   .ce
     38  74a3		       a9 00		      lda	#0
     39  74a5		       99 78 c9 	      sta	clickOn,y
     40  74a8		       be f6 83 	      ldx	sidOfs,y
     41  74ab		       b9 36 c3 	      lda	sidGate,y
     42  74ae		       9d 04 d4 	      sta	SID+4,x
     43  74b1				   .s
     44  74b1		       b9 6e c9 	      lda	sK,y
     45  74b4		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  74b6		       d0 19		      bne	.x
     47  74b8		       b9 75 c9 	      lda	atkT,y
     48  74bb		       cd a0 c6 	      cmp	sndStepT
