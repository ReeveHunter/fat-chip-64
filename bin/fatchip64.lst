------- FILE main.asm
------- FILE pads.asm LEVEL 2 PASS 2
      0  1a00					      include	"pads.asm"
      1  1a00							; Fat Chip 64 - sound: FAT (default) or PADS (V)
      2  1a00							;
      3  1a00							; PADS, per the brief's ambient pads: some voices swell and glide into each
      4  1a00							; chord, others keep sharp defined attacks.
      5  1a00							;   SID       slow attack (500 ms), long release (2.4 s), pulse wave with its
      6  1a00							;	       width wobbling (each voice its own phase), through a low-pass
      7  1a00							;	       filter that sweeps slowly (about 8 s up and down)
      8  1a00							;   Game Boy  slow attack and release on pulses + wave, pulse 2 glides
      9  1a00							;	       into each new note, deeper warble
     10  1a00							;   MidiNES   pulses swell and fade (CC7 envelope, see nesenv.asm); the
     11  1a00							;	       triangle (bass) just stops on release
     12  1a00							;
     13  1a00							; RAW, the classic raw chip sound: FAT's stacking, everything square and
     14  1a00							; instant: SID pulse (50 / 25 / 12.5% per voice), attack 0, sustain full,
     15  1a00							; release 0, no filter; Game Boy instant attack and release, no warble,
     16  1a00							; pulses 50% / 25%, wave channel as a third pulse; MidiNES full volume,
     17  1a00							; pulse 2 at 25%. The small detunes between doubled voices stay.
     18  1a00
     19  1a00				   SoundApply
     20  1a00					      subroutine
     21  1a00		       20 eb 1e 	      jsr	NesSoundApply	; leaving PADS: NES envelopes end, full volume
     22  1a03		       20 10 1b 	      jsr	NesDuty
