------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  3aaa					      include	"midiin.asm"
      1  3aaa							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  3aaa							;
      3  3aaa							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  3aaa							; The main loop parses them (running status; realtime and system bytes are
      5  3aaa							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  3aaa							; notes mode, latch, arp and K + note.
      7  3aaa							;
      8  3aaa							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  3aaa							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  3aaa							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  3aaa							;
     12  3aaa							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  3aaa							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  3aaa							;
     15  3aaa							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  3aaa							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  3aaa							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  3aaa							; MIDI in is passed on to the Game Boy or NES.
     19  3aaa
     20  3aaa							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  3aaa							; Uses A, X.
     22  3aaa							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  3aaa							; with the time; a Start ($FA) makes the next clock a beat.
     24  3aaa				   RxByte
     25  3aaa					      subroutine
     26  3aaa		       ad 06 de 	      lda	ACIA_STAT
     27  3aad		       4a		      lsr		; RDRF -> carry
     28  3aae		       90 2b		      bcc	.x
     29  3ab0				   RxGot
     30  3ab0		       ad 07 de 	      lda	ACIA_RX
     31  3ab3		       c9 f8		      cmp	#$F8
     32  3ab5		       f0 25		      beq	.clk
     33  3ab7		       c9 fa		      cmp	#$FA
     34  3ab9		       d0 0e		      bne	.buf
     35  3abb		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  3abd		       8e b3 ca 	      stx	clkPhase
     37  3ac0		       8e bb ca 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3ac3							;  the main loop could measure it)
     39  3ac3		       ae b4 ca 	      ldx	clkBeat
     40  3ac6		       8e c6 ca 	      stx	clkStartBeat
     41  3ac9				   .buf
     42  3ac9		       ae f1 c8 	      ldx	rxHead
     43  3acc		       9d b1 c8 	      sta	rxBuf,x
     44  3acf		       e8		      inx
     45  3ad0		       8a		      txa
     46  3ad1		       29 3f		      and	#63
     47  3ad3		       cd f2 c8 	      cmp	rxTail
     48  3ad6		       f0 03		      beq	.x	; full: dropped
     49  3ad8		       8d f1 c8 	      sta	rxHead
     50  3adb				   .x
     51  3adb		       60		      rts
     52  3adc				   .clk
     53  3adc		       ee af ca 	      inc	clkCount
     54  3adf		       ae b3 ca 	      ldx	clkPhase
     55  3ae2		       e8		      inx
     56  3ae3		       e0 18		      cpx	#24
     57  3ae5		       90 1b		      bcc	.ph
     58  3ae7		       a5 10		      lda	ticks
     59  3ae9		       8d b6 ca 	      sta	clkAtL
     60  3aec		       a5 11		      lda	ticks+1
     61  3aee		       8d b7 ca 	      sta	clkAtH
     62  3af1		       a5 2d		      lda	subTick
     63  3af3		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  3af5		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  3af7		       ad 05 dc 	      lda	CIA1_TAHI
     66  3afa				   .q
     67  3afa		       8d b8 ca 	      sta	clkAtS
     68  3afd		       ee b4 ca 	      inc	clkBeat
     69  3b00		       a2 00		      ldx	#0
     70  3b02				   .ph
     71  3b02		       8e b3 ca 	      stx	clkPhase
     72  3b05		       60		      rts
