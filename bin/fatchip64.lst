------- FILE main.asm
------- FILE viz.asm LEVEL 2 PASS 3
      0  60cc					      include	"viz.asm"
      1  60cc							; Fat Chip 64 - the visualizers (F7: BARS, GLITCH, back to play), demos
      2  60cc							;
      3  60cc							; BARS:
      4  60cc							; Nine bars, one per voice, in three groups: SID, Game Boy, MidiNES. A new
      5  60cc							; note throws its bar to the top; it falls back to a height set by the
      6  60cc							; note's pitch (higher notes stand taller) while the note sounds, and to
      7  60cc							; nothing when it stops. The tremolo makes the bars breathe. Each bar takes
      8  60cc							; the colour of its note's pitch class (C red ... B white). Kick drums flash
      9  60cc							; the border in the key's colour; row 24 has the sound, the tempo and, while
     10  60cc							; a beat plays, which beat of the bar it's on.
     11  60cc							;
     12  60cc							; One bar is drawn per screen step (about every 8 ms), so the screen stays
     13  60cc							; out of the way of the keyboard and the arp: about 13 frames a second.
     14  60cc							;
     15  60cc							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
     16  60cc							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
     17  60cc							; keep spattering more; runs of the screen get copied over other places
     18  60cc							; (datamosh) and wiped away, so it fills while you play and dissolves when
     19  60cc							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
     20  60cc							; the background. VINYL STOP drags it down the screen.
     21  60cc
     22  60cc		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     23  60cc		       00 16	   VIZ_NAMES  equ	22	; note names
     24  60cc		       00 a0	   VIZ_FULL   equ	160	; reversed space
     25  60cc		       00 62	   VIZ_HALF   equ	98	; lower half block
     26  60cc
