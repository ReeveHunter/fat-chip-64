------- FILE main.asm
------- FILE arp.asm LEVEL 2 PASS 2
      0  1541					      include	"arp.asm"
      1  1541							; Fat Chip 64 - tempo and arpeggiator
      2  1541							;
      3  1541							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1541							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1541							;
      6  1541							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1541							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1541							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1541							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1541							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1541							;	     until its voice's next turn.
     12  1541							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1541							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1541							;   J faster; either one also picks FREE).
     15  1541							;
     16  1541							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1541							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1541
     19  1541							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1541							; between the two bytes: $22FF read as $23FF)
     21  1541				   GetTicks
     22  1541					      subroutine
     23  1541		       08		      php
     24  1542		       78		      sei
     25  1543		       a5 10		      lda	ticks
     26  1545		       8d 26 c3 	      sta	nowL
     27  1548		       a5 11		      lda	ticks+1
     28  154a		       8d 27 c3 	      sta	nowH
     29  154d		       28		      plp
     30  154e		       60		      rts
     31  154f
