     27  7a24		       f0 21		      beq	.s
     28  7a26		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  7a28		       ae 5f cb 	      ldx	sndClick
     30  7a2b		       e0 02		      cpx	#2
     31  7a2d		       90 03		      bcc	.cl
     32  7a2f		       ad 5e cb 	      lda	sndStepT
     33  7a32				   .cl
     34  7a32		       d9 31 ce 	      cmp	atkT,y
     35  7a35		       f0 02		      beq	.ce
     36  7a37		       b0 0e		      bcs	.s
     37  7a39				   .ce
     38  7a39		       a9 00		      lda	#0
     39  7a3b		       99 34 ce 	      sta	clickOn,y
     40  7a3e		       be 13 99 	      ldx	sidOfs,y
