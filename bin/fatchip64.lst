    142  0906							;------------------------------------------------------------- interrupts
    143  0906							; Every 1/3 ms: feed the ACIA one byte (fast path). Every third time (1 ms):
    144  0906							; count a tick and move paced messages onto the wire.
    145  0906				   Irq
    146  0906					      subroutine
    147  0906		       48		      pha
    148  0907		       8a		      txa
    149  0908		       48		      pha
    150  0909		       ad 0d dc 	      lda	CIA1_ICR	; acknowledge
    151  090c		       a6 15		      ldx	wireTail
    152  090e		       e4 14		      cpx	wireHead
    153  0910		       f0 0f		      beq	.noByte
    154  0912		       ad 06 de 	      lda	ACIA_STAT
    155  0915		       29 02		      and	#ACIA_TDRE
    156  0917		       f0 08		      beq	.noByte
    157  0919		       bd 00 c0 	      lda	wireBuf,x
    158  091c		       8d 05 de 	      sta	ACIA_TX
    159  091f		       e6 15		      inc	wireTail
    160  0921				   .noByte
    161  0921		       c6 2e		      dec	subTick
    162  0923		       10 14		      bpl	.out
    163  0925		       a9 02		      lda	#2
    164  0927		       85 2e		      sta	subTick
    165  0929		       98		      tya
    166  092a		       48		      pha
    167  092b		       e6 10		      inc	ticks
    168  092d		       d0 02		      bne	.t
    169  092f		       e6 11		      inc	ticks+1
    170  0931				   .t
    171  0931		       20 72 09 	      jsr	Schedule
    172  0934		       20 55 09 	      jsr	TxByte	; start a just-scheduled message now if the ACIA is free
    173  0937		       68		      pla
    174  0938		       a8		      tay
    175  0939				   .out
    176  0939		       68		      pla
    177  093a		       aa		      tax
    178  093b		       68		      pla
    179  093c		       40		      rti
