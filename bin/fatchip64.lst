      0  0ee4					      include	"keys.asm"
      1  0ee4							; Fat Chip 64 - keyboard and RESTORE
      2  0ee4
      3  0ee4							; Scan the whole matrix, turn changes into key events.
      4  0ee4							;
      5  0ee4							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0ee4							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0ee4							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0ee4							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0ee4							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0ee4							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0ee4							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0ee4							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0ee4							; chords whose ghost lands on another used key lose their newest note.
     14  0ee4				   KeyScan
     15  0ee4					      subroutine
     16  0ee4		       a2 07		      ldx	#7
     17  0ee6				   .col
     18  0ee6		       bd 72 88 	      lda	colSelect,x
     19  0ee9		       8d 00 dc 	      sta	CIA1_PRA
     20  0eec		       ad 01 dc 	      lda	CIA1_PRB
     21  0eef		       49 ff		      eor	#$FF
     22  0ef1		       3d 88 c6 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0ef4		       9d 80 c6 	      sta	keyNow,x
     24  0ef7		       ca		      dex
     25  0ef8		       10 ec		      bpl	.col
     26  0efa		       a9 ff		      lda	#$FF
     27  0efc		       8d 00 dc 	      sta	CIA1_PRA
     28  0eff							; ---- every column as accepted (nothing pressed or let go): done
     29  0eff		       a2 07		      ldx	#7
     30  0f01				   .same
     31  0f01		       bd 80 c6 	      lda	keyNow,x
     32  0f04		       dd 90 c6 	      cmp	keyAcc,x
     33  0f07		       d0 04		      bne	.changed
     34  0f09		       ca		      dex
     35  0f0a		       10 f5		      bpl	.same
     36  0f0c		       60		      rts
     37  0f0d				   .changed
     38  0f0d							; ---- releases first: accepted keys that are up now
     39  0f0d		       a2 00		      ldx	#0
     40  0f0f				   .rc
     41  0f0f		       8e 3c c7 	      stx	ksCol
     42  0f12		       bd 80 c6 	      lda	keyNow,x
     43  0f15		       49 ff		      eor	#$FF
     44  0f17		       3d 90 c6 	      and	keyAcc,x
     45  0f1a		       8d 3b c7 	      sta	ksBits
     46  0f1d		       a9 00		      lda	#0
     47  0f1f		       8d 3d c7 	      sta	ksRow
     48  0f22				   .rb
     49  0f22		       ad 3b c7 	      lda	ksBits
     50  0f25		       f0 21		      beq	.rcn
     51  0f27		       4e 3b c7 	      lsr	ksBits
     52  0f2a		       90 17		      bcc	.rbn
     53  0f2c		       ae 3c c7 	      ldx	ksCol
     54  0f2f		       ac 3d c7 	      ldy	ksRow
     55  0f32		       b9 7a 88 	      lda	rowBit,y
     56  0f35		       49 ff		      eor	#$FF
     57  0f37		       3d 90 c6 	      and	keyAcc,x
     58  0f3a		       9d 90 c6 	      sta	keyAcc,x
     59  0f3d		       20 e3 0f 	      jsr	KeyCode
     60  0f40		       20 51 19 	      jsr	KeyUp
     61  0f43				   .rbn
     62  0f43		       ee 3d c7 	      inc	ksRow
     63  0f46		       d0 da		      bne	.rb
     64  0f48				   .rcn
     65  0f48		       ae 3c c7 	      ldx	ksCol
     66  0f4b		       e8		      inx
     67  0f4c		       e0 08		      cpx	#8
     68  0f4e		       d0 bf		      bne	.rc
     69  0f50							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0f50							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0f50							; still count as a combination.
     72  0f50		       a9 00		      lda	#0
     73  0f52		       8d 3f c7 	      sta	ksPass
     74  0f55				   .pass
     75  0f55		       a2 00		      ldx	#0
     76  0f57				   .pc
     77  0f57		       8e 3c c7 	      stx	ksCol
     78  0f5a		       bd 90 c6 	      lda	keyAcc,x
     79  0f5d		       49 ff		      eor	#$FF
     80  0f5f		       3d 80 c6 	      and	keyNow,x
     81  0f62		       8d 3b c7 	      sta	ksBits
     82  0f65		       a9 00		      lda	#0
     83  0f67		       8d 3d c7 	      sta	ksRow
     84  0f6a				   .pb
     85  0f6a		       ad 3b c7 	      lda	ksBits
     86  0f6d		       f0 49		      beq	.pcn
     87  0f6f		       4e 3b c7 	      lsr	ksBits
     88  0f72		       90 3f		      bcc	.pbn
     89  0f74		       ad 40 c7 	      lda	ghostFilter
     90  0f77		       d0 0c		      bne	.chk	; filter off (default): phantom notes play...
     91  0f79		       20 e3 0f 	      jsr	KeyCode
     92  0f7c		       c9 18		      cmp	#24
     93  0f7e		       90 0a		      bcc	.accept
     94  0f80		       20 cc 0f 	      jsr	IsModifier
     95  0f83		       f0 05		      beq	.accept
     96  0f85				   .chk 		; ...but a command key never comes from a phantom
     97  0f85		       20 f1 0f 	      jsr	Suspect	;  (v0.40: Q + E held, then C=, read C= + S too)
     98  0f88		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     99  0f8a				   .accept
    100  0f8a		       20 e3 0f 	      jsr	KeyCode
    101  0f8d		       20 cc 0f 	      jsr	IsModifier	; Z set = modifier
    102  0f90		       f0 07		      beq	.mod
    103  0f92		       ad 3f c7 	      lda	ksPass
    104  0f95		       f0 1c		      beq	.pbn	; pass 0: modifiers only
    105  0f97		       d0 05		      bne	.take
    106  0f99				   .mod
    107  0f99		       ad 3f c7 	      lda	ksPass
    108  0f9c		       d0 15		      bne	.pbn	; (taken in pass 0)
    109  0f9e				   .take
    110  0f9e		       ae 3c c7 	      ldx	ksCol
    111  0fa1		       ac 3d c7 	      ldy	ksRow
    112  0fa4		       b9 7a 88 	      lda	rowBit,y
    113  0fa7		       1d 90 c6 	      ora	keyAcc,x
    114  0faa		       9d 90 c6 	      sta	keyAcc,x
    115  0fad		       20 e3 0f 	      jsr	KeyCode
