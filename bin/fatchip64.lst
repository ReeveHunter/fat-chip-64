------- FILE main.asm
------- FILE devices.asm LEVEL 2 PASS 3
      0  62ac					      include	"devices.asm"
      1  62ac							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  62ac							; are in use, and each one in use gets its page on the main menu.
      3  62ac							;
      4  62ac							; YAMAHA SHS-10 (the keytar)
      5  62ac							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  62ac							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  62ac							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  62ac							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  62ac							;		     can play at once.)
     10  62ac							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  62ac							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  62ac							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  62ac							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  62ac							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  62ac							;		     louder (the SID and the NES; the Game Boy would click) or
     16  62ac							;		     brighter (the SID's filter: switched on if the patch has
     17  62ac							;		     none)
     18  62ac							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  62ac							;		     the patch's, or the ADVANCED amounts if it has none;
     20  62ac							;		     FILTER), or an action held while blowing hard
     21  62ac							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  62ac							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  62ac							;   PORTAMENTO BUTTON	an action (CC 65)
     24  62ac							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  62ac							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  62ac							; ATARI SYNTHCART
     27  62ac							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  62ac							;		     about 3% while held, SHIFT + , . step through the ten
     29  62ac							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  62ac							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  62ac							;		     sound's cents (the Synthcart manual's table: each Atari
     32  62ac							;		     sound plays its scales in its own key, a little off)
     33  62ac							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  62ac
     35  62ac		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  62ac		       00 28	   BREATH_LO  equ	40
     37  62ac		       00 01	   BFX_VIB    equ	1
     38  62ac		       00 02	   BFX_WARB   equ	2
     39  62ac		       00 03	   BFX_DET    equ	3
     40  62ac		       00 04	   BFX_FILT   equ	4
     41  62ac		       00 05	   BFX_HELD   equ	5
     42  62ac
     43  62ac							; the devices' settings -> what the MIDI code checks
     44  62ac				   SyncDerive
     45  62ac					      subroutine
     46  62ac		       a2 01		      ldx	#TEMPO_OWN
     47  62ae		       ad 36 c8 	      lda	useShs
     48  62b1		       f0 09		      beq	.t1
     49  62b3		       ad 39 c8 	      lda	shsTempo
     50  62b6		       d0 04		      bne	.t1
     51  62b8		       a2 00		      ldx	#TEMPO_KEYTAR
     52  62ba		       d0 0c		      bne	.t
     53  62bc				   .t1
     54  62bc		       ad 38 c8 	      lda	useSc
     55  62bf		       f0 07		      beq	.t
     56  62c1		       ad 43 c8 	      lda	scSync
     57  62c4		       f0 02		      beq	.t
     58  62c6		       a2 02		      ldx	#TEMPO_SC
     59  62c8				   .t
     60  62c8		       8e 8e c4 	      stx	syncTempo
     61  62cb		       a9 01		      lda	#1	; start / stop: 0 = the keytar's
     62  62cd		       ae 36 c8 	      ldx	useShs
     63  62d0		       f0 03		      beq	.s
     64  62d2		       ad 3b c8 	      lda	shsStart
     65  62d5				   .s
     66  62d5		       8d 8f c4 	      sta	syncStart
     67  62d8		       a9 00		      lda	#0	; drum notes: 1 = play them
     68  62da		       ae 36 c8 	      ldx	useShs
     69  62dd		       f0 03		      beq	.d
     70  62df		       ad 3a c8 	      lda	shsRhythm
