    301  2d92							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    302  2d92							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    303  2d92							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    304  2d92							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    305  2d92		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    306  2d96		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    307  2d9d		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    308  2da4		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    309  2da9		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
