     96  08b1							; one screen step per keyboard scan, 2 ms after it, on a pass of its
     97  08b1							; own (a scan and a screen step in one pass would stretch it)
     98  08b1							; (v0.12: the SID effects take a non-scan pass the screen doesn't need)
     99  08b1							; when both are due they take turns (a redraw after a key press would
    100  08b1							; otherwise freeze vibrato and glides for 70 ms)
    101  08b1		       ad 41 c7 	      lda	scanned
    102  08b4		       d0 47		      bne	.x
    103  08b6		       a5 13		      lda	scrAt
