------- FILE nesfx.asm LEVEL 2 PASS 3
      0  75b2					      include	"nesfx.asm"
      1  75b2							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  75b2							;
      3  75b2							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  75b2							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  75b2							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  75b2							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  75b2							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  75b2							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  75b2							;   glide    a new note starts bent back to the voice's last note and slides
     10  75b2							;	      in the way the SID's does (all three channels)
     11  75b2							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  75b2							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  75b2							; semitone, so these are a little stepped.
     14  75b2
     15  75b2		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  75b2							;  (the pulses, and the triangle while it glides)
     17  75b2
     18  75b2							; A = 1 (not Z) when a NesFxTick step is due
     19  75b2				   NesFxDue
     20  75b2					      subroutine
     21  75b2		       ad 27 c3 	      lda	devOn+DEV_NES
     22  75b5		       f0 19		      beq	.x
     23  75b7		       ad ff c5 	      lda	vibDepth
     24  75ba		       0d 2d c5 	      ora	nfxGlide
     25  75bd		       0d 2e c5 	      ora	nfxRun
     26  75c0		       f0 0e		      beq	.x
     27  75c2		       a5 10		      lda	ticks
     28  75c4		       38		      sec
     29  75c5		       ed 29 c5 	      sbc	nfxLast
     30  75c8		       c9 08		      cmp	#NFX_EVERY
     31  75ca		       a9 00		      lda	#0
     32  75cc		       90 02		      bcc	.x
     33  75ce		       a9 01		      lda	#1
     34  75d0				   .x
     35  75d0		       60		      rts
     36  75d1
     37  75d1							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  75d1							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  75d1							; quick return.
