     98  74a7		       99 ed c3 	      sta	sidBaseHi,y
     99  74aa		       ad a3 c6 	      lda	sndPenvK
    100  74ad		       ae 9f c6 	      ldx	sndStep
    101  74b0		       f0 02		      beq	.k
    102  74b2		       a9 ff		      lda	#$FF	; (STEP: held; AtkStep jumps)
    103  74b4				   .k
    104  74b4		       99 6e c9 	      sta	sK,y
    105  74b7				   .x
    106  74b7		       60		      rts
