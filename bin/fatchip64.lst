     22  5f8d		       bc ab 9c 	      ldy	prKeyH,x
     23  5f90		       c0 ff		      cpy	#$FF
     24  5f92		       f0 06		      beq	.h
     25  5f94		       b9 4d c6 	      lda	livePatch,y
     26  5f97		       8d 25 c8 	      sta	pnVH
     27  5f9a				   .h
     28  5f9a		       bd d7 9d 	      lda	prKLo,x
     29  5f9d		       8d d4 5f 	      sta	.kl+1
     30  5fa0		       8d dd 5f 	      sta	.kh+1
     31  5fa3		       bd 09 9e 	      lda	prKHi,x
     32  5fa6		       8d d5 5f 	      sta	.kl+2
     33  5fa9		       8d de 5f 	      sta	.kh+2
     34  5fac		       ee dd 5f 	      inc	.kh+1	; (the high byte: one on)
     35  5faf		       d0 03		      bne	.k1
     36  5fb1		       ee de 5f 	      inc	.kh+2
     37  5fb4				   .k1
     38  5fb4		       bd b1 9b 	      lda	prN,x
