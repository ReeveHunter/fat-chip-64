      0  2515					      include	"arp.asm"
      1  2515							; Fat Chip 64 - tempo and arpeggiator
      2  2515							;
      3  2515							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  2515							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  2515							;
      6  2515							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  2515							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  2515							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  2515							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  2515							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  2515							;	     until its voice's next turn.
     12  2515							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  2515							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  2515							;   J faster; either one also picks FREE).
     15  2515							;
     16  2515							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  2515							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  2515
     19  2515							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  2515							; between the two bytes: $22FF read as $23FF)
     21  2515				   GetTicks
     22  2515					      subroutine
     23  2515		       08		      php
     24  2516		       78		      sei
     25  2517		       a5 10		      lda	ticks
     26  2519		       8d 03 c8 	      sta	nowL
     27  251c		       a5 11		      lda	ticks+1
     28  251e		       8d 04 c8 	      sta	nowH
     29  2521		       28		      plp
     30  2522		       60		      rts
     31  2523
