    106  3c35		       a5 21		      lda	mS
    107  3c37		       29 0f		      and	#$0F
    108  3c39		       85 26		      sta	t2	; channel
    109  3c3b		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    110  3c3d							;  cuts it anyway, and the hit lands 1 ms sooner)
    111  3c3d		       29 7f		      and	#$7F
    112  3c3f		       8d 85 c4 	      sta	dmcNote
