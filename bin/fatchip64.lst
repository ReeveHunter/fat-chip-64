      0  6fda					      include	"nestables.asm"
      1  6fda							; generated by tools/gen_tables.py (NES part) - do not edit
      2  6fda							; MidiNES triangle release drop: -24 semitones over 50 steps (5 ms each = 250 ms), slow at first
      3  6fda							; triPb: MidiNES triangle bend scale per MIDI note, p(n) = 1710 * 0.5^((n - 36) / 12)
