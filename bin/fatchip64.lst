      0  6682					      include	"nesfx.asm"
      1  6682							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  6682							;
      3  6682							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  6682							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  6682							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  6682							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  6682							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  6682							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  6682							;   glide    a new note starts bent back to the voice's last note and slides
     10  6682							;	      in the way the SID's does (all three channels)
     11  6682							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  6682							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  6682							; semitone, so these are a little stepped.
     14  6682
     15  6682		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  6682							;  (the pulses, and the triangle while it glides)
     17  6682
     18  6682							; A = 1 (not Z) when a NesFxTick step is due
     19  6682				   NesFxDue
     20  6682					      subroutine
     21  6682		       ad 27 c3 	      lda	devOn+DEV_NES
     22  6685		       f0 19		      beq	.x
     23  6687		       ad ff c5 	      lda	vibDepth
     24  668a		       0d 2d c5 	      ora	nfxGlide
     25  668d		       0d 2e c5 	      ora	nfxRun
     26  6690		       f0 0e		      beq	.x
     27  6692		       a5 10		      lda	ticks
     28  6694		       38		      sec
     29  6695		       ed 29 c5 	      sbc	nfxLast
     30  6698		       c9 08		      cmp	#NFX_EVERY
     31  669a		       a9 00		      lda	#0
     32  669c		       90 02		      bcc	.x
     33  669e		       a9 01		      lda	#1
     34  66a0				   .x
     35  66a0		       60		      rts
     36  66a1
     37  66a1							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  66a1							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  66a1							; quick return.
     40  66a1				   NesFxTick
