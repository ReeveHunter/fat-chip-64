     32  39e3		       f0 25		      beq	.clk
     33  39e5		       c9 fa		      cmp	#$FA
     34  39e7		       d0 0e		      bne	.buf
     35  39e9		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  39eb		       8e f5 c5 	      stx	clkPhase
     37  39ee		       8e fd c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  39f1							;  the main loop could measure it)
     39  39f1		       ae f6 c5 	      ldx	clkBeat
     40  39f4		       8e 08 c6 	      stx	clkStartBeat
     41  39f7				   .buf
     42  39f7		       ae 31 c4 	      ldx	rxHead
     43  39fa		       9d f1 c3 	      sta	rxBuf,x
     44  39fd		       e8		      inx
     45  39fe		       8a		      txa
     46  39ff		       29 3f		      and	#63
     47  3a01		       cd 32 c4 	      cmp	rxTail
     48  3a04		       f0 03		      beq	.x	; full: dropped
     49  3a06		       8d 31 c4 	      sta	rxHead
     50  3a09				   .x
     51  3a09		       60		      rts
     52  3a0a				   .clk
     53  3a0a		       ee f1 c5 	      inc	clkCount
     54  3a0d		       ae f5 c5 	      ldx	clkPhase
     55  3a10		       e8		      inx
     56  3a11		       e0 18		      cpx	#24
     57  3a13		       90 1b		      bcc	.ph
     58  3a15		       a5 10		      lda	ticks
     59  3a17		       8d f8 c5 	      sta	clkAtL
     60  3a1a		       a5 11		      lda	ticks+1
