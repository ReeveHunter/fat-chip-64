    148  0f9e							; A = key code at ksCol / ksRow
    149  0f9e				   KeyCode
    150  0f9e					      subroutine
    151  0f9e		       ad 38 c3 	      lda	ksCol
    152  0fa1		       0a		      asl
    153  0fa2		       0a		      asl
    154  0fa3		       0a		      asl
    155  0fa4		       0d 39 c3 	      ora	ksRow
    156  0fa7		       a8		      tay
    157  0fa8		       b9 cd 7f 	      lda	keymap,y
    158  0fab		       60		      rts
