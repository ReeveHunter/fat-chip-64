    203  0975		       ad 06 de 	      lda	ACIA_STAT
    204  0978		       29 02		      and	#ACIA_TDRE
    205  097a		       f0 08		      beq	.noByte
    206  097c		       bd 00 c0 	      lda	wireBuf,x
    207  097f		       8d 05 de 	      sta	ACIA_TX
    208  0982		       e6 15		      inc	wireTail
    209  0984				   .noByte
    210  0984		       c6 2c		      dec	subTick
    211  0986		       10 14		      bpl	.out
    212  0988		       a9 02		      lda	#2
    213  098a		       85 2c		      sta	subTick
    214  098c		       98		      tya
    215  098d		       48		      pha
    216  098e		       e6 10		      inc	ticks
    217  0990		       d0 02		      bne	.t
    218  0992		       e6 11		      inc	ticks+1
    219  0994				   .t
    220  0994		       20 d8 09 	      jsr	Schedule
    221  0997		       20 bb 09 	      jsr	TxByte	; start a just-scheduled message now if the ACIA is free
    222  099a		       68		      pla
    223  099b		       a8		      tay
    224  099c				   .out
    225  099c		       68		      pla
    226  099d		       aa		      tax
    227  099e		       68		      pla
