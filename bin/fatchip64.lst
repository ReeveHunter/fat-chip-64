------- FILE attack.asm LEVEL 2 PASS 3
      0  718c					      include	"attack.asm"
      1  718c							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  718c							; how each note starts and ends in pitch
      3  718c							;
      4  718c							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  718c							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  718c							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  718c							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  718c							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  718c							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  718c							;   (v0.42) as long as TIME.
     11  718c							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  718c							;   release rings.
     13  718c
     14  718c							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  718c							; jumps to the note
     16  718c				   AtkStep
     17  718c					      subroutine
     18  718c		       ac c3 c3 	      ldy	envY
     19  718f		       b9 69 c9 	      lda	atkT,y
     20  7192		       18		      clc
     21  7193		       6d 52 c4 	      adc	fxN
     22  7196		       90 02		      bcc	.t
     23  7198		       a9 ff		      lda	#255
     24  719a				   .t
     25  719a		       99 69 c9 	      sta	atkT,y
     26  719d		       b9 6c c9 	      lda	clickOn,y
     27  71a0		       f0 21		      beq	.s
     28  71a2		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  71a4		       ae 95 c6 	      ldx	sndClick
     30  71a7		       e0 02		      cpx	#2
     31  71a9		       90 03		      bcc	.cl
     32  71ab		       ad 94 c6 	      lda	sndStepT
     33  71ae				   .cl
     34  71ae		       d9 69 c9 	      cmp	atkT,y
     35  71b1		       f0 02		      beq	.ce
     36  71b3		       b0 0e		      bcs	.s
     37  71b5				   .ce
     38  71b5		       a9 00		      lda	#0
     39  71b7		       99 6c c9 	      sta	clickOn,y
     40  71ba		       be 03 81 	      ldx	sidOfs,y
     41  71bd		       b9 32 c3 	      lda	sidGate,y
     42  71c0		       9d 04 d4 	      sta	SID+4,x
     43  71c3				   .s
     44  71c3		       b9 62 c9 	      lda	sK,y
     45  71c6		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  71c8		       d0 19		      bne	.x
     47  71ca		       b9 69 c9 	      lda	atkT,y
     48  71cd		       cd 94 c6 	      cmp	sndStepT
     49  71d0		       90 11		      bcc	.x
     50  71d2		       b9 5c c4 	      lda	sidTgtLo,y	; TIME's up: the note
     51  71d5		       99 de c3 	      sta	sidBaseLo,y
     52  71d8		       b9 5f c4 	      lda	sidTgtHi,y
     53  71db		       99 e1 c3 	      sta	sidBaseHi,y
     54  71de		       a9 00		      lda	#0
     55  71e0		       99 62 c9 	      sta	sK,y
     56  71e3				   .x
     57  71e3		       60		      rts
     58  71e4
     59  71e4							; a SID voice's gate went on (Y = SID voice, t2 = its registers): the CLICK
     60  71e4							; starts. Keeps Y.
     61  71e4				   ClickOn
     62  71e4					      subroutine
     63  71e4		       ad 95 c6 	      lda	sndClick
     64  71e7		       f0 11		      beq	.x
     65  71e9		       a9 01		      lda	#1
