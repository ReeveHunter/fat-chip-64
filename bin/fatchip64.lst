------- FILE main.asm
------- FILE wander.asm LEVEL 2 PASS 3
      0  60c5					      include	"wander.asm"
      1  60c5							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  60c5							;
      3  60c5							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  60c5							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  60c5							;   ATTACK   as always: the new notes start
      6  60c5							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  60c5							;	      has none)
      8  60c5							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  60c5							;	      start again
     10  60c5							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  60c5							;	      late; some glide, some start again (fade out, come back in)
     12  60c5							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  60c5							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  60c5							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  60c5							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  60c5
     17  60c5		       00 01	   CHG_ATTACK equ	1
     18  60c5		       00 02	   CHG_GLIDE  equ	2
     19  60c5		       00 03	   CHG_STAGGER equ	3
     20  60c5		       00 04	   CHG_WANDER equ	4
     21  60c5		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  60c5
     23  60c5							; A = the chord change style now (keeps X, Y)
     24  60c5				   ChgEff
     25  60c5					      subroutine
     26  60c5		       ad 58 c8 	      lda	chgMode
     27  60c8		       d0 0c		      bne	.x
     28  60ca		       ad aa c3 	      lda	effMode
     29  60cd		       c9 02		      cmp	#MODE_DRONE
     30  60cf		       d0 03		      bne	.a
     31  60d1		       a9 04		      lda	#CHG_WANDER
     32  60d3		       60		      rts
     33  60d4				   .a
     34  60d4		       a9 01		      lda	#CHG_ATTACK
     35  60d6				   .x
     36  60d6		       60		      rts
     37  60d7
     38  60d7							; ApplyVoices, voice X changes note: how. A = 0 (Z): change it now (t3,
     39  60d7							; legatoNow, vsGlide set); A = 1: not yet (WANDER). Keeps X.
     40  60d7				   ChgStyle
     41  60d7					      subroutine
     42  60d7		       bd 13 c3 	      lda	vNote,x
     43  60da		       c9 ff		      cmp	#NO_NOTE
     44  60dc		       d0 2f		      bne	.snd
     45  60de		       bd 0a c3 	      lda	vWant,x	; from silence: at once (GLIDE, STAGGER: from the
     46  60e1		       c9 ff		      cmp	#NO_NOTE	;  voice's last note, like a portamento)
     47  60e3		       f0 25		      beq	.now0
     48  60e5		       ad ca c3 	      lda	hardCut
     49  60e8		       0d 44 c4 	      ora	monoMode
     50  60eb		       d0 1d		      bne	.now0
     51  60ed		       20 c5 60 	      jsr	ChgEff
     52  60f0		       c9 02		      cmp	#CHG_GLIDE
     53  60f2		       f0 10		      beq	.gs
     54  60f4		       c9 03		      cmp	#CHG_STAGGER
     55  60f6		       d0 12		      bne	.now0
     56  60f8		       bd a6 76 	      lda	vDev,x
     57  60fb		       f0 07		      beq	.gs
     58  60fd		       bd af 76 	      lda	vIdx,x
     59  6100		       c9 02		      cmp	#2
     60  6102		       d0 06		      bne	.now0
