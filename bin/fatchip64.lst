     21  0faa		       ca		      dex
     22  0fab		       10 fa		      bpl	.clr
     23  0fad		       20 d0 0f 	      jsr	SidVolume
     24  0fb0		       a2 02		      ldx	#2
     25  0fb2				   .v
     26  0fb2		       bc d1 20 	      ldy	sidOfs,x
     27  0fb5		       a9 19		      lda	#$19	; attack 1, decay 9
     28  0fb7		       99 05 d4 	      sta	SID+5,y
     29  0fba		       a9 c9		      lda	#$C9	; sustain 12, release 9
     30  0fbc		       99 06 d4 	      sta	SID+6,y
     31  0fbf		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     32  0fc1		       99 03 d4 	      sta	SID+3,y
     33  0fc4		       a9 20		      lda	#$20	; sawtooth, gate off
     34  0fc6		       9d 19 c3 	      sta	sidGate,x
     35  0fc9		       99 04 d4 	      sta	SID+4,y
     36  0fcc		       ca		      dex
