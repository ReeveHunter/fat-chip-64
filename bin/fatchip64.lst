------- FILE nesenv.asm LEVEL 2 PASS 2
      0  1cea					      include	"nesenv.asm"
      1  1cea							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  1cea							;
      3  1cea							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  1cea							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  1cea							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  1cea							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  1cea							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  1cea							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  1cea							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  1cea							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  1cea							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  1cea							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  1cea							; would wrap to a high pitch).
     14  1cea							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  1cea
     16  1cea		       00 40	   ENV_ATK    equ	64	; 8.8 level per 10 ms: 15 levels in 0.6 s
     17  1cea		       00 1a	   ENV_DEC    equ	26	; 4 levels (15 -> 11) in 0.4 s
     18  1cea		       00 0b	   ENV_SUS    equ	11
     19  1cea		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     20  1cea		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     21  1cea							; NES channels too, and can't take a bend every 4 ms
     22  1cea		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     23  1cea		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     24  1cea
     25  1cea							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     26  1cea		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     27  1cf3		       02 05	   slotVoice  .byte.b	2,5
     28  1cf5
     29  1cf5							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     30  1cf5							; note keeps sounding for now). X = voice (= t0).
     31  1cf5				   NesSoftRelease
     32  1cf5					      subroutine
     33  1cf5		       ad 95 c3 	      lda	padSound
     34  1cf8		       f0 70		      beq	.no
     35  1cfa		       ad 90 c3 	      lda	muteNow
     36  1cfd		       0d cc c3 	      ora	hardCut
     37  1d00		       d0 68		      bne	.no
     38  1d02		       ad 27 c3 	      lda	devOn+DEV_NES
     39  1d05		       f0 63		      beq	.no
     40  1d07		       bd c5 2a 	      lda	vDev,x
     41  1d0a		       c9 02		      cmp	#DEV_NES
     42  1d0c		       d0 5c		      bne	.no
     43  1d0e		       bd 98 c3 	      lda	vOut,x
     44  1d11		       c9 ff		      cmp	#NO_NOTE
     45  1d13		       f0 55		      beq	.no
     46  1d15		       bc ea 1c 	      ldy	vEnvSlot,x
     47  1d18		       30 1b		      bmi	.tri
     48  1d1a							; pulse: release from the current level; step = 1.25 x level + 1 (8.8),
     49  1d1a							; so any level fades out in about 2 s
     50  1d1a		       b9 be c3 	      lda	envLvH,y
     51  1d1d		       4a		      lsr
     52  1d1e		       4a		      lsr
     53  1d1f		       99 c2 c3 	      sta	envRel,y
     54  1d22		       b9 be c3 	      lda	envLvH,y
     55  1d25		       18		      clc
