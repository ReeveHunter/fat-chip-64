------- FILE attack.asm LEVEL 2 PASS 3
      0  797b					      include	"attack.asm"
      1  797b							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  797b							; how each note starts and ends in pitch
      3  797b							;
      4  797b							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  797b							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  797b							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  797b							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  797b							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  797b							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  797b							;   (v0.42) as long as TIME.
     11  797b							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  797b							;   release rings.
     13  797b
     14  797b							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  797b							; jumps to the note
     16  797b				   AtkStep
     17  797b					      subroutine
     18  797b		       ac 8b c8 	      ldy	envY
     19  797e		       b9 35 ce 	      lda	atkT,y
     20  7981		       18		      clc
     21  7982		       6d 1e c9 	      adc	fxN
     22  7985		       90 02		      bcc	.t
     23  7987		       a9 ff		      lda	#255
     24  7989				   .t
     25  7989		       99 35 ce 	      sta	atkT,y
     26  798c		       b9 38 ce 	      lda	clickOn,y
     27  798f		       f0 21		      beq	.s
     28  7991		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  7993		       ae 61 cb 	      ldx	sndClick
     30  7996		       e0 02		      cpx	#2
     31  7998		       90 03		      bcc	.cl
     32  799a		       ad 60 cb 	      lda	sndStepT
     33  799d				   .cl
     34  799d		       d9 35 ce 	      cmp	atkT,y
     35  79a0		       f0 02		      beq	.ce
     36  79a2		       b0 0e		      bcs	.s
     37  79a4				   .ce
     38  79a4		       a9 00		      lda	#0
     39  79a6		       99 38 ce 	      sta	clickOn,y
     40  79a9		       be e4 88 	      ldx	sidOfs,y
     41  79ac		       b9 f6 c7 	      lda	sidGate,y
     42  79af		       9d 04 d4 	      sta	SID+4,x
     43  79b2				   .s
     44  79b2		       b9 2e ce 	      lda	sK,y
     45  79b5		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  79b7		       d0 19		      bne	.x
     47  79b9		       b9 35 ce 	      lda	atkT,y
     48  79bc		       cd 60 cb 	      cmp	sndStepT
     49  79bf		       90 11		      bcc	.x
     50  79c1		       b9 28 c9 	      lda	sidTgtLo,y	; TIME's up: the note
     51  79c4		       99 aa c8 	      sta	sidBaseLo,y
     52  79c7		       b9 2b c9 	      lda	sidTgtHi,y
     53  79ca		       99 ad c8 	      sta	sidBaseHi,y
     54  79cd		       a9 00		      lda	#0
     55  79cf		       99 2e ce 	      sta	sK,y
     56  79d2				   .x
     57  79d2		       60		      rts
     58  79d3
     59  79d3							; a SID voice's gate went on (Y = SID voice, t2 = its registers): the CLICK
     60  79d3							; starts. Keeps Y.
     61  79d3				   ClickOn
     62  79d3					      subroutine
     63  79d3		       ad 61 cb 	      lda	sndClick
     64  79d6		       f0 11		      beq	.x
     65  79d8		       a9 01		      lda	#1
     66  79da		       99 38 ce 	      sta	clickOn,y
     67  79dd		       b9 f6 c7 	      lda	sidGate,y
     68  79e0		       29 01		      and	#1
     69  79e2		       09 80		      ora	#$80	; noise
     70  79e4		       a6 26		      ldx	t2
     71  79e6		       9d 04 d4 	      sta	SID+4,x
     72  79e9				   .x
     73  79e9		       60		      rts
     74  79ea
     75  79ea							; VoiceSet, a SID voice's new note (Y = SID voice, t0 = the voice, t3 = a new
     76  79ea							; press): BEND IN starts it away from its pitch
     77  79ea				   BendIn
     78  79ea					      subroutine
     79  79ea		       ad 62 cb 	      lda	sndPenv
     80  79ed		       f0 45		      beq	.x
     81  79ef		       a6 24		      ldx	t0
