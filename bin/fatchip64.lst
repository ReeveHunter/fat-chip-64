------- FILE main.asm
------- FILE voices.asm LEVEL 2 PASS 2
      0  100c					      include	"voices.asm"
      1  100c							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  100c							;
      3  100c							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  100c							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  100c							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  100c							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  100c							; Allocation, whenever the held notes change:
      8  100c							;   1. bass voices play the lowest note, an octave down
      9  100c							;   2. every other note gets one voice, lowest notes first
     10  100c							;   3. leftover voices stack on the lowest two notes, alternating
     11  100c							; So one note = a nine-voice unison across three chips, and in chords the
     12  100c							; bottom of the chord is fattest. Disabled devices get no notes.
     13  100c
     14  100c							; ------------------------------------------------------------ SID
     15  100c				   SidInit
     16  100c					      subroutine
     17  100c		       a2 18		      ldx	#24
     18  100e		       a9 00		      lda	#0
     19  1010				   .clr
     20  1010		       9d 00 d4 	      sta	SID,x
     21  1013		       ca		      dex
     22  1014		       10 fa		      bpl	.clr
     23  1016		       20 39 10 	      jsr	SidVolume
     24  1019		       a2 02		      ldx	#2
     25  101b				   .v
     26  101b		       bc d9 24 	      ldy	sidOfs,x
     27  101e		       a9 19		      lda	#$19	; attack 1, decay 9
     28  1020		       99 05 d4 	      sta	SID+5,y
     29  1023		       a9 c9		      lda	#$C9	; sustain 12, release 9
     30  1025		       99 06 d4 	      sta	SID+6,y
     31  1028		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     32  102a		       99 03 d4 	      sta	SID+3,y
     33  102d		       a9 20		      lda	#$20	; sawtooth, gate off
     34  102f		       9d 19 c3 	      sta	sidGate,x
     35  1032		       99 04 d4 	      sta	SID+4,y
     36  1035		       ca		      dex
     37  1036		       10 e3		      bpl	.v
     38  1038		       60		      rts
     39  1039
     40  1039							; Volume 15, or 0 (silent, no hum) when the SID is off or muted (M).
     41  1039							; Volume 15, or 0 when the SID is off or muted. Keeps the filter mode bits.
     42  1039				   SidVolume
     43  1039					      subroutine
     44  1039		       ad 0d c3 	      lda	devOn+DEV_SID
     45  103c		       f0 0b		      beq	.z
