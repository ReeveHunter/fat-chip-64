------- FILE menu.asm LEVEL 2 PASS 3
      0  6080					      include	"menu.asm"
      1  6080							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  6080							;
      3  6080							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  6080							;   page   RETURN opens a page
      5  6080							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  6080							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  6080							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  6080							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  6080							; device pages, until DEVICES says the device is in use).
     10  6080							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  6080							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  6080							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  6080
     14  6080		       00 17	   MENU_VALCOL equ	23
     15  6080
     16  6080				   MenuOpen
     17  6080		       20 74 82 	      jsr	GlitchCalm	; (GLITCH may have the picture shaking)
     18  6083		       a9 01		      lda	#1
     19  6085		       8d b9 ce 	      sta	colDirty	; (the play screen's dark rows: light green again)
     20  6088		       8d 56 c9 	      sta	menuOn
     21  608b		       a9 00		      lda	#0
     22  608d		       8d 57 c9 	      sta	menuRow
     23  6090		       8d b8 ce 	      sta	menuJump
