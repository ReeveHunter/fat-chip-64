    181  0cc2		       90 20		      bcc	.done
    182  0cc4		       a6 1b		      ldx	nesqTail
    183  0cc6		       bd c0 c1 	      lda	nesqS,x
    184  0cc9		       bc 40 c2 	      ldy	nesqD2,x
    185  0ccc		       84 2c		      sty	irqT
    186  0cce		       bc 00 c2 	      ldy	nesqD1,x
    187  0cd1		       20 01 0d 	      jsr	WireMsg
    188  0cd4		       a5 1b		      lda	nesqTail
