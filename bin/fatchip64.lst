    207 U002d		       00	   subTick    ds	1	; IRQs until the next 1 ms tick (3-0)
    208 U002e		       00	   linkLoad   ds	1	; estimated bytes waiting in the Teensyboy (IRQ only)
    209 U002f		       00	   midiIrq    ds	1	; 1 = the MIDI chip's interrupts reach the C64 (v0.16)
    210 U0030		       00 00	   gSrc       ds	2	; GLITCH datamosh source
