------- FILE midi.asm LEVEL 2 PASS 3
      0  0be0					      include	"midi.asm"
      1  0be0							; Fat Chip 64 - MIDI out
      2  0be0							;
      3  0be0							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0be0							; at most one message per device onto the wire buffer, no sooner than that
      5  0be0							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0be0							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0be0							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0be0							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0be0							; The wire uses running status, except that every Game Boy message carries its
     10  0be0							; status byte (v0.64). The main loop and the IRQ both feed the ACIA.
     11  0be0
     12  0be0				   MidiInit
     13  0be0					      subroutine
     14  0be0		       a9 03		      lda	#ACIA_RESET
     15  0be2		       8d 04 de 	      sta	ACIA_CTRL
     16  0be5		       a9 16		      lda	#ACIA_MODE
     17  0be7		       8d 04 de 	      sta	ACIA_CTRL
     18  0bea							; (fall into the test)
     19  0bea
     20  0bea							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     21  0bea							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     22  0bea							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     23  0bea							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     24  0bea							; before. Interrupts are off when this is called.
     25  0bea				   MidiIrqTest
     26  0bea					      subroutine
     27  0bea		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     28  0bec		       8d 0d dc 	      sta	CIA1_ICR
     29  0bef		       ad 0d dc 	      lda	CIA1_ICR
     30  0bf2		       a9 3a		      lda	#<IrqTest
     31  0bf4		       8d fe ff 	      sta	$FFFE
     32  0bf7		       a9 0c		      lda	#>IrqTest
     33  0bf9		       8d ff ff 	      sta	$FFFF
     34  0bfc		       a9 00		      lda	#0
     35  0bfe		       85 2f		      sta	midiIrq
     36  0c00		       a9 b6		      lda	#ACIA_MODE_TX
     37  0c02		       8d 04 de 	      sta	ACIA_CTRL
     38  0c05		       58		      cli
     39  0c06		       a2 00		      ldx	#0
     40  0c08				   .w
     41  0c08		       ca		      dex
     42  0c09		       d0 fd		      bne	.w
     43  0c0b		       78		      sei
     44  0c0c		       a6 2f		      ldx	midiIrq
     45  0c0e		       bd 46 0c 	      lda	midiCtl,x
     46  0c11		       8d 04 de 	      sta	ACIA_CTRL
     47  0c14		       bd 48 0c 	      lda	irqLo,x
     48  0c17		       8d fe ff 	      sta	$FFFE
     49  0c1a		       bd 4a 0c 	      lda	irqHi,x
     50  0c1d		       8d ff ff 	      sta	$FFFF
     51  0c20		       bd 4c 0c 	      lda	latchLo,x
     52  0c23		       8d 04 dc 	      sta	CIA1_TALO
     53  0c26		       bd 4e 0c 	      lda	latchHi,x
     54  0c29		       8d 05 dc 	      sta	CIA1_TAHI
     55  0c2c		       a9 11		      lda	#$11	; start, force load, continuous
     56  0c2e		       8d 0e dc 	      sta	CIA1_CRA
     57  0c31		       ad 0d dc 	      lda	CIA1_ICR
     58  0c34		       a9 81		      lda	#$81	; timer A interrupt on
     59  0c36		       8d 0d dc 	      sta	CIA1_ICR
     60  0c39		       60		      rts
     61  0c3a				   IrqTest
     62  0c3a		       48		      pha
     63  0c3b		       a9 01		      lda	#1
     64  0c3d		       85 2f		      sta	midiIrq
     65  0c3f		       a9 16		      lda	#ACIA_MODE	; (quiet again)
     66  0c41		       8d 04 de 	      sta	ACIA_CTRL
     67  0c44		       68		      pla
     68  0c45		       40		      rti
     69  0c46		       16 96	   midiCtl    .byte.b	ACIA_MODE, ACIA_MODE_RX
     70  0c48		       20 6e	   irqLo      .byte.b	<Irq, <IrqMidi
     71  0c4a		       0b 0b	   irqHi      .byte.b	>Irq, >IrqMidi
     72  0c4c		       ff ff	   latchLo    .byte.b	<TICK_LATCH, <TICK_LATCH_MS
     73  0c4e		       00 03	   latchHi    .byte.b	>TICK_LATCH, >TICK_LATCH_MS
     74  0c50
     75  0c50							; IRQ: send one wire byte if the ACIA is ready.
     76  0c50				   TxByte
     77  0c50					      subroutine
     78  0c50		       a6 16		      ldx	wireTail
     79  0c52		       e4 15		      cpx	wireHead
     80  0c54		       f0 0f		      beq	.done
     81  0c56		       ad 06 de 	      lda	ACIA_STAT
     82  0c59		       29 02		      and	#ACIA_TDRE
     83  0c5b		       f0 08		      beq	.done
     84  0c5d		       bd 00 c4 	      lda	wireBuf,x
     85  0c60		       8d 05 de 	      sta	ACIA_TX
     86  0c63		       e6 16		      inc	wireTail
     87  0c65				   .done
     88  0c65		       60		      rts
     89  0c66
     90  0c66							; Main loop: same, with interrupts off around it.
     91  0c66				   TxService
     92  0c66					      subroutine
     93  0c66		       a5 2f		      lda	midiIrq	; (the MIDI chip's interrupts do it)
     94  0c68		       f0 01		      beq	.poll
     95  0c6a		       60		      rts
     96  0c6b				   .poll
     97  0c6b		       08		      php
     98  0c6c		       78		      sei
     99  0c6d		       20 50 0c 	      jsr	TxByte
    100  0c70		       20 ec 3a 	      jsr	RxByte
    101  0c73		       28		      plp
    102  0c74		       60		      rts
    103  0c75
    104  0c75							; IRQ: pace device queues onto the wire.
    105  0c75							;
    106  0c75							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    107  0c75							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    108  0c75							; times as signed numbers, so after 33 s of silence every queue froze for
    109  0c75							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    110  0c75							;
    111  0c75							; When the Game Boy is on, everything on the wire also passes through the
    112  0c75							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    113  0c75							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    114  0c75							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    115  0c75							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    116  0c75							; message, the rate measured clean.
    117  0c75				   Schedule
    118  0c75					      subroutine
    119  0c75		       ad ea c7 	      lda	devOn+DEV_GB
    120  0c78		       f0 10		      beq	.gb
    121  0c7a		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    122  0c7c		       f0 0c		      beq	.gb
    123  0c7e		       c6 2e		      dec	linkLoad
    124  0c80		       f0 08		      beq	.gb
    125  0c82		       a5 10		      lda	ticks
    126  0c84		       29 01		      and	#1
    127  0c86		       f0 02		      beq	.gb
    128  0c88		       c6 2e		      dec	linkLoad
    129  0c8a				   .gb
    130  0c8a							; ---- Game Boy
    131  0c8a		       a5 18		      lda	gbqTail
    132  0c8c		       c5 17		      cmp	gbqHead
    133  0c8e		       f0 3d		      beq	.nes
    134  0c90		       a5 19		      lda	gbNext
    135  0c92		       38		      sec
    136  0c93		       e5 10		      sbc	ticks
    137  0c95		       f0 04		      beq	.gbDue
    138  0c97		       c9 04		      cmp	#GB_GAP+1
    139  0c99		       90 32		      bcc	.nes	; 1..GB_GAP ms to go
    140  0c9b				   .gbDue
    141  0c9b							; only onto an empty wire, so the gap holds on the cable itself (NES
    142  0c9b							; bytes already waiting would otherwise delay this one and squeeze it
    143  0c9b							; against the next). While a Game Boy message is due, the NES doesn't
    144  0c9b							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    145  0c9b							; holding its notes back.
    146  0c9b		       20 ec 3a 	      jsr	RxByte	; (v0.66: MIDI in now too: the Game Boy's message
    147  0c9e							;  and the NES's after it outlast a byte's time)
    148  0c9e		       a5 15		      lda	wireHead
    149  0ca0		       c5 16		      cmp	wireTail
    150  0ca2		       d0 69		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    151  0ca4		       20 0e 0d 	      jsr	LinkRoom
    152  0ca7		       90 24		      bcc	.nes
    153  0ca9		       a9 ff		      lda	#$FF	; v0.64: every Game Boy message carries its status
    154  0cab		       85 14		      sta	lastStatus	; byte (no running status): the link drops a byte
    155  0cad		       a6 18		      ldx	gbqTail	; now and then, and in a run of nothing but drum
    156  0caf		       bd 00 c5 	      lda	gbqS,x	; notes that left every later note out of step
    157  0cb2		       bc 00 c6 	      ldy	gbqD2,x
    158  0cb5		       84 2c		      sty	irqT
    159  0cb7		       bc 80 c5 	      ldy	gbqD1,x
    160  0cba		       20 2a 0d 	      jsr	WireMsg
    161  0cbd		       a5 18		      lda	gbqTail
    162  0cbf		       18		      clc
    163  0cc0		       69 01		      adc	#1
    164  0cc2		       29 7f		      and	#127
    165  0cc4		       85 18		      sta	gbqTail
    166  0cc6		       a5 10		      lda	ticks
    167  0cc8		       18		      clc
    168  0cc9		       69 03		      adc	#GB_GAP
    169  0ccb		       85 19		      sta	gbNext
    170  0ccd				   .nes
    171  0ccd		       20 ec 3a 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    172  0cd0		       a5 1b		      lda	nesqTail
    173  0cd2		       c5 1a		      cmp	nesqHead
    174  0cd4		       f0 37		      beq	.done
    175  0cd6		       a5 1c		      lda	nesNext
    176  0cd8		       38		      sec
    177  0cd9		       e5 10		      sbc	ticks
    178  0cdb		       f0 04		      beq	.nesDue
    179  0cdd		       c9 02		      cmp	#NES_GAP+1
    180  0cdf		       90 2c		      bcc	.done
    181  0ce1				   .nesDue
    182  0ce1		       20 21 0d 	      jsr	WireFree
    183  0ce4		       c9 03		      cmp	#3
    184  0ce6		       90 25		      bcc	.done
    185  0ce8		       20 0e 0d 	      jsr	LinkRoom
    186  0ceb		       90 20		      bcc	.done
    187  0ced		       a6 1b		      ldx	nesqTail
    188  0cef		       bd 80 c6 	      lda	nesqS,x
    189  0cf2		       bc 00 c7 	      ldy	nesqD2,x
    190  0cf5		       84 2c		      sty	irqT
    191  0cf7		       bc c0 c6 	      ldy	nesqD1,x
    192  0cfa		       20 2a 0d 	      jsr	WireMsg
    193  0cfd		       a5 1b		      lda	nesqTail
    194  0cff		       18		      clc
    195  0d00		       69 01		      adc	#1
    196  0d02		       29 3f		      and	#63
    197  0d04		       85 1b		      sta	nesqTail
    198  0d06		       a5 10		      lda	ticks
    199  0d08		       18		      clc
    200  0d09		       69 01		      adc	#NES_GAP
    201  0d0b		       85 1c		      sta	nesNext
    202  0d0d				   .done
    203  0d0d		       60		      rts
    204  0d0e
    205  0d0e							; Carry set if the Teensyboy has room for a message (always, with the Game
    206  0d0e							; Boy off), and counts it.
    207  0d0e				   LinkRoom
    208  0d0e					      subroutine
    209  0d0e		       ad ea c7 	      lda	devOn+DEV_GB
    210  0d11		       f0 0a		      beq	.yes
    211  0d13		       a5 2e		      lda	linkLoad
    212  0d15		       c9 2d		      cmp	#LINK_MAX
    213  0d17		       b0 06		      bcs	.no
    214  0d19		       69 03		      adc	#3
    215  0d1b		       85 2e		      sta	linkLoad
    216  0d1d				   .yes
    217  0d1d		       38		      sec
