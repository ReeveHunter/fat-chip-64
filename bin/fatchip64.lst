     87  38eb		       29 3f		      and	#63
     88  38ed		       8d 2a c4 	      sta	rxTail
     89  38f0		       98		      tya
     90  38f1		       10 1e		      bpl	.data
     91  38f3		       c9 f8		      cmp	#$F8
