    399  0b12		       10 23		      bpl	.tim	; (not the MIDI chip)
    400  0b14		       4a		      lsr		; a byte in?
    401  0b15		       90 03		      bcc	.tx
    402  0b17		       20 94 30 	      jsr	RxGot
    403  0b1a				   .tx
    404  0b1a		       ad 06 de 	      lda	ACIA_STAT
