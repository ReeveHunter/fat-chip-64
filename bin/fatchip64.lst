------- FILE main.asm
------- FILE wander.asm LEVEL 2 PASS 3
      0  6fc2					      include	"wander.asm"
      1  6fc2							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  6fc2							;
      3  6fc2							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  6fc2							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  6fc2							;   ATTACK   as always: the new notes start
      6  6fc2							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  6fc2							;	      has none)
      8  6fc2							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  6fc2							;	      start again
     10  6fc2							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  6fc2							;	      late; some glide, some start again (fade out, come back in)
     12  6fc2							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  6fc2							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  6fc2							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  6fc2							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  6fc2
     17  6fc2		       00 01	   CHG_ATTACK equ	1
     18  6fc2		       00 02	   CHG_GLIDE  equ	2
     19  6fc2		       00 03	   CHG_STAGGER equ	3
     20  6fc2		       00 04	   CHG_WANDER equ	4
     21  6fc2		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  6fc2		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  6fc2
     24  6fc2							; A = the chord change style now (keeps X, Y)
     25  6fc2				   ChgEff
     26  6fc2					      subroutine
     27  6fc2		       ad 21 cd 	      lda	chgMode
     28  6fc5		       d0 0c		      bne	.x
     29  6fc7		       ad 73 c8 	      lda	effMode
     30  6fca		       c9 02		      cmp	#MODE_DRONE
     31  6fcc		       d0 03		      bne	.a
     32  6fce		       a9 04		      lda	#CHG_WANDER
     33  6fd0		       60		      rts
     34  6fd1				   .a
     35  6fd1		       a9 01		      lda	#CHG_ATTACK
     36  6fd3				   .x
     37  6fd3		       60		      rts
     38  6fd4
     39  6fd4							; ApplyVoices, voice X changes note: how. A = 0 (Z): change it now (t3,
     40  6fd4							; legatoNow, vsGlide set); A = 1: not yet (WANDER). Keeps X.
     41  6fd4				   ChgStyle
     42  6fd4					      subroutine
     43  6fd4		       bd d7 c7 	      lda	vNote,x
     44  6fd7		       c9 ff		      cmp	#NO_NOTE
     45  6fd9		       d0 34		      bne	.snd
     46  6fdb		       bd ce c7 	      lda	vWant,x	; from silence: at once (GLIDE, STAGGER: from the
     47  6fde		       c9 ff		      cmp	#NO_NOTE	;  voice's last note, like a portamento)
     48  6fe0		       f0 2a		      beq	.now0
     49  6fe2		       ad 97 c8 	      lda	hardCut
     50  6fe5		       0d 11 c9 	      ora	monoMode
     51  6fe8		       d0 22		      bne	.now0
     52  6fea		       bd c4 ce 	      lda	vOkp,x	; (v0.50: One Key Play's: no glide from silence)
     53  6fed		       d0 1d		      bne	.now0
     54  6fef		       20 c2 6f 	      jsr	ChgEff
     55  6ff2		       c9 02		      cmp	#CHG_GLIDE
     56  6ff4		       f0 10		      beq	.gs
     57  6ff6		       c9 03		      cmp	#CHG_STAGGER
