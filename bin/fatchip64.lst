------- FILE main.asm
------- FILE devices.asm LEVEL 2 PASS 3
      0  5e1a					      include	"devices.asm"
      1  5e1a							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  5e1a							; are in use, and each one in use gets its page on the main menu.
      3  5e1a							;
      4  5e1a							; YAMAHA SHS-10 (the keytar)
      5  5e1a							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  5e1a							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  5e1a							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  5e1a							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  5e1a							;		     can play at once.)
     10  5e1a							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  5e1a							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  5e1a							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  5e1a							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  5e1a							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  5e1a							;		     louder (the SID and the NES; the Game Boy would click) or
     16  5e1a							;		     brighter (the SID's filter: switched on if the patch has
     17  5e1a							;		     none)
     18  5e1a							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  5e1a							;		     the patch's, or the ADVANCED amounts if it has none;
     20  5e1a							;		     FILTER), or an action held while blowing hard
     21  5e1a							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  5e1a							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  5e1a							;   PORTAMENTO BUTTON	an action (CC 65)
     24  5e1a							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  5e1a							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  5e1a							; ATARI SYNTHCART
     27  5e1a							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  5e1a							;		     about 3% while held, SHIFT + , . step through the ten
     29  5e1a							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  5e1a							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  5e1a							;		     sound's cents (the Synthcart manual's table: each Atari
     32  5e1a							;		     sound plays its scales in its own key, a little off)
     33  5e1a							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  5e1a
     35  5e1a		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  5e1a		       00 28	   BREATH_LO  equ	40
     37  5e1a		       00 01	   BFX_VIB    equ	1
     38  5e1a		       00 02	   BFX_WARB   equ	2
     39  5e1a		       00 03	   BFX_DET    equ	3
     40  5e1a		       00 04	   BFX_FILT   equ	4
     41  5e1a		       00 05	   BFX_HELD   equ	5
     42  5e1a
     43  5e1a							; the devices' settings -> what the MIDI code checks
     44  5e1a				   SyncDerive
     45  5e1a					      subroutine
     46  5e1a		       a2 01		      ldx	#TEMPO_OWN
     47  5e1c		       ad 35 c8 	      lda	useShs
     48  5e1f		       f0 09		      beq	.t1
     49  5e21		       ad 38 c8 	      lda	shsTempo
     50  5e24		       d0 04		      bne	.t1
     51  5e26		       a2 00		      ldx	#TEMPO_KEYTAR
     52  5e28		       d0 0c		      bne	.t
     53  5e2a				   .t1
     54  5e2a		       ad 37 c8 	      lda	useSc
     55  5e2d		       f0 07		      beq	.t
     56  5e2f		       ad 42 c8 	      lda	scSync
     57  5e32		       f0 02		      beq	.t
     58  5e34		       a2 02		      ldx	#TEMPO_SC
     59  5e36				   .t
     60  5e36		       8e 8d c4 	      stx	syncTempo
     61  5e39		       a9 01		      lda	#1	; start / stop: 0 = the keytar's
     62  5e3b		       ae 35 c8 	      ldx	useShs
     63  5e3e		       f0 03		      beq	.s
     64  5e40		       ad 3a c8 	      lda	shsStart
     65  5e43				   .s
     66  5e43		       8d 8e c4 	      sta	syncStart
     67  5e46		       a9 00		      lda	#0	; drum notes: 1 = play them
     68  5e48		       ae 35 c8 	      ldx	useShs
     69  5e4b		       f0 03		      beq	.d
     70  5e4d		       ad 39 c8 	      lda	shsRhythm
