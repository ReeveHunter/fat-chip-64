------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  3995					      include	"midiin.asm"
      1  3995							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  3995							;
      3  3995							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  3995							; The main loop parses them (running status; realtime and system bytes are
      5  3995							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  3995							; notes mode, latch, arp and K + note.
      7  3995							;
      8  3995							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  3995							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  3995							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  3995							;
     12  3995							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  3995							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  3995							;
     15  3995							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  3995							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  3995							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  3995							; MIDI in is passed on to the Game Boy or NES.
     19  3995
     20  3995							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  3995							; Uses A, X.
     22  3995							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  3995							; with the time; a Start ($FA) makes the next clock a beat.
     24  3995				   RxByte
     25  3995					      subroutine
     26  3995		       ad 06 de 	      lda	ACIA_STAT
     27  3998		       4a		      lsr		; RDRF -> carry
     28  3999		       90 2b		      bcc	.x
     29  399b				   RxGot
     30  399b		       ad 07 de 	      lda	ACIA_RX
     31  399e		       c9 f8		      cmp	#$F8
     32  39a0		       f0 25		      beq	.clk
     33  39a2		       c9 fa		      cmp	#$FA
     34  39a4		       d0 0e		      bne	.buf
     35  39a6		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  39a8		       8e f5 c5 	      stx	clkPhase
     37  39ab		       8e fd c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  39ae							;  the main loop could measure it)
     39  39ae		       ae f6 c5 	      ldx	clkBeat
     40  39b1		       8e 08 c6 	      stx	clkStartBeat
     41  39b4				   .buf
     42  39b4		       ae 31 c4 	      ldx	rxHead
     43  39b7		       9d f1 c3 	      sta	rxBuf,x
     44  39ba		       e8		      inx
     45  39bb		       8a		      txa
     46  39bc		       29 3f		      and	#63
     47  39be		       cd 32 c4 	      cmp	rxTail
     48  39c1		       f0 03		      beq	.x	; full: dropped
     49  39c3		       8d 31 c4 	      sta	rxHead
     50  39c6				   .x
     51  39c6		       60		      rts
     52  39c7				   .clk
     53  39c7		       ee f1 c5 	      inc	clkCount
     54  39ca		       ae f5 c5 	      ldx	clkPhase
     55  39cd		       e8		      inx
     56  39ce		       e0 18		      cpx	#24
     57  39d0		       90 1b		      bcc	.ph
