------- FILE attack.asm LEVEL 2 PASS 3
      0  798b					      include	"attack.asm"
      1  798b							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  798b							; how each note starts and ends in pitch
      3  798b							;
      4  798b							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  798b							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  798b							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  798b							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  798b							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  798b							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  798b							;   (v0.42) as long as TIME.
     11  798b							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  798b							;   release rings.
     13  798b
     14  798b							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  798b							; jumps to the note
     16  798b				   AtkStep
     17  798b					      subroutine
     18  798b		       ac 8b c8 	      ldy	envY
     19  798e		       b9 31 ce 	      lda	atkT,y
     20  7991		       18		      clc
     21  7992		       6d 1e c9 	      adc	fxN
     22  7995		       90 02		      bcc	.t
     23  7997		       a9 ff		      lda	#255
     24  7999				   .t
     25  7999		       99 31 ce 	      sta	atkT,y
     26  799c		       b9 34 ce 	      lda	clickOn,y
     27  799f		       f0 21		      beq	.s
     28  79a1		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  79a3		       ae 5f cb 	      ldx	sndClick
     30  79a6		       e0 02		      cpx	#2
     31  79a8		       90 03		      bcc	.cl
     32  79aa		       ad 5e cb 	      lda	sndStepT
     33  79ad				   .cl
     34  79ad		       d9 31 ce 	      cmp	atkT,y
     35  79b0		       f0 02		      beq	.ce
     36  79b2		       b0 0e		      bcs	.s
     37  79b4				   .ce
     38  79b4		       a9 00		      lda	#0
     39  79b6		       99 34 ce 	      sta	clickOn,y
     40  79b9		       be 1e 90 	      ldx	sidOfs,y
     41  79bc		       b9 f6 c7 	      lda	sidGate,y
     42  79bf		       9d 04 d4 	      sta	SID+4,x
     43  79c2				   .s
     44  79c2		       b9 2a ce 	      lda	sK,y
     45  79c5		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  79c7		       d0 19		      bne	.x
     47  79c9		       b9 31 ce 	      lda	atkT,y
     48  79cc		       cd 5e cb 	      cmp	sndStepT
     49  79cf		       90 11		      bcc	.x
     50  79d1		       b9 28 c9 	      lda	sidTgtLo,y	; TIME's up: the note
     51  79d4		       99 aa c8 	      sta	sidBaseLo,y
     52  79d7		       b9 2b c9 	      lda	sidTgtHi,y
     53  79da		       99 ad c8 	      sta	sidBaseHi,y
     54  79dd		       a9 00		      lda	#0
     55  79df		       99 2a ce 	      sta	sK,y
     56  79e2				   .x
     57  79e2		       60		      rts
     58  79e3
     59  79e3							; a SID voice's gate went on (Y = SID voice, t2 = its registers): the CLICK
     60  79e3							; starts. Keeps Y.
     61  79e3				   ClickOn
     62  79e3					      subroutine
     63  79e3		       ad 5f cb 	      lda	sndClick
     64  79e6		       f0 11		      beq	.x
