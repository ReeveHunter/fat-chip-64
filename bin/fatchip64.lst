    403  3643							; A data byte (A) inside a SysEx
    404  3643				   SysexByte
    405  3643					      subroutine
    406  3643		       ae 4d c7 	      ldx	sxPos
    407  3646		       e0 03		      cpx	#3	; the command: 1 a patch, 2 the chips on / off
    408  3648		       d0 0b		      bne	.nc
    409  364a		       c9 02		      cmp	#2
    410  364c		       d0 07		      bne	.nc
    411  364e		       8d 1c c8 	      sta	sxCmd
    412  3651		       ee 4d c7 	      inc	sxPos
    413  3654		       60		      rts
    414  3655				   .nc
    415  3655		       ac 1c c8 	      ldy	sxCmd
    416  3658		       c0 02		      cpy	#2
    417  365a		       d0 0b		      bne	.pat
    418  365c		       e0 04		      cpx	#4	; 2: one byte, bit 0 SID, 1 Game Boy, 2 NES
    419  365e		       d0 39		      bne	.no
    420  3660		       8d 1d c8 	      sta	sxArg
    421  3663		       ee 4d c7 	      inc	sxPos
    422  3666		       60		      rts
    423  3667				   .pat
    424  3667		       e0 05		      cpx	#SX_HEAD
    425  3669		       b0 09		      bcs	.body
