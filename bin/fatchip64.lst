------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  3dbd					      include	"sounds.asm"
      1  3dbd							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  3dbd							;
      3  3dbd							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  3dbd							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  3dbd							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  3dbd							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  3dbd							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  3dbd							;
      9  3dbd							; Each sound has a mono default and a Fat Bass default:
     10  3dbd							;   MONO      one note (the last key pressed and still held) on every voice;
     11  3dbd							;	       a new key while another is held changes the pitch without a
     12  3dbd							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  3dbd							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  3dbd							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  3dbd							;	       the other voices
     16  3dbd							;
     17  3dbd							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  3dbd							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  3dbd							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  3dbd
     21  3dbd							; ------------------------------------------------------------ choosing
     22  3dbd							; V: next sound (SHIFT+V: previous)
     23  3dbd				   SoundKey
     24  3dbd					      subroutine
     25  3dbd		       20 4d 3e 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3dc0		       ae 5d c8 	      ldx	soundMode
     27  3dc3		       ad ee c7 	      lda	shiftDown
     28  3dc6		       d0 09		      bne	.prev
     29  3dc8		       e8		      inx
     30  3dc9		       e0 19		      cpx	#NUM_SOUNDS
     31  3dcb		       90 09		      bcc	.s
     32  3dcd		       a2 00		      ldx	#0
     33  3dcf		       f0 05		      beq	.s
     34  3dd1				   .prev
     35  3dd1		       ca		      dex
     36  3dd2		       10 02		      bpl	.s
     37  3dd4		       a2 18		      ldx	#NUM_SOUNDS-1
     38  3dd6				   .s
