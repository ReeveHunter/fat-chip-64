------- FILE midi.asm LEVEL 2 PASS 3
      0  0a51					      include	"midi.asm"
      1  0a51							; Fat Chip 64 - MIDI out
      2  0a51							;
      3  0a51							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0a51							; at most one message per device onto the wire buffer, no sooner than that
      5  0a51							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0a51							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0a51							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0a51							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0a51							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0a51
     11  0a51				   MidiInit
     12  0a51					      subroutine
     13  0a51		       a9 03		      lda	#ACIA_RESET
     14  0a53		       8d 04 de 	      sta	ACIA_CTRL
     15  0a56		       a9 16		      lda	#ACIA_MODE
     16  0a58		       8d 04 de 	      sta	ACIA_CTRL
     17  0a5b		       60		      rts
     18  0a5c
     19  0a5c							; IRQ: send one wire byte if the ACIA is ready.
     20  0a5c				   TxByte
     21  0a5c					      subroutine
     22  0a5c		       a6 16		      ldx	wireTail
     23  0a5e		       e4 15		      cpx	wireHead
     24  0a60		       f0 0f		      beq	.done
     25  0a62		       ad 06 de 	      lda	ACIA_STAT
     26  0a65		       29 02		      and	#ACIA_TDRE
     27  0a67		       f0 08		      beq	.done
     28  0a69		       bd 00 c0 	      lda	wireBuf,x
     29  0a6c		       8d 05 de 	      sta	ACIA_TX
     30  0a6f		       e6 16		      inc	wireTail
     31  0a71				   .done
     32  0a71		       60		      rts
     33  0a72
     34  0a72							; Main loop: same, with interrupts off around it.
     35  0a72				   TxService
     36  0a72					      subroutine
     37  0a72		       08		      php
     38  0a73		       78		      sei
     39  0a74		       20 5c 0a 	      jsr	TxByte
