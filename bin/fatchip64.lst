    441  60d3							; ------------------------------------------------------------ tuning
    442  60d3							; tuneC = PLAYING's FINE TUNE + the Synthcart's TUNE TO (while it's in use),
    443  60d3							; in cents (-100..+100). The Game Boy gets it as master tune (CC 103), the
    444  60d3							; NES in its bends (tuneN, 1/64 semitones), the SID in its note frequencies
    445  60d3							; (SidTune; the notes sounding move at once). MATCH KEY sets the key's root
    446  60d3							; once, when it changes.
    447  60d3				   ScTune
    448  60d3					      subroutine
    449  60d3		       a9 00		      lda	#0
    450  60d5		       ae 37 c8 	      ldx	useSc
