------- FILE main.asm LEVEL 1 PASS 3
      1  c817 ????						; Fat Chip 64 - main program
      2  c817 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  c817 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  c817 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  c817 ????
      6  c817 ????				      processor	6502
