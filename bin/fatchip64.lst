------- FILE midi.asm LEVEL 2 PASS 3
      0  0bae					      include	"midi.asm"
      1  0bae							; Fat Chip 64 - MIDI out
      2  0bae							;
      3  0bae							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0bae							; at most one message per device onto the wire buffer, no sooner than that
      5  0bae							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0bae							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0bae							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0bae							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0bae							; The wire uses running status, except that every Game Boy message carries its
     10  0bae							; status byte (v0.64). The main loop and the IRQ both feed the ACIA.
     11  0bae
     12  0bae				   MidiInit
     13  0bae					      subroutine
     14  0bae		       a9 03		      lda	#ACIA_RESET
     15  0bb0		       8d 04 de 	      sta	ACIA_CTRL
     16  0bb3		       a9 16		      lda	#ACIA_MODE
     17  0bb5		       8d 04 de 	      sta	ACIA_CTRL
     18  0bb8							; (fall into the test)
     19  0bb8
     20  0bb8							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     21  0bb8							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     22  0bb8							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     23  0bb8							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     24  0bb8							; before. Interrupts are off when this is called.
     25  0bb8				   MidiIrqTest
     26  0bb8					      subroutine
     27  0bb8		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     28  0bba		       8d 0d dc 	      sta	CIA1_ICR
     29  0bbd		       ad 0d dc 	      lda	CIA1_ICR
     30  0bc0		       a9 08		      lda	#<IrqTest
     31  0bc2		       8d fe ff 	      sta	$FFFE
     32  0bc5		       a9 0c		      lda	#>IrqTest
     33  0bc7		       8d ff ff 	      sta	$FFFF
     34  0bca		       a9 00		      lda	#0
     35  0bcc		       85 2f		      sta	midiIrq
     36  0bce		       a9 b6		      lda	#ACIA_MODE_TX
     37  0bd0		       8d 04 de 	      sta	ACIA_CTRL
     38  0bd3		       58		      cli
     39  0bd4		       a2 00		      ldx	#0
     40  0bd6				   .w
     41  0bd6		       ca		      dex
     42  0bd7		       d0 fd		      bne	.w
     43  0bd9		       78		      sei
     44  0bda		       a6 2f		      ldx	midiIrq
     45  0bdc		       bd 14 0c 	      lda	midiCtl,x
     46  0bdf		       8d 04 de 	      sta	ACIA_CTRL
     47  0be2		       bd 16 0c 	      lda	irqLo,x
     48  0be5		       8d fe ff 	      sta	$FFFE
     49  0be8		       bd 18 0c 	      lda	irqHi,x
     50  0beb		       8d ff ff 	      sta	$FFFF
     51  0bee		       bd 1a 0c 	      lda	latchLo,x
     52  0bf1		       8d 04 dc 	      sta	CIA1_TALO
     53  0bf4		       bd 1c 0c 	      lda	latchHi,x
     54  0bf7		       8d 05 dc 	      sta	CIA1_TAHI
     55  0bfa		       a9 11		      lda	#$11	; start, force load, continuous
     56  0bfc		       8d 0e dc 	      sta	CIA1_CRA
     57  0bff		       ad 0d dc 	      lda	CIA1_ICR
     58  0c02		       a9 81		      lda	#$81	; timer A interrupt on
     59  0c04		       8d 0d dc 	      sta	CIA1_ICR
     60  0c07		       60		      rts
     61  0c08				   IrqTest
     62  0c08		       48		      pha
     63  0c09		       a9 01		      lda	#1
     64  0c0b		       85 2f		      sta	midiIrq
     65  0c0d		       a9 16		      lda	#ACIA_MODE	; (quiet again)
     66  0c0f		       8d 04 de 	      sta	ACIA_CTRL
     67  0c12		       68		      pla
     68  0c13		       40		      rti
     69  0c14		       16 96	   midiCtl    .byte.b	ACIA_MODE, ACIA_MODE_RX
     70  0c16		       ee 3c	   irqLo      .byte.b	<Irq, <IrqMidi
     71  0c18		       0a 0b	   irqHi      .byte.b	>Irq, >IrqMidi
     72  0c1a		       ff ff	   latchLo    .byte.b	<TICK_LATCH, <TICK_LATCH_MS
     73  0c1c		       00 03	   latchHi    .byte.b	>TICK_LATCH, >TICK_LATCH_MS
     74  0c1e
     75  0c1e							; IRQ: send one wire byte if the ACIA is ready.
     76  0c1e				   TxByte
     77  0c1e					      subroutine
     78  0c1e		       a6 16		      ldx	wireTail
     79  0c20		       e4 15		      cpx	wireHead
     80  0c22		       f0 0f		      beq	.done
     81  0c24		       ad 06 de 	      lda	ACIA_STAT
     82  0c27		       29 02		      and	#ACIA_TDRE
     83  0c29		       f0 08		      beq	.done
     84  0c2b		       bd 00 c4 	      lda	wireBuf,x
     85  0c2e		       8d 05 de 	      sta	ACIA_TX
     86  0c31		       e6 16		      inc	wireTail
     87  0c33				   .done
     88  0c33		       60		      rts
     89  0c34
     90  0c34							; Main loop: same, with interrupts off around it.
     91  0c34				   TxService
     92  0c34					      subroutine
     93  0c34		       a5 2f		      lda	midiIrq	; (the MIDI chip's interrupts do it)
     94  0c36		       f0 01		      beq	.poll
     95  0c38		       60		      rts
     96  0c39				   .poll
     97  0c39		       08		      php
     98  0c3a		       78		      sei
     99  0c3b		       20 1e 0c 	      jsr	TxByte
    100  0c3e		       20 65 3a 	      jsr	RxByte
    101  0c41		       28		      plp
    102  0c42		       60		      rts
    103  0c43
    104  0c43							; IRQ: pace device queues onto the wire.
    105  0c43							;
    106  0c43							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    107  0c43							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    108  0c43							; times as signed numbers, so after 33 s of silence every queue froze for
    109  0c43							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    110  0c43							;
    111  0c43							; When the Game Boy is on, everything on the wire also passes through the
    112  0c43							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    113  0c43							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    114  0c43							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    115  0c43							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    116  0c43							; message, the rate measured clean.
    117  0c43				   Schedule
    118  0c43					      subroutine
    119  0c43		       ad ea c7 	      lda	devOn+DEV_GB
    120  0c46		       f0 10		      beq	.gb
    121  0c48		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    122  0c4a		       f0 0c		      beq	.gb
    123  0c4c		       c6 2e		      dec	linkLoad
    124  0c4e		       f0 08		      beq	.gb
    125  0c50		       a5 10		      lda	ticks
    126  0c52		       29 01		      and	#1
    127  0c54		       f0 02		      beq	.gb
    128  0c56		       c6 2e		      dec	linkLoad
    129  0c58				   .gb
    130  0c58							; ---- Game Boy
    131  0c58		       a5 18		      lda	gbqTail
    132  0c5a		       c5 17		      cmp	gbqHead
    133  0c5c		       f0 3a		      beq	.nes
    134  0c5e		       a5 19		      lda	gbNext
    135  0c60		       38		      sec
    136  0c61		       e5 10		      sbc	ticks
    137  0c63		       f0 04		      beq	.gbDue
    138  0c65		       c9 04		      cmp	#GB_GAP+1
    139  0c67		       90 2f		      bcc	.nes	; 1..GB_GAP ms to go
    140  0c69				   .gbDue
    141  0c69							; only onto an empty wire, so the gap holds on the cable itself (NES
    142  0c69							; bytes already waiting would otherwise delay this one and squeeze it
    143  0c69							; against the next). While a Game Boy message is due, the NES doesn't
    144  0c69							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    145  0c69							; holding its notes back.
    146  0c69		       a5 15		      lda	wireHead
    147  0c6b		       c5 16		      cmp	wireTail
    148  0c6d		       d0 69		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    149  0c6f		       20 d9 0c 	      jsr	LinkRoom
    150  0c72		       90 24		      bcc	.nes
    151  0c74		       a9 ff		      lda	#$FF	; v0.64: every Game Boy message carries its status
    152  0c76		       85 14		      sta	lastStatus	; byte (no running status): the link drops a byte
    153  0c78		       a6 18		      ldx	gbqTail	; now and then, and in a run of nothing but drum
    154  0c7a		       bd 00 c5 	      lda	gbqS,x	; notes that left every later note out of step
    155  0c7d		       bc 00 c6 	      ldy	gbqD2,x
    156  0c80		       84 2c		      sty	irqT
    157  0c82		       bc 80 c5 	      ldy	gbqD1,x
    158  0c85		       20 f5 0c 	      jsr	WireMsg
    159  0c88		       a5 18		      lda	gbqTail
    160  0c8a		       18		      clc
    161  0c8b		       69 01		      adc	#1
    162  0c8d		       29 7f		      and	#127
    163  0c8f		       85 18		      sta	gbqTail
    164  0c91		       a5 10		      lda	ticks
    165  0c93		       18		      clc
    166  0c94		       69 03		      adc	#GB_GAP
    167  0c96		       85 19		      sta	gbNext
    168  0c98				   .nes
    169  0c98		       20 65 3a 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    170  0c9b		       a5 1b		      lda	nesqTail
    171  0c9d		       c5 1a		      cmp	nesqHead
    172  0c9f		       f0 37		      beq	.done
    173  0ca1		       a5 1c		      lda	nesNext
    174  0ca3		       38		      sec
    175  0ca4		       e5 10		      sbc	ticks
    176  0ca6		       f0 04		      beq	.nesDue
    177  0ca8		       c9 02		      cmp	#NES_GAP+1
    178  0caa		       90 2c		      bcc	.done
    179  0cac				   .nesDue
    180  0cac		       20 ec 0c 	      jsr	WireFree
    181  0caf		       c9 03		      cmp	#3
    182  0cb1		       90 25		      bcc	.done
    183  0cb3		       20 d9 0c 	      jsr	LinkRoom
    184  0cb6		       90 20		      bcc	.done
    185  0cb8		       a6 1b		      ldx	nesqTail
    186  0cba		       bd 80 c6 	      lda	nesqS,x
    187  0cbd		       bc 00 c7 	      ldy	nesqD2,x
    188  0cc0		       84 2c		      sty	irqT
    189  0cc2		       bc c0 c6 	      ldy	nesqD1,x
    190  0cc5		       20 f5 0c 	      jsr	WireMsg
    191  0cc8		       a5 1b		      lda	nesqTail
    192  0cca		       18		      clc
    193  0ccb		       69 01		      adc	#1
    194  0ccd		       29 3f		      and	#63
    195  0ccf		       85 1b		      sta	nesqTail
    196  0cd1		       a5 10		      lda	ticks
    197  0cd3		       18		      clc
    198  0cd4		       69 01		      adc	#NES_GAP
    199  0cd6		       85 1c		      sta	nesNext
    200  0cd8				   .done
    201  0cd8		       60		      rts
    202  0cd9
    203  0cd9							; Carry set if the Teensyboy has room for a message (always, with the Game
    204  0cd9							; Boy off), and counts it.
    205  0cd9				   LinkRoom
    206  0cd9					      subroutine
    207  0cd9		       ad ea c7 	      lda	devOn+DEV_GB
    208  0cdc		       f0 0a		      beq	.yes
    209  0cde		       a5 2e		      lda	linkLoad
    210  0ce0		       c9 2d		      cmp	#LINK_MAX
    211  0ce2		       b0 06		      bcs	.no
    212  0ce4		       69 03		      adc	#3
    213  0ce6		       85 2e		      sta	linkLoad
    214  0ce8				   .yes
    215  0ce8		       38		      sec
    216  0ce9		       60		      rts
    217  0cea				   .no
    218  0cea		       18		      clc
