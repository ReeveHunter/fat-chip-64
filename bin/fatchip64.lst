------- FILE attack.asm LEVEL 2 PASS 3
      0  6eee					      include	"attack.asm"
      1  6eee							; Fat Chip 64 - ATTACK, BEND IN, BEND OUT (v0.30): how each note starts and
      2  6eee							; ends in pitch
      3  6eee							;
      4  6eee							; ATTACK (the SID): BLIP: an octave up for one BLIP STEP, then the note
      5  6eee							;   (OCTAVE + 5TH: an octave, a fifth, the note; 2 OCTAVES: two up, one up,
      6  6eee							;   the note); CLICK: the first 20 ms as noise.
      7  6eee							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      8  6eee							;   a scoop) and bends to its pitch over TIME: the SID and NES slide it (the
      9  6eee							;   SID per voice, the NES with its glide), the Game Boy has its own pitch
     10  6eee							;   envelope (CC 80 / 81).
     11  6eee							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  6eee							;   release rings.
     13  6eee
     14  6eee							; SidFxs pitch loop, SID voice envY: ATTACK's clock; the CLICK ends
     15  6eee				   AtkStep
     16  6eee					      subroutine
     17  6eee		       ac c3 c3 	      ldy	envY
     18  6ef1		       b9 69 c9 	      lda	atkT,y
     19  6ef4		       18		      clc
     20  6ef5		       6d 52 c4 	      adc	fxN
     21  6ef8		       90 02		      bcc	.t
     22  6efa		       a9 ff		      lda	#255
     23  6efc				   .t
     24  6efc		       99 69 c9 	      sta	atkT,y
     25  6eff		       b9 6c c9 	      lda	clickOn,y
     26  6f02		       f0 15		      beq	.x
