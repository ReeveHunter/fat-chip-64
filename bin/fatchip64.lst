    116  0cf2							; Z set if key code A is a modifier. Keeps A.
    117  0cf2				   IsModifier
    118  0cf2		       c9 88		      cmp	#K_LSHIFT
    119  0cf4		       f0 0a		      beq	.y
    120  0cf6		       c9 89		      cmp	#K_RSHIFT
    121  0cf8		       f0 06		      beq	.y
    122  0cfa		       c9 8c		      cmp	#K_CTRL
    123  0cfc		       f0 02		      beq	.y
    124  0cfe		       c9 9a		      cmp	#K_K
