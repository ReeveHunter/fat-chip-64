------- FILE screen.asm LEVEL 2 PASS 3
      0  66cf					      include	"screen.asm"
      1  66cf							; Fat Chip 64 - screen
      2  66cf							;
      3  66cf							;  row 0      header
      4  66cf							;  row 2      sound, POLY / MONO, Fat Bass
      5  66cf							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  66cf							;	       each plays (row 7: a channel overlap warning)
      7  66cf							;  row 9      key, notes mode, latch
      8  66cf							;  row 10     arp
      9  66cf							;  row 12     tempo, beat, mute
     10  66cf							;  row 13     SPACE's action, octave (the lowest key)
     11  66cf							;  row 15     held notes
     12  66cf							;  row 16     MIDI in
     13  66cf							;  row 24     F keys
     14  66cf
     15  66cf							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     16  66cf							; Letters become screen codes; bit 7 of t2 reverses.
     17  66cf				   PrintAt
     18  66cf					      subroutine
     19  66cf		       20 e7 66 	      jsr	ScreenAddr
     20  66d2		       a0 00		      ldy	#0
     21  66d4				   .c
     22  66d4		       b1 28		      lda	(ptr),y
     23  66d6		       f0 0e		      beq	.done
     24  66d8		       c9 40		      cmp	#64
     25  66da		       90 03		      bcc	.noLetter
     26  66dc		       38		      sec
     27  66dd		       e9 40		      sbc	#64
     28  66df				   .noLetter
     29  66df		       05 26		      ora	t2
     30  66e1		       91 2a		      sta	(ptr2),y
     31  66e3		       c8		      iny
