------- FILE main.asm
------- FILE devices.asm LEVEL 2 PASS 3
      0  5b5e					      include	"devices.asm"
      1  5b5e							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  5b5e							; are in use, and each one in use gets its page on the main menu.
      3  5b5e							;
      4  5b5e							; YAMAHA SHS-10 (the keytar)
      5  5b5e							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  5b5e							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  5b5e							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  5b5e							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  5b5e							;		     can play at once.)
     10  5b5e							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  5b5e							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  5b5e							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  5b5e							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  5b5e							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  5b5e							;		     louder (the SID and the NES; the Game Boy would click) or
     16  5b5e							;		     brighter (the SID's filter: switched on if the patch has
     17  5b5e							;		     none)
     18  5b5e							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  5b5e							;		     the patch's, or the ADVANCED amounts if it has none;
     20  5b5e							;		     FILTER), or an action held while blowing hard
     21  5b5e							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  5b5e							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  5b5e							;   PORTAMENTO BUTTON	an action (CC 65)
     24  5b5e							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  5b5e							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  5b5e							; ATARI SYNTHCART
     27  5b5e							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  5b5e							;		     about 3% while held, SHIFT + , . step through the ten
     29  5b5e							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  5b5e							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  5b5e							;		     sound's cents (the Synthcart manual's table: each Atari
     32  5b5e							;		     sound plays its scales in its own key, a little off)
     33  5b5e							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  5b5e
     35  5b5e		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  5b5e		       00 28	   BREATH_LO  equ	40
     37  5b5e		       00 01	   BFX_VIB    equ	1
     38  5b5e		       00 02	   BFX_WARB   equ	2
     39  5b5e		       00 03	   BFX_DET    equ	3
     40  5b5e		       00 04	   BFX_FILT   equ	4
     41  5b5e		       00 05	   BFX_HELD   equ	5
     42  5b5e
