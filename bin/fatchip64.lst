    392  3f02
    393  3f02		       00 6e	   WOB_DEPTH  equ	110	; TAPE WOBBLE: about 0.45 semitone
    394  3f02		       00 b7	   WOB_RATE   equ	183	;  at 0.7 Hz
    395  3f02
    396  3f02							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    397  3f02							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    398  3f02							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    399  3f02							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    400  3f02		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    401  3f06		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    402  3f0d		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    403  3f14		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
