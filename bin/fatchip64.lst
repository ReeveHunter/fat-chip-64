------- FILE main.asm
------- FILE voices.asm LEVEL 2 PASS 3
      0  126b					      include	"voices.asm"
      1  126b							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  126b							;
      3  126b							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  126b							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  126b							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  126b							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  126b							; Allocation, whenever the held notes change:
      8  126b							;   1. bass voices play the lowest note, an octave down
      9  126b							;   2. every other note gets one voice, lowest notes first
     10  126b							;   3. leftover voices stack on the lowest two notes, alternating
     11  126b							; So one note = a nine-voice unison across three chips, and in chords the
     12  126b							; bottom of the chord is fattest. Disabled devices get no notes.
     13  126b
     14  126b							; ------------------------------------------------------------ SID
     15  126b				   SidInit
     16  126b					      subroutine
     17  126b		       a2 18		      ldx	#24
     18  126d		       a9 00		      lda	#0
     19  126f				   .clr
     20  126f		       9d 00 d4 	      sta	SID,x
     21  1272		       ca		      dex
     22  1273		       10 fa		      bpl	.clr
     23  1275		       20 98 12 	      jsr	SidVolume
     24  1278		       a2 02		      ldx	#2
     25  127a				   .v
     26  127a		       bc 75 69 	      ldy	sidOfs,x
     27  127d		       a9 19		      lda	#$19	; attack 1, decay 9
