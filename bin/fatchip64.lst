     31  7043		       d0 03		      bne	.a
     32  7045		       a9 04		      lda	#CHG_WANDER
     33  7047		       60		      rts
     34  7048				   .a
     35  7048		       a9 01		      lda	#CHG_ATTACK
     36  704a				   .x
     37  704a		       60		      rts
