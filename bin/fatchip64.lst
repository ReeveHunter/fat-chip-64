    168  0a83					      subroutine
    169  0a83		       c5 13		      cmp	lastStatus
    170  0a85		       f0 05		      beq	.rs
    171  0a87		       85 13		      sta	lastStatus
    172  0a89		       20 a6 0a 	      jsr	WirePut
