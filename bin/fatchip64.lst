------- FILE main.asm
------- FILE devices.asm LEVEL 2 PASS 3
      0  67c1					      include	"devices.asm"
      1  67c1							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  67c1							; are in use, and each one in use gets its page on the main menu.
      3  67c1							;
      4  67c1							; YAMAHA SHS-10 (the keytar)
      5  67c1							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  67c1							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  67c1							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  67c1							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  67c1							;		     can play at once.)
     10  67c1							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  67c1							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  67c1							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  67c1							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  67c1							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  67c1							;		     louder (the SID and the NES; the Game Boy would click) or
     16  67c1							;		     brighter (the SID's filter: switched on if the patch has
     17  67c1							;		     none)
     18  67c1							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  67c1							;		     the patch's, or the ADVANCED amounts if it has none;
     20  67c1							;		     FILTER), or an action held while blowing hard
     21  67c1							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  67c1							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  67c1							;   PORTAMENTO BUTTON	an action (CC 65)
     24  67c1							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  67c1							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  67c1							; ATARI SYNTHCART
     27  67c1							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  67c1							;		     about 3% while held, SHIFT + , . step through the ten
     29  67c1							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  67c1							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  67c1							;		     sound's cents (the Synthcart manual's table: each Atari
     32  67c1							;		     sound plays its scales in its own key, a little off)
     33  67c1							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  67c1
     35  67c1		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  67c1		       00 28	   BREATH_LO  equ	40
     37  67c1		       00 01	   BFX_VIB    equ	1
     38  67c1		       00 02	   BFX_WARB   equ	2
     39  67c1		       00 03	   BFX_DET    equ	3
     40  67c1		       00 04	   BFX_FILT   equ	4
     41  67c1		       00 05	   BFX_HELD   equ	5
     42  67c1
     43  67c1							; the devices' settings -> what the MIDI code checks
     44  67c1				   SyncDerive
     45  67c1					      subroutine
     46  67c1		       a2 01		      ldx	#TEMPO_OWN
     47  67c3		       ad 42 c8 	      lda	useShs
     48  67c6		       f0 09		      beq	.t1
     49  67c8		       ad 45 c8 	      lda	shsTempo
     50  67cb		       d0 04		      bne	.t1
     51  67cd		       a2 00		      ldx	#TEMPO_KEYTAR
     52  67cf		       d0 0c		      bne	.t
     53  67d1				   .t1
     54  67d1		       ad 44 c8 	      lda	useSc
     55  67d4		       f0 07		      beq	.t
     56  67d6		       ad 4f c8 	      lda	scSync
     57  67d9		       f0 02		      beq	.t
     58  67db		       a2 02		      ldx	#TEMPO_SC
     59  67dd				   .t
     60  67dd		       8e 9a c4 	      stx	syncTempo
     61  67e0		       a9 01		      lda	#1	; start / stop: 0 = the keytar's
     62  67e2		       ae 42 c8 	      ldx	useShs
     63  67e5		       f0 03		      beq	.s
     64  67e7		       ad 47 c8 	      lda	shsStart
     65  67ea				   .s
     66  67ea		       8d 9b c4 	      sta	syncStart
     67  67ed		       a9 00		      lda	#0	; drum notes: 1 = play them
     68  67ef		       ae 42 c8 	      ldx	useShs
     69  67f2		       f0 03		      beq	.d
     70  67f4		       ad 46 c8 	      lda	shsRhythm
