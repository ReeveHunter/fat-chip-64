------- FILE nesenv.asm LEVEL 2 PASS 2
      0  1ca1					      include	"nesenv.asm"
      1  1ca1							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  1ca1							;
      3  1ca1							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  1ca1							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  1ca1							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  1ca1							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  1ca1							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  1ca1							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  1ca1							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  1ca1							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  1ca1							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  1ca1							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  1ca1							; would wrap to a high pitch).
     14  1ca1							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  1ca1
     16  1ca1							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  1ca1							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  1ca1							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  1ca1							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  1ca1							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  1ca1		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  1ca1		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  1ca1							; NES channels too, and can't take a bend every 4 ms
     24  1ca1		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  1ca1		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  1ca1
     27  1ca1							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  1ca1		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  1caa		       02 05	   slotVoice  .byte.b	2,5
     30  1cac
     31  1cac							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  1cac							; note keeps sounding for now). X = voice (= t0).
     33  1cac				   NesSoftRelease
     34  1cac					      subroutine
     35  1cac		       4c b1 1c 	      jmp	.go
     36  1caf				   .nope
     37  1caf		       18		      clc
     38  1cb0		       60		      rts
     39  1cb1				   .go
     40  1cb1		       ad 47 c4 	      lda	nesEnvOn
     41  1cb4		       f0 f9		      beq	.nope
     42  1cb6		       ad 90 c3 	      lda	muteNow
     43  1cb9		       0d cb c3 	      ora	hardCut
     44  1cbc		       d0 f1		      bne	.nope
     45  1cbe		       ad 27 c3 	      lda	devOn+DEV_NES
     46  1cc1		       f0 ec		      beq	.nope
     47  1cc3		       bd 0d 37 	      lda	vDev,x
     48  1cc6		       c9 02		      cmp	#DEV_NES
     49  1cc8		       d0 7f		      bne	.no
     50  1cca		       bd 97 c3 	      lda	vOut,x
     51  1ccd		       c9 ff		      cmp	#NO_NOTE
     52  1ccf		       f0 78		      beq	.no
     53  1cd1		       bc a1 1c 	      ldy	vEnvSlot,x
     54  1cd4		       30 3e		      bmi	.tri
     55  1cd6							; pulse: release from the current level; step = level x factor / 4 + 1
     56  1cd6							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  1cd6							; about 2 s). Factor 0: no release, cut.
     58  1cd6		       ad 6a c4 	      lda	envRelV
     59  1cd9		       f0 6e		      beq	.no
     60  1cdb		       86 26		      stx	t2
     61  1cdd		       84 27		      sty	t3
     62  1cdf		       b9 bd c3 	      lda	envLvH,y
     63  1ce2		       ac 6a c4 	      ldy	envRelV
     64  1ce5		       20 b6 2a 	      jsr	Mul8
     65  1ce8		       4e 6d c4 	      lsr	mt16+1
     66  1ceb		       6e 6c c4 	      ror	mt16
     67  1cee		       4e 6d c4 	      lsr	mt16+1
     68  1cf1		       6e 6c c4 	      ror	mt16
     69  1cf4		       a4 27		      ldy	t3
     70  1cf6		       a6 26		      ldx	t2
     71  1cf8		       ad 6d c4 	      lda	mt16+1
     72  1cfb		       d0 0b		      bne	.max
     73  1cfd		       ad 6c c4 	      lda	mt16
     74  1d00		       c9 ff		      cmp	#255
     75  1d02		       b0 04		      bcs	.max
     76  1d04		       69 01		      adc	#1
     77  1d06		       d0 02		      bne	.rel
     78  1d08				   .max
     79  1d08		       a9 ff		      lda	#255
     80  1d0a				   .rel
     81  1d0a		       99 c1 c3 	      sta	envRel,y
     82  1d0d		       a9 04		      lda	#ENV_R
     83  1d0f		       99 b9 c3 	      sta	envPh,y
     84  1d12		       38		      sec
     85  1d13		       60		      rts
     86  1d14				   .tri
     87  1d14					      if	TRI_DROP_PADS == 0
     88  1d14		       4c 49 1d 	      jmp	.no	; PADS: the bass just stops (Reeve, 2026-11-01)
     89  1d17					      endif
     90  1d17		       bd 16 37 	      lda	vIdx,x
     91  1d1a		       c9 02		      cmp	#2
     92  1d1c		       d0 2b		      bne	.no
     93  1d1e		       bd 97 c3 	      lda	vOut,x
     94  1d21		       20 70 27 	      jsr	MidiNoteValue	; the note actually sounding
     95  1d24		       c9 16		      cmp	#TRI_FLOOR+1
     96  1d26		       90 21		      bcc	.no	; already at the bottom: just cut
     97  1d28		       8d c7 c3 	      sta	triNote
     98  1d2b		       a9 00		      lda	#0
     99  1d2d		       8d c6 c3 	      sta	triK
