      0  5a33					      include	"patchedit.asm"
      1  5a33							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  5a33							; the dice. The settings and their steps come from tools/gen_menu.py
      3  5a33							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  5a33							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  5a33							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  5a33							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  5a33							; (EnvDerive).
      8  5a33
      9  5a33		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  5a33		       00 30	   LFO_LAST   equ	FLD_gbLDelay
     11  5a33
