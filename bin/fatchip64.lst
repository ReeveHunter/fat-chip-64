     82  0f41		       a9 00		      lda	#0
     83  0f43		       8d 38 c3 	      sta	ksRow
     84  0f46				   .pb
     85  0f46		       ad 36 c3 	      lda	ksBits
     86  0f49		       f0 3d		      beq	.pcn
     87  0f4b		       4e 36 c3 	      lsr	ksBits
