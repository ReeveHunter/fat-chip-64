------- FILE attack.asm LEVEL 2 PASS 3
      0  6ec1					      include	"attack.asm"
      1  6ec1							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  6ec1							; how each note starts and ends in pitch
      3  6ec1							;
      4  6ec1							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  6ec1							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  6ec1							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  6ec1							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  6ec1							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  6ec1							;   CLICK (the SID): the first 20 ms of each note as noise.
     10  6ec1							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     11  6ec1							;   release rings.
     12  6ec1
     13  6ec1							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     14  6ec1							; jumps to the note
     15  6ec1				   AtkStep
     16  6ec1					      subroutine
     17  6ec1		       ac c3 c3 	      ldy	envY
     18  6ec4		       b9 69 c9 	      lda	atkT,y
     19  6ec7		       18		      clc
     20  6ec8		       6d 52 c4 	      adc	fxN
     21  6ecb		       90 02		      bcc	.t
     22  6ecd		       a9 ff		      lda	#255
     23  6ecf				   .t
     24  6ecf		       99 69 c9 	      sta	atkT,y
     25  6ed2		       b9 6c c9 	      lda	clickOn,y
     26  6ed5		       f0 15		      beq	.s
     27  6ed7		       b9 69 c9 	      lda	atkT,y
     28  6eda		       c9 05		      cmp	#5	; (20 ms of noise)
     29  6edc		       90 0e		      bcc	.s
     30  6ede		       a9 00		      lda	#0
     31  6ee0		       99 6c c9 	      sta	clickOn,y
     32  6ee3		       be f2 7d 	      ldx	sidOfs,y
     33  6ee6		       b9 32 c3 	      lda	sidGate,y
     34  6ee9		       9d 04 d4 	      sta	SID+4,x
     35  6eec				   .s
     36  6eec		       b9 62 c9 	      lda	sK,y
     37  6eef		       c9 ff		      cmp	#$FF	; (STEP: held)
     38  6ef1		       d0 19		      bne	.x
     39  6ef3		       b9 69 c9 	      lda	atkT,y
     40  6ef6		       cd 94 c6 	      cmp	sndStepT
     41  6ef9		       90 11		      bcc	.x
     42  6efb		       b9 5c c4 	      lda	sidTgtLo,y	; TIME's up: the note
     43  6efe		       99 de c3 	      sta	sidBaseLo,y
     44  6f01		       b9 5f c4 	      lda	sidTgtHi,y
     45  6f04		       99 e1 c3 	      sta	sidBaseHi,y
     46  6f07		       a9 00		      lda	#0
     47  6f09		       99 62 c9 	      sta	sK,y
     48  6f0c				   .x
     49  6f0c		       60		      rts
     50  6f0d
     51  6f0d							; a SID voice's gate went on (Y = SID voice, t2 = its registers): the CLICK
     52  6f0d							; starts. Keeps Y.
     53  6f0d				   ClickOn
     54  6f0d					      subroutine
     55  6f0d		       ad 95 c6 	      lda	sndClick
     56  6f10		       f0 11		      beq	.x
     57  6f12		       a9 01		      lda	#1
     58  6f14		       99 6c c9 	      sta	clickOn,y
     59  6f17		       b9 32 c3 	      lda	sidGate,y
     60  6f1a		       29 01		      and	#1
     61  6f1c		       09 80		      ora	#$80	; noise
     62  6f1e		       a6 26		      ldx	t2
     63  6f20		       9d 04 d4 	      sta	SID+4,x
     64  6f23				   .x
     65  6f23		       60		      rts
     66  6f24
     67  6f24							; VoiceSet, a SID voice's new note (Y = SID voice, t0 = the voice, t3 = a new
     68  6f24							; press): BEND IN starts it away from its pitch
     69  6f24				   BendIn
     70  6f24					      subroutine
     71  6f24		       ad 96 c6 	      lda	sndPenv
     72  6f27		       f0 36		      beq	.x
     73  6f29		       a6 24		      ldx	t0
     74  6f2b		       ad 48 c4 	      lda	legatoNow
     75  6f2e		       d0 2f		      bne	.x	; (legato: no new start)
     76  6f30		       bd 13 c3 	      lda	vNote,x
     77  6f33		       c9 ff		      cmp	#NO_NOTE
     78  6f35		       f0 04		      beq	.go	; from silence
