    383  3633		       ae 1c c8 	      ldx	sxCmd
    384  3636		       e0 02		      cpx	#2
    385  3638		       f0 0d		      beq	.dev
    386  363a		       ae 4d c7 	      ldx	sxPos
    387  363d		       e0 cf		      cpx	#SX_LEN
    388  363f		       d0 05		      bne	.x
    389  3641		       48		      pha
