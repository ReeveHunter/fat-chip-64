------- FILE arp.asm LEVEL 2 PASS 2
      0  1515					      include	"arp.asm"
      1  1515							; Fat Chip 64 - tempo and arpeggiator
      2  1515							;
      3  1515							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1515							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1515							;
      6  1515							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1515							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1515							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1515							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1515							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1515							;	     until its voice's next turn.
     12  1515							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1515							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1515							;   J faster; either one also picks FREE).
     15  1515							;
     16  1515							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1515							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1515
     19  1515							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1515							; between the two bytes: $22FF read as $23FF)
     21  1515				   GetTicks
     22  1515					      subroutine
     23  1515		       08		      php
     24  1516		       78		      sei
     25  1517		       a5 10		      lda	ticks
     26  1519		       8d 26 c3 	      sta	nowL
     27  151c		       a5 11		      lda	ticks+1
     28  151e		       8d 27 c3 	      sta	nowH
     29  1521		       28		      plp
     30  1522		       60		      rts
     31  1523
