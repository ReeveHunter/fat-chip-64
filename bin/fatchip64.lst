      0  471a					      include	"drums.asm"
      1  471a							; Fat Chip 64 - drums on the MidiNES
      2  471a							;
      3  471a							; Two sources, one kit:
      4  471a							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  471a							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  471a							;			   64 = hit, 56 = ghost)
      7  471a							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  471a							;			   RETURN starts / stops it, at its own tempo (B taps
      9  471a							;			   a new one)
     10  471a							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  471a							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  471a							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  471a							; a note-on, then a note-off after the sound's length, the level set with
     14  471a							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  471a							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  471a
     17  471a		       00 0c	   KIT_SIZE   equ	12
     18  471a		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  471a		       00 00	   DK_KICK    equ	0
     20  471a		       00 01	   DK_SNARE   equ	1
     21  471a		       00 02	   DK_CH      equ	2
     22  471a		       00 03	   DK_OH      equ	3
     23  471a		       00 04	   DK_CY      equ	4
     24  471a		       00 05	   DK_TOM     equ	5
     25  471a		       00 06	   DK_PERC    equ	6
     26  471a
     27  471a							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
