------- FILE sounds.asm LEVEL 2 PASS 3
      0  36f6					      include	"sounds.asm"
      1  36f6							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  36f6							;
      3  36f6							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  36f6							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  36f6							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  36f6							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  36f6							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  36f6							;
      9  36f6							; Each sound has a mono default and a Fat Bass default:
     10  36f6							;   MONO      one note (the last key pressed and still held) on every voice;
     11  36f6							;	       a new key while another is held changes the pitch without a
     12  36f6							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  36f6							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  36f6							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  36f6							;	       the other voices
     16  36f6							;
     17  36f6							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  36f6							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  36f6							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  36f6
     21  36f6							; ------------------------------------------------------------ choosing
     22  36f6							; V: next sound (SHIFT+V: previous)
     23  36f6				   SoundKey
