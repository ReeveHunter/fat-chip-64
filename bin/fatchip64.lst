------- FILE main.asm
------- FILE devices.asm LEVEL 2 PASS 3
      0  64fb					      include	"devices.asm"
      1  64fb							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  64fb							; are in use, and each one in use gets its page on the main menu.
      3  64fb							;
      4  64fb							; YAMAHA SHS-10 (the keytar)
      5  64fb							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  64fb							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  64fb							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  64fb							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  64fb							;		     can play at once.)
     10  64fb							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  64fb							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  64fb							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  64fb							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  64fb							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  64fb							;		     louder (the SID and the NES; the Game Boy would click) or
     16  64fb							;		     brighter (the SID's filter: switched on if the patch has
     17  64fb							;		     none)
     18  64fb							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  64fb							;		     the patch's, or the ADVANCED amounts if it has none;
     20  64fb							;		     FILTER), or an action held while blowing hard
     21  64fb							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  64fb							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  64fb							;   PORTAMENTO BUTTON	an action (CC 65)
     24  64fb							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  64fb							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  64fb							; ATARI SYNTHCART
     27  64fb							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  64fb							;		     about 3% while held, SHIFT + , . step through the ten
     29  64fb							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  64fb							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  64fb							;		     sound's cents (the Synthcart manual's table: each Atari
     32  64fb							;		     sound plays its scales in its own key, a little off)
     33  64fb							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  64fb
     35  64fb		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  64fb		       00 28	   BREATH_LO  equ	40
     37  64fb		       00 01	   BFX_VIB    equ	1
     38  64fb		       00 02	   BFX_WARB   equ	2
     39  64fb		       00 03	   BFX_DET    equ	3
     40  64fb		       00 04	   BFX_FILT   equ	4
     41  64fb		       00 05	   BFX_HELD   equ	5
     42  64fb
