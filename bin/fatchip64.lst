     46  8094		       0d 39 c5 	      ora	nfxGlide
     47  8097		       0d 3a c5 	      ora	nfxRun
     48  809a		       0d f3 c9 	      ora	nfxWarb
     49  809d		       d0 01		      bne	.on
     50  809f				   .q
     51  809f		       60		      rts
     52  80a0				   .on
     53  80a0		       a5 10		      lda	ticks
     54  80a2		       38		      sec
     55  80a3		       ed 35 c5 	      sbc	nfxLast
     56  80a6		       c9 08		      cmp	#NFX_EVERY
     57  80a8		       b0 01		      bcs	.go
     58  80aa		       60		      rts
     59  80ab				   .go
     60  80ab		       4a		      lsr
     61  80ac		       4a		      lsr		; 4 ms steps
     62  80ad		       c9 08		      cmp	#8
     63  80af		       90 02		      bcc	.n
     64  80b1		       a9 08		      lda	#8
     65  80b3				   .n
