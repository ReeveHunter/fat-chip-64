------- FILE main.asm
------- FILE menu.asm LEVEL 2 PASS 3
      0  521c					      include	"menu.asm"
      1  521c							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  521c							;
      3  521c							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  521c							;   page   RETURN opens a page
      5  521c							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  521c							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  521c							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  521c							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  521c							; device pages, until DEVICES says the device is in use).
     10  521c							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  521c							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  521c							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  521c
     14  521c		       00 17	   MENU_VALCOL equ	23
     15  521c
     16  521c				   MenuOpen
     17  521c		       20 a1 70 	      jsr	GlitchCalm	; (GLITCH may have the picture shaking)
     18  521f		       a9 01		      lda	#1
     19  5221		       8d 89 c4 	      sta	menuOn
     20  5224		       a9 00		      lda	#0
     21  5226		       8d 8a c4 	      sta	menuRow
     22  5229							; page A on screen (the cursor stays on its line if it's on this page)
     23  5229				   MenuPage
     24  5229					      subroutine
     25  5229		       8d 1b c6 	      sta	menuPage
     26  522c		       aa		      tax
     27  522d		       ad 8a c4 	      lda	menuRow
