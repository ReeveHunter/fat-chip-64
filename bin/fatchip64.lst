------- FILE main.asm
------- FILE viz.asm LEVEL 2 PASS 3
      0  8237					      include	"viz.asm"
      1  8237							; Fat Chip 64 - the visualizer (F7: GLITCH on / off; v0.28 dropped the BARS)
      2  8237							;
      3  8237							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
      4  8237							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
      5  8237							; keep spattering more; runs of the screen get copied over other places
      6  8237							; (datamosh) and wiped away, so it fills while you play and dissolves when
      7  8237							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
      8  8237							; the background. VINYL STOP drags it down the screen.
      9  8237
     10  8237		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     11  8237		       00 16	   VIZ_NAMES  equ	22	; note names
     12  8237		       00 a0	   VIZ_FULL   equ	160	; reversed space
     13  8237		       00 62	   VIZ_HALF   equ	98	; lower half block
     14  8237
