------- FILE voices.asm LEVEL 2 PASS 2
      0  0c7b					      include	"voices.asm"
      1  0c7b							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  0c7b							;
      3  0c7b							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  0c7b							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  0c7b							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  0c7b							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  0c7b							; Allocation, whenever the held notes change:
      8  0c7b							;   1. bass voices play the lowest note, an octave down
      9  0c7b							;   2. every other note gets one voice, lowest notes first
     10  0c7b							;   3. leftover voices stack on the lowest two notes, alternating
     11  0c7b							; So one note = a nine-voice unison across three chips, and in chords the
     12  0c7b							; bottom of the chord is fattest. Disabled devices get no notes.
     13  0c7b
     14  0c7b							; ------------------------------------------------------------ SID
     15  0c7b				   SidInit
     16  0c7b					      subroutine
     17  0c7b		       a2 18		      ldx	#24
