    205  0ce6							; Carry set if the Teensyboy has room for a message (always, with the Game
    206  0ce6							; Boy off), and counts it.
    207  0ce6				   LinkRoom
    208  0ce6					      subroutine
    209  0ce6		       ad ea c7 	      lda	devOn+DEV_GB
    210  0ce9		       f0 0a		      beq	.yes
    211  0ceb		       a5 2e		      lda	linkLoad
    212  0ced		       c9 2d		      cmp	#LINK_MAX
    213  0cef		       b0 06		      bcs	.no
    214  0cf1		       69 03		      adc	#3
    215  0cf3		       85 2e		      sta	linkLoad
