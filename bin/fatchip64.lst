------- FILE sync.asm LEVEL 2 PASS 3
      0  486d					      include	"sync.asm"
      1  486d							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  486d							;
      3  486d							; Menu, DEVICE SYNC (defaults first):
      4  486d							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  486d							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  486d							;		     sets the tempo, averaged over beats (the clock jitters about
      7  486d							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  486d							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  486d							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  486d							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  486d							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  486d							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  486d							;		     picks a beat demo (styleBeat)
     14  486d							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  486d							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  486d							;		     key channel) picks a sound (voiceSound)
     17  486d							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  486d							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  486d							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  486d							;
     21  486d							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  486d							; 1/4 ms); a Start makes the next clock a beat.
     23  486d
     24  486d		       00 00	   TEMPO_KEYTAR equ	0
     25  486d		       00 01	   TEMPO_OWN  equ	1
     26  486d		       00 02	   TEMPO_SC   equ	2
     27  486d		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  486d
     29  486d
     30  486d
     31  486d							; ------------------------------------------------------------ clock
     32  486d							; Main loop, every pass
