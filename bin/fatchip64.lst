    121  3b18		       d0 a7		      bne	.next
    122  3b1a		       a9 00		      lda	#0
    123  3b1c		       8d f4 c8 	      sta	rxCnt
    124  3b1f		       20 47 3b 	      jsr	MidiInMsg
    125  3b22		       4c c1 3a 	      jmp	.next
    126  3b25				   .rt
