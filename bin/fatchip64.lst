    403  3630							; A data byte (A) inside a SysEx
    404  3630				   SysexByte
    405  3630					      subroutine
    406  3630		       ae 4d c7 	      ldx	sxPos
    407  3633		       e0 03		      cpx	#3	; the command: 1 a patch, 2 the chips on / off
    408  3635		       d0 0b		      bne	.nc
    409  3637		       c9 02		      cmp	#2
    410  3639		       d0 07		      bne	.nc
    411  363b		       8d 1c c8 	      sta	sxCmd
    412  363e		       ee 4d c7 	      inc	sxPos
    413  3641		       60		      rts
    414  3642				   .nc
    415  3642		       ac 1c c8 	      ldy	sxCmd
    416  3645		       c0 02		      cpy	#2
    417  3647		       d0 0b		      bne	.pat
    418  3649		       e0 04		      cpx	#4	; 2: one byte, bit 0 SID, 1 Game Boy, 2 NES
    419  364b		       d0 39		      bne	.no
    420  364d		       8d 1d c8 	      sta	sxArg
    421  3650		       ee 4d c7 	      inc	sxPos
    422  3653		       60		      rts
    423  3654				   .pat
    424  3654		       e0 05		      cpx	#SX_HEAD
    425  3656		       b0 09		      bcs	.body
    426  3658		       dd 8c 36 	      cmp	sxHead,x	; the header must match, or the rest is ignored
    427  365b		       d0 29		      bne	.no
    428  365d		       ee 4d c7 	      inc	sxPos
    429  3660		       60		      rts
    430  3661				   .body
    431  3661		       e0 cf		      cpx	#SX_LEN
    432  3663		       b0 21		      bcs	.no	; too long
    433  3665		       48		      pha
    434  3666		       8a		      txa
    435  3667		       38		      sec
    436  3668		       e9 05		      sbc	#SX_HEAD
    437  366a		       4a		      lsr
    438  366b		       a8		      tay		; byte number
    439  366c		       68		      pla
    440  366d		       29 0f		      and	#15
    441  366f		       b0 0b		      bcs	.lo
    442  3671		       0a		      asl
    443  3672		       0a		      asl
    444  3673		       0a		      asl
    445  3674		       0a		      asl
    446  3675		       99 cc c6 	      sta	sxBuf,y
    447  3678		       ee 4d c7 	      inc	sxPos
    448  367b		       60		      rts
