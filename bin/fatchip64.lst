------- FILE main.asm
------- FILE wander.asm LEVEL 2 PASS 3
      0  67c1					      include	"wander.asm"
      1  67c1							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  67c1							;
      3  67c1							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  67c1							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  67c1							;   ATTACK   as always: the new notes start
      6  67c1							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  67c1							;	      has none)
      8  67c1							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  67c1							;	      start again
     10  67c1							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  67c1							;	      late; some glide, some start again (fade out, come back in)
     12  67c1							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  67c1							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  67c1							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  67c1							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  67c1
     17  67c1		       00 01	   CHG_ATTACK equ	1
     18  67c1		       00 02	   CHG_GLIDE  equ	2
     19  67c1		       00 03	   CHG_STAGGER equ	3
     20  67c1		       00 04	   CHG_WANDER equ	4
     21  67c1		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  67c1		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  67c1
     24  67c1							; A = the chord change style now (keeps X, Y)
     25  67c1				   ChgEff
     26  67c1					      subroutine
     27  67c1		       ad 59 c8 	      lda	chgMode
     28  67c4		       d0 0c		      bne	.x
     29  67c6		       ad ab c3 	      lda	effMode
     30  67c9		       c9 02		      cmp	#MODE_DRONE
     31  67cb		       d0 03		      bne	.a
     32  67cd		       a9 04		      lda	#CHG_WANDER
     33  67cf		       60		      rts
     34  67d0				   .a
     35  67d0		       a9 01		      lda	#CHG_ATTACK
     36  67d2				   .x
     37  67d2		       60		      rts
     38  67d3
     39  67d3							; ApplyVoices, voice X changes note: how. A = 0 (Z): change it now (t3,
     40  67d3							; legatoNow, vsGlide set); A = 1: not yet (WANDER). Keeps X.
     41  67d3				   ChgStyle
     42  67d3					      subroutine
     43  67d3		       bd 13 c3 	      lda	vNote,x
     44  67d6		       c9 ff		      cmp	#NO_NOTE
     45  67d8		       d0 2f		      bne	.snd
     46  67da		       bd 0a c3 	      lda	vWant,x	; from silence: at once (GLIDE, STAGGER: from the
     47  67dd		       c9 ff		      cmp	#NO_NOTE	;  voice's last note, like a portamento)
     48  67df		       f0 25		      beq	.now0
     49  67e1		       ad cb c3 	      lda	hardCut
     50  67e4		       0d 45 c4 	      ora	monoMode
     51  67e7		       d0 1d		      bne	.now0
     52  67e9		       20 c1 67 	      jsr	ChgEff
     53  67ec		       c9 02		      cmp	#CHG_GLIDE
     54  67ee		       f0 10		      beq	.gs
     55  67f0		       c9 03		      cmp	#CHG_STAGGER
     56  67f2		       d0 12		      bne	.now0
     57  67f4		       bd 9a 80 	      lda	vDev,x
     58  67f7		       f0 07		      beq	.gs
     59  67f9		       bd a3 80 	      lda	vIdx,x
     60  67fc		       c9 02		      cmp	#2
     61  67fe		       d0 06		      bne	.now0
     62  6800				   .gs
     63  6800		       ad 04 c6 	      lda	glideK
     64  6803		       8d 5d c8 	      sta	vsGlide
     65  6806				   .now0
     66  6806		       a9 00		      lda	#0
     67  6808		       60		      rts
     68  6809				   .snd
     69  6809		       bd 0a c3 	      lda	vWant,x
     70  680c		       c9 ff		      cmp	#NO_NOTE
     71  680e		       f0 7f		      beq	.now
     72  6810		       ad cb c3 	      lda	hardCut
     73  6813		       1d 7a c3 	      ora	vArpHit,x	; (the arp, MONO: their own way)
     74  6816		       0d 45 c4 	      ora	monoMode
     75  6819		       d0 74		      bne	.now
     76  681b		       ad 80 c8 	      lda	okpHit	; One Key Play's notes: at once, new attacks
     77  681e		       f0 0d		      beq	.s
     78  6820		       bd 0a c3 	      lda	vWant,x
     79  6823		       cd 7c c8 	      cmp	okpNotes
     80  6826		       f0 63		      beq	.okp
     81  6828		       cd 7d c8 	      cmp	okpNotes+1
     82  682b		       f0 5e		      beq	.okp
     83  682d				   .s
     84  682d		       20 c1 67 	      jsr	ChgEff
     85  6830		       c9 01		      cmp	#CHG_ATTACK
     86  6832		       f0 5b		      beq	.now
     87  6834		       c9 02		      cmp	#CHG_GLIDE
     88  6836		       f0 5a		      beq	.glide
     89  6838		       c9 03		      cmp	#CHG_STAGGER
     90  683a		       d0 0e		      bne	.wander
     91  683c		       bd 9a 80 	      lda	vDev,x	; STAGGER: the SID and the bass glide
     92  683f		       f0 51		      beq	.glide
     93  6841		       bd a3 80 	      lda	vIdx,x
     94  6844		       c9 02		      cmp	#2
     95  6846		       f0 4a		      beq	.glide
