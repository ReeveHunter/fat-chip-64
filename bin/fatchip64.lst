------- FILE main.asm
------- FILE lead.asm LEVEL 2 PASS 3
      0  7002					      include	"lead.asm"
      1  7002							; Fat Chip 64 - CHORD + LEAD (v0.28): a chord and a lead at once, each its
      2  7002							; own patch.
      3  7002							;   BASS      (was LOW NOTE) the first key pressed is the chord's root
      4  7002							;	       (POLY: just it; SMART CHORD: its 5TH, TRIAD...; DRONE: the
      5  7002							;	       drone); every other key is the lead, while the chord key is held
      6  7002							;   TRIAD     (was LATCH 3) three keys pressed together are the chord while
      7  7002							;	       they're held (v0.36: with LATCH on, it keeps sounding after you
      8  7002							;	       let go); every other key is the lead.
      9  7002							; v0.36: the lead is LEAD OCTAVE up in every mode (+1 at first; SHIFT + F1 /
     10  7002							; F3; v0.43: One Key Play too). v0.43: SHIFT + F5 SPLIT on / off, SHIFT + F7
     11  7002							; its mode, SHIFT + K then a note: the split point. LATCH holds KEY's chord side and TRIAD's chord.
     12  7002							; The lead is one note (the last key pressed) on one voice per chip (SID 3,
     13  7002							; Game Boy pulse 1, NES pulse 1), only while it plays: the rest of the time
     14  7002							; those voices are the chord's. Its patch: SHIFT + A S D F G / Z X C V B.
     15  7002							; The lead's own: the SID's waveform, width, envelope and octave, the Game
     16  7002							; Boy pulse's CCs, the NES pulse's duty. Shared with the chord: the effects
     17  7002							; (vibrato, filter, tremolo...), the NES envelope.
     18  7002
     19  7002							;   KEY       (v0.32) a keyboard split: keys below the split point are the
     20  7002							;	       chord (as the mode plays them), keys from it up the lead (LEAD
     21  7002							;	       OCTAVE, +1 at first). On the C64's keys the split is a key (it
     22  7002							;	       stays put when the octave changes); over MIDI, a note as sent
     23  7002							;	       (before MIDI IN OCTAVE). SHIFT + F5 held + a note sets either.
     24  7002		       00 01	   CL_KEY     equ	1	; SPLIT (clMode)
     25  7002		       00 02	   CL_BASS    equ	2
     26  7002		       00 03	   CL_L3      equ	3	; (TRIAD)
     27  7002		       00 06	   LEAD_SID   equ	6	; the lead's voices: SID 3, GB pulse 1, NES pulse 1
     28  7002		       00 01	   LEAD_GB    equ	1
     29  7002		       00 02	   LEAD_NES   equ	2
     30  7002
     31  7002							; NoteDown, CHORD + LEAD on: key X pressed. Carry set: it's the lead (the
     32  7002							; latch styles leave it alone).
     33  7002				   ClPress
     34  7002					      subroutine
