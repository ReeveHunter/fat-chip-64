------- FILE repeat.asm LEVEL 2 PASS 3
      0  4beb					      include	"repeat.asm"
      1  4beb							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  4beb							;
      3  4beb							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  4beb							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  4beb							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  4beb							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  4beb							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  4beb							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  4beb							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  4beb							; 3/4 of the time between echoes. The SID doesn't echo.
     11  4beb							;
     12  4beb							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  4beb							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  4beb							; or a keytar button).
     15  4beb							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  4beb							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  4beb
     18  4beb		       00 10	   RP_SLOTS   equ	16
     19  4beb		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  4beb
     21  4beb							; REPEAT is on now?
     22  4beb				   RepeatActive
     23  4beb		       ad 58 c5 	      lda	repeatOn
     24  4bee		       0d b8 c4 	      ora	actCnt+A_REPEAT
     25  4bf1		       60		      rts
     26  4bf2
