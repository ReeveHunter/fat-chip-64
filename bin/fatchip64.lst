      0  3f54					      include	"repeat.asm"
      1  3f54							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  3f54							;
      3  3f54							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  3f54							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  3f54							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  3f54							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  3f54							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  3f54							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  3f54							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  3f54							; 3/4 of the time between echoes. The SID doesn't echo.
     11  3f54							;
     12  3f54							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  3f54							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  3f54							; or a keytar button).
     15  3f54							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  3f54							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  3f54
     18  3f54		       00 10	   RP_SLOTS   equ	16
     19  3f54		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  3f54
