    377  3119		       ae 4c c7 	      ldx	sxOn
    378  311c		       f0 1c		      beq	.x
    379  311e		       a2 00		      ldx	#0
    380  3120		       8e 4c c7 	      stx	sxOn
    381  3123		       c9 f7		      cmp	#$F7
    382  3125		       d0 13		      bne	.x
    383  3127		       ae 1c c8 	      ldx	sxCmd
    384  312a		       e0 02		      cpx	#2
    385  312c		       f0 0d		      beq	.dev
    386  312e		       ae 4d c7 	      ldx	sxPos
    387  3131		       e0 ab		      cpx	#SX_LEN
    388  3133		       d0 05		      bne	.x
    389  3135		       48		      pha
    390  3136		       20 cc 31 	      jsr	PatchReceived
    391  3139		       68		      pla
    392  313a				   .x
    393  313a		       60		      rts
    394  313b				   .dev
    395  313b		       ae 4d c7 	      ldx	sxPos
    396  313e		       e0 05		      cpx	#5
    397  3140		       d0 f8		      bne	.x
