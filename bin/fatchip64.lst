------- FILE midiin.asm LEVEL 2 PASS 3
      0  3aec					      include	"midiin.asm"
      1  3aec							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  3aec							;
      3  3aec							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  3aec							; The main loop parses them (running status; realtime and system bytes are
      5  3aec							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  3aec							; notes mode, latch, arp and K + note.
      7  3aec							;
      8  3aec							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  3aec							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  3aec							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  3aec							;
     12  3aec							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  3aec							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  3aec							;
     15  3aec							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  3aec							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  3aec							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  3aec							; MIDI in is passed on to the Game Boy or NES.
     19  3aec
     20  3aec							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  3aec							; Uses A, X.
     22  3aec							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  3aec							; with the time; a Start ($FA) makes the next clock a beat.
     24  3aec				   RxByte
     25  3aec					      subroutine
     26  3aec		       ad 06 de 	      lda	ACIA_STAT
     27  3aef		       4a		      lsr		; RDRF -> carry
     28  3af0		       90 2b		      bcc	.x
     29  3af2				   RxGot
     30  3af2		       ad 07 de 	      lda	ACIA_RX
     31  3af5		       c9 f8		      cmp	#$F8
     32  3af7		       f0 25		      beq	.clk
     33  3af9		       c9 fa		      cmp	#$FA
     34  3afb		       d0 0e		      bne	.buf
     35  3afd		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  3aff		       8e b3 ca 	      stx	clkPhase
     37  3b02		       8e bb ca 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3b05							;  the main loop could measure it)
     39  3b05		       ae b4 ca 	      ldx	clkBeat
     40  3b08		       8e c6 ca 	      stx	clkStartBeat
     41  3b0b				   .buf
     42  3b0b		       ae f1 c8 	      ldx	rxHead
     43  3b0e		       9d b1 c8 	      sta	rxBuf,x
     44  3b11		       e8		      inx
     45  3b12		       8a		      txa
     46  3b13		       29 3f		      and	#63
     47  3b15		       cd f2 c8 	      cmp	rxTail
     48  3b18		       f0 03		      beq	.x	; full: dropped
     49  3b1a		       8d f1 c8 	      sta	rxHead
     50  3b1d				   .x
     51  3b1d		       60		      rts
     52  3b1e				   .clk
     53  3b1e		       ee af ca 	      inc	clkCount
     54  3b21		       ae b3 ca 	      ldx	clkPhase
     55  3b24		       e8		      inx
     56  3b25		       e0 18		      cpx	#24
     57  3b27		       90 1b		      bcc	.ph
     58  3b29		       a5 10		      lda	ticks
     59  3b2b		       8d b6 ca 	      sta	clkAtL
     60  3b2e		       a5 11		      lda	ticks+1
