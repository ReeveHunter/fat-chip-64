------- FILE main.asm
------- FILE devices.asm LEVEL 2 PASS 3
      0  67db					      include	"devices.asm"
      1  67db							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  67db							; are in use, and each one in use gets its page on the main menu.
      3  67db							;
      4  67db							; YAMAHA SHS-10 (the keytar)
      5  67db							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  67db							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  67db							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  67db							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  67db							;		     can play at once.)
     10  67db							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  67db							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  67db							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  67db							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  67db							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  67db							;		     louder (the SID and the NES; the Game Boy would click) or
     16  67db							;		     brighter (the SID's filter: switched on if the patch has
     17  67db							;		     none)
     18  67db							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  67db							;		     the patch's, or the ADVANCED amounts if it has none;
     20  67db							;		     FILTER), or an action held while blowing hard
     21  67db							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  67db							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  67db							;   PORTAMENTO BUTTON	an action (CC 65)
     24  67db							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  67db							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  67db							; ATARI SYNTHCART
     27  67db							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  67db							;		     about 3% while held, SHIFT + , . step through the ten
     29  67db							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  67db							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  67db							;		     sound's cents (the Synthcart manual's table: each Atari
     32  67db							;		     sound plays its scales in its own key, a little off)
     33  67db							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  67db
     35  67db		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  67db		       00 28	   BREATH_LO  equ	40
     37  67db		       00 01	   BFX_VIB    equ	1
     38  67db		       00 02	   BFX_WARB   equ	2
     39  67db		       00 03	   BFX_DET    equ	3
     40  67db		       00 04	   BFX_FILT   equ	4
     41  67db		       00 05	   BFX_HELD   equ	5
     42  67db
