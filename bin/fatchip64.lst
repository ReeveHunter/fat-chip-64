------- FILE nesfx.asm LEVEL 2 PASS 3
      0  7b0a					      include	"nesfx.asm"
      1  7b0a							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7b0a							;
      3  7b0a							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7b0a							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7b0a							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7b0a							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7b0a							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7b0a							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7b0a							;   glide    a new note starts bent back to the voice's last note and slides
     10  7b0a							;	      in the way the SID's does (all three channels)
     11  7b0a							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7b0a							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7b0a							; semitone, so these are a little stepped.
     14  7b0a
     15  7b0a		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7b0a							;  (the pulses, and the triangle while it glides)
     17  7b0a
     18  7b0a							; A = 1 (not Z) when a NesFxTick step is due
     19  7b0a				   NesFxDue
     20  7b0a					      subroutine
     21  7b0a		       ad 27 c3 	      lda	devOn+DEV_NES
     22  7b0d		       f0 19		      beq	.x
     23  7b0f		       ad ff c5 	      lda	vibDepth
     24  7b12		       0d 2d c5 	      ora	nfxGlide
     25  7b15		       0d 2e c5 	      ora	nfxRun
     26  7b18		       f0 0e		      beq	.x
     27  7b1a		       a5 10		      lda	ticks
     28  7b1c		       38		      sec
     29  7b1d		       ed 29 c5 	      sbc	nfxLast
     30  7b20		       c9 08		      cmp	#NFX_EVERY
     31  7b22		       a9 00		      lda	#0
     32  7b24		       90 02		      bcc	.x
     33  7b26		       a9 01		      lda	#1
     34  7b28				   .x
     35  7b28		       60		      rts
     36  7b29
     37  7b29							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  7b29							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  7b29							; quick return.
     40  7b29				   NesFxTick
