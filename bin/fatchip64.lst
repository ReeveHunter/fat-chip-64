    300  2e6d
    301  2e6d							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    302  2e6d							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    303  2e6d							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    304  2e6d							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    305  2e6d		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    306  2e71		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    307  2e78		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    308  2e7f		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    309  2e84		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    310  2e88		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    311  2e8c		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
    312  2e91		       05 0a 0f 14*uTremRH    .byte.b	>1311, >2621, >3932, >5243, >6554
    313  2e96		       04 08 0c 10 uDetT      .byte.b	4, 8, 12, 16
    314  2e9a		       18 38 64    uWarbT     .byte.b	24, 56, 100
