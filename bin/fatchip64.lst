    289  0d2e							; write the slot at head first (always free: one slot stays empty),
    290  0d2e							; then publish head unless the queue is full. Uses only A and X.
    291  0d2e		       a6 1a		      ldx	nesqHead
    292  0d30		       a5 21		      lda	mS
