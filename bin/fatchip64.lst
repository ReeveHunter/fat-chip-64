    139  5594							; period in 1/16 ms
    140  5594		       06 26		      asl	t2
    141  5596		       26 27		      rol	t3
    142  5598		       06 26		      asl	t2
    143  559a		       26 27		      rol	t3
    144  559c		       ad fe c5 	      lda	clkHave
    145  559f		       c9 02		      cmp	#2
    146  55a1		       f0 12		      beq	.avg
    147  55a3		       a5 26		      lda	t2
    148  55a5		       8d ff c5 	      sta	clk16L
    149  55a8		       a5 27		      lda	t3
