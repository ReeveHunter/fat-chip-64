    200  0cc0							; Carry set if the Teensyboy has room for a message (always, with the Game
    201  0cc0							; Boy off), and counts it.
    202  0cc0				   LinkRoom
    203  0cc0					      subroutine
    204  0cc0		       ad 26 c3 	      lda	devOn+DEV_GB
    205  0cc3		       f0 0a		      beq	.yes
