    193  7ec1		       f0 53		      beq	.snap
    194  7ec3							; total = d x n (n = 1-8: shift and add)
    195  7ec3		       a9 00		      lda	#0
    196  7ec5		       8d 27 c5 	      sta	nfxTL
    197  7ec8		       8d 28 c5 	      sta	nfxTH
    198  7ecb		       ad 2f c5 	      lda	nfxN
    199  7ece		       8d 31 c5 	      sta	nfxC
