    148  0fcd							; A = key code at ksCol / ksRow
    149  0fcd				   KeyCode
    150  0fcd					      subroutine
    151  0fcd		       ad 3c c3 	      lda	ksCol
    152  0fd0		       0a		      asl
    153  0fd1		       0a		      asl
    154  0fd2		       0a		      asl
    155  0fd3		       0d 3d c3 	      ora	ksRow
    156  0fd6		       a8		      tay
    157  0fd7		       b9 00 84 	      lda	keymap,y
    158  0fda		       60		      rts
