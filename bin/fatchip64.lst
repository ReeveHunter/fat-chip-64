     26  693c					      subroutine
     27  693c		       ad 5d c8 	      lda	chgMode
     28  693f		       d0 0c		      bne	.x
     29  6941		       ad ab c3 	      lda	effMode
     30  6944		       c9 02		      cmp	#MODE_DRONE
     31  6946		       d0 03		      bne	.a
     32  6948		       a9 04		      lda	#CHG_WANDER
     33  694a		       60		      rts
     34  694b				   .a
     35  694b		       a9 01		      lda	#CHG_ATTACK
     36  694d				   .x
     37  694d		       60		      rts
