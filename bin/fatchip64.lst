------- FILE main.asm LEVEL 1 PASS 3
      1  c447 ????						; Fat Chip 64 - main program
      2  c447 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  c447 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  c447 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  c447 ????
      6  c447 ????				      processor	6502
