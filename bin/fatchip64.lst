------- FILE keys.asm LEVEL 2 PASS 3
      0  0f08					      include	"keys.asm"
      1  0f08							; Fat Chip 64 - keyboard and RESTORE
      2  0f08
      3  0f08							; Scan the whole matrix, turn changes into key events.
      4  0f08							;
      5  0f08							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0f08							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0f08							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0f08							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0f08							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0f08							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0f08							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0f08							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0f08							; chords whose ghost lands on another used key lose their newest note.
     14  0f08				   KeyScan
     15  0f08					      subroutine
     16  0f08		       a2 07		      ldx	#7
     17  0f0a				   .col
     18  0f0a		       bd 24 89 	      lda	colSelect,x
     19  0f0d		       8d 00 dc 	      sta	CIA1_PRA
     20  0f10		       ad 01 dc 	      lda	CIA1_PRB
     21  0f13		       49 ff		      eor	#$FF
     22  0f15		       3d 48 c7 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0f18		       9d 40 c7 	      sta	keyNow,x
     24  0f1b		       ca		      dex
     25  0f1c		       10 ec		      bpl	.col
     26  0f1e		       a9 ff		      lda	#$FF
     27  0f20		       8d 00 dc 	      sta	CIA1_PRA
     28  0f23							; ---- every column as accepted (nothing pressed or let go): done
     29  0f23		       a2 07		      ldx	#7
     30  0f25				   .same
     31  0f25		       bd 40 c7 	      lda	keyNow,x
     32  0f28		       dd 50 c7 	      cmp	keyAcc,x
     33  0f2b		       d0 04		      bne	.changed
     34  0f2d		       ca		      dex
     35  0f2e		       10 f5		      bpl	.same
     36  0f30		       60		      rts
     37  0f31				   .changed
     38  0f31							; ---- releases first: accepted keys that are up now
     39  0f31		       a2 00		      ldx	#0
     40  0f33				   .rc
     41  0f33		       8e fc c7 	      stx	ksCol
     42  0f36		       bd 40 c7 	      lda	keyNow,x
     43  0f39		       49 ff		      eor	#$FF
     44  0f3b		       3d 50 c7 	      and	keyAcc,x
     45  0f3e		       8d fb c7 	      sta	ksBits
     46  0f41		       a9 00		      lda	#0
     47  0f43		       8d fd c7 	      sta	ksRow
     48  0f46				   .rb
     49  0f46		       ad fb c7 	      lda	ksBits
     50  0f49		       f0 21		      beq	.rcn
     51  0f4b		       4e fb c7 	      lsr	ksBits
     52  0f4e		       90 17		      bcc	.rbn
     53  0f50		       ae fc c7 	      ldx	ksCol
     54  0f53		       ac fd c7 	      ldy	ksRow
     55  0f56		       b9 2c 89 	      lda	rowBit,y
     56  0f59		       49 ff		      eor	#$FF
     57  0f5b		       3d 50 c7 	      and	keyAcc,x
     58  0f5e		       9d 50 c7 	      sta	keyAcc,x
     59  0f61		       20 07 10 	      jsr	KeyCode
     60  0f64		       20 75 19 	      jsr	KeyUp
     61  0f67				   .rbn
     62  0f67		       ee fd c7 	      inc	ksRow
     63  0f6a		       d0 da		      bne	.rb
     64  0f6c				   .rcn
     65  0f6c		       ae fc c7 	      ldx	ksCol
     66  0f6f		       e8		      inx
     67  0f70		       e0 08		      cpx	#8
     68  0f72		       d0 bf		      bne	.rc
     69  0f74							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0f74							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0f74							; still count as a combination.
