------- FILE midi.asm LEVEL 2 PASS 3
      0  0bd7					      include	"midi.asm"
      1  0bd7							; Fat Chip 64 - MIDI out
      2  0bd7							;
      3  0bd7							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0bd7							; at most one message per device onto the wire buffer, no sooner than that
      5  0bd7							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0bd7							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0bd7							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0bd7							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0bd7							; The wire uses running status, except that every Game Boy message carries its
     10  0bd7							; status byte (v0.64). The main loop and the IRQ both feed the ACIA.
     11  0bd7
     12  0bd7				   MidiInit
     13  0bd7					      subroutine
     14  0bd7		       a9 03		      lda	#ACIA_RESET
     15  0bd9		       8d 04 de 	      sta	ACIA_CTRL
     16  0bdc		       a9 16		      lda	#ACIA_MODE
     17  0bde		       8d 04 de 	      sta	ACIA_CTRL
     18  0be1							; (fall into the test)
     19  0be1
     20  0be1							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     21  0be1							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     22  0be1							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     23  0be1							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     24  0be1							; before. Interrupts are off when this is called.
     25  0be1				   MidiIrqTest
     26  0be1					      subroutine
     27  0be1		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     28  0be3		       8d 0d dc 	      sta	CIA1_ICR
     29  0be6		       ad 0d dc 	      lda	CIA1_ICR
     30  0be9		       a9 31		      lda	#<IrqTest
     31  0beb		       8d fe ff 	      sta	$FFFE
     32  0bee		       a9 0c		      lda	#>IrqTest
     33  0bf0		       8d ff ff 	      sta	$FFFF
     34  0bf3		       a9 00		      lda	#0
     35  0bf5		       85 2f		      sta	midiIrq
     36  0bf7		       a9 b6		      lda	#ACIA_MODE_TX
     37  0bf9		       8d 04 de 	      sta	ACIA_CTRL
     38  0bfc		       58		      cli
     39  0bfd		       a2 00		      ldx	#0
     40  0bff				   .w
     41  0bff		       ca		      dex
     42  0c00		       d0 fd		      bne	.w
     43  0c02		       78		      sei
     44  0c03		       a6 2f		      ldx	midiIrq
     45  0c05		       bd 3d 0c 	      lda	midiCtl,x
     46  0c08		       8d 04 de 	      sta	ACIA_CTRL
     47  0c0b		       bd 3f 0c 	      lda	irqLo,x
     48  0c0e		       8d fe ff 	      sta	$FFFE
     49  0c11		       bd 41 0c 	      lda	irqHi,x
     50  0c14		       8d ff ff 	      sta	$FFFF
     51  0c17		       bd 43 0c 	      lda	latchLo,x
     52  0c1a		       8d 04 dc 	      sta	CIA1_TALO
     53  0c1d		       bd 45 0c 	      lda	latchHi,x
     54  0c20		       8d 05 dc 	      sta	CIA1_TAHI
     55  0c23		       a9 11		      lda	#$11	; start, force load, continuous
     56  0c25		       8d 0e dc 	      sta	CIA1_CRA
     57  0c28		       ad 0d dc 	      lda	CIA1_ICR
     58  0c2b		       a9 81		      lda	#$81	; timer A interrupt on
     59  0c2d		       8d 0d dc 	      sta	CIA1_ICR
     60  0c30		       60		      rts
     61  0c31				   IrqTest
     62  0c31		       48		      pha
     63  0c32		       a9 01		      lda	#1
     64  0c34		       85 2f		      sta	midiIrq
     65  0c36		       a9 16		      lda	#ACIA_MODE	; (quiet again)
     66  0c38		       8d 04 de 	      sta	ACIA_CTRL
     67  0c3b		       68		      pla
     68  0c3c		       40		      rti
     69  0c3d		       16 96	   midiCtl    .byte.b	ACIA_MODE, ACIA_MODE_RX
     70  0c3f		       17 65	   irqLo      .byte.b	<Irq, <IrqMidi
     71  0c41		       0b 0b	   irqHi      .byte.b	>Irq, >IrqMidi
     72  0c43		       ff ff	   latchLo    .byte.b	<TICK_LATCH, <TICK_LATCH_MS
     73  0c45		       00 03	   latchHi    .byte.b	>TICK_LATCH, >TICK_LATCH_MS
     74  0c47
     75  0c47							; IRQ: send one wire byte if the ACIA is ready.
     76  0c47				   TxByte
     77  0c47					      subroutine
     78  0c47		       a6 16		      ldx	wireTail
     79  0c49		       e4 15		      cpx	wireHead
     80  0c4b		       f0 0f		      beq	.done
     81  0c4d		       ad 06 de 	      lda	ACIA_STAT
     82  0c50		       29 02		      and	#ACIA_TDRE
     83  0c52		       f0 08		      beq	.done
     84  0c54		       bd 00 c4 	      lda	wireBuf,x
     85  0c57		       8d 05 de 	      sta	ACIA_TX
     86  0c5a		       e6 16		      inc	wireTail
     87  0c5c				   .done
     88  0c5c		       60		      rts
     89  0c5d
     90  0c5d							; Main loop: same, with interrupts off around it.
     91  0c5d				   TxService
     92  0c5d					      subroutine
     93  0c5d		       a5 2f		      lda	midiIrq	; (the MIDI chip's interrupts do it)
     94  0c5f		       f0 01		      beq	.poll
     95  0c61		       60		      rts
     96  0c62				   .poll
     97  0c62		       08		      php
     98  0c63		       78		      sei
     99  0c64		       20 47 0c 	      jsr	TxByte
    100  0c67		       20 aa 3a 	      jsr	RxByte
    101  0c6a		       28		      plp
    102  0c6b		       60		      rts
    103  0c6c
    104  0c6c							; IRQ: pace device queues onto the wire.
    105  0c6c							;
    106  0c6c							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    107  0c6c							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    108  0c6c							; times as signed numbers, so after 33 s of silence every queue froze for
    109  0c6c							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    110  0c6c							;
    111  0c6c							; When the Game Boy is on, everything on the wire also passes through the
    112  0c6c							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    113  0c6c							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    114  0c6c							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    115  0c6c							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    116  0c6c							; message, the rate measured clean.
    117  0c6c				   Schedule
    118  0c6c					      subroutine
    119  0c6c		       ad ea c7 	      lda	devOn+DEV_GB
    120  0c6f		       f0 10		      beq	.gb
    121  0c71		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    122  0c73		       f0 0c		      beq	.gb
    123  0c75		       c6 2e		      dec	linkLoad
    124  0c77		       f0 08		      beq	.gb
    125  0c79		       a5 10		      lda	ticks
    126  0c7b		       29 01		      and	#1
    127  0c7d		       f0 02		      beq	.gb
    128  0c7f		       c6 2e		      dec	linkLoad
    129  0c81				   .gb
    130  0c81							; ---- Game Boy
    131  0c81		       a5 18		      lda	gbqTail
    132  0c83		       c5 17		      cmp	gbqHead
    133  0c85		       f0 3d		      beq	.nes
    134  0c87		       a5 19		      lda	gbNext
    135  0c89		       38		      sec
    136  0c8a		       e5 10		      sbc	ticks
    137  0c8c		       f0 04		      beq	.gbDue
    138  0c8e		       c9 04		      cmp	#GB_GAP+1
    139  0c90		       90 32		      bcc	.nes	; 1..GB_GAP ms to go
    140  0c92				   .gbDue
    141  0c92							; only onto an empty wire, so the gap holds on the cable itself (NES
    142  0c92							; bytes already waiting would otherwise delay this one and squeeze it
    143  0c92							; against the next). While a Game Boy message is due, the NES doesn't
    144  0c92							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    145  0c92							; holding its notes back.
    146  0c92		       20 aa 3a 	      jsr	RxByte	; (v0.66: MIDI in now too: the Game Boy's message
    147  0c95							;  and the NES's after it outlast a byte's time)
    148  0c95		       a5 15		      lda	wireHead
    149  0c97		       c5 16		      cmp	wireTail
    150  0c99		       d0 69		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    151  0c9b		       20 05 0d 	      jsr	LinkRoom
    152  0c9e		       90 24		      bcc	.nes
    153  0ca0		       a9 ff		      lda	#$FF	; v0.64: every Game Boy message carries its status
    154  0ca2		       85 14		      sta	lastStatus	; byte (no running status): the link drops a byte
    155  0ca4		       a6 18		      ldx	gbqTail	; now and then, and in a run of nothing but drum
    156  0ca6		       bd 00 c5 	      lda	gbqS,x	; notes that left every later note out of step
    157  0ca9		       bc 00 c6 	      ldy	gbqD2,x
    158  0cac		       84 2c		      sty	irqT
    159  0cae		       bc 80 c5 	      ldy	gbqD1,x
    160  0cb1		       20 21 0d 	      jsr	WireMsg
    161  0cb4		       a5 18		      lda	gbqTail
    162  0cb6		       18		      clc
    163  0cb7		       69 01		      adc	#1
    164  0cb9		       29 7f		      and	#127
    165  0cbb		       85 18		      sta	gbqTail
    166  0cbd		       a5 10		      lda	ticks
    167  0cbf		       18		      clc
    168  0cc0		       69 03		      adc	#GB_GAP
    169  0cc2		       85 19		      sta	gbNext
    170  0cc4				   .nes
    171  0cc4		       20 aa 3a 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    172  0cc7		       a5 1b		      lda	nesqTail
    173  0cc9		       c5 1a		      cmp	nesqHead
    174  0ccb		       f0 37		      beq	.done
    175  0ccd		       a5 1c		      lda	nesNext
    176  0ccf		       38		      sec
    177  0cd0		       e5 10		      sbc	ticks
    178  0cd2		       f0 04		      beq	.nesDue
    179  0cd4		       c9 02		      cmp	#NES_GAP+1
    180  0cd6		       90 2c		      bcc	.done
    181  0cd8				   .nesDue
    182  0cd8		       20 18 0d 	      jsr	WireFree
    183  0cdb		       c9 03		      cmp	#3
    184  0cdd		       90 25		      bcc	.done
    185  0cdf		       20 05 0d 	      jsr	LinkRoom
    186  0ce2		       90 20		      bcc	.done
    187  0ce4		       a6 1b		      ldx	nesqTail
    188  0ce6		       bd 80 c6 	      lda	nesqS,x
    189  0ce9		       bc 00 c7 	      ldy	nesqD2,x
    190  0cec		       84 2c		      sty	irqT
    191  0cee		       bc c0 c6 	      ldy	nesqD1,x
    192  0cf1		       20 21 0d 	      jsr	WireMsg
    193  0cf4		       a5 1b		      lda	nesqTail
    194  0cf6		       18		      clc
    195  0cf7		       69 01		      adc	#1
    196  0cf9		       29 3f		      and	#63
    197  0cfb		       85 1b		      sta	nesqTail
    198  0cfd		       a5 10		      lda	ticks
    199  0cff		       18		      clc
    200  0d00		       69 01		      adc	#NES_GAP
    201  0d02		       85 1c		      sta	nesNext
    202  0d04				   .done
    203  0d04		       60		      rts
    204  0d05
    205  0d05							; Carry set if the Teensyboy has room for a message (always, with the Game
    206  0d05							; Boy off), and counts it.
    207  0d05				   LinkRoom
    208  0d05					      subroutine
    209  0d05		       ad ea c7 	      lda	devOn+DEV_GB
    210  0d08		       f0 0a		      beq	.yes
    211  0d0a		       a5 2e		      lda	linkLoad
    212  0d0c		       c9 2d		      cmp	#LINK_MAX
    213  0d0e		       b0 06		      bcs	.no
