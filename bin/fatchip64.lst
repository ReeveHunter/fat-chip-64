------- FILE main.asm
------- FILE arp.asm LEVEL 2 PASS 2
      0  15a2					      include	"arp.asm"
      1  15a2							; Fat Chip 64 - tempo and arpeggiator
      2  15a2							;
      3  15a2							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  15a2							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  15a2							;
      6  15a2							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  15a2							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  15a2							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  15a2							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  15a2							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  15a2							;	     until its voice's next turn.
     12  15a2							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  15a2							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  15a2							;   J faster; either one also picks FREE).
     15  15a2							;
     16  15a2							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  15a2							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  15a2
     19  15a2							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  15a2							; between the two bytes: $22FF read as $23FF)
     21  15a2				   GetTicks
     22  15a2					      subroutine
     23  15a2		       08		      php
     24  15a3		       78		      sei
     25  15a4		       a5 10		      lda	ticks
     26  15a6		       8d 26 c3 	      sta	nowL
     27  15a9		       a5 11		      lda	ticks+1
     28  15ab		       8d 27 c3 	      sta	nowH
     29  15ae		       28		      plp
     30  15af		       60		      rts
     31  15b0
     32  15b0							; ------------------------------------------------------------ tempo
     33  15b0				   TapTempo
     34  15b0					      subroutine
     35  15b0		       20 a2 15 	      jsr	GetTicks
     36  15b3		       ad 26 c3 	      lda	nowL
     37  15b6		       38		      sec
     38  15b7		       ed 2b c3 	      sbc	tapLast
     39  15ba		       85 23		      sta	t0
     40  15bc		       ad 27 c3 	      lda	nowH
     41  15bf		       ed 2c c3 	      sbc	tapLast+1
     42  15c2		       85 24		      sta	t1
     43  15c4		       ad 26 c3 	      lda	nowL
     44  15c7		       8d 2b c3 	      sta	tapLast
     45  15ca		       ad 27 c3 	      lda	nowH
     46  15cd		       8d 2c c3 	      sta	tapLast+1
     47  15d0		       ad 2d c3 	      lda	tapCount
     48  15d3		       d0 03		      bne	.had
     49  15d5		       4c 5c 16 	      jmp	.first
     50  15d8				   .had
     51  15d8							; 240 ms (250 BPM) <= gap < 2000 ms (30 BPM)
     52  15d8		       a5 24		      lda	t1
     53  15da		       c9 07		      cmp	#>2000
