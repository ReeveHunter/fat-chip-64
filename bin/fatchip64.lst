     84  808d				   .v
     85  808d		       bd e2 c4 	      lda	nesVT,x
     86  8090		       18		      clc
     87  8091		       6d 3b c5 	      adc	nfxN
     88  8094		       90 02		      bcc	.vt
     89  8096		       a9 ff		      lda	#255
     90  8098				   .vt
     91  8098		       9d e2 c4 	      sta	nesVT,x
     92  809b		       20 0f 81 	      jsr	NesGlideStep
     93  809e		       bd d0 c4 	      lda	nesGlL,x
