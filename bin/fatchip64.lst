------- FILE nesenv.asm LEVEL 2 PASS 3
      0  29e4					      include	"nesenv.asm"
      1  29e4							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  29e4							;
      3  29e4							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  29e4							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  29e4							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  29e4							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  29e4							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  29e4							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  29e4							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  29e4							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  29e4							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  29e4							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  29e4							; would wrap to a high pitch).
     14  29e4							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  29e4
     16  29e4							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  29e4							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  29e4							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  29e4							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  29e4							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  29e4		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  29e4		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  29e4							; NES channels too, and can't take a bend every 4 ms
     24  29e4		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  29e4		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  29e4
     27  29e4							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  29e4		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  29ed		       02 05	   slotVoice  .byte.b	2,5
     30  29ef
     31  29ef							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  29ef							; note keeps sounding for now). X = voice (= t0).
     33  29ef				   NesSoftRelease
     34  29ef					      subroutine
     35  29ef		       4c f4 29 	      jmp	.go
     36  29f2				   .nope
     37  29f2		       18		      clc
     38  29f3		       60		      rts
     39  29f4				   .go
     40  29f4		       ad 58 c8 	      lda	muteNow
     41  29f7		       0d 97 c8 	      ora	hardCut
     42  29fa		       d0 f6		      bne	.nope
     43  29fc		       ad eb c7 	      lda	devOn+DEV_NES
     44  29ff		       f0 f1		      beq	.nope
     45  2a01		       bd e3 88 	      lda	vDev,x
     46  2a04		       c9 02		      cmp	#DEV_NES
     47  2a06		       d0 ea		      bne	.nope
     48  2a08		       bd 5f c8 	      lda	vOut,x
     49  2a0b		       c9 ff		      cmp	#NO_NOTE
     50  2a0d		       f0 e3		      beq	.nope
     51  2a0f		       ad 13 c9 	      lda	nesEnvOn
     52  2a12		       f0 78		      beq	.fo	; (no envelope: BEND OUT's fall-off, if any)
     53  2a14		       bc e4 29 	      ldy	vEnvSlot,x
     54  2a17		       30 41		      bmi	.tri
     55  2a19							; pulse: release from the current level; step = level x factor / 4 + 1
     56  2a19							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  2a19							; about 2 s). Factor 0: no release, cut.
     58  2a19		       ad 36 c9 	      lda	envRelV
     59  2a1c		       f0 6e		      beq	.fo
     60  2a1e		       86 26		      stx	t2
     61  2a20		       84 27		      sty	t3
