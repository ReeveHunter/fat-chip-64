    121  3b9f		       d0 a7		      bne	.next
    122  3ba1		       a9 00		      lda	#0
    123  3ba3		       8d f4 c8 	      sta	rxCnt
    124  3ba6		       20 ce 3b 	      jsr	MidiInMsg
    125  3ba9		       4c 48 3b 	      jmp	.next
    126  3bac				   .rt
    127  3bac		       c9 fa		      cmp	#$FA
    128  3bae		       d0 06		      bne	.rt2
    129  3bb0		       20 7c 5e 	      jsr	KeytarStart
    130  3bb3		       4c 48 3b 	      jmp	.next
    131  3bb6				   .rt2
    132  3bb6		       c9 fc		      cmp	#$FC
    133  3bb8		       d0 03		      bne	.rt3
    134  3bba		       20 9d 5e 	      jsr	KeytarStop
    135  3bbd				   .rt3
