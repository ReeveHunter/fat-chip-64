    181  0cb2		       90 20		      bcc	.done
    182  0cb4		       a6 1b		      ldx	nesqTail
    183  0cb6		       bd c0 c5 	      lda	nesqS,x
    184  0cb9		       bc 40 c6 	      ldy	nesqD2,x
    185  0cbc		       84 2c		      sty	irqT
    186  0cbe		       bc 00 c6 	      ldy	nesqD1,x
    187  0cc1		       20 f1 0c 	      jsr	WireMsg
    188  0cc4		       a5 1b		      lda	nesqTail
    189  0cc6		       18		      clc
    190  0cc7		       69 01		      adc	#1
    191  0cc9		       29 3f		      and	#63
    192  0ccb		       85 1b		      sta	nesqTail
    193  0ccd		       a5 10		      lda	ticks
    194  0ccf		       18		      clc
