    441  3d22		       48		      pha
    442  3d23		       8a		      txa
    443  3d24		       38		      sec
    444  3d25		       e9 05		      sbc	#SX_HEAD
    445  3d27		       4a		      lsr
    446  3d28		       a8		      tay		; byte number
    447  3d29		       68		      pla
    448  3d2a		       29 0f		      and	#15
    449  3d2c		       b0 0b		      bcs	.lo
    450  3d2e		       0a		      asl
