------- FILE main.asm
------- FILE repeat.asm LEVEL 2 PASS 3
      0  4a0d					      include	"repeat.asm"
      1  4a0d							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  4a0d							;
      3  4a0d							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  4a0d							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  4a0d							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  4a0d							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  4a0d							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  4a0d							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  4a0d							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  4a0d							; 3/4 of the time between echoes. The SID doesn't echo.
     11  4a0d							;
     12  4a0d							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  4a0d							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  4a0d							; or a keytar button).
     15  4a0d							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  4a0d							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  4a0d
     18  4a0d		       00 10	   RP_SLOTS   equ	16
     19  4a0d		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  4a0d
     21  4a0d							; REPEAT is on now?
     22  4a0d				   RepeatActive
     23  4a0d		       ad 50 c5 	      lda	repeatOn
     24  4a10		       0d b0 c4 	      ora	actCnt+A_REPEAT
     25  4a13		       60		      rts
     26  4a14
     27  4a14							; Allocate, after SPARKLE took its pair: the echo voices (vSkip keeps them
     28  4a14							; out of the chord, vEcho marks them)
     29  4a14				   RepeatSet
     30  4a14					      subroutine
     31  4a14		       a2 08		      ldx	#NUM_VOICES-1
     32  4a16		       a9 00		      lda	#0
     33  4a18				   .c
     34  4a18		       9d 5d c5 	      sta	vEcho,x
     35  4a1b		       ca		      dex
     36  4a1c		       10 fa		      bpl	.c
     37  4a1e		       20 0d 4a 	      jsr	RepeatActive
