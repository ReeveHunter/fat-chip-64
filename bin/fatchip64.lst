------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  2db7					      include	"sounds.asm"
      1  2db7							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  2db7							;
      3  2db7							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  2db7							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  2db7							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  2db7							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  2db7							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  2db7							;
      9  2db7							; Each sound has a mono default and a Fat Bass default:
     10  2db7							;   MONO      one note (the last key pressed and still held) on every voice;
     11  2db7							;	       a new key while another is held changes the pitch without a
     12  2db7							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  2db7							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  2db7							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  2db7							;	       the other voices
     16  2db7							;
     17  2db7							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  2db7							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  2db7							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  2db7
     21  2db7							; ------------------------------------------------------------ choosing
     22  2db7							; V: next sound (SHIFT+V: previous)
     23  2db7				   SoundKey
     24  2db7					      subroutine
     25  2db7		       20 14 2e 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  2dba		       ae 95 c3 	      ldx	soundMode
     27  2dbd		       ad 2a c3 	      lda	shiftDown
     28  2dc0		       d0 09		      bne	.prev
     29  2dc2		       e8		      inx
     30  2dc3		       e0 13		      cpx	#NUM_SOUNDS
     31  2dc5		       90 09		      bcc	.s
     32  2dc7		       a2 00		      ldx	#0
     33  2dc9		       f0 05		      beq	.s
     34  2dcb				   .prev
     35  2dcb		       ca		      dex
     36  2dcc		       10 02		      bpl	.s
     37  2dce		       a2 12		      ldx	#NUM_SOUNDS-1
     38  2dd0				   .s
     39  2dd0		       4c da 2d 	      jmp	SoundSetX
