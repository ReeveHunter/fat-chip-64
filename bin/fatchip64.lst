------- FILE viz.asm LEVEL 2 PASS 3
      0  9266					      include	"viz.asm"
      1  9266							; Fat Chip 64 - the visualizer (F7: GLITCH on / off; v0.28 dropped the BARS)
      2  9266							;
      3  9266							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
      4  9266							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
      5  9266							; keep spattering more; runs of the screen get copied over other places
      6  9266							; (datamosh) and wiped away, so it fills while you play and dissolves when
      7  9266							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
      8  9266							; the background. VINYL STOP drags it down the screen.
      9  9266
     10  9266		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     11  9266		       00 16	   VIZ_NAMES  equ	22	; note names
     12  9266		       00 a0	   VIZ_FULL   equ	160	; reversed space
     13  9266		       00 62	   VIZ_HALF   equ	98	; lower half block
     14  9266
     15  9266							; RESTORE's VISUALIZER (v0.37; was F7): GLITCH on (not from the menu)
     16  9266				   VizOn
     17  9266					      subroutine
     18  9266		       ad 56 c9 	      lda	menuOn
     19  9269		       d0 2f		      bne	VizX
