     82  2a50		       a9 04		      lda	#ENV_R
     83  2a52		       99 81 c8 	      sta	envPh,y
     84  2a55		       20 a3 2a 	      jsr	RdBend	; BEND OUT: it sags as it fades
     85  2a58		       38		      sec
     86  2a59		       60		      rts
     87  2a5a				   .tri
     88  2a5a					      if	TRI_DROP_PADS == 0
     89  2a5a		       4c 8c 2a 	      jmp	.fo	; PADS: the bass just stops (Reeve, 2026-11-01)
     90  2a5d					      endif
     91  2a5d		       bd ec 88 	      lda	vIdx,x
     92  2a60		       c9 02		      cmp	#2
