------- FILE midi.asm LEVEL 2 PASS 2
      0  099f					      include	"midi.asm"
      1  099f							; Fat Chip 64 - MIDI out
      2  099f							;
      3  099f							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  099f							; at most one message per device onto the wire buffer, no sooner than that
      5  099f							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  099f							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  099f							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  099f							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  099f							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  099f
     11  099f				   MidiInit
     12  099f					      subroutine
     13  099f		       a9 03		      lda	#ACIA_RESET
     14  09a1		       8d 04 de 	      sta	ACIA_CTRL
     15  09a4		       a9 16		      lda	#ACIA_MODE
     16  09a6		       8d 04 de 	      sta	ACIA_CTRL
     17  09a9		       60		      rts
     18  09aa
     19  09aa							; IRQ: send one wire byte if the ACIA is ready.
     20  09aa				   TxByte
     21  09aa					      subroutine
     22  09aa		       a6 15		      ldx	wireTail
     23  09ac		       e4 14		      cpx	wireHead
     24  09ae		       f0 0f		      beq	.done
     25  09b0		       ad 06 de 	      lda	ACIA_STAT
     26  09b3		       29 02		      and	#ACIA_TDRE
     27  09b5		       f0 08		      beq	.done
     28  09b7		       bd 00 c0 	      lda	wireBuf,x
     29  09ba		       8d 05 de 	      sta	ACIA_TX
     30  09bd		       e6 15		      inc	wireTail
     31  09bf				   .done
     32  09bf		       60		      rts
     33  09c0
     34  09c0							; Main loop: same, with interrupts off around it.
     35  09c0				   TxService
     36  09c0					      subroutine
     37  09c0		       08		      php
     38  09c1		       78		      sei
     39  09c2		       20 aa 09 	      jsr	TxByte
     40  09c5		       28		      plp
     41  09c6		       60		      rts
     42  09c7
     43  09c7							; IRQ: pace device queues onto the wire.
     44  09c7							;
     45  09c7							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
     46  09c7							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
     47  09c7							; times as signed numbers, so after 33 s of silence every queue froze for
     48  09c7							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
     49  09c7							;
     50  09c7							; When the Game Boy is on, everything on the wire also passes through the
     51  09c7							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
     52  09c7							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
     53  09c7							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
     54  09c7							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
     55  09c7							; message, the rate measured clean.
     56  09c7				   Schedule
     57  09c7					      subroutine
     58  09c7		       ad 0e c3 	      lda	devOn+DEV_GB
     59  09ca		       f0 10		      beq	.gb
     60  09cc		       a5 2d		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
     61  09ce		       f0 0c		      beq	.gb
     62  09d0		       c6 2d		      dec	linkLoad
     63  09d2		       f0 08		      beq	.gb
     64  09d4		       a5 10		      lda	ticks
     65  09d6		       29 01		      and	#1
     66  09d8		       f0 02		      beq	.gb
     67  09da		       c6 2d		      dec	linkLoad
     68  09dc				   .gb
     69  09dc							; ---- Game Boy
     70  09dc		       a5 17		      lda	gbqTail
     71  09de		       c5 16		      cmp	gbqHead
     72  09e0		       f0 36		      beq	.nes
     73  09e2		       a5 18		      lda	gbNext
     74  09e4		       38		      sec
     75  09e5		       e5 10		      sbc	ticks
     76  09e7		       f0 04		      beq	.gbDue
     77  09e9		       c9 04		      cmp	#GB_GAP+1
     78  09eb		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
     79  09ed				   .gbDue
     80  09ed							; only onto an empty wire, so the gap holds on the cable itself (NES
     81  09ed							; bytes already waiting would otherwise delay this one and squeeze it
     82  09ed							; against the next)
     83  09ed		       a5 14		      lda	wireHead
     84  09ef		       c5 15		      cmp	wireTail
     85  09f1		       d0 25		      bne	.nes
     86  09f3		       20 56 0a 	      jsr	LinkRoom
     87  09f6		       90 20		      bcc	.nes
     88  09f8		       a6 17		      ldx	gbqTail
     89  09fa		       bd 00 c1 	      lda	gbqS,x
     90  09fd		       bc 80 c1 	      ldy	gbqD2,x
     91  0a00		       84 2b		      sty	irqT
     92  0a02		       bc 40 c1 	      ldy	gbqD1,x
     93  0a05		       20 72 0a 	      jsr	WireMsg
     94  0a08		       a5 17		      lda	gbqTail
     95  0a0a		       18		      clc
     96  0a0b		       69 01		      adc	#1
     97  0a0d		       29 3f		      and	#63
     98  0a0f		       85 17		      sta	gbqTail
     99  0a11		       a5 10		      lda	ticks
    100  0a13		       18		      clc
    101  0a14		       69 03		      adc	#GB_GAP
    102  0a16		       85 18		      sta	gbNext
    103  0a18				   .nes
    104  0a18		       a5 1a		      lda	nesqTail
    105  0a1a		       c5 19		      cmp	nesqHead
    106  0a1c		       f0 37		      beq	.done
    107  0a1e		       a5 1b		      lda	nesNext
    108  0a20		       38		      sec
    109  0a21		       e5 10		      sbc	ticks
    110  0a23		       f0 04		      beq	.nesDue
    111  0a25		       c9 02		      cmp	#NES_GAP+1
    112  0a27		       90 2c		      bcc	.done
