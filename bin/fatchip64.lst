    444  595f							; the keytar's 25 rhythm styles -> beat demos (0 ELECTRO, 1 JUNGLE, 2 DNB,
    445  595f							; 3 BOOMBAP, 4 ROCK, 5 6/8), by feel, until there are 20 beats
    446  595f							;   R&B 1/2, Fusion 1/2, Slow Rock, Swing, Big Band, Dixie, Boogie Woogie,
    447  595f							;   Jazz Waltz, R'n'R 1/2, Rock-a-Ballad, Hard Rock, Reggae, Bossa Nova,
    448  595f							;   Samba, Tango, Country, Bluegrass, March 1/2, Lullaby, Baroque, Fanfare
    449  595f		       03 03 00 02*styleBeat  .byte.b	3,3,0,2,5,3,1,4,4,5,4,4,5,4,3,0,1,0,4,2,4,4,5,0,4
