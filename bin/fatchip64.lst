    441  2e55		       4c a7 11 	      jmp	Dirty
------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  2e58					      include	"sounds.asm"
      1  2e58							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  2e58							;
      3  2e58							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  2e58							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  2e58							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  2e58							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  2e58							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  2e58							;
      9  2e58							; Each sound has a mono default and a Fat Bass default:
     10  2e58							;   MONO      one note (the last key pressed and still held) on every voice;
     11  2e58							;	       a new key while another is held changes the pitch without a
     12  2e58							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  2e58							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  2e58							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  2e58							;	       the other voices
     16  2e58							;
     17  2e58							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  2e58							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  2e58							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  2e58
     21  2e58							; ------------------------------------------------------------ choosing
     22  2e58							; V: next sound (SHIFT+V: previous)
     23  2e58				   SoundKey
     24  2e58					      subroutine
     25  2e58		       20 b5 2e 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  2e5b		       ae 95 c3 	      ldx	soundMode
     27  2e5e		       ad 2a c3 	      lda	shiftDown
     28  2e61		       d0 09		      bne	.prev
     29  2e63		       e8		      inx
     30  2e64		       e0 13		      cpx	#NUM_SOUNDS
     31  2e66		       90 09		      bcc	.s
     32  2e68		       a2 00		      ldx	#0
     33  2e6a		       f0 05		      beq	.s
     34  2e6c				   .prev
     35  2e6c		       ca		      dex
     36  2e6d		       10 02		      bpl	.s
     37  2e6f		       a2 12		      ldx	#NUM_SOUNDS-1
     38  2e71				   .s
     39  2e71		       4c 7b 2e 	      jmp	SoundSetX
     40  2e74
