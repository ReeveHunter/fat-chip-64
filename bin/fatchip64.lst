------- FILE screen.asm LEVEL 2 PASS 3
      0  5b73					      include	"screen.asm"
      1  5b73							; Fat Chip 64 - screen
      2  5b73							;
      3  5b73							;  row 0      header
      4  5b73							;  row 2      sound, POLY / MONO, Fat Bass
      5  5b73							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  5b73							;	       each plays (row 7: a channel overlap warning)
      7  5b73							;  row 9      key, notes mode, latch
      8  5b73							;  row 10     arp
      9  5b73							;  row 12     tempo, beat, mute
     10  5b73							;  row 13     SPACE's action, octave (the lowest key)
     11  5b73							;  row 15     held notes
     12  5b73							;  row 16     MIDI in
     13  5b73							;  row 24     F keys
     14  5b73
     15  5b73							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     16  5b73							; Letters become screen codes; bit 7 of t2 reverses.
     17  5b73				   PrintAt
     18  5b73					      subroutine
     19  5b73		       20 8b 5b 	      jsr	ScreenAddr
     20  5b76		       a0 00		      ldy	#0
     21  5b78				   .c
     22  5b78		       b1 28		      lda	(ptr),y
     23  5b7a		       f0 0e		      beq	.done
     24  5b7c		       c9 40		      cmp	#64
     25  5b7e		       90 03		      bcc	.noLetter
     26  5b80		       38		      sec
     27  5b81		       e9 40		      sbc	#64
     28  5b83				   .noLetter
     29  5b83		       05 26		      ora	t2
     30  5b85		       91 2a		      sta	(ptr2),y
     31  5b87		       c8		      iny
     32  5b88		       d0 ee		      bne	.c
     33  5b8a				   .done
     34  5b8a		       60		      rts
     35  5b8b
     36  5b8b							; ptr2 = SCREEN + 40*Y + X (row table: no loop)
     37  5b8b				   ScreenAddr
     38  5b8b					      subroutine
     39  5b8b		       8a		      txa
     40  5b8c		       18		      clc
