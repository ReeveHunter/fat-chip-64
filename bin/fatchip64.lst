     69  1a3e		       08		      php
     70  1a3f		       78		      sei
     71  1a40		       ad 91 c9 	      lda	sidVolNow	; the filter mode at once, the volume as it is
     72  1a43		       0d b8 c3 	      ora	sidFilt
