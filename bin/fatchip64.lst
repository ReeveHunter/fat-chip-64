------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  33d5					      include	"midiin.asm"
      1  33d5							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  33d5							;
      3  33d5							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  33d5							; The main loop parses them (running status; realtime and system bytes are
      5  33d5							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  33d5							; notes mode, latch, arp and K + note.
      7  33d5							;
      8  33d5							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  33d5							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  33d5							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  33d5							;
     12  33d5							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  33d5							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  33d5							;
     15  33d5							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  33d5							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  33d5							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  33d5							; MIDI in is passed on to the Game Boy or NES.
     19  33d5
     20  33d5							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  33d5							; Uses A, X.
     22  33d5							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  33d5							; with the time; a Start ($FA) makes the next clock a beat.
     24  33d5				   RxByte
     25  33d5					      subroutine
     26  33d5		       ad 06 de 	      lda	ACIA_STAT
     27  33d8		       4a		      lsr		; RDRF -> carry
     28  33d9		       90 2b		      bcc	.x
     29  33db				   RxGot
     30  33db		       ad 07 de 	      lda	ACIA_RX
     31  33de		       c9 f8		      cmp	#$F8
     32  33e0		       f0 25		      beq	.clk
     33  33e2		       c9 fa		      cmp	#$FA
     34  33e4		       d0 0e		      bne	.buf
     35  33e6		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  33e8		       8e e8 c5 	      stx	clkPhase
     37  33eb		       8e f0 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  33ee							;  the main loop could measure it)
     39  33ee		       ae e9 c5 	      ldx	clkBeat
     40  33f1		       8e fb c5 	      stx	clkStartBeat
     41  33f4				   .buf
     42  33f4		       ae 24 c4 	      ldx	rxHead
     43  33f7		       9d e4 c3 	      sta	rxBuf,x
     44  33fa		       e8		      inx
     45  33fb		       8a		      txa
     46  33fc		       29 3f		      and	#63
     47  33fe		       cd 25 c4 	      cmp	rxTail
     48  3401		       f0 03		      beq	.x	; full: dropped
     49  3403		       8d 24 c4 	      sta	rxHead
     50  3406				   .x
     51  3406		       60		      rts
     52  3407				   .clk
     53  3407		       ee e4 c5 	      inc	clkCount
     54  340a		       ae e8 c5 	      ldx	clkPhase
     55  340d		       e8		      inx
     56  340e		       e0 18		      cpx	#24
     57  3410		       90 1b		      bcc	.ph
     58  3412		       a5 10		      lda	ticks
     59  3414		       8d eb c5 	      sta	clkAtL
