    472  60f4		       a9 00		      lda	#0
    473  60f6		       8d 5c c8 	      sta	vsGlide
    474  60f9		       20 13 3a 	      jsr	SidRetune	; (the SID's notes sounding: there at once)
    475  60fc				   .k
