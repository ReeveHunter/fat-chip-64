------- FILE midiin.asm LEVEL 2 PASS 3
      0  33e6					      include	"midiin.asm"
      1  33e6							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  33e6							;
      3  33e6							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  33e6							; The main loop parses them (running status; realtime and system bytes are
      5  33e6							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  33e6							; notes mode, latch, arp and K + note.
      7  33e6							;
      8  33e6							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  33e6							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  33e6							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  33e6							;
     12  33e6							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  33e6							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  33e6							;
     15  33e6							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  33e6							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  33e6							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  33e6							; MIDI in is passed on to the Game Boy or NES.
     19  33e6
     20  33e6							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  33e6							; Uses A, X.
     22  33e6							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  33e6							; with the time; a Start ($FA) makes the next clock a beat.
     24  33e6				   RxByte
     25  33e6					      subroutine
     26  33e6		       ad 06 de 	      lda	ACIA_STAT
     27  33e9		       4a		      lsr		; RDRF -> carry
     28  33ea		       90 2b		      bcc	.x
     29  33ec				   RxGot
     30  33ec		       ad 07 de 	      lda	ACIA_RX
     31  33ef		       c9 f8		      cmp	#$F8
     32  33f1		       f0 25		      beq	.clk
     33  33f3		       c9 fa		      cmp	#$FA
     34  33f5		       d0 0e		      bne	.buf
     35  33f7		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  33f9		       8e e8 c5 	      stx	clkPhase
     37  33fc		       8e f0 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  33ff							;  the main loop could measure it)
     39  33ff		       ae e9 c5 	      ldx	clkBeat
     40  3402		       8e fb c5 	      stx	clkStartBeat
     41  3405				   .buf
     42  3405		       ae 24 c4 	      ldx	rxHead
     43  3408		       9d e4 c3 	      sta	rxBuf,x
     44  340b		       e8		      inx
     45  340c		       8a		      txa
     46  340d		       29 3f		      and	#63
     47  340f		       cd 25 c4 	      cmp	rxTail
     48  3412		       f0 03		      beq	.x	; full: dropped
     49  3414		       8d 24 c4 	      sta	rxHead
     50  3417				   .x
     51  3417		       60		      rts
     52  3418				   .clk
     53  3418		       ee e4 c5 	      inc	clkCount
     54  341b		       ae e8 c5 	      ldx	clkPhase
     55  341e		       e8		      inx
     56  341f		       e0 18		      cpx	#24
     57  3421		       90 1b		      bcc	.ph
     58  3423		       a5 10		      lda	ticks
     59  3425		       8d eb c5 	      sta	clkAtL
     60  3428		       a5 11		      lda	ticks+1
