    138  51ba		       00 01 00 00*dmcPrioT   .byte.b	0,1,0,0,0,2,3	; kick, snare, -, -, -, tom, perc
    139  51c1		       00 03 00 00*kitOfs     .byte.b	0,3,0,0,0,6,9
    140  51c8
    141  51c8							; mS = control change on MidiNES channel nesBase + A
