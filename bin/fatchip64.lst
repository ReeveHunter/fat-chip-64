    123  7e31		       bd c4 c4 	      lda	nesGlL,x
    124  7e34		       1d cd c4 	      ora	nesGlH,x
    125  7e37		       1d f1 c4 	      ora	nesBent,x
    126  7e3a		       1d 79 c9 	      ora	nesRd,x
    127  7e3d		       d0 02		      bne	.t
    128  7e3f		       a2 02		      ldx	#2
    129  7e41				   .t
    130  7e41		       8e 2a c5 	      stx	nfxV
    131  7e44		       86 24		      stx	t0
    132  7e46		       bd 97 c3 	      lda	vOut,x
    133  7e49		       c9 ff		      cmp	#NO_NOTE
    134  7e4b		       f0 20		      beq	.x
    135  7e4d		       20 d0 7f 	      jsr	NesFxVal
    136  7e50		       a6 24		      ldx	t0
    137  7e52		       ad 33 c5 	      lda	nfxL
    138  7e55		       dd df c4 	      cmp	nesFxSL,x
    139  7e58		       d0 08		      bne	.send
    140  7e5a		       ad 34 c5 	      lda	nfxH
    141  7e5d		       dd e8 c4 	      cmp	nesFxSH,x
    142  7e60		       f0 0b		      beq	.x
    143  7e62				   .send
    144  7e62		       a9 01		      lda	#1
    145  7e64		       8d 2b c5 	      sta	nfxHave	; (NesBendVoice: nfx is this voice's already)
    146  7e67		       bd 97 c3 	      lda	vOut,x
    147  7e6a		       4c e1 34 	      jmp	NesBendVoice
    148  7e6d				   .x
    149  7e6d		       60		      rts
