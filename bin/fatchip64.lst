    356  35ef							; ------------------------------------------------------------ SysEx: a patch from Chip Lab (v0.20)
    357  35ef							; (v0.23: F0 7D 46 43 02 m F7 sets the chips on / off: DevicesReceived)
    358  35ef							; F0 7D 46 43 01 PATCH_SIZE, then the patch (PATCH_SIZE bytes, the live patch's layout:
    359  35ef							; tools/gen_patches.py) as two 4-bit halves each, high first, then F7. It
    360  35ef							; arrives in sxBuf; only a complete one goes into the live patch, which then
    361  35ef							; sounds at once (like choosing a sound). Anything else is ignored.
    362  35ef		       00 05	   SX_HEAD    equ	5
    363  35ef		       00 cf	   SX_LEN     equ	SX_HEAD + PATCH_SIZE * 2
    364  35ef
    365  35ef							; A status byte in A (F0-F7); keeps A
    366  35ef				   SysexStatus
    367  35ef					      subroutine
    368  35ef		       c9 f0		      cmp	#$F0
    369  35f1		       d0 0e		      bne	.end
    370  35f3		       a2 01		      ldx	#1
    371  35f5		       8e 4c c7 	      stx	sxOn
    372  35f8		       8e 1c c8 	      stx	sxCmd
    373  35fb		       a2 00		      ldx	#0
    374  35fd		       8e 4d c7 	      stx	sxPos
    375  3600		       60		      rts
    376  3601				   .end
    377  3601		       ae 4c c7 	      ldx	sxOn
    378  3604		       f0 1c		      beq	.x
    379  3606		       a2 00		      ldx	#0
    380  3608		       8e 4c c7 	      stx	sxOn
    381  360b		       c9 f7		      cmp	#$F7
    382  360d		       d0 13		      bne	.x
    383  360f		       ae 1c c8 	      ldx	sxCmd
    384  3612		       e0 02		      cpx	#2
    385  3614		       f0 0d		      beq	.dev
    386  3616		       ae 4d c7 	      ldx	sxPos
    387  3619		       e0 cf		      cpx	#SX_LEN
    388  361b		       d0 05		      bne	.x
    389  361d		       48		      pha
    390  361e		       20 b4 36 	      jsr	PatchReceived
    391  3621		       68		      pla
    392  3622				   .x
    393  3622		       60		      rts
    394  3623				   .dev
    395  3623		       ae 4d c7 	      ldx	sxPos
    396  3626		       e0 05		      cpx	#5
    397  3628		       d0 f8		      bne	.x
    398  362a		       48		      pha
