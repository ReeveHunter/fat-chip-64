------- FILE main.asm LEVEL 1 PASS 3
      1  b8c0 ????						; Fat Chip 64 - main program
      2  b8c0 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  b8c0 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  b8c0 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  b8c0 ????
      6  b8c0 ????				      processor	6502
