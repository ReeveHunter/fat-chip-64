------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  517a					      include	"sync.asm"
      1  517a							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  517a							;
      3  517a							; Menu, DEVICE SYNC (defaults first):
      4  517a							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  517a							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  517a							;		     sets the tempo, averaged over beats (the clock jitters about
      7  517a							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  517a							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  517a							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  517a							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  517a							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  517a							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  517a							;		     picks a beat demo (styleBeat)
     14  517a							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  517a							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  517a							;		     key channel) picks a sound (voiceSound)
     17  517a							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  517a							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  517a							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  517a							;
     21  517a							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  517a							; 1/4 ms); a Start makes the next clock a beat.
     23  517a
     24  517a		       00 00	   TEMPO_KEYTAR equ	0
     25  517a		       00 01	   TEMPO_OWN  equ	1
     26  517a		       00 02	   TEMPO_SC   equ	2
     27  517a		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  517a
     29  517a
     30  517a
     31  517a							; ------------------------------------------------------------ clock
     32  517a							; Main loop, every pass
