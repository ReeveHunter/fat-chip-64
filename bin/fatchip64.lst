------- FILE screen.asm LEVEL 2 PASS 3
      0  726a					      include	"screen.asm"
      1  726a							; Fat Chip 64 - screen
      2  726a							;
      3  726a							;  row 0      header
      4  726a							;  row 2      sound, POLY / MONO, Fat Bass
      5  726a							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  726a							;	       each plays (row 7: a channel overlap warning)
      7  726a							;  row 9      key, notes mode, latch
      8  726a							;  row 10     arp
      9  726a							;  row 12     tempo, beat, mute
     10  726a							;  row 13     SPACE's action, octave (the lowest key), transpose
     11  726a							;  row 14     v0.40: the effect the C= keys work on, its setting
     12  726a							;  row 15     held notes
     13  726a							;  row 16     MIDI in
     14  726a							;  row 24     F keys
     15  726a
     16  726a							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     17  726a							; Letters become screen codes; bit 7 of t2 reverses.
