      0  0ba0					      include	"midi.asm"
      1  0ba0							; Fat Chip 64 - MIDI out
      2  0ba0							;
      3  0ba0							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0ba0							; at most one message per device onto the wire buffer, no sooner than that
      5  0ba0							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0ba0							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0ba0							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0ba0							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0ba0							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0ba0
     11  0ba0				   MidiInit
     12  0ba0					      subroutine
     13  0ba0		       a9 03		      lda	#ACIA_RESET
     14  0ba2		       8d 04 de 	      sta	ACIA_CTRL
     15  0ba5		       a9 16		      lda	#ACIA_MODE
     16  0ba7		       8d 04 de 	      sta	ACIA_CTRL
     17  0baa							; (fall into the test)
     18  0baa
     19  0baa							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0baa							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0baa							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0baa							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0baa							; before. Interrupts are off when this is called.
     24  0baa				   MidiIrqTest
     25  0baa					      subroutine
     26  0baa		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0bac		       8d 0d dc 	      sta	CIA1_ICR
     28  0baf		       ad 0d dc 	      lda	CIA1_ICR
     29  0bb2		       a9 fa		      lda	#<IrqTest
     30  0bb4		       8d fe ff 	      sta	$FFFE
     31  0bb7		       a9 0b		      lda	#>IrqTest
     32  0bb9		       8d ff ff 	      sta	$FFFF
     33  0bbc		       a9 00		      lda	#0
     34  0bbe		       85 2f		      sta	midiIrq
     35  0bc0		       a9 b6		      lda	#ACIA_MODE_TX
     36  0bc2		       8d 04 de 	      sta	ACIA_CTRL
     37  0bc5		       58		      cli
     38  0bc6		       a2 00		      ldx	#0
     39  0bc8				   .w
     40  0bc8		       ca		      dex
     41  0bc9		       d0 fd		      bne	.w
     42  0bcb		       78		      sei
     43  0bcc		       a6 2f		      ldx	midiIrq
     44  0bce		       bd 06 0c 	      lda	midiCtl,x
     45  0bd1		       8d 04 de 	      sta	ACIA_CTRL
     46  0bd4		       bd 08 0c 	      lda	irqLo,x
     47  0bd7		       8d fe ff 	      sta	$FFFE
     48  0bda		       bd 0a 0c 	      lda	irqHi,x
     49  0bdd		       8d ff ff 	      sta	$FFFF
     50  0be0		       bd 0c 0c 	      lda	latchLo,x
     51  0be3		       8d 04 dc 	      sta	CIA1_TALO
     52  0be6		       bd 0e 0c 	      lda	latchHi,x
     53  0be9		       8d 05 dc 	      sta	CIA1_TAHI
     54  0bec		       a9 11		      lda	#$11	; start, force load, continuous
     55  0bee		       8d 0e dc 	      sta	CIA1_CRA
     56  0bf1		       ad 0d dc 	      lda	CIA1_ICR
     57  0bf4		       a9 81		      lda	#$81	; timer A interrupt on
     58  0bf6		       8d 0d dc 	      sta	CIA1_ICR
