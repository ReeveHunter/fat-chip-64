------- FILE drums.asm LEVEL 2 PASS 3
      0  507d					      include	"drums.asm"
      1  507d							; Fat Chip 64 - drums on the MidiNES
      2  507d							;
      3  507d							; Two sources, one kit:
      4  507d							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  507d							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  507d							;			   64 = hit, 56 = ghost)
      7  507d							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  507d							;			   RETURN starts / stops it, at its own tempo (B taps
      9  507d							;			   a new one)
     10  507d							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  507d							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  507d							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  507d							; a note-on, then a note-off after the sound's length, the level set with
     14  507d							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  507d							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  507d
     17  507d		       00 0c	   KIT_SIZE   equ	12
     18  507d		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  507d		       00 00	   DK_KICK    equ	0
     20  507d		       00 01	   DK_SNARE   equ	1
     21  507d		       00 02	   DK_CH      equ	2
     22  507d		       00 03	   DK_OH      equ	3
     23  507d		       00 04	   DK_CY      equ	4
     24  507d		       00 05	   DK_TOM     equ	5
     25  507d		       00 06	   DK_PERC    equ	6
     26  507d
     27  507d							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
