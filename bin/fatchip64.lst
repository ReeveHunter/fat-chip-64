------- FILE main.asm LEVEL 1 PASS 3
      1  8528 ????						; Fat Chip 64 - main program
      2  8528 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  8528 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  8528 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  8528 ????
      6  8528 ????				      processor	6502
