     47  d799 ????	       00 01	   NES_GAP    equ	1	; ms between messages to the MidiNES (wire-limited)
     48  d799 ????	       01 5e	   DOUBLE_TAP equ	350	; ms: second RESTORE press within this = double tap
     49  d799 ????	       00 28	   RESTORE_DEBOUNCE equ	40	; ms
