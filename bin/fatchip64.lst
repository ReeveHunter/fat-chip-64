     33  0b36		       a9 00		      lda	#0
     34  0b38		       85 2f		      sta	midiIrq
     35  0b3a		       a9 b6		      lda	#ACIA_MODE_TX
     36  0b3c		       8d 04 de 	      sta	ACIA_CTRL
