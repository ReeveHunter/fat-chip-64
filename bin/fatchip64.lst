------- FILE main.asm
------- FILE viz.asm LEVEL 2 PASS 3
      0  622f					      include	"viz.asm"
      1  622f							; Fat Chip 64 - the visualizers (F7: BARS, GLITCH, back to play), demos
      2  622f							;
      3  622f							; BARS:
      4  622f							; Nine bars, one per voice, in three groups: SID, Game Boy, MidiNES. A new
      5  622f							; note throws its bar to the top; it falls back to a height set by the
      6  622f							; note's pitch (higher notes stand taller) while the note sounds, and to
      7  622f							; nothing when it stops. The tremolo makes the bars breathe. Each bar takes
      8  622f							; the colour of its note's pitch class (C red ... B white). Kick drums flash
      9  622f							; the border in the key's colour; row 24 has the sound, the tempo and, while
     10  622f							; a beat plays, which beat of the bar it's on.
     11  622f							;
     12  622f							; One bar is drawn per screen step (about every 8 ms), so the screen stays
     13  622f							; out of the way of the keyboard and the arp: about 13 frames a second.
     14  622f							;
     15  622f							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
     16  622f							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
     17  622f							; keep spattering more; runs of the screen get copied over other places
     18  622f							; (datamosh) and wiped away, so it fills while you play and dissolves when
     19  622f							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
     20  622f							; the background. VINYL STOP drags it down the screen.
     21  622f
     22  622f		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     23  622f		       00 16	   VIZ_NAMES  equ	22	; note names
     24  622f		       00 a0	   VIZ_FULL   equ	160	; reversed space
     25  622f		       00 62	   VIZ_HALF   equ	98	; lower half block
     26  622f
