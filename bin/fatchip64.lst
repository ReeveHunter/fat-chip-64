------- FILE midiin.asm LEVEL 2 PASS 3
      0  3a4e					      include	"midiin.asm"
      1  3a4e							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  3a4e							;
      3  3a4e							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  3a4e							; The main loop parses them (running status; realtime and system bytes are
      5  3a4e							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  3a4e							; notes mode, latch, arp and K + note.
      7  3a4e							;
      8  3a4e							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  3a4e							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  3a4e							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  3a4e							;
     12  3a4e							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  3a4e							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  3a4e							;
     15  3a4e							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  3a4e							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  3a4e							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  3a4e							; MIDI in is passed on to the Game Boy or NES.
     19  3a4e
     20  3a4e							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  3a4e							; Uses A, X.
     22  3a4e							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  3a4e							; with the time; a Start ($FA) makes the next clock a beat.
     24  3a4e				   RxByte
     25  3a4e					      subroutine
     26  3a4e		       ad 06 de 	      lda	ACIA_STAT
     27  3a51		       4a		      lsr		; RDRF -> carry
     28  3a52		       90 2b		      bcc	.x
     29  3a54				   RxGot
     30  3a54		       ad 07 de 	      lda	ACIA_RX
     31  3a57		       c9 f8		      cmp	#$F8
     32  3a59		       f0 25		      beq	.clk
     33  3a5b		       c9 fa		      cmp	#$FA
     34  3a5d		       d0 0e		      bne	.buf
     35  3a5f		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  3a61		       8e f5 c9 	      stx	clkPhase
     37  3a64		       8e fd c9 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3a67							;  the main loop could measure it)
     39  3a67		       ae f6 c9 	      ldx	clkBeat
     40  3a6a		       8e 08 ca 	      stx	clkStartBeat
     41  3a6d				   .buf
     42  3a6d		       ae 31 c8 	      ldx	rxHead
     43  3a70		       9d f1 c7 	      sta	rxBuf,x
     44  3a73		       e8		      inx
     45  3a74		       8a		      txa
     46  3a75		       29 3f		      and	#63
     47  3a77		       cd 32 c8 	      cmp	rxTail
     48  3a7a		       f0 03		      beq	.x	; full: dropped
     49  3a7c		       8d 31 c8 	      sta	rxHead
     50  3a7f				   .x
     51  3a7f		       60		      rts
     52  3a80				   .clk
     53  3a80		       ee f1 c9 	      inc	clkCount
     54  3a83		       ae f5 c9 	      ldx	clkPhase
     55  3a86		       e8		      inx
     56  3a87		       e0 18		      cpx	#24
     57  3a89		       90 1b		      bcc	.ph
     58  3a8b		       a5 10		      lda	ticks
     59  3a8d		       8d f8 c9 	      sta	clkAtL
     60  3a90		       a5 11		      lda	ticks+1
     61  3a92		       8d f9 c9 	      sta	clkAtH
     62  3a95		       a5 2d		      lda	subTick
     63  3a97		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  3a99		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  3a9b		       ad 05 dc 	      lda	CIA1_TAHI
     66  3a9e				   .q
     67  3a9e		       8d fa c9 	      sta	clkAtS
     68  3aa1		       ee f6 c9 	      inc	clkBeat
     69  3aa4		       a2 00		      ldx	#0
     70  3aa6				   .ph
     71  3aa6		       8e f5 c9 	      stx	clkPhase
     72  3aa9		       60		      rts
