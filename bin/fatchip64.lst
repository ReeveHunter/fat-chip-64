    142  0b25							; Boy off), and counts it.
    143  0b25				   LinkRoom
    144  0b25					      subroutine
    145  0b25		       ad 26 c3 	      lda	devOn+DEV_GB
    146  0b28		       f0 0a		      beq	.yes
