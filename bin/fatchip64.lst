    151  7e6e							; voice X's glide offset closer to 0: by off / 2^glideK for each 4 ms step
    152  7e6e							; (worked out once: d = off >> k, off -= d x n; past 0 or nothing left to
    153  7e6e							; move by: there). Keeps X.
    154  7e6e				   NesGlideStep
    155  7e6e					      subroutine
    156  7e6e		       bd c4 c4 	      lda	nesGlL,x
    157  7e71		       1d cd c4 	      ora	nesGlH,x
    158  7e74		       d0 01		      bne	.go
    159  7e76		       60		      rts
    160  7e77				   .go
    161  7e77		       bd 70 c9 	      lda	nesK,x
    162  7e7a		       c9 ff		      cmp	#$FF	; (v0.41: BEND IN STEP: held for TIME, then the note)
    163  7e7c		       d0 0c		      bne	.slide
    164  7e7e		       bd d6 c4 	      lda	nesVT,x
    165  7e81		       cd 94 c6 	      cmp	sndStepT
    166  7e84		       b0 01		      bcs	.jump
    167  7e86		       60		      rts
    168  7e87				   .jump
    169  7e87		       4c 15 7f 	      jmp	.snap
    170  7e8a				   .slide
