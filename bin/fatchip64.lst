    333  33a6							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    334  33a6							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    335  33a6							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    336  33a6							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    337  33a6		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    338  33aa		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    339  33b1		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    340  33b8		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    341  33bd		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    342  33c1		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    343  33c5		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
