      0  478d					      include	"menu.asm"
      1  478d							; Fat Chip 64 - the menu (v0.14): RETURN in, SHIFT+RETURN back out
      2  478d							;
      3  478d							; Three pages: the main one (SOUND, PLAYING), ADVANCED SOUND and DEVICE SYNC
      4  478d							; (RETURN on their lines opens them, SHIFT+RETURN comes back).
      5  478d							; CRSR DOWN / SHIFT+CRSR DOWN (up): choose a setting. CRSR RIGHT / SHIFT+CRSR
      6  478d							; RIGHT: its next / previous value. Every other key works as usual (notes
      7  478d							; play; V, F keys, = ... too: the values here follow).
      8  478d							; The play screen pauses while the menu is up and redraws when it closes.
      9  478d
