    105  2720		       29 e0		      and	#$E0
    106  2722		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
    107  2724		       d0 bc		      bne	.next
    108  2726		       a9 00		      lda	#0
    109  2728		       8d 28 c4 	      sta	rxCnt
    110  272b		       20 53 27 	      jsr	MidiInMsg
    111  272e		       4c e2 26 	      jmp	.next
    112  2731				   .rt
