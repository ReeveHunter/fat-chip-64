------- FILE lead.asm LEVEL 2 PASS 3
      0  602c					      include	"lead.asm"
      1  602c							; Fat Chip 64 - CHORD + LEAD (v0.28): a chord and a lead at once, each its
      2  602c							; own patch.
      3  602c							;   LOW NOTE  the first key pressed is the chord's root (POLY: root and
      4  602c							;	       fifth; SMART CHORD / EXT / DRONE: their chord); every other key
      5  602c							;	       is the lead, while the chord key is held
      6  602c							;   LATCH 3   three keys pressed together latch as the chord (let go, it
      7  602c							;	       keeps sounding); everything else is the lead. L clears it.
      8  602c							; The lead is one note (the last key pressed) on one voice per chip (SID 3,
      9  602c							; Game Boy pulse 1, NES pulse 1), only while it plays: the rest of the time
     10  602c							; those voices are the chord's. Its patch: SHIFT + A S D F G / Z X C V B.
     11  602c							; The lead's own: the SID's waveform, width, envelope and octave, the Game
     12  602c							; Boy pulse's CCs, the NES pulse's duty. Shared with the chord: the effects
     13  602c							; (vibrato, filter, tremolo...), the NES envelope.
     14  602c
     15  602c		       00 06	   LEAD_SID   equ	6	; the lead's voices: SID 3, GB pulse 1, NES pulse 1
     16  602c		       00 01	   LEAD_GB    equ	1
     17  602c		       00 02	   LEAD_NES   equ	2
     18  602c
     19  602c							; NoteDown, CHORD + LEAD on: key X pressed. Carry set: it's the lead (the
     20  602c							; latch styles leave it alone).
