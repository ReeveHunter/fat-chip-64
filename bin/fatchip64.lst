------- FILE sync.asm LEVEL 2 PASS 3
      0  5508					      include	"sync.asm"
      1  5508							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  5508							;
      3  5508							; Menu, DEVICE SYNC (defaults first):
      4  5508							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  5508							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  5508							;		     sets the tempo, averaged over beats (the clock jitters about
      7  5508							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  5508							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  5508							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  5508							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  5508							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  5508							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  5508							;		     picks a beat demo (styleBeat)
     14  5508							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  5508							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  5508							;		     key channel) picks a sound (voiceSound)
     17  5508							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  5508							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  5508							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  5508							;
     21  5508							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  5508							; 1/4 ms); a Start makes the next clock a beat.
     23  5508
     24  5508		       00 00	   TEMPO_KEYTAR equ	0
     25  5508		       00 01	   TEMPO_OWN  equ	1
     26  5508		       00 02	   TEMPO_SC   equ	2
     27  5508		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  5508
     29  5508
     30  5508
     31  5508							; ------------------------------------------------------------ clock
     32  5508							; Main loop, every pass
