    196  0aae							; ------------------------------------------------------------ queueing (main loop)
    197  0aae							; Message in mS / mD1 / mD2. Dropped if the queue is full (63 messages).
    198  0aae				   GbPut
    199  0aae					      subroutine
    200  0aae							; write the slot at head first (always free: one slot stays empty),
    201  0aae							; then publish head unless the queue is full. Uses only A and X.
    202  0aae		       a6 16		      ldx	gbqHead
    203  0ab0		       a5 20		      lda	mS
    204  0ab2		       9d 00 c1 	      sta	gbqS,x
    205  0ab5		       a5 21		      lda	mD1
    206  0ab7		       9d 40 c1 	      sta	gbqD1,x
    207  0aba		       a5 22		      lda	mD2
    208  0abc		       9d 80 c1 	      sta	gbqD2,x
    209  0abf		       8a		      txa
