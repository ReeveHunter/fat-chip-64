     42  0971
     43  0971							; IRQ: pace device queues onto the wire.
     44  0971							;
     45  0971							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
     46  0971							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
     47  0971							; times as signed numbers, so after 33 s of silence every queue froze for
     48  0971							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
     49  0971							;
     50  0971							; When the Game Boy is on, everything on the wire also passes through the
     51  0971							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
     52  0971							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
     53  0971							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
     54  0971							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
     55  0971							; message, the rate measured clean.
     56  0971				   Schedule
     57  0971					      subroutine
     58  0971		       ad 06 c3 	      lda	devOn+DEV_GB
     59  0974		       f0 10		      beq	.gb
     60  0976		       a5 2d		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
     61  0978		       f0 0c		      beq	.gb
     62  097a		       c6 2d		      dec	linkLoad
     63  097c		       f0 08		      beq	.gb
     64  097e		       a5 10		      lda	ticks
     65  0980		       29 01		      and	#1
     66  0982		       f0 02		      beq	.gb
     67  0984		       c6 2d		      dec	linkLoad
     68  0986				   .gb
     69  0986							; ---- Game Boy
     70  0986		       a5 17		      lda	gbqTail
     71  0988		       c5 16		      cmp	gbqHead
     72  098a		       f0 36		      beq	.nes
     73  098c		       a5 18		      lda	gbNext
     74  098e		       38		      sec
     75  098f		       e5 10		      sbc	ticks
     76  0991		       f0 04		      beq	.gbDue
     77  0993		       c9 04		      cmp	#GB_GAP+1
     78  0995		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
     79  0997				   .gbDue
     80  0997							; only onto an empty wire, so the gap holds on the cable itself (NES
     81  0997							; bytes already waiting would otherwise delay this one and squeeze it
     82  0997							; against the next)
     83  0997		       a5 14		      lda	wireHead
     84  0999		       c5 15		      cmp	wireTail
     85  099b		       d0 25		      bne	.nes
     86  099d		       20 00 0a 	      jsr	LinkRoom
     87  09a0		       90 20		      bcc	.nes
     88  09a2		       a6 17		      ldx	gbqTail
     89  09a4		       bd 00 c1 	      lda	gbqS,x
     90  09a7		       bc 80 c1 	      ldy	gbqD2,x
     91  09aa		       84 2b		      sty	irqT
     92  09ac		       bc 40 c1 	      ldy	gbqD1,x
     93  09af		       20 1c 0a 	      jsr	WireMsg
     94  09b2		       a5 17		      lda	gbqTail
     95  09b4		       18		      clc
     96  09b5		       69 01		      adc	#1
     97  09b7		       29 3f		      and	#63
     98  09b9		       85 17		      sta	gbqTail
     99  09bb		       a5 10		      lda	ticks
    100  09bd		       18		      clc
    101  09be		       69 03		      adc	#GB_GAP
    102  09c0		       85 18		      sta	gbNext
    103  09c2				   .nes
    104  09c2		       a5 1a		      lda	nesqTail
    105  09c4		       c5 19		      cmp	nesqHead
    106  09c6		       f0 37		      beq	.done
    107  09c8		       a5 1b		      lda	nesNext
    108  09ca		       38		      sec
    109  09cb		       e5 10		      sbc	ticks
    110  09cd		       f0 04		      beq	.nesDue
    111  09cf		       c9 02		      cmp	#NES_GAP+1
    112  09d1		       90 2c		      bcc	.done
    113  09d3				   .nesDue
    114  09d3		       20 13 0a 	      jsr	WireFree
    115  09d6		       c9 03		      cmp	#3
    116  09d8		       90 25		      bcc	.done
    117  09da		       20 00 0a 	      jsr	LinkRoom
    118  09dd		       90 20		      bcc	.done
    119  09df		       a6 1a		      ldx	nesqTail
    120  09e1		       bd c0 c1 	      lda	nesqS,x
    121  09e4		       bc 40 c2 	      ldy	nesqD2,x
    122  09e7		       84 2b		      sty	irqT
    123  09e9		       bc 00 c2 	      ldy	nesqD1,x
    124  09ec		       20 1c 0a 	      jsr	WireMsg
    125  09ef		       a5 1a		      lda	nesqTail
    126  09f1		       18		      clc
    127  09f2		       69 01		      adc	#1
    128  09f4		       29 3f		      and	#63
    129  09f6		       85 1a		      sta	nesqTail
    130  09f8		       a5 10		      lda	ticks
    131  09fa		       18		      clc
    132  09fb		       69 01		      adc	#NES_GAP
    133  09fd		       85 1b		      sta	nesNext
    134  09ff				   .done
    135  09ff		       60		      rts
