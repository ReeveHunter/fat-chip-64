     89  40f7		       85 25		      sta	t1
     90  40f9							; bank (CC14 on the sample channel) when it changes
     91  40f9		       a9 04		      lda	#4
     92  40fb		       20 53 41 	      jsr	NesChStatus	; mS = CC, sample channel
     93  40fe		       a9 00		      lda	#0
     94  4100		       a6 25		      ldx	t1
