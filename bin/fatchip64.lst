------- FILE nesenv.asm LEVEL 2 PASS 3
      0  1f8d					      include	"nesenv.asm"
      1  1f8d							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  1f8d							;
      3  1f8d							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  1f8d							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  1f8d							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  1f8d							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  1f8d							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  1f8d							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  1f8d							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  1f8d							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  1f8d							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  1f8d							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  1f8d							; would wrap to a high pitch).
     14  1f8d							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  1f8d
     16  1f8d							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  1f8d							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  1f8d							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  1f8d							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  1f8d							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  1f8d		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  1f8d		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  1f8d							; NES channels too, and can't take a bend every 4 ms
     24  1f8d		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  1f8d		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  1f8d
     27  1f8d							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  1f8d		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  1f96		       02 05	   slotVoice  .byte.b	2,5
     30  1f98
     31  1f98							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  1f98							; note keeps sounding for now). X = voice (= t0).
     33  1f98				   NesSoftRelease
     34  1f98					      subroutine
     35  1f98		       4c 9d 1f 	      jmp	.go
     36  1f9b				   .nope
     37  1f9b		       18		      clc
     38  1f9c		       60		      rts
     39  1f9d				   .go
     40  1f9d		       ad 47 c4 	      lda	nesEnvOn
     41  1fa0		       f0 f9		      beq	.nope
     42  1fa2		       ad 90 c3 	      lda	muteNow
     43  1fa5		       0d cb c3 	      ora	hardCut
     44  1fa8		       d0 f1		      bne	.nope
     45  1faa		       ad 27 c3 	      lda	devOn+DEV_NES
     46  1fad		       f0 ec		      beq	.nope
     47  1faf		       bd ce 6a 	      lda	vDev,x
     48  1fb2		       c9 02		      cmp	#DEV_NES
     49  1fb4		       d0 7c		      bne	.no
     50  1fb6		       bd 97 c3 	      lda	vOut,x
     51  1fb9		       c9 ff		      cmp	#NO_NOTE
     52  1fbb		       f0 75		      beq	.no
     53  1fbd		       bc 8d 1f 	      ldy	vEnvSlot,x
     54  1fc0		       30 3e		      bmi	.tri
     55  1fc2							; pulse: release from the current level; step = level x factor / 4 + 1
     56  1fc2							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  1fc2							; about 2 s). Factor 0: no release, cut.
     58  1fc2		       ad 6a c4 	      lda	envRelV
     59  1fc5		       f0 6b		      beq	.no
     60  1fc7		       86 26		      stx	t2
     61  1fc9		       84 27		      sty	t3
     62  1fcb		       b9 bd c3 	      lda	envLvH,y
