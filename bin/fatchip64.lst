    112  24ec		       d0 06		      bne	.rt2
    113  24ee		       20 e7 35 	      jsr	KeytarStart
    114  24f1		       4c 9b 24 	      jmp	.next
    115  24f4				   .rt2
    116  24f4		       c9 fc		      cmp	#$FC
    117  24f6		       d0 03		      bne	.rt3
    118  24f8		       20 08 36 	      jsr	KeytarStop
    119  24fb				   .rt3
    120  24fb		       4c 9b 24 	      jmp	.next
    121  24fe				   .second
    122  24fe		       8d 2a c4 	      sta	rxD2
    123  2501		       a9 00		      lda	#0
    124  2503		       8d 28 c4 	      sta	rxCnt
    125  2506		       20 0c 25 	      jsr	MidiInMsg
    126  2509		       4c 9b 24 	      jmp	.next
