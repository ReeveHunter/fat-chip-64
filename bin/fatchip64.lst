    111  391c				   .nosx
    112  391c		       ae 2b c4 	      ldx	rxStatus
    113  391f		       f0 bb		      beq	.next	; no status yet
    114  3921		       ae 2c c4 	      ldx	rxCnt
    115  3924		       d0 2e		      bne	.second
    116  3926		       8d 2d c4 	      sta	rxD1
    117  3929		       ee 2c c4 	      inc	rxCnt
    118  392c		       ad 2b c4 	      lda	rxStatus
    119  392f		       29 e0		      and	#$E0
    120  3931		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
    121  3933		       d0 a7		      bne	.next
    122  3935		       a9 00		      lda	#0
    123  3937		       8d 2c c4 	      sta	rxCnt
    124  393a		       20 62 39 	      jsr	MidiInMsg
    125  393d		       4c dc 38 	      jmp	.next
    126  3940				   .rt
    127  3940		       c9 fa		      cmp	#$FA
    128  3942		       d0 06		      bne	.rt2
    129  3944		       20 39 56 	      jsr	KeytarStart
    130  3947		       4c dc 38 	      jmp	.next
    131  394a				   .rt2
    132  394a		       c9 fc		      cmp	#$FC
    133  394c		       d0 03		      bne	.rt3
    134  394e		       20 5a 56 	      jsr	KeytarStop
    135  3951				   .rt3
    136  3951		       4c dc 38 	      jmp	.next
    137  3954				   .second
    138  3954		       8d 2e c4 	      sta	rxD2
    139  3957		       a9 00		      lda	#0
