------- FILE main.asm
------- FILE wander.asm LEVEL 2 PASS 3
      0  6091					      include	"wander.asm"
      1  6091							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  6091							;
      3  6091							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  6091							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  6091							;   ATTACK   as always: the new notes start
      6  6091							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  6091							;	      has none)
      8  6091							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  6091							;	      start again
     10  6091							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  6091							;	      late; some glide, some start again (fade out, come back in)
     12  6091							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  6091							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  6091							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  6091							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  6091
     17  6091		       00 01	   CHG_ATTACK equ	1
     18  6091		       00 02	   CHG_GLIDE  equ	2
     19  6091		       00 03	   CHG_STAGGER equ	3
     20  6091		       00 04	   CHG_WANDER equ	4
     21  6091		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  6091
     23  6091							; A = the chord change style now (keeps X, Y)
     24  6091				   ChgEff
     25  6091					      subroutine
     26  6091		       ad 58 c8 	      lda	chgMode
     27  6094		       d0 0c		      bne	.x
     28  6096		       ad aa c3 	      lda	effMode
     29  6099		       c9 02		      cmp	#MODE_DRONE
     30  609b		       d0 03		      bne	.a
     31  609d		       a9 04		      lda	#CHG_WANDER
     32  609f		       60		      rts
     33  60a0				   .a
     34  60a0		       a9 01		      lda	#CHG_ATTACK
     35  60a2				   .x
     36  60a2		       60		      rts
     37  60a3
     38  60a3							; ApplyVoices, voice X changes note: how. A = 0 (Z): change it now (t3,
     39  60a3							; legatoNow, vsGlide set); A = 1: not yet (WANDER). Keeps X.
     40  60a3				   ChgStyle
     41  60a3					      subroutine
     42  60a3		       bd 13 c3 	      lda	vNote,x
     43  60a6		       c9 ff		      cmp	#NO_NOTE
