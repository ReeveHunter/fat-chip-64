     39  d58a ????	       03 ff	   TICK_LATCH_MS equ	1023	; with the MIDI chip's interrupts (midiIrq): 1 ms
     40  d58a ????	       00 ff	   TICK_LATCH equ	255	; CIA1 timer A: 256 cycles = 1/4 ms (NTSC), quicker
     41  d58a ????						; than a MIDI byte (327 cycles), so the ACIA is fed
     42  d58a ????						; and read (MIDI in) even while the main loop is
