    139  0eed				   KeyCode
    140  0eed					      subroutine
    141  0eed		       ad 37 c3 	      lda	ksCol
    142  0ef0		       0a		      asl
    143  0ef1		       0a		      asl
    144  0ef2		       0a		      asl
