------- FILE main.asm
------- FILE devices.asm LEVEL 2 PASS 3
      0  65d5					      include	"devices.asm"
      1  65d5							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  65d5							; are in use, and each one in use gets its page on the main menu.
      3  65d5							;
      4  65d5							; YAMAHA SHS-10 (the keytar)
      5  65d5							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  65d5							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  65d5							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  65d5							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  65d5							;		     can play at once.)
     10  65d5							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  65d5							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  65d5							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  65d5							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  65d5							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  65d5							;		     louder (the SID and the NES; the Game Boy would click) or
     16  65d5							;		     brighter (the SID's filter: switched on if the patch has
     17  65d5							;		     none)
     18  65d5							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  65d5							;		     the patch's, or the ADVANCED amounts if it has none;
     20  65d5							;		     FILTER), or an action held while blowing hard
     21  65d5							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  65d5							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  65d5							;   PORTAMENTO BUTTON	an action (CC 65)
     24  65d5							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  65d5							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  65d5							; ATARI SYNTHCART
     27  65d5							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  65d5							;		     about 3% while held, SHIFT + , . step through the ten
     29  65d5							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  65d5							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  65d5							;		     sound's cents (the Synthcart manual's table: each Atari
     32  65d5							;		     sound plays its scales in its own key, a little off)
     33  65d5							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  65d5
     35  65d5		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  65d5		       00 28	   BREATH_LO  equ	40
     37  65d5		       00 01	   BFX_VIB    equ	1
     38  65d5		       00 02	   BFX_WARB   equ	2
     39  65d5		       00 03	   BFX_DET    equ	3
     40  65d5		       00 04	   BFX_FILT   equ	4
     41  65d5		       00 05	   BFX_HELD   equ	5
     42  65d5
