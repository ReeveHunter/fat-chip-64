    125  0b58		       bc 40 c2 	      ldy	nesqD2,x
    126  0b5b		       84 2c		      sty	irqT
    127  0b5d		       bc 00 c2 	      ldy	nesqD1,x
    128  0b60		       20 90 0b 	      jsr	WireMsg
