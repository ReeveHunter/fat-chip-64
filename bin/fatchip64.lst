      3  0cd5							; Scan the whole matrix, turn changes into key events.
      4  0cd5							;
      5  0cd5							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0cd5							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0cd5							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0cd5							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0cd5							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0cd5							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0cd5							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0cd5							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0cd5							; chords whose ghost lands on another used key lose their newest note.
     14  0cd5				   KeyScan
     15  0cd5					      subroutine
     16  0cd5		       a2 07		      ldx	#7
     17  0cd7				   .col
     18  0cd7		       bd d8 44 	      lda	colSelect,x
