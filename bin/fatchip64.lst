     42  0b3f		       78		      sei
     43  0b40		       a6 2f		      ldx	midiIrq
     44  0b42		       bd 7a 0b 	      lda	midiCtl,x
     45  0b45		       8d 04 de 	      sta	ACIA_CTRL
     46  0b48		       bd 7c 0b 	      lda	irqLo,x
     47  0b4b		       8d fe ff 	      sta	$FFFE
     48  0b4e		       bd 7e 0b 	      lda	irqHi,x
     49  0b51		       8d ff ff 	      sta	$FFFF
     50  0b54		       bd 80 0b 	      lda	latchLo,x
     51  0b57		       8d 04 dc 	      sta	CIA1_TALO
     52  0b5a		       bd 82 0b 	      lda	latchHi,x
     53  0b5d		       8d 05 dc 	      sta	CIA1_TAHI
     54  0b60		       a9 11		      lda	#$11	; start, force load, continuous
     55  0b62		       8d 0e dc 	      sta	CIA1_CRA
