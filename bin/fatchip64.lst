      0  0bb3					      include	"midi.asm"
      1  0bb3							; Fat Chip 64 - MIDI out
      2  0bb3							;
      3  0bb3							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0bb3							; at most one message per device onto the wire buffer, no sooner than that
      5  0bb3							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0bb3							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0bb3							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0bb3							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0bb3							; The wire uses running status, except that every Game Boy message carries its
     10  0bb3							; status byte (v0.64). The main loop and the IRQ both feed the ACIA.
     11  0bb3
     12  0bb3				   MidiInit
     13  0bb3					      subroutine
     14  0bb3		       a9 03		      lda	#ACIA_RESET
     15  0bb5		       8d 04 de 	      sta	ACIA_CTRL
     16  0bb8		       a9 16		      lda	#ACIA_MODE
     17  0bba		       8d 04 de 	      sta	ACIA_CTRL
     18  0bbd							; (fall into the test)
     19  0bbd
     20  0bbd							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     21  0bbd							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     22  0bbd							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     23  0bbd							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     24  0bbd							; before. Interrupts are off when this is called.
     25  0bbd				   MidiIrqTest
     26  0bbd					      subroutine
     27  0bbd		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     28  0bbf		       8d 0d dc 	      sta	CIA1_ICR
     29  0bc2		       ad 0d dc 	      lda	CIA1_ICR
     30  0bc5		       a9 0d		      lda	#<IrqTest
     31  0bc7		       8d fe ff 	      sta	$FFFE
     32  0bca		       a9 0c		      lda	#>IrqTest
     33  0bcc		       8d ff ff 	      sta	$FFFF
     34  0bcf		       a9 00		      lda	#0
     35  0bd1		       85 2f		      sta	midiIrq
     36  0bd3		       a9 b6		      lda	#ACIA_MODE_TX
     37  0bd5		       8d 04 de 	      sta	ACIA_CTRL
     38  0bd8		       58		      cli
     39  0bd9		       a2 00		      ldx	#0
     40  0bdb				   .w
     41  0bdb		       ca		      dex
