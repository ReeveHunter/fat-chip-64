    200  0cc0							; Carry set if the Teensyboy has room for a message (always, with the Game
    201  0cc0							; Boy off), and counts it.
    202  0cc0				   LinkRoom
    203  0cc0					      subroutine
    204  0cc0		       ad 26 c3 	      lda	devOn+DEV_GB
    205  0cc3		       f0 0a		      beq	.yes
    206  0cc5		       a5 2e		      lda	linkLoad
    207  0cc7		       c9 2d		      cmp	#LINK_MAX
    208  0cc9		       b0 06		      bcs	.no
    209  0ccb		       69 03		      adc	#3
    210  0ccd		       85 2e		      sta	linkLoad
    211  0ccf				   .yes
    212  0ccf		       38		      sec
    213  0cd0		       60		      rts
    214  0cd1				   .no
    215  0cd1		       18		      clc
    216  0cd2		       60		      rts
