    118  79ce							; VoiceSet, a SID voice let go (X = the voice, Y = SID voice): BEND OUT
    119  79ce				   RelDrop
    120  79ce					      subroutine
    121  79ce		       ad 64 cb 	      lda	sndRdrop
    122  79d1		       f0 26		      beq	.x
