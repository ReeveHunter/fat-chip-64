     51  0ee2		       4e 37 c3 	      lsr	ksBits
     52  0ee5		       90 17		      bcc	.rbn
     53  0ee7		       ae 38 c3 	      ldx	ksCol
     54  0eea		       ac 39 c3 	      ldy	ksRow
     55  0eed		       b9 aa 7d 	      lda	rowBit,y
     56  0ef0		       49 ff		      eor	#$FF
     57  0ef2		       3d 90 c2 	      and	keyAcc,x
     58  0ef5		       9d 90 c2 	      sta	keyAcc,x
     59  0ef8		       20 9e 0f 	      jsr	KeyCode
     60  0efb		       20 31 18 	      jsr	KeyUp
     61  0efe				   .rbn
     62  0efe		       ee 39 c3 	      inc	ksRow
     63  0f01		       d0 da		      bne	.rb
     64  0f03				   .rcn
     65  0f03		       ae 38 c3 	      ldx	ksCol
     66  0f06		       e8		      inx
     67  0f07		       e0 08		      cpx	#8
     68  0f09		       d0 bf		      bne	.rc
     69  0f0b							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0f0b							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0f0b							; still count as a combination.
     72  0f0b		       a9 00		      lda	#0
     73  0f0d		       8d 3b c3 	      sta	ksPass
     74  0f10				   .pass
     75  0f10		       a2 00		      ldx	#0
     76  0f12				   .pc
     77  0f12		       8e 38 c3 	      stx	ksCol
     78  0f15		       bd 90 c2 	      lda	keyAcc,x
     79  0f18		       49 ff		      eor	#$FF
