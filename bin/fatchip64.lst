------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 2
      0  24dd					      include	"sounds.asm"
      1  24dd							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  24dd							;
      3  24dd							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  24dd							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  24dd							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  24dd							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  24dd							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  24dd							;
      9  24dd							; Each sound has a mono default and a Fat Bass default:
     10  24dd							;   MONO      one note (the last key pressed and still held) on every voice;
     11  24dd							;	       a new key while another is held changes the pitch without a
     12  24dd							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  24dd							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  24dd							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  24dd							;	       the other voices
     16  24dd							;
     17  24dd							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  24dd							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  24dd							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  24dd
     21  24dd							; ------------------------------------------------------------ choosing
     22  24dd							; V: next sound (SHIFT+V: previous)
     23  24dd				   SoundKey
     24  24dd					      subroutine
     25  24dd		       20 15 25 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  24e0		       ae 95 c3 	      ldx	soundMode
     27  24e3		       ad 2a c3 	      lda	shiftDown
     28  24e6		       d0 09		      bne	.prev
     29  24e8		       e8		      inx
     30  24e9		       e0 11		      cpx	#NUM_SOUNDS
     31  24eb		       90 09		      bcc	.s
     32  24ed		       a2 00		      ldx	#0
     33  24ef		       f0 05		      beq	.s
     34  24f1				   .prev
     35  24f1		       ca		      dex
     36  24f2		       10 02		      bpl	.s
     37  24f4		       a2 10		      ldx	#NUM_SOUNDS-1
     38  24f6				   .s
     39  24f6		       8e 95 c3 	      stx	soundMode
     40  24f9		       20 4b 25 	      jsr	SoundVars
     41  24fc		       20 a3 25 	      jsr	SoundApply	; ...and come back with the new one
     42  24ff		       4c 26 10 	      jmp	Dirty
     43  2502
     44  2502							; C: POLY <-> MONO (each sound picks one when chosen; this overrides it)
     45  2502				   MonoKey
     46  2502					      subroutine
     47  2502		       ad 45 c4 	      lda	monoMode
     48  2505		       49 01		      eor	#1
     49  2507		       8d 45 c4 	      sta	monoMode
     50  250a		       20 02 27 	      jsr	GbLegato
     51  250d		       a9 01		      lda	#1
     52  250f		       8d 2b c3 	      sta	reallocFlag
     53  2512		       4c 26 10 	      jmp	Dirty
     54  2515
     55  2515							; Every Game Boy / NES voice lets go now (no soft releases), so nothing
     56  2515							; sounding depends on the old sound's octave or bass settings. The next
     57  2515							; voice update plays the held notes again.
     58  2515				   SoundRelease
     59  2515					      subroutine
     60  2515		       a9 01		      lda	#1
     61  2517		       8d cb c3 	      sta	hardCut
     62  251a		       a2 00		      ldx	#0
     63  251c				   .v
     64  251c		       86 24		      stx	t0
     65  251e		       bd 0d 37 	      lda	vDev,x
     66  2521		       f0 13		      beq	.n
     67  2523		       bd 97 c3 	      lda	vOut,x
     68  2526		       c9 ff		      cmp	#NO_NOTE
     69  2528		       f0 05		      beq	.n0
     70  252a		       a9 ff		      lda	#NO_NOTE
     71  252c		       20 2d 16 	      jsr	MidiTo
     72  252f				   .n0
     73  252f		       a6 24		      ldx	t0
     74  2531		       a9 ff		      lda	#NO_NOTE
     75  2533		       9d 13 c3 	      sta	vNote,x
     76  2536				   .n
     77  2536		       a6 24		      ldx	t0
     78  2538		       e8		      inx
     79  2539		       e0 09		      cpx	#NUM_VOICES
     80  253b		       d0 df		      bne	.v
     81  253d		       a9 00		      lda	#0
     82  253f		       8d cb c3 	      sta	hardCut
     83  2542		       20 f5 20 	      jsr	NesEnvReset
     84  2545		       a9 01		      lda	#1
     85  2547		       8d 2b c3 	      sta	reallocFlag
     86  254a		       60		      rts
     87  254b
     88  254b							; RAM copies of the sound's settings that the busy code reads
     89  254b				   SoundVars
     90  254b					      subroutine
     91  254b		       ae 95 c3 	      ldx	soundMode
     92  254e		       bd ee 3d 	      lda	sndMono,x
     93  2551		       8d 45 c4 	      sta	monoMode
     94  2554		       bd ff 3d 	      lda	sndFat,x
     95  2557		       8d 46 c4 	      sta	fatBass
