------- FILE main.asm LEVEL 1 PASS 2
      1  2b82 ????						; Fat Chip 64 - main program
      2  2b82 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  2b82 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  2b82 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  2b82 ????
      6  2b82 ????				      processor	6502
