      0  62e0					      include	"patchedit.asm"
      1  62e0							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  62e0							; the dice. The settings and their steps come from tools/gen_menu.py
      3  62e0							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  62e0							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  62e0							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  62e0							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  62e0							; (EnvDerive).
      8  62e0
