------- FILE main.asm
    553  ddf5				   ioEnd
    554  ddf5					      rend
    555  ddf5				  -	      if	ioEnd > $DE00
    556  ddf5				  -			; (Nmi reads the ACIA at $DE06: if one came while BeatLoad has the I/O
    557  ddf5				  -			;  switched out, it would read and write the RAM there: keep data below)
    558  ddf5				  -	      echo	"the $D000 data runs past $DE00"
    559  ddf5				  -	      err
    560  ddf5					      endif
