     49  2988		       c9 ff		      cmp	#NO_NOTE
     50  298a		       f0 e3		      beq	.nope
     51  298c		       ad 53 c4 	      lda	nesEnvOn
     52  298f		       f0 78		      beq	.fo	; (no envelope: BEND OUT's fall-off, if any)
     53  2991		       bc 61 29 	      ldy	vEnvSlot,x
     54  2994		       30 41		      bmi	.tri
     55  2996							; pulse: release from the current level; step = level x factor / 4 + 1
     56  2996							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  2996							; about 2 s). Factor 0: no release, cut.
