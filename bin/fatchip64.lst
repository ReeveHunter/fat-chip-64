      3  0ec5							; Scan the whole matrix, turn changes into key events.
      4  0ec5							;
      5  0ec5							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0ec5							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0ec5							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0ec5							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0ec5							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0ec5							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0ec5							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0ec5							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0ec5							; chords whose ghost lands on another used key lose their newest note.
     14  0ec5				   KeyScan
     15  0ec5					      subroutine
     16  0ec5		       a2 07		      ldx	#7
     17  0ec7				   .col
     18  0ec7		       bd 95 78 	      lda	colSelect,x
     19  0eca		       8d 00 dc 	      sta	CIA1_PRA
     20  0ecd		       ad 01 dc 	      lda	CIA1_PRB
     21  0ed0		       49 ff		      eor	#$FF
     22  0ed2		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0ed5		       9d 80 c2 	      sta	keyNow,x
     24  0ed8		       ca		      dex
     25  0ed9		       10 ec		      bpl	.col
     26  0edb		       a9 ff		      lda	#$FF
     27  0edd		       8d 00 dc 	      sta	CIA1_PRA
     28  0ee0							; ---- every column as accepted (nothing pressed or let go): done
     29  0ee0		       a2 07		      ldx	#7
     30  0ee2				   .same
     31  0ee2		       bd 80 c2 	      lda	keyNow,x
     32  0ee5		       dd 90 c2 	      cmp	keyAcc,x
     33  0ee8		       d0 04		      bne	.changed
     34  0eea		       ca		      dex
     35  0eeb		       10 f5		      bpl	.same
     36  0eed		       60		      rts
     37  0eee				   .changed
     38  0eee							; ---- releases first: accepted keys that are up now
     39  0eee		       a2 00		      ldx	#0
     40  0ef0				   .rc
     41  0ef0		       8e 38 c3 	      stx	ksCol
     42  0ef3		       bd 80 c2 	      lda	keyNow,x
     43  0ef6		       49 ff		      eor	#$FF
