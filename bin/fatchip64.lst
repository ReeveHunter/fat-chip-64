     69  14c8		       8d 18 d4 	      sta	SID_VOL
     70  14cb		       60		      rts
     71  14cc
     72  14cc							; M or SPACE changed: muteNow = mute xor momentary. The SID goes to volume 0;
     73  14cc							; the Game Boy and NES get note-offs (so nothing hangs on, and their tails
     74  14cc							; ring out naturally), and their notes come back when it unmutes.
     75  14cc				   MuteChanged
     76  14cc					      subroutine
     77  14cc		       ad 40 c4 	      lda	sidMute
