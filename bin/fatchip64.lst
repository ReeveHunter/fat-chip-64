------- FILE main.asm
------- FILE repeat.asm LEVEL 2 PASS 3
      0  4325					      include	"repeat.asm"
      1  4325							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  4325							;
      3  4325							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  4325							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  4325							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  4325							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  4325							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  4325							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  4325							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  4325							; 3/4 of the time between echoes. The SID doesn't echo.
     11  4325							;
     12  4325							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  4325							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  4325							; or a keytar button).
     15  4325							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  4325							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  4325
     18  4325		       00 10	   RP_SLOTS   equ	16
     19  4325		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  4325
     21  4325							; REPEAT is on now?
     22  4325				   RepeatActive
     23  4325		       ad 4b c5 	      lda	repeatOn
     24  4328		       0d ab c4 	      ora	actCnt+A_REPEAT
     25  432b		       60		      rts
     26  432c
     27  432c							; Allocate, after SPARKLE took its pair: the echo voices (vSkip keeps them
     28  432c							; out of the chord, vEcho marks them)
     29  432c				   RepeatSet
