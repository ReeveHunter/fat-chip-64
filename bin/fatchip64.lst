    450  367c		       19 cc c6 	      ora	sxBuf,y
    451  367f		       99 cc c6 	      sta	sxBuf,y
    452  3682		       ee 4d c7 	      inc	sxPos
    453  3685		       60		      rts
    454  3686				   .no
    455  3686		       a9 00		      lda	#0
    456  3688		       8d 4c c7 	      sta	sxOn
    457  368b		       60		      rts
    458  368c		       7d 46 43 01*sxHead     .byte.b	$7D, $46, $43, $01, PATCH_SIZE	; (the size: a Chip Lab with another layout is ignored)
