------- FILE sounds.asm LEVEL 2 PASS 3
      0  34c7					      include	"sounds.asm"
      1  34c7							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  34c7							;
      3  34c7							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  34c7							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  34c7							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  34c7							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  34c7							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  34c7							;
      9  34c7							; Each sound has a mono default and a Fat Bass default:
     10  34c7							;   MONO      one note (the last key pressed and still held) on every voice;
     11  34c7							;	       a new key while another is held changes the pitch without a
     12  34c7							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  34c7							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  34c7							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  34c7							;	       the other voices
     16  34c7							;
     17  34c7							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  34c7							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  34c7							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  34c7
     21  34c7							; ------------------------------------------------------------ choosing
     22  34c7							; V: next sound (SHIFT+V: previous)
