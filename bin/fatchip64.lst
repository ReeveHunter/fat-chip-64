     36  16c9		       ad 3e c3 	      lda	nowL
     37  16cc		       38		      sec
     38  16cd		       ed 43 c3 	      sbc	tapLast
     39  16d0		       85 24		      sta	t0
     40  16d2		       ad 3f c3 	      lda	nowH
     41  16d5		       ed 44 c3 	      sbc	tapLast+1
     42  16d8		       85 25		      sta	t1
     43  16da		       ad 3e c3 	      lda	nowL
