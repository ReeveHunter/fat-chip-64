    128  0dc9							; A = key code at ksCol / ksRow
    129  0dc9				   KeyCode
    130  0dc9					      subroutine
    131  0dc9		       ad 37 c3 	      lda	ksCol
    132  0dcc		       0a		      asl
    133  0dcd		       0a		      asl
    134  0dce		       0a		      asl
    135  0dcf		       0d 38 c3 	      ora	ksRow
    136  0dd2		       a8		      tay
    137  0dd3		       b9 e7 49 	      lda	keymap,y
    138  0dd6		       60		      rts
    139  0dd7
    140  0dd7							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    141  0dd7							; keys: some other column has a key in this row and shares another row with
    142  0dd7							; this column.
    143  0dd7				   Suspect
    144  0dd7					      subroutine
    145  0dd7		       ac 38 c3 	      ldy	ksRow
    146  0dda		       b9 df 49 	      lda	rowBit,y
    147  0ddd		       49 ff		      eor	#$FF
    148  0ddf		       ae 37 c3 	      ldx	ksCol
    149  0de2		       3d 80 c2 	      and	keyNow,x
    150  0de5		       8d 39 c3 	      sta	ksMask	; this column's other held rows
    151  0de8		       f0 1c		      beq	.no
    152  0dea		       a2 07		      ldx	#7
    153  0dec				   .c
    154  0dec		       ec 37 c3 	      cpx	ksCol
    155  0def		       f0 12		      beq	.n
    156  0df1		       bd 80 c2 	      lda	keyNow,x
    157  0df4		       39 df 49 	      and	rowBit,y
    158  0df7		       f0 0a		      beq	.n
    159  0df9		       bd 80 c2 	      lda	keyNow,x
    160  0dfc		       2d 39 c3 	      and	ksMask
    161  0dff		       f0 02		      beq	.n
    162  0e01		       38		      sec
    163  0e02		       60		      rts
    164  0e03				   .n
    165  0e03		       ca		      dex
    166  0e04		       10 e6		      bpl	.c
    167  0e06				   .no
    168  0e06		       18		      clc
    169  0e07		       60		      rts
    170  0e08
    171  0e08							; A = key code
    172  0e08							;   overlay	    notes (K held + a note: set the key)
    173  0e08							;   F1/F3/F5/F7    octave: C4 / C3 / C2 / C1 on the lowest key
    174  0e08							;   SHIFT+F1/F3/F5 SID / Game Boy / MidiNES on-off	SHIFT+F7 panic
    175  0e08							;   CTRL+F3/F5     Game Boy / MidiNES: next channel block
    176  0e08							;   M		    mute everything	   SPACE  per its mode
    177  0e08							;   =		    latch: off <-> on, in the menu's LATCH STYLE
    178  0e08							;   N		    new chord: the next note starts one (twice: clear now)
    179  0e08							;   Z / X	    notes mode (POLY, CHORD, EXT) / extensions (7 9 11 13)
    180  0e08							;   K + note / L   key root / major-minor
    181  0e08							;   V / SHIFT+V    next / previous sound	    C  POLY / MONO
    182  0e08							;   G / RETURN     next beat (and drum kit) / beat start-stop
    183  0e08							;   A / S / D / F  arp mode / pattern / speed / SPARKLE octave
    184  0e08							;   ; / :	    free arp speed	      B  tap tempo
    185  0e08							;   , / .	    SPACE mode (MUTES / BENDS)
    186  0e08							;   H / J	    MIDI in octave down / up
    187  0e08							;   (the phantom-key filter stays off: GhostKey is kept for a setup menu)
    188  0e08				   KeyDown
    189  0e08					      subroutine
    190  0e08		       c9 18		      cmp	#24
    191  0e0a		       90 03		      bcc	NoteDown
    192  0e0c		       4c a1 0e 	      jmp	.cmd
    193  0e0f				   NoteDown		; A = note index (overlay key 0-23, MIDI slot 24-31)
    194  0e0f		       aa		      tax
    195  0e10		       ad 8b c3 	      lda	kDown
    196  0e13		       f0 03		      beq	.note
    197  0e15		       4c 9b 0f 	      jmp	SetKeyRoot
    198  0e18				   .note
