------- FILE lead.asm LEVEL 2 PASS 3
      0  749c					      include	"lead.asm"
      1  749c							; Fat Chip 64 - CHORD + LEAD (v0.28): a chord and a lead at once, each its
      2  749c							; own patch.
      3  749c							;   BASS      (was LOW NOTE) the first key pressed is the chord's root
      4  749c							;	       (POLY: just it; SMART CHORD: its 5TH, TRIAD...; DRONE: the
      5  749c							;	       drone); every other key is the lead, while the chord key is held
      6  749c							;   TRIAD     (was LATCH 3) three keys pressed together are the chord while
      7  749c							;	       they're held (v0.36: with LATCH on, it keeps sounding after you
      8  749c							;	       let go); every other key is the lead.
      9  749c							; v0.36: the lead is LEAD OCTAVE up in every mode (+1 at first; SHIFT + F1 /
     10  749c							; F3; v0.43: One Key Play too). v0.43: SHIFT + F5 SPLIT on / off, SHIFT + F7
     11  749c							; its mode, SHIFT + K then a note: the split point. LATCH holds KEY's chord side and TRIAD's chord.
     12  749c							; The lead is one note (the last key pressed) on one voice per chip (SID 3,
     13  749c							; Game Boy pulse 1, NES pulse 1), only while it plays: the rest of the time
     14  749c							; those voices are the chord's. Its patch: SHIFT + A S D F G / Z X C V B.
     15  749c							; The lead's own: the SID's waveform, width, envelope and octave, the Game
     16  749c							; Boy pulse's CCs, the NES pulse's duty. Shared with the chord: the effects
     17  749c							; (vibrato, filter, tremolo...), the NES envelope.
     18  749c
     19  749c							;   KEY       (v0.32) a keyboard split: keys below the split point are the
     20  749c							;	       chord (as the mode plays them), keys from it up the lead (LEAD
     21  749c							;	       OCTAVE, +1 at first). On the C64's keys the split is a key (it
     22  749c							;	       stays put when the octave changes); over MIDI, a note as sent
     23  749c							;	       (before MIDI IN OCTAVE). SHIFT + F5 held + a note sets either.
     24  749c		       00 01	   CL_KEY     equ	1	; SPLIT (clMode)
     25  749c		       00 02	   CL_BASS    equ	2
     26  749c		       00 03	   CL_L3      equ	3	; (TRIAD)
     27  749c		       00 06	   LEAD_SID   equ	6	; the lead's voices: SID 3, GB pulse 1, NES pulse 1
     28  749c		       00 01	   LEAD_GB    equ	1
     29  749c		       00 02	   LEAD_NES   equ	2
     30  749c
