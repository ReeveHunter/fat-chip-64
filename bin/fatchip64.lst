     32  1104		       99 03 d4 	      sta	SID+3,y
     33  1107		       a9 20		      lda	#$20	; sawtooth, gate off
     34  1109		       9d 31 c3 	      sta	sidGate,x
     35  110c		       99 04 d4 	      sta	SID+4,y
     36  110f		       ca		      dex
