    443  6a6c							; ------------------------------------------------------------ tuning
    444  6a6c							; tuneC = PLAYING's FINE TUNE + the Synthcart's TUNE TO (while it's in use),
    445  6a6c							; in cents (-100..+100). The Game Boy gets it as master tune (CC 103), the
    446  6a6c							; NES in its bends (tuneN, 1/64 semitones), the SID in its note frequencies
    447  6a6c							; (SidTune; the notes sounding move at once). MATCH KEY sets the key's root
    448  6a6c							; once, when it changes.
    449  6a6c				   ScTune
    450  6a6c					      subroutine
    451  6a6c		       a9 00		      lda	#0
    452  6a6e		       ae 44 c8 	      ldx	useSc
