      0  0ba3					      include	"midi.asm"
      1  0ba3							; Fat Chip 64 - MIDI out
      2  0ba3							;
      3  0ba3							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0ba3							; at most one message per device onto the wire buffer, no sooner than that
      5  0ba3							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0ba3							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0ba3							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0ba3							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0ba3							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0ba3
