    120  6da6		       d0 0d		      bne	.t
    121  6da8		       bd c3 c4 	      lda	nesGlL,x
    122  6dab		       1d cc c4 	      ora	nesGlH,x
    123  6dae		       1d f0 c4 	      ora	nesBent,x
    124  6db1		       d0 02		      bne	.t
    125  6db3		       a2 02		      ldx	#2
    126  6db5				   .t
    127  6db5		       8e 29 c5 	      stx	nfxV
    128  6db8		       86 24		      stx	t0
    129  6dba		       bd 96 c3 	      lda	vOut,x
    130  6dbd		       c9 ff		      cmp	#NO_NOTE
    131  6dbf		       f0 20		      beq	.x
    132  6dc1		       20 02 6f 	      jsr	NesFxVal
    133  6dc4		       a6 24		      ldx	t0
    134  6dc6		       ad 32 c5 	      lda	nfxL
    135  6dc9		       dd de c4 	      cmp	nesFxSL,x
    136  6dcc		       d0 08		      bne	.send
    137  6dce		       ad 33 c5 	      lda	nfxH
    138  6dd1		       dd e7 c4 	      cmp	nesFxSH,x
    139  6dd4		       f0 0b		      beq	.x
    140  6dd6				   .send
    141  6dd6		       a9 01		      lda	#1
    142  6dd8		       8d 2a c5 	      sta	nfxHave	; (NesBendVoice: nfx is this voice's already)
    143  6ddb		       bd 96 c3 	      lda	vOut,x
    144  6dde		       4c 80 2d 	      jmp	NesBendVoice
    145  6de1				   .x
    146  6de1		       60		      rts
