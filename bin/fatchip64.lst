------- FILE main.asm
------- FILE drums.asm LEVEL 2 PASS 3
      0  45d6					      include	"drums.asm"
      1  45d6							; Fat Chip 64 - drums on the MidiNES
      2  45d6							;
      3  45d6							; Two sources, one kit:
      4  45d6							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  45d6							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  45d6							;			   64 = hit, 56 = ghost)
      7  45d6							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  45d6							;			   RETURN starts / stops it, at its own tempo (B taps
      9  45d6							;			   a new one)
     10  45d6							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  45d6							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  45d6							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  45d6							; a note-on, then a note-off after the sound's length, the level set with
     14  45d6							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  45d6							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  45d6
     17  45d6		       00 0c	   KIT_SIZE   equ	12
     18  45d6		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  45d6		       00 00	   DK_KICK    equ	0
     20  45d6		       00 01	   DK_SNARE   equ	1
     21  45d6		       00 02	   DK_CH      equ	2
     22  45d6		       00 03	   DK_OH      equ	3
     23  45d6		       00 04	   DK_CY      equ	4
     24  45d6		       00 05	   DK_TOM     equ	5
     25  45d6		       00 06	   DK_PERC    equ	6
     26  45d6
     27  45d6							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  45d6				   DrumHit
     29  45d6					      subroutine
     30  45d6		       8d 82 c4 	      sta	drumKind
     31  45d9		       8e 81 c4 	      stx	drumLvl
     32  45dc		       8c 83 c4 	      sty	drumTom
     33  45df		       c9 00		      cmp	#DK_KICK
     34  45e1		       d0 05		      bne	.nk
     35  45e3		       a9 01		      lda	#1
     36  45e5		       8d 3f c6 	      sta	vizKick	; (the visualizer's border flash)
     37  45e8				   .nk
     38  45e8		       ad 27 c3 	      lda	devOn+DEV_NES
     39  45eb		       d0 01		      bne	.on
     40  45ed		       60		      rts
     41  45ee				   .on
     42  45ee		       20 c7 1e 	      jsr	GetTicks
     43  45f1		       ad 82 c4 	      lda	drumKind
     44  45f4		       c9 02		      cmp	#DK_CH
     45  45f6		       90 07		      bcc	.dmc
     46  45f8		       c9 05		      cmp	#DK_TOM
     47  45fa		       b0 03		      bcs	.dmc
     48  45fc		       4c b1 46 	      jmp	NoiseHit
     49  45ff				   .dmc
     50  45ff		       ae 82 c4 	      ldx	drumKind
     51  4602		       bd 98 46 	      lda	dmcPrioT,x
     52  4605		       85 24		      sta	t0
     53  4607		       ad 3e c3 	      lda	nowL
     54  460a		       38		      sec
     55  460b		       ed 79 c4 	      sbc	dmcAt
     56  460e		       a8		      tay
     57  460f		       ad 3f c3 	      lda	nowH
     58  4612		       ed 7a c4 	      sbc	dmcAt+1
     59  4615		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  4617		       c0 0c		      cpy	#DRUM_WINDOW
     61  4619		       b0 08		      bcs	.ok
     62  461b		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     63  461d		       cd 78 c4 	      cmp	dmcPrio
     64  4620		       90 01		      bcc	.ok
     65  4622		       60		      rts
