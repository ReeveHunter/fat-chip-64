------- FILE main.asm LEVEL 1 PASS 3
      1  d165 ????						; Fat Chip 64 - main program
      2  d165 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  d165 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  d165 ????						; Build: ./build.sh (dasm makes bin/fatchip64-image.prg; tools/crunch.py packs it
      5  d165 ????						; into bin/fatchip64.prg)
      6  d165 ????
      7  d165 ????				      processor	6502
