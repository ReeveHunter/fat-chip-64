------- FILE main.asm
------- FILE drums.asm LEVEL 2 PASS 3
      0  3a44					      include	"drums.asm"
      1  3a44							; Fat Chip 64 - drums on the MidiNES
      2  3a44							;
      3  3a44							; Two sources, one kit:
      4  3a44							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  3a44							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  3a44							;			   64 = hit, 56 = ghost)
      7  3a44							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  3a44							;			   RETURN starts / stops it, at its own tempo (B taps
      9  3a44							;			   a new one)
     10  3a44							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  3a44							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  3a44							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  3a44							; a note-on, then a note-off after the sound's length, the level set with
     14  3a44							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  3a44							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  3a44
     17  3a44		       00 0c	   KIT_SIZE   equ	12
     18  3a44		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  3a44		       00 00	   DK_KICK    equ	0
     20  3a44		       00 01	   DK_SNARE   equ	1
     21  3a44		       00 02	   DK_CH      equ	2
     22  3a44		       00 03	   DK_OH      equ	3
     23  3a44		       00 04	   DK_CY      equ	4
     24  3a44		       00 05	   DK_TOM     equ	5
     25  3a44		       00 06	   DK_PERC    equ	6
     26  3a44
     27  3a44							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  3a44				   DrumHit
     29  3a44					      subroutine
     30  3a44		       8d 83 c4 	      sta	drumKind
     31  3a47		       8e 82 c4 	      stx	drumLvl
