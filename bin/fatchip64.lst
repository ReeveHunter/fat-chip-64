    120  6661		       01 00 01 03*blipTab    .byte.b	1,0, 1,3, 2,1	; OCTAVE, OCTAVE + 5TH, 2 OCTAVES: steps 0 and 1
    121  6667
    122  6667							; VoiceSet, a SID voice's new note (Y = SID voice, t0 = the voice, t3 = a new
