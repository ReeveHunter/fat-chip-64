     22  726f				   .c
     23  726f		       b1 28		      lda	(ptr),y
     24  7271		       f0 0e		      beq	.done
     25  7273		       c9 40		      cmp	#64
     26  7275		       90 03		      bcc	.noLetter
     27  7277		       38		      sec
     28  7278		       e9 40		      sbc	#64
     29  727a				   .noLetter
