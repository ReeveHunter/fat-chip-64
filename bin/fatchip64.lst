------- FILE sounds.asm LEVEL 2 PASS 3
      0  2ece					      include	"sounds.asm"
      1  2ece							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  2ece							;
      3  2ece							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  2ece							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  2ece							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  2ece							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  2ece							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  2ece							;
      9  2ece							; Each sound has a mono default and a Fat Bass default:
     10  2ece							;   MONO      one note (the last key pressed and still held) on every voice;
     11  2ece							;	       a new key while another is held changes the pitch without a
     12  2ece							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  2ece							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  2ece							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  2ece							;	       the other voices
     16  2ece							;
     17  2ece							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  2ece							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  2ece							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  2ece
     21  2ece							; ------------------------------------------------------------ choosing
     22  2ece							; V: next sound (SHIFT+V: previous)
     23  2ece				   SoundKey
     24  2ece					      subroutine
     25  2ece		       20 2b 2f 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  2ed1		       ae 95 c3 	      ldx	soundMode
     27  2ed4		       ad 2a c3 	      lda	shiftDown
     28  2ed7		       d0 09		      bne	.prev
     29  2ed9		       e8		      inx
     30  2eda		       e0 13		      cpx	#NUM_SOUNDS
     31  2edc		       90 09		      bcc	.s
     32  2ede		       a2 00		      ldx	#0
     33  2ee0		       f0 05		      beq	.s
     34  2ee2				   .prev
     35  2ee2		       ca		      dex
     36  2ee3		       10 02		      bpl	.s
     37  2ee5		       a2 12		      ldx	#NUM_SOUNDS-1
     38  2ee7				   .s
