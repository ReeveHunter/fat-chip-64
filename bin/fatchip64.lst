     30  1189		       99 06 d4 	      sta	SID+6,y
     31  118c		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     32  118e		       99 03 d4 	      sta	SID+3,y
     33  1191		       a9 20		      lda	#$20	; sawtooth, gate off
     34  1193		       9d 31 c3 	      sta	sidGate,x
     35  1196		       99 04 d4 	      sta	SID+4,y
     36  1199		       ca		      dex
