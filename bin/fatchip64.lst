------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  4b3d					      include	"sync.asm"
      1  4b3d							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  4b3d							;
      3  4b3d							; Menu, DEVICE SYNC (defaults first):
      4  4b3d							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  4b3d							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  4b3d							;		     sets the tempo, averaged over beats (the clock jitters about
      7  4b3d							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  4b3d							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  4b3d							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  4b3d							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  4b3d							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  4b3d							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  4b3d							;		     picks a beat demo (styleBeat)
     14  4b3d							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  4b3d							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  4b3d							;		     key channel) picks a sound (voiceSound)
     17  4b3d							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  4b3d							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  4b3d							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  4b3d							;
     21  4b3d							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  4b3d							; 1/4 ms); a Start makes the next clock a beat.
     23  4b3d
     24  4b3d		       00 00	   TEMPO_KEYTAR equ	0
     25  4b3d		       00 01	   TEMPO_OWN  equ	1
     26  4b3d		       00 02	   TEMPO_SC   equ	2
     27  4b3d		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  4b3d
     29  4b3d
     30  4b3d
     31  4b3d							; ------------------------------------------------------------ clock
