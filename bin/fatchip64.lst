      0  1c63					      include	"nesenv.asm"
      1  1c63							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  1c63							;
      3  1c63							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  1c63							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  1c63							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  1c63							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  1c63							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  1c63							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  1c63							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  1c63							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  1c63							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  1c63							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  1c63							; would wrap to a high pitch).
     14  1c63							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  1c63
     16  1c63		       00 40	   ENV_ATK    equ	64	; 8.8 level per 10 ms: 15 levels in 0.6 s
     17  1c63		       00 1a	   ENV_DEC    equ	26	; 4 levels (15 -> 11) in 0.4 s
     18  1c63		       00 0b	   ENV_SUS    equ	11
     19  1c63		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     20  1c63		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     21  1c63							; NES channels too, and can't take a bend every 4 ms
     22  1c63		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     23  1c63		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     24  1c63
     25  1c63							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     26  1c63		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     27  1c6c		       02 05	   slotVoice  .byte.b	2,5
