------- FILE main.asm LEVEL 1 PASS 3
      1  c955 ????						; Fat Chip 64 - main program
      2  c955 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  c955 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  c955 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  c955 ????
      6  c955 ????				      processor	6502
