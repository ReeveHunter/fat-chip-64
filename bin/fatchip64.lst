------- FILE drums.asm LEVEL 2 PASS 3
      0  4b13					      include	"drums.asm"
      1  4b13							; Fat Chip 64 - drums on the MidiNES
      2  4b13							;
      3  4b13							; Two sources, one kit:
      4  4b13							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  4b13							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  4b13							;			   64 = hit, 56 = ghost)
      7  4b13							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  4b13							;			   RETURN starts / stops it, at its own tempo (B taps
      9  4b13							;			   a new one)
     10  4b13							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  4b13							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  4b13							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  4b13							; a note-on, then a note-off after the sound's length, the level set with
     14  4b13							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  4b13							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  4b13
     17  4b13		       00 0c	   KIT_SIZE   equ	12
     18  4b13		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  4b13		       00 00	   DK_KICK    equ	0
     20  4b13		       00 01	   DK_SNARE   equ	1
     21  4b13		       00 02	   DK_CH      equ	2
     22  4b13		       00 03	   DK_OH      equ	3
     23  4b13		       00 04	   DK_CY      equ	4
     24  4b13		       00 05	   DK_TOM     equ	5
     25  4b13		       00 06	   DK_PERC    equ	6
     26  4b13
     27  4b13							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  4b13				   DrumHit
     29  4b13					      subroutine
     30  4b13		       8d 83 c4 	      sta	drumKind
     31  4b16		       8e 82 c4 	      stx	drumLvl
     32  4b19		       8c 84 c4 	      sty	drumTom
     33  4b1c		       c9 00		      cmp	#DK_KICK
     34  4b1e		       d0 05		      bne	.nk
     35  4b20		       a9 01		      lda	#1
     36  4b22		       8d 40 c6 	      sta	vizKick	; (the visualizer's border flash)
     37  4b25				   .nk
     38  4b25		       ad 27 c3 	      lda	devOn+DEV_NES
     39  4b28		       d0 01		      bne	.on
     40  4b2a		       60		      rts
     41  4b2b				   .on
     42  4b2b		       20 ae 22 	      jsr	GetTicks
     43  4b2e		       ad 83 c4 	      lda	drumKind
     44  4b31		       c9 02		      cmp	#DK_CH
     45  4b33		       90 07		      bcc	.dmc
     46  4b35		       c9 05		      cmp	#DK_TOM
     47  4b37		       b0 03		      bcs	.dmc
     48  4b39		       4c ee 4b 	      jmp	NoiseHit
     49  4b3c				   .dmc
     50  4b3c		       ae 83 c4 	      ldx	drumKind
     51  4b3f		       bd d5 4b 	      lda	dmcPrioT,x
     52  4b42		       85 24		      sta	t0
     53  4b44		       ad 3f c3 	      lda	nowL
     54  4b47		       38		      sec
     55  4b48		       ed 7a c4 	      sbc	dmcAt
     56  4b4b		       a8		      tay
     57  4b4c		       ad 40 c3 	      lda	nowH
     58  4b4f		       ed 7b c4 	      sbc	dmcAt+1
     59  4b52		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  4b54		       c0 0c		      cpy	#DRUM_WINDOW
     61  4b56		       b0 08		      bcs	.ok
     62  4b58		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     63  4b5a		       cd 79 c4 	      cmp	dmcPrio
     64  4b5d		       90 01		      bcc	.ok
     65  4b5f		       60		      rts
     66  4b60				   .ok
     67  4b60							; the sample: kit[beat][kitOfs[kind] + level, or + tom]
     68  4b60		       ae 83 c4 	      ldx	drumKind
     69  4b63		       bd dc 4b 	      lda	kitOfs,x
     70  4b66		       e0 05		      cpx	#DK_TOM
     71  4b68		       d0 07		      bne	.lv
     72  4b6a		       18		      clc
     73  4b6b		       6d 84 c4 	      adc	drumTom
     74  4b6e		       4c 75 4b 	      jmp	.k
     75  4b71				   .lv
     76  4b71		       18		      clc
     77  4b72		       6d 82 c4 	      adc	drumLvl
     78  4b75				   .k
     79  4b75		       85 25		      sta	t1
     80  4b77		       ad 6e c4 	      lda	beatSel	; x 12
     81  4b7a		       0a		      asl
     82  4b7b		       0a		      asl
     83  4b7c		       85 26		      sta	t2
     84  4b7e		       0a		      asl
     85  4b7f		       65 26		      adc	t2
     86  4b81		       65 25		      adc	t1
     87  4b83		       aa		      tax
     88  4b84		       bd c5 a2 	      lda	kits,x
     89  4b87		       85 25		      sta	t1
     90  4b89							; bank (CC14 on the sample channel) when it changes
     91  4b89		       a9 04		      lda	#4
     92  4b8b		       20 e3 4b 	      jsr	NesChStatus	; mS = CC, sample channel
     93  4b8e		       a9 00		      lda	#0
     94  4b90		       a6 25		      ldx	t1
     95  4b92		       10 02		      bpl	.a
     96  4b94		       a9 7f		      lda	#127
     97  4b96				   .a
     98  4b96		       cd 78 c4 	      cmp	dmcBank
     99  4b99		       f0 0c		      beq	.note
    100  4b9b		       8d 78 c4 	      sta	dmcBank
    101  4b9e		       85 23		      sta	mD2
    102  4ba0		       a9 0e		      lda	#14
    103  4ba2		       85 22		      sta	mD1
    104  4ba4		       20 58 0d 	      jsr	NesPut
    105  4ba7				   .note
    106  4ba7		       a5 21		      lda	mS
    107  4ba9		       29 0f		      and	#$0F
    108  4bab		       85 26		      sta	t2	; channel
    109  4bad		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    110  4baf							;  cuts it anyway, and the hit lands 1 ms sooner)
    111  4baf		       29 7f		      and	#$7F
    112  4bb1		       8d 85 c4 	      sta	dmcNote
    113  4bb4		       85 22		      sta	mD1
    114  4bb6		       a5 26		      lda	t2
    115  4bb8		       09 90		      ora	#$90
    116  4bba		       85 21		      sta	mS
    117  4bbc		       a9 7f		      lda	#127
    118  4bbe		       85 23		      sta	mD2
    119  4bc0		       20 58 0d 	      jsr	NesPut
    120  4bc3		       a5 24		      lda	t0
    121  4bc5		       8d 79 c4 	      sta	dmcPrio
    122  4bc8		       ad 3f c3 	      lda	nowL
    123  4bcb		       8d 7a c4 	      sta	dmcAt
    124  4bce		       ad 40 c3 	      lda	nowH
    125  4bd1		       8d 7b c4 	      sta	dmcAt+1
    126  4bd4		       60		      rts
    127  4bd5
    128  4bd5		       00 01 00 00*dmcPrioT   .byte.b	0,1,0,0,0,2,3	; kick, snare, -, -, -, tom, perc
    129  4bdc		       00 03 00 00*kitOfs     .byte.b	0,3,0,0,0,6,9
