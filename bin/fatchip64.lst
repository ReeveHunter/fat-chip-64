      0  37ef					      include	"midiin.asm"
      1  37ef							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  37ef							;
      3  37ef							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  37ef							; The main loop parses them (running status; realtime and system bytes are
      5  37ef							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  37ef							; notes mode, latch, arp and K + note.
      7  37ef							;
      8  37ef							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  37ef							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  37ef							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  37ef							;
     12  37ef							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  37ef							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  37ef							;
     15  37ef							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  37ef							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  37ef							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  37ef							; MIDI in is passed on to the Game Boy or NES.
     19  37ef
     20  37ef							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  37ef							; Uses A, X.
     22  37ef							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  37ef							; with the time; a Start ($FA) makes the next clock a beat.
     24  37ef				   RxByte
     25  37ef					      subroutine
     26  37ef		       ad 06 de 	      lda	ACIA_STAT
     27  37f2		       4a		      lsr		; RDRF -> carry
     28  37f3		       90 2b		      bcc	.x
     29  37f5				   RxGot
     30  37f5		       ad 07 de 	      lda	ACIA_RX
     31  37f8		       c9 f8		      cmp	#$F8
     32  37fa		       f0 25		      beq	.clk
     33  37fc		       c9 fa		      cmp	#$FA
     34  37fe		       d0 0e		      bne	.buf
     35  3800		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  3802		       8e e9 c5 	      stx	clkPhase
     37  3805		       8e f1 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3808							;  the main loop could measure it)
     39  3808		       ae ea c5 	      ldx	clkBeat
     40  380b		       8e fc c5 	      stx	clkStartBeat
     41  380e				   .buf
     42  380e		       ae 25 c4 	      ldx	rxHead
     43  3811		       9d e5 c3 	      sta	rxBuf,x
     44  3814		       e8		      inx
     45  3815		       8a		      txa
     46  3816		       29 3f		      and	#63
     47  3818		       cd 26 c4 	      cmp	rxTail
     48  381b		       f0 03		      beq	.x	; full: dropped
     49  381d		       8d 25 c4 	      sta	rxHead
     50  3820				   .x
     51  3820		       60		      rts
     52  3821				   .clk
     53  3821		       ee e5 c5 	      inc	clkCount
     54  3824		       ae e9 c5 	      ldx	clkPhase
     55  3827		       e8		      inx
     56  3828		       e0 18		      cpx	#24
     57  382a		       90 1b		      bcc	.ph
     58  382c		       a5 10		      lda	ticks
     59  382e		       8d ec c5 	      sta	clkAtL
     60  3831		       a5 11		      lda	ticks+1
     61  3833		       8d ed c5 	      sta	clkAtH
     62  3836		       a5 2d		      lda	subTick
     63  3838		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  383a		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  383c		       ad 05 dc 	      lda	CIA1_TAHI
     66  383f				   .q
     67  383f		       8d ee c5 	      sta	clkAtS
     68  3842		       ee ea c5 	      inc	clkBeat
     69  3845		       a2 00		      ldx	#0
     70  3847				   .ph
     71  3847		       8e e9 c5 	      stx	clkPhase
     72  384a		       60		      rts
