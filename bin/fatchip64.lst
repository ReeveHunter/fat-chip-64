     22  7203				   .c
     23  7203		       b1 28		      lda	(ptr),y
     24  7205		       f0 0e		      beq	.done
     25  7207		       c9 40		      cmp	#64
     26  7209		       90 03		      bcc	.noLetter
     27  720b		       38		      sec
     28  720c		       e9 40		      sbc	#64
     29  720e				   .noLetter
