     51  2e81		       20 eb 2e 	      jsr	SoundVars
     52  2e84		       20 66 32 	      jsr	SoundApply	; ...and come back with the new one
     53  2e87		       4c a7 11 	      jmp	Dirty
     54  2e8a
     55  2e8a							;  built-in patch X -> livePatch, the patch everything plays from (keeps X)
     56  2e8a				   PatchLoad
     57  2e8a					      subroutine
     58  2e8a		       bd 11 71 	      lda	patchLo,x
