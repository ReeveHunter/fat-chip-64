    132  861f		       bd 5f c8 	      lda	vOut,x
    133  8622		       c9 ff		      cmp	#NO_NOTE
    134  8624		       f0 20		      beq	.x
    135  8626		       20 ae 87 	      jsr	NesFxVal
    136  8629		       a6 24		      ldx	t0
    137  862b		       ad ff c9 	      lda	nfxL
    138  862e		       dd ab c9 	      cmp	nesFxSL,x
    139  8631		       d0 08		      bne	.send
    140  8633		       ad 00 ca 	      lda	nfxH
    141  8636		       dd b4 c9 	      cmp	nesFxSH,x
    142  8639		       f0 0b		      beq	.x
    143  863b				   .send
    144  863b		       a9 01		      lda	#1
    145  863d		       8d f7 c9 	      sta	nfxHave	; (NesBendVoice: nfx is this voice's already)
    146  8640		       bd 5f c8 	      lda	vOut,x
    147  8643		       4c 53 37 	      jmp	NesBendVoice
    148  8646				   .x
