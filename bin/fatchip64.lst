    330  334b		       00 6e	   WOB_DEPTH  equ	110	; TAPE WOBBLE: about 0.45 semitone
    331  334b		       00 b7	   WOB_RATE   equ	183	;  at 0.7 Hz
    332  334b
    333  334b							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    334  334b							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    335  334b							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    336  334b							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    337  334b		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    338  334f		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    339  3356		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    340  335d		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    341  3362		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    342  3366		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    343  336a		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
    344  336f		       05 0a 0f 14*uTremRH    .byte.b	>1311, >2621, >3932, >5243, >6554
    345  3374		       04 08 0c 10 uDetT      .byte.b	4, 8, 12, 16
    346  3378		       18 38 64    uWarbT     .byte.b	24, 56, 100
    347  337b							; ... and the Game Boy's CCs for them (LFO depth CC 1, rate CC 76, delay
    348  337b							; CC 79, glide CC 5, detune +- from 64 on CC 94)
    349  337b		       10 18 1c 20 gbVibDepT  .byte.b	16, 24, 28, 32
    350  337f		       48 50 54 58*gbVibRateT .byte.b	72, 80, 84, 88, 92, 96, 100
    351  3386		       00 08 10 20*gbVibDelT  .byte.b	0, 8, 16, 32, 64
    352  338b		       10 20 30 40 gbGlideT   .byte.b	16, 32, 48, 64
    353  338f		       03 06 0a 10 gbDetT     .byte.b	3, 6, 10, 16
