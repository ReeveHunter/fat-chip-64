      0  1be7					      include	"nesenv.asm"
      1  1be7							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  1be7							;
      3  1be7							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  1be7							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  1be7							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  1be7							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  1be7							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  1be7							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  1be7							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  1be7							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  1be7							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  1be7							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  1be7							; would wrap to a high pitch).
     14  1be7							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  1be7
     16  1be7		       00 40	   ENV_ATK    equ	64	; 8.8 level per 10 ms: 15 levels in 0.6 s
     17  1be7		       00 1a	   ENV_DEC    equ	26	; 4 levels (15 -> 11) in 0.4 s
     18  1be7		       00 0b	   ENV_SUS    equ	11
     19  1be7		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     20  1be7		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     21  1be7							; NES channels too, and can't take a bend every 4 ms
     22  1be7		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     23  1be7		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     24  1be7
     25  1be7							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     26  1be7		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     27  1bf0		       02 05	   slotVoice  .byte.b	2,5
     28  1bf2
