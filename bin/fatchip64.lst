      0  3e02					      include	"screen.asm"
      1  3e02							; Fat Chip 64 - screen
      2  3e02							;
      3  3e02							;  row 0   FAT CHIP 64 header
      4  3e02							;  rows 2-7  devices (F1/F3/F5), channels, panic, overlap warning
      5  3e02							;  rows 9-18 voice table: which chip voice plays which note
      6  3e02							;  row 20  held notes, row 21 octave + latch, row 22 RESTORE test counters,
      7  3e02							;  row 23 messages sent, row 24 mode
      8  3e02
      9  3e02							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
