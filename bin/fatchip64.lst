------- FILE voices.asm LEVEL 2 PASS 3
      0  112d					      include	"voices.asm"
      1  112d							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  112d							;
      3  112d							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  112d							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  112d							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  112d							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  112d							; Allocation, whenever the held notes change:
      8  112d							;   1. bass voices play the lowest note, an octave down
      9  112d							;   2. every other note gets one voice, lowest notes first
     10  112d							;   3. leftover voices stack on the lowest two notes, alternating
     11  112d							; So one note = a nine-voice unison across three chips, and in chords the
     12  112d							; bottom of the chord is fattest. Disabled devices get no notes.
     13  112d
     14  112d							; ------------------------------------------------------------ SID
     15  112d				   SidInit
     16  112d					      subroutine
