------- FILE main.asm
------- FILE looper.asm LEVEL 2 PASS 3
      0  8a43					      include	"looper.asm"
      1  8a43							; Fat Chip 64 - THE LOOPER, sampler stage 2 (v0.69): six loop tracks of pad hits
      2  8a43							;
      3  8a43							; One clock, 24 ticks a beat, four beats a bar; each track its own length in
      4  8a43							; bars. While a beat runs the clock steps with it (6 ticks a step, waiting
      5  8a43							; for the beat's next step, so they never drift); a beat started while loops
      6  8a43							; play waits for their next bar.
      7  8a43							;
      8  8a43							; In the sampler: F1 / F3 pick a track (1-6). F5, its button, as the RC-505's:
      9  8a43							; EMPTY -> armed (recording from the first hit) -> F5: its length, the take
     10  8a43							; rounded to whole bars (late: the hits past the end go to its start; early:
     11  8a43							; it runs to the bar's end), and it plays -> F5 overdub -> F5 play. A stopped
     12  8a43							; track: F5 plays it from the next bar. F5 twice quickly: stop. F7: stop
     13  8a43							; (SHIFT + F7: all); F7 on a stopped track clears it. <- undoes the last
     14  8a43							; overdub (again: back). C= + 1-6: mute. QUANTIZE (menu SAMPLER): OFF, 1/16,
     15  8a43							; 1/8, as hits are recorded. On the play screen RUN/STOP + Q W E R T Y is
     16  8a43							; track 1-6's button.
     17  8a43							;
     18  8a43							; A hit is 3 bytes under the I/O (LPEV: a region a track): its tick (low,
     19  8a43							; then high in bits 0-2 with $80: this overdub's, $40: undone, $20: skip once
     20  8a43							; - recorded on or after where the loop is), then pad | kit << 4 | accent << 5.
     21  8a43							; A track's hits stay in order of their ticks.
     22  8a43
     23  8a43		       00 00	   LP_EMPTY   equ	0
     24  8a43		       00 01	   LP_ARMED   equ	1
     25  8a43		       00 02	   LP_REC     equ	2
     26  8a43		       00 03	   LP_PLAY    equ	3
     27  8a43		       00 04	   LP_DUB     equ	4
     28  8a43		       00 05	   LP_STOP    equ	5
     29  8a43		       00 06	   LP_CUED    equ	6
     30  8a43		       00 06	   LP_TRACKS  equ	6
     31  8a43		       00 4c	   LP_HITS    equ	76	; a track's hits (3 bytes each)
     32  8a43		       00 60	   LP_BAR     equ	96	; ticks a bar
     33  8a43		       00 fa	   LP_TAP     equ	250	; ms: F5 twice within it stops
     34  8a43
     35  8a43							; ---- the clock (main loop). It rests while no track is armed, recording,
     36  8a43							; playing or cued (and no beat waits for it): nothing to keep time for
     37  8a43				   LoopTick
     38  8a43					      subroutine
     39  8a43		       ad 88 fd 	      lda	lpDirty
     40  8a46		       f0 03		      beq	.k
     41  8a48		       20 fb 8a 	      jsr	LoopAny
     42  8a4b				   .k
     43  8a4b		       ad d5 fd 	      lda	lpAny
     44  8a4e		       d0 10		      bne	.go
     45  8a50		       ad 88 fd 	      lda	lpDirty	; (resting: a change still shows)
     46  8a53		       f0 0a		      beq	.r
     47  8a55		       a9 00		      lda	#0
     48  8a57		       8d 88 fd 	      sta	lpDirty
     49  8a5a		       a9 01		      lda	#1
     50  8a5c		       8d f0 c7 	      sta	screenDirty
     51  8a5f				   .r
     52  8a5f		       60		      rts
     53  8a60				   .go
     54  8a60		       20 15 25 	      jsr	GetTicks
