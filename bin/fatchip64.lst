------- FILE main.asm
------- FILE wander.asm LEVEL 2 PASS 3
      0  682d					      include	"wander.asm"
      1  682d							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  682d							;
      3  682d							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  682d							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  682d							;   ATTACK   as always: the new notes start
      6  682d							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  682d							;	      has none)
      8  682d							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  682d							;	      start again
     10  682d							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  682d							;	      late; some glide, some start again (fade out, come back in)
     12  682d							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  682d							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  682d							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  682d							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  682d
     17  682d		       00 01	   CHG_ATTACK equ	1
     18  682d		       00 02	   CHG_GLIDE  equ	2
     19  682d		       00 03	   CHG_STAGGER equ	3
     20  682d		       00 04	   CHG_WANDER equ	4
     21  682d		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  682d		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  682d
     24  682d							; A = the chord change style now (keeps X, Y)
     25  682d				   ChgEff
     26  682d					      subroutine
     27  682d		       ad 59 c8 	      lda	chgMode
     28  6830		       d0 0c		      bne	.x
     29  6832		       ad ab c3 	      lda	effMode
     30  6835		       c9 02		      cmp	#MODE_DRONE
     31  6837		       d0 03		      bne	.a
     32  6839		       a9 04		      lda	#CHG_WANDER
     33  683b		       60		      rts
     34  683c				   .a
     35  683c		       a9 01		      lda	#CHG_ATTACK
     36  683e				   .x
     37  683e		       60		      rts
