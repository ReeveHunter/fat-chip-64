------- FILE midi.asm LEVEL 2 PASS 3
      0  0b5a					      include	"midi.asm"
      1  0b5a							; Fat Chip 64 - MIDI out
      2  0b5a							;
      3  0b5a							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0b5a							; at most one message per device onto the wire buffer, no sooner than that
      5  0b5a							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0b5a							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0b5a							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0b5a							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0b5a							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0b5a
     11  0b5a				   MidiInit
     12  0b5a					      subroutine
     13  0b5a		       a9 03		      lda	#ACIA_RESET
     14  0b5c		       8d 04 de 	      sta	ACIA_CTRL
     15  0b5f		       a9 16		      lda	#ACIA_MODE
     16  0b61		       8d 04 de 	      sta	ACIA_CTRL
     17  0b64							; (fall into the test)
     18  0b64
     19  0b64							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0b64							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0b64							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0b64							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0b64							; before. Interrupts are off when this is called.
     24  0b64				   MidiIrqTest
     25  0b64					      subroutine
     26  0b64		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0b66		       8d 0d dc 	      sta	CIA1_ICR
     28  0b69		       ad 0d dc 	      lda	CIA1_ICR
     29  0b6c		       a9 b4		      lda	#<IrqTest
     30  0b6e		       8d fe ff 	      sta	$FFFE
     31  0b71		       a9 0b		      lda	#>IrqTest
     32  0b73		       8d ff ff 	      sta	$FFFF
     33  0b76		       a9 00		      lda	#0
     34  0b78		       85 2f		      sta	midiIrq
     35  0b7a		       a9 b6		      lda	#ACIA_MODE_TX
     36  0b7c		       8d 04 de 	      sta	ACIA_CTRL
     37  0b7f		       58		      cli
     38  0b80		       a2 00		      ldx	#0
     39  0b82				   .w
     40  0b82		       ca		      dex
     41  0b83		       d0 fd		      bne	.w
     42  0b85		       78		      sei
     43  0b86		       a6 2f		      ldx	midiIrq
     44  0b88		       bd c0 0b 	      lda	midiCtl,x
     45  0b8b		       8d 04 de 	      sta	ACIA_CTRL
     46  0b8e		       bd c2 0b 	      lda	irqLo,x
     47  0b91		       8d fe ff 	      sta	$FFFE
     48  0b94		       bd c4 0b 	      lda	irqHi,x
     49  0b97		       8d ff ff 	      sta	$FFFF
     50  0b9a		       bd c6 0b 	      lda	latchLo,x
     51  0b9d		       8d 04 dc 	      sta	CIA1_TALO
     52  0ba0		       bd c8 0b 	      lda	latchHi,x
     53  0ba3		       8d 05 dc 	      sta	CIA1_TAHI
     54  0ba6		       a9 11		      lda	#$11	; start, force load, continuous
     55  0ba8		       8d 0e dc 	      sta	CIA1_CRA
     56  0bab		       ad 0d dc 	      lda	CIA1_ICR
     57  0bae		       a9 81		      lda	#$81	; timer A interrupt on
     58  0bb0		       8d 0d dc 	      sta	CIA1_ICR
     59  0bb3		       60		      rts
     60  0bb4				   IrqTest
     61  0bb4		       48		      pha
     62  0bb5		       a9 01		      lda	#1
     63  0bb7		       85 2f		      sta	midiIrq
     64  0bb9		       a9 16		      lda	#ACIA_MODE	; (quiet again)
     65  0bbb		       8d 04 de 	      sta	ACIA_CTRL
     66  0bbe		       68		      pla
     67  0bbf		       40		      rti
     68  0bc0		       16 96	   midiCtl    .byte.b	ACIA_MODE, ACIA_MODE_RX
     69  0bc2		       b0 f3	   irqLo      .byte.b	<Irq, <IrqMidi
     70  0bc4		       0a 0a	   irqHi      .byte.b	>Irq, >IrqMidi
     71  0bc6		       ff ff	   latchLo    .byte.b	<TICK_LATCH, <TICK_LATCH_MS
     72  0bc8		       00 03	   latchHi    .byte.b	>TICK_LATCH, >TICK_LATCH_MS
