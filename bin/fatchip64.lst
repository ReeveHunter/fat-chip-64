------- FILE viz.asm LEVEL 2 PASS 3
      0  6006					      include	"viz.asm"
      1  6006							; Fat Chip 64 - the visualizers (F7: BARS, GLITCH, back to play), demos
      2  6006							;
      3  6006							; BARS:
      4  6006							; Nine bars, one per voice, in three groups: SID, Game Boy, MidiNES. A new
      5  6006							; note throws its bar to the top; it falls back to a height set by the
      6  6006							; note's pitch (higher notes stand taller) while the note sounds, and to
      7  6006							; nothing when it stops. The tremolo makes the bars breathe. Each bar takes
      8  6006							; the colour of its note's pitch class (C red ... B white). Kick drums flash
      9  6006							; the border in the key's colour; row 24 has the sound, the tempo and, while
     10  6006							; a beat plays, which beat of the bar it's on.
     11  6006							;
     12  6006							; One bar is drawn per screen step (about every 8 ms), so the screen stays
     13  6006							; out of the way of the keyboard and the arp: about 13 frames a second.
     14  6006							;
     15  6006							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
     16  6006							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
     17  6006							; keep spattering more; runs of the screen get copied over other places
     18  6006							; (datamosh) and wiped away, so it fills while you play and dissolves when
     19  6006							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
     20  6006							; the background. VINYL STOP drags it down the screen.
     21  6006
     22  6006		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     23  6006		       00 16	   VIZ_NAMES  equ	22	; note names
     24  6006		       00 a0	   VIZ_FULL   equ	160	; reversed space
     25  6006		       00 62	   VIZ_HALF   equ	98	; lower half block
     26  6006
