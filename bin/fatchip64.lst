    219  0acc				   NesPut
    220  0acc					      subroutine
    221  0acc							; write the slot at head first (always free: one slot stays empty),
    222  0acc							; then publish head unless the queue is full. Uses only A and X.
    223  0acc		       a6 19		      ldx	nesqHead
