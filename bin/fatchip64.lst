    299  2b36							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    300  2b36							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    301  2b36							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    302  2b36							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    303  2b36		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    304  2b3a		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    305  2b41		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    306  2b48		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    307  2b4d		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    308  2b51		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    309  2b55		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
    310  2b5a		       05 0a 0f 14*uTremRH    .byte.b	>1311, >2621, >3932, >5243, >6554
    311  2b5f		       04 08 0c 10 uDetT      .byte.b	4, 8, 12, 16
    312  2b63		       18 38 64    uWarbT     .byte.b	24, 56, 100
    313  2b66							; ... and the Game Boy's CCs for them (LFO depth CC 1, rate CC 76, delay
    314  2b66							; CC 79, glide CC 5, detune +- from 64 on CC 94)
