------- FILE midi.asm LEVEL 2 PASS 2
      0  096e					      include	"midi.asm"
      1  096e							; Fat Chip 64 - MIDI out
      2  096e							;
      3  096e							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  096e							; at most one message per device onto the wire buffer, no sooner than that
      5  096e							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  096e							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  096e							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  096e							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  096e							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  096e
     11  096e				   MidiInit
     12  096e					      subroutine
     13  096e		       a9 03		      lda	#ACIA_RESET
     14  0970		       8d 04 de 	      sta	ACIA_CTRL
     15  0973		       a9 16		      lda	#ACIA_MODE
     16  0975		       8d 04 de 	      sta	ACIA_CTRL
     17  0978		       60		      rts
     18  0979
     19  0979							; IRQ: send one wire byte if the ACIA is ready.
     20  0979				   TxByte
     21  0979					      subroutine
     22  0979		       a6 15		      ldx	wireTail
     23  097b		       e4 14		      cpx	wireHead
     24  097d		       f0 0f		      beq	.done
     25  097f		       ad 06 de 	      lda	ACIA_STAT
     26  0982		       29 02		      and	#ACIA_TDRE
     27  0984		       f0 08		      beq	.done
     28  0986		       bd 00 c0 	      lda	wireBuf,x
     29  0989		       8d 05 de 	      sta	ACIA_TX
     30  098c		       e6 15		      inc	wireTail
     31  098e				   .done
     32  098e		       60		      rts
     33  098f
     34  098f							; Main loop: same, with interrupts off around it.
     35  098f				   TxService
     36  098f					      subroutine
     37  098f		       08		      php
     38  0990		       78		      sei
     39  0991		       20 79 09 	      jsr	TxByte
     40  0994		       28		      plp
     41  0995		       60		      rts
     42  0996
     43  0996							; IRQ: pace device queues onto the wire.
     44  0996							;
     45  0996							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
     46  0996							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
     47  0996							; times as signed numbers, so after 33 s of silence every queue froze for
     48  0996							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
     49  0996							;
     50  0996							; When the Game Boy is on, everything on the wire also passes through the
     51  0996							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
     52  0996							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
     53  0996							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
     54  0996							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
     55  0996							; message, the rate measured clean.
     56  0996				   Schedule
     57  0996					      subroutine
     58  0996		       ad 0e c3 	      lda	devOn+DEV_GB
     59  0999		       f0 10		      beq	.gb
     60  099b		       a5 2d		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
     61  099d		       f0 0c		      beq	.gb
     62  099f		       c6 2d		      dec	linkLoad
     63  09a1		       f0 08		      beq	.gb
     64  09a3		       a5 10		      lda	ticks
     65  09a5		       29 01		      and	#1
     66  09a7		       f0 02		      beq	.gb
     67  09a9		       c6 2d		      dec	linkLoad
     68  09ab				   .gb
     69  09ab							; ---- Game Boy
     70  09ab		       a5 17		      lda	gbqTail
     71  09ad		       c5 16		      cmp	gbqHead
     72  09af		       f0 36		      beq	.nes
     73  09b1		       a5 18		      lda	gbNext
     74  09b3		       38		      sec
     75  09b4		       e5 10		      sbc	ticks
     76  09b6		       f0 04		      beq	.gbDue
     77  09b8		       c9 04		      cmp	#GB_GAP+1
     78  09ba		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
     79  09bc				   .gbDue
     80  09bc							; only onto an empty wire, so the gap holds on the cable itself (NES
     81  09bc							; bytes already waiting would otherwise delay this one and squeeze it
     82  09bc							; against the next)
     83  09bc		       a5 14		      lda	wireHead
     84  09be		       c5 15		      cmp	wireTail
     85  09c0		       d0 25		      bne	.nes
     86  09c2		       20 25 0a 	      jsr	LinkRoom
     87  09c5		       90 20		      bcc	.nes
     88  09c7		       a6 17		      ldx	gbqTail
     89  09c9		       bd 00 c1 	      lda	gbqS,x
     90  09cc		       bc 80 c1 	      ldy	gbqD2,x
     91  09cf		       84 2b		      sty	irqT
     92  09d1		       bc 40 c1 	      ldy	gbqD1,x
     93  09d4		       20 41 0a 	      jsr	WireMsg
     94  09d7		       a5 17		      lda	gbqTail
     95  09d9		       18		      clc
     96  09da		       69 01		      adc	#1
     97  09dc		       29 3f		      and	#63
     98  09de		       85 17		      sta	gbqTail
     99  09e0		       a5 10		      lda	ticks
    100  09e2		       18		      clc
    101  09e3		       69 03		      adc	#GB_GAP
    102  09e5		       85 18		      sta	gbNext
    103  09e7				   .nes
    104  09e7		       a5 1a		      lda	nesqTail
    105  09e9		       c5 19		      cmp	nesqHead
    106  09eb		       f0 37		      beq	.done
    107  09ed		       a5 1b		      lda	nesNext
    108  09ef		       38		      sec
    109  09f0		       e5 10		      sbc	ticks
    110  09f2		       f0 04		      beq	.nesDue
    111  09f4		       c9 02		      cmp	#NES_GAP+1
    112  09f6		       90 2c		      bcc	.done
    113  09f8				   .nesDue
    114  09f8		       20 38 0a 	      jsr	WireFree
    115  09fb		       c9 03		      cmp	#3
    116  09fd		       90 25		      bcc	.done
    117  09ff		       20 25 0a 	      jsr	LinkRoom
    118  0a02		       90 20		      bcc	.done
    119  0a04		       a6 1a		      ldx	nesqTail
    120  0a06		       bd c0 c1 	      lda	nesqS,x
    121  0a09		       bc 40 c2 	      ldy	nesqD2,x
    122  0a0c		       84 2b		      sty	irqT
    123  0a0e		       bc 00 c2 	      ldy	nesqD1,x
    124  0a11		       20 41 0a 	      jsr	WireMsg
    125  0a14		       a5 1a		      lda	nesqTail
    126  0a16		       18		      clc
    127  0a17		       69 01		      adc	#1
    128  0a19		       29 3f		      and	#63
    129  0a1b		       85 1a		      sta	nesqTail
    130  0a1d		       a5 10		      lda	ticks
    131  0a1f		       18		      clc
    132  0a20		       69 01		      adc	#NES_GAP
    133  0a22		       85 1b		      sta	nesNext
    134  0a24				   .done
    135  0a24		       60		      rts
