------- FILE main.asm LEVEL 1 PASS 3
      1  b788 ????						; Fat Chip 64 - main program
      2  b788 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  b788 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  b788 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  b788 ????
      6  b788 ????				      processor	6502
