------- FILE main.asm LEVEL 1 PASS 3
      1  aa39 ????						; Fat Chip 64 - main program
      2  aa39 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  aa39 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  aa39 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  aa39 ????
      6  aa39 ????				      processor	6502
