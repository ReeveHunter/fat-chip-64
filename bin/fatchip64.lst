      0  632a					      include	"patchedit.asm"
      1  632a							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  632a							; the dice. The settings and their steps come from tools/gen_menu.py
      3  632a							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  632a							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  632a							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  632a							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  632a							; (EnvDerive).
