    129  80c3				   .t
    130  80c3		       8e 36 c5 	      stx	nfxV
    131  80c6		       86 24		      stx	t0
    132  80c8		       bd 9f c3 	      lda	vOut,x
    133  80cb		       c9 ff		      cmp	#NO_NOTE
    134  80cd		       f0 20		      beq	.x
    135  80cf		       20 57 82 	      jsr	NesFxVal
    136  80d2		       a6 24		      ldx	t0
    137  80d4		       ad 3f c5 	      lda	nfxL
    138  80d7		       dd eb c4 	      cmp	nesFxSL,x
    139  80da		       d0 08		      bne	.send
    140  80dc		       ad 40 c5 	      lda	nfxH
    141  80df		       dd f4 c4 	      cmp	nesFxSH,x
    142  80e2		       f0 0b		      beq	.x
    143  80e4				   .send
    144  80e4		       a9 01		      lda	#1
    145  80e6		       8d 37 c5 	      sta	nfxHave	; (NesBendVoice: nfx is this voice's already)
    146  80e9		       bd 9f c3 	      lda	vOut,x
    147  80ec		       4c 87 36 	      jmp	NesBendVoice
    148  80ef				   .x
    149  80ef		       60		      rts
    150  80f0
    151  80f0							; voice X's glide offset closer to 0: by off / 2^glideK for each 4 ms step
    152  80f0							; (worked out once: d = off >> k, off -= d x n; past 0 or nothing left to
    153  80f0							; move by: there). Keeps X.
    154  80f0				   NesGlideStep
    155  80f0					      subroutine
    156  80f0		       bd d0 c4 	      lda	nesGlL,x
    157  80f3		       1d d9 c4 	      ora	nesGlH,x
    158  80f6		       d0 01		      bne	.go
    159  80f8		       60		      rts
