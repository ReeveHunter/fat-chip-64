    200  0ccf							; Carry set if the Teensyboy has room for a message (always, with the Game
    201  0ccf							; Boy off), and counts it.
    202  0ccf				   LinkRoom
    203  0ccf					      subroutine
    204  0ccf		       ad 26 c3 	      lda	devOn+DEV_GB
    205  0cd2		       f0 0a		      beq	.yes
    206  0cd4		       a5 2e		      lda	linkLoad
    207  0cd6		       c9 2d		      cmp	#LINK_MAX
    208  0cd8		       b0 06		      bcs	.no
    209  0cda		       69 03		      adc	#3
    210  0cdc		       85 2e		      sta	linkLoad
    211  0cde				   .yes
    212  0cde		       38		      sec
    213  0cdf		       60		      rts
    214  0ce0				   .no
    215  0ce0		       18		      clc
    216  0ce1		       60		      rts
