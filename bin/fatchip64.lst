------- FILE screen.asm LEVEL 2 PASS 3
      0  6f93					      include	"screen.asm"
      1  6f93							; Fat Chip 64 - screen
      2  6f93							;
      3  6f93							;  row 0      header
      4  6f93							;  row 2      sound, POLY / MONO, Fat Bass
      5  6f93							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  6f93							;	       each plays (row 7: a channel overlap warning)
      7  6f93							;  row 9      key, notes mode, latch
      8  6f93							;  row 10     arp
      9  6f93							;  row 12     tempo, beat, mute
     10  6f93							;  row 13     SPACE's action, octave (the lowest key), transpose
     11  6f93							;  row 14     v0.40: the effect the C= keys work on, its setting
     12  6f93							;  row 15     held notes
     13  6f93							;  row 16     MIDI in
     14  6f93							;  row 24     F keys
     15  6f93
