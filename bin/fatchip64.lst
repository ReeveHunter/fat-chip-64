     20  0cdd		       ad 01 dc 	      lda	CIA1_PRB
     21  0ce0		       49 ff		      eor	#$FF
     22  0ce2		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0ce5		       9d 80 c2 	      sta	keyNow,x
     24  0ce8		       ca		      dex
     25  0ce9		       10 ec		      bpl	.col
     26  0ceb		       a9 ff		      lda	#$FF
