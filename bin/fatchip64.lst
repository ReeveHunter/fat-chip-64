------- FILE sync.asm LEVEL 2 PASS 3
      0  5ad9					      include	"sync.asm"
      1  5ad9							; Fat Chip 64 - device sync (v0.13): MIDI in (v0.67: any controller; it was
      2  5ad9							; the Yamaha SHS-10's page, whose own parts - its rhythm on channel 16 and its
      3  5ad9							; style buttons - are gone: git tag shs10-last) and Synthcart
      4  5ad9							;
      5  5ad9							; Menu, MIDI IN (defaults first), as it was for the keytar:
      6  5ad9							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      7  5ad9							;		     KEYTAR: MIDI clock (24 a beat, sent even while stopped)
      8  5ad9							;		     sets the tempo, averaged over beats (the clock jitters about
      9  5ad9							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
     10  5ad9							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
     11  5ad9							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     12  5ad9							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     13  5ad9							;		     (a start waits for the next beat clock: step 1 lands on it)
     14  5ad9							;   PROGRAM CHANGE  PICK PATCH / IGNORE: Program Change 0-24 picks bank slot
     15  5ad9							;		     n (bank n / 5, slot n mod 5)
     16  5ad9							;   PITCH WHEEL     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     17  5ad9							;   CC 1 / CC 65 / CC 64  an action each (the keytar's vibrato / portamento /
     18  5ad9							;		     sustain buttons;
     19  5ad9							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  5ad9							;
     21  5ad9							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  5ad9							; 1/4 ms); a Start makes the next clock a beat.
     23  5ad9
     24  5ad9		       00 00	   TEMPO_KEYTAR equ	0
     25  5ad9		       00 01	   TEMPO_OWN  equ	1
     26  5ad9		       00 02	   TEMPO_SC   equ	2
     27  5ad9		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  5ad9
     29  5ad9
     30  5ad9
