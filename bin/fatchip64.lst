    401  405a							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    402  405a							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    403  405a							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    404  405a							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    405  405a		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    406  405e		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    407  4065		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
