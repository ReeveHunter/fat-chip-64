     71  0c22		       0a 0b	   irqHi      .byte.b	>Irq, >IrqMidi
     72  0c24		       ff ff	   latchLo    .byte.b	<TICK_LATCH, <TICK_LATCH_MS
     73  0c26		       00 03	   latchHi    .byte.b	>TICK_LATCH, >TICK_LATCH_MS
     74  0c28
     75  0c28							; IRQ: send one wire byte if the ACIA is ready.
     76  0c28				   TxByte
     77  0c28					      subroutine
     78  0c28		       a6 16		      ldx	wireTail
     79  0c2a		       e4 15		      cpx	wireHead
     80  0c2c		       f0 0f		      beq	.done
     81  0c2e		       ad 06 de 	      lda	ACIA_STAT
     82  0c31		       29 02		      and	#ACIA_TDRE
     83  0c33		       f0 08		      beq	.done
     84  0c35		       bd 00 c4 	      lda	wireBuf,x
