------- FILE nesenv.asm LEVEL 2 PASS 3
      0  23c3					      include	"nesenv.asm"
      1  23c3							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  23c3							;
      3  23c3							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  23c3							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  23c3							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  23c3							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  23c3							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  23c3							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  23c3							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  23c3							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  23c3							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  23c3							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  23c3							; would wrap to a high pitch).
     14  23c3							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  23c3
     16  23c3							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  23c3							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  23c3							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  23c3							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  23c3							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  23c3		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  23c3		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  23c3							; NES channels too, and can't take a bend every 4 ms
     24  23c3		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  23c3		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  23c3
     27  23c3							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  23c3		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  23cc		       02 05	   slotVoice  .byte.b	2,5
     30  23ce
     31  23ce							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  23ce							; note keeps sounding for now). X = voice (= t0).
     33  23ce				   NesSoftRelease
     34  23ce					      subroutine
     35  23ce		       4c d3 23 	      jmp	.go
     36  23d1				   .nope
     37  23d1		       18		      clc
     38  23d2		       60		      rts
     39  23d3				   .go
     40  23d3		       ad 46 c4 	      lda	nesEnvOn
     41  23d6		       f0 f9		      beq	.nope
     42  23d8		       ad 8f c3 	      lda	muteNow
     43  23db		       0d ca c3 	      ora	hardCut
     44  23de		       d0 f1		      bne	.nope
     45  23e0		       ad 27 c3 	      lda	devOn+DEV_NES
     46  23e3		       f0 ec		      beq	.nope
     47  23e5		       bd ce 73 	      lda	vDev,x
     48  23e8		       c9 02		      cmp	#DEV_NES
     49  23ea		       d0 7c		      bne	.no
     50  23ec		       bd 96 c3 	      lda	vOut,x
     51  23ef		       c9 ff		      cmp	#NO_NOTE
     52  23f1		       f0 75		      beq	.no
     53  23f3		       bc c3 23 	      ldy	vEnvSlot,x
     54  23f6		       30 3e		      bmi	.tri
     55  23f8							; pulse: release from the current level; step = level x factor / 4 + 1
     56  23f8							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  23f8							; about 2 s). Factor 0: no release, cut.
     58  23f8		       ad 69 c4 	      lda	envRelV
     59  23fb		       f0 6b		      beq	.no
     60  23fd		       86 26		      stx	t2
     61  23ff		       84 27		      sty	t3
