------- FILE main.asm
------- FILE viz.asm LEVEL 2 PASS 3
      0  5e9d					      include	"viz.asm"
      1  5e9d							; Fat Chip 64 - the visualizers (F7: BARS, GLITCH, back to play), demos
      2  5e9d							;
      3  5e9d							; BARS:
      4  5e9d							; Nine bars, one per voice, in three groups: SID, Game Boy, MidiNES. A new
      5  5e9d							; note throws its bar to the top; it falls back to a height set by the
      6  5e9d							; note's pitch (higher notes stand taller) while the note sounds, and to
      7  5e9d							; nothing when it stops. The tremolo makes the bars breathe. Each bar takes
      8  5e9d							; the colour of its note's pitch class (C red ... B white). Kick drums flash
      9  5e9d							; the border in the key's colour; row 24 has the sound, the tempo and, while
     10  5e9d							; a beat plays, which beat of the bar it's on.
     11  5e9d							;
     12  5e9d							; One bar is drawn per screen step (about every 8 ms), so the screen stays
     13  5e9d							; out of the way of the keyboard and the arp: about 13 frames a second.
     14  5e9d							;
     15  5e9d							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
     16  5e9d							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
     17  5e9d							; keep spattering more; runs of the screen get copied over other places
     18  5e9d							; (datamosh) and wiped away, so it fills while you play and dissolves when
     19  5e9d							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
     20  5e9d							; the background. VINYL STOP drags it down the screen.
     21  5e9d
     22  5e9d		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     23  5e9d		       00 16	   VIZ_NAMES  equ	22	; note names
     24  5e9d		       00 a0	   VIZ_FULL   equ	160	; reversed space
     25  5e9d		       00 62	   VIZ_HALF   equ	98	; lower half block
     26  5e9d
