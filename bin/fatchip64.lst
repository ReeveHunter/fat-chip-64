     82  0f20		       a9 00		      lda	#0
     83  0f22		       8d 39 c3 	      sta	ksRow
     84  0f25				   .pb
     85  0f25		       ad 37 c3 	      lda	ksBits
     86  0f28		       f0 49		      beq	.pcn
     87  0f2a		       4e 37 c3 	      lsr	ksBits
     88  0f2d		       90 3f		      bcc	.pbn
     89  0f2f		       ad 3c c3 	      lda	ghostFilter
     90  0f32		       d0 0c		      bne	.chk	; filter off (default): phantom notes play...
     91  0f34		       20 9e 0f 	      jsr	KeyCode
     92  0f37		       c9 18		      cmp	#24
     93  0f39		       90 0a		      bcc	.accept
     94  0f3b		       20 87 0f 	      jsr	IsModifier
     95  0f3e		       f0 05		      beq	.accept
     96  0f40				   .chk 		; ...but a command key never comes from a phantom
     97  0f40		       20 ac 0f 	      jsr	Suspect	;  (v0.40: Q + E held, then C=, read C= + S too)
     98  0f43		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     99  0f45				   .accept
    100  0f45		       20 9e 0f 	      jsr	KeyCode
    101  0f48		       20 87 0f 	      jsr	IsModifier	; Z set = modifier
    102  0f4b		       f0 07		      beq	.mod
    103  0f4d		       ad 3b c3 	      lda	ksPass
    104  0f50		       f0 1c		      beq	.pbn	; pass 0: modifiers only
    105  0f52		       d0 05		      bne	.take
    106  0f54				   .mod
    107  0f54		       ad 3b c3 	      lda	ksPass
    108  0f57		       d0 15		      bne	.pbn	; (taken in pass 0)
    109  0f59				   .take
    110  0f59		       ae 38 c3 	      ldx	ksCol
    111  0f5c		       ac 39 c3 	      ldy	ksRow
    112  0f5f		       b9 aa 7d 	      lda	rowBit,y
    113  0f62		       1d 90 c2 	      ora	keyAcc,x
    114  0f65		       9d 90 c2 	      sta	keyAcc,x
    115  0f68		       20 9e 0f 	      jsr	KeyCode
    116  0f6b		       20 dd 0f 	      jsr	KeyDown
    117  0f6e				   .pbn
    118  0f6e		       ee 39 c3 	      inc	ksRow
    119  0f71		       d0 b2		      bne	.pb
    120  0f73				   .pcn
    121  0f73		       ae 38 c3 	      ldx	ksCol
    122  0f76		       e8		      inx
    123  0f77		       e0 08		      cpx	#8
    124  0f79		       d0 97		      bne	.pc
    125  0f7b		       ad 3b c3 	      lda	ksPass
    126  0f7e		       d0 06		      bne	.done
    127  0f80		       ee 3b c3 	      inc	ksPass
    128  0f83		       4c 10 0f 	      jmp	.pass
    129  0f86				   .done
    130  0f86		       60		      rts
    131  0f87
    132  0f87							; Z set if key code A is a modifier. Keeps A.
    133  0f87				   IsModifier
    134  0f87		       c9 88		      cmp	#K_LSHIFT
    135  0f89		       f0 12		      beq	.y
    136  0f8b		       c9 89		      cmp	#K_RSHIFT
    137  0f8d		       f0 0e		      beq	.y
    138  0f8f		       c9 8c		      cmp	#K_CTRL
    139  0f91		       f0 0a		      beq	.y
    140  0f93		       c9 a2		      cmp	#K_CBM
    141  0f95		       f0 06		      beq	.y
    142  0f97		       c9 a3		      cmp	#K_STOP
    143  0f99		       f0 02		      beq	.y
    144  0f9b		       c9 9a		      cmp	#K_K
    145  0f9d				   .y
