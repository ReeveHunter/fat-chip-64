    102  0bd0
    103  0bd0							; IRQ: pace device queues onto the wire.
    104  0bd0							;
    105  0bd0							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0bd0							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0bd0							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0bd0							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0bd0							;
    110  0bd0							; When the Game Boy is on, everything on the wire also passes through the
    111  0bd0							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0bd0							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0bd0							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0bd0							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0bd0							; message, the rate measured clean.
    116  0bd0				   Schedule
    117  0bd0					      subroutine
    118  0bd0		       ad 26 c3 	      lda	devOn+DEV_GB
    119  0bd3		       f0 10		      beq	.gb
    120  0bd5		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0bd7		       f0 0c		      beq	.gb
    122  0bd9		       c6 2e		      dec	linkLoad
    123  0bdb		       f0 08		      beq	.gb
    124  0bdd		       a5 10		      lda	ticks
    125  0bdf		       29 01		      and	#1
    126  0be1		       f0 02		      beq	.gb
    127  0be3		       c6 2e		      dec	linkLoad
    128  0be5				   .gb
    129  0be5							; ---- Game Boy
    130  0be5		       a5 18		      lda	gbqTail
    131  0be7		       c5 17		      cmp	gbqHead
    132  0be9		       f0 36		      beq	.nes
    133  0beb		       a5 19		      lda	gbNext
    134  0bed		       38		      sec
    135  0bee		       e5 10		      sbc	ticks
    136  0bf0		       f0 04		      beq	.gbDue
    137  0bf2		       c9 04		      cmp	#GB_GAP+1
    138  0bf4		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0bf6				   .gbDue
    140  0bf6							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0bf6							; bytes already waiting would otherwise delay this one and squeeze it
    142  0bf6							; against the next). While a Game Boy message is due, the NES doesn't
    143  0bf6							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0bf6							; holding its notes back.
    145  0bf6		       a5 15		      lda	wireHead
    146  0bf8		       c5 16		      cmp	wireTail
    147  0bfa		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0bfc		       20 62 0c 	      jsr	LinkRoom
    149  0bff		       90 20		      bcc	.nes
    150  0c01		       a6 18		      ldx	gbqTail
    151  0c03		       bd 00 c1 	      lda	gbqS,x
    152  0c06		       bc 80 c1 	      ldy	gbqD2,x
    153  0c09		       84 2c		      sty	irqT
    154  0c0b		       bc 40 c1 	      ldy	gbqD1,x
    155  0c0e		       20 7e 0c 	      jsr	WireMsg
    156  0c11		       a5 18		      lda	gbqTail
    157  0c13		       18		      clc
    158  0c14		       69 01		      adc	#1
    159  0c16		       29 3f		      and	#63
    160  0c18		       85 18		      sta	gbqTail
    161  0c1a		       a5 10		      lda	ticks
    162  0c1c		       18		      clc
    163  0c1d		       69 03		      adc	#GB_GAP
    164  0c1f		       85 19		      sta	gbNext
    165  0c21				   .nes
    166  0c21		       20 da 2e 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0c24		       a5 1b		      lda	nesqTail
    168  0c26		       c5 1a		      cmp	nesqHead
    169  0c28		       f0 37		      beq	.done
    170  0c2a		       a5 1c		      lda	nesNext
    171  0c2c		       38		      sec
    172  0c2d		       e5 10		      sbc	ticks
    173  0c2f		       f0 04		      beq	.nesDue
    174  0c31		       c9 02		      cmp	#NES_GAP+1
    175  0c33		       90 2c		      bcc	.done
    176  0c35				   .nesDue
    177  0c35		       20 75 0c 	      jsr	WireFree
    178  0c38		       c9 03		      cmp	#3
    179  0c3a		       90 25		      bcc	.done
    180  0c3c		       20 62 0c 	      jsr	LinkRoom
    181  0c3f		       90 20		      bcc	.done
    182  0c41		       a6 1b		      ldx	nesqTail
    183  0c43		       bd c0 c1 	      lda	nesqS,x
    184  0c46		       bc 40 c2 	      ldy	nesqD2,x
    185  0c49		       84 2c		      sty	irqT
    186  0c4b		       bc 00 c2 	      ldy	nesqD1,x
    187  0c4e		       20 7e 0c 	      jsr	WireMsg
    188  0c51		       a5 1b		      lda	nesqTail
    189  0c53		       18		      clc
    190  0c54		       69 01		      adc	#1
    191  0c56		       29 3f		      and	#63
    192  0c58		       85 1b		      sta	nesqTail
    193  0c5a		       a5 10		      lda	ticks
    194  0c5c		       18		      clc
    195  0c5d		       69 01		      adc	#NES_GAP
    196  0c5f		       85 1c		      sta	nesNext
    197  0c61				   .done
    198  0c61		       60		      rts
