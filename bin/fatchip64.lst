------- FILE menu.asm LEVEL 2 PASS 3
      0  4e89					      include	"menu.asm"
      1  4e89							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  4e89							;
      3  4e89							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  4e89							;   page   RETURN opens a page
      5  4e89							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  4e89							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  4e89							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  4e89							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  4e89							; device pages, until DEVICES says the device is in use).
     10  4e89							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  4e89							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  4e89							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  4e89
     14  4e89		       00 17	   MENU_VALCOL equ	23
     15  4e89
     16  4e89				   MenuOpen
     17  4e89		       20 7b 6a 	      jsr	GlitchCalm	; (GLITCH may have the picture shaking)
