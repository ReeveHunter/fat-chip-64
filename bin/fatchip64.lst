    457  4140		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    458  4144		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    459  4148		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
