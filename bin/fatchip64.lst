    387  39a7		       48 50 54 58*gbVibRateT .byte.b	72, 80, 84, 88, 92, 96, 100
    388  39ae		       00 08 10 20*gbVibDelT  .byte.b	0, 8, 16, 32, 64
    389  39b3		       10 20 30 40 gbGlideT   .byte.b	16, 32, 48, 64
