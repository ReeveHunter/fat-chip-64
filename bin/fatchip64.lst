    422  0b41							; With the MIDI chip's interrupts (midiIrq, v0.16): the chip interrupts when
    423  0b41							; a byte has come in or the next can go out; the CIA timer ticks each ms.
    424  0b41				   IrqMidi
    425  0b41					      subroutine
    426  0b41		       48		      pha
    427  0b42		       8a		      txa
    428  0b43		       48		      pha
    429  0b44		       ad 06 de 	      lda	ACIA_STAT
    430  0b47		       10 23		      bpl	.tim	; (not the MIDI chip)
    431  0b49		       4a		      lsr		; a byte in?
    432  0b4a		       90 03		      bcc	.tx
    433  0b4c		       20 84 32 	      jsr	RxGot
    434  0b4f				   .tx
    435  0b4f		       ad 06 de 	      lda	ACIA_STAT
    436  0b52		       29 02		      and	#ACIA_TDRE
    437  0b54		       f0 16		      beq	.tim
    438  0b56		       a6 16		      ldx	wireTail
    439  0b58		       e4 15		      cpx	wireHead
    440  0b5a		       f0 0b		      beq	.quiet
    441  0b5c		       bd 00 c0 	      lda	wireBuf,x
    442  0b5f		       8d 05 de 	      sta	ACIA_TX
    443  0b62		       e6 16		      inc	wireTail
    444  0b64		       4c 6c 0b 	      jmp	.tim
    445  0b67				   .quiet
    446  0b67		       a9 96		      lda	#ACIA_MODE_RX	; nothing to send: no more "ready" interrupts
    447  0b69		       8d 04 de 	      sta	ACIA_CTRL
    448  0b6c				   .tim
    449  0b6c		       ad 0d dc 	      lda	CIA1_ICR	; the 1 ms tick?
    450  0b6f		       4a		      lsr
    451  0b70		       90 16		      bcc	.out
    452  0b72		       98		      tya
    453  0b73		       48		      pha
    454  0b74		       e6 10		      inc	ticks
    455  0b76		       d0 02		      bne	.t
    456  0b78		       e6 11		      inc	ticks+1
    457  0b7a				   .t
    458  0b7a		       20 3d 0c 	      jsr	Schedule
    459  0b7d		       20 7e 32 	      jsr	RxByte	; (a long tick: a byte may be waiting, and
    460  0b80		       20 18 0c 	      jsr	TxByte	;  the MIDI chip holds only one)
    461  0b83		       20 7e 32 	      jsr	RxByte
    462  0b86		       68		      pla
    463  0b87		       a8		      tay
