    457  654a		       aa		      tax
    458  654b		       ad 55 c8 	      lda	fineTune
    459  654e		       38		      sec
    460  654f		       e9 32		      sbc	#50
    461  6551		       18		      clc
    462  6552		       7d 68 66 	      adc	scCents,x
    463  6555		       50 00		      bvc	.c	; (can't overflow: -85..+60)
    464  6557				   .c
    465  6557		       cd 56 c8 	      cmp	tuneC
    466  655a		       f0 1b		      beq	.k
    467  655c		       8d 56 c8 	      sta	tuneC
    468  655f		       20 90 65 	      jsr	TuneUnits
    469  6562		       ae 58 c8 	      ldx	gbTune
    470  6565		       a9 67		      lda	#GCC_TUNE
    471  6567		       20 50 0d 	      jsr	GbGlobal
    472  656a		       a9 08		      lda	#8
    473  656c		       8d 2e c5 	      sta	nfxRun	; (the NES bends again)
    474  656f		       a9 00		      lda	#0
    475  6571		       8d 5d c8 	      sta	vsGlide
    476  6574		       20 c8 3d 	      jsr	SidRetune	; (the SID's notes sounding: there at once)
    477  6577				   .k
    478  6577		       ae 54 c8 	      ldx	tuneNow
    479  657a		       f0 13		      beq	.x
    480  657c		       ad 50 c8 	      lda	scKey
