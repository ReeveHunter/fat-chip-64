------- FILE sync.asm LEVEL 2 PASS 3
      0  46ed					      include	"sync.asm"
      1  46ed							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  46ed							;
      3  46ed							; Menu, DEVICE SYNC (defaults first):
      4  46ed							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  46ed							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  46ed							;		     sets the tempo, averaged over beats (the clock jitters about
      7  46ed							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  46ed							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  46ed							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  46ed							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  46ed							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  46ed							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  46ed							;		     picks a beat demo (styleBeat)
     14  46ed							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  46ed							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  46ed							;		     key channel) picks a sound (voiceSound)
     17  46ed							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  46ed							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  46ed							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  46ed							;
     21  46ed							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  46ed							; 1/4 ms); a Start makes the next clock a beat.
     23  46ed
     24  46ed		       00 00	   TEMPO_KEYTAR equ	0
     25  46ed		       00 01	   TEMPO_OWN  equ	1
     26  46ed		       00 02	   TEMPO_SC   equ	2
     27  46ed		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  46ed
     29  46ed
     30  46ed
     31  46ed							; ------------------------------------------------------------ clock
     32  46ed							; Main loop, every pass
