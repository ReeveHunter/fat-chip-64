     43  5a9e		       b9 c1 5a 	      lda	rowAddrHi,y
     44  5aa1		       69 00		      adc	#0
     45  5aa3		       85 2b		      sta	ptr2+1
     46  5aa5		       a0 00		      ldy	#0	; (callers expect Y = 0, as the old loop left it)
     47  5aa7		       60		      rts
     48  5aa8				   rowAddrLo
     49  5aa8		       00 28 50 78*	      .byte.b	<(SCREEN+0),<(SCREEN+40),<(SCREEN+80),<(SCREEN+120),<(SCREEN+160),<(SCREEN+200),<(SCREEN+240),<(SCREEN+280),<(SCREEN+320),<(SCREEN+360),<(SCREEN+400),<(SCREEN+440),<(SCREEN+480),<(SCREEN+520),<(SCREEN+560),<(SCREEN+600),<(SCREEN+640),<(SCREEN+680),<(SCREEN+720),<(SCREEN+760),<(SCREEN+800),<(SCREEN+840),<(SCREEN+880),<(SCREEN+920),<(SCREEN+960)
     50  5ac1				   rowAddrHi
     51  5ac1		       04 04 04 04*	      .byte.b	>(SCREEN+0),>(SCREEN+40),>(SCREEN+80),>(SCREEN+120),>(SCREEN+160),>(SCREEN+200),>(SCREEN+240),>(SCREEN+280),>(SCREEN+320),>(SCREEN+360),>(SCREEN+400),>(SCREEN+440),>(SCREEN+480),>(SCREEN+520),>(SCREEN+560),>(SCREEN+600),>(SCREEN+640),>(SCREEN+680),>(SCREEN+720),>(SCREEN+760),>(SCREEN+800),>(SCREEN+840),>(SCREEN+880),>(SCREEN+920),>(SCREEN+960)
     52  5ada
     53  5ada							; macro-ish helper: PRINT row, col, label
