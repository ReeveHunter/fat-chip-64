     82  3d5f		       0a		      asl
     83  3d60		       85 26		      sta	t2
     84  3d62		       0a		      asl
     85  3d63		       65 26		      adc	t2
     86  3d65		       65 25		      adc	t1
     87  3d67		       aa		      tax
     88  3d68		       bd f2 77 	      lda	kits,x
     89  3d6b		       85 25		      sta	t1
     90  3d6d							; bank (CC14 on the sample channel) when it changes
     91  3d6d		       a9 04		      lda	#4
     92  3d6f		       20 c7 3d 	      jsr	NesChStatus	; mS = CC, sample channel
     93  3d72		       a9 00		      lda	#0
     94  3d74		       a6 25		      ldx	t1
     95  3d76		       10 02		      bpl	.a
     96  3d78		       a9 7f		      lda	#127
     97  3d7a				   .a
     98  3d7a		       cd 78 c4 	      cmp	dmcBank
     99  3d7d		       f0 0c		      beq	.note
    100  3d7f		       8d 78 c4 	      sta	dmcBank
    101  3d82		       85 23		      sta	mD2
    102  3d84		       a9 0e		      lda	#14
    103  3d86		       85 22		      sta	mD1
    104  3d88		       20 ac 0c 	      jsr	NesPut
    105  3d8b				   .note
    106  3d8b		       a5 21		      lda	mS
    107  3d8d		       29 0f		      and	#$0F
    108  3d8f		       85 26		      sta	t2	; channel
    109  3d91		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    110  3d93							;  cuts it anyway, and the hit lands 1 ms sooner)
    111  3d93		       29 7f		      and	#$7F
    112  3d95		       8d 85 c4 	      sta	dmcNote
    113  3d98		       85 22		      sta	mD1
    114  3d9a		       a5 26		      lda	t2
