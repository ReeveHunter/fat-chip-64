    469  5eec		       20 4c 0d 	      jsr	GbGlobal
    470  5eef		       a9 08		      lda	#8
    471  5ef1		       8d 2d c5 	      sta	nfxRun	; (the NES bends again)
    472  5ef4		       a9 00		      lda	#0
    473  5ef6		       8d 5c c8 	      sta	vsGlide
    474  5ef9		       20 8b 38 	      jsr	SidRetune	; (the SID's notes sounding: there at once)
