------- FILE main.asm
    554  dedc				   hiEnd
    555  dedc							; v0.66: under the KERNAL, past its tables (cleared at start): each patch
    556  dedc							; setting's step when its effect was last switched off, and per effect
    557  dedc							; whether that's been kept (patchedit.asm FxOff / FxOn)
    558  dedc		       fc c8	   fxMem      equ	hiEnd
    559  dedc		       fd 08	   fxMemOk    equ	hiEnd+64
    560  dedc							; v0.68: the sampler's (sampler.asm), cleared at start too
    561  dedc		       fd 18	   SMP	      equ	fxMemOk+16
    562  dedc		       fd 18	   smpOn      equ	SMP+0	; 1: the sampler's screen and keys
    563  dedc		       fd 19	   smpInit    equ	SMP+1	; kit 1 made from the beat's kit
    564  dedc		       fd 1a	   smpArm     equ	SMP+2	; RETURN: the next pad gets the browser's sample
    565  dedc		       fd 1b	   smpKit     equ	SMP+3	; 0 / 1: kit 1 / 2
    566  dedc		       fd 1c	   smpSel     equ	SMP+4	; the browser's sample (bit 7: bank B)
    567  dedc		       fd 1d	   smpRate    equ	SMP+5	; its rate, 0-15
    568  dedc		       fd 1e	   smpFilt    equ	SMP+6	; TYPE: 0 ALL, 1-8 K S H P L T F V
    569  dedc		       fd 1f	   padKeys    equ	SMP+7	; PAD KEYS: 0 GRID, 1 OVERLAY
    570  dedc		       fd 20	   padCh      equ	SMP+8	; PAD MIDI CHANNEL: 0 OFF, 1-16
    571  dedc		       fd 21	   padBase    equ	SMP+9	; PAD BASE NOTE
    572  dedc		       fd 22	   dmcRate    equ	SMP+10	; the MidiNES's sample rate (CC 3) last sent
    573  dedc		       fd 23	   padLitP    equ	SMP+11	; the lit pad ($FF none), since padLitT
    574  dedc		       fd 24	   padLitT    equ	SMP+12
    575  dedc		       fd 25	   padVel     equ	SMP+13
    576  dedc		       fd 26	   padNow     equ	SMP+14
    577  dedc		       fd 27	   padCC      equ	SMP+15
    578  dedc		       fd 28	   padLane    equ	SMP+16
    579  dedc		       fd 29	   smpCode    equ	SMP+17
    580  dedc		       fd 2a	   smpTmp     equ	SMP+18
    581  dedc		       fd 2b	   smpI       equ	SMP+19
    582  dedc		       fd 2c	   smpN       equ	SMP+20
    583  dedc		       fd 2d	   smpX       equ	SMP+21
    584  dedc		       fd 2e	   smpY       equ	SMP+22
    585  dedc		       fd 2f	   smpR       equ	SMP+23
    586  dedc		       fd 30	   smpS       equ	SMP+24
    587  dedc		       fd 31	   smpX2      equ	SMP+25
    588  dedc		       fd 32	   smpN2      equ	SMP+26
    589  dedc		       fd 33	   smpTaken   equ	SMP+27	; 8: the keys whose press the sampler took
    590  dedc		       fd 3b	   puOff      equ	SMP+35	; (v0.69: PatchUnpack's)
    591  dedc		       fd 3c	   puSrc      equ	SMP+36
    592  dedc		       fd 40	   padKit     equ	SMP+40	; 2 kits x 16 pads x (sample or $FF, rate)
    593  dedc							; v0.69: the looper's (looper.asm)
    594  dedc		       fd 80	   LPV	      equ	SMP+104
    595  dedc		       fd 80	   lpSel      equ	LPV+0	; the track the keys work
    596  dedc		       fd 81	   lpQnt      equ	LPV+1	; QUANTIZE: 0 OFF, 1 1/16, 2 1/8
    597  dedc		       fd 82	   lpPh       equ	LPV+2	; the clock in its bar, 0-95
    598  dedc		       fd 83	   lpAtL      equ	LPV+3	; its next tick (ms)
    599  dedc		       fd 84	   lpAtH      equ	LPV+4
    600  dedc		       fd 85	   lpFrac     equ	LPV+5
    601  dedc		       fd 86	   lpRel      equ	LPV+6	; ticks left this beat step (a beat going)
    602  dedc		       fd 87	   lpBeatCue  equ	LPV+7	; a beat to start at the next bar
    603  dedc		       fd 88	   lpDirty    equ	LPV+8
    604  dedc		       fd 89	   lpT	      equ	LPV+9
    605  dedc		       fd 8a	   lpT2       equ	LPV+10
    606  dedc		       fd 8b	   lpI	      equ	LPV+11
    607  dedc		       fd 8c	   lpQn       equ	LPV+12
    608  dedc		       fd 8d	   lpQd       equ	LPV+13
    609  dedc		       fd 8e	   lpSk       equ	LPV+14
    610  dedc		       fd 8f	   lpMute     equ	LPV+15	; a bit a track
    611  dedc		       fd 90	   lpTapK     equ	LPV+16	; the last button pressed, when (F5 twice: stop)
    612  dedc		       fd 91	   lpTapL     equ	LPV+17
    613  dedc		       fd 92	   lpTapH     equ	LPV+18
    614  dedc		       fd 93	   evL	      equ	LPV+19
    615  dedc		       fd 94	   evH	      equ	LPV+20
    616  dedc		       fd 95	   evP	      equ	LPV+21
    617  dedc		       fd 96	   nwL	      equ	LPV+22
    618  dedc		       fd 97	   nwH	      equ	LPV+23
    619  dedc		       fd 98	   nwP	      equ	LPV+24
    620  dedc		       fd 99	   lpQ	      equ	LPV+25	; 8: hits due this tick
    621  dedc		       fd a1	   trkSt      equ	LPV+33	; 6 each: state (LP_*)
    622  dedc		       fd a7	   trkLenL    equ	LPV+39	;  length in ticks
    623  dedc		       fd ad	   trkLenH    equ	LPV+45
    624  dedc		       fd b3	   trkPosL    equ	LPV+51	;  where it is
    625  dedc		       fd b9	   trkPosH    equ	LPV+57
    626  dedc		       fd bf	   trkCnt     equ	LPV+63	;  hits
    627  dedc		       fd c5	   trkCur     equ	LPV+69	;  the next to play
    628  dedc		       fd cb	   trkUndo    equ	LPV+75	;  0, 1 an overdub kept, 2 undone
    629  dedc		       fd d1	   lpB16L     equ	LPV+81	; the tempo the tick was worked out for, and it
    630  dedc		       fd d2	   lpB16H     equ	LPV+82
    631  dedc		       fd d3	   lpTkL      equ	LPV+83
    632  dedc		       fd d4	   lpTkH      equ	LPV+84
    633  dedc		       fd d5	   lpAny      equ	LPV+85	; the clock's awake (LoopAny)
    634  dedc		       fd d6	   SMP_END    equ	LPV+86
    635  dedc				  -	      if	SMP_END - fxMemOk > 255
    636  dedc				  -	      echo	"the variables under the KERNAL: more than InitState clears"
    637  dedc				  -	      err
    638  dedc					      endif
    639  dedc				  -	      if	SMP_END > $FFF0
    640  dedc				  -	      echo	"fxMem runs into the vectors"
    641  dedc				  -	      err
    642  dedc					      endif
    643  dedc					      rend
    644  dedc				  -	      if	hiEnd > $FFFA
    645  dedc				  -	      echo	"the $E000 tables run into the CPU's vectors"
    646  dedc				  -	      err
    647  dedc					      endif
    648  dedc
    649  dedc							; ---- v0.60: data in the RAM under the I/O ($D000-$DFFF): packed apart too,
    650  dedc							; unpacked there with the I/O switched out; read with BeatLoad's copy
    651  dedc				   ioPhys
    652  dedc					      rorg	$D000
    653  dedc				   ioStart
