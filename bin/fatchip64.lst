------- FILE lead.asm LEVEL 2 PASS 3
      0  74ff					      include	"lead.asm"
      1  74ff							; Fat Chip 64 - CHORD + LEAD (v0.28): a chord and a lead at once, each its
      2  74ff							; own patch.
      3  74ff							;   BASS      (was LOW NOTE) the first key pressed is the chord's root
      4  74ff							;	       (POLY: just it; SMART CHORD: its 5TH, TRIAD...; DRONE: the
      5  74ff							;	       drone); every other key is the lead, while the chord key is held
      6  74ff							;   TRIAD     (was LATCH 3) three keys pressed together are the chord while
      7  74ff							;	       they're held (v0.36: with LATCH on, it keeps sounding after you
      8  74ff							;	       let go); every other key is the lead.
      9  74ff							; v0.36: the lead is LEAD OCTAVE up in every mode (+1 at first; SHIFT + F1 /
     10  74ff							; F3; v0.43: One Key Play too). v0.43: SHIFT + F5 SPLIT on / off, SHIFT + F7
     11  74ff							; its mode, SHIFT + K then a note: the split point. LATCH holds KEY's chord side and TRIAD's chord.
     12  74ff							; The lead is one note (the last key pressed) on one voice per chip (SID 3,
     13  74ff							; Game Boy pulse 1, NES pulse 1), only while it plays: the rest of the time
     14  74ff							; those voices are the chord's. Its patch: SHIFT + A S D F G / Z X C V B.
     15  74ff							; The lead's own: the SID's waveform, width, envelope and octave, the Game
     16  74ff							; Boy pulse's CCs, the NES pulse's duty. Shared with the chord: the effects
     17  74ff							; (vibrato, filter, tremolo...), the NES envelope.
     18  74ff
     19  74ff							;   KEY       (v0.32) a keyboard split: keys below the split point are the
     20  74ff							;	       chord (as the mode plays them), keys from it up the lead (LEAD
     21  74ff							;	       OCTAVE, +1 at first). On the C64's keys the split is a key (it
     22  74ff							;	       stays put when the octave changes); over MIDI, a note as sent
     23  74ff							;	       (before MIDI IN OCTAVE). SHIFT + F5 held + a note sets either.
     24  74ff		       00 01	   CL_KEY     equ	1	; SPLIT (clMode)
     25  74ff		       00 02	   CL_BASS    equ	2
     26  74ff		       00 03	   CL_L3      equ	3	; (TRIAD)
     27  74ff		       00 06	   LEAD_SID   equ	6	; the lead's voices: SID 3, GB pulse 1, NES pulse 1
     28  74ff		       00 01	   LEAD_GB    equ	1
     29  74ff		       00 02	   LEAD_NES   equ	2
     30  74ff
