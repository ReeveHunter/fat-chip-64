    396  3dcc							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    397  3dcc							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    398  3dcc							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    399  3dcc							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    400  3dcc		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    401  3dd0		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    402  3dd7		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    403  3dde		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    404  3de3		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    405  3de7		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    406  3deb		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
    407  3df0		       05 0a 0f 14*uTremRH    .byte.b	>1311, >2621, >3932, >5243, >6554
    408  3df5		       04 08 0c 10 uDetT      .byte.b	4, 8, 12, 16
    409  3df9		       18 38 64    uWarbT     .byte.b	24, 56, 100
    410  3dfc							; ... and the Game Boy's CCs for them (LFO depth CC 1, rate CC 76, delay
    411  3dfc							; CC 79, glide CC 5, detune +- from 64 on CC 94)
