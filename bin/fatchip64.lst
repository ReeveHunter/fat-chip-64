------- FILE bend.asm LEVEL 2 PASS 2
      0  1fde					      include	"bend.asm"
      1  1fde							; Fat Chip 64 - SPACE modes and the SPACE bend (v0.10)
      2  1fde							;
      3  1fde							; , and . (the < > keys) pick what SPACE does:
      4  1fde							;   MUTES  (default) held = the mute flips (the momentary mute / play key)
      5  1fde							;   BENDS  held = everything bends down 2 semitones over about 1 s;
      6  1fde							;	    let go and it comes back up over about 0.5 s
      7  1fde							;
      8  1fde							; bendLvl 0-255 is the depth (255 = 2 semitones down).
      9  1fde							;   SID       frequency x (1 - k / 256), k = lvl / 8 - lvl / 64 (max 28: 0.891,
     10  1fde							;	       2 semitones), every change (4 ms steps)
     11  1fde							;   Game Boy  pitch bend on its three channels (Fat Chip GB bend range is
     12  1fde							;	       2 semitones): 8192 - lvl x 32, every BEND_TICK ms
     13  1fde							;   MidiNES   its bend moves the timer, so the amount depends on the note:
     14  1fde							;	       p(n) x lvl / 1024 for the triangle, twice that for the pulses
     15  1fde							;	       (p = the MidiNES triangle bend scale, 1710 at MIDI 36; 2 semitones
     16  1fde							;	       is p x 0.245, this is p x 0.249). Sent every BEND_TICK ms, and
     17  1fde							;	       before each new NES note while bent. Notes too near the bottom
     18  1fde							;	       of the NES range (the timer would wrap) don't bend.
     19  1fde
     20  1fde							; , : SPACE mode back
     21  1fde				   SpaceBack
     22  1fde					      subroutine
     23  1fde		       ae bd c3 	      ldx	spaceMode
     24  1fe1		       d0 02		      bne	.d
     25  1fe3		       a2 02		      ldx	#SPC_MODES
     26  1fe5				   .d
     27  1fe5		       ca		      dex
     28  1fe6		       4c f3 1f 	      jmp	SpaceSet
     29  1fe9
     30  1fe9							; . : SPACE mode on
     31  1fe9				   SpaceNext
     32  1fe9					      subroutine
     33  1fe9		       ae bd c3 	      ldx	spaceMode
     34  1fec		       e8		      inx
     35  1fed		       e0 02		      cpx	#SPC_MODES
     36  1fef		       90 02		      bcc	SpaceSet
     37  1ff1		       a2 00		      ldx	#0
     38  1ff3				   SpaceSet
     39  1ff3		       8e bd c3 	      stx	spaceMode
     40  1ff6		       a9 00		      lda	#0
     41  1ff8		       8d 77 c3 	      sta	moment	; a mute held in the old mode ends
     42  1ffb		       20 8e 10 	      jsr	MuteChanged
     43  1ffe		       4c 8a 0f 	      jmp	Dirty
