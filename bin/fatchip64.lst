------- FILE midiin.asm LEVEL 2 PASS 3
      0  2a5b					      include	"midiin.asm"
      1  2a5b							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  2a5b							;
      3  2a5b							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  2a5b							; The main loop parses them (running status; realtime and system bytes are
      5  2a5b							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  2a5b							; notes mode, latch, arp and K + note.
      7  2a5b							;
      8  2a5b							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  2a5b							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  2a5b							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  2a5b							;
     12  2a5b							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  2a5b							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  2a5b							;
     15  2a5b							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  2a5b							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  2a5b							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  2a5b							; MIDI in is passed on to the Game Boy or NES.
     19  2a5b
     20  2a5b							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  2a5b							; Uses A, X.
     22  2a5b							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  2a5b							; with the time; a Start ($FA) makes the next clock a beat.
     24  2a5b				   RxByte
     25  2a5b					      subroutine
     26  2a5b		       ad 06 de 	      lda	ACIA_STAT
     27  2a5e		       4a		      lsr		; RDRF -> carry
     28  2a5f		       90 2b		      bcc	.x
     29  2a61				   RxGot
     30  2a61		       ad 07 de 	      lda	ACIA_RX
     31  2a64		       c9 f8		      cmp	#$F8
     32  2a66		       f0 25		      beq	.clk
     33  2a68		       c9 fa		      cmp	#$FA
     34  2a6a		       d0 0e		      bne	.buf
     35  2a6c		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  2a6e		       8e e5 c5 	      stx	clkPhase
     37  2a71		       8e ed c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  2a74							;  the main loop could measure it)
     39  2a74		       ae e6 c5 	      ldx	clkBeat
     40  2a77		       8e f8 c5 	      stx	clkStartBeat
     41  2a7a				   .buf
     42  2a7a		       ae 25 c4 	      ldx	rxHead
     43  2a7d		       9d e5 c3 	      sta	rxBuf,x
     44  2a80		       e8		      inx
     45  2a81		       8a		      txa
     46  2a82		       29 3f		      and	#63
     47  2a84		       cd 26 c4 	      cmp	rxTail
     48  2a87		       f0 03		      beq	.x	; full: dropped
     49  2a89		       8d 25 c4 	      sta	rxHead
     50  2a8c				   .x
     51  2a8c		       60		      rts
     52  2a8d				   .clk
     53  2a8d		       ee e1 c5 	      inc	clkCount
     54  2a90		       ae e5 c5 	      ldx	clkPhase
     55  2a93		       e8		      inx
     56  2a94		       e0 18		      cpx	#24
     57  2a96		       90 1b		      bcc	.ph
     58  2a98		       a5 10		      lda	ticks
     59  2a9a		       8d e8 c5 	      sta	clkAtL
     60  2a9d		       a5 11		      lda	ticks+1
     61  2a9f		       8d e9 c5 	      sta	clkAtH
     62  2aa2		       a5 2d		      lda	subTick
     63  2aa4		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  2aa6		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  2aa8		       ad 05 dc 	      lda	CIA1_TAHI
     66  2aab				   .q
     67  2aab		       8d ea c5 	      sta	clkAtS
     68  2aae		       ee e6 c5 	      inc	clkBeat
     69  2ab1		       a2 00		      ldx	#0
     70  2ab3				   .ph
     71  2ab3		       8e e5 c5 	      stx	clkPhase
     72  2ab6		       60		      rts
