    150  0efb							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    151  0efb							; keys: some other column has a key in this row and shares another row with
    152  0efb							; this column.
    153  0efb				   Suspect
    154  0efb					      subroutine
    155  0efb		       ac 38 c3 	      ldy	ksRow
    156  0efe		       b9 25 69 	      lda	rowBit,y
    157  0f01		       49 ff		      eor	#$FF
    158  0f03		       ae 37 c3 	      ldx	ksCol
    159  0f06		       3d 80 c2 	      and	keyNow,x
    160  0f09		       8d 39 c3 	      sta	ksMask	; this column's other held rows
    161  0f0c		       f0 1c		      beq	.no
    162  0f0e		       a2 07		      ldx	#7
    163  0f10				   .c
    164  0f10		       ec 37 c3 	      cpx	ksCol
