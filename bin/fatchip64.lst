     54  1a26		       ad b6 c4 	      lda	vinylLvl	; VINYL STOP fades the SID out from 192
     55  1a29		       c9 c0		      cmp	#192
     56  1a2b		       90 08		      bcc	.full
     57  1a2d		       49 ff		      eor	#$FF	; (255 - lvl) / 4
     58  1a2f		       4a		      lsr
     59  1a30		       4a		      lsr
     60  1a31		       c9 10		      cmp	#16
     61  1a33		       90 06		      bcc	.z
