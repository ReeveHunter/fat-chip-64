------- FILE nesfx.asm LEVEL 2 PASS 3
      0  8554					      include	"nesfx.asm"
      1  8554							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  8554							;
      3  8554							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  8554							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  8554							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  8554							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  8554							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  8554							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  8554							;   glide    a new note starts bent back to the voice's last note and slides
     10  8554							;	      in the way the SID's does (all three channels)
     11  8554							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  8554							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  8554							; semitone, so these are a little stepped.
     14  8554
     15  8554		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  8554							;  (the pulses, and the triangle while it glides)
     17  8554
     18  8554							; A = 1 (not Z) when a NesFxTick step is due
     19  8554				   NesFxDue
     20  8554					      subroutine
     21  8554		       ad eb c7 	      lda	devOn+DEV_NES
     22  8557		       f0 1c		      beq	.x
     23  8559		       ad cb ca 	      lda	vibDepth
     24  855c		       0d f9 c9 	      ora	nfxGlide
     25  855f		       0d fa c9 	      ora	nfxRun
     26  8562		       0d b9 ce 	      ora	nfxWarb
     27  8565		       f0 0e		      beq	.x
     28  8567		       a5 10		      lda	ticks
     29  8569		       38		      sec
     30  856a		       ed f5 c9 	      sbc	nfxLast
     31  856d		       c9 08		      cmp	#NFX_EVERY
     32  856f		       a9 00		      lda	#0
     33  8571		       90 02		      bcc	.x
     34  8573		       a9 01		      lda	#1
     35  8575				   .x
     36  8575		       60		      rts
     37  8576
     38  8576							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     39  8576							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     40  8576							; quick return.
