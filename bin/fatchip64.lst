      0  699d					      include	"wander.asm"
      1  699d							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  699d							;
      3  699d							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  699d							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  699d							;   ATTACK   as always: the new notes start
      6  699d							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  699d							;	      has none)
      8  699d							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  699d							;	      start again
     10  699d							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  699d							;	      late; some glide, some start again (fade out, come back in)
     12  699d							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  699d							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  699d							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  699d							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  699d
     17  699d		       00 01	   CHG_ATTACK equ	1
     18  699d		       00 02	   CHG_GLIDE  equ	2
     19  699d		       00 03	   CHG_STAGGER equ	3
     20  699d		       00 04	   CHG_WANDER equ	4
     21  699d		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  699d		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  699d
     24  699d							; A = the chord change style now (keeps X, Y)
     25  699d				   ChgEff
     26  699d					      subroutine
     27  699d		       ad 65 c8 	      lda	chgMode
     28  69a0		       d0 0c		      bne	.x
     29  69a2		       ad b3 c3 	      lda	effMode
     30  69a5		       c9 02		      cmp	#MODE_DRONE
     31  69a7		       d0 03		      bne	.a
     32  69a9		       a9 04		      lda	#CHG_WANDER
     33  69ab		       60		      rts
     34  69ac				   .a
     35  69ac		       a9 01		      lda	#CHG_ATTACK
     36  69ae				   .x
     37  69ae		       60		      rts
     38  69af
     39  69af							; ApplyVoices, voice X changes note: how. A = 0 (Z): change it now (t3,
     40  69af							; legatoNow, vsGlide set); A = 1: not yet (WANDER). Keeps X.
