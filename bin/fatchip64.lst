------- FILE main.asm
------- FILE arp.asm LEVEL 2 PASS 3
      0  24b5					      include	"arp.asm"
      1  24b5							; Fat Chip 64 - tempo and arpeggiator
      2  24b5							;
      3  24b5							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  24b5							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  24b5							;
      6  24b5							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  24b5							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  24b5							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  24b5							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  24b5							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  24b5							;	     until its voice's next turn.
     12  24b5							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  24b5							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  24b5							;   J faster; either one also picks FREE).
     15  24b5							;
     16  24b5							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  24b5							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  24b5
     19  24b5							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  24b5							; between the two bytes: $22FF read as $23FF)
     21  24b5				   GetTicks
     22  24b5					      subroutine
     23  24b5		       08		      php
     24  24b6		       78		      sei
     25  24b7		       a5 10		      lda	ticks
     26  24b9		       8d 03 c8 	      sta	nowL
     27  24bc		       a5 11		      lda	ticks+1
     28  24be		       8d 04 c8 	      sta	nowH
     29  24c1		       28		      plp
     30  24c2		       60		      rts
     31  24c3
     32  24c3							; ------------------------------------------------------------ tempo
