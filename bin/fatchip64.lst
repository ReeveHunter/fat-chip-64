    359  72b7							; ------------------------------------------------------------ One Key Play
    360  72b7							; CRSR DOWN or CRSR RIGHT (A = 1 / 2: which) pressed, ONE KEY PLAY on: the
    361  72b7							; phrase's next step sounds. PENTATONIC PAIRS: two notes of the key's
    362  72b7							; pentatonic scale, one apart (a third or a fourth), across the overlay's two
    363  72b7							; octaves. CHORD NOTES: one note of the chord (the keys held or latched),
    364  72b7							; over two octaves. EACH PRESS CUTS the last step or lets it RING ON (until
    365  72b7							; the next). The notes sound while either key is down (latch: until the next
    366  72b7							; press).
    367  72b7				   OkpPress
    368  72b7					      subroutine
    369  72b7		       0d 42 cd 	      ora	okpDown
    370  72ba		       8d 42 cd 	      sta	okpDown
    371  72bd		       ad 3f cd 	      lda	okpRing	; RINGS ON: the last step stays
    372  72c0		       f0 15		      beq	.cut
    373  72c2		       ad 43 cd 	      lda	okpCount
    374  72c5		       f0 10		      beq	.cut
    375  72c7		       ad 44 cd 	      lda	okpNotes
    376  72ca		       8d 46 cd 	      sta	okpNotes+2
    377  72cd		       ad 45 cd 	      lda	okpNotes+1
    378  72d0		       8d 47 cd 	      sta	okpNotes+3
    379  72d3		       a9 04		      lda	#4
    380  72d5		       d0 02		      bne	.c
    381  72d7				   .cut
    382  72d7		       a9 02		      lda	#2
    383  72d9				   .c
    384  72d9		       8d 43 cd 	      sta	okpCount
    385  72dc		       20 32 73 	      jsr	OkpBuild
    386  72df		       ad 49 cd 	      lda	okpLen
    387  72e2		       d0 06		      bne	.go
    388  72e4		       a9 00		      lda	#0	; (nothing to play)
    389  72e6		       8d 43 cd 	      sta	okpCount
    390  72e9		       60		      rts
    391  72ea				   .go
    392  72ea		       20 fb 73 	      jsr	OkpStep
    393  72ed		       ae 40 cd 	      ldx	okpPos
    394  72f0		       bd 4a cd 	      lda	okpList,x
    395  72f3		       20 12 73 	      jsr	LeadOfs	; (v0.43: the lead's octave, SHIFT + F1 F3)
    396  72f6		       8d 44 cd 	      sta	okpNotes
