    121  3b14		       d0 a7		      bne	.next
    122  3b16		       a9 00		      lda	#0
    123  3b18		       8d f4 c8 	      sta	rxCnt
    124  3b1b		       20 43 3b 	      jsr	MidiInMsg
    125  3b1e		       4c bd 3a 	      jmp	.next
    126  3b21				   .rt
    127  3b21		       c9 fa		      cmp	#$FA
    128  3b23		       d0 06		      bne	.rt2
    129  3b25		       20 91 5d 	      jsr	KeytarStart
    130  3b28		       4c bd 3a 	      jmp	.next
    131  3b2b				   .rt2
