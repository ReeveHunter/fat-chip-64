      0  6b9d					      include	"wander.asm"
      1  6b9d							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  6b9d							;
      3  6b9d							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  6b9d							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  6b9d							;   ATTACK   as always: the new notes start
      6  6b9d							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  6b9d							;	      has none)
      8  6b9d							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  6b9d							;	      start again
     10  6b9d							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  6b9d							;	      late; some glide, some start again (fade out, come back in)
     12  6b9d							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  6b9d							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  6b9d							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  6b9d							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  6b9d
     17  6b9d		       00 01	   CHG_ATTACK equ	1
     18  6b9d		       00 02	   CHG_GLIDE  equ	2
     19  6b9d		       00 03	   CHG_STAGGER equ	3
     20  6b9d		       00 04	   CHG_WANDER equ	4
     21  6b9d		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  6b9d		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  6b9d
