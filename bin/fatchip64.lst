     45  6b77		       0d 2c c5 	      ora	nfxGlide
     46  6b7a		       0d 2d c5 	      ora	nfxRun
     47  6b7d		       d0 01		      bne	.on
     48  6b7f				   .q
     49  6b7f		       60		      rts
     50  6b80				   .on
     51  6b80		       a5 10		      lda	ticks
     52  6b82		       38		      sec
     53  6b83		       ed 28 c5 	      sbc	nfxLast
     54  6b86		       c9 08		      cmp	#NFX_EVERY
     55  6b88		       b0 01		      bcs	.go
     56  6b8a		       60		      rts
     57  6b8b				   .go
     58  6b8b		       4a		      lsr
