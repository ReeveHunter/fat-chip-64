------- FILE nesenv.asm LEVEL 2 PASS 3
      0  237f					      include	"nesenv.asm"
      1  237f							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  237f							;
      3  237f							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  237f							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  237f							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  237f							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  237f							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  237f							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  237f							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  237f							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  237f							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  237f							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  237f							; would wrap to a high pitch).
     14  237f							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  237f
     16  237f							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  237f							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  237f							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  237f							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  237f							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  237f		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  237f		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  237f							; NES channels too, and can't take a bend every 4 ms
     24  237f		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  237f		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  237f
     27  237f							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  237f		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  2388		       02 05	   slotVoice  .byte.b	2,5
     30  238a
     31  238a							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  238a							; note keeps sounding for now). X = voice (= t0).
     33  238a				   NesSoftRelease
     34  238a					      subroutine
     35  238a		       4c 8f 23 	      jmp	.go
     36  238d				   .nope
     37  238d		       18		      clc
     38  238e		       60		      rts
     39  238f				   .go
     40  238f		       ad 46 c4 	      lda	nesEnvOn
     41  2392		       f0 f9		      beq	.nope
     42  2394		       ad 8f c3 	      lda	muteNow
     43  2397		       0d ca c3 	      ora	hardCut
     44  239a		       d0 f1		      bne	.nope
     45  239c		       ad 27 c3 	      lda	devOn+DEV_NES
     46  239f		       f0 ec		      beq	.nope
     47  23a1		       bd ee 6f 	      lda	vDev,x
     48  23a4		       c9 02		      cmp	#DEV_NES
     49  23a6		       d0 7c		      bne	.no
     50  23a8		       bd 96 c3 	      lda	vOut,x
     51  23ab		       c9 ff		      cmp	#NO_NOTE
     52  23ad		       f0 75		      beq	.no
     53  23af		       bc 7f 23 	      ldy	vEnvSlot,x
     54  23b2		       30 3e		      bmi	.tri
     55  23b4							; pulse: release from the current level; step = level x factor / 4 + 1
     56  23b4							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  23b4							; about 2 s). Factor 0: no release, cut.
     58  23b4		       ad 69 c4 	      lda	envRelV
     59  23b7		       f0 6b		      beq	.no
     60  23b9		       86 26		      stx	t2
