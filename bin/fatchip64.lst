     27  7303		       f0 21		      beq	.s
     28  7305		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  7307		       ae 99 c6 	      ldx	sndClick
     30  730a		       e0 02		      cpx	#2
     31  730c		       90 03		      bcc	.cl
     32  730e		       ad 98 c6 	      lda	sndStepT
     33  7311				   .cl
     34  7311		       d9 6d c9 	      cmp	atkT,y
     35  7314		       f0 02		      beq	.ce
     36  7316		       b0 0e		      bcs	.s
