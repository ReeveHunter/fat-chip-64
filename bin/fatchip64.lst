------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  4c3d					      include	"sync.asm"
      1  4c3d							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  4c3d							;
      3  4c3d							; Menu, DEVICE SYNC (defaults first):
      4  4c3d							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  4c3d							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  4c3d							;		     sets the tempo, averaged over beats (the clock jitters about
      7  4c3d							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  4c3d							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  4c3d							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  4c3d							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  4c3d							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  4c3d							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  4c3d							;		     picks a beat demo (styleBeat)
     14  4c3d							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  4c3d							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  4c3d							;		     key channel) picks a sound (voiceSound)
     17  4c3d							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  4c3d							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  4c3d							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  4c3d							;
     21  4c3d							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  4c3d							; 1/4 ms); a Start makes the next clock a beat.
     23  4c3d
     24  4c3d		       00 00	   TEMPO_KEYTAR equ	0
     25  4c3d		       00 01	   TEMPO_OWN  equ	1
     26  4c3d		       00 02	   TEMPO_SC   equ	2
     27  4c3d		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  4c3d
     29  4c3d
     30  4c3d
     31  4c3d							; ------------------------------------------------------------ clock
     32  4c3d							; Main loop, every pass
     33  4c3d				   ClockTick
     34  4c3d					      subroutine
     35  4c3d		       ad e4 c5 	      lda	clkCount	; any clock lately?
     36  4c40		       cd e5 c5 	      cmp	clkCountSeen
     37  4c43		       f0 15		      beq	.alive
     38  4c45		       8d e5 c5 	      sta	clkCountSeen
     39  4c48		       20 c7 1e 	      jsr	GetTicks
     40  4c4b		       ad 3e c3 	      lda	nowL
     41  4c4e		       8d e6 c5 	      sta	clkSeenL
     42  4c51		       ad 3f c3 	      lda	nowH
     43  4c54		       8d e7 c5 	      sta	clkSeenH
     44  4c57		       4c 7b 4c 	      jmp	.beatq
     45  4c5a				   .alive
     46  4c5a		       ad f1 c5 	      lda	clkHave	; none for a while: start measuring afresh
     47  4c5d		       f0 1c		      beq	.beatq
     48  4c5f		       20 c7 1e 	      jsr	GetTicks
     49  4c62		       ad 3e c3 	      lda	nowL
     50  4c65		       38		      sec
     51  4c66		       ed e6 c5 	      sbc	clkSeenL
     52  4c69		       aa		      tax
     53  4c6a		       ad 3f c3 	      lda	nowH
     54  4c6d		       ed e7 c5 	      sbc	clkSeenH
     55  4c70		       d0 04		      bne	.lost
