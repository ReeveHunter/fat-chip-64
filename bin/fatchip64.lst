     23  83b7 ????						; Kerberos MIDI, DATEL emulation (MC6850 ACIA at $DE04-$DE07).
     24  83b7 ????						; Flash Fat Chip 64 with MIDI emulation = DATEL / Siel / JMS.
     25  83b7 ????	       de 04	   ACIA_CTRL  equ	$DE04
     26  83b7 ????	       de 05	   ACIA_TX    equ	$DE05
     27  83b7 ????	       de 06	   ACIA_STAT  equ	$DE06
     28  83b7 ????	       de 07	   ACIA_RX    equ	$DE07
     29  83b7 ????	       00 03	   ACIA_RESET equ	$03	; master reset
     30  83b7 ????	       00 16	   ACIA_MODE  equ	$16	; /64 (31250 baud), 8N1, no interrupts
     31  83b7 ????	       00 96	   ACIA_MODE_RX equ	$96	; ... and an interrupt when a byte comes in
     32  83b7 ????	       00 b6	   ACIA_MODE_TX equ	$B6	; ... and when the next byte can go out too
     33  83b7 ????	       00 02	   ACIA_TDRE  equ	$02	; status: transmit register empty
