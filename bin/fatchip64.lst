    364  3aba							; ------------------------------------------------------------ SysEx: a patch from Chip Lab (v0.20)
    365  3aba							; (v0.23: F0 7D 46 43 02 m F7 sets the chips on / off: DevicesReceived)
    366  3aba							; F0 7D 46 43 01 PATCH_SIZE, then the patch (PATCH_SIZE bytes, the live patch's layout:
    367  3aba							; tools/gen_patches.py) as two 4-bit halves each, high first, then F7. It
    368  3aba							; arrives in sxBuf; only a complete one goes into the live patch, which then
    369  3aba							; sounds at once (like choosing a sound). Anything else is ignored.
    370  3aba		       00 05	   SX_HEAD    equ	5
    371  3aba		       00 d5	   SX_LEN     equ	SX_HEAD + PATCH_SIZE * 2
    372  3aba
    373  3aba							; A status byte in A (F0-F7); keeps A
    374  3aba				   SysexStatus
    375  3aba					      subroutine
    376  3aba		       c9 f0		      cmp	#$F0
    377  3abc		       d0 0e		      bne	.end
