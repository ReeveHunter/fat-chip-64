    121  6cd4		       bd c3 c4 	      lda	nesGlL,x
    122  6cd7		       1d cc c4 	      ora	nesGlH,x
    123  6cda		       1d f0 c4 	      ora	nesBent,x
    124  6cdd		       d0 02		      bne	.t
    125  6cdf		       a2 02		      ldx	#2
    126  6ce1				   .t
    127  6ce1		       8e 29 c5 	      stx	nfxV
    128  6ce4		       86 24		      stx	t0
    129  6ce6		       bd 96 c3 	      lda	vOut,x
    130  6ce9		       c9 ff		      cmp	#NO_NOTE
    131  6ceb		       f0 20		      beq	.x
    132  6ced		       20 2e 6e 	      jsr	NesFxVal
    133  6cf0		       a6 24		      ldx	t0
    134  6cf2		       ad 32 c5 	      lda	nfxL
    135  6cf5		       dd de c4 	      cmp	nesFxSL,x
    136  6cf8		       d0 08		      bne	.send
    137  6cfa		       ad 33 c5 	      lda	nfxH
    138  6cfd		       dd e7 c4 	      cmp	nesFxSH,x
    139  6d00		       f0 0b		      beq	.x
    140  6d02				   .send
    141  6d02		       a9 01		      lda	#1
    142  6d04		       8d 2a c5 	      sta	nfxHave	; (NesBendVoice: nfx is this voice's already)
    143  6d07		       bd 96 c3 	      lda	vOut,x
    144  6d0a		       4c c3 2c 	      jmp	NesBendVoice
    145  6d0d				   .x
    146  6d0d		       60		      rts
    147  6d0e
    148  6d0e							; voice X's glide offset closer to 0: by off / 2^glideK for each 4 ms step
    149  6d0e							; (worked out once: d = off >> k, off -= d x n; past 0 or nothing left to
    150  6d0e							; move by: there). Keeps X.
    151  6d0e				   NesGlideStep
    152  6d0e					      subroutine
    153  6d0e		       bd c3 c4 	      lda	nesGlL,x
