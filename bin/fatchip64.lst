     43  2a08		       ad eb c7 	      lda	devOn+DEV_NES
     44  2a0b		       f0 f1		      beq	.nope
     45  2a0d		       bd 80 88 	      lda	vDev,x
     46  2a10		       c9 02		      cmp	#DEV_NES
     47  2a12		       d0 ea		      bne	.nope
     48  2a14		       bd 5f c8 	      lda	vOut,x
     49  2a17		       c9 ff		      cmp	#NO_NOTE
     50  2a19		       f0 e3		      beq	.nope
     51  2a1b		       ad 13 c9 	      lda	nesEnvOn
     52  2a1e		       f0 78		      beq	.fo	; (no envelope: BEND OUT's fall-off, if any)
     53  2a20		       bc f0 29 	      ldy	vEnvSlot,x
     54  2a23		       30 41		      bmi	.tri
     55  2a25							; pulse: release from the current level; step = level x factor / 4 + 1
     56  2a25							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  2a25							; about 2 s). Factor 0: no release, cut.
     58  2a25		       ad 36 c9 	      lda	envRelV
     59  2a28		       f0 6e		      beq	.fo
     60  2a2a		       86 26		      stx	t2
