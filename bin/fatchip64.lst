------- FILE main.asm
------- FILE viz.asm LEVEL 2 PASS 3
      0  714d					      include	"viz.asm"
      1  714d							; Fat Chip 64 - the visualizer (F7: GLITCH on / off; v0.28 dropped the BARS)
      2  714d							;
      3  714d							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
      4  714d							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
      5  714d							; keep spattering more; runs of the screen get copied over other places
      6  714d							; (datamosh) and wiped away, so it fills while you play and dissolves when
      7  714d							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
      8  714d							; the background. VINYL STOP drags it down the screen.
      9  714d
     10  714d		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     11  714d		       00 16	   VIZ_NAMES  equ	22	; note names
     12  714d		       00 a0	   VIZ_FULL   equ	160	; reversed space
     13  714d		       00 62	   VIZ_HALF   equ	98	; lower half block
     14  714d
     15  714d							; F7: GLITCH on / off (not from the menu)
