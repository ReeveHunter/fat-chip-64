    196  0d3d		       9d b0 c2 	      sta	physKey,x
    197  0d40		       ee c8 c2 	      inc	physCount
    198  0d43		       20 b5 15 	      jsr	GetTicks
    199  0d46		       20 e6 0e 	      jsr	ApplySettings	; (changes waiting for this note)
    200  0d49		       ad 74 c3 	      lda	newPending	; N or a setting change: this note starts a new chord
    201  0d4c		       f0 0b		      beq	.styles
    202  0d4e		       a9 00		      lda	#0
    203  0d50		       8d 74 c3 	      sta	newPending
    204  0d53		       20 6c 0f 	      jsr	ClearNotes
    205  0d56		       4c 9a 0d 	      jmp	.add
    206  0d59				   .styles
    207  0d59		       ad bf c3 	      lda	latch
    208  0d5c		       c9 03		      cmp	#LATCH_ADD
    209  0d5e		       f0 54		      beq	.addStyle
