------- FILE main.asm
------- FILE bend.asm LEVEL 2 PASS 3
      0  278f					      include	"bend.asm"
      1  278f							; Fat Chip 64 - bends (SPACE / the keytar's buttons and wheel), v0.13
      2  278f							;
      3  278f							; What everything is bent by: m = 0-384 sixteenths of a semitone (two
      4  278f							; octaves at most), up or down: bendMag (0-192, the first octave) + bendHi
      5  278f							; (0-192, the second), bendUp. From three things added together:
      6  278f							;   the BEND DOWN / BEND UP actions (SPACE or a keytar button, held): bendLvl
      7  278f							;     0-255 ramps up over about 1 s while held, back over about 0.5 s; full =
      8  278f							;     the menu's BEND RANGE (1-24 semitones, default 2)
      9  278f							;   the keytar's wheel: wheelMag 0-255 up or down, full = BEND RANGE
     10  278f							;   VINYL STOP (held): vinylLvl 0-255 the same way, like a record stopping:
     11  278f							;     speed (256 - lvl) / 256, the pitch 12 log2(1 / speed) down (vinP: an
     12  278f							;     octave by lvl 128, two by 192); the SID fades out from lvl 192; the
     13  278f							;     beat and arp slow (up to 8x); at lvl 248 everything has stopped:
     14  278f							;     silent, no drums (vinylCut). Let go, it winds back up in 0.5 s.
     15  278f							; Then:
     16  278f							;   SID       its frequency x 2^(+-m/192), from tables (bendtab.asm): the
     17  278f							;	       first octave, then the second the same way
     18  278f							;   Game Boy  bend range 24 (CC 85, sent with the sound), bend = 8192 +- m x 8192 / 384
     19  278f							;   MidiNES   p(n) x the table / 8192 for the triangle, twice for the pulses
     20  278f							;	       (p = the MidiNES triangle bend scale, 1710 at MIDI 36)
     21  278f							; Going down, a Game Boy or NES note bends only as far as the bottom of
     22  278f							; that channel's range (lower would wrap round to a high note): it holds
     23  278f							; there. Game Boy pulses C2 (MIDI 36), wave C1; NES pulses A1, triangle A0.
     24  278f							; Bends go out every BEND_TICK ms at most, and before each new NES note.
     25  278f
     26  278f							; , : SPACE's action back
     27  278f				   SpaceBack
     28  278f					      subroutine
     29  278f		       ae d3 c3 	      ldx	spaceAct
     30  2792		       d0 02		      bne	.d
     31  2794		       a2 14		      ldx	#NUM_ACTS
     32  2796				   .d
     33  2796		       ca		      dex
     34  2797		       4c a4 27 	      jmp	SpaceSet
     35  279a
     36  279a							; . : SPACE's action on
     37  279a				   SpaceNext
     38  279a					      subroutine
     39  279a		       ae d3 c3 	      ldx	spaceAct
