    149  769f							; voice X's glide offset closer to 0: by off / 2^glideK for each 4 ms step
    150  769f							; (worked out once: d = off >> k, off -= d x n; past 0 or nothing left to
    151  769f							; move by: there). Keeps X.
    152  769f				   NesGlideStep
    153  769f					      subroutine
    154  769f		       bd c4 c4 	      lda	nesGlL,x
