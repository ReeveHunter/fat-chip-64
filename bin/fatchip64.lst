      0  511c					      include	"menu.asm"
      1  511c							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  511c							;
      3  511c							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  511c							;   page   RETURN opens a page
      5  511c							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  511c							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  511c							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  511c							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  511c							; device pages, until DEVICES says the device is in use).
     10  511c							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  511c							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  511c							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  511c
     14  511c		       00 17	   MENU_VALCOL equ	23
     15  511c
