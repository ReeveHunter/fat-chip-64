     30  3094		       ad 07 de 	      lda	ACIA_RX
     31  3097		       c9 f8		      cmp	#$F8
     32  3099		       f0 25		      beq	.clk
     33  309b		       c9 fa		      cmp	#$FA
     34  309d		       d0 0e		      bne	.buf
     35  309f		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  30a1		       8e e8 c5 	      stx	clkPhase
     37  30a4		       8e f0 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  30a7							;  the main loop could measure it)
     39  30a7		       ae e9 c5 	      ldx	clkBeat
     40  30aa		       8e fb c5 	      stx	clkStartBeat
     41  30ad				   .buf
     42  30ad		       ae 24 c4 	      ldx	rxHead
