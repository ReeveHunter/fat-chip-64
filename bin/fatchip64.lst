     54  27b0		       0d dd c5 	      ora	wheelMag
     55  27b3		       0d df c5 	      ora	bendMag
     56  27b6		       0d d7 c3 	      ora	bendSent
     57  27b9		       0d e2 c5 	      ora	bendSidMag
     58  27bc		       0d b2 c4 	      ora	bendHi
     59  27bf		       0d b3 c4 	      ora	bendSidHi
