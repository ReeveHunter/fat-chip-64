     38  c942 ????						; ------------------------------------------------------------ timing
     39  c942 ????	       03 ff	   TICK_LATCH_MS equ	1023	; with the MIDI chip's interrupts (midiIrq): 1 ms
     40  c942 ????	       00 ff	   TICK_LATCH equ	255	; CIA1 timer A: 256 cycles = 1/4 ms (NTSC), quicker
     41  c942 ????						; than a MIDI byte (327 cycles), so the ACIA is fed
     42  c942 ????						; and read (MIDI in) even while the main loop is
     43  c942 ????						; busy; every fourth IRQ is a tick
