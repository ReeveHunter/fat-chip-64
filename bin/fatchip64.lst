    203  0975		       29 02		      and	#ACIA_TDRE
    204  0977		       f0 08		      beq	.noByte
    205  0979		       bd 00 c0 	      lda	wireBuf,x
    206  097c		       8d 05 de 	      sta	ACIA_TX
