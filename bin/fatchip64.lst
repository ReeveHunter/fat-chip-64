------- FILE nesenv.asm LEVEL 2 PASS 3
      0  285d					      include	"nesenv.asm"
      1  285d							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  285d							;
      3  285d							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  285d							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  285d							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  285d							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  285d							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  285d							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  285d							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  285d							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  285d							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  285d							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  285d							; would wrap to a high pitch).
     14  285d							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  285d
     16  285d							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  285d							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  285d							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  285d							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  285d							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  285d		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  285d		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  285d							; NES channels too, and can't take a bend every 4 ms
     24  285d		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  285d		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  285d
     27  285d							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  285d		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  2866		       02 05	   slotVoice  .byte.b	2,5
     30  2868
     31  2868							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  2868							; note keeps sounding for now). X = voice (= t0).
     33  2868				   NesSoftRelease
     34  2868					      subroutine
     35  2868		       4c 6d 28 	      jmp	.go
     36  286b				   .nope
     37  286b		       18		      clc
     38  286c		       60		      rts
     39  286d				   .go
     40  286d		       ad 90 c3 	      lda	muteNow
     41  2870		       0d cb c3 	      ora	hardCut
     42  2873		       d0 f6		      bne	.nope
     43  2875		       ad 27 c3 	      lda	devOn+DEV_NES
     44  2878		       f0 f1		      beq	.nope
     45  287a		       bd 9a 80 	      lda	vDev,x
