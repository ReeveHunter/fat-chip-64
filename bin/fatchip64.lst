     74  0ba3							; IRQ: send one wire byte if the ACIA is ready.
     75  0ba3				   TxByte
     76  0ba3					      subroutine
     77  0ba3		       a6 16		      ldx	wireTail
     78  0ba5		       e4 15		      cpx	wireHead
