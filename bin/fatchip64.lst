    165  0a41							; Put a message on the wire (IRQ only): A = status, Y = data 1, irqT = data 2.
    166  0a41							; Program change / channel pressure have one data byte.
    167  0a41				   WireMsg
    168  0a41					      subroutine
    169  0a41		       c5 13		      cmp	lastStatus
    170  0a43		       f0 05		      beq	.rs
    171  0a45		       85 13		      sta	lastStatus
    172  0a47		       20 64 0a 	      jsr	WirePut
    173  0a4a				   .rs
    174  0a4a		       98		      tya
    175  0a4b		       20 64 0a 	      jsr	WirePut
    176  0a4e		       a5 13		      lda	lastStatus
    177  0a50		       29 e0		      and	#$E0
    178  0a52		       c9 c0		      cmp	#$C0	; $Cx and $Dx: one data byte
    179  0a54		       f0 05		      beq	.done
    180  0a56		       a5 2b		      lda	irqT
    181  0a58		       20 64 0a 	      jsr	WirePut
    182  0a5b				   .done
    183  0a5b		       ee 1c c3 	      inc	statSent
    184  0a5e		       d0 03		      bne	.x
    185  0a60		       ee 1d c3 	      inc	statSent+1
