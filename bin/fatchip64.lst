    120  6bfe		       d0 0d		      bne	.t
    121  6c00		       bd c3 c4 	      lda	nesGlL,x
    122  6c03		       1d cc c4 	      ora	nesGlH,x
    123  6c06		       1d f0 c4 	      ora	nesBent,x
    124  6c09		       d0 02		      bne	.t
    125  6c0b		       a2 02		      ldx	#2
    126  6c0d				   .t
    127  6c0d		       8e 29 c5 	      stx	nfxV
    128  6c10		       86 24		      stx	t0
    129  6c12		       bd 96 c3 	      lda	vOut,x
    130  6c15		       c9 ff		      cmp	#NO_NOTE
    131  6c17		       f0 20		      beq	.x
    132  6c19		       20 5a 6d 	      jsr	NesFxVal
    133  6c1c		       a6 24		      ldx	t0
    134  6c1e		       ad 32 c5 	      lda	nfxL
    135  6c21		       dd de c4 	      cmp	nesFxSL,x
    136  6c24		       d0 08		      bne	.send
    137  6c26		       ad 33 c5 	      lda	nfxH
    138  6c29		       dd e7 c4 	      cmp	nesFxSH,x
    139  6c2c		       f0 0b		      beq	.x
    140  6c2e				   .send
    141  6c2e		       a9 01		      lda	#1
    142  6c30		       8d 2a c5 	      sta	nfxHave	; (NesBendVoice: nfx is this voice's already)
    143  6c33		       bd 96 c3 	      lda	vOut,x
    144  6c36		       4c be 2b 	      jmp	NesBendVoice
    145  6c39				   .x
    146  6c39		       60		      rts
    147  6c3a
    148  6c3a							; voice X's glide offset closer to 0: by off / 2^glideK for each 4 ms step
    149  6c3a							; (worked out once: d = off >> k, off -= d x n; past 0 or nothing left to
    150  6c3a							; move by: there). Keeps X.
    151  6c3a				   NesGlideStep
    152  6c3a					      subroutine
    153  6c3a		       bd c3 c4 	      lda	nesGlL,x
