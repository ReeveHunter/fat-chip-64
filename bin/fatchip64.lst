    200  0c9a							; Carry set if the Teensyboy has room for a message (always, with the Game
    201  0c9a							; Boy off), and counts it.
    202  0c9a				   LinkRoom
    203  0c9a					      subroutine
    204  0c9a		       ad 26 c3 	      lda	devOn+DEV_GB
    205  0c9d		       f0 0a		      beq	.yes
