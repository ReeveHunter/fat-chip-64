     18  7029		       00 02	   CHG_GLIDE  equ	2
     19  7029		       00 03	   CHG_STAGGER equ	3
     20  7029		       00 04	   CHG_WANDER equ	4
     21  7029		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  7029		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  7029
