     89  39dd		       85 25		      sta	t1
     90  39df							; bank (CC14 on the sample channel) when it changes
     91  39df		       a9 04		      lda	#4
     92  39e1		       20 39 3a 	      jsr	NesChStatus	; mS = CC, sample channel
     93  39e4		       a9 00		      lda	#0
     94  39e6		       a6 25		      ldx	t1
