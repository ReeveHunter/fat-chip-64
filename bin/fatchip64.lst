     58  4e51		       ed 7f c4 	      sbc	dmcAt+1
     59  4e54		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  4e56		       c0 0c		      cpy	#DRUM_WINDOW
