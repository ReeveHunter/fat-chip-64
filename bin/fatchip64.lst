    457  6a79		       aa		      tax
    458  6a7a		       ad 61 c8 	      lda	fineTune
    459  6a7d		       38		      sec
    460  6a7e		       e9 32		      sbc	#50
    461  6a80		       18		      clc
    462  6a81		       7d 97 6b 	      adc	scCents,x
    463  6a84		       50 00		      bvc	.c	; (can't overflow: -85..+60)
    464  6a86				   .c
    465  6a86		       cd 62 c8 	      cmp	tuneC
    466  6a89		       f0 1b		      beq	.k
    467  6a8b		       8d 62 c8 	      sta	tuneC
    468  6a8e		       20 bf 6a 	      jsr	TuneUnits
    469  6a91		       ae 64 c8 	      ldx	gbTune
    470  6a94		       a9 67		      lda	#GCC_TUNE
    471  6a96		       20 78 0d 	      jsr	GbGlobal
    472  6a99		       a9 08		      lda	#8
