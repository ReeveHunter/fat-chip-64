     35  14d6		       a9 c9		      lda	#$C9	; sustain 12, release 9
     36  14d8		       99 06 d4 	      sta	SID+6,y
     37  14db		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     38  14dd		       99 03 d4 	      sta	SID+3,y
     39  14e0		       a9 20		      lda	#$20	; sawtooth, gate off
     40  14e2		       9d 31 c3 	      sta	sidGate,x
