------- FILE drums.asm LEVEL 2 PASS 3
      0  36e3					      include	"drums.asm"
      1  36e3							; Fat Chip 64 - drums on the MidiNES
      2  36e3							;
      3  36e3							; Two sources, one kit:
      4  36e3							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  36e3							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  36e3							;			   64 = hit, 56 = ghost)
      7  36e3							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  36e3							;			   RETURN starts / stops it, at its own tempo (B taps
      9  36e3							;			   a new one)
     10  36e3							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  36e3							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  36e3							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  36e3							; a note-on, then a note-off after the sound's length, the level set with
     14  36e3							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  36e3							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  36e3
     17  36e3		       00 0c	   KIT_SIZE   equ	12
     18  36e3		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  36e3		       00 00	   DK_KICK    equ	0
     20  36e3		       00 01	   DK_SNARE   equ	1
     21  36e3		       00 02	   DK_CH      equ	2
     22  36e3		       00 03	   DK_OH      equ	3
     23  36e3		       00 04	   DK_CY      equ	4
     24  36e3		       00 05	   DK_TOM     equ	5
     25  36e3		       00 06	   DK_PERC    equ	6
     26  36e3
     27  36e3							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  36e3				   DrumHit
     29  36e3					      subroutine
     30  36e3		       8d 83 c4 	      sta	drumKind
     31  36e6		       8e 82 c4 	      stx	drumLvl
     32  36e9		       8c 84 c4 	      sty	drumTom
     33  36ec		       c9 00		      cmp	#DK_KICK
     34  36ee		       d0 05		      bne	.nk
     35  36f0		       a9 01		      lda	#1
     36  36f2		       8d b7 c5 	      sta	vizKick	; (the visualizer's border flash)
     37  36f5				   .nk
     38  36f5		       ad 27 c3 	      lda	devOn+DEV_NES
     39  36f8		       d0 01		      bne	.on
     40  36fa		       60		      rts
     41  36fb				   .on
     42  36fb		       20 d4 18 	      jsr	GetTicks
     43  36fe		       ad 83 c4 	      lda	drumKind
     44  3701		       c9 02		      cmp	#DK_CH
     45  3703		       90 07		      bcc	.dmc
     46  3705		       c9 05		      cmp	#DK_TOM
     47  3707		       b0 03		      bcs	.dmc
     48  3709		       4c be 37 	      jmp	NoiseHit
     49  370c				   .dmc
     50  370c		       ae 83 c4 	      ldx	drumKind
     51  370f		       bd a5 37 	      lda	dmcPrioT,x
     52  3712		       85 24		      sta	t0
     53  3714		       ad 3e c3 	      lda	nowL
