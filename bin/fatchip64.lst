     77  1a4b							; IRQ, each 1 ms: every 2 ms the SID's volume one step nearer its target, so
     78  1a4b							; it never jumps (a jump in the 6581's volume thumps). Keeps X, Y.
     79  1a4b				   VolSlew
     80  1a4b					      subroutine
     81  1a4b		       a5 10		      lda	ticks
     82  1a4d		       4a		      lsr
     83  1a4e		       b0 19		      bcs	.x
