------- FILE voices.asm LEVEL 2 PASS 2
      0  0d6c					      include	"voices.asm"
      1  0d6c							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  0d6c							;
      3  0d6c							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  0d6c							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  0d6c							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  0d6c							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  0d6c							; Allocation, whenever the held notes change:
      8  0d6c							;   1. bass voices play the lowest note, an octave down
      9  0d6c							;   2. every other note gets one voice, lowest notes first
     10  0d6c							;   3. leftover voices stack on the lowest two notes, alternating
     11  0d6c							; So one note = a nine-voice unison across three chips, and in chords the
     12  0d6c							; bottom of the chord is fattest. Disabled devices get no notes.
     13  0d6c
     14  0d6c							; ------------------------------------------------------------ SID
     15  0d6c				   SidInit
     16  0d6c					      subroutine
     17  0d6c		       a2 18		      ldx	#24
     18  0d6e		       a9 00		      lda	#0
     19  0d70				   .clr
