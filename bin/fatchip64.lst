    144  39ac							; A full message: rxStatus, rxD1, rxD2
    145  39ac				   MidiInMsg
    146  39ac					      subroutine
    147  39ac		       ad 2b c4 	      lda	rxStatus
    148  39af		       29 0f		      and	#15
    149  39b1		       c9 0f		      cmp	#DRUM_CH_IN	; channel 16: the keytar's rhythm
    150  39b3		       d0 1d		      bne	.notes
    151  39b5		       ad 2b c4 	      lda	rxStatus
    152  39b8		       29 f0		      and	#$F0
    153  39ba		       c9 c0		      cmp	#$C0
    154  39bc		       d0 03		      bne	.dr
    155  39be		       4c ef 56 	      jmp	KeytarStyle	; its style buttons
    156  39c1				   .dr
    157  39c1		       c9 90		      cmp	#$90
    158  39c3		       d0 47		      bne	.x
    159  39c5		       ad 2e c4 	      lda	rxD2
    160  39c8		       f0 42		      beq	.x
    161  39ca		       ad 95 c4 	      lda	syncDrums	; its drum notes: on the MidiNES if the menu says PLAY
    162  39cd		       f0 3d		      beq	.x
    163  39cf		       4c ed 4f 	      jmp	KeytarDrum
    164  39d2				   .notes
    165  39d2		       c9 0b		      cmp	#MIDI_IN_CHANS
    166  39d4		       b0 36		      bcs	.x	; channels 12-15: the keytar's accompaniment
    167  39d6		       85 27		      sta	t3
    168  39d8		       ad 2b c4 	      lda	rxStatus
    169  39db		       29 f0		      and	#$F0
    170  39dd		       c9 b0		      cmp	#$B0
    171  39df		       d0 03		      bne	.pc
    172  39e1		       4c 4a 57 	      jmp	KeytarCC	; its vibrato / portamento / sustain buttons
    173  39e4				   .pc
    174  39e4		       c9 c0		      cmp	#$C0
    175  39e6		       d0 03		      bne	.pb
    176  39e8		       4c 07 57 	      jmp	KeytarVoice	; its voice buttons
    177  39eb				   .pb
    178  39eb		       c9 d0		      cmp	#$D0
    179  39ed		       d0 03		      bne	.pw
    180  39ef		       4c 65 66 	      jmp	Breath	; channel pressure: the DH-100's breath
    181  39f2				   .pw
    182  39f2		       c9 e0		      cmp	#$E0
    183  39f4		       d0 03		      bne	.nt
    184  39f6		       4c c4 59 	      jmp	KeytarWheel
    185  39f9				   .nt
