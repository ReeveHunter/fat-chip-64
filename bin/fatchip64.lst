------- FILE drums.asm LEVEL 2 PASS 3
      0  479b					      include	"drums.asm"
      1  479b							; Fat Chip 64 - drums on the MidiNES
      2  479b							;
      3  479b							; Two sources, one kit:
      4  479b							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  479b							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  479b							;			   64 = hit, 56 = ghost)
      7  479b							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  479b							;			   RETURN starts / stops it, at its own tempo (B taps
      9  479b							;			   a new one)
     10  479b							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  479b							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  479b							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  479b							; a note-on, then a note-off after the sound's length, the level set with
     14  479b							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  479b							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  479b
     17  479b		       00 0c	   KIT_SIZE   equ	12
     18  479b		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  479b		       00 00	   DK_KICK    equ	0
     20  479b		       00 01	   DK_SNARE   equ	1
     21  479b		       00 02	   DK_CH      equ	2
     22  479b		       00 03	   DK_OH      equ	3
     23  479b		       00 04	   DK_CY      equ	4
     24  479b		       00 05	   DK_TOM     equ	5
     25  479b		       00 06	   DK_PERC    equ	6
     26  479b
     27  479b							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  479b				   DrumHit
     29  479b					      subroutine
     30  479b		       8d 83 c4 	      sta	drumKind
     31  479e		       8e 82 c4 	      stx	drumLvl
     32  47a1		       8c 84 c4 	      sty	drumTom
     33  47a4		       c9 00		      cmp	#DK_KICK
