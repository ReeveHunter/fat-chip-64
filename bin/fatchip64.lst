    108  4e84				   .meas
    109  4e84		       ad f1 c5 	      lda	clkSkip	; (a Start moved the beat: no period this time)
    110  4e87		       d0 05		      bne	.start
    111  4e89		       ad f2 c5 	      lda	clkHave
    112  4e8c		       d0 10		      bne	.have
    113  4e8e				   .start
    114  4e8e		       a9 00		      lda	#0
    115  4e90		       8d f1 c5 	      sta	clkSkip
    116  4e93		       ad f2 c5 	      lda	clkHave
    117  4e96		       d0 05		      bne	.st2
    118  4e98		       a9 01		      lda	#1
    119  4e9a		       8d f2 c5 	      sta	clkHave
    120  4e9d				   .st2
    121  4e9d		       60		      rts
    122  4e9e				   .have
    123  4e9e							; 250 ms .. 2 s (1000 .. 8000 quarters), else start the average again
    124  4e9e		       a5 27		      lda	t3
    125  4ea0		       c9 03		      cmp	#>1000
    126  4ea2		       90 10		      bcc	.bad0
    127  4ea4		       d0 06		      bne	.hi
    128  4ea6		       a5 26		      lda	t2
    129  4ea8		       c9 e8		      cmp	#<1000
    130  4eaa		       90 08		      bcc	.bad0
    131  4eac				   .hi
    132  4eac		       a5 27		      lda	t3
    133  4eae		       c9 1f		      cmp	#>8000
    134  4eb0		       90 05		      bcc	.ok
    135  4eb2		       f0 03		      beq	.ok
    136  4eb4				   .bad0
    137  4eb4		       4c 70 4f 	      jmp	.bad
    138  4eb7				   .ok
    139  4eb7							; period in 1/16 ms
    140  4eb7		       06 26		      asl	t2
    141  4eb9		       26 27		      rol	t3
    142  4ebb		       06 26		      asl	t2
    143  4ebd		       26 27		      rol	t3
    144  4ebf		       ad f2 c5 	      lda	clkHave
    145  4ec2		       c9 02		      cmp	#2
    146  4ec4		       f0 12		      beq	.avg
    147  4ec6		       a5 26		      lda	t2
    148  4ec8		       8d f3 c5 	      sta	clk16L
    149  4ecb		       a5 27		      lda	t3
    150  4ecd		       8d f4 c5 	      sta	clk16H
    151  4ed0		       a9 02		      lda	#2
    152  4ed2		       8d f2 c5 	      sta	clkHave
    153  4ed5		       4c 62 4f 	      jmp	.use
    154  4ed8				   .avg
    155  4ed8							; clk16 += (period - clk16) / 4; off by more than a quarter (the tempo
    156  4ed8							; jumped): the new period at once
    157  4ed8		       ad f4 c5 	      lda	clk16H	; bT1:bT0 = clk16 / 4
    158  4edb		       4a		      lsr
    159  4edc		       8d db c3 	      sta	bT1
    160  4edf		       ad f3 c5 	      lda	clk16L
    161  4ee2		       6a		      ror
    162  4ee3		       8d da c3 	      sta	bT0
    163  4ee6		       4e db c3 	      lsr	bT1
    164  4ee9		       6e da c3 	      ror	bT0
    165  4eec		       a5 26		      lda	t2
    166  4eee		       38		      sec
    167  4eef		       ed f3 c5 	      sbc	clk16L
    168  4ef2		       8d b6 c3 	      sta	exS
    169  4ef5		       a5 27		      lda	t3
