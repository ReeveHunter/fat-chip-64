    213  0f4d		       20 f3 39 	      jsr	RepeatPress	; REPEAT: its echoes (keeps X)
    214  0f50		       20 19 1a 	      jsr	GetTicks
    215  0f53		       20 41 11 	      jsr	ApplySettings	; (changes waiting for this note)
    216  0f56		       ad 8c c3 	      lda	newPending	; NEXT or a setting change: this note starts a new chord
    217  0f59		       f0 0b		      beq	.styles
    218  0f5b		       a9 00		      lda	#0
    219  0f5d		       8d 8c c3 	      sta	newPending
