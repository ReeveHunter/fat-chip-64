     39  cec4 ????	       03 ff	   TICK_LATCH_MS equ	1023	; with the MIDI chip's interrupts (midiIrq): 1 ms
     40  cec4 ????	       00 ff	   TICK_LATCH equ	255	; CIA1 timer A: 256 cycles = 1/4 ms (NTSC), quicker
     41  cec4 ????						; than a MIDI byte (327 cycles), so the ACIA is fed
     42  cec4 ????						; and read (MIDI in) even while the main loop is
