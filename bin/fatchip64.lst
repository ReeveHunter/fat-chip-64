------- FILE main.asm
------- FILE voices.asm LEVEL 2 PASS 3
      0  1a24					      include	"voices.asm"
      1  1a24							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  1a24							;
      3  1a24							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  1a24							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  1a24							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  1a24							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  1a24							; Allocation, whenever the held notes change. Who comes first (v0.21):
      8  1a24							; Polyphony > Fat Bass > the patch's effects (REPEAT's echoes) > stacking.
      9  1a24							;   1. every note gets a voice (SPARKLE's arp pair is what you play, so it
     10  1a24							;	counts as notes and goes first)
     11  1a24							;   2. Fat Bass: as many bass voices as are spare play the lowest note,
     12  1a24							;	folded into the bass range (one note fewer needs a voice, so with
     13  1a24							;	Fat Bass the bottom of the chord is the bass)
     14  1a24							;   3. REPEAT's echo voices: one or two of what's still spare
     15  1a24							;   4. leftover voices stack on the lowest two notes, alternating
     16  1a24							; So one note = a nine-voice unison across three chips, and in chords the
     17  1a24							; bottom of the chord is fattest. Disabled devices, and voices the drums
     18  1a24							; hold (vDrum), get no notes.
     19  1a24
     20  1a24							; ------------------------------------------------------------ SID
     21  1a24				   SidInit
     22  1a24					      subroutine
     23  1a24		       a2 18		      ldx	#24
     24  1a26		       a9 00		      lda	#0
     25  1a28				   .clr
     26  1a28		       9d 00 d4 	      sta	SID,x
     27  1a2b		       ca		      dex
     28  1a2c		       10 fa		      bpl	.clr
     29  1a2e		       20 51 1a 	      jsr	SidVolume
     30  1a31		       a2 02		      ldx	#2
     31  1a33				   .v
     32  1a33		       bc 6b 82 	      ldy	sidOfs,x
     33  1a36		       a9 19		      lda	#$19	; attack 1, decay 9
     34  1a38		       99 05 d4 	      sta	SID+5,y
     35  1a3b		       a9 c9		      lda	#$C9	; sustain 12, release 9
     36  1a3d		       99 06 d4 	      sta	SID+6,y
     37  1a40		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     38  1a42		       99 03 d4 	      sta	SID+3,y
     39  1a45		       a9 20		      lda	#$20	; sawtooth, gate off
     40  1a47		       9d 32 c3 	      sta	sidGate,x
     41  1a4a		       99 04 d4 	      sta	SID+4,y
     42  1a4d		       ca		      dex
     43  1a4e		       10 e3		      bpl	.v
     44  1a50		       60		      rts
