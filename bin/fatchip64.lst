      0  7c86					      include	"nesfx.asm"
      1  7c86							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7c86							;
      3  7c86							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7c86							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7c86							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7c86							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7c86							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7c86							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7c86							;   glide    a new note starts bent back to the voice's last note and slides
     10  7c86							;	      in the way the SID's does (all three channels)
     11  7c86							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7c86							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7c86							; semitone, so these are a little stepped.
     14  7c86
     15  7c86		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7c86							;  (the pulses, and the triangle while it glides)
     17  7c86
     18  7c86							; A = 1 (not Z) when a NesFxTick step is due
     19  7c86				   NesFxDue
     20  7c86					      subroutine
     21  7c86		       ad 27 c3 	      lda	devOn+DEV_NES
     22  7c89		       f0 1c		      beq	.x
     23  7c8b		       ad ff c5 	      lda	vibDepth
     24  7c8e		       0d 2d c5 	      ora	nfxGlide
     25  7c91		       0d 2e c5 	      ora	nfxRun
     26  7c94		       0d e3 c9 	      ora	nfxWarb
     27  7c97		       f0 0e		      beq	.x
     28  7c99		       a5 10		      lda	ticks
     29  7c9b		       38		      sec
     30  7c9c		       ed 29 c5 	      sbc	nfxLast
     31  7c9f		       c9 08		      cmp	#NFX_EVERY
     32  7ca1		       a9 00		      lda	#0
     33  7ca3		       90 02		      bcc	.x
     34  7ca5		       a9 01		      lda	#1
     35  7ca7				   .x
     36  7ca7		       60		      rts
     37  7ca8
