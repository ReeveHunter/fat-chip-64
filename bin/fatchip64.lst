    136  7686		       dd df c4 	      cmp	nesFxSL,x
    137  7689		       d0 08		      bne	.send
    138  768b		       ad 34 c5 	      lda	nfxH
    139  768e		       dd e8 c4 	      cmp	nesFxSH,x
    140  7691		       f0 0b		      beq	.x
    141  7693				   .send
    142  7693		       a9 01		      lda	#1
