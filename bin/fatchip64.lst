      0  5093					      include	"drums.asm"
      1  5093							; Fat Chip 64 - drums on the MidiNES
      2  5093							;
      3  5093							; Two sources, one kit:
      4  5093							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  5093							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  5093							;			   64 = hit, 56 = ghost)
      7  5093							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  5093							;			   RETURN starts / stops it, at its own tempo (B taps
      9  5093							;			   a new one)
     10  5093							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  5093							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  5093							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  5093							; a note-on, then a note-off after the sound's length, the level set with
     14  5093							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  5093							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  5093
     17  5093		       00 0c	   KIT_SIZE   equ	12
     18  5093		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  5093		       00 00	   DK_KICK    equ	0
     20  5093		       00 01	   DK_SNARE   equ	1
     21  5093		       00 02	   DK_CH      equ	2
     22  5093		       00 03	   DK_OH      equ	3
     23  5093		       00 04	   DK_CY      equ	4
     24  5093		       00 05	   DK_TOM     equ	5
     25  5093		       00 06	   DK_PERC    equ	6
     26  5093
