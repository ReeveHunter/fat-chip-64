------- FILE drums.asm LEVEL 2 PASS 3
      0  3ba1					      include	"drums.asm"
      1  3ba1							; Fat Chip 64 - drums on the MidiNES
      2  3ba1							;
      3  3ba1							; Two sources, one kit:
      4  3ba1							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  3ba1							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  3ba1							;			   64 = hit, 56 = ghost)
      7  3ba1							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  3ba1							;			   RETURN starts / stops it, at its own tempo (B taps
      9  3ba1							;			   a new one)
     10  3ba1							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  3ba1							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  3ba1							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  3ba1							; a note-on, then a note-off after the sound's length, the level set with
     14  3ba1							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  3ba1							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  3ba1
     17  3ba1		       00 0c	   KIT_SIZE   equ	12
     18  3ba1		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  3ba1		       00 00	   DK_KICK    equ	0
     20  3ba1		       00 01	   DK_SNARE   equ	1
     21  3ba1		       00 02	   DK_CH      equ	2
     22  3ba1		       00 03	   DK_OH      equ	3
     23  3ba1		       00 04	   DK_CY      equ	4
     24  3ba1		       00 05	   DK_TOM     equ	5
     25  3ba1		       00 06	   DK_PERC    equ	6
     26  3ba1
     27  3ba1							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  3ba1				   DrumHit
     29  3ba1					      subroutine
     30  3ba1		       8d 83 c4 	      sta	drumKind
     31  3ba4		       8e 82 c4 	      stx	drumLvl
     32  3ba7		       8c 84 c4 	      sty	drumTom
     33  3baa		       c9 00		      cmp	#DK_KICK
     34  3bac		       d0 05		      bne	.nk
     35  3bae		       a9 01		      lda	#1
     36  3bb0		       8d 40 c6 	      sta	vizKick	; (the visualizer's border flash)
     37  3bb3				   .nk
     38  3bb3		       ad 27 c3 	      lda	devOn+DEV_NES
     39  3bb6		       d0 01		      bne	.on
     40  3bb8		       60		      rts
     41  3bb9				   .on
