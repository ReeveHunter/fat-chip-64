------- FILE nesfx.asm LEVEL 2 PASS 3
      0  7a87					      include	"nesfx.asm"
      1  7a87							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7a87							;
      3  7a87							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7a87							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7a87							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7a87							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7a87							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7a87							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7a87							;   glide    a new note starts bent back to the voice's last note and slides
     10  7a87							;	      in the way the SID's does (all three channels)
     11  7a87							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7a87							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7a87							; semitone, so these are a little stepped.
     14  7a87
     15  7a87		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7a87							;  (the pulses, and the triangle while it glides)
     17  7a87
     18  7a87							; A = 1 (not Z) when a NesFxTick step is due
     19  7a87				   NesFxDue
     20  7a87					      subroutine
     21  7a87		       ad 27 c3 	      lda	devOn+DEV_NES
     22  7a8a		       f0 19		      beq	.x
     23  7a8c		       ad ff c5 	      lda	vibDepth
     24  7a8f		       0d 2d c5 	      ora	nfxGlide
     25  7a92		       0d 2e c5 	      ora	nfxRun
     26  7a95		       f0 0e		      beq	.x
     27  7a97		       a5 10		      lda	ticks
     28  7a99		       38		      sec
     29  7a9a		       ed 29 c5 	      sbc	nfxLast
     30  7a9d		       c9 08		      cmp	#NFX_EVERY
     31  7a9f		       a9 00		      lda	#0
     32  7aa1		       90 02		      bcc	.x
     33  7aa3		       a9 01		      lda	#1
     34  7aa5				   .x
     35  7aa5		       60		      rts
     36  7aa6
     37  7aa6							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  7aa6							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  7aa6							; quick return.
