    114  39cc		       ae 34 c4 	      ldx	rxCnt
    115  39cf		       d0 2e		      bne	.second
    116  39d1		       8d 35 c4 	      sta	rxD1
    117  39d4		       ee 34 c4 	      inc	rxCnt
    118  39d7		       ad 33 c4 	      lda	rxStatus
    119  39da		       29 e0		      and	#$E0
    120  39dc		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
    121  39de		       d0 a7		      bne	.next
    122  39e0		       a9 00		      lda	#0
    123  39e2		       8d 34 c4 	      sta	rxCnt
    124  39e5		       20 0d 3a 	      jsr	MidiInMsg
    125  39e8		       4c 87 39 	      jmp	.next
    126  39eb				   .rt
