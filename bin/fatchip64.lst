     27  19f7		       ca		      dex
     28  19f8		       10 fa		      bpl	.clr
     29  19fa		       20 1d 1a 	      jsr	SidVolume
     30  19fd		       a2 02		      ldx	#2
     31  19ff				   .v
     32  19ff		       bc 03 81 	      ldy	sidOfs,x
     33  1a02		       a9 19		      lda	#$19	; attack 1, decay 9
     34  1a04		       99 05 d4 	      sta	SID+5,y
     35  1a07		       a9 c9		      lda	#$C9	; sustain 12, release 9
     36  1a09		       99 06 d4 	      sta	SID+6,y
     37  1a0c		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     38  1a0e		       99 03 d4 	      sta	SID+3,y
     39  1a11		       a9 20		      lda	#$20	; sawtooth, gate off
     40  1a13		       9d 32 c3 	      sta	sidGate,x
     41  1a16		       99 04 d4 	      sta	SID+4,y
     42  1a19		       ca		      dex
