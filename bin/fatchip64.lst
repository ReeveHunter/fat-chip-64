    138  0ef6							; A = key code at ksCol / ksRow
    139  0ef6				   KeyCode
    140  0ef6					      subroutine
    141  0ef6		       ad 37 c3 	      lda	ksCol
    142  0ef9		       0a		      asl
    143  0efa		       0a		      asl
    144  0efb		       0a		      asl
    145  0efc		       0d 38 c3 	      ora	ksRow
    146  0eff		       a8		      tay
    147  0f00		       b9 29 6a 	      lda	keymap,y
    148  0f03		       60		      rts
