    264  0d1f							; ------------------------------------------------------------ queueing (main loop)
    265  0d1f							; Message in mS / mD1 / mD2. Dropped if the queue is full (63 messages).
    266  0d1f				   GbPut
    267  0d1f					      subroutine
    268  0d1f							; write the slot at head first (always free: one slot stays empty),
    269  0d1f							; then publish head unless the queue is full. Uses only A and X.
    270  0d1f		       a6 17		      ldx	gbqHead
    271  0d21		       a5 21		      lda	mS
    272  0d23		       9d 00 c1 	      sta	gbqS,x
    273  0d26		       a5 22		      lda	mD1
    274  0d28		       9d 40 c1 	      sta	gbqD1,x
    275  0d2b		       a5 23		      lda	mD2
    276  0d2d		       9d 80 c1 	      sta	gbqD2,x
    277  0d30		       8a		      txa
    278  0d31		       18		      clc
    279  0d32		       69 01		      adc	#1
    280  0d34		       29 3f		      and	#63
    281  0d36		       c5 18		      cmp	gbqTail
    282  0d38		       f0 02		      beq	.full
    283  0d3a		       85 17		      sta	gbqHead
    284  0d3c				   .full
    285  0d3c		       60		      rts
