    181  0a97		       20 a3 0a 	      jsr	WirePut
    182  0a9a				   .done
    183  0a9a		       ee 1c c3 	      inc	statSent
    184  0a9d		       d0 03		      bne	.x
    185  0a9f		       ee 1d c3 	      inc	statSent+1
    186  0aa2				   .x
