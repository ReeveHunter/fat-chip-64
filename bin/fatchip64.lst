    180  0f38
    181  0f38							; A = key code
    182  0f38							;   overlay	    notes (K held + a note: set the key)
    183  0f38							;   F1 / F3	    octave up / down		F5  beat start / stop
    184  0f38							;   F7 	    visualizer on / off 	RETURN	the menu
    185  0f38							;   SHIFT+F1/F3/F5 SID / Game Boy / MidiNES on-off	SHIFT+F7 panic
    186  0f38							;   CTRL+F3/F5     Game Boy / MidiNES: next channel block
    187  0f38							;   M		    mute everything	   SPACE  its action
    188  0f38							;   =		    latch on (the menu's LATCH STYLE); latched with notes:
    189  0f38							;		    NEXT (the next key starts a new chord); again: off
    190  0f38							;   Z / X	    notes mode (POLY, CHORD, EXT) / extensions (7 9 11 13)
    191  0f38							;   K + note / L   key root / major-minor
    192  0f38							;   V / SHIFT+V    next / previous sound	    C  POLY / MONO
    193  0f38							;   G		    next beat (and drum kit)
    194  0f38							;   A / S / D / F  arp mode / pattern / speed / SPARKLE octave
    195  0f38							;   ; / :	    free arp speed	      B  tap tempo
    196  0f38							;   , / .	    SPACE mode (MUTES / BENDS)
    197  0f38							;   H / J	    MIDI in octave down / up
    198  0f38							;   (the phantom-key filter stays off: GhostKey is kept for a setup menu)
    199  0f38				   KeyDown
    200  0f38					      subroutine
    201  0f38		       c9 18		      cmp	#24
    202  0f3a		       90 03		      bcc	NoteDown
    203  0f3c		       4c d4 0f 	      jmp	.cmd
    204  0f3f				   NoteDown		; A = note index (overlay key 0-23, MIDI slot 24-31)
    205  0f3f		       aa		      tax
    206  0f40		       ad 8b c3 	      lda	kDown
    207  0f43		       f0 03		      beq	.note
    208  0f45		       4c e7 10 	      jmp	SetKeyRoot
    209  0f48				   .note
    210  0f48		       a9 01		      lda	#1
    211  0f4a		       9d b8 c2 	      sta	physKey,x
    212  0f4d		       ee d8 c2 	      inc	physCount
    213  0f50		       20 55 3a 	      jsr	RepeatPress	; REPEAT: its echoes (keeps X)
    214  0f53		       20 92 1a 	      jsr	GetTicks
    215  0f56		       20 44 11 	      jsr	ApplySettings	; (changes waiting for this note)
    216  0f59		       ad 8c c3 	      lda	newPending	; NEXT or a setting change: this note starts a new chord
    217  0f5c		       f0 0b		      beq	.styles
    218  0f5e		       a9 00		      lda	#0
    219  0f60		       8d 8c c3 	      sta	newPending
