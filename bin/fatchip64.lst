    144  2fbc							; A full message: rxStatus, rxD1, rxD2
    145  2fbc				   MidiInMsg
    146  2fbc					      subroutine
    147  2fbc		       ad 26 c4 	      lda	rxStatus
    148  2fbf		       29 0f		      and	#15
    149  2fc1		       c9 0f		      cmp	#DRUM_CH_IN	; channel 16: the keytar's rhythm
    150  2fc3		       d0 1d		      bne	.notes
    151  2fc5		       ad 26 c4 	      lda	rxStatus
