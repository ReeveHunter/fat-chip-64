     82  4e67		       a9 01		      lda	#1
     83  4e69		       8d f9 c5 	      sta	beatClkNew
     84  4e6c		       ad eb c5 	      lda	clkBeatSeen
     85  4e6f		       8d fe c5 	      sta	beatClkNum
     86  4e72		       06 24		      asl	t0
     87  4e74		       26 25		      rol	t1
     88  4e76		       06 24		      asl	t0
     89  4e78		       26 25		      rol	t1
     90  4e7a		       a9 03		      lda	#3
     91  4e7c		       38		      sec
     92  4e7d		       e5 26		      sbc	t2
     93  4e7f		       29 03		      and	#3
     94  4e81		       05 24		      ora	t0
     95  4e83		       85 24		      sta	t0	; t1:t0 = ticks x 4 + quarters
     96  4e85							; the period since the last beat clock (none yet: this one is the start)
     97  4e85		       a5 24		      lda	t0
     98  4e87		       38		      sec
     99  4e88		       ed ef c5 	      sbc	clkLastQL
    100  4e8b		       85 26		      sta	t2
    101  4e8d		       a5 25		      lda	t1
    102  4e8f		       ed f0 c5 	      sbc	clkLastQH
    103  4e92		       85 27		      sta	t3
    104  4e94		       a5 24		      lda	t0
    105  4e96		       8d ef c5 	      sta	clkLastQL
    106  4e99		       a5 25		      lda	t1
    107  4e9b		       8d f0 c5 	      sta	clkLastQH
    108  4e9e				   .meas
    109  4e9e		       ad f1 c5 	      lda	clkSkip	; (a Start moved the beat: no period this time)
    110  4ea1		       d0 05		      bne	.start
    111  4ea3		       ad f2 c5 	      lda	clkHave
    112  4ea6		       d0 10		      bne	.have
    113  4ea8				   .start
    114  4ea8		       a9 00		      lda	#0
    115  4eaa		       8d f1 c5 	      sta	clkSkip
    116  4ead		       ad f2 c5 	      lda	clkHave
    117  4eb0		       d0 05		      bne	.st2
    118  4eb2		       a9 01		      lda	#1
    119  4eb4		       8d f2 c5 	      sta	clkHave
    120  4eb7				   .st2
    121  4eb7		       60		      rts
    122  4eb8				   .have
    123  4eb8							; 250 ms .. 2 s (1000 .. 8000 quarters), else start the average again
    124  4eb8		       a5 27		      lda	t3
    125  4eba		       c9 03		      cmp	#>1000
    126  4ebc		       90 10		      bcc	.bad0
    127  4ebe		       d0 06		      bne	.hi
    128  4ec0		       a5 26		      lda	t2
    129  4ec2		       c9 e8		      cmp	#<1000
    130  4ec4		       90 08		      bcc	.bad0
    131  4ec6				   .hi
    132  4ec6		       a5 27		      lda	t3
    133  4ec8		       c9 1f		      cmp	#>8000
    134  4eca		       90 05		      bcc	.ok
    135  4ecc		       f0 03		      beq	.ok
    136  4ece				   .bad0
    137  4ece		       4c 8a 4f 	      jmp	.bad
    138  4ed1				   .ok
    139  4ed1							; period in 1/16 ms
    140  4ed1		       06 26		      asl	t2
    141  4ed3		       26 27		      rol	t3
    142  4ed5		       06 26		      asl	t2
    143  4ed7		       26 27		      rol	t3
    144  4ed9		       ad f2 c5 	      lda	clkHave
    145  4edc		       c9 02		      cmp	#2
