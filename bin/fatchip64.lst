    470  0b8c							; RESTORE: the only NMI source. Count presses; the main loop acts on them.
    471  0b8c							; (A MIDI chip wired to NMI instead could fire one during MidiIrqTest: that
    472  0b8c							; isn't a press.)
    473  0b8c				   Nmi
    474  0b8c					      subroutine
    475  0b8c		       48		      pha
    476  0b8d		       ad 06 de 	      lda	ACIA_STAT
    477  0b90		       10 07		      bpl	.r
    478  0b92		       a9 16		      lda	#ACIA_MODE
    479  0b94		       8d 04 de 	      sta	ACIA_CTRL
    480  0b97		       68		      pla
    481  0b98		       40		      rti
    482  0b99				   .r
    483  0b99		       ad 0d dd 	      lda	CIA2_ICR	; acknowledge anything CIA 2 holds, so the NMI
    484  0b9c							; line is free for the next RESTORE edge
    485  0b9c		       e6 1d		      inc	nmiCount
    486  0b9e		       a5 10		      lda	ticks
    487  0ba0		       85 1e		      sta	nmiTick
    488  0ba2		       a5 11		      lda	ticks+1
    489  0ba4		       85 1f		      sta	nmiTick+1
    490  0ba6		       68		      pla
    491  0ba7		       40		      rti
