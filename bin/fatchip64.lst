     65  217b		       4a		      lsr
     66  217c		       4a		      lsr
     67  217d		       8d da c3 	      sta	bT0	; n
     68  2180		       ad 9d c4 	      lda	bendBtn	; the keytar's BEND DOWN button, held
     69  2183		       d0 0c		      bne	.down
     70  2185		       ad d9 c3 	      lda	spaceDown
