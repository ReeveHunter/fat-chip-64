     85  347f		       e8		      inx
     86  3480		       8a		      txa
     87  3481		       29 3f		      and	#63
     88  3483		       8d 26 c4 	      sta	rxTail
     89  3486		       98		      tya
     90  3487		       10 1e		      bpl	.data
     91  3489		       c9 f8		      cmp	#$F8
     92  348b		       b0 49		      bcs	.rt	; realtime (clocks are counted by RxByte)
     93  348d		       c9 f0		      cmp	#$F0
     94  348f		       b0 07		      bcs	.sys
     95  3491		       a2 00		      ldx	#0	; a channel message ends any SysEx
     96  3493		       8e 4d c7 	      stx	sxOn
     97  3496		       f0 05		      beq	.status
     98  3498				   .sys
     99  3498		       20 43 36 	      jsr	SysexStatus	; F0 starts a SysEx, F7 ends it (v0.20)
    100  349b		       a9 00		      lda	#0	; system: no running status until the next one
    101  349d				   .status
    102  349d		       8d 27 c4 	      sta	rxStatus
    103  34a0		       a9 00		      lda	#0
    104  34a2		       8d 28 c4 	      sta	rxCnt
    105  34a5		       f0 cb		      beq	.next
    106  34a7				   .data
    107  34a7		       ae 4d c7 	      ldx	sxOn
    108  34aa		       f0 06		      beq	.nosx
    109  34ac		       20 84 36 	      jsr	SysexByte
    110  34af		       4c 72 34 	      jmp	.next
    111  34b2				   .nosx
    112  34b2		       ae 27 c4 	      ldx	rxStatus
    113  34b5		       f0 bb		      beq	.next	; no status yet
    114  34b7		       ae 28 c4 	      ldx	rxCnt
    115  34ba		       d0 2e		      bne	.second
    116  34bc		       8d 29 c4 	      sta	rxD1
    117  34bf		       ee 28 c4 	      inc	rxCnt
    118  34c2		       ad 27 c4 	      lda	rxStatus
    119  34c5		       29 e0		      and	#$E0
    120  34c7		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
    121  34c9		       d0 a7		      bne	.next
    122  34cb		       a9 00		      lda	#0
    123  34cd		       8d 28 c4 	      sta	rxCnt
    124  34d0		       20 f8 34 	      jsr	MidiInMsg
    125  34d3		       4c 72 34 	      jmp	.next
    126  34d6				   .rt
    127  34d6		       c9 fa		      cmp	#$FA
    128  34d8		       d0 06		      bne	.rt2
    129  34da		       20 7f 50 	      jsr	KeytarStart
    130  34dd		       4c 72 34 	      jmp	.next
    131  34e0				   .rt2
    132  34e0		       c9 fc		      cmp	#$FC
    133  34e2		       d0 03		      bne	.rt3
    134  34e4		       20 a0 50 	      jsr	KeytarStop
    135  34e7				   .rt3
    136  34e7		       4c 72 34 	      jmp	.next
    137  34ea				   .second
    138  34ea		       8d 2a c4 	      sta	rxD2
    139  34ed		       a9 00		      lda	#0
    140  34ef		       8d 28 c4 	      sta	rxCnt
    141  34f2		       20 f8 34 	      jsr	MidiInMsg
    142  34f5		       4c 72 34 	      jmp	.next
