      6  7a01							;	       each plays (row 7: a channel overlap warning)
      7  7a01							;  row 9      key, notes mode, latch
      8  7a01							;  row 10     arp
      9  7a01							;  row 12     tempo, beat, mute
     10  7a01							;  row 13     SPACE's action, octave (the lowest key), transpose
     11  7a01							;  row 14     v0.40: the effect the C= keys work on, its setting
     12  7a01							;  row 15     held notes
     13  7a01							;  row 16     MIDI in
     14  7a01							;  row 24     F keys
     15  7a01
