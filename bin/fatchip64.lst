      0  0e0b					      include	"keys.asm"
      1  0e0b							; Fat Chip 64 - keyboard and RESTORE
      2  0e0b
      3  0e0b							; Scan the whole matrix, turn changes into key events.
      4  0e0b							;
      5  0e0b							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0e0b							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0e0b							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0e0b							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0e0b							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0e0b							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0e0b							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0e0b							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0e0b							; chords whose ghost lands on another used key lose their newest note.
     14  0e0b				   KeyScan
     15  0e0b					      subroutine
     16  0e0b		       a2 07		      ldx	#7
     17  0e0d				   .col
     18  0e0d		       bd 19 6a 	      lda	colSelect,x
     19  0e10		       8d 00 dc 	      sta	CIA1_PRA
     20  0e13		       ad 01 dc 	      lda	CIA1_PRB
     21  0e16		       49 ff		      eor	#$FF
     22  0e18		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0e1b		       9d 80 c2 	      sta	keyNow,x
     24  0e1e		       ca		      dex
     25  0e1f		       10 ec		      bpl	.col
     26  0e21		       a9 ff		      lda	#$FF
     27  0e23		       8d 00 dc 	      sta	CIA1_PRA
     28  0e26							; ---- every column as accepted (nothing pressed or let go): done
     29  0e26		       a2 07		      ldx	#7
     30  0e28				   .same
     31  0e28		       bd 80 c2 	      lda	keyNow,x
     32  0e2b		       dd 90 c2 	      cmp	keyAcc,x
     33  0e2e		       d0 04		      bne	.changed
     34  0e30		       ca		      dex
     35  0e31		       10 f5		      bpl	.same
     36  0e33		       60		      rts
     37  0e34				   .changed
     38  0e34							; ---- releases first: accepted keys that are up now
     39  0e34		       a2 00		      ldx	#0
     40  0e36				   .rc
     41  0e36		       8e 37 c3 	      stx	ksCol
     42  0e39		       bd 80 c2 	      lda	keyNow,x
     43  0e3c		       49 ff		      eor	#$FF
     44  0e3e		       3d 90 c2 	      and	keyAcc,x
     45  0e41		       8d 36 c3 	      sta	ksBits
     46  0e44		       a9 00		      lda	#0
     47  0e46		       8d 38 c3 	      sta	ksRow
     48  0e49				   .rb
     49  0e49		       ad 36 c3 	      lda	ksBits
     50  0e4c		       f0 21		      beq	.rcn
     51  0e4e		       4e 36 c3 	      lsr	ksBits
     52  0e51		       90 17		      bcc	.rbn
     53  0e53		       ae 37 c3 	      ldx	ksCol
     54  0e56		       ac 38 c3 	      ldy	ksRow
     55  0e59		       b9 21 6a 	      lda	rowBit,y
     56  0e5c		       49 ff		      eor	#$FF
     57  0e5e		       3d 90 c2 	      and	keyAcc,x
     58  0e61		       9d 90 c2 	      sta	keyAcc,x
     59  0e64		       20 f6 0e 	      jsr	KeyCode
     60  0e67		       20 b8 11 	      jsr	KeyUp
     61  0e6a				   .rbn
     62  0e6a		       ee 38 c3 	      inc	ksRow
     63  0e6d		       d0 da		      bne	.rb
     64  0e6f				   .rcn
     65  0e6f		       ae 37 c3 	      ldx	ksCol
     66  0e72		       e8		      inx
     67  0e73		       e0 08		      cpx	#8
     68  0e75		       d0 bf		      bne	.rc
     69  0e77							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     70  0e77							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     71  0e77							; still count as a combination.
     72  0e77		       a9 00		      lda	#0
     73  0e79		       8d 3a c3 	      sta	ksPass
     74  0e7c				   .pass
     75  0e7c		       a2 00		      ldx	#0
     76  0e7e				   .pc
     77  0e7e		       8e 37 c3 	      stx	ksCol
     78  0e81		       bd 90 c2 	      lda	keyAcc,x
     79  0e84		       49 ff		      eor	#$FF
     80  0e86		       3d 80 c2 	      and	keyNow,x
     81  0e89		       8d 36 c3 	      sta	ksBits
     82  0e8c		       a9 00		      lda	#0
     83  0e8e		       8d 38 c3 	      sta	ksRow
     84  0e91				   .pb
     85  0e91		       ad 36 c3 	      lda	ksBits
     86  0e94		       f0 3d		      beq	.pcn
     87  0e96		       4e 36 c3 	      lsr	ksBits
     88  0e99		       90 33		      bcc	.pbn
     89  0e9b		       ad 3b c3 	      lda	ghostFilter
     90  0e9e		       f0 05		      beq	.accept	; filter off (default): phantoms play
     91  0ea0		       20 04 0f 	      jsr	Suspect
     92  0ea3		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     93  0ea5				   .accept
     94  0ea5		       20 f6 0e 	      jsr	KeyCode
     95  0ea8		       20 e7 0e 	      jsr	IsModifier	; Z set = modifier
     96  0eab		       f0 07		      beq	.mod
     97  0ead		       ad 3a c3 	      lda	ksPass
     98  0eb0		       f0 1c		      beq	.pbn	; pass 0: modifiers only
     99  0eb2		       d0 05		      bne	.take
    100  0eb4				   .mod
    101  0eb4		       ad 3a c3 	      lda	ksPass
    102  0eb7		       d0 15		      bne	.pbn	; (taken in pass 0)
    103  0eb9				   .take
    104  0eb9		       ae 37 c3 	      ldx	ksCol
    105  0ebc		       ac 38 c3 	      ldy	ksRow
    106  0ebf		       b9 21 6a 	      lda	rowBit,y
    107  0ec2		       1d 90 c2 	      ora	keyAcc,x
    108  0ec5		       9d 90 c2 	      sta	keyAcc,x
    109  0ec8		       20 f6 0e 	      jsr	KeyCode
    110  0ecb		       20 35 0f 	      jsr	KeyDown
    111  0ece				   .pbn
    112  0ece		       ee 38 c3 	      inc	ksRow
    113  0ed1		       d0 be		      bne	.pb
    114  0ed3				   .pcn
    115  0ed3		       ae 37 c3 	      ldx	ksCol
    116  0ed6		       e8		      inx
    117  0ed7		       e0 08		      cpx	#8
    118  0ed9		       d0 a3		      bne	.pc
    119  0edb		       ad 3a c3 	      lda	ksPass
    120  0ede		       d0 06		      bne	.done
    121  0ee0		       ee 3a c3 	      inc	ksPass
