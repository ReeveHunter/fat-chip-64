------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  335e					      include	"sounds.asm"
      1  335e							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  335e							;
      3  335e							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  335e							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  335e							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  335e							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  335e							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  335e							;
      9  335e							; Each sound has a mono default and a Fat Bass default:
     10  335e							;   MONO      one note (the last key pressed and still held) on every voice;
     11  335e							;	       a new key while another is held changes the pitch without a
     12  335e							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  335e							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  335e							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  335e							;	       the other voices
     16  335e							;
     17  335e							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  335e							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  335e							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  335e
     21  335e							; ------------------------------------------------------------ choosing
     22  335e							; V: next sound (SHIFT+V: previous)
     23  335e				   SoundKey
     24  335e					      subroutine
     25  335e		       20 d8 33 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3361		       ae 94 c3 	      ldx	soundMode
     27  3364		       ad 2a c3 	      lda	shiftDown
     28  3367		       d0 09		      bne	.prev
     29  3369		       e8		      inx
     30  336a		       e0 13		      cpx	#NUM_SOUNDS
     31  336c		       90 09		      bcc	.s
     32  336e		       a2 00		      ldx	#0
     33  3370		       f0 05		      beq	.s
     34  3372				   .prev
     35  3372		       ca		      dex
     36  3373		       10 02		      bpl	.s
     37  3375		       a2 12		      ldx	#NUM_SOUNDS-1
     38  3377				   .s
