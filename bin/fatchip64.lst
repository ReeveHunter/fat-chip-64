    109  759b		       ad a3 c6 	      lda	sndPenvK
    110  759e		       ae 9f c6 	      ldx	sndStep
    111  75a1		       f0 02		      beq	.k
    112  75a3		       a9 ff		      lda	#$FF	; (STEP: held; AtkStep jumps)
    113  75a5				   .k
