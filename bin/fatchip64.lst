     95  6bd8		       ca		      dex
     96  6bd9		       ca		      dex
     97  6bda		       ca		      dex
     98  6bdb		       10 de		      bpl	.v
     99  6bdd							; ---- the NES queue needs room
    100  6bdd		       a5 1a		      lda	nesqHead
    101  6bdf		       38		      sec
    102  6be0		       e5 1b		      sbc	nesqTail
    103  6be2		       29 3f		      and	#63
    104  6be4		       c9 08		      cmp	#Q_BACKLOG
    105  6be6		       b0 51		      bcs	.x
    106  6be8							; ---- the next NES voice: a bend if its effects moved
    107  6be8		       ad 2d c5 	      lda	nfxRun	; (a few rounds after an effects change)
    108  6beb		       f0 03		      beq	.r
