    173  8131		       bd d9 c4 	      lda	nesGlH,x
    174  8134		       8d 40 c5 	      sta	nfxH
    175  8137		       bc 7c c9 	      ldy	nesK,x	; (BEND IN: its own)
    176  813a		       d0 07		      bne	.sh
