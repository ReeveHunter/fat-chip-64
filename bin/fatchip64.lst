------- FILE repeat.asm LEVEL 2 PASS 3
      0  388e					      include	"repeat.asm"
      1  388e							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  388e							;
      3  388e							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  388e							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  388e							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  388e							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  388e							; 1s), taken out of the chord while REPEAT is on - unless the notes held need
      8  388e							; them (then held notes come first and the echoes wait). Each echo sounds for
      9  388e							; 3/4 of the time between echoes. The SID doesn't echo.
     10  388e							;
     11  388e							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     12  388e							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     13  388e							; or a keytar button).
     14  388e							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     15  388e							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     16  388e
     17  388e		       00 10	   RP_SLOTS   equ	16
     18  388e		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     19  388e
     20  388e							; REPEAT is on now?
     21  388e				   RepeatActive
     22  388e		       ad 4c c5 	      lda	repeatOn
     23  3891		       0d ac c4 	      ora	actCnt+A_REPEAT
     24  3894		       60		      rts
