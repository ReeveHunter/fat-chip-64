    185  0fdc							; A = key code (v0.22 layout)
    186  0fdc							;   overlay	    notes
    187  0fdc							;   A S D F G	    bank (FAT PADS LEADS BASS FX): switches at once, same slot
    188  0fdc							;   Z X C V B	    patch 1-5 in the bank
    189  0fdc							;   L		    latch on / off	      K, then a note or a shape: key + scale
    190  0fdc							;   =		    tap tempo		      , / .  tempo -1 / +1 (SHIFT: 10)
    191  0fdc							;   /		    mute		      SHIFT+/  the dice
    192  0fdc							;   ; / :	    free arp speed	      SPACE  its action
    193  0fdc							;   F1 / F3	    octave up / down	      F5  arp on / off	  F7  visualizer
    194  0fdc							;   RETURN	    the menu		      CTRL+F3/F5  GB / NES channel block
    195  0fdc							;   C= +  A S D F  arp type / pattern / speed / SPARKLE octave
    196  0fdc							;	   Z X C    notes mode / extensions / POLY-MONO     L  latch style
    197  0fdc							;	   V	    SPLIT (tapped: OFF KEY LOW NOTE LATCH 3; held + a note:
    198  0fdc							;		    the split point there, on the C64's keys or over MIDI)
    199  0fdc							;	   , .	    SPACE's action	      ; :  MIDI in octave down / up
    200  0fdc							;	   /	    undo the dice	      F1 F3 F5	SID / GB / NES on-off
    201  0fdc							;	   F7	    panic		      (SHIFT + F keys too, as before)
    202  0fdc							;   RUN/STOP	    tapped: beat start / stop; held + A S D F G H: pick a beat
    203  0fdc				   KeyDown
