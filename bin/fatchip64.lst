------- FILE attack.asm LEVEL 2 PASS 3
      0  747a					      include	"attack.asm"
      1  747a							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  747a							; how each note starts and ends in pitch
      3  747a							;
      4  747a							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  747a							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  747a							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  747a							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  747a							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  747a							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  747a							;   (v0.42) as long as TIME.
     11  747a							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  747a							;   release rings.
     13  747a
     14  747a							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  747a							; jumps to the note
     16  747a				   AtkStep
     17  747a					      subroutine
     18  747a		       ac cb c3 	      ldy	envY
     19  747d		       b9 75 c9 	      lda	atkT,y
     20  7480		       18		      clc
