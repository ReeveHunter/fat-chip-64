------- FILE screen.asm LEVEL 2 PASS 3
      0  7269					      include	"screen.asm"
      1  7269							; Fat Chip 64 - screen
      2  7269							;
      3  7269							;  row 0      header
      4  7269							;  row 2      sound, POLY / MONO, Fat Bass
      5  7269							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  7269							;	       each plays (row 7: a channel overlap warning)
      7  7269							;  row 9      key, notes mode, latch
      8  7269							;  row 10     arp
      9  7269							;  row 12     tempo, beat, mute
     10  7269							;  row 13     SPACE's action, octave (the lowest key), transpose
     11  7269							;  row 14     v0.40: the effect the C= keys work on, its setting
     12  7269							;  row 15     held notes
     13  7269							;  row 16     MIDI in
     14  7269							;  row 24     F keys
     15  7269
     16  7269							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     17  7269							; Letters become screen codes; bit 7 of t2 reverses.
