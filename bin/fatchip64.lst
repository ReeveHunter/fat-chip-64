      0  4e49					      include	"menu.asm"
      1  4e49							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  4e49							;
      3  4e49							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  4e49							;   page   RETURN opens a page
      5  4e49							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  4e49							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  4e49							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  4e49							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  4e49							; device pages, until DEVICES says the device is in use).
     10  4e49							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  4e49							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  4e49							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  4e49
     14  4e49		       00 17	   MENU_VALCOL equ	23
     15  4e49
