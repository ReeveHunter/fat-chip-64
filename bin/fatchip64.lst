    116  0edc		       e8		      inx
    117  0edd		       e0 08		      cpx	#8
    118  0edf		       d0 a3		      bne	.pc
    119  0ee1		       ad 3a c3 	      lda	ksPass
    120  0ee4		       d0 06		      bne	.done
    121  0ee6		       ee 3a c3 	      inc	ksPass
    122  0ee9		       4c 82 0e 	      jmp	.pass
    123  0eec				   .done
    124  0eec		       60		      rts
