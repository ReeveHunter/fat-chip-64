     95  3aed		       a2 00		      ldx	#0	; a channel message ends any SysEx
     96  3aef		       8e 19 cc 	      stx	sxOn
     97  3af2		       f0 05		      beq	.status
     98  3af4				   .sys
     99  3af4		       20 ac 3c 	      jsr	SysexStatus	; F0 starts a SysEx, F7 ends it (v0.20)
    100  3af7		       a9 00		      lda	#0	; system: no running status until the next one
    101  3af9				   .status
    102  3af9		       8d f3 c8 	      sta	rxStatus
    103  3afc		       a9 00		      lda	#0
    104  3afe		       8d f4 c8 	      sta	rxCnt
    105  3b01		       f0 cb		      beq	.next
