------- FILE devices.asm LEVEL 2 PASS 3
      0  58cb					      include	"devices.asm"
      1  58cb							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  58cb							; are in use, and each one in use gets its page on the main menu.
      3  58cb							;
      4  58cb							; YAMAHA SHS-10 (the keytar)
      5  58cb							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  58cb							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  58cb							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  58cb							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  58cb							;		     can play at once.)
     10  58cb							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  58cb							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  58cb							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  58cb							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  58cb							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  58cb							;		     louder (the SID and the NES; the Game Boy would click) or
     16  58cb							;		     brighter (the SID's filter: switched on if the patch has
     17  58cb							;		     none)
     18  58cb							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  58cb							;		     the patch's, or the ADVANCED amounts if it has none;
     20  58cb							;		     FILTER), or an action held while blowing hard
     21  58cb							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  58cb							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  58cb							;   PORTAMENTO BUTTON	an action (CC 65)
     24  58cb							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  58cb							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  58cb							; ATARI SYNTHCART
     27  58cb							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  58cb							;		     about 3% while held, SHIFT + , . step through the ten
     29  58cb							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  58cb							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  58cb							;		     sound's cents (the Synthcart manual's table: each Atari
     32  58cb							;		     sound plays its scales in its own key, a little off)
     33  58cb							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  58cb
     35  58cb		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  58cb		       00 28	   BREATH_LO  equ	40
     37  58cb		       00 01	   BFX_VIB    equ	1
     38  58cb		       00 02	   BFX_WARB   equ	2
     39  58cb		       00 03	   BFX_DET    equ	3
     40  58cb		       00 04	   BFX_FILT   equ	4
     41  58cb		       00 05	   BFX_HELD   equ	5
     42  58cb
