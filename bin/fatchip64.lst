    233  1013				   .ncl
    234  1013		       ad 8c c3 	      lda	newPending	; NEXT or a setting change: this note starts a new chord
    235  1016		       f0 0b		      beq	.styles
    236  1018		       a9 00		      lda	#0
    237  101a		       8d 8c c3 	      sta	newPending
    238  101d		       20 26 18 	      jsr	ClearNotes
    239  1020		       4c 64 10 	      jmp	.add
    240  1023				   .styles
    241  1023		       ad 40 c4 	      lda	latch
    242  1026		       c9 03		      cmp	#LATCH_ADD
    243  1028		       f0 54		      beq	.addStyle
