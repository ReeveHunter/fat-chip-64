------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  514d					      include	"sync.asm"
      1  514d							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  514d							;
      3  514d							; Menu, DEVICE SYNC (defaults first):
      4  514d							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  514d							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  514d							;		     sets the tempo, averaged over beats (the clock jitters about
      7  514d							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  514d							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  514d							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  514d							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  514d							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  514d							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  514d							;		     picks a beat demo (styleBeat)
     14  514d							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  514d							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  514d							;		     key channel) picks a sound (voiceSound)
     17  514d							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  514d							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  514d							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  514d							;
     21  514d							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  514d							; 1/4 ms); a Start makes the next clock a beat.
     23  514d
     24  514d		       00 00	   TEMPO_KEYTAR equ	0
     25  514d		       00 01	   TEMPO_OWN  equ	1
     26  514d		       00 02	   TEMPO_SC   equ	2
     27  514d		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  514d
     29  514d
     30  514d
     31  514d							; ------------------------------------------------------------ clock
