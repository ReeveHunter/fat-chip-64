    441  5f94							; ------------------------------------------------------------ tuning
    442  5f94							; tuneC = PLAYING's FINE TUNE + the Synthcart's TUNE TO (while it's in use),
    443  5f94							; in cents (-100..+100). The Game Boy gets it as master tune (CC 103), the
    444  5f94							; NES in its bends (tuneN, 1/64 semitones), the SID in its note frequencies
    445  5f94							; (SidTune; the notes sounding move at once). MATCH KEY sets the key's root
    446  5f94							; once, when it changes.
    447  5f94				   ScTune
    448  5f94					      subroutine
    449  5f94		       a9 00		      lda	#0
    450  5f96		       ae 37 c8 	      ldx	useSc
