    200  0bbb							; ------------------------------------------------------------ queueing (main loop)
    201  0bbb							; Message in mS / mD1 / mD2. Dropped if the queue is full (63 messages).
    202  0bbb				   GbPut
    203  0bbb					      subroutine
    204  0bbb							; write the slot at head first (always free: one slot stays empty),
    205  0bbb							; then publish head unless the queue is full. Uses only A and X.
    206  0bbb		       a6 17		      ldx	gbqHead
    207  0bbd		       a5 21		      lda	mS
    208  0bbf		       9d 00 c1 	      sta	gbqS,x
    209  0bc2		       a5 22		      lda	mD1
