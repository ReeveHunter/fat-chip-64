------- FILE main.asm LEVEL 1 PASS 3
      1  5f11 ????						; Fat Chip 64 - main program
      2  5f11 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  5f11 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  5f11 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  5f11 ????
      6  5f11 ????				      processor	6502
