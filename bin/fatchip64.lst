      0  0b1a					      include	"midi.asm"
      1  0b1a							; Fat Chip 64 - MIDI out
      2  0b1a							;
      3  0b1a							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0b1a							; at most one message per device onto the wire buffer, no sooner than that
      5  0b1a							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0b1a							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0b1a							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0b1a							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0b1a							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0b1a
     11  0b1a				   MidiInit
     12  0b1a					      subroutine
     13  0b1a		       a9 03		      lda	#ACIA_RESET
