------- FILE main.asm LEVEL 1 PASS 2
      1  1623 ????						; Fat Chip 64 - main program
      2  1623 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  1623 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  1623 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  1623 ????
      6  1623 ????				      processor	6502
