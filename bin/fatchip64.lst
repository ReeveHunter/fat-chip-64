    113  518b		       20 95 0d 	      jsr	NesPut
    114  518e				   .r
    115  518e		       a5 27		      lda	t3
    116  5190		       cd 62 fd 	      cmp	dmcRate
    117  5193		       f0 0c		      beq	.note
    118  5195		       8d 62 fd 	      sta	dmcRate
    119  5198		       85 23		      sta	mD2
    120  519a		       a9 03		      lda	#3
    121  519c		       85 22		      sta	mD1
    122  519e		       20 95 0d 	      jsr	NesPut
    123  51a1				   .note
    124  51a1		       a5 21		      lda	mS
    125  51a3		       29 0f		      and	#$0F
    126  51a5		       09 90		      ora	#$90
    127  51a7		       85 21		      sta	mS
    128  51a9		       a5 25		      lda	t1
    129  51ab		       29 7f		      and	#$7F
    130  51ad		       8d 51 c9 	      sta	dmcNote
    131  51b0		       85 22		      sta	mD1
    132  51b2		       a9 7f		      lda	#127
    133  51b4		       85 23		      sta	mD2
    134  51b6		       4c 95 0d 	      jmp	NesPut
    135  51b9				   .x
    136  51b9		       60		      rts
