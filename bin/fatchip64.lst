     73  27e0		       c9 04		      cmp	#BEND_DOWN_MS
     74  27e2		       b0 03		      bcs	.step
     75  27e4		       4c 8a 28 	      jmp	.midi
     76  27e7				   .step
     77  27e7							; n = elapsed / 4 steps; keep the remainder
     78  27e7		       8d d9 c3 	      sta	bT0
     79  27ea		       29 03		      and	#3
     80  27ec		       8d da c3 	      sta	bT1
     81  27ef		       ad 3e c3 	      lda	nowL
     82  27f2		       38		      sec
     83  27f3		       ed da c3 	      sbc	bT1
     84  27f6		       8d d5 c3 	      sta	bendLast
     85  27f9		       ad d9 c3 	      lda	bT0
     86  27fc		       4a		      lsr
     87  27fd		       4a		      lsr
     88  27fe		       8d d9 c3 	      sta	bT0	; n
     89  2801							; ---- BEND DOWN / BEND UP held: up to 255; let go: back twice as fast
     90  2801		       ad a1 c4 	      lda	actCnt+A_BENDDN
     91  2804		       0d a2 c4 	      ora	actCnt+A_BENDUP
