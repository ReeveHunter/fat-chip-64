------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  5b34					      include	"sync.asm"
      1  5b34							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  5b34							;
      3  5b34							; Menu, DEVICE SYNC (defaults first):
      4  5b34							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  5b34							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  5b34							;		     sets the tempo, averaged over beats (the clock jitters about
      7  5b34							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  5b34							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  5b34							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  5b34							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  5b34							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  5b34							;   RHYTHM BUTTONS  IN ORDER / BY FEEL / IGNORE: its rhythm (Program Change on
     13  5b34							;		     channel 16, the keytar's 00-44) picks beat n (bank n / 5), or
     14  5b34							;		     the beat nearest its style (styleBeat)
     15  5b34							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     16  5b34							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     17  5b34							;		     key channel) picks a sound (voiceSound)
     18  5b34							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     19  5b34							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     20  5b34							;		     127 held, 0 let go), the same list as SPACE (actions below)
     21  5b34							;
     22  5b34							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     23  5b34							; 1/4 ms); a Start makes the next clock a beat.
     24  5b34
     25  5b34		       00 00	   TEMPO_KEYTAR equ	0
     26  5b34		       00 01	   TEMPO_OWN  equ	1
