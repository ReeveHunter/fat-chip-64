------- FILE keys.asm LEVEL 2 PASS 2
      0  0c6b					      include	"keys.asm"
      1  0c6b							; Fat Chip 64 - keyboard and RESTORE
      2  0c6b
      3  0c6b							; Scan the whole matrix, turn changes into key events.
      4  0c6b							;
      5  0c6b							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0c6b							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0c6b							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0c6b							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0c6b							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0c6b							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0c6b							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0c6b							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0c6b							; chords whose ghost lands on another used key lose their newest note.
     14  0c6b				   KeyScan
     15  0c6b					      subroutine
     16  0c6b		       a2 07		      ldx	#7
     17  0c6d				   .col
     18  0c6d		       bd 72 2a 	      lda	colSelect,x
     19  0c70		       8d 00 dc 	      sta	CIA1_PRA
     20  0c73		       ad 01 dc 	      lda	CIA1_PRB
     21  0c76		       49 ff		      eor	#$FF
     22  0c78		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0c7b		       9d 80 c2 	      sta	keyNow,x
     24  0c7e		       ca		      dex
     25  0c7f		       10 ec		      bpl	.col
     26  0c81		       a9 ff		      lda	#$FF
     27  0c83		       8d 00 dc 	      sta	CIA1_PRA
     28  0c86							; ---- releases first: accepted keys that are up now
     29  0c86		       a2 00		      ldx	#0
     30  0c88				   .rc
     31  0c88		       8e 37 c3 	      stx	ksCol
     32  0c8b		       bd 80 c2 	      lda	keyNow,x
     33  0c8e		       49 ff		      eor	#$FF
     34  0c90		       3d 90 c2 	      and	keyAcc,x
     35  0c93		       8d 36 c3 	      sta	ksBits
     36  0c96		       a9 00		      lda	#0
     37  0c98		       8d 38 c3 	      sta	ksRow
     38  0c9b				   .rb
     39  0c9b		       ad 36 c3 	      lda	ksBits
     40  0c9e		       f0 21		      beq	.rcn
     41  0ca0		       4e 36 c3 	      lsr	ksBits
     42  0ca3		       90 17		      bcc	.rbn
     43  0ca5		       ae 37 c3 	      ldx	ksCol
     44  0ca8		       ac 38 c3 	      ldy	ksRow
     45  0cab		       b9 7a 2a 	      lda	rowBit,y
     46  0cae		       49 ff		      eor	#$FF
     47  0cb0		       3d 90 c2 	      and	keyAcc,x
     48  0cb3		       9d 90 c2 	      sta	keyAcc,x
     49  0cb6		       20 48 0d 	      jsr	KeyCode
     50  0cb9		       20 eb 0f 	      jsr	KeyUp
     51  0cbc				   .rbn
     52  0cbc		       ee 38 c3 	      inc	ksRow
     53  0cbf		       d0 da		      bne	.rb
     54  0cc1				   .rcn
     55  0cc1		       ae 37 c3 	      ldx	ksCol
     56  0cc4		       e8		      inx
     57  0cc5		       e0 08		      cpx	#8
     58  0cc7		       d0 bf		      bne	.rc
     59  0cc9							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     60  0cc9							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     61  0cc9							; still count as a combination.
     62  0cc9		       a9 00		      lda	#0
     63  0ccb		       8d 3a c3 	      sta	ksPass
     64  0cce				   .pass
     65  0cce		       a2 00		      ldx	#0
     66  0cd0				   .pc
     67  0cd0		       8e 37 c3 	      stx	ksCol
     68  0cd3		       bd 90 c2 	      lda	keyAcc,x
     69  0cd6		       49 ff		      eor	#$FF
     70  0cd8		       3d 80 c2 	      and	keyNow,x
     71  0cdb		       8d 36 c3 	      sta	ksBits
     72  0cde		       a9 00		      lda	#0
     73  0ce0		       8d 38 c3 	      sta	ksRow
     74  0ce3				   .pb
     75  0ce3		       ad 36 c3 	      lda	ksBits
     76  0ce6		       f0 3d		      beq	.pcn
     77  0ce8		       4e 36 c3 	      lsr	ksBits
     78  0ceb		       90 33		      bcc	.pbn
     79  0ced		       ad 3b c3 	      lda	ghostFilter
     80  0cf0		       f0 05		      beq	.accept	; filter off (default): phantoms play
     81  0cf2		       20 56 0d 	      jsr	Suspect
     82  0cf5		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     83  0cf7				   .accept
     84  0cf7		       20 48 0d 	      jsr	KeyCode
     85  0cfa		       20 39 0d 	      jsr	IsModifier	; Z set = modifier
     86  0cfd		       f0 07		      beq	.mod
     87  0cff		       ad 3a c3 	      lda	ksPass
     88  0d02		       f0 1c		      beq	.pbn	; pass 0: modifiers only
     89  0d04		       d0 05		      bne	.take
     90  0d06				   .mod
     91  0d06		       ad 3a c3 	      lda	ksPass
     92  0d09		       d0 15		      bne	.pbn	; (taken in pass 0)
     93  0d0b				   .take
     94  0d0b		       ae 37 c3 	      ldx	ksCol
     95  0d0e		       ac 38 c3 	      ldy	ksRow
     96  0d11		       b9 7a 2a 	      lda	rowBit,y
     97  0d14		       1d 90 c2 	      ora	keyAcc,x
     98  0d17		       9d 90 c2 	      sta	keyAcc,x
     99  0d1a		       20 48 0d 	      jsr	KeyCode
    100  0d1d		       20 87 0d 	      jsr	KeyDown
    101  0d20				   .pbn
