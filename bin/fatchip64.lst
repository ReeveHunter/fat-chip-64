    459  cf91							; the envelope's Game Boy and NES parts from the SID's nibbles (EnvDerive)
------- FILE main.asm
    545  cf91				   hiEnd
    546  cf91					      rend
    547  cf91				  -	      if	hiEnd > $FFFA
    548  cf91				  -	      echo	"the $E000 tables run into the CPU's vectors"
    549  cf91				  -	      err
    550  cf91					      endif
    551  cf91				  -	      if	hiPhys + hiEnd - hiStart > $D000
    552  cf91				  -			; (v0.40: an unresolved name, not err: the first pass guesses the code
    553  cf91				  -			;  long and err would stop it there; this fails only if still true)
    554  cf91				  -	      .byte	PROGRAM_FILE_RUNS_INTO_THE_IO_AT_D000
    555  cf91					      endif
