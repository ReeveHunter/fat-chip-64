------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  3b9d					      include	"sounds.asm"
      1  3b9d							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  3b9d							;
      3  3b9d							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  3b9d							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  3b9d							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  3b9d							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  3b9d							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  3b9d							;
      9  3b9d							; Each sound has a mono default and a Fat Bass default:
     10  3b9d							;   MONO      one note (the last key pressed and still held) on every voice;
     11  3b9d							;	       a new key while another is held changes the pitch without a
     12  3b9d							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  3b9d							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  3b9d							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  3b9d							;	       the other voices
     16  3b9d							;
     17  3b9d							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  3b9d							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  3b9d							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  3b9d
     21  3b9d							; ------------------------------------------------------------ choosing
     22  3b9d							; V: next sound (SHIFT+V: previous)
     23  3b9d				   SoundKey
     24  3b9d					      subroutine
     25  3b9d		       20 2d 3c 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3ba0		       ae 95 c3 	      ldx	soundMode
     27  3ba3		       ad 2a c3 	      lda	shiftDown
     28  3ba6		       d0 09		      bne	.prev
     29  3ba8		       e8		      inx
     30  3ba9		       e0 13		      cpx	#NUM_SOUNDS
     31  3bab		       90 09		      bcc	.s
     32  3bad		       a2 00		      ldx	#0
     33  3baf		       f0 05		      beq	.s
     34  3bb1				   .prev
     35  3bb1		       ca		      dex
     36  3bb2		       10 02		      bpl	.s
     37  3bb4		       a2 12		      ldx	#NUM_SOUNDS-1
     38  3bb6				   .s
