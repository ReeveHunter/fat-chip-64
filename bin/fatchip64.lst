     29  5231		       fd 71 8e 	      sbc	pgFirst,x
     30  5234		       dd 88 8e 	      cmp	pgCount,x
     31  5237		       90 06		      bcc	.in
     32  5239		       bd 71 8e 	      lda	pgFirst,x
     33  523c		       8d 8a c4 	      sta	menuRow
