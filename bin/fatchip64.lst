------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  273b					      include	"midiin.asm"
      1  273b							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  273b							;
      3  273b							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  273b							; The main loop parses them (running status; realtime and system bytes are
      5  273b							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  273b							; notes mode, latch, arp and K + note.
      7  273b							;
      8  273b							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  273b							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  273b							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  273b							;
     12  273b							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  273b							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  273b							;
     15  273b							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  273b							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  273b							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  273b							; MIDI in is passed on to the Game Boy or NES.
     19  273b
     20  273b							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  273b							; Uses A, X.
     22  273b							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  273b							; with the time; a Start ($FA) makes the next clock a beat.
     24  273b				   RxByte
     25  273b					      subroutine
     26  273b		       ad 06 de 	      lda	ACIA_STAT
     27  273e		       4a		      lsr		; RDRF -> carry
     28  273f		       90 2b		      bcc	.x
     29  2741				   RxGot
     30  2741		       ad 07 de 	      lda	ACIA_RX
     31  2744		       c9 f8		      cmp	#$F8
     32  2746		       f0 25		      beq	.clk
     33  2748		       c9 fa		      cmp	#$FA
     34  274a		       d0 0e		      bne	.buf
     35  274c		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  274e		       8e 60 c5 	      stx	clkPhase
     37  2751		       8e 68 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  2754							;  the main loop could measure it)
