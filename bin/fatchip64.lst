      0  74ef					      include	"attack.asm"
      1  74ef							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  74ef							; how each note starts and ends in pitch
      3  74ef							;
      4  74ef							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  74ef							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  74ef							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  74ef							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  74ef							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  74ef							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  74ef							;   (v0.42) as long as TIME.
     11  74ef							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  74ef							;   release rings.
     13  74ef
     14  74ef							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  74ef							; jumps to the note
     16  74ef				   AtkStep
     17  74ef					      subroutine
     18  74ef		       ac cb c3 	      ldy	envY
     19  74f2		       b9 75 c9 	      lda	atkT,y
     20  74f5		       18		      clc
     21  74f6		       6d 5e c4 	      adc	fxN
     22  74f9		       90 02		      bcc	.t
     23  74fb		       a9 ff		      lda	#255
     24  74fd				   .t
     25  74fd		       99 75 c9 	      sta	atkT,y
     26  7500		       b9 78 c9 	      lda	clickOn,y
     27  7503		       f0 21		      beq	.s
     28  7505		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  7507		       ae a1 c6 	      ldx	sndClick
     30  750a		       e0 02		      cpx	#2
     31  750c		       90 03		      bcc	.cl
     32  750e		       ad a0 c6 	      lda	sndStepT
     33  7511				   .cl
     34  7511		       d9 75 c9 	      cmp	atkT,y
     35  7514		       f0 02		      beq	.ce
     36  7516		       b0 0e		      bcs	.s
     37  7518				   .ce
     38  7518		       a9 00		      lda	#0
     39  751a		       99 78 c9 	      sta	clickOn,y
     40  751d		       be 44 84 	      ldx	sidOfs,y
     41  7520		       b9 36 c3 	      lda	sidGate,y
     42  7523		       9d 04 d4 	      sta	SID+4,x
     43  7526				   .s
     44  7526		       b9 6e c9 	      lda	sK,y
     45  7529		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  752b		       d0 19		      bne	.x
     47  752d		       b9 75 c9 	      lda	atkT,y
     48  7530		       cd a0 c6 	      cmp	sndStepT
     49  7533		       90 11		      bcc	.x
     50  7535		       b9 68 c4 	      lda	sidTgtLo,y	; TIME's up: the note
     51  7538		       99 ea c3 	      sta	sidBaseLo,y
     52  753b		       b9 6b c4 	      lda	sidTgtHi,y
     53  753e		       99 ed c3 	      sta	sidBaseHi,y
     54  7541		       a9 00		      lda	#0
     55  7543		       99 6e c9 	      sta	sK,y
     56  7546				   .x
     57  7546		       60		      rts
