------- FILE arp.asm LEVEL 2 PASS 3
      0  2421					      include	"arp.asm"
      1  2421							; Fat Chip 64 - tempo and arpeggiator
      2  2421							;
      3  2421							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  2421							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  2421							;
      6  2421							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  2421							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  2421							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  2421							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  2421							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  2421							;	     until its voice's next turn.
     12  2421							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  2421							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  2421							;   J faster; either one also picks FREE).
     15  2421							;
     16  2421							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  2421							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  2421
     19  2421							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  2421							; between the two bytes: $22FF read as $23FF)
     21  2421				   GetTicks
     22  2421					      subroutine
     23  2421		       08		      php
     24  2422		       78		      sei
     25  2423		       a5 10		      lda	ticks
     26  2425		       8d 43 c3 	      sta	nowL
     27  2428		       a5 11		      lda	ticks+1
     28  242a		       8d 44 c3 	      sta	nowH
     29  242d		       28		      plp
     30  242e		       60		      rts
     31  242f
