------- FILE nesenv.asm LEVEL 2 PASS 3
      0  233f					      include	"nesenv.asm"
      1  233f							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  233f							;
      3  233f							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  233f							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  233f							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  233f							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  233f							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  233f							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  233f							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  233f							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  233f							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  233f							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  233f							; would wrap to a high pitch).
     14  233f							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  233f
     16  233f							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  233f							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  233f							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  233f							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  233f							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  233f		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  233f		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  233f							; NES channels too, and can't take a bend every 4 ms
     24  233f		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  233f		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  233f
     27  233f							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  233f		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  2348		       02 05	   slotVoice  .byte.b	2,5
     30  234a
     31  234a							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  234a							; note keeps sounding for now). X = voice (= t0).
     33  234a				   NesSoftRelease
     34  234a					      subroutine
     35  234a		       4c 4f 23 	      jmp	.go
     36  234d				   .nope
     37  234d		       18		      clc
     38  234e		       60		      rts
