    190  0fdd
    191  0fdd							; A = key code (v0.22 layout)
    192  0fdd							;   overlay	    notes
    193  0fdd							;   A S D F G	    bank (FAT PADS LEADS BASS FX): switches at once, same slot
    194  0fdd							;   Z X C V B	    patch 1-5 in the bank
    195  0fdd							;   L		    latch on / off	      K, then a note or a shape: key + scale
    196  0fdd							;   =		    tap tempo		      , / .  tempo -1 / +1 (SHIFT: 10)
    197  0fdd							;   /		    mute		      SHIFT+/  the dice
    198  0fdd							;   ; / :	    free arp speed	      SPACE  its action
    199  0fdd							;   F1 / F3	    octave up / down	      F5  arp on / off	  F7  visualizer
    200  0fdd							;   RETURN	    the menu		      CTRL+F3/F5  GB / NES channel block
    201  0fdd							;   C= +  A S D F  arp type / pattern / speed / SPARKLE octave
    202  0fdd							;	   Z X C    notes mode / extensions / POLY-MONO     L  latch style
    203  0fdd							;	   , .	    SPACE's action	      ; :  MIDI in octave down / up
    204  0fdd							;	   /	    undo the dice	      F1 F3 F5	SID / GB / NES on-off
    205  0fdd							;	   F7	    panic		      (SHIFT + F keys too, as before)
    206  0fdd							;   RUN/STOP	    tapped: beat start / stop; held + A S D F G H: pick a beat
    207  0fdd				   KeyDown
    208  0fdd					      subroutine
    209  0fdd		       c9 18		      cmp	#24
    210  0fdf		       90 03		      bcc	NoteDown
    211  0fe1		       4c 8e 10 	      jmp	.cmd
    212  0fe4				   NoteDown		; A = note index (overlay key 0-23, MIDI slot 24-31)
    213  0fe4		       aa		      tax
    214  0fe5		       ad bd c8 	      lda	spArm
    215  0fe8		       f0 03		      beq	.nsp
    216  0fea		       4c e7 6b 	      jmp	SplitSet	; (C= + V held: this note sets the split, it doesn't play)
    217  0fed				   .nsp
    218  0fed		       ad 71 c7 	      lda	kArm
    219  0ff0		       f0 03		      beq	.note
    220  0ff2		       4c ca 16 	      jmp	KeyShapeNote	; (K tapped: this note picks the key, it doesn't play)
    221  0ff5				   .note
    222  0ff5		       a9 01		      lda	#1
    223  0ff7		       9d b8 c2 	      sta	physKey,x
    224  0ffa		       ee d8 c2 	      inc	physCount
    225  0ffd		       20 65 47 	      jsr	RepeatPress	; REPEAT: its echoes (keeps X)
    226  1000		       20 86 22 	      jsr	GetTicks
    227  1003		       20 8b 17 	      jsr	ApplySettings	; (changes waiting for this note)
    228  1006		       ad ae c8 	      lda	clMode	; CHORD + LEAD: the chord's key, or the lead
    229  1009		       f0 08		      beq	.ncl
    230  100b		       20 49 6a 	      jsr	ClPress
    231  100e		       90 03		      bcc	.ncl
