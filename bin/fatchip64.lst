    143  0905							;------------------------------------------------------------- interrupts
    144  0905							; Every 1/3 ms: feed the ACIA one byte (fast path). Every third time (1 ms):
    145  0905							; count a tick and move paced messages onto the wire.
    146  0905				   Irq
    147  0905					      subroutine
    148  0905		       48		      pha
    149  0906		       8a		      txa
    150  0907		       48		      pha
    151  0908		       ad 0d dc 	      lda	CIA1_ICR	; acknowledge
    152  090b		       a6 15		      ldx	wireTail
    153  090d		       e4 14		      cpx	wireHead
    154  090f		       f0 0f		      beq	.noByte
    155  0911		       ad 06 de 	      lda	ACIA_STAT
    156  0914		       29 02		      and	#ACIA_TDRE
    157  0916		       f0 08		      beq	.noByte
    158  0918		       bd 00 c0 	      lda	wireBuf,x
    159  091b		       8d 05 de 	      sta	ACIA_TX
    160  091e		       e6 15		      inc	wireTail
    161  0920				   .noByte
    162  0920		       c6 2c		      dec	subTick
    163  0922		       10 14		      bpl	.out
    164  0924		       a9 02		      lda	#2
    165  0926		       85 2c		      sta	subTick
    166  0928		       98		      tya
    167  0929		       48		      pha
    168  092a		       e6 10		      inc	ticks
    169  092c		       d0 02		      bne	.t
    170  092e		       e6 11		      inc	ticks+1
    171  0930				   .t
    172  0930		       20 71 09 	      jsr	Schedule
    173  0933		       20 54 09 	      jsr	TxByte	; start a just-scheduled message now if the ACIA is free
    174  0936		       68		      pla
    175  0937		       a8		      tay
    176  0938				   .out
    177  0938		       68		      pla
    178  0939		       aa		      tax
    179  093a		       68		      pla
    180  093b		       40		      rti
