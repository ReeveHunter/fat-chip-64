------- FILE main.asm
------- FILE wander.asm LEVEL 2 PASS 3
      0  69e0					      include	"wander.asm"
      1  69e0							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  69e0							;
      3  69e0							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  69e0							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  69e0							;   ATTACK   as always: the new notes start
      6  69e0							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  69e0							;	      has none)
      8  69e0							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  69e0							;	      start again
     10  69e0							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  69e0							;	      late; some glide, some start again (fade out, come back in)
     12  69e0							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  69e0							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  69e0							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  69e0							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  69e0
     17  69e0		       00 01	   CHG_ATTACK equ	1
     18  69e0		       00 02	   CHG_GLIDE  equ	2
     19  69e0		       00 03	   CHG_STAGGER equ	3
     20  69e0		       00 04	   CHG_WANDER equ	4
     21  69e0		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  69e0		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  69e0
     24  69e0							; A = the chord change style now (keeps X, Y)
     25  69e0				   ChgEff
     26  69e0					      subroutine
     27  69e0		       ad 65 c8 	      lda	chgMode
     28  69e3		       d0 0c		      bne	.x
     29  69e5		       ad b3 c3 	      lda	effMode
     30  69e8		       c9 02		      cmp	#MODE_DRONE
     31  69ea		       d0 03		      bne	.a
     32  69ec		       a9 04		      lda	#CHG_WANDER
     33  69ee		       60		      rts
     34  69ef				   .a
     35  69ef		       a9 01		      lda	#CHG_ATTACK
     36  69f1				   .x
     37  69f1		       60		      rts
     38  69f2
     39  69f2							; ApplyVoices, voice X changes note: how. A = 0 (Z): change it now (t3,
     40  69f2							; legatoNow, vsGlide set); A = 1: not yet (WANDER). Keeps X.
