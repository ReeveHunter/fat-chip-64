     18  7965		       ad 8a c4 	      lda	menuOn
     19  7968		       d0 2f		      bne	VizX
     20  796a		       20 09 7a 	      jsr	GlitchCalm
     21  796d		       a9 02		      lda	#2
     22  796f		       8d 24 c6 	      sta	vizOn
     23  7972		       4c bc 79 	      jmp	VizDraw
