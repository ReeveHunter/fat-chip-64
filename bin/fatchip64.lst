------- FILE main.asm
------- FILE pads.asm LEVEL 2 PASS 2
      0  1b03					      include	"pads.asm"
      1  1b03							; Fat Chip 64 - sound: FAT (default) or PADS (V)
      2  1b03							;
      3  1b03							; PADS, per the brief's ambient pads: some voices swell and glide into each
      4  1b03							; chord, others keep sharp defined attacks.
      5  1b03							;   SID       slow attack (500 ms), long release (2.4 s), pulse wave with its
      6  1b03							;	       width wobbling (each voice its own phase), through a low-pass
      7  1b03							;	       filter that sweeps slowly (about 8 s up and down)
      8  1b03							;   Game Boy  slow attack and release on pulses + wave, pulse 2 glides
      9  1b03							;	       into each new note, deeper warble
     10  1b03							;   MidiNES   pulses swell and fade (CC7 envelope, see nesenv.asm); the
     11  1b03							;	       triangle (bass) just stops on release
     12  1b03							;
     13  1b03							; RAW, the classic raw chip sound: FAT's stacking, everything square and
     14  1b03							; instant: SID pulse (50 / 25 / 12.5% per voice), attack 0, sustain full,
     15  1b03							; release 0, no filter; Game Boy instant attack and release, no warble,
     16  1b03							; pulses 50% / 25%, wave channel as a third pulse; MidiNES full volume,
     17  1b03							; pulse 2 at 25%. The small detunes between doubled voices stay.
     18  1b03
     19  1b03				   SoundApply
     20  1b03					      subroutine
     21  1b03		       20 fa 1f 	      jsr	NesSoundApply	; leaving PADS: NES envelopes end, full volume
     22  1b06		       20 13 1c 	      jsr	NesDuty
     23  1b09		       a2 02		      ldx	#2
     24  1b0b				   .v
     25  1b0b		       bc c2 2a 	      ldy	sidOfs,x
     26  1b0e		       86 25		      stx	t1
     27  1b10		       ae 96 c3 	      ldx	soundMode
     28  1b13		       bd 42 1c 	      lda	sndAD,x
     29  1b16		       99 05 d4 	      sta	SID+5,y
     30  1b19		       bd 45 1c 	      lda	sndSR,x
     31  1b1c		       99 06 d4 	      sta	SID+6,y
     32  1b1f		       bd 48 1c 	      lda	sndWave,x
