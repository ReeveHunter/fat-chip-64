------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  55a0					      include	"sync.asm"
      1  55a0							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  55a0							;
      3  55a0							; Menu, DEVICE SYNC (defaults first):
      4  55a0							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  55a0							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  55a0							;		     sets the tempo, averaged over beats (the clock jitters about
      7  55a0							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  55a0							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  55a0							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  55a0							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  55a0							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  55a0							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  55a0							;		     picks a beat demo (styleBeat)
     14  55a0							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  55a0							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  55a0							;		     key channel) picks a sound (voiceSound)
     17  55a0							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  55a0							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  55a0							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  55a0							;
     21  55a0							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  55a0							; 1/4 ms); a Start makes the next clock a beat.
     23  55a0
     24  55a0		       00 00	   TEMPO_KEYTAR equ	0
     25  55a0		       00 01	   TEMPO_OWN  equ	1
     26  55a0		       00 02	   TEMPO_SC   equ	2
     27  55a0		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  55a0
     29  55a0
     30  55a0
     31  55a0							; ------------------------------------------------------------ clock
     32  55a0							; Main loop, every pass
     33  55a0				   ClockTick
     34  55a0					      subroutine
     35  55a0		       ad f1 c5 	      lda	clkCount	; any clock lately?
     36  55a3		       cd f2 c5 	      cmp	clkCountSeen
     37  55a6		       f0 15		      beq	.alive
     38  55a8		       8d f2 c5 	      sta	clkCountSeen
     39  55ab		       20 1e 24 	      jsr	GetTicks
     40  55ae		       ad 43 c3 	      lda	nowL
     41  55b1		       8d f3 c5 	      sta	clkSeenL
     42  55b4		       ad 44 c3 	      lda	nowH
     43  55b7		       8d f4 c5 	      sta	clkSeenH
     44  55ba		       4c de 55 	      jmp	.beatq
     45  55bd				   .alive
     46  55bd		       ad fe c5 	      lda	clkHave	; none for a while: start measuring afresh
     47  55c0		       f0 1c		      beq	.beatq
     48  55c2		       20 1e 24 	      jsr	GetTicks
     49  55c5		       ad 43 c3 	      lda	nowL
     50  55c8		       38		      sec
     51  55c9		       ed f3 c5 	      sbc	clkSeenL
     52  55cc		       aa		      tax
     53  55cd		       ad 44 c3 	      lda	nowH
     54  55d0		       ed f4 c5 	      sbc	clkSeenH
