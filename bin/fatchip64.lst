     93  38f7		       c9 f0		      cmp	#$F0
     94  38f9		       b0 07		      bcs	.sys
     95  38fb		       a2 00		      ldx	#0	; a channel message ends any SysEx
     96  38fd		       8e 51 c7 	      stx	sxOn
     97  3900		       f0 05		      beq	.status
     98  3902				   .sys
     99  3902		       20 ba 3a 	      jsr	SysexStatus	; F0 starts a SysEx, F7 ends it (v0.20)
    100  3905		       a9 00		      lda	#0	; system: no running status until the next one
    101  3907				   .status
    102  3907		       8d 2b c4 	      sta	rxStatus
    103  390a		       a9 00		      lda	#0
    104  390c		       8d 2c c4 	      sta	rxCnt
