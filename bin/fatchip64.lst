    128  0ce9							; A = key code at ksCol / ksRow
    129  0ce9				   KeyCode
    130  0ce9					      subroutine
    131  0ce9		       ad 1f c3 	      lda	ksCol
    132  0cec		       0a		      asl
    133  0ced		       0a		      asl
    134  0cee		       0a		      asl
    135  0cef		       0d 20 c3 	      ora	ksRow
    136  0cf2		       a8		      tay
    137  0cf3		       b9 99 24 	      lda	keymap,y
