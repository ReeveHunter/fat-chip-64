------- FILE main.asm LEVEL 1 PASS 2
      1  3184 ????						; Fat Chip 64 - main program
      2  3184 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  3184 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  3184 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  3184 ????
      6  3184 ????				      processor	6502
