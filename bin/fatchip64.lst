     81  0f43		       8d 37 c3 	      sta	ksBits
     82  0f46		       a9 00		      lda	#0
     83  0f48		       8d 39 c3 	      sta	ksRow
     84  0f4b				   .pb
     85  0f4b		       ad 37 c3 	      lda	ksBits
     86  0f4e		       f0 3d		      beq	.pcn
     87  0f50		       4e 37 c3 	      lsr	ksBits
     88  0f53		       90 33		      bcc	.pbn
     89  0f55		       ad 3c c3 	      lda	ghostFilter
     90  0f58		       f0 05		      beq	.accept	; filter off (default): phantoms play
     91  0f5a		       20 c6 0f 	      jsr	Suspect
