    108  2f6e		       f0 06		      beq	.nosx
    109  2f70		       20 48 31 	      jsr	SysexByte
    110  2f73		       4c 36 2f 	      jmp	.next
    111  2f76				   .nosx
    112  2f76		       ae 26 c4 	      ldx	rxStatus
    113  2f79		       f0 bb		      beq	.next	; no status yet
    114  2f7b		       ae 27 c4 	      ldx	rxCnt
    115  2f7e		       d0 2e		      bne	.second
    116  2f80		       8d 28 c4 	      sta	rxD1
