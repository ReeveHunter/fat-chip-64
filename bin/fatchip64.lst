    429  0b51							; With the MIDI chip's interrupts (midiIrq, v0.16): the chip interrupts when
    430  0b51							; a byte has come in or the next can go out; the CIA timer ticks each ms.
    431  0b51				   IrqMidi
    432  0b51					      subroutine
    433  0b51		       48		      pha
    434  0b52		       8a		      txa
    435  0b53		       48		      pha
    436  0b54		       ad 06 de 	      lda	ACIA_STAT
    437  0b57		       10 23		      bpl	.tim	; (not the MIDI chip)
    438  0b59		       4a		      lsr		; a byte in?
    439  0b5a		       90 03		      bcc	.tx
    440  0b5c		       20 1c 34 	      jsr	RxGot
    441  0b5f				   .tx
    442  0b5f		       ad 06 de 	      lda	ACIA_STAT
    443  0b62		       29 02		      and	#ACIA_TDRE
    444  0b64		       f0 16		      beq	.tim
    445  0b66		       a6 16		      ldx	wireTail
    446  0b68		       e4 15		      cpx	wireHead
    447  0b6a		       f0 0b		      beq	.quiet
    448  0b6c		       bd 00 c0 	      lda	wireBuf,x
    449  0b6f		       8d 05 de 	      sta	ACIA_TX
    450  0b72		       e6 16		      inc	wireTail
    451  0b74		       4c 7c 0b 	      jmp	.tim
    452  0b77				   .quiet
    453  0b77		       a9 96		      lda	#ACIA_MODE_RX	; nothing to send: no more "ready" interrupts
    454  0b79		       8d 04 de 	      sta	ACIA_CTRL
    455  0b7c				   .tim
    456  0b7c		       ad 0d dc 	      lda	CIA1_ICR	; the 1 ms tick?
    457  0b7f		       4a		      lsr
    458  0b80		       90 21		      bcc	.out
    459  0b82		       98		      tya
    460  0b83		       48		      pha
    461  0b84		       e6 10		      inc	ticks
    462  0b86		       d0 02		      bne	.t
    463  0b88		       e6 11		      inc	ticks+1
    464  0b8a				   .t
    465  0b8a		       ad 8e c9 	      lda	sidVolNow	; (the SID's volume: a step towards its target)
    466  0b8d		       cd 8f c9 	      cmp	sidVolTgt
    467  0b90		       f0 03		      beq	.vs
    468  0b92		       20 8b 16 	      jsr	VolSlew
    469  0b95				   .vs
    470  0b95		       20 58 0c 	      jsr	Schedule
    471  0b98		       20 16 34 	      jsr	RxByte	; (a long tick: a byte may be waiting, and
    472  0b9b		       20 33 0c 	      jsr	TxByte	;  the MIDI chip holds only one)
    473  0b9e		       20 16 34 	      jsr	RxByte
