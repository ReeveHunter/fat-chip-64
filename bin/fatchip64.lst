------- FILE drums.asm LEVEL 2 PASS 3
      0  45a5					      include	"drums.asm"
      1  45a5							; Fat Chip 64 - drums on the MidiNES
      2  45a5							;
      3  45a5							; Two sources, one kit:
      4  45a5							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  45a5							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  45a5							;			   64 = hit, 56 = ghost)
      7  45a5							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  45a5							;			   RETURN starts / stops it, at its own tempo (B taps
      9  45a5							;			   a new one)
     10  45a5							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  45a5							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  45a5							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  45a5							; a note-on, then a note-off after the sound's length, the level set with
     14  45a5							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  45a5							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  45a5
     17  45a5		       00 0c	   KIT_SIZE   equ	12
     18  45a5		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  45a5		       00 00	   DK_KICK    equ	0
     20  45a5		       00 01	   DK_SNARE   equ	1
     21  45a5		       00 02	   DK_CH      equ	2
     22  45a5		       00 03	   DK_OH      equ	3
     23  45a5		       00 04	   DK_CY      equ	4
     24  45a5		       00 05	   DK_TOM     equ	5
     25  45a5		       00 06	   DK_PERC    equ	6
     26  45a5
     27  45a5							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  45a5				   DrumHit
     29  45a5					      subroutine
     30  45a5		       8d 82 c4 	      sta	drumKind
     31  45a8		       8e 81 c4 	      stx	drumLvl
     32  45ab		       8c 83 c4 	      sty	drumTom
     33  45ae		       c9 00		      cmp	#DK_KICK
     34  45b0		       d0 05		      bne	.nk
     35  45b2		       a9 01		      lda	#1
     36  45b4		       8d 3f c6 	      sta	vizKick	; (the visualizer's border flash)
     37  45b7				   .nk
     38  45b7		       ad 27 c3 	      lda	devOn+DEV_NES
     39  45ba		       d0 01		      bne	.on
     40  45bc		       60		      rts
     41  45bd				   .on
     42  45bd		       20 96 1e 	      jsr	GetTicks
     43  45c0		       ad 82 c4 	      lda	drumKind
     44  45c3		       c9 02		      cmp	#DK_CH
     45  45c5		       90 07		      bcc	.dmc
     46  45c7		       c9 05		      cmp	#DK_TOM
     47  45c9		       b0 03		      bcs	.dmc
     48  45cb		       4c 80 46 	      jmp	NoiseHit
     49  45ce				   .dmc
     50  45ce		       ae 82 c4 	      ldx	drumKind
     51  45d1		       bd 67 46 	      lda	dmcPrioT,x
     52  45d4		       85 24		      sta	t0
