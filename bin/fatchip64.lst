------- FILE lead.asm LEVEL 2 PASS 3
      0  65df					      include	"lead.asm"
      1  65df							; Fat Chip 64 - CHORD + LEAD (v0.28): a chord and a lead at once, each its
      2  65df							; own patch.
      3  65df							;   BASS      (was LOW NOTE) the first key pressed is the chord's root
      4  65df							;	       (POLY: just it; SMART CHORD: its 5TH, TRIAD...; DRONE: the
      5  65df							;	       drone); every other key is the lead, while the chord key is held
      6  65df							;   TRIAD     (was LATCH 3) three keys pressed together are the chord while
      7  65df							;	       they're held (v0.36: with LATCH on, it keeps sounding after you
      8  65df							;	       let go); every other key is the lead.
      9  65df							; v0.36: the lead is LEAD OCTAVE up in every mode (+1 at first; SHIFT + F1 /
     10  65df							; F3). SHIFT + F5 SPLIT on / off (held + a note: the split point), SHIFT + F7
     11  65df							; its mode. LATCH holds KEY's chord side and TRIAD's chord.
     12  65df							; The lead is one note (the last key pressed) on one voice per chip (SID 3,
     13  65df							; Game Boy pulse 1, NES pulse 1), only while it plays: the rest of the time
     14  65df							; those voices are the chord's. Its patch: SHIFT + A S D F G / Z X C V B.
     15  65df							; The lead's own: the SID's waveform, width, envelope and octave, the Game
     16  65df							; Boy pulse's CCs, the NES pulse's duty. Shared with the chord: the effects
     17  65df							; (vibrato, filter, tremolo...), the NES envelope.
     18  65df
     19  65df							;   KEY       (v0.32) a keyboard split: keys below the split point are the
     20  65df							;	       chord (as the mode plays them), keys from it up the lead (LEAD
     21  65df							;	       OCTAVE, +1 at first). On the C64's keys the split is a key (it
     22  65df							;	       stays put when the octave changes); over MIDI, a note as sent
     23  65df							;	       (before MIDI IN OCTAVE). SHIFT + F5 held + a note sets either.
     24  65df		       00 01	   CL_KEY     equ	1	; SPLIT (clMode)
     25  65df		       00 02	   CL_BASS    equ	2
     26  65df		       00 03	   CL_L3      equ	3	; (TRIAD)
     27  65df		       00 06	   LEAD_SID   equ	6	; the lead's voices: SID 3, GB pulse 1, NES pulse 1
     28  65df		       00 01	   LEAD_GB    equ	1
     29  65df		       00 02	   LEAD_NES   equ	2
     30  65df
     31  65df							; NoteDown, CHORD + LEAD on: key X pressed. Carry set: it's the lead (the
     32  65df							; latch styles leave it alone).
     33  65df				   ClPress
     34  65df					      subroutine
     35  65df		       8e b0 c3 	      stx	exI
     36  65e2		       ad ad c8 	      lda	clMode
     37  65e5		       c9 03		      cmp	#CL_L3
