    185  0ff7							; A = key code (v0.22 layout)
    186  0ff7							;   overlay	    notes
    187  0ff7							;   A S D F G	    bank (FAT PADS LEADS BASS FX): switches at once, same slot
    188  0ff7							;   Z X C V B	    patch 1-5 in the bank
    189  0ff7							;   L		    latch on / off	      K, then a note or a shape: key + scale
    190  0ff7							;   =		    tap tempo		      , / .  tempo -1 / +1 (SHIFT: 10)
    191  0ff7							;   /		    mute		      SHIFT+/  the dice
    192  0ff7							;   ; / :	    free arp speed	      SPACE  its action
    193  0ff7							;   F1 / F3	    octave up / down	      F5  arp on / off	  F7  visualizer
    194  0ff7							;   RETURN	    the menu		      CTRL+F3/F5  GB / NES channel block
    195  0ff7							;   C= +  A S D F  arp type / pattern / speed / SPARKLE octave
    196  0ff7							;	   Z X C    notes mode / extensions / POLY-MONO     L  latch style
    197  0ff7							;	   , .	    SPACE's action	      ; :  MIDI in octave down / up
    198  0ff7							;	   /	    undo the dice	      F1 F3 F5	SID / GB / NES on-off
    199  0ff7							;	   F7	    panic		      (SHIFT + F keys too, as before)
    200  0ff7							;   RUN/STOP	    tapped: beat start / stop; held + A S D F G H: pick a beat
    201  0ff7				   KeyDown
    202  0ff7					      subroutine
    203  0ff7		       c9 18		      cmp	#24
    204  0ff9		       90 03		      bcc	NoteDown
    205  0ffb		       4c a8 10 	      jmp	.cmd
