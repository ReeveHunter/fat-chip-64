------- FILE main.asm LEVEL 1 PASS 2
      1  1972 ????						; Fat Chip 64 - main program
      2  1972 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  1972 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  1972 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  1972 ????
      6  1972 ????				      processor	6502
