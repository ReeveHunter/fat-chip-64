    151  864b							; voice X's glide offset closer to 0: by off / 2^glideK for each 4 ms step
    152  864b							; (worked out once: d = off >> k, off -= d x n; past 0 or nothing left to
    153  864b							; move by: there). Keeps X.
    154  864b				   NesGlideStep
    155  864b					      subroutine
    156  864b		       bd 90 c9 	      lda	nesGlL,x
    157  864e		       1d 99 c9 	      ora	nesGlH,x
    158  8651		       d0 01		      bne	.go
    159  8653		       60		      rts
    160  8654				   .go
    161  8654		       bd 3c ce 	      lda	nesK,x
    162  8657		       c9 ff		      cmp	#$FF	; (v0.41: BEND IN STEP: held for TIME, then the note)
    163  8659		       d0 0c		      bne	.slide
    164  865b		       bd a2 c9 	      lda	nesVT,x
    165  865e		       cd 60 cb 	      cmp	sndStepT
    166  8661		       b0 01		      bcs	.jump
    167  8663		       60		      rts
    168  8664				   .jump
