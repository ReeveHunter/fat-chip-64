------- FILE main.asm LEVEL 1 PASS 3
      1  84c6 ????						; Fat Chip 64 - main program
      2  84c6 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  84c6 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  84c6 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  84c6 ????
      6  84c6 ????				      processor	6502
