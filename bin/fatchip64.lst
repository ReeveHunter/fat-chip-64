    258  5e40				   .c
    259  5e40		       8d 7a c8 	      sta	okpCount
    260  5e43		       20 8b 5e 	      jsr	OkpBuild
    261  5e46		       ad 80 c8 	      lda	okpLen
    262  5e49		       d0 06		      bne	.go
    263  5e4b		       a9 00		      lda	#0	; (nothing to play)
    264  5e4d		       8d 7a c8 	      sta	okpCount
    265  5e50		       60		      rts
    266  5e51				   .go
    267  5e51		       20 54 5f 	      jsr	OkpStep
