      0  2104					      include	"bend.asm"
      1  2104							; Fat Chip 64 - SPACE modes and the SPACE bend (v0.10)
      2  2104							;
      3  2104							; , and . (the < > keys) pick what SPACE does:
      4  2104							;   MUTES  (default) held = the mute flips (the momentary mute / play key)
      5  2104							;   BENDS  held = everything bends down 2 semitones over about 1 s;
      6  2104							;	    let go and it comes back up over about 0.5 s
      7  2104							;
      8  2104							; bendLvl 0-255 is the depth (255 = 2 semitones down).
      9  2104							;   SID       frequency x (1 - k / 256), k = lvl / 8 - lvl / 64 (max 28: 0.891,
     10  2104							;	       2 semitones), every change (4 ms steps)
     11  2104							;   Game Boy  pitch bend on its three channels (Fat Chip GB bend range is
     12  2104							;	       2 semitones): 8192 - lvl x 32, every BEND_TICK ms
     13  2104							;   MidiNES   its bend moves the timer, so the amount depends on the note:
     14  2104							;	       p(n) x lvl / 1024 for the triangle, twice that for the pulses
     15  2104							;	       (p = the MidiNES triangle bend scale, 1710 at MIDI 36; 2 semitones
     16  2104							;	       is p x 0.245, this is p x 0.249). Sent every BEND_TICK ms, and
     17  2104							;	       before each new NES note while bent. Notes too near the bottom
     18  2104							;	       of the NES range (the timer would wrap) don't bend.
     19  2104
     20  2104							; , : SPACE mode back
     21  2104				   SpaceBack
     22  2104					      subroutine
     23  2104		       ae d4 c3 	      ldx	spaceMode
