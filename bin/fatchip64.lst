------- FILE attack.asm LEVEL 2 PASS 3
      0  74d5					      include	"attack.asm"
      1  74d5							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  74d5							; how each note starts and ends in pitch
      3  74d5							;
      4  74d5							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  74d5							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  74d5							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  74d5							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  74d5							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  74d5							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  74d5							;   (v0.42) as long as TIME.
     11  74d5							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  74d5							;   release rings.
     13  74d5
     14  74d5							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  74d5							; jumps to the note
     16  74d5				   AtkStep
     17  74d5					      subroutine
     18  74d5		       ac cb c3 	      ldy	envY
     19  74d8		       b9 75 c9 	      lda	atkT,y
     20  74db		       18		      clc
     21  74dc		       6d 5e c4 	      adc	fxN
     22  74df		       90 02		      bcc	.t
     23  74e1		       a9 ff		      lda	#255
     24  74e3				   .t
     25  74e3		       99 75 c9 	      sta	atkT,y
     26  74e6		       b9 78 c9 	      lda	clickOn,y
     27  74e9		       f0 21		      beq	.s
     28  74eb		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  74ed		       ae a1 c6 	      ldx	sndClick
     30  74f0		       e0 02		      cpx	#2
     31  74f2		       90 03		      bcc	.cl
     32  74f4		       ad a0 c6 	      lda	sndStepT
     33  74f7				   .cl
     34  74f7		       d9 75 c9 	      cmp	atkT,y
     35  74fa		       f0 02		      beq	.ce
     36  74fc		       b0 0e		      bcs	.s
     37  74fe				   .ce
     38  74fe		       a9 00		      lda	#0
     39  7500		       99 78 c9 	      sta	clickOn,y
     40  7503		       be 2f 84 	      ldx	sidOfs,y
     41  7506		       b9 36 c3 	      lda	sidGate,y
     42  7509		       9d 04 d4 	      sta	SID+4,x
     43  750c				   .s
     44  750c		       b9 6e c9 	      lda	sK,y
     45  750f		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  7511		       d0 19		      bne	.x
     47  7513		       b9 75 c9 	      lda	atkT,y
     48  7516		       cd a0 c6 	      cmp	sndStepT
     49  7519		       90 11		      bcc	.x
     50  751b		       b9 68 c4 	      lda	sidTgtLo,y	; TIME's up: the note
     51  751e		       99 ea c3 	      sta	sidBaseLo,y
     52  7521		       b9 6b c4 	      lda	sidTgtHi,y
     53  7524		       99 ed c3 	      sta	sidBaseHi,y
     54  7527		       a9 00		      lda	#0
     55  7529		       99 6e c9 	      sta	sK,y
     56  752c				   .x
     57  752c		       60		      rts
