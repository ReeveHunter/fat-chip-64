      0  6737					      include	"wander.asm"
      1  6737							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  6737							;
      3  6737							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  6737							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  6737							;   ATTACK   as always: the new notes start
      6  6737							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  6737							;	      has none)
      8  6737							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  6737							;	      start again
     10  6737							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  6737							;	      late; some glide, some start again (fade out, come back in)
     12  6737							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  6737							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  6737							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  6737							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  6737
     17  6737		       00 01	   CHG_ATTACK equ	1
     18  6737		       00 02	   CHG_GLIDE  equ	2
     19  6737		       00 03	   CHG_STAGGER equ	3
     20  6737		       00 04	   CHG_WANDER equ	4
     21  6737		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  6737		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  6737
     24  6737							; A = the chord change style now (keeps X, Y)
     25  6737				   ChgEff
     26  6737					      subroutine
     27  6737		       ad 59 c8 	      lda	chgMode
     28  673a		       d0 0c		      bne	.x
     29  673c		       ad ab c3 	      lda	effMode
     30  673f		       c9 02		      cmp	#MODE_DRONE
     31  6741		       d0 03		      bne	.a
     32  6743		       a9 04		      lda	#CHG_WANDER
     33  6745		       60		      rts
     34  6746				   .a
     35  6746		       a9 01		      lda	#CHG_ATTACK
     36  6748				   .x
     37  6748		       60		      rts
