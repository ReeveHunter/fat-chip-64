------- FILE midiin.asm LEVEL 2 PASS 3
      0  31b7					      include	"midiin.asm"
      1  31b7							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  31b7							;
      3  31b7							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  31b7							; The main loop parses them (running status; realtime and system bytes are
      5  31b7							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  31b7							; notes mode, latch, arp and K + note.
      7  31b7							;
      8  31b7							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  31b7							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  31b7							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  31b7							;
     12  31b7							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  31b7							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  31b7							;
     15  31b7							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  31b7							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  31b7							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  31b7							; MIDI in is passed on to the Game Boy or NES.
     19  31b7
     20  31b7							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  31b7							; Uses A, X.
     22  31b7							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  31b7							; with the time; a Start ($FA) makes the next clock a beat.
     24  31b7				   RxByte
     25  31b7					      subroutine
     26  31b7		       ad 06 de 	      lda	ACIA_STAT
     27  31ba		       4a		      lsr		; RDRF -> carry
     28  31bb		       90 2b		      bcc	.x
     29  31bd				   RxGot
     30  31bd		       ad 07 de 	      lda	ACIA_RX
     31  31c0		       c9 f8		      cmp	#$F8
     32  31c2		       f0 25		      beq	.clk
     33  31c4		       c9 fa		      cmp	#$FA
     34  31c6		       d0 0e		      bne	.buf
     35  31c8		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  31ca		       8e e8 c5 	      stx	clkPhase
     37  31cd		       8e f0 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  31d0							;  the main loop could measure it)
     39  31d0		       ae e9 c5 	      ldx	clkBeat
     40  31d3		       8e fb c5 	      stx	clkStartBeat
     41  31d6				   .buf
     42  31d6		       ae 24 c4 	      ldx	rxHead
     43  31d9		       9d e4 c3 	      sta	rxBuf,x
     44  31dc		       e8		      inx
     45  31dd		       8a		      txa
     46  31de		       29 3f		      and	#63
     47  31e0		       cd 25 c4 	      cmp	rxTail
     48  31e3		       f0 03		      beq	.x	; full: dropped
     49  31e5		       8d 24 c4 	      sta	rxHead
     50  31e8				   .x
     51  31e8		       60		      rts
     52  31e9				   .clk
     53  31e9		       ee e4 c5 	      inc	clkCount
     54  31ec		       ae e8 c5 	      ldx	clkPhase
     55  31ef		       e8		      inx
     56  31f0		       e0 18		      cpx	#24
     57  31f2		       90 1b		      bcc	.ph
     58  31f4		       a5 10		      lda	ticks
     59  31f6		       8d eb c5 	      sta	clkAtL
     60  31f9		       a5 11		      lda	ticks+1
