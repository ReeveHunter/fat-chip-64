------- FILE attack.asm LEVEL 2 PASS 3
      0  7120					      include	"attack.asm"
      1  7120							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  7120							; how each note starts and ends in pitch
      3  7120							;
      4  7120							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  7120							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  7120							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  7120							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  7120							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  7120							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  7120							;   (v0.42) as long as TIME.
     11  7120							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  7120							;   release rings.
     13  7120
     14  7120							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  7120							; jumps to the note
     16  7120				   AtkStep
     17  7120					      subroutine
     18  7120		       ac c3 c3 	      ldy	envY
     19  7123		       b9 69 c9 	      lda	atkT,y
     20  7126		       18		      clc
     21  7127		       6d 52 c4 	      adc	fxN
     22  712a		       90 02		      bcc	.t
     23  712c		       a9 ff		      lda	#255
     24  712e				   .t
     25  712e		       99 69 c9 	      sta	atkT,y
     26  7131		       b9 6c c9 	      lda	clickOn,y
     27  7134		       f0 21		      beq	.s
     28  7136		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  7138		       ae 95 c6 	      ldx	sndClick
     30  713b		       e0 02		      cpx	#2
     31  713d		       90 03		      bcc	.cl
     32  713f		       ad 94 c6 	      lda	sndStepT
     33  7142				   .cl
     34  7142		       d9 69 c9 	      cmp	atkT,y
     35  7145		       f0 02		      beq	.ce
     36  7147		       b0 0e		      bcs	.s
     37  7149				   .ce
     38  7149		       a9 00		      lda	#0
     39  714b		       99 6c c9 	      sta	clickOn,y
     40  714e		       be 97 80 	      ldx	sidOfs,y
     41  7151		       b9 32 c3 	      lda	sidGate,y
     42  7154		       9d 04 d4 	      sta	SID+4,x
     43  7157				   .s
     44  7157		       b9 62 c9 	      lda	sK,y
     45  715a		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  715c		       d0 19		      bne	.x
     47  715e		       b9 69 c9 	      lda	atkT,y
     48  7161		       cd 94 c6 	      cmp	sndStepT
     49  7164		       90 11		      bcc	.x
     50  7166		       b9 5c c4 	      lda	sidTgtLo,y	; TIME's up: the note
     51  7169		       99 de c3 	      sta	sidBaseLo,y
     52  716c		       b9 5f c4 	      lda	sidTgtHi,y
     53  716f		       99 e1 c3 	      sta	sidBaseHi,y
     54  7172		       a9 00		      lda	#0
     55  7174		       99 62 c9 	      sta	sK,y
     56  7177				   .x
     57  7177		       60		      rts
     58  7178
     59  7178							; a SID voice's gate went on (Y = SID voice, t2 = its registers): the CLICK
     60  7178							; starts. Keeps Y.
     61  7178				   ClickOn
     62  7178					      subroutine
     63  7178		       ad 95 c6 	      lda	sndClick
     64  717b		       f0 11		      beq	.x
     65  717d		       a9 01		      lda	#1
     66  717f		       99 6c c9 	      sta	clickOn,y
     67  7182		       b9 32 c3 	      lda	sidGate,y
     68  7185		       29 01		      and	#1
     69  7187		       09 80		      ora	#$80	; noise
     70  7189		       a6 26		      ldx	t2
     71  718b		       9d 04 d4 	      sta	SID+4,x
     72  718e				   .x
     73  718e		       60		      rts
     74  718f
     75  718f							; VoiceSet, a SID voice's new note (Y = SID voice, t0 = the voice, t3 = a new
     76  718f							; press): BEND IN starts it away from its pitch
     77  718f				   BendIn
     78  718f					      subroutine
     79  718f		       ad 96 c6 	      lda	sndPenv
     80  7192		       f0 36		      beq	.x
     81  7194		       a6 24		      ldx	t0
     82  7196		       ad 48 c4 	      lda	legatoNow
     83  7199		       d0 2f		      bne	.x	; (legato: no new start)
     84  719b		       bd 13 c3 	      lda	vNote,x
     85  719e		       c9 ff		      cmp	#NO_NOTE
     86  71a0		       f0 04		      beq	.go	; from silence
     87  71a2		       a5 27		      lda	t3
     88  71a4		       f0 24		      beq	.x	; (a glide to a new note, no new attack)
     89  71a6				   .go
     90  71a6		       bd 0a c3 	      lda	vWant,x
     91  71a9		       18		      clc
     92  71aa		       6d 96 c6 	      adc	sndPenv
     93  71ad		       20 f7 71 	      jsr	NoteClamp
     94  71b0		       20 4b 20 	      jsr	SidPitch	; -> ptr
     95  71b3		       a5 28		      lda	ptr
     96  71b5		       99 de c3 	      sta	sidBaseLo,y
     97  71b8		       a5 29		      lda	ptr+1
     98  71ba		       99 e1 c3 	      sta	sidBaseHi,y
     99  71bd		       ad 97 c6 	      lda	sndPenvK
    100  71c0		       ae 93 c6 	      ldx	sndStep
    101  71c3		       f0 02		      beq	.k
    102  71c5		       a9 ff		      lda	#$FF	; (STEP: held; AtkStep jumps)
    103  71c7				   .k
    104  71c7		       99 62 c9 	      sta	sK,y
    105  71ca				   .x
    106  71ca		       60		      rts
    107  71cb
    108  71cb							; VoiceSet, a SID voice let go (X = the voice, Y = SID voice): BEND OUT
    109  71cb				   RelDrop
    110  71cb					      subroutine
    111  71cb		       ad 9a c6 	      lda	sndRdrop
    112  71ce		       f0 26		      beq	.x
    113  71d0		       bd 13 c3 	      lda	vNote,x
    114  71d3		       c9 ff		      cmp	#NO_NOTE
    115  71d5		       f0 1f		      beq	.x
    116  71d7		       38		      sec
    117  71d8		       ed 9a c6 	      sbc	sndRdrop
    118  71db		       20 f7 71 	      jsr	NoteClamp
    119  71de		       20 4b 20 	      jsr	SidPitch
    120  71e1		       a5 28		      lda	ptr
    121  71e3		       99 5c c4 	      sta	sidTgtLo,y
    122  71e6		       a5 29		      lda	ptr+1
    123  71e8		       99 5f c4 	      sta	sidTgtHi,y
    124  71eb		       ad 9b c6 	      lda	sndRdropK
    125  71ee		       99 62 c9 	      sta	sK,y
    126  71f1		       a9 01		      lda	#1
    127  71f3		       99 66 c9 	      sta	rdOn,y
    128  71f6				   .x
    129  71f6		       60		      rts
    130  71f7
    131  71f7							; A = a note, kept within the SID's table (0-127; a signed overflow: 0)
    132  71f7				   NoteClamp
    133  71f7					      subroutine
    134  71f7		       c9 00		      cmp	#0
    135  71f9		       10 02		      bpl	.x
    136  71fb		       a9 00		      lda	#0
    137  71fd				   .x
