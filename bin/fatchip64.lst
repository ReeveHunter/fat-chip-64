------- FILE main.asm
------- FILE repeat.asm LEVEL 2 PASS 3
      0  47b8					      include	"repeat.asm"
      1  47b8							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  47b8							;
      3  47b8							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  47b8							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  47b8							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  47b8							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  47b8							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  47b8							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  47b8							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  47b8							; 3/4 of the time between echoes. The SID doesn't echo.
     11  47b8							;
     12  47b8							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  47b8							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  47b8							; or a keytar button).
     15  47b8							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  47b8							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  47b8
     18  47b8		       00 10	   RP_SLOTS   equ	16
     19  47b8		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  47b8
     21  47b8							; REPEAT is on now?
     22  47b8				   RepeatActive
     23  47b8		       ad 4c c5 	      lda	repeatOn
     24  47bb		       0d ac c4 	      ora	actCnt+A_REPEAT
     25  47be		       60		      rts
     26  47bf
     27  47bf							; Allocate, after SPARKLE took its pair: the echo voices (vSkip keeps them
     28  47bf							; out of the chord, vEcho marks them)
     29  47bf				   RepeatSet
     30  47bf					      subroutine
     31  47bf		       a2 08		      ldx	#NUM_VOICES-1
     32  47c1		       a9 00		      lda	#0
     33  47c3				   .c
     34  47c3		       9d 59 c5 	      sta	vEcho,x
