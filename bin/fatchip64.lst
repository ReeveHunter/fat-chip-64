     25  6781		       0d 2e c5 	      ora	nfxRun
     26  6784		       f0 0e		      beq	.x
     27  6786		       a5 10		      lda	ticks
     28  6788		       38		      sec
     29  6789		       ed 29 c5 	      sbc	nfxLast
     30  678c		       c9 08		      cmp	#NFX_EVERY
     31  678e		       a9 00		      lda	#0
     32  6790		       90 02		      bcc	.x
     33  6792		       a9 01		      lda	#1
     34  6794				   .x
     35  6794		       60		      rts
     36  6795
