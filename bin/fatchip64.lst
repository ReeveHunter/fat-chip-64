    441  60af							; ------------------------------------------------------------ tuning
    442  60af							; tuneC = PLAYING's FINE TUNE + the Synthcart's TUNE TO (while it's in use),
    443  60af							; in cents (-100..+100). The Game Boy gets it as master tune (CC 103), the
    444  60af							; NES in its bends (tuneN, 1/64 semitones), the SID in its note frequencies
    445  60af							; (SidTune; the notes sounding move at once). MATCH KEY sets the key's root
    446  60af							; once, when it changes.
    447  60af				   ScTune
    448  60af					      subroutine
    449  60af		       a9 00		      lda	#0
    450  60b1		       ae 37 c8 	      ldx	useSc
