------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  3d2b					      include	"sync.asm"
      1  3d2b							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  3d2b							;
      3  3d2b							; Menu, DEVICE SYNC (defaults first):
      4  3d2b							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  3d2b							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  3d2b							;		     sets the tempo, averaged over beats (the clock jitters about
      7  3d2b							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  3d2b							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  3d2b							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  3d2b							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  3d2b							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  3d2b							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  3d2b							;		     picks a beat demo (styleBeat)
     14  3d2b							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  3d2b							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  3d2b							;		     key channel) picks a sound (voiceSound)
     17  3d2b							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  3d2b							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  3d2b							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  3d2b							;
     21  3d2b							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  3d2b							; 1/4 ms); a Start makes the next clock a beat.
     23  3d2b
     24  3d2b		       00 00	   TEMPO_KEYTAR equ	0
     25  3d2b		       00 01	   TEMPO_OWN  equ	1
     26  3d2b		       00 02	   TEMPO_SC   equ	2
     27  3d2b		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  3d2b
     29  3d2b
     30  3d2b
     31  3d2b							; ------------------------------------------------------------ clock
