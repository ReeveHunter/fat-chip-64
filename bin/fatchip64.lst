    181  0ca1		       90 20		      bcc	.done
    182  0ca3		       a6 1b		      ldx	nesqTail
    183  0ca5		       bd c0 c1 	      lda	nesqS,x
    184  0ca8		       bc 40 c2 	      ldy	nesqD2,x
    185  0cab		       84 2c		      sty	irqT
    186  0cad		       bc 00 c2 	      ldy	nesqD1,x
    187  0cb0		       20 e0 0c 	      jsr	WireMsg
    188  0cb3		       a5 1b		      lda	nesqTail
    189  0cb5		       18		      clc
    190  0cb6		       69 01		      adc	#1
    191  0cb8		       29 3f		      and	#63
    192  0cba		       85 1b		      sta	nesqTail
    193  0cbc		       a5 10		      lda	ticks
    194  0cbe		       18		      clc
