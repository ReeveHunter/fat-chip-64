     37  7d9d ????	       00 ff	   TICK_LATCH equ	255	; CIA1 timer A: 256 cycles = 1/4 ms (NTSC), quicker
     38  7d9d ????						; than a MIDI byte (327 cycles), so the ACIA is fed
     39  7d9d ????						; and read (MIDI in) even while the main loop is
     40  7d9d ????						; busy; every fourth IRQ is a tick
     41  7d9d ????	       00 04	   SCAN_EVERY equ	4	; keyboard scan every 4 ms
     42  7d9d ????	       00 03	   GB_GAP     equ	3	; ms between messages to the Game Boy (measured safe: 2)
     43  7d9d ????	       00 2d	   LINK_MAX   equ	45	; bytes we let pile up in the Teensyboy (its buffer: 64)
     44  7d9d ????	       00 01	   NES_GAP    equ	1	; ms between messages to the MidiNES (wire-limited)
     45  7d9d ????	       01 5e	   DOUBLE_TAP equ	350	; ms: second RESTORE press within this = double tap
     46  7d9d ????	       00 28	   RESTORE_DEBOUNCE equ	40	; ms
