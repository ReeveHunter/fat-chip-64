------- FILE main.asm
------- FILE wander.asm LEVEL 2 PASS 3
      0  682c					      include	"wander.asm"
      1  682c							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  682c							;
      3  682c							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  682c							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  682c							;   ATTACK   as always: the new notes start
      6  682c							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  682c							;	      has none)
      8  682c							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  682c							;	      start again
     10  682c							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  682c							;	      late; some glide, some start again (fade out, come back in)
     12  682c							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  682c							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  682c							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  682c							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  682c
     17  682c		       00 01	   CHG_ATTACK equ	1
     18  682c		       00 02	   CHG_GLIDE  equ	2
     19  682c		       00 03	   CHG_STAGGER equ	3
     20  682c		       00 04	   CHG_WANDER equ	4
     21  682c		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  682c		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  682c
     24  682c							; A = the chord change style now (keeps X, Y)
     25  682c				   ChgEff
     26  682c					      subroutine
     27  682c		       ad 59 c8 	      lda	chgMode
     28  682f		       d0 0c		      bne	.x
     29  6831		       ad ab c3 	      lda	effMode
     30  6834		       c9 02		      cmp	#MODE_DRONE
     31  6836		       d0 03		      bne	.a
     32  6838		       a9 04		      lda	#CHG_WANDER
     33  683a		       60		      rts
     34  683b				   .a
     35  683b		       a9 01		      lda	#CHG_ATTACK
     36  683d				   .x
     37  683d		       60		      rts
