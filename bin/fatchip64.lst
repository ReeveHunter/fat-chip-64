------- FILE sounds.asm LEVEL 2 PASS 3
      0  3726					      include	"sounds.asm"
      1  3726							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  3726							;
      3  3726							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  3726							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  3726							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  3726							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  3726							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  3726							;
      9  3726							; Each sound has a mono default and a Fat Bass default:
     10  3726							;   MONO      one note (the last key pressed and still held) on every voice;
     11  3726							;	       a new key while another is held changes the pitch without a
     12  3726							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  3726							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  3726							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  3726							;	       the other voices
     16  3726							;
     17  3726							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  3726							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  3726							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  3726
     21  3726							; ------------------------------------------------------------ choosing
     22  3726							; V: next sound (SHIFT+V: previous)
     23  3726				   SoundKey
     24  3726					      subroutine
     25  3726		       20 b3 37 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3729		       ae 95 c3 	      ldx	soundMode
     27  372c		       ad 2a c3 	      lda	shiftDown
     28  372f		       d0 09		      bne	.prev
     29  3731		       e8		      inx
     30  3732		       e0 13		      cpx	#NUM_SOUNDS
     31  3734		       90 09		      bcc	.s
     32  3736		       a2 00		      ldx	#0
     33  3738		       f0 05		      beq	.s
     34  373a				   .prev
     35  373a		       ca		      dex
     36  373b		       10 02		      bpl	.s
     37  373d		       a2 12		      ldx	#NUM_SOUNDS-1
     38  373f				   .s
