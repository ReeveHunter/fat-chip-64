------- FILE devices.asm LEVEL 2 PASS 3
      0  646b					      include	"devices.asm"
      1  646b							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  646b							; are in use, and each one in use gets its page on the main menu.
      3  646b							;
      4  646b							; YAMAHA SHS-10 (the keytar)
      5  646b							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  646b							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  646b							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  646b							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  646b							;		     can play at once.)
     10  646b							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  646b							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  646b							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  646b							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  646b							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  646b							;		     louder (the SID and the NES; the Game Boy would click) or
     16  646b							;		     brighter (the SID's filter: switched on if the patch has
     17  646b							;		     none)
     18  646b							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  646b							;		     the patch's, or the ADVANCED amounts if it has none;
     20  646b							;		     FILTER), or an action held while blowing hard
     21  646b							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  646b							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  646b							;   PORTAMENTO BUTTON	an action (CC 65)
     24  646b							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  646b							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  646b							; ATARI SYNTHCART
     27  646b							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  646b							;		     about 3% while held, SHIFT + , . step through the ten
     29  646b							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  646b							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  646b							;		     sound's cents (the Synthcart manual's table: each Atari
     32  646b							;		     sound plays its scales in its own key, a little off)
     33  646b							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  646b
     35  646b		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  646b		       00 28	   BREATH_LO  equ	40
     37  646b		       00 01	   BFX_VIB    equ	1
     38  646b		       00 02	   BFX_WARB   equ	2
     39  646b		       00 03	   BFX_DET    equ	3
     40  646b		       00 04	   BFX_FILT   equ	4
     41  646b		       00 05	   BFX_HELD   equ	5
     42  646b
