------- FILE voices.asm LEVEL 2 PASS 3
      0  1190					      include	"voices.asm"
      1  1190							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  1190							;
      3  1190							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  1190							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  1190							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  1190							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  1190							; Allocation, whenever the held notes change:
      8  1190							;   1. bass voices play the lowest note, an octave down
      9  1190							;   2. every other note gets one voice, lowest notes first
     10  1190							;   3. leftover voices stack on the lowest two notes, alternating
     11  1190							; So one note = a nine-voice unison across three chips, and in chords the
     12  1190							; bottom of the chord is fattest. Disabled devices get no notes.
     13  1190
     14  1190							; ------------------------------------------------------------ SID
     15  1190				   SidInit
     16  1190					      subroutine
     17  1190		       a2 18		      ldx	#24
     18  1192		       a9 00		      lda	#0
     19  1194				   .clr
     20  1194		       9d 00 d4 	      sta	SID,x
     21  1197		       ca		      dex
     22  1198		       10 fa		      bpl	.clr
     23  119a		       20 bd 11 	      jsr	SidVolume
     24  119d		       a2 02		      ldx	#2
     25  119f				   .v
     26  119f		       bc 53 66 	      ldy	sidOfs,x
     27  11a2		       a9 19		      lda	#$19	; attack 1, decay 9
     28  11a4		       99 05 d4 	      sta	SID+5,y
     29  11a7		       a9 c9		      lda	#$C9	; sustain 12, release 9
     30  11a9		       99 06 d4 	      sta	SID+6,y
     31  11ac		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     32  11ae		       99 03 d4 	      sta	SID+3,y
     33  11b1		       a9 20		      lda	#$20	; sawtooth, gate off
     34  11b3		       9d 31 c3 	      sta	sidGate,x
     35  11b6		       99 04 d4 	      sta	SID+4,y
     36  11b9		       ca		      dex
     37  11ba		       10 e3		      bpl	.v
     38  11bc		       60		      rts
     39  11bd
     40  11bd							; Volume 15, or 0 (silent, no hum) when the SID is off or muted (M).
