    138  6681		       18		      clc
    139  6682		       6d 95 c6 	      adc	sndPenv
    140  6685		       20 c8 66 	      jsr	NoteClamp
    141  6688		       20 ca 1b 	      jsr	SidPitch	; -> ptr
