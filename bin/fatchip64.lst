    128  0d01							; A = key code at ksCol / ksRow
    129  0d01				   KeyCode
    130  0d01					      subroutine
    131  0d01		       ad 1f c3 	      lda	ksCol
    132  0d04		       0a		      asl
    133  0d05		       0a		      asl
    134  0d06		       0a		      asl
    135  0d07		       0d 20 c3 	      ora	ksRow
    136  0d0a		       a8		      tay
    137  0d0b		       b9 15 28 	      lda	keymap,y
    138  0d0e		       60		      rts
    139  0d0f
    140  0d0f							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    141  0d0f							; keys: some other column has a key in this row and shares another row with
    142  0d0f							; this column.
    143  0d0f				   Suspect
    144  0d0f					      subroutine
    145  0d0f		       ac 20 c3 	      ldy	ksRow
    146  0d12		       b9 0d 28 	      lda	rowBit,y
    147  0d15		       49 ff		      eor	#$FF
    148  0d17		       ae 1f c3 	      ldx	ksCol
    149  0d1a		       3d 80 c2 	      and	keyNow,x
    150  0d1d		       8d 21 c3 	      sta	ksMask	; this column's other held rows
    151  0d20		       f0 1c		      beq	.no
    152  0d22		       a2 07		      ldx	#7
    153  0d24				   .c
    154  0d24		       ec 1f c3 	      cpx	ksCol
    155  0d27		       f0 12		      beq	.n
    156  0d29		       bd 80 c2 	      lda	keyNow,x
    157  0d2c		       39 0d 28 	      and	rowBit,y
    158  0d2f		       f0 0a		      beq	.n
    159  0d31		       bd 80 c2 	      lda	keyNow,x
    160  0d34		       2d 21 c3 	      and	ksMask
    161  0d37		       f0 02		      beq	.n
    162  0d39		       38		      sec
    163  0d3a		       60		      rts
    164  0d3b				   .n
    165  0d3b		       ca		      dex
    166  0d3c		       10 e6		      bpl	.c
    167  0d3e				   .no
    168  0d3e		       18		      clc
    169  0d3f		       60		      rts
    170  0d40
    171  0d40							; A = key code
    172  0d40							;   overlay	    notes (K held + a note: set the key)
    173  0d40							;   F1/F3/F5/F7    octave: C4 / C3 / C2 / C1 on the lowest key
    174  0d40							;   SHIFT+F1/F3/F5 SID / Game Boy / MidiNES on-off	SHIFT+F7 panic
    175  0d40							;   CTRL+F3/F5     Game Boy / MidiNES: next channel block
    176  0d40							;   M		    mute everything	   SPACE  momentary (flips mute while held)
