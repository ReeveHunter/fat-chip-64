------- FILE main.asm
------- FILE lead.asm LEVEL 2 PASS 3
      0  6640					      include	"lead.asm"
      1  6640							; Fat Chip 64 - CHORD + LEAD (v0.28): a chord and a lead at once, each its
      2  6640							; own patch.
      3  6640							;   BASS      (was LOW NOTE) the first key pressed is the chord's root
      4  6640							;	       (POLY: just it; SMART CHORD: its 5TH, TRIAD...; DRONE: the
      5  6640							;	       drone); every other key is the lead, while the chord key is held
      6  6640							;   TRIAD     (was LATCH 3) three keys pressed together are the chord while
      7  6640							;	       they're held (v0.36: with LATCH on, it keeps sounding after you
      8  6640							;	       let go); every other key is the lead.
      9  6640							; v0.36: the lead is LEAD OCTAVE up in every mode (+1 at first; SHIFT + F1 /
     10  6640							; F3). SHIFT + F5 SPLIT on / off (held + a note: the split point), SHIFT + F7
     11  6640							; its mode. LATCH holds KEY's chord side and TRIAD's chord.
     12  6640							; The lead is one note (the last key pressed) on one voice per chip (SID 3,
     13  6640							; Game Boy pulse 1, NES pulse 1), only while it plays: the rest of the time
     14  6640							; those voices are the chord's. Its patch: SHIFT + A S D F G / Z X C V B.
     15  6640							; The lead's own: the SID's waveform, width, envelope and octave, the Game
     16  6640							; Boy pulse's CCs, the NES pulse's duty. Shared with the chord: the effects
     17  6640							; (vibrato, filter, tremolo...), the NES envelope.
     18  6640
     19  6640							;   KEY       (v0.32) a keyboard split: keys below the split point are the
     20  6640							;	       chord (as the mode plays them), keys from it up the lead (LEAD
     21  6640							;	       OCTAVE, +1 at first). On the C64's keys the split is a key (it
     22  6640							;	       stays put when the octave changes); over MIDI, a note as sent
     23  6640							;	       (before MIDI IN OCTAVE). SHIFT + F5 held + a note sets either.
     24  6640		       00 01	   CL_KEY     equ	1	; SPLIT (clMode)
     25  6640		       00 02	   CL_BASS    equ	2
     26  6640		       00 03	   CL_L3      equ	3	; (TRIAD)
     27  6640		       00 06	   LEAD_SID   equ	6	; the lead's voices: SID 3, GB pulse 1, NES pulse 1
     28  6640		       00 01	   LEAD_GB    equ	1
     29  6640		       00 02	   LEAD_NES   equ	2
     30  6640
     31  6640							; NoteDown, CHORD + LEAD on: key X pressed. Carry set: it's the lead (the
     32  6640							; latch styles leave it alone).
     33  6640				   ClPress
     34  6640					      subroutine
     35  6640		       8e b1 c3 	      stx	exI
     36  6643		       ad ae c8 	      lda	clMode
     37  6646		       c9 03		      cmp	#CL_L3
     38  6648		       f0 21		      beq	.l3
     39  664a		       c9 01		      cmp	#CL_KEY
     40  664c		       d0 09		      bne	.low
