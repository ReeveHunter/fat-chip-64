------- FILE lead.asm LEVEL 2 PASS 3
      0  64a0					      include	"lead.asm"
      1  64a0							; Fat Chip 64 - CHORD + LEAD (v0.28): a chord and a lead at once, each its
      2  64a0							; own patch.
      3  64a0							;   LOW NOTE  the first key pressed is the chord's root (POLY: just it;
      4  64a0							;	       SMART CHORD: its 5TH, TRIAD...; DRONE: the drone); every other
      5  64a0							;	       key is the lead, while the chord key is held
      6  64a0							;   LATCH 3   three keys pressed together latch as the chord (let go, it
      7  64a0							;	       keeps sounding); everything else is the lead. L clears it.
      8  64a0							; The lead is one note (the last key pressed) on one voice per chip (SID 3,
      9  64a0							; Game Boy pulse 1, NES pulse 1), only while it plays: the rest of the time
     10  64a0							; those voices are the chord's. Its patch: SHIFT + A S D F G / Z X C V B.
     11  64a0							; The lead's own: the SID's waveform, width, envelope and octave, the Game
     12  64a0							; Boy pulse's CCs, the NES pulse's duty. Shared with the chord: the effects
     13  64a0							; (vibrato, filter, tremolo...), the NES envelope.
     14  64a0
     15  64a0							;   KEY       (v0.32) a keyboard split: keys below the split point are the
     16  64a0							;	       chord (as the mode plays them), keys from it up the lead (LEAD
     17  64a0							;	       OCTAVE, +1 at first). On the C64's keys the split is a key (it
     18  64a0							;	       stays put when the octave changes); over MIDI, a note as sent
     19  64a0							;	       (before MIDI IN OCTAVE). C= + V held + a note sets either.
     20  64a0		       00 01	   CL_KEY     equ	1	; SPLIT (clMode)
     21  64a0		       00 02	   CL_LOW     equ	2
     22  64a0		       00 03	   CL_L3      equ	3
     23  64a0		       00 06	   LEAD_SID   equ	6	; the lead's voices: SID 3, GB pulse 1, NES pulse 1
     24  64a0		       00 01	   LEAD_GB    equ	1
     25  64a0		       00 02	   LEAD_NES   equ	2
     26  64a0
     27  64a0							; NoteDown, CHORD + LEAD on: key X pressed. Carry set: it's the lead (the
     28  64a0							; latch styles leave it alone).
     29  64a0				   ClPress
