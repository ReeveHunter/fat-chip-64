    160  0fb4							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    161  0fb4							; keys: some other column has a key in this row and shares another row with
    162  0fb4							; this column.
    163  0fb4				   Suspect
    164  0fb4					      subroutine
    165  0fb4		       ac 3d c3 	      ldy	ksRow
    166  0fb7		       b9 23 82 	      lda	rowBit,y
    167  0fba		       49 ff		      eor	#$FF
    168  0fbc		       ae 3c c3 	      ldx	ksCol
    169  0fbf		       3d 80 c2 	      and	keyNow,x
    170  0fc2		       8d 3e c3 	      sta	ksMask	; this column's other held rows
    171  0fc5		       f0 1c		      beq	.no
    172  0fc7		       a2 07		      ldx	#7
    173  0fc9				   .c
    174  0fc9		       ec 3c c3 	      cpx	ksCol
    175  0fcc		       f0 12		      beq	.n
    176  0fce		       bd 80 c2 	      lda	keyNow,x
    177  0fd1		       39 23 82 	      and	rowBit,y
    178  0fd4		       f0 0a		      beq	.n
    179  0fd6		       bd 80 c2 	      lda	keyNow,x
    180  0fd9		       2d 3e c3 	      and	ksMask
    181  0fdc		       f0 02		      beq	.n
    182  0fde		       38		      sec
    183  0fdf		       60		      rts
    184  0fe0				   .n
    185  0fe0		       ca		      dex
    186  0fe1		       10 e6		      bpl	.c
    187  0fe3				   .no
    188  0fe3		       18		      clc
    189  0fe4		       60		      rts
    190  0fe5
    191  0fe5							; A = key code (v0.22 layout)
    192  0fe5							;   overlay	    notes
    193  0fe5							;   A S D F G	    bank (FAT PADS LEADS BASS FX): switches at once, same slot
    194  0fe5							;   Z X C V B	    patch 1-5 in the bank
    195  0fe5							;   L		    latch on / off	      K, then a note or a shape: key + scale
    196  0fe5							;   =		    tap tempo		      , / .  tempo -1 / +1 (SHIFT: 10)
    197  0fe5							;   /		    mute		      SHIFT+/  the dice
    198  0fe5							;   ; / :	    free arp speed	      SPACE  its action
    199  0fe5							;   F1 / F3	    octave up / down	      F5  arp on / off	  F7  visualizer
    200  0fe5							;   RETURN	    the menu		      CTRL+F3/F5  GB / NES channel block
    201  0fe5							;   C= +  A S D F  arp type / pattern / speed / SPARKLE octave
    202  0fe5							;	   Z X C    notes mode / extensions / POLY-MONO     L  latch style
    203  0fe5							;	   , .	    SPACE's action	      ; :  MIDI in octave down / up
    204  0fe5							;	   /	    undo the dice	      F1 F3 F5	SID / GB / NES on-off
    205  0fe5							;	   F7	    panic		      (SHIFT + F keys too, as before)
