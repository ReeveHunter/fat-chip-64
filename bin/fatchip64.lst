------- FILE nesfx.asm LEVEL 2 PASS 3
      0  8558					      include	"nesfx.asm"
      1  8558							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  8558							;
      3  8558							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  8558							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  8558							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  8558							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  8558							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  8558							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  8558							;   glide    a new note starts bent back to the voice's last note and slides
     10  8558							;	      in the way the SID's does (all three channels)
     11  8558							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  8558							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  8558							; semitone, so these are a little stepped.
     14  8558
     15  8558		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  8558							;  (the pulses, and the triangle while it glides)
     17  8558
     18  8558							; A = 1 (not Z) when a NesFxTick step is due
     19  8558				   NesFxDue
     20  8558					      subroutine
     21  8558		       ad eb c7 	      lda	devOn+DEV_NES
     22  855b		       f0 1c		      beq	.x
     23  855d		       ad cb ca 	      lda	vibDepth
     24  8560		       0d f9 c9 	      ora	nfxGlide
     25  8563		       0d fa c9 	      ora	nfxRun
     26  8566		       0d b9 ce 	      ora	nfxWarb
     27  8569		       f0 0e		      beq	.x
     28  856b		       a5 10		      lda	ticks
     29  856d		       38		      sec
     30  856e		       ed f5 c9 	      sbc	nfxLast
     31  8571		       c9 08		      cmp	#NFX_EVERY
     32  8573		       a9 00		      lda	#0
     33  8575		       90 02		      bcc	.x
     34  8577		       a9 01		      lda	#1
     35  8579				   .x
     36  8579		       60		      rts
     37  857a
     38  857a							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     39  857a							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     40  857a							; quick return.
     41  857a				   NesFxTick
