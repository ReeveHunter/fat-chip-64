------- FILE main.asm LEVEL 1 PASS 3
      1  537a ????						; Fat Chip 64 - main program
      2  537a ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  537a ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  537a ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  537a ????
      6  537a ????				      processor	6502
