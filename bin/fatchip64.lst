------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  47f8					      include	"sync.asm"
      1  47f8							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  47f8							;
      3  47f8							; Menu, DEVICE SYNC (defaults first):
      4  47f8							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  47f8							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  47f8							;		     sets the tempo, averaged over beats (the clock jitters about
      7  47f8							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  47f8							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  47f8							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  47f8							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  47f8							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  47f8							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  47f8							;		     picks a beat demo (styleBeat)
     14  47f8							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  47f8							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  47f8							;		     key channel) picks a sound (voiceSound)
     17  47f8							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  47f8							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  47f8							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  47f8							;
     21  47f8							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  47f8							; 1/4 ms); a Start makes the next clock a beat.
     23  47f8
     24  47f8		       00 00	   TEMPO_KEYTAR equ	0
     25  47f8		       00 01	   TEMPO_OWN  equ	1
     26  47f8		       00 02	   TEMPO_SC   equ	2
     27  47f8		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  47f8
     29  47f8
     30  47f8
