     32  396f		       8c 84 c4 	      sty	drumTom
     33  3972		       c9 00		      cmp	#DK_KICK
     34  3974		       d0 05		      bne	.nk
     35  3976		       a9 01		      lda	#1
     36  3978		       8d 3c c6 	      sta	vizKick	; (the visualizer's border flash)
     37  397b				   .nk
