     39  d799 ????	       03 ff	   TICK_LATCH_MS equ	1023	; with the MIDI chip's interrupts (midiIrq): 1 ms
     40  d799 ????	       00 ff	   TICK_LATCH equ	255	; CIA1 timer A: 256 cycles = 1/4 ms (NTSC), quicker
     41  d799 ????						; than a MIDI byte (327 cycles), so the ACIA is fed
     42  d799 ????						; and read (MIDI in) even while the main loop is
     43  d799 ????						; busy; every fourth IRQ is a tick
     44  d799 ????	       00 04	   SCAN_EVERY equ	4	; keyboard scan every 4 ms
