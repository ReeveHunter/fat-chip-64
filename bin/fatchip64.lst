    466  6889		       f0 1b		      beq	.k
    467  688b		       8d 62 c8 	      sta	tuneC
    468  688e		       20 bf 68 	      jsr	TuneUnits
    469  6891		       ae 64 c8 	      ldx	gbTune
    470  6894		       a9 67		      lda	#GCC_TUNE
    471  6896		       20 58 0d 	      jsr	GbGlobal
    472  6899		       a9 08		      lda	#8
    473  689b		       8d 3a c5 	      sta	nfxRun	; (the NES bends again)
    474  689e		       a9 00		      lda	#0
    475  68a0		       8d 69 c8 	      sta	vsGlide
    476  68a3		       20 a8 3f 	      jsr	SidRetune	; (the SID's notes sounding: there at once)
    477  68a6				   .k
