      0  0d1b					      include	"keys.asm"
      1  0d1b							; Fat Chip 64 - keyboard and RESTORE
      2  0d1b
      3  0d1b							; Scan the whole matrix, turn changes into key events.
      4  0d1b							;
      5  0d1b							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0d1b							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0d1b							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0d1b							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0d1b							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0d1b							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0d1b							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0d1b							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0d1b							; chords whose ghost lands on another used key lose their newest note.
     14  0d1b				   KeyScan
     15  0d1b					      subroutine
     16  0d1b		       a2 07		      ldx	#7
     17  0d1d				   .col
     18  0d1d		       bd f7 5d 	      lda	colSelect,x
     19  0d20		       8d 00 dc 	      sta	CIA1_PRA
     20  0d23		       ad 01 dc 	      lda	CIA1_PRB
     21  0d26		       49 ff		      eor	#$FF
     22  0d28		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0d2b		       9d 80 c2 	      sta	keyNow,x
     24  0d2e		       ca		      dex
     25  0d2f		       10 ec		      bpl	.col
     26  0d31		       a9 ff		      lda	#$FF
     27  0d33		       8d 00 dc 	      sta	CIA1_PRA
     28  0d36							; ---- releases first: accepted keys that are up now
     29  0d36		       a2 00		      ldx	#0
     30  0d38				   .rc
     31  0d38		       8e 37 c3 	      stx	ksCol
     32  0d3b		       bd 80 c2 	      lda	keyNow,x
     33  0d3e		       49 ff		      eor	#$FF
     34  0d40		       3d 90 c2 	      and	keyAcc,x
     35  0d43		       8d 36 c3 	      sta	ksBits
     36  0d46		       a9 00		      lda	#0
     37  0d48		       8d 38 c3 	      sta	ksRow
     38  0d4b				   .rb
     39  0d4b		       ad 36 c3 	      lda	ksBits
     40  0d4e		       f0 21		      beq	.rcn
     41  0d50		       4e 36 c3 	      lsr	ksBits
     42  0d53		       90 17		      bcc	.rbn
     43  0d55		       ae 37 c3 	      ldx	ksCol
     44  0d58		       ac 38 c3 	      ldy	ksRow
     45  0d5b		       b9 ff 5d 	      lda	rowBit,y
     46  0d5e		       49 ff		      eor	#$FF
     47  0d60		       3d 90 c2 	      and	keyAcc,x
     48  0d63		       9d 90 c2 	      sta	keyAcc,x
     49  0d66		       20 f8 0d 	      jsr	KeyCode
     50  0d69		       20 ba 10 	      jsr	KeyUp
     51  0d6c				   .rbn
     52  0d6c		       ee 38 c3 	      inc	ksRow
     53  0d6f		       d0 da		      bne	.rb
     54  0d71				   .rcn
     55  0d71		       ae 37 c3 	      ldx	ksCol
     56  0d74		       e8		      inx
     57  0d75		       e0 08		      cpx	#8
     58  0d77		       d0 bf		      bne	.rc
     59  0d79							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     60  0d79							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     61  0d79							; still count as a combination.
     62  0d79		       a9 00		      lda	#0
     63  0d7b		       8d 3a c3 	      sta	ksPass
     64  0d7e				   .pass
     65  0d7e		       a2 00		      ldx	#0
     66  0d80				   .pc
     67  0d80		       8e 37 c3 	      stx	ksCol
     68  0d83		       bd 90 c2 	      lda	keyAcc,x
     69  0d86		       49 ff		      eor	#$FF
     70  0d88		       3d 80 c2 	      and	keyNow,x
     71  0d8b		       8d 36 c3 	      sta	ksBits
     72  0d8e		       a9 00		      lda	#0
     73  0d90		       8d 38 c3 	      sta	ksRow
     74  0d93				   .pb
     75  0d93		       ad 36 c3 	      lda	ksBits
     76  0d96		       f0 3d		      beq	.pcn
     77  0d98		       4e 36 c3 	      lsr	ksBits
     78  0d9b		       90 33		      bcc	.pbn
     79  0d9d		       ad 3b c3 	      lda	ghostFilter
     80  0da0		       f0 05		      beq	.accept	; filter off (default): phantoms play
     81  0da2		       20 06 0e 	      jsr	Suspect
     82  0da5		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     83  0da7				   .accept
     84  0da7		       20 f8 0d 	      jsr	KeyCode
     85  0daa		       20 e9 0d 	      jsr	IsModifier	; Z set = modifier
     86  0dad		       f0 07		      beq	.mod
     87  0daf		       ad 3a c3 	      lda	ksPass
     88  0db2		       f0 1c		      beq	.pbn	; pass 0: modifiers only
     89  0db4		       d0 05		      bne	.take
     90  0db6				   .mod
     91  0db6		       ad 3a c3 	      lda	ksPass
     92  0db9		       d0 15		      bne	.pbn	; (taken in pass 0)
     93  0dbb				   .take
     94  0dbb		       ae 37 c3 	      ldx	ksCol
