------- FILE main.asm
    543  c955				   hiEnd
    544  c955					      rend
    545  c955				  -	      if	hiEnd > $FFFA
    546  c955				  -	      echo	"the $E000 tables run into the CPU's vectors"
    547  c955				  -	      err
    548  c955					      endif
    549  c955				  -	      if	hiPhys + hiEnd - hiStart > $D000
    550  c955				  -	      echo	"the program file runs into the I/O at $D000"
    551  c955				  -	      err
    552  c955					      endif
