------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  54c5					      include	"sync.asm"
      1  54c5							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  54c5							;
      3  54c5							; Menu, DEVICE SYNC (defaults first):
      4  54c5							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  54c5							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  54c5							;		     sets the tempo, averaged over beats (the clock jitters about
      7  54c5							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  54c5							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  54c5							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  54c5							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  54c5							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  54c5							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  54c5							;		     picks a beat demo (styleBeat)
     14  54c5							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  54c5							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  54c5							;		     key channel) picks a sound (voiceSound)
     17  54c5							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  54c5							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  54c5							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  54c5							;
     21  54c5							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  54c5							; 1/4 ms); a Start makes the next clock a beat.
     23  54c5
     24  54c5		       00 00	   TEMPO_KEYTAR equ	0
     25  54c5		       00 01	   TEMPO_OWN  equ	1
     26  54c5		       00 02	   TEMPO_SC   equ	2
     27  54c5		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  54c5
     29  54c5
     30  54c5
     31  54c5							; ------------------------------------------------------------ clock
     32  54c5							; Main loop, every pass
     33  54c5				   ClockTick
     34  54c5					      subroutine
     35  54c5		       ad f1 c5 	      lda	clkCount	; any clock lately?
     36  54c8		       cd f2 c5 	      cmp	clkCountSeen
