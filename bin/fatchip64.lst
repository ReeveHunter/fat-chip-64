      0  3c55					      include	"nestables.asm"
      1  3c55							; generated by tools/gen_tables.py (NES part) - do not edit
      2  3c55							; MidiNES triangle release drop: -24 semitones over 50 steps (5 ms each = 250 ms), slow at first
      3  3c55							; triPb: MidiNES triangle bend scale per MIDI note, p(n) = 1710 * 0.5^((n - 36) / 12)
      4  3c55							; triDropH: (2 * 2^(s/12) - 2) * 1024 for the drop s at each step; bend = -(p * h) / 1024
      5  3c55							; triDropS8: the drop at each step in eighths of a semitone (for the floor check)
      6  3c55		       00 32	   TRI_STEPS  equ	50
