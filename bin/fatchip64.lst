     38  aa39 ????						; ------------------------------------------------------------ timing
     39  aa39 ????	       03 ff	   TICK_LATCH_MS equ	1023	; with the MIDI chip's interrupts (midiIrq): 1 ms
     40  aa39 ????	       00 ff	   TICK_LATCH equ	255	; CIA1 timer A: 256 cycles = 1/4 ms (NTSC), quicker
     41  aa39 ????						; than a MIDI byte (327 cycles), so the ACIA is fed
     42  aa39 ????						; and read (MIDI in) even while the main loop is
     43  aa39 ????						; busy; every fourth IRQ is a tick
     44  aa39 ????	       00 04	   SCAN_EVERY equ	4	; keyboard scan every 4 ms
     45  aa39 ????	       00 03	   GB_GAP     equ	3	; ms between messages to the Game Boy (measured safe: 2)
     46  aa39 ????	       00 2d	   LINK_MAX   equ	45	; bytes we let pile up in the Teensyboy (its buffer: 64)
     47  aa39 ????	       00 01	   NES_GAP    equ	1	; ms between messages to the MidiNES (wire-limited)
     48  aa39 ????	       01 5e	   DOUBLE_TAP equ	350	; ms: second RESTORE press within this = double tap
     49  aa39 ????	       00 28	   RESTORE_DEBOUNCE equ	40	; ms
     50  aa39 ????
