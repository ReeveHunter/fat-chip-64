    533  defb
    534  defb							; ---- v0.60: data in the RAM under the I/O ($D000-$DFFF): packed apart too,
    535  defb							; unpacked there with the I/O switched out; read with BeatLoad's copy
    536  defb				   ioPhys
    537  defb					      rorg	$D000
    538  defb				   ioStart
