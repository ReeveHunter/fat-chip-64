------- FILE screen.asm LEVEL 2 PASS 3
      0  6bcd					      include	"screen.asm"
      1  6bcd							; Fat Chip 64 - screen
      2  6bcd							;
      3  6bcd							;  row 0      header
      4  6bcd							;  row 2      sound, POLY / MONO, Fat Bass
      5  6bcd							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  6bcd							;	       each plays (row 7: a channel overlap warning)
      7  6bcd							;  row 9      key, notes mode, latch
      8  6bcd							;  row 10     arp
      9  6bcd							;  row 12     tempo, beat, mute
     10  6bcd							;  row 13     SPACE's action, octave (the lowest key)
     11  6bcd							;  row 15     held notes
     12  6bcd							;  row 16     MIDI in
     13  6bcd							;  row 24     F keys
     14  6bcd
     15  6bcd							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     16  6bcd							; Letters become screen codes; bit 7 of t2 reverses.
