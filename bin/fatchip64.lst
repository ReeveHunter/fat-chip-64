    138  8610		       dd eb c8 	      cmp	nesFxSL,x
    139  8613		       d0 08		      bne	.send
    140  8615		       ad 40 c9 	      lda	nfxH
    141  8618		       dd f4 c8 	      cmp	nesFxSH,x
    142  861b		       f0 0b		      beq	.x
    143  861d				   .send
    144  861d		       a9 01		      lda	#1
