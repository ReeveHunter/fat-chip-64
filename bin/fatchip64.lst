------- FILE drums.asm LEVEL 2 PASS 3
      0  41a3					      include	"drums.asm"
      1  41a3							; Fat Chip 64 - drums on the MidiNES
      2  41a3							;
      3  41a3							; Two sources, one kit:
      4  41a3							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  41a3							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  41a3							;			   64 = hit, 56 = ghost)
      7  41a3							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  41a3							;			   RETURN starts / stops it, at its own tempo (B taps
      9  41a3							;			   a new one)
     10  41a3							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  41a3							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  41a3							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  41a3							; a note-on, then a note-off after the sound's length, the level set with
     14  41a3							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  41a3							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  41a3
     17  41a3		       00 0c	   KIT_SIZE   equ	12
     18  41a3		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  41a3		       00 00	   DK_KICK    equ	0
     20  41a3		       00 01	   DK_SNARE   equ	1
     21  41a3		       00 02	   DK_CH      equ	2
     22  41a3		       00 03	   DK_OH      equ	3
     23  41a3		       00 04	   DK_CY      equ	4
     24  41a3		       00 05	   DK_TOM     equ	5
     25  41a3		       00 06	   DK_PERC    equ	6
     26  41a3
     27  41a3							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
