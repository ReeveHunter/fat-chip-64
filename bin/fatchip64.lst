     51  74c3		       99 ea c3 	      sta	sidBaseLo,y
     52  74c6		       b9 6b c4 	      lda	sidTgtHi,y
     53  74c9		       99 ed c3 	      sta	sidBaseHi,y
     54  74cc		       a9 00		      lda	#0
     55  74ce		       99 6e c9 	      sta	sK,y
     56  74d1				   .x
