      0  7f65					      include	"nesfx.asm"
      1  7f65							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7f65							;
      3  7f65							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7f65							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7f65							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7f65							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7f65							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7f65							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7f65							;   glide    a new note starts bent back to the voice's last note and slides
     10  7f65							;	      in the way the SID's does (all three channels)
     11  7f65							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7f65							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7f65							; semitone, so these are a little stepped.
     14  7f65
     15  7f65		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7f65							;  (the pulses, and the triangle while it glides)
     17  7f65
     18  7f65							; A = 1 (not Z) when a NesFxTick step is due
     19  7f65				   NesFxDue
     20  7f65					      subroutine
     21  7f65		       ad 2b c3 	      lda	devOn+DEV_NES
     22  7f68		       f0 1c		      beq	.x
     23  7f6a		       ad 0b c6 	      lda	vibDepth
     24  7f6d		       0d 39 c5 	      ora	nfxGlide
     25  7f70		       0d 3a c5 	      ora	nfxRun
     26  7f73		       0d ef c9 	      ora	nfxWarb
     27  7f76		       f0 0e		      beq	.x
     28  7f78		       a5 10		      lda	ticks
     29  7f7a		       38		      sec
     30  7f7b		       ed 35 c5 	      sbc	nfxLast
     31  7f7e		       c9 08		      cmp	#NFX_EVERY
     32  7f80		       a9 00		      lda	#0
     33  7f82		       90 02		      bcc	.x
     34  7f84		       a9 01		      lda	#1
     35  7f86				   .x
     36  7f86		       60		      rts
     37  7f87
     38  7f87							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     39  7f87							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     40  7f87							; quick return.
     41  7f87				   NesFxTick
