------- FILE main.asm LEVEL 1 PASS 3
      1  cf91 ????						; Fat Chip 64 - main program
      2  cf91 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  cf91 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  cf91 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  cf91 ????
      6  cf91 ????				      processor	6502
