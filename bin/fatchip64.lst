------- FILE main.asm
------- FILE viz.asm LEVEL 2 PASS 3
      0  5dc2					      include	"viz.asm"
      1  5dc2							; Fat Chip 64 - the visualizers (F7: BARS, GLITCH, back to play), demos
      2  5dc2							;
      3  5dc2							; BARS:
      4  5dc2							; Nine bars, one per voice, in three groups: SID, Game Boy, MidiNES. A new
      5  5dc2							; note throws its bar to the top; it falls back to a height set by the
      6  5dc2							; note's pitch (higher notes stand taller) while the note sounds, and to
      7  5dc2							; nothing when it stops. The tremolo makes the bars breathe. Each bar takes
      8  5dc2							; the colour of its note's pitch class (C red ... B white). Kick drums flash
      9  5dc2							; the border in the key's colour; row 24 has the sound, the tempo and, while
     10  5dc2							; a beat plays, which beat of the bar it's on.
     11  5dc2							;
     12  5dc2							; One bar is drawn per screen step (about every 8 ms), so the screen stays
     13  5dc2							; out of the way of the keyboard and the arp: about 13 frames a second.
     14  5dc2							;
     15  5dc2							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
     16  5dc2							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
     17  5dc2							; keep spattering more; runs of the screen get copied over other places
     18  5dc2							; (datamosh) and wiped away, so it fills while you play and dissolves when
     19  5dc2							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
     20  5dc2							; the background. VINYL STOP drags it down the screen.
     21  5dc2
     22  5dc2		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     23  5dc2		       00 16	   VIZ_NAMES  equ	22	; note names
     24  5dc2		       00 a0	   VIZ_FULL   equ	160	; reversed space
     25  5dc2		       00 62	   VIZ_HALF   equ	98	; lower half block
     26  5dc2
     27  5dc2							; F7: BARS -> GLITCH -> the play screen (not from the menu)
     28  5dc2				   VizKey
