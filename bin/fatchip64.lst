      0  644b					      include	"nesfx.asm"
      1  644b							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  644b							;
      3  644b							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  644b							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  644b							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  644b							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  644b							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  644b							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  644b							;   glide    a new note starts bent back to the voice's last note and slides
     10  644b							;	      in the way the SID's does (all three channels)
     11  644b							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  644b							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  644b							; semitone, so these are a little stepped.
     14  644b
     15  644b		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  644b							;  (the pulses, and the triangle while it glides)
     17  644b
     18  644b							; A = 1 (not Z) when a NesFxTick step is due
     19  644b				   NesFxDue
     20  644b					      subroutine
     21  644b		       ad 27 c3 	      lda	devOn+DEV_NES
     22  644e		       f0 19		      beq	.x
     23  6450		       ad fb c5 	      lda	vibDepth
     24  6453		       0d 29 c5 	      ora	nfxGlide
     25  6456		       0d 2a c5 	      ora	nfxRun
     26  6459		       f0 0e		      beq	.x
     27  645b		       a5 10		      lda	ticks
     28  645d		       38		      sec
     29  645e		       ed 25 c5 	      sbc	nfxLast
     30  6461		       c9 08		      cmp	#NFX_EVERY
     31  6463		       a9 00		      lda	#0
     32  6465		       90 02		      bcc	.x
     33  6467		       a9 01		      lda	#1
     34  6469				   .x
     35  6469		       60		      rts
     36  646a
     37  646a							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  646a							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  646a							; quick return.
