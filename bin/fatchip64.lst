    411  3d20		       d0 0b		      bne	.nc
    412  3d22		       c9 02		      cmp	#2
    413  3d24		       d0 07		      bne	.nc
    414  3d26		       8d e7 cc 	      sta	sxCmd
    415  3d29		       ee 18 cc 	      inc	sxPos
    416  3d2c		       60		      rts
    417  3d2d				   .nc
    418  3d2d		       ac e7 cc 	      ldy	sxCmd
    419  3d30		       c0 02		      cpy	#2
    420  3d32		       d0 0b		      bne	.pat
    421  3d34		       e0 04		      cpx	#4	; 2: one byte, bit 0 SID, 1 Game Boy, 2 NES
