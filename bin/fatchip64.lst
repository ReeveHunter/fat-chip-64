    358  3c82		       c9 f0		      cmp	#$F0
    359  3c84		       d0 0e		      bne	.end
    360  3c86		       a2 01		      ldx	#1
    361  3c88		       8e 17 cc 	      stx	sxOn
    362  3c8b		       8e e7 cc 	      stx	sxCmd
    363  3c8e		       a2 00		      ldx	#0
