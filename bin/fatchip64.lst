      0  4837					      include	"repeat.asm"
      1  4837							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  4837							;
      3  4837							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  4837							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  4837							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  4837							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  4837							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  4837							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  4837							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  4837							; 3/4 of the time between echoes. The SID doesn't echo.
     11  4837							;
     12  4837							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  4837							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  4837							; or a keytar button).
     15  4837							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  4837							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  4837
     18  4837		       00 10	   RP_SLOTS   equ	16
     19  4837		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  4837
     21  4837							; REPEAT is on now?
     22  4837				   RepeatActive
     23  4837		       ad 4c c5 	      lda	repeatOn
     24  483a		       0d ac c4 	      ora	actCnt+A_REPEAT
     25  483d		       60		      rts
