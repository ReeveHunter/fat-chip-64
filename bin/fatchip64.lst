     43  0bde		       78		      sei
     44  0bdf		       a6 2f		      ldx	midiIrq
     45  0be1		       bd 19 0c 	      lda	midiCtl,x
     46  0be4		       8d 04 de 	      sta	ACIA_CTRL
     47  0be7		       bd 1b 0c 	      lda	irqLo,x
     48  0bea		       8d fe ff 	      sta	$FFFE
     49  0bed		       bd 1d 0c 	      lda	irqHi,x
     50  0bf0		       8d ff ff 	      sta	$FFFF
     51  0bf3		       bd 1f 0c 	      lda	latchLo,x
     52  0bf6		       8d 04 dc 	      sta	CIA1_TALO
     53  0bf9		       bd 21 0c 	      lda	latchHi,x
     54  0bfc		       8d 05 dc 	      sta	CIA1_TAHI
     55  0bff		       a9 11		      lda	#$11	; start, force load, continuous
     56  0c01		       8d 0e dc 	      sta	CIA1_CRA
