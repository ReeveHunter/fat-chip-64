      0  5250					      include	"menu.asm"
      1  5250							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  5250							;
      3  5250							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  5250							;   page   RETURN opens a page
      5  5250							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  5250							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  5250							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  5250							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  5250							; device pages, until DEVICES says the device is in use).
     10  5250							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  5250							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  5250							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  5250
     14  5250		       00 17	   MENU_VALCOL equ	23
     15  5250
