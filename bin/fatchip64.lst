------- FILE attack.asm LEVEL 2 PASS 3
      0  7a10					      include	"attack.asm"
      1  7a10							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  7a10							; how each note starts and ends in pitch
      3  7a10							;
      4  7a10							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  7a10							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  7a10							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  7a10							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  7a10							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  7a10							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  7a10							;   (v0.42) as long as TIME.
     11  7a10							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  7a10							;   release rings.
     13  7a10
     14  7a10							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  7a10							; jumps to the note
     16  7a10				   AtkStep
     17  7a10					      subroutine
     18  7a10		       ac 8b c8 	      ldy	envY
     19  7a13		       b9 31 ce 	      lda	atkT,y
     20  7a16		       18		      clc
     21  7a17		       6d 1e c9 	      adc	fxN
