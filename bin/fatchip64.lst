    443  680b							; ------------------------------------------------------------ tuning
    444  680b							; tuneC = PLAYING's FINE TUNE + the Synthcart's TUNE TO (while it's in use),
    445  680b							; in cents (-100..+100). The Game Boy gets it as master tune (CC 103), the
    446  680b							; NES in its bends (tuneN, 1/64 semitones), the SID in its note frequencies
    447  680b							; (SidTune; the notes sounding move at once). MATCH KEY sets the key's root
    448  680b							; once, when it changes.
    449  680b				   ScTune
    450  680b					      subroutine
    451  680b		       a9 00		      lda	#0
    452  680d		       ae 3c c8 	      ldx	useSc
    453  6810		       f0 03		      beq	.t
    454  6812		       ad 53 c8 	      lda	scSound
    455  6815				   .t
    456  6815		       8d 58 c8 	      sta	tuneNow	; (the Synthcart sound, for MATCH KEY)
    457  6818		       aa		      tax
    458  6819		       ad 59 c8 	      lda	fineTune
    459  681c		       38		      sec
    460  681d		       e9 32		      sbc	#50
    461  681f		       18		      clc
    462  6820		       7d 36 69 	      adc	scCents,x
    463  6823		       50 00		      bvc	.c	; (can't overflow: -85..+60)
