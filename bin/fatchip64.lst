     87  4e2a		       aa		      tax
     88  4e2b		       bd db a7 	      lda	kits,x
     89  4e2e		       85 25		      sta	t1
     90  4e30							; bank (CC14 on the sample channel) when it changes
     91  4e30		       a9 04		      lda	#4
     92  4e32		       20 8a 4e 	      jsr	NesChStatus	; mS = CC, sample channel
     93  4e35		       a9 00		      lda	#0
     94  4e37		       a6 25		      ldx	t1
     95  4e39		       10 02		      bpl	.a
     96  4e3b		       a9 7f		      lda	#127
     97  4e3d				   .a
     98  4e3d		       cd 7c c4 	      cmp	dmcBank
     99  4e40		       f0 0c		      beq	.note
    100  4e42		       8d 7c c4 	      sta	dmcBank
    101  4e45		       85 23		      sta	mD2
    102  4e47		       a9 0e		      lda	#14
    103  4e49		       85 22		      sta	mD1
    104  4e4b		       20 3a 0d 	      jsr	NesPut
    105  4e4e				   .note
    106  4e4e		       a5 21		      lda	mS
    107  4e50		       29 0f		      and	#$0F
    108  4e52		       85 26		      sta	t2	; channel
    109  4e54		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    110  4e56							;  cuts it anyway, and the hit lands 1 ms sooner)
    111  4e56		       29 7f		      and	#$7F
    112  4e58		       8d 89 c4 	      sta	dmcNote
