    161  278d		       d0 03		      bne	.pb
    162  278f		       4c a9 38 	      jmp	KeytarVoice	; its voice buttons
    163  2792				   .pb
    164  2792		       c9 e0		      cmp	#$E0
    165  2794		       d0 03		      bne	.nt
    166  2796		       4c ff 3a 	      jmp	KeytarWheel
    167  2799				   .nt
