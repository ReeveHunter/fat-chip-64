      0  7edf					      include	"nesfx.asm"
      1  7edf							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7edf							;
      3  7edf							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7edf							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7edf							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7edf							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7edf							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7edf							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7edf							;   glide    a new note starts bent back to the voice's last note and slides
     10  7edf							;	      in the way the SID's does (all three channels)
     11  7edf							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7edf							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7edf							; semitone, so these are a little stepped.
     14  7edf
     15  7edf		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7edf							;  (the pulses, and the triangle while it glides)
     17  7edf
     18  7edf							; A = 1 (not Z) when a NesFxTick step is due
     19  7edf				   NesFxDue
     20  7edf					      subroutine
     21  7edf		       ad 2b c3 	      lda	devOn+DEV_NES
     22  7ee2		       f0 1c		      beq	.x
     23  7ee4		       ad 0b c6 	      lda	vibDepth
