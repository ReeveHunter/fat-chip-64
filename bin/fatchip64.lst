     44  0b39		       bd 71 0b 	      lda	midiCtl,x
     45  0b3c		       8d 04 de 	      sta	ACIA_CTRL
     46  0b3f		       bd 73 0b 	      lda	irqLo,x
     47  0b42		       8d fe ff 	      sta	$FFFE
     48  0b45		       bd 75 0b 	      lda	irqHi,x
     49  0b48		       8d ff ff 	      sta	$FFFF
     50  0b4b		       bd 77 0b 	      lda	latchLo,x
     51  0b4e		       8d 04 dc 	      sta	CIA1_TALO
     52  0b51		       bd 79 0b 	      lda	latchHi,x
