    100  08b9							; one screen step per keyboard scan, 2 ms after it, on a pass of its
    101  08b9							; own (a scan and a screen step in one pass would stretch it)
    102  08b9							; (v0.12: the SID effects take a non-scan pass the screen doesn't need)
    103  08b9							; when both are due they take turns (a redraw after a key press would
    104  08b9							; otherwise freeze vibrato and glides for 70 ms)
    105  08b9		       ad 01 c8 	      lda	scanned
    106  08bc		       d0 47		      bne	.x
    107  08be		       a5 13		      lda	scrAt
