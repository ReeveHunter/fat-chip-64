------- FILE screen.asm LEVEL 2 PASS 3
      0  72fa					      include	"screen.asm"
      1  72fa							; Fat Chip 64 - screen
      2  72fa							;
      3  72fa							;  row 0      header
      4  72fa							;  row 2      sound, POLY / MONO, Fat Bass
      5  72fa							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  72fa							;	       each plays (row 7: a channel overlap warning)
      7  72fa							;  row 9      key, notes mode, latch
      8  72fa							;  row 10     arp
      9  72fa							;  row 12     tempo, beat, mute
     10  72fa							;  row 13     SPACE's action, octave (the lowest key), transpose
     11  72fa							;  row 14     v0.40: the effect the C= keys work on, its setting
     12  72fa							;  row 15     held notes
     13  72fa							;  row 16     MIDI in
     14  72fa							;  row 24     F keys
     15  72fa
     16  72fa							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     17  72fa							; Letters become screen codes; bit 7 of t2 reverses.
     18  72fa				   PrintAt
     19  72fa					      subroutine
     20  72fa		       20 12 73 	      jsr	ScreenAddr
     21  72fd		       a0 00		      ldy	#0
     22  72ff				   .c
     23  72ff		       b1 28		      lda	(ptr),y
     24  7301		       f0 0e		      beq	.done
     25  7303		       c9 40		      cmp	#64
     26  7305		       90 03		      bcc	.noLetter
     27  7307		       38		      sec
     28  7308		       e9 40		      sbc	#64
     29  730a				   .noLetter
