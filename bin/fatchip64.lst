------- FILE devices.asm LEVEL 2 PASS 3
      0  588b					      include	"devices.asm"
      1  588b							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  588b							; are in use, and each one in use gets its page on the main menu.
      3  588b							;
      4  588b							; YAMAHA SHS-10 (the keytar)
      5  588b							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  588b							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  588b							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  588b							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  588b							;		     can play at once.)
     10  588b							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  588b							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  588b							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  588b							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  588b							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  588b							;		     louder (the SID and the NES; the Game Boy would click) or
     16  588b							;		     brighter (the SID's filter: switched on if the patch has
     17  588b							;		     none)
     18  588b							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  588b							;		     the patch's, or the ADVANCED amounts if it has none;
     20  588b							;		     FILTER), or an action held while blowing hard
     21  588b							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  588b							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  588b							;   PORTAMENTO BUTTON	an action (CC 65)
     24  588b							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  588b							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  588b							; ATARI SYNTHCART
     27  588b							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  588b							;		     about 3% while held, SHIFT + , . step through the ten
     29  588b							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  588b							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  588b							;		     sound's cents (the Synthcart manual's table: each Atari
     32  588b							;		     sound plays its scales in its own key, a little off)
     33  588b							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  588b
     35  588b		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  588b		       00 28	   BREATH_LO  equ	40
     37  588b		       00 01	   BFX_VIB    equ	1
     38  588b		       00 02	   BFX_WARB   equ	2
     39  588b		       00 03	   BFX_DET    equ	3
     40  588b		       00 04	   BFX_FILT   equ	4
     41  588b		       00 05	   BFX_HELD   equ	5
     42  588b
