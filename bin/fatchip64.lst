------- FILE arp.asm LEVEL 2 PASS 3
      0  1879					      include	"arp.asm"
      1  1879							; Fat Chip 64 - tempo and arpeggiator
      2  1879							;
      3  1879							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1879							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1879							;
      6  1879							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1879							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1879							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1879							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1879							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1879							;	     until its voice's next turn.
     12  1879							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1879							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1879							;   J faster; either one also picks FREE).
     15  1879							;
     16  1879							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1879							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1879
     19  1879							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1879							; between the two bytes: $22FF read as $23FF)
     21  1879				   GetTicks
     22  1879					      subroutine
     23  1879		       08		      php
     24  187a		       78		      sei
     25  187b		       a5 10		      lda	ticks
     26  187d		       8d 3e c3 	      sta	nowL
     27  1880		       a5 11		      lda	ticks+1
     28  1882		       8d 3f c3 	      sta	nowH
     29  1885		       28		      plp
     30  1886		       60		      rts
     31  1887
