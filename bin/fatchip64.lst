      0  4dd4					      include	"menu.asm"
      1  4dd4							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  4dd4							;
      3  4dd4							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  4dd4							;   page   RETURN opens a page
      5  4dd4							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  4dd4							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  4dd4							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  4dd4							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  4dd4							; device pages, until DEVICES says the device is in use).
     10  4dd4							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  4dd4							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  4dd4							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  4dd4
     14  4dd4		       00 17	   MENU_VALCOL equ	23
     15  4dd4
