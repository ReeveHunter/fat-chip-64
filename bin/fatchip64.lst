------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  52a6					      include	"sync.asm"
      1  52a6							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  52a6							;
      3  52a6							; Menu, DEVICE SYNC (defaults first):
      4  52a6							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  52a6							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  52a6							;		     sets the tempo, averaged over beats (the clock jitters about
      7  52a6							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  52a6							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  52a6							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  52a6							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  52a6							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  52a6							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  52a6							;		     picks a beat demo (styleBeat)
     14  52a6							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  52a6							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  52a6							;		     key channel) picks a sound (voiceSound)
     17  52a6							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  52a6							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  52a6							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  52a6							;
     21  52a6							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  52a6							; 1/4 ms); a Start makes the next clock a beat.
     23  52a6
     24  52a6		       00 00	   TEMPO_KEYTAR equ	0
     25  52a6		       00 01	   TEMPO_OWN  equ	1
     26  52a6		       00 02	   TEMPO_SC   equ	2
     27  52a6		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  52a6
     29  52a6
     30  52a6
     31  52a6							; ------------------------------------------------------------ clock
     32  52a6							; Main loop, every pass
