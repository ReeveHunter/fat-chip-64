------- FILE main.asm LEVEL 1 PASS 3
      1  7d9d ????						; Fat Chip 64 - main program
      2  7d9d ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  7d9d ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  7d9d ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  7d9d ????
      6  7d9d ????				      processor	6502
