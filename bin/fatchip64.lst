    458  669e		       ad 55 c8 	      lda	fineTune
    459  66a1		       38		      sec
    460  66a2		       e9 32		      sbc	#50
    461  66a4		       18		      clc
    462  66a5		       7d bb 67 	      adc	scCents,x
    463  66a8		       50 00		      bvc	.c	; (can't overflow: -85..+60)
    464  66aa				   .c
    465  66aa		       cd 56 c8 	      cmp	tuneC
    466  66ad		       f0 1b		      beq	.k
    467  66af		       8d 56 c8 	      sta	tuneC
    468  66b2		       20 e3 66 	      jsr	TuneUnits
    469  66b5		       ae 58 c8 	      ldx	gbTune
    470  66b8		       a9 67		      lda	#GCC_TUNE
    471  66ba		       20 50 0d 	      jsr	GbGlobal
    472  66bd		       a9 08		      lda	#8
    473  66bf		       8d 2e c5 	      sta	nfxRun	; (the NES bends again)
    474  66c2		       a9 00		      lda	#0
    475  66c4		       8d 5d c8 	      sta	vsGlide
    476  66c7		       20 63 3e 	      jsr	SidRetune	; (the SID's notes sounding: there at once)
    477  66ca				   .k
    478  66ca		       ae 54 c8 	      ldx	tuneNow
