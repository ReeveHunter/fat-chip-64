    118  7a31							; VoiceSet, a SID voice let go (X = the voice, Y = SID voice): BEND OUT
    119  7a31				   RelDrop
    120  7a31					      subroutine
    121  7a31		       ad 66 cb 	      lda	sndRdrop
    122  7a34		       f0 26		      beq	.x
