------- FILE main.asm
    540  e7fa				   ioEnd
    541  e7fa					      rend
    542  e7fa				  -	      if	ioEnd > $DE00
    543  e7fa				  -			; (Nmi reads the ACIA at $DE06: if one came while BeatLoad has the I/O
    544  e7fa				  -			;  switched out, it would read and write the RAM there: keep data below)
    545  e7fa				  -	      echo	"the $D000 data runs past $DE00"
    546  e7fa				  -	      err
    547  e7fa					      endif
