      0  614f					      include	"patchedit.asm"
      1  614f							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  614f							; the dice. The settings and their steps come from tools/gen_menu.py
      3  614f							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  614f							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  614f							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  614f							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  614f							; (EnvDerive).
      8  614f
      9  614f		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  614f		       00 30	   LFO_LAST   equ	FLD_gbLDelay
     11  614f
