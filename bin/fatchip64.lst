    165  55c9		       a5 26		      lda	t2
    166  55cb		       38		      sec
    167  55cc		       ed ff c5 	      sbc	clk16L
    168  55cf		       8d be c3 	      sta	exS
    169  55d2		       a5 27		      lda	t3
