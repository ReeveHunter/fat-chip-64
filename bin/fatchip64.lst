------- FILE drums.asm LEVEL 2 PASS 3
      0  3969					      include	"drums.asm"
      1  3969							; Fat Chip 64 - drums on the MidiNES
      2  3969							;
      3  3969							; Two sources, one kit:
      4  3969							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  3969							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  3969							;			   64 = hit, 56 = ghost)
      7  3969							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  3969							;			   RETURN starts / stops it, at its own tempo (B taps
      9  3969							;			   a new one)
     10  3969							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  3969							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  3969							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  3969							; a note-on, then a note-off after the sound's length, the level set with
     14  3969							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  3969							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  3969
     17  3969		       00 0c	   KIT_SIZE   equ	12
     18  3969		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  3969		       00 00	   DK_KICK    equ	0
     20  3969		       00 01	   DK_SNARE   equ	1
     21  3969		       00 02	   DK_CH      equ	2
     22  3969		       00 03	   DK_OH      equ	3
     23  3969		       00 04	   DK_CY      equ	4
     24  3969		       00 05	   DK_TOM     equ	5
     25  3969		       00 06	   DK_PERC    equ	6
     26  3969
     27  3969							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  3969				   DrumHit
     29  3969					      subroutine
     30  3969		       8d 83 c4 	      sta	drumKind
