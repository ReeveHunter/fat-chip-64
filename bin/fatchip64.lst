------- FILE main.asm
------- FILE nesfx.asm LEVEL 2 PASS 3
      0  801c					      include	"nesfx.asm"
      1  801c							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  801c							;
      3  801c							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  801c							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  801c							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  801c							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  801c							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  801c							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  801c							;   glide    a new note starts bent back to the voice's last note and slides
     10  801c							;	      in the way the SID's does (all three channels)
     11  801c							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  801c							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  801c							; semitone, so these are a little stepped.
     14  801c
     15  801c		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  801c							;  (the pulses, and the triangle while it glides)
     17  801c
     18  801c							; A = 1 (not Z) when a NesFxTick step is due
     19  801c				   NesFxDue
     20  801c					      subroutine
     21  801c		       ad 2b c3 	      lda	devOn+DEV_NES
     22  801f		       f0 1c		      beq	.x
     23  8021		       ad 0b c6 	      lda	vibDepth
     24  8024		       0d 39 c5 	      ora	nfxGlide
     25  8027		       0d 3a c5 	      ora	nfxRun
     26  802a		       0d f3 c9 	      ora	nfxWarb
     27  802d		       f0 0e		      beq	.x
     28  802f		       a5 10		      lda	ticks
     29  8031		       38		      sec
     30  8032		       ed 35 c5 	      sbc	nfxLast
     31  8035		       c9 08		      cmp	#NFX_EVERY
     32  8037		       a9 00		      lda	#0
     33  8039		       90 02		      bcc	.x
     34  803b		       a9 01		      lda	#1
     35  803d				   .x
     36  803d		       60		      rts
     37  803e
     38  803e							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     39  803e							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     40  803e							; quick return.
     41  803e				   NesFxTick
     42  803e					      subroutine
     43  803e		       ad 2b c3 	      lda	devOn+DEV_NES
     44  8041		       f0 0e		      beq	.q
     45  8043		       ad 0b c6 	      lda	vibDepth
     46  8046		       0d 39 c5 	      ora	nfxGlide
     47  8049		       0d 3a c5 	      ora	nfxRun
     48  804c		       0d f3 c9 	      ora	nfxWarb
     49  804f		       d0 01		      bne	.on
     50  8051				   .q
     51  8051		       60		      rts
     52  8052				   .on
     53  8052		       a5 10		      lda	ticks
     54  8054		       38		      sec
     55  8055		       ed 35 c5 	      sbc	nfxLast
     56  8058		       c9 08		      cmp	#NFX_EVERY
     57  805a		       b0 01		      bcs	.go
     58  805c		       60		      rts
     59  805d				   .go
     60  805d		       4a		      lsr
     61  805e		       4a		      lsr		; 4 ms steps
     62  805f		       c9 08		      cmp	#8
     63  8061		       90 02		      bcc	.n
     64  8063		       a9 08		      lda	#8
     65  8065				   .n
