------- FILE main.asm LEVEL 1 PASS 3
      1  d58a ????						; Fat Chip 64 - main program
      2  d58a ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  d58a ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  d58a ????						; Build: ./build.sh (dasm makes bin/fatchip64-image.prg; tools/crunch.py packs it
      5  d58a ????						; into bin/fatchip64.prg)
      6  d58a ????
      7  d58a ????				      processor	6502
