    457  6a5f		       aa		      tax
    458  6a60		       ad 61 c8 	      lda	fineTune
    459  6a63		       38		      sec
    460  6a64		       e9 32		      sbc	#50
    461  6a66		       18		      clc
    462  6a67		       7d 7d 6b 	      adc	scCents,x
    463  6a6a		       50 00		      bvc	.c	; (can't overflow: -85..+60)
    464  6a6c				   .c
    465  6a6c		       cd 62 c8 	      cmp	tuneC
    466  6a6f		       f0 1b		      beq	.k
    467  6a71		       8d 62 c8 	      sta	tuneC
    468  6a74		       20 a5 6a 	      jsr	TuneUnits
    469  6a77		       ae 64 c8 	      ldx	gbTune
