    156  0c76		       a5 18		      lda	gbqTail
    157  0c78		       18		      clc
    158  0c79		       69 01		      adc	#1
    159  0c7b		       29 3f		      and	#63
    160  0c7d		       85 18		      sta	gbqTail
    161  0c7f		       a5 10		      lda	ticks
    162  0c81		       18		      clc
    163  0c82		       69 03		      adc	#GB_GAP
    164  0c84		       85 19		      sta	gbNext
    165  0c86				   .nes
    166  0c86		       20 d5 39 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0c89		       a5 1b		      lda	nesqTail
    168  0c8b		       c5 1a		      cmp	nesqHead
    169  0c8d		       f0 37		      beq	.done
    170  0c8f		       a5 1c		      lda	nesNext
    171  0c91		       38		      sec
    172  0c92		       e5 10		      sbc	ticks
    173  0c94		       f0 04		      beq	.nesDue
    174  0c96		       c9 02		      cmp	#NES_GAP+1
