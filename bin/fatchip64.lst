------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  4e02					      include	"sync.asm"
      1  4e02							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  4e02							;
      3  4e02							; Menu, DEVICE SYNC (defaults first):
      4  4e02							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  4e02							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  4e02							;		     sets the tempo, averaged over beats (the clock jitters about
      7  4e02							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  4e02							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  4e02							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  4e02							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  4e02							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  4e02							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  4e02							;		     picks a beat demo (styleBeat)
     14  4e02							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  4e02							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  4e02							;		     key channel) picks a sound (voiceSound)
     17  4e02							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  4e02							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  4e02							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  4e02							;
     21  4e02							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  4e02							; 1/4 ms); a Start makes the next clock a beat.
     23  4e02
     24  4e02		       00 00	   TEMPO_KEYTAR equ	0
     25  4e02		       00 01	   TEMPO_OWN  equ	1
     26  4e02		       00 02	   TEMPO_SC   equ	2
     27  4e02		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  4e02
     29  4e02
     30  4e02
     31  4e02							; ------------------------------------------------------------ clock
     32  4e02							; Main loop, every pass
     33  4e02				   ClockTick
     34  4e02					      subroutine
     35  4e02		       ad e5 c5 	      lda	clkCount	; any clock lately?
     36  4e05		       cd e6 c5 	      cmp	clkCountSeen
     37  4e08		       f0 15		      beq	.alive
     38  4e0a		       8d e6 c5 	      sta	clkCountSeen
     39  4e0d		       20 49 1f 	      jsr	GetTicks
     40  4e10		       ad 3f c3 	      lda	nowL
     41  4e13		       8d e7 c5 	      sta	clkSeenL
     42  4e16		       ad 40 c3 	      lda	nowH
