    196  0a9d							; ------------------------------------------------------------ queueing (main loop)
    197  0a9d							; Message in mS / mD1 / mD2. Dropped if the queue is full (63 messages).
    198  0a9d				   GbPut
    199  0a9d					      subroutine
    200  0a9d							; write the slot at head first (always free: one slot stays empty),
    201  0a9d							; then publish head unless the queue is full. Uses only A and X.
    202  0a9d		       a6 16		      ldx	gbqHead
    203  0a9f		       a5 20		      lda	mS
    204  0aa1		       9d 00 c1 	      sta	gbqS,x
    205  0aa4		       a5 21		      lda	mD1
    206  0aa6		       9d 40 c1 	      sta	gbqD1,x
    207  0aa9		       a5 22		      lda	mD2
    208  0aab		       9d 80 c1 	      sta	gbqD2,x
    209  0aae		       8a		      txa
