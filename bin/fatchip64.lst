------- FILE nesfx.asm LEVEL 2 PASS 3
      0  8c92					      include	"nesfx.asm"
      1  8c92							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  8c92							;
      3  8c92							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  8c92							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  8c92							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  8c92							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  8c92							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  8c92							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  8c92							;   glide    a new note starts bent back to the voice's last note and slides
     10  8c92							;	      in the way the SID's does (all three channels)
     11  8c92							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  8c92							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  8c92							; semitone, so these are a little stepped.
     14  8c92
     15  8c92		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  8c92							;  (the pulses, and the triangle while it glides)
     17  8c92
     18  8c92							; A = 1 (not Z) when a NesFxTick step is due
     19  8c92				   NesFxDue
     20  8c92					      subroutine
     21  8c92		       ad eb c7 	      lda	devOn+DEV_NES
     22  8c95		       f0 1c		      beq	.x
     23  8c97		       ad c9 ca 	      lda	vibDepth
     24  8c9a		       0d f7 c9 	      ora	nfxGlide
     25  8c9d		       0d f8 c9 	      ora	nfxRun
     26  8ca0		       0d b5 ce 	      ora	nfxWarb
     27  8ca3		       f0 0e		      beq	.x
     28  8ca5		       a5 10		      lda	ticks
     29  8ca7		       38		      sec
     30  8ca8		       ed f3 c9 	      sbc	nfxLast
     31  8cab		       c9 08		      cmp	#NFX_EVERY
     32  8cad		       a9 00		      lda	#0
     33  8caf		       90 02		      bcc	.x
     34  8cb1		       a9 01		      lda	#1
     35  8cb3				   .x
     36  8cb3		       60		      rts
     37  8cb4
     38  8cb4							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     39  8cb4							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     40  8cb4							; quick return.
     41  8cb4				   NesFxTick
     42  8cb4					      subroutine
     43  8cb4		       ad eb c7 	      lda	devOn+DEV_NES
     44  8cb7		       f0 0e		      beq	.q
