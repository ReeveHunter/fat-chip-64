------- FILE midiin.asm LEVEL 2 PASS 3
      0  3a61					      include	"midiin.asm"
      1  3a61							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  3a61							;
      3  3a61							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  3a61							; The main loop parses them (running status; realtime and system bytes are
      5  3a61							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  3a61							; notes mode, latch, arp and K + note.
      7  3a61							;
      8  3a61							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  3a61							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  3a61							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  3a61							;
     12  3a61							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  3a61							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  3a61							;
     15  3a61							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  3a61							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  3a61							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  3a61							; MIDI in is passed on to the Game Boy or NES.
     19  3a61
     20  3a61							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  3a61							; Uses A, X.
     22  3a61							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  3a61							; with the time; a Start ($FA) makes the next clock a beat.
     24  3a61				   RxByte
     25  3a61					      subroutine
     26  3a61		       ad 06 de 	      lda	ACIA_STAT
     27  3a64		       4a		      lsr		; RDRF -> carry
     28  3a65		       90 2b		      bcc	.x
     29  3a67				   RxGot
     30  3a67		       ad 07 de 	      lda	ACIA_RX
     31  3a6a		       c9 f8		      cmp	#$F8
     32  3a6c		       f0 25		      beq	.clk
     33  3a6e		       c9 fa		      cmp	#$FA
     34  3a70		       d0 0e		      bne	.buf
     35  3a72		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  3a74		       8e b5 ca 	      stx	clkPhase
     37  3a77		       8e bd ca 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3a7a							;  the main loop could measure it)
     39  3a7a		       ae b6 ca 	      ldx	clkBeat
     40  3a7d		       8e c8 ca 	      stx	clkStartBeat
     41  3a80				   .buf
     42  3a80		       ae f1 c8 	      ldx	rxHead
     43  3a83		       9d b1 c8 	      sta	rxBuf,x
     44  3a86		       e8		      inx
     45  3a87		       8a		      txa
     46  3a88		       29 3f		      and	#63
     47  3a8a		       cd f2 c8 	      cmp	rxTail
     48  3a8d		       f0 03		      beq	.x	; full: dropped
     49  3a8f		       8d f1 c8 	      sta	rxHead
     50  3a92				   .x
     51  3a92		       60		      rts
     52  3a93				   .clk
     53  3a93		       ee b1 ca 	      inc	clkCount
     54  3a96		       ae b5 ca 	      ldx	clkPhase
     55  3a99		       e8		      inx
     56  3a9a		       e0 18		      cpx	#24
     57  3a9c		       90 1b		      bcc	.ph
     58  3a9e		       a5 10		      lda	ticks
     59  3aa0		       8d b8 ca 	      sta	clkAtL
     60  3aa3		       a5 11		      lda	ticks+1
     61  3aa5		       8d b9 ca 	      sta	clkAtH
     62  3aa8		       a5 2d		      lda	subTick
     63  3aaa		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  3aac		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  3aae		       ad 05 dc 	      lda	CIA1_TAHI
     66  3ab1				   .q
