      0  6355					      include	"patchedit.asm"
      1  6355							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  6355							; the dice. The settings and their steps come from tools/gen_menu.py
      3  6355							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  6355							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  6355							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  6355							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  6355							; (EnvDerive).
      8  6355
