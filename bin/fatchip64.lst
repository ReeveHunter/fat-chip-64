------- FILE attack.asm LEVEL 2 PASS 3
      0  721c					      include	"attack.asm"
      1  721c							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  721c							; how each note starts and ends in pitch
      3  721c							;
      4  721c							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  721c							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  721c							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  721c							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  721c							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  721c							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  721c							;   (v0.42) as long as TIME.
     11  721c							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  721c							;   release rings.
     13  721c
     14  721c							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  721c							; jumps to the note
     16  721c				   AtkStep
     17  721c					      subroutine
     18  721c		       ac c3 c3 	      ldy	envY
     19  721f		       b9 6d c9 	      lda	atkT,y
