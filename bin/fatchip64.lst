     44  1d56		       d0 f1		      bne	.nope
     45  1d58		       ad 27 c3 	      lda	devOn+DEV_NES
     46  1d5b		       f0 ec		      beq	.nope
     47  1d5d		       bd 2a 4a 	      lda	vDev,x
     48  1d60		       c9 02		      cmp	#DEV_NES
