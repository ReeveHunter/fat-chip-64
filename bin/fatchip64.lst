------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  5660					      include	"sync.asm"
      1  5660							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  5660							;
      3  5660							; Menu, DEVICE SYNC (defaults first):
      4  5660							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  5660							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  5660							;		     sets the tempo, averaged over beats (the clock jitters about
      7  5660							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  5660							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  5660							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  5660							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  5660							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  5660							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  5660							;		     picks a beat demo (styleBeat)
     14  5660							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  5660							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  5660							;		     key channel) picks a sound (voiceSound)
     17  5660							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  5660							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  5660							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  5660							;
     21  5660							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  5660							; 1/4 ms); a Start makes the next clock a beat.
     23  5660
     24  5660		       00 00	   TEMPO_KEYTAR equ	0
     25  5660		       00 01	   TEMPO_OWN  equ	1
     26  5660		       00 02	   TEMPO_SC   equ	2
     27  5660		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  5660
     29  5660
     30  5660
