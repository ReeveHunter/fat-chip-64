------- FILE main.asm
------- FILE viz.asm LEVEL 2 PASS 3
      0  6e62					      include	"viz.asm"
      1  6e62							; Fat Chip 64 - the visualizer (F7: GLITCH on / off; v0.28 dropped the BARS)
      2  6e62							;
      3  6e62							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
      4  6e62							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
      5  6e62							; keep spattering more; runs of the screen get copied over other places
      6  6e62							; (datamosh) and wiped away, so it fills while you play and dissolves when
      7  6e62							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
      8  6e62							; the background. VINYL STOP drags it down the screen.
      9  6e62
     10  6e62		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     11  6e62		       00 16	   VIZ_NAMES  equ	22	; note names
     12  6e62		       00 a0	   VIZ_FULL   equ	160	; reversed space
     13  6e62		       00 62	   VIZ_HALF   equ	98	; lower half block
     14  6e62
