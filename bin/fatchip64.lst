     95  4624		       10 02		      bpl	.a
     96  4626		       a9 7f		      lda	#127
     97  4628				   .a
     98  4628		       cd 77 c4 	      cmp	dmcBank
     99  462b		       f0 0c		      beq	.note
    100  462d		       8d 77 c4 	      sta	dmcBank
    101  4630		       85 23		      sta	mD2
    102  4632		       a9 0e		      lda	#14
    103  4634		       85 22		      sta	mD1
    104  4636		       20 2e 0d 	      jsr	NesPut
    105  4639				   .note
    106  4639		       a5 21		      lda	mS
    107  463b		       29 0f		      and	#$0F
    108  463d		       85 26		      sta	t2	; channel
    109  463f		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    110  4641							;  cuts it anyway, and the hit lands 1 ms sooner)
    111  4641		       29 7f		      and	#$7F
    112  4643		       8d 84 c4 	      sta	dmcNote
    113  4646		       85 22		      sta	mD1
    114  4648		       a5 26		      lda	t2
    115  464a		       09 90		      ora	#$90
    116  464c		       85 21		      sta	mS
    117  464e		       a9 7f		      lda	#127
    118  4650		       85 23		      sta	mD2
    119  4652		       20 2e 0d 	      jsr	NesPut
    120  4655		       a5 24		      lda	t0
