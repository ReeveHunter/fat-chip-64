     65  7521		       a9 01		      lda	#1
     66  7523		       99 78 c9 	      sta	clickOn,y
     67  7526		       b9 36 c3 	      lda	sidGate,y
     68  7529		       29 01		      and	#1
     69  752b		       09 80		      ora	#$80	; noise
     70  752d		       a6 26		      ldx	t2
     71  752f		       9d 04 d4 	      sta	SID+4,x
     72  7532				   .x
     73  7532		       60		      rts
     74  7533
     75  7533							; VoiceSet, a SID voice's new note (Y = SID voice, t0 = the voice, t3 = a new
     76  7533							; press): BEND IN starts it away from its pitch
     77  7533				   BendIn
     78  7533					      subroutine
     79  7533		       ad a2 c6 	      lda	sndPenv
     80  7536		       f0 36		      beq	.x
     81  7538		       a6 24		      ldx	t0
     82  753a		       ad 54 c4 	      lda	legatoNow
