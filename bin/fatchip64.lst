    403  3148							; A data byte (A) inside a SysEx
    404  3148				   SysexByte
    405  3148					      subroutine
    406  3148		       ae 4d c7 	      ldx	sxPos
    407  314b		       e0 03		      cpx	#3	; the command: 1 a patch, 2 the chips on / off
    408  314d		       d0 0b		      bne	.nc
    409  314f		       c9 02		      cmp	#2
    410  3151		       d0 07		      bne	.nc
