------- FILE main.asm
------- FILE wander.asm LEVEL 2 PASS 3
      0  5bdc					      include	"wander.asm"
      1  5bdc							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  5bdc							;
      3  5bdc							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  5bdc							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  5bdc							;   ATTACK   as always: the new notes start
      6  5bdc							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  5bdc							;	      has none)
      8  5bdc							;   SPLIT    the SID and the bass voices glide, the Game Boy and NES pulses
      9  5bdc							;	      start again
     10  5bdc							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  5bdc							;	      late; some glide, some start again (fade out, come back in)
     12  5bdc							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  5bdc							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  5bdc							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  5bdc							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  5bdc
     17  5bdc		       00 01	   CHG_ATTACK equ	1
     18  5bdc		       00 02	   CHG_GLIDE  equ	2
     19  5bdc		       00 03	   CHG_SPLIT  equ	3
     20  5bdc		       00 04	   CHG_WANDER equ	4
     21  5bdc		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  5bdc
     23  5bdc							; A = the chord change style now (keeps X, Y)
     24  5bdc				   ChgEff
     25  5bdc					      subroutine
     26  5bdc		       ad 58 c8 	      lda	chgMode
     27  5bdf		       d0 0c		      bne	.x
     28  5be1		       ad aa c3 	      lda	effMode
     29  5be4		       c9 03		      cmp	#MODE_DRONE
     30  5be6		       d0 03		      bne	.a
     31  5be8		       a9 04		      lda	#CHG_WANDER
     32  5bea		       60		      rts
     33  5beb				   .a
     34  5beb		       a9 01		      lda	#CHG_ATTACK
     35  5bed				   .x
     36  5bed		       60		      rts
     37  5bee
     38  5bee							; ApplyVoices, voice X changes note: how. A = 0 (Z): change it now (t3,
     39  5bee							; legatoNow, vsGlide set); A = 1: not yet (WANDER). Keeps X.
     40  5bee				   ChgStyle
     41  5bee					      subroutine
