------- FILE nesenv.asm LEVEL 2 PASS 3
      0  23fe					      include	"nesenv.asm"
      1  23fe							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  23fe							;
      3  23fe							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  23fe							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  23fe							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  23fe							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  23fe							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  23fe							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  23fe							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  23fe							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  23fe							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  23fe							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  23fe							; would wrap to a high pitch).
     14  23fe							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  23fe
     16  23fe							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  23fe							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  23fe							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  23fe							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  23fe							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  23fe		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  23fe		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  23fe							; NES channels too, and can't take a bend every 4 ms
     24  23fe		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  23fe		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  23fe
     27  23fe							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  23fe		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  2407		       02 05	   slotVoice  .byte.b	2,5
     30  2409
     31  2409							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  2409							; note keeps sounding for now). X = voice (= t0).
     33  2409				   NesSoftRelease
     34  2409					      subroutine
     35  2409		       4c 0e 24 	      jmp	.go
     36  240c				   .nope
     37  240c		       18		      clc
     38  240d		       60		      rts
     39  240e				   .go
     40  240e		       ad 8f c3 	      lda	muteNow
     41  2411		       0d ca c3 	      ora	hardCut
     42  2414		       d0 f6		      bne	.nope
     43  2416		       ad 27 c3 	      lda	devOn+DEV_NES
     44  2419		       f0 f1		      beq	.nope
