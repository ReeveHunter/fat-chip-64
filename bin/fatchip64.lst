      0  51d1					      include	"patchedit.asm"
      1  51d1							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  51d1							; the dice. The settings and their steps come from tools/gen_menu.py
      3  51d1							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  51d1							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  51d1							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  51d1							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  51d1							; (EnvDerive).
      8  51d1
