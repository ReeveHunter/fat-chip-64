    208  0981				   .noByte
    209  0981		       c6 2c		      dec	subTick
    210  0983		       10 14		      bpl	.out
    211  0985		       a9 02		      lda	#2
    212  0987		       85 2c		      sta	subTick
    213  0989		       98		      tya
    214  098a		       48		      pha
