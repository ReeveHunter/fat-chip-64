------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  5afe					      include	"sync.asm"
      1  5afe							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  5afe							;
      3  5afe							; Menu, DEVICE SYNC (defaults first):
      4  5afe							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  5afe							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  5afe							;		     sets the tempo, averaged over beats (the clock jitters about
      7  5afe							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  5afe							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  5afe							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  5afe							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  5afe							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  5afe							;   RHYTHM BUTTONS  IN ORDER / BY FEEL / IGNORE: its rhythm (Program Change on
     13  5afe							;		     channel 16, the keytar's 00-44) picks beat n (bank n / 5), or
     14  5afe							;		     the beat nearest its style (styleBeat)
     15  5afe							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     16  5afe							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     17  5afe							;		     key channel) picks a sound (voiceSound)
     18  5afe							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     19  5afe							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     20  5afe							;		     127 held, 0 let go), the same list as SPACE (actions below)
     21  5afe							;
     22  5afe							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     23  5afe							; 1/4 ms); a Start makes the next clock a beat.
     24  5afe
     25  5afe		       00 00	   TEMPO_KEYTAR equ	0
     26  5afe		       00 01	   TEMPO_OWN  equ	1
     27  5afe		       00 02	   TEMPO_SC   equ	2
     28  5afe		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     29  5afe
     30  5afe
     31  5afe
     32  5afe							; ------------------------------------------------------------ clock
     33  5afe							; Main loop, every pass
     34  5afe				   ClockTick
