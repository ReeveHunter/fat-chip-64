------- FILE main.asm
------- FILE nesfx.asm LEVEL 2 PASS 3
      0  6ccc					      include	"nesfx.asm"
      1  6ccc							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  6ccc							;
      3  6ccc							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  6ccc							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  6ccc							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  6ccc							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  6ccc							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  6ccc							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  6ccc							;   glide    a new note starts bent back to the voice's last note and slides
     10  6ccc							;	      in the way the SID's does (all three channels)
     11  6ccc							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  6ccc							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  6ccc							; semitone, so these are a little stepped.
     14  6ccc
     15  6ccc		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  6ccc							;  (the pulses, and the triangle while it glides)
     17  6ccc
     18  6ccc							; A = 1 (not Z) when a NesFxTick step is due
     19  6ccc				   NesFxDue
     20  6ccc					      subroutine
     21  6ccc		       ad 27 c3 	      lda	devOn+DEV_NES
     22  6ccf		       f0 19		      beq	.x
     23  6cd1		       ad fe c5 	      lda	vibDepth
     24  6cd4		       0d 2c c5 	      ora	nfxGlide
     25  6cd7		       0d 2d c5 	      ora	nfxRun
     26  6cda		       f0 0e		      beq	.x
     27  6cdc		       a5 10		      lda	ticks
     28  6cde		       38		      sec
     29  6cdf		       ed 28 c5 	      sbc	nfxLast
     30  6ce2		       c9 08		      cmp	#NFX_EVERY
     31  6ce4		       a9 00		      lda	#0
     32  6ce6		       90 02		      bcc	.x
     33  6ce8		       a9 01		      lda	#1
     34  6cea				   .x
     35  6cea		       60		      rts
     36  6ceb
     37  6ceb							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  6ceb							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  6ceb							; quick return.
