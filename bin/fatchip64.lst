------- FILE patchedit.asm LEVEL 2 PASS 3
      0  5a4d					      include	"patchedit.asm"
      1  5a4d							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  5a4d							; the dice. The settings and their steps come from tools/gen_menu.py
      3  5a4d							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  5a4d							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  5a4d							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  5a4d							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  5a4d							; (EnvDerive).
      8  5a4d
      9  5a4d		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  5a4d		       00 30	   LFO_LAST   equ	FLD_gbLDelay
     11  5a4d
     12  5a4d							; X = param -> A = the step the live patch is nearest to
     13  5a4d				   ParamNearest
