------- FILE sync.asm LEVEL 2 PASS 3
      0  48ad					      include	"sync.asm"
      1  48ad							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  48ad							;
      3  48ad							; Menu, DEVICE SYNC (defaults first):
      4  48ad							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  48ad							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  48ad							;		     sets the tempo, averaged over beats (the clock jitters about
      7  48ad							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  48ad							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  48ad							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  48ad							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  48ad							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  48ad							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  48ad							;		     picks a beat demo (styleBeat)
     14  48ad							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  48ad							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  48ad							;		     key channel) picks a sound (voiceSound)
     17  48ad							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  48ad							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  48ad							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  48ad							;
     21  48ad							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  48ad							; 1/4 ms); a Start makes the next clock a beat.
     23  48ad
     24  48ad		       00 00	   TEMPO_KEYTAR equ	0
     25  48ad		       00 01	   TEMPO_OWN  equ	1
     26  48ad		       00 02	   TEMPO_SC   equ	2
     27  48ad		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  48ad
     29  48ad
     30  48ad
     31  48ad							; ------------------------------------------------------------ clock
     32  48ad							; Main loop, every pass
     33  48ad				   ClockTick
     34  48ad					      subroutine
     35  48ad		       ad e4 c5 	      lda	clkCount	; any clock lately?
