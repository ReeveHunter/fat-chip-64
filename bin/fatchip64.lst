------- FILE pads.asm LEVEL 2 PASS 2
      0  1960					      include	"pads.asm"
      1  1960							; Fat Chip 64 - sound: FAT (default) or PADS (V)
      2  1960							;
      3  1960							; PADS, per the brief's ambient pads: some voices swell and glide into each
      4  1960							; chord, others keep sharp defined attacks.
      5  1960							;   SID       slow attack (500 ms), long release (2.4 s), pulse wave with its
      6  1960							;	       width wobbling (each voice its own phase), through a low-pass
      7  1960							;	       filter that sweeps slowly (about 8 s up and down)
      8  1960							;   Game Boy  slow attack and release on pulses + wave, pulse 2 glides
      9  1960							;	       into each new note, deeper warble
     10  1960							;   MidiNES   unchanged: the sharp attacks under the swell
     11  1960
     12  1960				   SoundApply
     13  1960					      subroutine
     14  1960		       a2 02		      ldx	#2
     15  1962				   .v
     16  1962		       bc d1 20 	      ldy	sidOfs,x
     17  1965		       ad 7d c3 	      lda	padSound
     18  1968		       f0 0e		      beq	.fat
     19  196a		       a9 a0		      lda	#$A0	; attack 500 ms, decay -
     20  196c		       99 05 d4 	      sta	SID+5,y
     21  196f		       a9 fb		      lda	#$FB	; sustain 15, release 2.4 s
     22  1971		       99 06 d4 	      sta	SID+6,y
     23  1974		       a9 40		      lda	#$40	; pulse
     24  1976		       d0 16		      bne	.w
     25  1978				   .fat
     26  1978		       a9 19		      lda	#$19
     27  197a		       99 05 d4 	      sta	SID+5,y
     28  197d		       a9 c9		      lda	#$C9
     29  197f		       99 06 d4 	      sta	SID+6,y
     30  1982		       a9 08		      lda	#$08	; pulse width back to 50%
     31  1984		       99 03 d4 	      sta	SID+3,y
     32  1987		       a9 00		      lda	#0
     33  1989		       99 02 d4 	      sta	SID+2,y
     34  198c		       a9 20		      lda	#$20	; saw
     35  198e				   .w
     36  198e		       85 23		      sta	t0
     37  1990		       bd 19 c3 	      lda	sidGate,x
     38  1993		       29 01		      and	#1
     39  1995		       05 23		      ora	t0
     40  1997		       9d 19 c3 	      sta	sidGate,x
     41  199a		       99 04 d4 	      sta	SID+4,y
     42  199d		       ca		      dex
     43  199e		       10 c2		      bpl	.v
     44  19a0		       ad 7d c3 	      lda	padSound
     45  19a3		       f0 11		      beq	.noFilt
