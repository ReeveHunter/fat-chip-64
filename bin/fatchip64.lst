------- FILE midi.asm LEVEL 2 PASS 2
      0  0949					      include	"midi.asm"
      1  0949							; Fat Chip 64 - MIDI out
      2  0949							;
      3  0949							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0949							; at most one message per device onto the wire buffer, no sooner than that
      5  0949							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0949							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0949							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0949							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0949							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0949
     11  0949				   MidiInit
     12  0949					      subroutine
     13  0949		       a9 03		      lda	#ACIA_RESET
     14  094b		       8d 04 de 	      sta	ACIA_CTRL
     15  094e		       a9 16		      lda	#ACIA_MODE
     16  0950		       8d 04 de 	      sta	ACIA_CTRL
     17  0953		       60		      rts
     18  0954
     19  0954							; IRQ: send one wire byte if the ACIA is ready.
     20  0954				   TxByte
     21  0954					      subroutine
     22  0954		       a6 15		      ldx	wireTail
     23  0956		       e4 14		      cpx	wireHead
     24  0958		       f0 0f		      beq	.done
     25  095a		       ad 06 de 	      lda	ACIA_STAT
     26  095d		       29 02		      and	#ACIA_TDRE
     27  095f		       f0 08		      beq	.done
     28  0961		       bd 00 c0 	      lda	wireBuf,x
     29  0964		       8d 05 de 	      sta	ACIA_TX
     30  0967		       e6 15		      inc	wireTail
