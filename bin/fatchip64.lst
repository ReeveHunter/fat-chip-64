------- FILE main.asm
------- FILE repeat.asm LEVEL 2 PASS 3
      0  4a13					      include	"repeat.asm"
      1  4a13							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  4a13							;
      3  4a13							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  4a13							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  4a13							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  4a13							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  4a13							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  4a13							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  4a13							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  4a13							; 3/4 of the time between echoes. The SID doesn't echo.
     11  4a13							;
     12  4a13							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  4a13							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  4a13							; or a keytar button).
     15  4a13							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  4a13							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  4a13
     18  4a13		       00 10	   RP_SLOTS   equ	16
     19  4a13		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  4a13
     21  4a13							; REPEAT is on now?
     22  4a13				   RepeatActive
     23  4a13		       ad 58 c5 	      lda	repeatOn
     24  4a16		       0d b8 c4 	      ora	actCnt+A_REPEAT
     25  4a19		       60		      rts
     26  4a1a
     27  4a1a							; Allocate, after SPARKLE took its pair: the echo voices (vSkip keeps them
     28  4a1a							; out of the chord, vEcho marks them)
     29  4a1a				   RepeatSet
     30  4a1a					      subroutine
     31  4a1a		       a2 08		      ldx	#NUM_VOICES-1
     32  4a1c		       a9 00		      lda	#0
     33  4a1e				   .c
     34  4a1e		       9d 65 c5 	      sta	vEcho,x
     35  4a21		       ca		      dex
     36  4a22		       10 fa		      bpl	.c
     37  4a24		       20 13 4a 	      jsr	RepeatActive
     38  4a27		       f0 56		      beq	.x
