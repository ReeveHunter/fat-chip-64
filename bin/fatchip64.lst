    174  399a		       c9 c0		      cmp	#$C0
    175  399c		       d0 03		      bne	.pb
    176  399e		       4c 88 56 	      jmp	KeytarVoice	; its voice buttons
    177  39a1				   .pb
    178  39a1		       c9 d0		      cmp	#$D0
