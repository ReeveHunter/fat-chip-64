------- FILE main.asm
------- FILE attack.asm LEVEL 2 PASS 3
      0  6961					      include	"attack.asm"
      1  6961							; Fat Chip 64 - ATTACK, BEND IN, BEND OUT (v0.30): how each note starts and
      2  6961							; ends in pitch
      3  6961							;
      4  6961							; ATTACK (the SID): BLIP: an octave up for one BLIP STEP, then the note
      5  6961							;   (OCTAVE + 5TH: an octave, a fifth, the note; 2 OCTAVES: two up, one up,
      6  6961							;   the note); CLICK: the first 20 ms as noise.
      7  6961							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      8  6961							;   a scoop) and bends to its pitch over TIME: the SID and NES slide it (the
      9  6961							;   SID per voice, the NES with its glide), the Game Boy has its own pitch
     10  6961							;   envelope (CC 80 / 81).
     11  6961							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  6961							;   release rings.
     13  6961
     14  6961							; SidFxs pitch loop, SID voice envY: ATTACK's clock; the CLICK ends
     15  6961				   AtkStep
     16  6961					      subroutine
     17  6961		       ac c2 c3 	      ldy	envY
     18  6964		       b9 5e c9 	      lda	atkT,y
     19  6967		       18		      clc
     20  6968		       6d 51 c4 	      adc	fxN
     21  696b		       90 02		      bcc	.t
     22  696d		       a9 ff		      lda	#255
     23  696f				   .t
     24  696f		       99 5e c9 	      sta	atkT,y
     25  6972		       b9 61 c9 	      lda	clickOn,y
