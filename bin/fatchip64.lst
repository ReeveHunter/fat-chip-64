    117  80c8		       e0 09		      cpx	#NUM_VOICES
    118  80ca		       90 02		      bcc	.nv
    119  80cc		       a2 02		      ldx	#2
    120  80ce				   .nv
    121  80ce		       e0 08		      cpx	#8	; the triangle only while it glides or is bent
    122  80d0		       d0 10		      bne	.t
    123  80d2		       bd d0 c4 	      lda	nesGlL,x
    124  80d5		       1d d9 c4 	      ora	nesGlH,x
    125  80d8		       1d fd c4 	      ora	nesBent,x
    126  80db		       1d 85 c9 	      ora	nesRd,x
    127  80de		       d0 02		      bne	.t
    128  80e0		       a2 02		      ldx	#2
    129  80e2				   .t
    130  80e2		       8e 36 c5 	      stx	nfxV
    131  80e5		       86 24		      stx	t0
    132  80e7		       bd 9f c3 	      lda	vOut,x
    133  80ea		       c9 ff		      cmp	#NO_NOTE
    134  80ec		       f0 20		      beq	.x
    135  80ee		       20 76 82 	      jsr	NesFxVal
    136  80f1		       a6 24		      ldx	t0
    137  80f3		       ad 3f c5 	      lda	nfxL
    138  80f6		       dd eb c4 	      cmp	nesFxSL,x
    139  80f9		       d0 08		      bne	.send
    140  80fb		       ad 40 c5 	      lda	nfxH
    141  80fe		       dd f4 c4 	      cmp	nesFxSH,x
    142  8101		       f0 0b		      beq	.x
    143  8103				   .send
    144  8103		       a9 01		      lda	#1
    145  8105		       8d 37 c5 	      sta	nfxHave	; (NesBendVoice: nfx is this voice's already)
    146  8108		       bd 9f c3 	      lda	vOut,x
    147  810b		       4c 87 36 	      jmp	NesBendVoice
    148  810e				   .x
    149  810e		       60		      rts
    150  810f
    151  810f							; voice X's glide offset closer to 0: by off / 2^glideK for each 4 ms step
    152  810f							; (worked out once: d = off >> k, off -= d x n; past 0 or nothing left to
    153  810f							; move by: there). Keeps X.
    154  810f				   NesGlideStep
    155  810f					      subroutine
    156  810f		       bd d0 c4 	      lda	nesGlL,x
    157  8112		       1d d9 c4 	      ora	nesGlH,x
    158  8115		       d0 01		      bne	.go
    159  8117		       60		      rts
    160  8118				   .go
    161  8118		       bd 7c c9 	      lda	nesK,x
    162  811b		       c9 ff		      cmp	#$FF	; (v0.41: BEND IN STEP: held for TIME, then the note)
    163  811d		       d0 0c		      bne	.slide
    164  811f		       bd e2 c4 	      lda	nesVT,x
    165  8122		       cd a0 c6 	      cmp	sndStepT
    166  8125		       b0 01		      bcs	.jump
    167  8127		       60		      rts
    168  8128				   .jump
    169  8128		       4c bb 81 	      jmp	.snap
    170  812b				   .slide
    171  812b		       bd d0 c4 	      lda	nesGlL,x
