      0  67e1					      include	"patchedit.asm"
      1  67e1							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  67e1							; the dice. The settings and their steps come from tools/gen_menu.py
      3  67e1							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  67e1							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  67e1							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  67e1							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  67e1							; (EnvDerive).
