------- FILE main.asm LEVEL 1 PASS 3
      1  7e88 ????						; Fat Chip 64 - main program
      2  7e88 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  7e88 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  7e88 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  7e88 ????
      6  7e88 ????				      processor	6502
