------- FILE patchedit.asm LEVEL 2 PASS 3
      0  5f79					      include	"patchedit.asm"
      1  5f79							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  5f79							; the dice. The settings and their steps come from tools/gen_menu.py
      3  5f79							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  5f79							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  5f79							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  5f79							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  5f79							; (EnvDerive).
      8  5f79
      9  5f79		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  5f79		       00 30	   LFO_LAST   equ	FLD_gbLDelay
     11  5f79
     12  5f79							; X = param -> A = the step the live patch is nearest to
     13  5f79				   ParamNearest
     14  5f79					      subroutine
     15  5f79		       8e 20 c8 	      stx	pnP
     16  5f7c		       bc 79 9c 	      ldy	prKey,x
     17  5f7f		       b9 4d c6 	      lda	livePatch,y
     18  5f82		       3d dd 9c 	      and	prKeyM,x
     19  5f85		       8d 24 c8 	      sta	pnVL
     20  5f88		       a9 00		      lda	#0
