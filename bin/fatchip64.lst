      1  2b6f							; Fat Chip 64 - drums on the MidiNES
      2  2b6f							;
      3  2b6f							; Two sources, one kit:
      4  2b6f							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  2b6f							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  2b6f							;			   64 = hit, 56 = ghost)
      7  2b6f							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  2b6f							;			   RETURN starts / stops it, at its own tempo (B taps
      9  2b6f							;			   a new one)
     10  2b6f							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  2b6f							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  2b6f							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  2b6f							; a note-on, then a note-off after the sound's length, the level set with
     14  2b6f							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  2b6f							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  2b6f
     17  2b6f		       00 0c	   KIT_SIZE   equ	12
     18  2b6f		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  2b6f		       00 00	   DK_KICK    equ	0
     20  2b6f		       00 01	   DK_SNARE   equ	1
     21  2b6f		       00 02	   DK_CH      equ	2
     22  2b6f		       00 03	   DK_OH      equ	3
     23  2b6f		       00 04	   DK_CY      equ	4
     24  2b6f		       00 05	   DK_TOM     equ	5
     25  2b6f		       00 06	   DK_PERC    equ	6
     26  2b6f
     27  2b6f							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  2b6f				   DrumHit
     29  2b6f					      subroutine
     30  2b6f		       8d 83 c4 	      sta	drumKind
     31  2b72		       8e 82 c4 	      stx	drumLvl
     32  2b75		       8c 84 c4 	      sty	drumTom
     33  2b78		       ad 27 c3 	      lda	devOn+DEV_NES
     34  2b7b		       d0 01		      bne	.on
     35  2b7d		       60		      rts
     36  2b7e				   .on
     37  2b7e		       20 1b 18 	      jsr	GetTicks
     38  2b81		       ad 83 c4 	      lda	drumKind
     39  2b84		       c9 02		      cmp	#DK_CH
     40  2b86		       90 07		      bcc	.dmc
     41  2b88		       c9 05		      cmp	#DK_TOM
     42  2b8a		       b0 03		      bcs	.dmc
     43  2b8c		       4c 41 2c 	      jmp	NoiseHit
     44  2b8f				   .dmc
     45  2b8f		       ae 83 c4 	      ldx	drumKind
     46  2b92		       bd 28 2c 	      lda	dmcPrioT,x
     47  2b95		       85 24		      sta	t0
     48  2b97		       ad 3e c3 	      lda	nowL
     49  2b9a		       38		      sec
     50  2b9b		       ed 7a c4 	      sbc	dmcAt
     51  2b9e		       a8		      tay
     52  2b9f		       ad 3f c3 	      lda	nowH
     53  2ba2		       ed 7b c4 	      sbc	dmcAt+1
     54  2ba5		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     55  2ba7		       c0 0c		      cpy	#DRUM_WINDOW
     56  2ba9		       b0 08		      bcs	.ok
     57  2bab		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     58  2bad		       cd 79 c4 	      cmp	dmcPrio
     59  2bb0		       90 01		      bcc	.ok
     60  2bb2		       60		      rts
     61  2bb3				   .ok
     62  2bb3							; the sample: kit[beat][kitOfs[kind] + level, or + tom]
     63  2bb3		       ae 83 c4 	      ldx	drumKind
     64  2bb6		       bd 2f 2c 	      lda	kitOfs,x
     65  2bb9		       e0 05		      cpx	#DK_TOM
     66  2bbb		       d0 07		      bne	.lv
     67  2bbd		       18		      clc
     68  2bbe		       6d 84 c4 	      adc	drumTom
     69  2bc1		       4c c8 2b 	      jmp	.k
     70  2bc4				   .lv
     71  2bc4		       18		      clc
     72  2bc5		       6d 82 c4 	      adc	drumLvl
     73  2bc8				   .k
     74  2bc8		       85 25		      sta	t1
     75  2bca		       ad 6e c4 	      lda	beatSel	; x 12
     76  2bcd		       0a		      asl
     77  2bce		       0a		      asl
     78  2bcf		       85 26		      sta	t2
     79  2bd1		       0a		      asl
     80  2bd2		       65 26		      adc	t2
     81  2bd4		       65 25		      adc	t1
     82  2bd6		       aa		      tax
     83  2bd7		       bd 6e 43 	      lda	kits,x
     84  2bda		       85 25		      sta	t1
     85  2bdc							; bank (CC14 on the sample channel) when it changes
     86  2bdc		       a9 04		      lda	#4
     87  2bde		       20 36 2c 	      jsr	NesChStatus	; mS = CC, sample channel
     88  2be1		       a9 00		      lda	#0
     89  2be3		       a6 25		      ldx	t1
     90  2be5		       10 02		      bpl	.a
     91  2be7		       a9 7f		      lda	#127
     92  2be9				   .a
     93  2be9		       cd 78 c4 	      cmp	dmcBank
     94  2bec		       f0 0c		      beq	.note
     95  2bee		       8d 78 c4 	      sta	dmcBank
     96  2bf1		       85 23		      sta	mD2
     97  2bf3		       a9 0e		      lda	#14
     98  2bf5		       85 22		      sta	mD1
     99  2bf7		       20 6e 0b 	      jsr	NesPut
    100  2bfa				   .note
    101  2bfa		       a5 21		      lda	mS
    102  2bfc		       29 0f		      and	#$0F
    103  2bfe		       85 26		      sta	t2	; channel
    104  2c00		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    105  2c02							;  cuts it anyway, and the hit lands 1 ms sooner)
    106  2c02		       29 7f		      and	#$7F
    107  2c04		       8d 85 c4 	      sta	dmcNote
    108  2c07		       85 22		      sta	mD1
    109  2c09		       a5 26		      lda	t2
    110  2c0b		       09 90		      ora	#$90
    111  2c0d		       85 21		      sta	mS
    112  2c0f		       a9 7f		      lda	#127
    113  2c11		       85 23		      sta	mD2
    114  2c13		       20 6e 0b 	      jsr	NesPut
    115  2c16		       a5 24		      lda	t0
    116  2c18		       8d 79 c4 	      sta	dmcPrio
    117  2c1b		       ad 3e c3 	      lda	nowL
    118  2c1e		       8d 7a c4 	      sta	dmcAt
    119  2c21		       ad 3f c3 	      lda	nowH
    120  2c24		       8d 7b c4 	      sta	dmcAt+1
    121  2c27		       60		      rts
    122  2c28
    123  2c28		       00 01 00 00*dmcPrioT   .byte.b	0,1,0,0,0,2,3	; kick, snare, -, -, -, tom, perc
    124  2c2f		       00 03 00 00*kitOfs     .byte.b	0,3,0,0,0,6,9
    125  2c36
    126  2c36							; mS = control change on MidiNES channel nesBase + A
    127  2c36				   NesChStatus
    128  2c36					      subroutine
    129  2c36		       18		      clc
    130  2c37		       6d 29 c3 	      adc	nesBase
    131  2c3a		       29 0f		      and	#15
    132  2c3c		       09 b0		      ora	#$B0
    133  2c3e		       85 21		      sta	mS
    134  2c40		       60		      rts
    135  2c41
    136  2c41							; hats and cymbals: NES noise (one at a time; cymbal > open > closed)
    137  2c41				   NoiseHit
    138  2c41					      subroutine
    139  2c41		       ad 83 c4 	      lda	drumKind
    140  2c44		       38		      sec
    141  2c45		       e9 02		      sbc	#DK_CH
    142  2c47		       85 24		      sta	t0	; 0 closed, 1 open, 2 cymbal
    143  2c49		       a9 02		      lda	#2
    144  2c4b		       38		      sec
    145  2c4c		       e5 24		      sbc	t0
    146  2c4e		       85 27		      sta	t3	; priority (0 = most important)
    147  2c50		       ad 3e c3 	      lda	nowL
    148  2c53		       38		      sec
    149  2c54		       ed 7d c4 	      sbc	nzAt
    150  2c57		       a8		      tay
    151  2c58		       ad 3f c3 	      lda	nowH
    152  2c5b		       ed 7e c4 	      sbc	nzAt+1
    153  2c5e		       d0 0c		      bne	.ok
    154  2c60		       c0 0c		      cpy	#DRUM_WINDOW
    155  2c62		       b0 08		      bcs	.ok
    156  2c64		       a5 27		      lda	t3
    157  2c66		       cd 7c c4 	      cmp	nzPrio
    158  2c69		       90 01		      bcc	.ok
    159  2c6b		       60		      rts
    160  2c6c				   .ok
    161  2c6c		       a5 24		      lda	t0	; preset = sound x 3 + level
    162  2c6e		       0a		      asl
    163  2c6f		       65 24		      adc	t0
    164  2c71		       6d 82 c4 	      adc	drumLvl
    165  2c74		       aa		      tax
    166  2c75		       bd 3f 2d 	      lda	nzNoteT,x
    167  2c78		       85 25		      sta	t1
    168  2c7a		       bd 48 2d 	      lda	nzVolT,x
    169  2c7d		       85 26		      sta	t2
    170  2c7f		       bd 51 2d 	      lda	nzLenT,x
    171  2c82		       8d 87 c4 	      sta	nzLen
    172  2c85		       a5 24		      lda	t0
    173  2c87		       d0 2f		      bne	.send
    174  2c89							; closed hats: a third of the time a neighbouring noise note, a third
    175  2c89							; of the time a level up or down
    176  2c89		       20 fd 1b 	      jsr	Random
    177  2c8c		       8d 84 c4 	      sta	drumTom
    178  2c8f		       29 03		      and	#3
    179  2c91		       f0 25		      beq	.send
    180  2c93		       c9 01		      cmp	#1
    181  2c95		       d0 04		      bne	.nd
    182  2c97		       e6 25		      inc	t1
    183  2c99		       d0 06		      bne	.lv
    184  2c9b				   .nd
    185  2c9b		       c9 02		      cmp	#2
    186  2c9d		       d0 02		      bne	.lv
    187  2c9f		       c6 25		      dec	t1
    188  2ca1				   .lv
    189  2ca1		       ad 84 c4 	      lda	drumTom
    190  2ca4		       4a		      lsr
    191  2ca5		       4a		      lsr
    192  2ca6		       29 03		      and	#3
    193  2ca8		       f0 0e		      beq	.send
    194  2caa		       c9 01		      cmp	#1
    195  2cac		       d0 04		      bne	.vd
    196  2cae		       e6 26		      inc	t2
    197  2cb0		       d0 06		      bne	.send
    198  2cb2				   .vd
    199  2cb2		       c9 02		      cmp	#2
    200  2cb4		       d0 02		      bne	.send
    201  2cb6		       c6 26		      dec	t2
    202  2cb8				   .send
    203  2cb8		       a9 03		      lda	#3
    204  2cba		       20 36 2c 	      jsr	NesChStatus
    205  2cbd		       a5 21		      lda	mS
    206  2cbf		       29 0f		      and	#$0F
    207  2cc1		       8d 83 c4 	      sta	drumKind	; (channel; the kind isn't needed any more)
    208  2cc4		       ad 7f c4 	      lda	nzNote	; the last noise note off
    209  2cc7		       c9 ff		      cmp	#$FF
    210  2cc9		       f0 10		      beq	.vol
    211  2ccb		       85 22		      sta	mD1
    212  2ccd		       ad 83 c4 	      lda	drumKind
    213  2cd0		       09 80		      ora	#$80
    214  2cd2		       85 21		      sta	mS
    215  2cd4		       a9 00		      lda	#0
    216  2cd6		       85 23		      sta	mD2
    217  2cd8		       20 6e 0b 	      jsr	NesPut
    218  2cdb				   .vol
    219  2cdb		       a5 26		      lda	t2	; level: CC7 = level x 8, when it changes
    220  2cdd		       cd 86 c4 	      cmp	nzVol
    221  2ce0		       f0 16		      beq	.on
    222  2ce2		       8d 86 c4 	      sta	nzVol
    223  2ce5		       0a		      asl
    224  2ce6		       0a		      asl
    225  2ce7		       0a		      asl
    226  2ce8		       85 23		      sta	mD2
    227  2cea		       a9 07		      lda	#7
    228  2cec		       85 22		      sta	mD1
    229  2cee		       ad 83 c4 	      lda	drumKind
    230  2cf1		       09 b0		      ora	#$B0
    231  2cf3		       85 21		      sta	mS
    232  2cf5		       20 6e 0b 	      jsr	NesPut
    233  2cf8				   .on
    234  2cf8		       a5 25		      lda	t1
    235  2cfa		       8d 7f c4 	      sta	nzNote
    236  2cfd		       85 22		      sta	mD1
    237  2cff		       ad 83 c4 	      lda	drumKind
    238  2d02		       09 90		      ora	#$90
    239  2d04		       85 21		      sta	mS
    240  2d06		       a9 7f		      lda	#127
    241  2d08		       85 23		      sta	mD2
    242  2d0a		       20 6e 0b 	      jsr	NesPut
    243  2d0d							; it stops after its length (4 ms units)
    244  2d0d		       ad 87 c4 	      lda	nzLen
    245  2d10		       0a		      asl
