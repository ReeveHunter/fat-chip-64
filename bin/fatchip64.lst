     99  74c9		       ad a3 c6 	      lda	sndPenvK
    100  74cc		       ae 9f c6 	      ldx	sndStep
    101  74cf		       f0 02		      beq	.k
    102  74d1		       a9 ff		      lda	#$FF	; (STEP: held; AtkStep jumps)
    103  74d3				   .k
    104  74d3		       99 6e c9 	      sta	sK,y
    105  74d6				   .x
    106  74d6		       60		      rts
