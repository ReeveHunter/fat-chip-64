    175  7e96		       bc 70 c9 	      ldy	nesK,x	; (BEND IN: its own)
    176  7e99		       d0 07		      bne	.sh
    177  7e9b		       ac 04 c6 	      ldy	glideK
    178  7e9e		       d0 02		      bne	.sh
    179  7ea0		       a0 02		      ldy	#2	; (glide switched off mid-slide: finish quickly)
    180  7ea2				   .sh
    181  7ea2		       ad 34 c5 	      lda	nfxH
