     89  480f		       85 25		      sta	t1
     90  4811							; bank (CC14 on the sample channel) when it changes
     91  4811		       a9 04		      lda	#4
     92  4813		       20 6b 48 	      jsr	NesChStatus	; mS = CC, sample channel
     93  4816		       a9 00		      lda	#0
