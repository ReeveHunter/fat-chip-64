    119  2f89		       29 e0		      and	#$E0
    120  2f8b		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
    121  2f8d		       d0 a7		      bne	.next
    122  2f8f		       a9 00		      lda	#0
    123  2f91		       8d 27 c4 	      sta	rxCnt
    124  2f94		       20 bc 2f 	      jsr	MidiInMsg
    125  2f97		       4c 36 2f 	      jmp	.next
    126  2f9a				   .rt
    127  2f9a		       c9 fa		      cmp	#$FA
    128  2f9c		       d0 06		      bne	.rt2
    129  2f9e		       20 81 49 	      jsr	KeytarStart
    130  2fa1		       4c 36 2f 	      jmp	.next
    131  2fa4				   .rt2
    132  2fa4		       c9 fc		      cmp	#$FC
    133  2fa6		       d0 03		      bne	.rt3
    134  2fa8		       20 a2 49 	      jsr	KeytarStop
    135  2fab				   .rt3
    136  2fab		       4c 36 2f 	      jmp	.next
    137  2fae				   .second
    138  2fae		       8d 29 c4 	      sta	rxD2
    139  2fb1		       a9 00		      lda	#0
    140  2fb3		       8d 27 c4 	      sta	rxCnt
    141  2fb6		       20 bc 2f 	      jsr	MidiInMsg
    142  2fb9		       4c 36 2f 	      jmp	.next
