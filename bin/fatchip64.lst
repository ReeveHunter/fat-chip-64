    103  1d35		       10 e5		      bpl	.s
    104  1d37		       ad 46 c3 	      lda	tapN
    105  1d3a		       8d 52 c3 	      sta	dvsL
    106  1d3d		       a9 00		      lda	#0
    107  1d3f		       8d 53 c3 	      sta	dvsH
    108  1d42		       20 68 1e 	      jsr	Div16
    109  1d45		       ad 50 c3 	      lda	dvdL
    110  1d48		       8d 41 c3 	      sta	beatMs
