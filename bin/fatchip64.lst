     51  7265		       99 e2 c3 	      sta	sidBaseLo,y
     52  7268		       b9 63 c4 	      lda	sidTgtHi,y
     53  726b		       99 e5 c3 	      sta	sidBaseHi,y
     54  726e		       a9 00		      lda	#0
     55  7270		       99 66 c9 	      sta	sK,y
     56  7273				   .x
     57  7273		       60		      rts
