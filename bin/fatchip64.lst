     43  281e		       ad 27 c3 	      lda	devOn+DEV_NES
     44  2821		       f0 f1		      beq	.nope
     45  2823		       bd 5e 7e 	      lda	vDev,x
     46  2826		       c9 02		      cmp	#DEV_NES
     47  2828		       d0 ea		      bne	.nope
     48  282a		       bd 97 c3 	      lda	vOut,x
     49  282d		       c9 ff		      cmp	#NO_NOTE
     50  282f		       f0 e3		      beq	.nope
     51  2831		       ad 47 c4 	      lda	nesEnvOn
     52  2834		       f0 78		      beq	.fo	; (no envelope: BEND OUT's fall-off, if any)
     53  2836		       bc 06 28 	      ldy	vEnvSlot,x
     54  2839		       30 41		      bmi	.tri
     55  283b							; pulse: release from the current level; step = level x factor / 4 + 1
     56  283b							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  283b							; about 2 s). Factor 0: no release, cut.
