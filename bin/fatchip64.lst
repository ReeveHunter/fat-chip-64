------- FILE attack.asm LEVEL 2 PASS 3
      0  7a0b					      include	"attack.asm"
      1  7a0b							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  7a0b							; how each note starts and ends in pitch
      3  7a0b							;
      4  7a0b							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  7a0b							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  7a0b							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  7a0b							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  7a0b							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  7a0b							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  7a0b							;   (v0.42) as long as TIME.
     11  7a0b							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  7a0b							;   release rings.
     13  7a0b
     14  7a0b							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  7a0b							; jumps to the note
     16  7a0b				   AtkStep
     17  7a0b					      subroutine
     18  7a0b		       ac 8b c8 	      ldy	envY
