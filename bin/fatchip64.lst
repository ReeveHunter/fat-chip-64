    119  3afd		       29 e0		      and	#$E0
    120  3aff		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
    121  3b01		       d0 a7		      bne	.next
    122  3b03		       a9 00		      lda	#0
    123  3b05		       8d 34 c8 	      sta	rxCnt
    124  3b08		       20 30 3b 	      jsr	MidiInMsg
    125  3b0b		       4c aa 3a 	      jmp	.next
    126  3b0e				   .rt
    127  3b0e		       c9 fa		      cmp	#$FA
    128  3b10		       d0 06		      bne	.rt2
    129  3b12		       20 7b 5d 	      jsr	KeytarStart
    130  3b15		       4c aa 3a 	      jmp	.next
    131  3b18				   .rt2
    132  3b18		       c9 fc		      cmp	#$FC
    133  3b1a		       d0 03		      bne	.rt3
    134  3b1c		       20 9c 5d 	      jsr	KeytarStop
    135  3b1f				   .rt3
    136  3b1f		       4c aa 3a 	      jmp	.next
    137  3b22				   .second
    138  3b22		       8d 36 c8 	      sta	rxD2
    139  3b25		       a9 00		      lda	#0
    140  3b27		       8d 34 c8 	      sta	rxCnt
    141  3b2a		       20 30 3b 	      jsr	MidiInMsg
    142  3b2d		       4c aa 3a 	      jmp	.next
