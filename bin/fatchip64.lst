    144  3962							; A full message: rxStatus, rxD1, rxD2
    145  3962				   MidiInMsg
    146  3962					      subroutine
    147  3962		       ad 2b c4 	      lda	rxStatus
    148  3965		       29 0f		      and	#15
    149  3967		       c9 0f		      cmp	#DRUM_CH_IN	; channel 16: the keytar's rhythm
    150  3969		       d0 1d		      bne	.notes
    151  396b		       ad 2b c4 	      lda	rxStatus
    152  396e		       29 f0		      and	#$F0
    153  3970		       c9 c0		      cmp	#$C0
    154  3972		       d0 03		      bne	.dr
