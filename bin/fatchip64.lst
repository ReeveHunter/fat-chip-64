    102  0c08
    103  0c08							; IRQ: pace device queues onto the wire.
    104  0c08							;
    105  0c08							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0c08							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0c08							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0c08							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0c08							;
    110  0c08							; When the Game Boy is on, everything on the wire also passes through the
    111  0c08							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0c08							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0c08							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0c08							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0c08							; message, the rate measured clean.
    116  0c08				   Schedule
    117  0c08					      subroutine
    118  0c08		       ad 26 c3 	      lda	devOn+DEV_GB
    119  0c0b		       f0 10		      beq	.gb
    120  0c0d		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0c0f		       f0 0c		      beq	.gb
    122  0c11		       c6 2e		      dec	linkLoad
    123  0c13		       f0 08		      beq	.gb
    124  0c15		       a5 10		      lda	ticks
    125  0c17		       29 01		      and	#1
    126  0c19		       f0 02		      beq	.gb
    127  0c1b		       c6 2e		      dec	linkLoad
    128  0c1d				   .gb
    129  0c1d							; ---- Game Boy
    130  0c1d		       a5 18		      lda	gbqTail
    131  0c1f		       c5 17		      cmp	gbqHead
    132  0c21		       f0 36		      beq	.nes
    133  0c23		       a5 19		      lda	gbNext
    134  0c25		       38		      sec
    135  0c26		       e5 10		      sbc	ticks
    136  0c28		       f0 04		      beq	.gbDue
    137  0c2a		       c9 04		      cmp	#GB_GAP+1
    138  0c2c		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0c2e				   .gbDue
    140  0c2e							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0c2e							; bytes already waiting would otherwise delay this one and squeeze it
    142  0c2e							; against the next). While a Game Boy message is due, the NES doesn't
    143  0c2e							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0c2e							; holding its notes back.
    145  0c2e		       a5 15		      lda	wireHead
    146  0c30		       c5 16		      cmp	wireTail
    147  0c32		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0c34		       20 9a 0c 	      jsr	LinkRoom
    149  0c37		       90 20		      bcc	.nes
    150  0c39		       a6 18		      ldx	gbqTail
    151  0c3b		       bd 00 c1 	      lda	gbqS,x
    152  0c3e		       bc 80 c1 	      ldy	gbqD2,x
    153  0c41		       84 2c		      sty	irqT
    154  0c43		       bc 40 c1 	      ldy	gbqD1,x
    155  0c46		       20 b6 0c 	      jsr	WireMsg
    156  0c49		       a5 18		      lda	gbqTail
    157  0c4b		       18		      clc
    158  0c4c		       69 01		      adc	#1
    159  0c4e		       29 3f		      and	#63
    160  0c50		       85 18		      sta	gbqTail
    161  0c52		       a5 10		      lda	ticks
    162  0c54		       18		      clc
    163  0c55		       69 03		      adc	#GB_GAP
    164  0c57		       85 19		      sta	gbNext
    165  0c59				   .nes
    166  0c59		       20 8e 30 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0c5c		       a5 1b		      lda	nesqTail
    168  0c5e		       c5 1a		      cmp	nesqHead
    169  0c60		       f0 37		      beq	.done
    170  0c62		       a5 1c		      lda	nesNext
    171  0c64		       38		      sec
    172  0c65		       e5 10		      sbc	ticks
    173  0c67		       f0 04		      beq	.nesDue
    174  0c69		       c9 02		      cmp	#NES_GAP+1
    175  0c6b		       90 2c		      bcc	.done
    176  0c6d				   .nesDue
    177  0c6d		       20 ad 0c 	      jsr	WireFree
    178  0c70		       c9 03		      cmp	#3
    179  0c72		       90 25		      bcc	.done
    180  0c74		       20 9a 0c 	      jsr	LinkRoom
    181  0c77		       90 20		      bcc	.done
    182  0c79		       a6 1b		      ldx	nesqTail
    183  0c7b		       bd c0 c1 	      lda	nesqS,x
    184  0c7e		       bc 40 c2 	      ldy	nesqD2,x
    185  0c81		       84 2c		      sty	irqT
    186  0c83		       bc 00 c2 	      ldy	nesqD1,x
    187  0c86		       20 b6 0c 	      jsr	WireMsg
    188  0c89		       a5 1b		      lda	nesqTail
    189  0c8b		       18		      clc
    190  0c8c		       69 01		      adc	#1
    191  0c8e		       29 3f		      and	#63
    192  0c90		       85 1b		      sta	nesqTail
    193  0c92		       a5 10		      lda	ticks
    194  0c94		       18		      clc
    195  0c95		       69 01		      adc	#NES_GAP
    196  0c97		       85 1c		      sta	nesNext
    197  0c99				   .done
    198  0c99		       60		      rts
