     91  7a00		       30 0c		      bmi	.dn
     92  7a02		       18		      clc
     93  7a03		       7d ce c7 	      adc	vWant,x
     94  7a06		       c9 74		      cmp	#116
     95  7a08		       90 0c		      bcc	.ok
     96  7a0a		       a9 73		      lda	#115
     97  7a0c		       d0 08		      bne	.ok
     98  7a0e				   .dn
     99  7a0e		       18		      clc
    100  7a0f		       7d ce c7 	      adc	vWant,x
    101  7a12		       b0 02		      bcs	.ok	; (no borrow: 0 or more)
    102  7a14		       a9 00		      lda	#0
    103  7a16				   .ok
    104  7a16		       20 ea 21 	      jsr	SidPitch	; -> ptr
    105  7a19		       a5 28		      lda	ptr
    106  7a1b		       99 aa c8 	      sta	sidBaseLo,y
    107  7a1e		       a5 29		      lda	ptr+1
    108  7a20		       99 ad c8 	      sta	sidBaseHi,y
    109  7a23		       ad 63 cb 	      lda	sndPenvK
    110  7a26		       ae 5f cb 	      ldx	sndStep
    111  7a29		       f0 02		      beq	.k
    112  7a2b		       a9 ff		      lda	#$FF	; (STEP: held; AtkStep jumps)
    113  7a2d				   .k
    114  7a2d		       99 2e ce 	      sta	sK,y
    115  7a30				   .x
    116  7a30		       60		      rts
