    318  0d69							; CC 123 (all notes off) on the Game Boy's three note channels
    319  0d69				   GbAllOff
    320  0d69					      subroutine
    321  0d69		       a9 7b		      lda	#123
    322  0d6b		       85 22		      sta	mD1
    323  0d6d		       a9 00		      lda	#0
    324  0d6f		       85 23		      sta	mD2
    325  0d71		       ad 28 c3 	      lda	gbBase
    326  0d74		       09 b0		      ora	#$B0
