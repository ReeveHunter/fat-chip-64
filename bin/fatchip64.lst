------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 2
      0  22b5					      include	"midiin.asm"
      1  22b5							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  22b5							;
      3  22b5							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  22b5							; The main loop parses them (running status; realtime and system bytes are
      5  22b5							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  22b5							; notes mode, latch, arp and K + note.
      7  22b5							;
      8  22b5							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  22b5							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  22b5							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  22b5							;
     12  22b5							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  22b5							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  22b5							;
     15  22b5							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  22b5							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  22b5							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  22b5							; MIDI in is passed on to the Game Boy or NES.
     19  22b5
     20  22b5							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  22b5							; Uses A, X.
     22  22b5				   RxByte
     23  22b5					      subroutine
     24  22b5		       ad 06 de 	      lda	ACIA_STAT
     25  22b8		       4a		      lsr		; RDRF -> carry
     26  22b9		       90 15		      bcc	.x
     27  22bb		       ad 07 de 	      lda	ACIA_RX
     28  22be		       ae 26 c4 	      ldx	rxHead
     29  22c1		       9d e6 c3 	      sta	rxBuf,x
     30  22c4		       e8		      inx
     31  22c5		       8a		      txa
     32  22c6		       29 3f		      and	#63
     33  22c8		       cd 27 c4 	      cmp	rxTail
     34  22cb		       f0 03		      beq	.x	; full: dropped
     35  22cd		       8d 26 c4 	      sta	rxHead
     36  22d0				   .x
     37  22d0		       60		      rts
     38  22d1
     39  22d1							; Main loop, every pass: parse what came in.
     40  22d1				   MidiInService
     41  22d1					      subroutine
     42  22d1				   .next
     43  22d1		       ae 27 c4 	      ldx	rxTail
     44  22d4		       ec 26 c4 	      cpx	rxHead
     45  22d7		       d0 01		      bne	.byte
     46  22d9		       60		      rts
     47  22da				   .byte
     48  22da		       bd e6 c3 	      lda	rxBuf,x
     49  22dd		       a8		      tay
     50  22de		       e8		      inx
     51  22df		       8a		      txa
     52  22e0		       29 3f		      and	#63
     53  22e2		       8d 27 c4 	      sta	rxTail
     54  22e5		       98		      tya
     55  22e6		       10 14		      bpl	.data
     56  22e8		       c9 f8		      cmp	#$F8
     57  22ea		       b0 e5		      bcs	.next	; realtime (clock, active sensing...): skip
     58  22ec		       c9 f0		      cmp	#$F0
     59  22ee		       90 02		      bcc	.status
     60  22f0		       a9 00		      lda	#0	; system: no running status until the next one
     61  22f2				   .status
     62  22f2		       8d 28 c4 	      sta	rxStatus
     63  22f5		       a9 00		      lda	#0
     64  22f7		       8d 29 c4 	      sta	rxCnt
     65  22fa		       f0 d5		      beq	.next
     66  22fc				   .data
     67  22fc		       ae 28 c4 	      ldx	rxStatus
     68  22ff		       f0 d0		      beq	.next	; no status yet
     69  2301		       ae 29 c4 	      ldx	rxCnt
     70  2304		       d0 16		      bne	.second
     71  2306		       8d 2a c4 	      sta	rxD1
     72  2309		       ee 29 c4 	      inc	rxCnt
     73  230c		       ad 28 c4 	      lda	rxStatus
     74  230f		       29 e0		      and	#$E0
     75  2311		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
     76  2313		       d0 bc		      bne	.next
     77  2315		       a9 00		      lda	#0
     78  2317		       8d 29 c4 	      sta	rxCnt
     79  231a		       f0 b5		      beq	.next
     80  231c				   .second
     81  231c		       8d 2b c4 	      sta	rxD2
     82  231f		       a9 00		      lda	#0
     83  2321		       8d 29 c4 	      sta	rxCnt
     84  2324		       20 2a 23 	      jsr	MidiInMsg
     85  2327		       4c d1 22 	      jmp	.next
     86  232a
     87  232a							; A full message: rxStatus, rxD1, rxD2
     88  232a				   MidiInMsg
     89  232a					      subroutine
     90  232a		       ad 28 c4 	      lda	rxStatus
     91  232d		       29 0f		      and	#15
     92  232f		       c9 0b		      cmp	#MIDI_IN_CHANS
