------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  2987					      include	"midiin.asm"
      1  2987							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  2987							;
      3  2987							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  2987							; The main loop parses them (running status; realtime and system bytes are
      5  2987							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  2987							; notes mode, latch, arp and K + note.
      7  2987							;
      8  2987							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  2987							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  2987							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  2987							;
     12  2987							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  2987							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  2987							;
     15  2987							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  2987							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  2987							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  2987							; MIDI in is passed on to the Game Boy or NES.
     19  2987
     20  2987							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  2987							; Uses A, X.
     22  2987							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  2987							; with the time; a Start ($FA) makes the next clock a beat.
     24  2987				   RxByte
     25  2987					      subroutine
     26  2987		       ad 06 de 	      lda	ACIA_STAT
     27  298a		       4a		      lsr		; RDRF -> carry
     28  298b		       90 2b		      bcc	.x
     29  298d				   RxGot
     30  298d		       ad 07 de 	      lda	ACIA_RX
     31  2990		       c9 f8		      cmp	#$F8
     32  2992		       f0 25		      beq	.clk
     33  2994		       c9 fa		      cmp	#$FA
     34  2996		       d0 0e		      bne	.buf
     35  2998		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  299a		       8e e5 c5 	      stx	clkPhase
     37  299d		       8e ed c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  29a0							;  the main loop could measure it)
     39  29a0		       ae e6 c5 	      ldx	clkBeat
     40  29a3		       8e f8 c5 	      stx	clkStartBeat
     41  29a6				   .buf
     42  29a6		       ae 25 c4 	      ldx	rxHead
     43  29a9		       9d e5 c3 	      sta	rxBuf,x
     44  29ac		       e8		      inx
     45  29ad		       8a		      txa
     46  29ae		       29 3f		      and	#63
     47  29b0		       cd 26 c4 	      cmp	rxTail
     48  29b3		       f0 03		      beq	.x	; full: dropped
     49  29b5		       8d 25 c4 	      sta	rxHead
     50  29b8				   .x
     51  29b8		       60		      rts
     52  29b9				   .clk
     53  29b9		       ee e1 c5 	      inc	clkCount
     54  29bc		       ae e5 c5 	      ldx	clkPhase
     55  29bf		       e8		      inx
     56  29c0		       e0 18		      cpx	#24
     57  29c2		       90 14		      bcc	.ph
     58  29c4		       a5 10		      lda	ticks
     59  29c6		       8d e8 c5 	      sta	clkAtL
