------- FILE arp.asm LEVEL 2 PASS 2
      0  181b					      include	"arp.asm"
      1  181b							; Fat Chip 64 - tempo and arpeggiator
      2  181b							;
      3  181b							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  181b							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  181b							;
      6  181b							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  181b							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  181b							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  181b							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  181b							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  181b							;	     until its voice's next turn.
     12  181b							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  181b							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  181b							;   J faster; either one also picks FREE).
     15  181b							;
     16  181b							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  181b							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  181b
     19  181b							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  181b							; between the two bytes: $22FF read as $23FF)
     21  181b				   GetTicks
     22  181b					      subroutine
     23  181b		       08		      php
     24  181c		       78		      sei
     25  181d		       a5 10		      lda	ticks
     26  181f		       8d 3e c3 	      sta	nowL
     27  1822		       a5 11		      lda	ticks+1
     28  1824		       8d 3f c3 	      sta	nowH
     29  1827		       28		      plp
     30  1828		       60		      rts
     31  1829
