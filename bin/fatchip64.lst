------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  46d8					      include	"sync.asm"
      1  46d8							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  46d8							;
      3  46d8							; Menu, DEVICE SYNC (defaults first):
      4  46d8							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  46d8							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  46d8							;		     sets the tempo, averaged over beats (the clock jitters about
      7  46d8							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  46d8							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  46d8							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  46d8							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  46d8							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  46d8							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  46d8							;		     picks a beat demo (styleBeat)
     14  46d8							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  46d8							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  46d8							;		     key channel) picks a sound (voiceSound)
     17  46d8							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  46d8							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  46d8							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  46d8							;
     21  46d8							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  46d8							; 1/4 ms); a Start makes the next clock a beat.
     23  46d8
     24  46d8		       00 00	   TEMPO_KEYTAR equ	0
     25  46d8		       00 01	   TEMPO_OWN  equ	1
     26  46d8		       00 02	   TEMPO_SC   equ	2
     27  46d8		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  46d8
     29  46d8
     30  46d8
     31  46d8							; ------------------------------------------------------------ clock
