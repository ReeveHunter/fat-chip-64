------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  32e1					      include	"sounds.asm"
      1  32e1							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  32e1							;
      3  32e1							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  32e1							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  32e1							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  32e1							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  32e1							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  32e1							;
      9  32e1							; Each sound has a mono default and a Fat Bass default:
     10  32e1							;   MONO      one note (the last key pressed and still held) on every voice;
     11  32e1							;	       a new key while another is held changes the pitch without a
     12  32e1							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  32e1							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  32e1							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  32e1							;	       the other voices
     16  32e1							;
     17  32e1							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  32e1							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  32e1							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  32e1
     21  32e1							; ------------------------------------------------------------ choosing
     22  32e1							; V: next sound (SHIFT+V: previous)
     23  32e1				   SoundKey
     24  32e1					      subroutine
     25  32e1		       20 5b 33 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  32e4		       ae 94 c3 	      ldx	soundMode
     27  32e7		       ad 2a c3 	      lda	shiftDown
     28  32ea		       d0 09		      bne	.prev
     29  32ec		       e8		      inx
     30  32ed		       e0 13		      cpx	#NUM_SOUNDS
     31  32ef		       90 09		      bcc	.s
     32  32f1		       a2 00		      ldx	#0
     33  32f3		       f0 05		      beq	.s
     34  32f5				   .prev
     35  32f5		       ca		      dex
     36  32f6		       10 02		      bpl	.s
     37  32f8		       a2 12		      ldx	#NUM_SOUNDS-1
     38  32fa				   .s
     39  32fa		       4c 04 33 	      jmp	SoundSetX
     40  32fd
     41  32fd							; X = sound (the keytar's voice buttons)
