    114  2083		       29 3f		      and	#63
    115  2085		       c9 08		      cmp	#Q_BACKLOG
    116  2087		       b0 1f		      bcs	.x
    117  2089				   .q2
    118  2089		       ad 0f c3 	      lda	devOn+DEV_NES
    119  208c		       f0 0b		      beq	.ok
    120  208e		       a5 19		      lda	nesqHead
    121  2090		       38		      sec
    122  2091		       e5 1a		      sbc	nesqTail
    123  2093		       29 3f		      and	#63
    124  2095		       c9 08		      cmp	#Q_BACKLOG
    125  2097		       b0 0f		      bcs	.x
    126  2099				   .ok
    127  2099		       ad 26 c3 	      lda	nowL
    128  209c		       8d c0 c3 	      sta	bendSentAt
