     24  0d79		       a2 02		      ldx	#2
     25  0d7b				   .v
     26  0d7b		       bc 00 15 	      ldy	sidOfs,x
     27  0d7e		       a9 19		      lda	#$19	; attack 1, decay 9
     28  0d80		       99 05 d4 	      sta	SID+5,y
     29  0d83		       a9 c9		      lda	#$C9	; sustain 12, release 9
     30  0d85		       99 06 d4 	      sta	SID+6,y
     31  0d88		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     32  0d8a		       99 03 d4 	      sta	SID+3,y
     33  0d8d		       a9 20		      lda	#$20	; sawtooth, gate off
     34  0d8f		       9d 11 c3 	      sta	sidGate,x
     35  0d92		       99 04 d4 	      sta	SID+4,y
     36  0d95		       ca		      dex
