------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  288c					      include	"sounds.asm"
      1  288c							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  288c							;
      3  288c							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  288c							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  288c							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  288c							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  288c							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  288c							;
      9  288c							; Each sound has a mono default and a Fat Bass default:
     10  288c							;   MONO      one note (the last key pressed and still held) on every voice;
     11  288c							;	       a new key while another is held changes the pitch without a
     12  288c							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  288c							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  288c							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  288c							;	       the other voices
     16  288c							;
     17  288c							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  288c							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  288c							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  288c
     21  288c							; ------------------------------------------------------------ choosing
     22  288c							; V: next sound (SHIFT+V: previous)
     23  288c				   SoundKey
     24  288c					      subroutine
     25  288c		       20 ce 28 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  288f		       ae 95 c3 	      ldx	soundMode
     27  2892		       ad 2a c3 	      lda	shiftDown
     28  2895		       d0 09		      bne	.prev
     29  2897		       e8		      inx
     30  2898		       e0 11		      cpx	#NUM_SOUNDS
     31  289a		       90 09		      bcc	.s
     32  289c		       a2 00		      ldx	#0
     33  289e		       f0 05		      beq	.s
     34  28a0				   .prev
     35  28a0		       ca		      dex
     36  28a1		       10 02		      bpl	.s
     37  28a3		       a2 10		      ldx	#NUM_SOUNDS-1
     38  28a5				   .s
