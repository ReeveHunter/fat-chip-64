    505  4c3c							; ------------------------------------------------------------ actions
    506  4c3c							; What SPACE and the keytar's buttons do (menu: SPACE, ... BUTTON):
    507  4c3c							;   held     MUTE, BEND DOWN, BEND UP, VIBRATO, TREMOLO, ARP, STUTTER,
    508  4c3c							;	      VINYL STOP, GLIDE, SUSTAIN, OCTAVE UP, REPEAT, FILTER SWEEP,
    509  4c3c							;	      BEAT FILL, TAPE WOBBLE, WIDE
    510  4c3c							;   a press  TAP TEMPO, BEAT ON/OFF, NEXT SOUND; or NOTHING
