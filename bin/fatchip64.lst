    126  0ee7							; Z set if key code A is a modifier. Keeps A.
    127  0ee7				   IsModifier
    128  0ee7		       c9 88		      cmp	#K_LSHIFT
    129  0ee9		       f0 0a		      beq	.y
    130  0eeb		       c9 89		      cmp	#K_RSHIFT
    131  0eed		       f0 06		      beq	.y
    132  0eef		       c9 8c		      cmp	#K_CTRL
    133  0ef1		       f0 02		      beq	.y
    134  0ef3		       c9 9a		      cmp	#K_K
    135  0ef5				   .y
