    389  3ca4		       c9 f7		      cmp	#$F7
    390  3ca6		       d0 13		      bne	.x
    391  3ca8		       ae 29 cc 	      ldx	sxCmd
    392  3cab		       e0 02		      cpx	#2
    393  3cad		       f0 0d		      beq	.dev
    394  3caf		       ae 5a cb 	      ldx	sxPos
    395  3cb2		       e0 db		      cpx	#SX_LEN
    396  3cb4		       d0 05		      bne	.x
