    307  0a64							;------------------------------------------------------------- interrupts
    308  0a64							; Every 1/4 ms: take a MIDI-in byte, feed the ACIA one byte (fast path).
    309  0a64							; Every fourth time (1 ms):
    310  0a64							; count a tick and move paced messages onto the wire.
    311  0a64				   Irq
    312  0a64					      subroutine
    313  0a64		       48		      pha
    314  0a65		       8a		      txa
    315  0a66		       48		      pha
    316  0a67		       ad 0d dc 	      lda	CIA1_ICR	; acknowledge
    317  0a6a		       ad 06 de 	      lda	ACIA_STAT	; MIDI in: a received byte? (quick check inline)
    318  0a6d		       4a		      lsr
    319  0a6e		       90 03		      bcc	.noRx
    320  0a70		       20 8d 29 	      jsr	RxGot
    321  0a73				   .noRx
    322  0a73		       a6 16		      ldx	wireTail
    323  0a75		       e4 15		      cpx	wireHead
    324  0a77		       f0 0f		      beq	.noByte
    325  0a79		       ad 06 de 	      lda	ACIA_STAT
    326  0a7c		       29 02		      and	#ACIA_TDRE
    327  0a7e		       f0 08		      beq	.noByte
    328  0a80		       bd 00 c0 	      lda	wireBuf,x
    329  0a83		       8d 05 de 	      sta	ACIA_TX
    330  0a86		       e6 16		      inc	wireTail
    331  0a88				   .noByte
    332  0a88		       c6 2d		      dec	subTick
    333  0a8a		       10 17		      bpl	.out
    334  0a8c		       a9 03		      lda	#3
    335  0a8e		       85 2d		      sta	subTick
    336  0a90		       98		      tya
    337  0a91		       48		      pha
    338  0a92		       e6 10		      inc	ticks
    339  0a94		       d0 02		      bne	.t
    340  0a96		       e6 11		      inc	ticks+1
    341  0a98				   .t
    342  0a98		       20 e2 0a 	      jsr	Schedule
    343  0a9b		       20 c2 0a 	      jsr	TxByte	; start a just-scheduled message now if the ACIA is free
    344  0a9e		       20 87 29 	      jsr	RxByte	; (again: this pass was long, a byte may be in)
    345  0aa1		       68		      pla
    346  0aa2		       a8		      tay
    347  0aa3				   .out
    348  0aa3		       68		      pla
    349  0aa4		       aa		      tax
