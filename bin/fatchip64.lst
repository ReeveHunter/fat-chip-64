    218  0ce2							; A = free bytes in the wire ring
    219  0ce2				   WireFree
    220  0ce2					      subroutine
    221  0ce2		       a5 16		      lda	wireTail
    222  0ce4		       38		      sec
    223  0ce5		       e5 15		      sbc	wireHead
    224  0ce7		       38		      sec
    225  0ce8		       e9 01		      sbc	#1
    226  0cea		       60		      rts
