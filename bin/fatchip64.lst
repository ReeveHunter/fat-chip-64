------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  396e					      include	"midiin.asm"
      1  396e							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  396e							;
      3  396e							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  396e							; The main loop parses them (running status; realtime and system bytes are
      5  396e							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  396e							; notes mode, latch, arp and K + note.
      7  396e							;
      8  396e							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  396e							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  396e							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  396e							;
     12  396e							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  396e							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  396e							;
     15  396e							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  396e							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  396e							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  396e							; MIDI in is passed on to the Game Boy or NES.
     19  396e
     20  396e							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  396e							; Uses A, X.
     22  396e							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  396e							; with the time; a Start ($FA) makes the next clock a beat.
     24  396e				   RxByte
     25  396e					      subroutine
     26  396e		       ad 06 de 	      lda	ACIA_STAT
     27  3971		       4a		      lsr		; RDRF -> carry
     28  3972		       90 2b		      bcc	.x
     29  3974				   RxGot
     30  3974		       ad 07 de 	      lda	ACIA_RX
     31  3977		       c9 f8		      cmp	#$F8
     32  3979		       f0 25		      beq	.clk
     33  397b		       c9 fa		      cmp	#$FA
     34  397d		       d0 0e		      bne	.buf
     35  397f		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  3981		       8e f5 c5 	      stx	clkPhase
     37  3984		       8e fd c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3987							;  the main loop could measure it)
     39  3987		       ae f6 c5 	      ldx	clkBeat
     40  398a		       8e 08 c6 	      stx	clkStartBeat
     41  398d				   .buf
     42  398d		       ae 31 c4 	      ldx	rxHead
     43  3990		       9d f1 c3 	      sta	rxBuf,x
     44  3993		       e8		      inx
     45  3994		       8a		      txa
     46  3995		       29 3f		      and	#63
     47  3997		       cd 32 c4 	      cmp	rxTail
     48  399a		       f0 03		      beq	.x	; full: dropped
     49  399c		       8d 31 c4 	      sta	rxHead
     50  399f				   .x
     51  399f		       60		      rts
     52  39a0				   .clk
     53  39a0		       ee f1 c5 	      inc	clkCount
     54  39a3		       ae f5 c5 	      ldx	clkPhase
     55  39a6		       e8		      inx
     56  39a7		       e0 18		      cpx	#24
     57  39a9		       90 1b		      bcc	.ph
     58  39ab		       a5 10		      lda	ticks
     59  39ad		       8d f8 c5 	      sta	clkAtL
     60  39b0		       a5 11		      lda	ticks+1
     61  39b2		       8d f9 c5 	      sta	clkAtH
     62  39b5		       a5 2d		      lda	subTick
     63  39b7		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  39b9		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  39bb		       ad 05 dc 	      lda	CIA1_TAHI
     66  39be				   .q
     67  39be		       8d fa c5 	      sta	clkAtS
     68  39c1		       ee f6 c5 	      inc	clkBeat
     69  39c4		       a2 00		      ldx	#0
     70  39c6				   .ph
     71  39c6		       8e f5 c5 	      stx	clkPhase
     72  39c9		       60		      rts
     73  39ca
     74  39ca							; Main loop, every pass: parse what came in.
     75  39ca				   MidiInService
     76  39ca					      subroutine
     77  39ca				   .next
     78  39ca		       ae 32 c4 	      ldx	rxTail
     79  39cd		       ec 31 c4 	      cpx	rxHead
     80  39d0		       d0 01		      bne	.byte
     81  39d2		       60		      rts
     82  39d3				   .byte
     83  39d3		       bd f1 c3 	      lda	rxBuf,x
     84  39d6		       a8		      tay
     85  39d7		       e8		      inx
     86  39d8		       8a		      txa
     87  39d9		       29 3f		      and	#63
     88  39db		       8d 32 c4 	      sta	rxTail
     89  39de		       98		      tya
     90  39df		       10 1e		      bpl	.data
     91  39e1		       c9 f8		      cmp	#$F8
     92  39e3		       b0 49		      bcs	.rt	; realtime (clocks are counted by RxByte)
     93  39e5		       c9 f0		      cmp	#$F0
