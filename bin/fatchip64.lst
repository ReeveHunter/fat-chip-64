    149 U002f ????				      seg.u	zp
    150 U0010					      org	$10
    151 U0010		       00 00	   ticks      ds	2	; 1 ms counter (IRQ)
    152 U0012		       00	   scanAt     ds	1	; low byte of ticks for the next scan
    153 U0013		       00	   scrAt      ds	1	; ... for the next screen step
    154 U0014		       00	   lastStatus ds	1	; running status on the wire
    155 U0015		       00	   wireHead   ds	1	; wire ring: head = write, tail = read
    156 U0016		       00	   wireTail   ds	1
