    160  8650				   .go
    161  8650		       bd 3c ce 	      lda	nesK,x
    162  8653		       c9 ff		      cmp	#$FF	; (v0.41: BEND IN STEP: held for TIME, then the note)
    163  8655		       d0 0c		      bne	.slide
    164  8657		       bd a2 c9 	      lda	nesVT,x
    165  865a		       cd 60 cb 	      cmp	sndStepT
