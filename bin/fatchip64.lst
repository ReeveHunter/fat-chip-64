      0  61db					      include	"patchedit.asm"
      1  61db							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  61db							; the dice. The settings and their steps come from tools/gen_menu.py
      3  61db							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  61db							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  61db							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  61db							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  61db							; (EnvDerive).
      8  61db
      9  61db		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  61db		       00 30	   LFO_LAST   equ	FLD_gbLDelay
     11  61db
