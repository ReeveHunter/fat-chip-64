    176  811b		       d0 07		      bne	.sh
    177  811d		       ac 10 c6 	      ldy	glideK
    178  8120		       d0 02		      bne	.sh
    179  8122		       a0 02		      ldy	#2	; (glide switched off mid-slide: finish quickly)
    180  8124				   .sh
