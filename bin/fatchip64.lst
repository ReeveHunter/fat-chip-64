------- FILE attack.asm LEVEL 2 PASS 3
      0  65a7					      include	"attack.asm"
      1  65a7							; Fat Chip 64 - ATTACK, BEND IN, BEND OUT (v0.30): how each note starts and
      2  65a7							; ends in pitch
      3  65a7							;
      4  65a7							; ATTACK (the SID): BLIP: an octave up for one BLIP STEP, then the note
      5  65a7							;   (OCTAVE + 5TH: an octave, a fifth, the note; 2 OCTAVES: two up, one up,
      6  65a7							;   the note); CLICK: the first 20 ms as noise.
      7  65a7							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      8  65a7							;   a scoop) and bends to its pitch over TIME: the SID and NES slide it (the
      9  65a7							;   SID per voice, the NES with its glide), the Game Boy has its own pitch
     10  65a7							;   envelope (CC 80 / 81).
     11  65a7							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  65a7							;   release rings.
     13  65a7
     14  65a7							; SidFxs pitch loop, SID voice envY: ATTACK's clock; the CLICK ends
     15  65a7				   AtkStep
     16  65a7					      subroutine
     17  65a7		       ac c2 c3 	      ldy	envY
     18  65aa		       b9 58 c9 	      lda	atkT,y
     19  65ad		       18		      clc
     20  65ae		       6d 51 c4 	      adc	fxN
     21  65b1		       90 02		      bcc	.t
     22  65b3		       a9 ff		      lda	#255
     23  65b5				   .t
     24  65b5		       99 58 c9 	      sta	atkT,y
     25  65b8		       b9 5b c9 	      lda	clickOn,y
     26  65bb		       f0 15		      beq	.x
     27  65bd		       b9 58 c9 	      lda	atkT,y
     28  65c0		       c9 05		      cmp	#5	; (20 ms of noise)
     29  65c2		       90 0e		      bcc	.x
     30  65c4		       a9 00		      lda	#0
     31  65c6		       99 5b c9 	      sta	clickOn,y
     32  65c9		       be cb 73 	      ldx	sidOfs,y
     33  65cc		       b9 31 c3 	      lda	sidGate,y
     34  65cf		       9d 04 d4 	      sta	SID+4,x
     35  65d2				   .x
     36  65d2		       60		      rts
