      3  0c0f							; Scan the whole matrix, turn changes into key events.
      4  0c0f							;
      5  0c0f							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0c0f							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0c0f							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0c0f							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0c0f							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0c0f							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0c0f							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0c0f							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0c0f							; chords whose ghost lands on another used key lose their newest note.
     14  0c0f				   KeyScan
     15  0c0f					      subroutine
     16  0c0f		       a2 07		      ldx	#7
     17  0c11				   .col
     18  0c11		       bd 2f 25 	      lda	colSelect,x
     19  0c14		       8d 00 dc 	      sta	CIA1_PRA
     20  0c17		       ad 01 dc 	      lda	CIA1_PRB
     21  0c1a		       49 ff		      eor	#$FF
     22  0c1c		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0c1f		       9d 80 c2 	      sta	keyNow,x
     24  0c22		       ca		      dex
     25  0c23		       10 ec		      bpl	.col
     26  0c25		       a9 ff		      lda	#$FF
     27  0c27		       8d 00 dc 	      sta	CIA1_PRA
     28  0c2a							; ---- releases first: accepted keys that are up now
     29  0c2a		       a2 00		      ldx	#0
     30  0c2c				   .rc
     31  0c2c		       8e 1f c3 	      stx	ksCol
     32  0c2f		       bd 80 c2 	      lda	keyNow,x
     33  0c32		       49 ff		      eor	#$FF
     34  0c34		       3d 90 c2 	      and	keyAcc,x
     35  0c37		       8d 1e c3 	      sta	ksBits
     36  0c3a		       a9 00		      lda	#0
     37  0c3c		       8d 20 c3 	      sta	ksRow
     38  0c3f				   .rb
     39  0c3f		       ad 1e c3 	      lda	ksBits
     40  0c42		       f0 21		      beq	.rcn
     41  0c44		       4e 1e c3 	      lsr	ksBits
     42  0c47		       90 17		      bcc	.rbn
     43  0c49		       ae 1f c3 	      ldx	ksCol
     44  0c4c		       ac 20 c3 	      ldy	ksRow
     45  0c4f		       b9 37 25 	      lda	rowBit,y
     46  0c52		       49 ff		      eor	#$FF
     47  0c54		       3d 90 c2 	      and	keyAcc,x
     48  0c57		       9d 90 c2 	      sta	keyAcc,x
     49  0c5a		       20 ec 0c 	      jsr	KeyCode
     50  0c5d		       20 77 0f 	      jsr	KeyUp
     51  0c60				   .rbn
     52  0c60		       ee 20 c3 	      inc	ksRow
     53  0c63		       d0 da		      bne	.rb
     54  0c65				   .rcn
     55  0c65		       ae 1f c3 	      ldx	ksCol
     56  0c68		       e8		      inx
     57  0c69		       e0 08		      cpx	#8
     58  0c6b		       d0 bf		      bne	.rc
     59  0c6d							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     60  0c6d							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     61  0c6d							; still count as a combination.
     62  0c6d		       a9 00		      lda	#0
     63  0c6f		       8d 22 c3 	      sta	ksPass
     64  0c72				   .pass
     65  0c72		       a2 00		      ldx	#0
     66  0c74				   .pc
     67  0c74		       8e 1f c3 	      stx	ksCol
     68  0c77		       bd 90 c2 	      lda	keyAcc,x
     69  0c7a		       49 ff		      eor	#$FF
     70  0c7c		       3d 80 c2 	      and	keyNow,x
     71  0c7f		       8d 1e c3 	      sta	ksBits
     72  0c82		       a9 00		      lda	#0
     73  0c84		       8d 20 c3 	      sta	ksRow
     74  0c87				   .pb
     75  0c87		       ad 1e c3 	      lda	ksBits
     76  0c8a		       f0 3d		      beq	.pcn
     77  0c8c		       4e 1e c3 	      lsr	ksBits
     78  0c8f		       90 33		      bcc	.pbn
     79  0c91		       ad 23 c3 	      lda	ghostFilter
     80  0c94		       f0 05		      beq	.accept	; filter off (default): phantoms play
     81  0c96		       20 fa 0c 	      jsr	Suspect
     82  0c99		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     83  0c9b				   .accept
     84  0c9b		       20 ec 0c 	      jsr	KeyCode
     85  0c9e		       20 dd 0c 	      jsr	IsModifier	; Z set = modifier
     86  0ca1		       f0 07		      beq	.mod
     87  0ca3		       ad 22 c3 	      lda	ksPass
     88  0ca6		       f0 1c		      beq	.pbn	; pass 0: modifiers only
     89  0ca8		       d0 05		      bne	.take
     90  0caa				   .mod
     91  0caa		       ad 22 c3 	      lda	ksPass
     92  0cad		       d0 15		      bne	.pbn	; (taken in pass 0)
     93  0caf				   .take
     94  0caf		       ae 1f c3 	      ldx	ksCol
     95  0cb2		       ac 20 c3 	      ldy	ksRow
     96  0cb5		       b9 37 25 	      lda	rowBit,y
     97  0cb8		       1d 90 c2 	      ora	keyAcc,x
     98  0cbb		       9d 90 c2 	      sta	keyAcc,x
     99  0cbe		       20 ec 0c 	      jsr	KeyCode
    100  0cc1		       20 2b 0d 	      jsr	KeyDown
    101  0cc4				   .pbn
    102  0cc4		       ee 20 c3 	      inc	ksRow
    103  0cc7		       d0 be		      bne	.pb
    104  0cc9				   .pcn
    105  0cc9		       ae 1f c3 	      ldx	ksCol
    106  0ccc		       e8		      inx
    107  0ccd		       e0 08		      cpx	#8
    108  0ccf		       d0 a3		      bne	.pc
    109  0cd1		       ad 22 c3 	      lda	ksPass
    110  0cd4		       d0 06		      bne	.done
    111  0cd6		       ee 22 c3 	      inc	ksPass
    112  0cd9		       4c 72 0c 	      jmp	.pass
    113  0cdc				   .done
