      0  5c91					      include	"wander.asm"
      1  5c91							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  5c91							;
      3  5c91							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  5c91							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  5c91							;   ATTACK   as always: the new notes start
      6  5c91							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  5c91							;	      has none)
      8  5c91							;   SPLIT    the SID and the bass voices glide, the Game Boy and NES pulses
      9  5c91							;	      start again
     10  5c91							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  5c91							;	      late; some glide, some start again (fade out, come back in)
     12  5c91							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  5c91							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  5c91							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  5c91							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  5c91
     17  5c91		       00 01	   CHG_ATTACK equ	1
     18  5c91		       00 02	   CHG_GLIDE  equ	2
     19  5c91		       00 03	   CHG_SPLIT  equ	3
     20  5c91		       00 04	   CHG_WANDER equ	4
     21  5c91		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  5c91
     23  5c91							; A = the chord change style now (keeps X, Y)
