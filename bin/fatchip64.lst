    466  3ac2		       7d 46 43 01*sxHead     .byte.b	$7D, $46, $43, $01, PATCH_SIZE	; (the size: a Chip Lab with another layout is ignored)
    467  3ac7
    468  3ac7							; F0 7D 46 43 02 m F7 (v0.23): the chips on or off, m bit 0 SID, 1 Game
    469  3ac7							; Boy, 2 NES (Chip Lab's chip buttons) - as SHIFT / C= + F1 F3 F5 do
    470  3ac7				   DevicesReceived
    471  3ac7					      subroutine
    472  3ac7		       a2 00		      ldx	#0
