    150  0f01							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    151  0f01							; keys: some other column has a key in this row and shares another row with
    152  0f01							; this column.
    153  0f01				   Suspect
    154  0f01					      subroutine
    155  0f01		       ac 38 c3 	      ldy	ksRow
    156  0f04		       b9 2d 69 	      lda	rowBit,y
    157  0f07		       49 ff		      eor	#$FF
    158  0f09		       ae 37 c3 	      ldx	ksCol
    159  0f0c		       3d 80 c2 	      and	keyNow,x
    160  0f0f		       8d 39 c3 	      sta	ksMask	; this column's other held rows
    161  0f12		       f0 1c		      beq	.no
    162  0f14		       a2 07		      ldx	#7
    163  0f16				   .c
    164  0f16		       ec 37 c3 	      cpx	ksCol
    165  0f19		       f0 12		      beq	.n
    166  0f1b		       bd 80 c2 	      lda	keyNow,x
    167  0f1e		       39 2d 69 	      and	rowBit,y
    168  0f21		       f0 0a		      beq	.n
    169  0f23		       bd 80 c2 	      lda	keyNow,x
    170  0f26		       2d 39 c3 	      and	ksMask
    171  0f29		       f0 02		      beq	.n
