------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  2fd1					      include	"midiin.asm"
      1  2fd1							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  2fd1							;
      3  2fd1							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  2fd1							; The main loop parses them (running status; realtime and system bytes are
      5  2fd1							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  2fd1							; notes mode, latch, arp and K + note.
      7  2fd1							;
      8  2fd1							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  2fd1							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  2fd1							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  2fd1							;
     12  2fd1							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  2fd1							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  2fd1							;
     15  2fd1							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  2fd1							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  2fd1							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  2fd1							; MIDI in is passed on to the Game Boy or NES.
     19  2fd1
     20  2fd1							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  2fd1							; Uses A, X.
     22  2fd1							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  2fd1							; with the time; a Start ($FA) makes the next clock a beat.
     24  2fd1				   RxByte
     25  2fd1					      subroutine
     26  2fd1		       ad 06 de 	      lda	ACIA_STAT
     27  2fd4		       4a		      lsr		; RDRF -> carry
     28  2fd5		       90 2b		      bcc	.x
     29  2fd7				   RxGot
     30  2fd7		       ad 07 de 	      lda	ACIA_RX
     31  2fda		       c9 f8		      cmp	#$F8
     32  2fdc		       f0 25		      beq	.clk
     33  2fde		       c9 fa		      cmp	#$FA
     34  2fe0		       d0 0e		      bne	.buf
     35  2fe2		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  2fe4		       8e e8 c5 	      stx	clkPhase
     37  2fe7		       8e f0 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  2fea							;  the main loop could measure it)
     39  2fea		       ae e9 c5 	      ldx	clkBeat
     40  2fed		       8e fb c5 	      stx	clkStartBeat
     41  2ff0				   .buf
     42  2ff0		       ae 24 c4 	      ldx	rxHead
     43  2ff3		       9d e4 c3 	      sta	rxBuf,x
     44  2ff6		       e8		      inx
     45  2ff7		       8a		      txa
     46  2ff8		       29 3f		      and	#63
     47  2ffa		       cd 25 c4 	      cmp	rxTail
     48  2ffd		       f0 03		      beq	.x	; full: dropped
     49  2fff		       8d 24 c4 	      sta	rxHead
     50  3002				   .x
     51  3002		       60		      rts
     52  3003				   .clk
     53  3003		       ee e4 c5 	      inc	clkCount
     54  3006		       ae e8 c5 	      ldx	clkPhase
     55  3009		       e8		      inx
     56  300a		       e0 18		      cpx	#24
     57  300c		       90 1b		      bcc	.ph
     58  300e		       a5 10		      lda	ticks
     59  3010		       8d eb c5 	      sta	clkAtL
     60  3013		       a5 11		      lda	ticks+1
     61  3015		       8d ec c5 	      sta	clkAtH
     62  3018		       a5 2d		      lda	subTick
     63  301a		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  301c		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  301e		       ad 05 dc 	      lda	CIA1_TAHI
     66  3021				   .q
     67  3021		       8d ed c5 	      sta	clkAtS
     68  3024		       ee e9 c5 	      inc	clkBeat
     69  3027		       a2 00		      ldx	#0
     70  3029				   .ph
     71  3029		       8e e8 c5 	      stx	clkPhase
     72  302c		       60		      rts
     73  302d
     74  302d							; Main loop, every pass: parse what came in.
     75  302d				   MidiInService
     76  302d					      subroutine
     77  302d				   .next
     78  302d		       ae 25 c4 	      ldx	rxTail
     79  3030		       ec 24 c4 	      cpx	rxHead
     80  3033		       d0 01		      bne	.byte
     81  3035		       60		      rts
     82  3036				   .byte
     83  3036		       bd e4 c3 	      lda	rxBuf,x
     84  3039		       a8		      tay
     85  303a		       e8		      inx
     86  303b		       8a		      txa
     87  303c		       29 3f		      and	#63
     88  303e		       8d 25 c4 	      sta	rxTail
     89  3041		       98		      tya
     90  3042		       10 1e		      bpl	.data
     91  3044		       c9 f8		      cmp	#$F8
     92  3046		       b0 49		      bcs	.rt	; realtime (clocks are counted by RxByte)
     93  3048		       c9 f0		      cmp	#$F0
     94  304a		       b0 07		      bcs	.sys
     95  304c		       a2 00		      ldx	#0	; a channel message ends any SysEx
     96  304e		       8e 4c c7 	      stx	sxOn
     97  3051		       f0 05		      beq	.status
     98  3053				   .sys
     99  3053		       20 fe 31 	      jsr	SysexStatus	; F0 starts a SysEx, F7 ends it (v0.20)
    100  3056		       a9 00		      lda	#0	; system: no running status until the next one
    101  3058				   .status
    102  3058		       8d 26 c4 	      sta	rxStatus
    103  305b		       a9 00		      lda	#0
    104  305d		       8d 27 c4 	      sta	rxCnt
    105  3060		       f0 cb		      beq	.next
    106  3062				   .data
    107  3062		       ae 4c c7 	      ldx	sxOn
    108  3065		       f0 06		      beq	.nosx
    109  3067		       20 3f 32 	      jsr	SysexByte
    110  306a		       4c 2d 30 	      jmp	.next
    111  306d				   .nosx
    112  306d		       ae 26 c4 	      ldx	rxStatus
    113  3070		       f0 bb		      beq	.next	; no status yet
    114  3072		       ae 27 c4 	      ldx	rxCnt
    115  3075		       d0 2e		      bne	.second
    116  3077		       8d 28 c4 	      sta	rxD1
    117  307a		       ee 27 c4 	      inc	rxCnt
    118  307d		       ad 26 c4 	      lda	rxStatus
    119  3080		       29 e0		      and	#$E0
    120  3082		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
    121  3084		       d0 a7		      bne	.next
    122  3086		       a9 00		      lda	#0
    123  3088		       8d 27 c4 	      sta	rxCnt
