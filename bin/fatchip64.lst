    363  35d7							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    364  35d7							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    365  35d7							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    366  35d7							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    367  35d7		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    368  35db		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    369  35e2		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    370  35e9		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    371  35ee		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    372  35f2		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
