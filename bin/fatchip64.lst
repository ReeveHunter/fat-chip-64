      0  3063					      include	"repeat.asm"
      1  3063							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  3063							;
      3  3063							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  3063							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  3063							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  3063							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  3063							; 1s), taken out of the chord while REPEAT is on - unless the notes held need
      8  3063							; them (then held notes come first and the echoes wait). Each echo sounds for
      9  3063							; 3/4 of the time between echoes. The SID doesn't echo.
     10  3063							;
     11  3063							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     12  3063							; OFF), or the REPEAT action held (SPACE or a keytar button).
     13  3063							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     14  3063							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     15  3063
     16  3063		       00 10	   RP_SLOTS   equ	16
     17  3063		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     18  3063
     19  3063							; REPEAT is on now?
     20  3063				   RepeatActive
     21  3063		       ad bf c4 	      lda	repeatOn
     22  3066		       0d ac c4 	      ora	actCnt+A_REPEAT
     23  3069		       60		      rts
