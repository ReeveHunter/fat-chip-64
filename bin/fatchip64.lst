    109  3b08		       20 ed 3c 	      jsr	SysexByte
    110  3b0b		       4c ce 3a 	      jmp	.next
    111  3b0e				   .nosx
    112  3b0e		       ae f3 c8 	      ldx	rxStatus
    113  3b11		       f0 bb		      beq	.next	; no status yet
    114  3b13		       ae f4 c8 	      ldx	rxCnt
    115  3b16		       d0 2e		      bne	.second
    116  3b18		       8d f5 c8 	      sta	rxD1
    117  3b1b		       ee f4 c8 	      inc	rxCnt
    118  3b1e		       ad f3 c8 	      lda	rxStatus
    119  3b21		       29 e0		      and	#$E0
    120  3b23		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
    121  3b25		       d0 a7		      bne	.next
    122  3b27		       a9 00		      lda	#0
    123  3b29		       8d f4 c8 	      sta	rxCnt
    124  3b2c		       20 54 3b 	      jsr	MidiInMsg
    125  3b2f		       4c ce 3a 	      jmp	.next
    126  3b32				   .rt
    127  3b32		       c9 fa		      cmp	#$FA
    128  3b34		       d0 06		      bne	.rt2
    129  3b36		       20 cb 5d 	      jsr	KeytarStart
    130  3b39		       4c ce 3a 	      jmp	.next
    131  3b3c				   .rt2
    132  3b3c		       c9 fc		      cmp	#$FC
    133  3b3e		       d0 03		      bne	.rt3
    134  3b40		       20 ec 5d 	      jsr	KeytarStop
    135  3b43				   .rt3
    136  3b43		       4c ce 3a 	      jmp	.next
    137  3b46				   .second
    138  3b46		       8d f6 c8 	      sta	rxD2
    139  3b49		       a9 00		      lda	#0
    140  3b4b		       8d f4 c8 	      sta	rxCnt
    141  3b4e		       20 54 3b 	      jsr	MidiInMsg
    142  3b51		       4c ce 3a 	      jmp	.next
