    407  3f96		       05 0a 0f 14*uTremRH    .byte.b	>1311, >2621, >3932, >5243, >6554
    408  3f9b		       04 08 0c 10 uDetT      .byte.b	4, 8, 12, 16
    409  3f9f		       18 38 64    uWarbT     .byte.b	24, 56, 100
