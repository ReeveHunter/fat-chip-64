------- FILE nesfx.asm LEVEL 2 PASS 3
      0  8536					      include	"nesfx.asm"
      1  8536							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  8536							;
      3  8536							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  8536							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  8536							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  8536							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  8536							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  8536							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  8536							;   glide    a new note starts bent back to the voice's last note and slides
     10  8536							;	      in the way the SID's does (all three channels)
     11  8536							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  8536							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  8536							; semitone, so these are a little stepped.
     14  8536
     15  8536		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  8536							;  (the pulses, and the triangle while it glides)
     17  8536
     18  8536							; A = 1 (not Z) when a NesFxTick step is due
     19  8536				   NesFxDue
     20  8536					      subroutine
     21  8536		       ad 2b c7 	      lda	devOn+DEV_NES
     22  8539		       f0 1c		      beq	.x
     23  853b		       ad 0b ca 	      lda	vibDepth
     24  853e		       0d 39 c9 	      ora	nfxGlide
     25  8541		       0d 3a c9 	      ora	nfxRun
     26  8544		       0d f9 cd 	      ora	nfxWarb
     27  8547		       f0 0e		      beq	.x
     28  8549		       a5 10		      lda	ticks
     29  854b		       38		      sec
     30  854c		       ed 35 c9 	      sbc	nfxLast
     31  854f		       c9 08		      cmp	#NFX_EVERY
     32  8551		       a9 00		      lda	#0
     33  8553		       90 02		      bcc	.x
     34  8555		       a9 01		      lda	#1
     35  8557				   .x
     36  8557		       60		      rts
     37  8558
     38  8558							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     39  8558							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     40  8558							; quick return.
