      0  5fe4					      include	"patchedit.asm"
      1  5fe4							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  5fe4							; the dice. The settings and their steps come from tools/gen_menu.py
      3  5fe4							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  5fe4							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  5fe4							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  5fe4							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  5fe4							; (EnvDerive).
