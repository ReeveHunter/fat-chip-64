    309  0a6a							;------------------------------------------------------------- interrupts
    310  0a6a							; Every 1/4 ms: take a MIDI-in byte, feed the ACIA one byte (fast path).
    311  0a6a							; Every fourth time (1 ms):
    312  0a6a							; count a tick and move paced messages onto the wire.
    313  0a6a				   Irq
    314  0a6a					      subroutine
    315  0a6a		       48		      pha
    316  0a6b		       8a		      txa
    317  0a6c		       48		      pha
    318  0a6d		       ad 0d dc 	      lda	CIA1_ICR	; acknowledge
    319  0a70		       ad 06 de 	      lda	ACIA_STAT	; MIDI in: a received byte? (quick check inline)
    320  0a73		       4a		      lsr
    321  0a74		       90 03		      bcc	.noRx
    322  0a76		       20 af 2b 	      jsr	RxGot
    323  0a79				   .noRx
