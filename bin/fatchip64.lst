      0  6aa5					      include	"attack.asm"
      1  6aa5							; Fat Chip 64 - ATTACK, BEND IN, BEND OUT (v0.30): how each note starts and
      2  6aa5							; ends in pitch
      3  6aa5							;
      4  6aa5							; ATTACK (the SID): BLIP: an octave up for one BLIP STEP, then the note
      5  6aa5							;   (OCTAVE + 5TH: an octave, a fifth, the note; 2 OCTAVES: two up, one up,
      6  6aa5							;   the note); CLICK: the first 20 ms as noise.
      7  6aa5							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      8  6aa5							;   a scoop) and bends to its pitch over TIME: the SID and NES slide it (the
      9  6aa5							;   SID per voice, the NES with its glide), the Game Boy has its own pitch
     10  6aa5							;   envelope (CC 80 / 81).
     11  6aa5							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  6aa5							;   release rings.
     13  6aa5
     14  6aa5							; SidFxs pitch loop, SID voice envY: ATTACK's clock; the CLICK ends
     15  6aa5				   AtkStep
