     22  755d				   .c
     23  755d		       b1 28		      lda	(ptr),y
     24  755f		       f0 0e		      beq	.done
     25  7561		       c9 40		      cmp	#64
     26  7563		       90 03		      bcc	.noLetter
     27  7565		       38		      sec
     28  7566		       e9 40		      sbc	#64
     29  7568				   .noLetter
     30  7568		       05 26		      ora	t2
     31  756a		       91 2a		      sta	(ptr2),y
     32  756c		       c8		      iny
     33  756d		       d0 ee		      bne	.c
     34  756f				   .done
     35  756f		       60		      rts
     36  7570
