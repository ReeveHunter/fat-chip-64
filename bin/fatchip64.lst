------- FILE main.asm LEVEL 1 PASS 3
      1  8be7 ????						; Fat Chip 64 - main program
      2  8be7 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  8be7 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  8be7 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  8be7 ????
      6  8be7 ????				      processor	6502
