     84  2a42		       20 90 2a 	      jsr	RdBend	; BEND OUT: it sags as it fades
     85  2a45		       38		      sec
     86  2a46		       60		      rts
     87  2a47				   .tri
     88  2a47					      if	TRI_DROP_PADS == 0
     89  2a47		       4c 79 2a 	      jmp	.fo	; PADS: the bass just stops (Reeve, 2026-11-01)
     90  2a4a					      endif
     91  2a4a		       bd ce 88 	      lda	vIdx,x
     92  2a4d		       c9 02		      cmp	#2
