------- FILE sounds.asm LEVEL 2 PASS 3
      0  36e5					      include	"sounds.asm"
      1  36e5							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  36e5							;
      3  36e5							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  36e5							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  36e5							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  36e5							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  36e5							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  36e5							;
      9  36e5							; Each sound has a mono default and a Fat Bass default:
     10  36e5							;   MONO      one note (the last key pressed and still held) on every voice;
     11  36e5							;	       a new key while another is held changes the pitch without a
     12  36e5							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  36e5							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  36e5							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  36e5							;	       the other voices
     16  36e5							;
     17  36e5							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  36e5							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  36e5							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  36e5
     21  36e5							; ------------------------------------------------------------ choosing
     22  36e5							; V: next sound (SHIFT+V: previous)
     23  36e5				   SoundKey
     24  36e5					      subroutine
     25  36e5		       20 5f 37 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  36e8		       ae 94 c3 	      ldx	soundMode
     27  36eb		       ad 2a c3 	      lda	shiftDown
     28  36ee		       d0 09		      bne	.prev
     29  36f0		       e8		      inx
     30  36f1		       e0 13		      cpx	#NUM_SOUNDS
     31  36f3		       90 09		      bcc	.s
     32  36f5		       a2 00		      ldx	#0
     33  36f7		       f0 05		      beq	.s
     34  36f9				   .prev
     35  36f9		       ca		      dex
     36  36fa		       10 02		      bpl	.s
