------- FILE repeat.asm LEVEL 2 PASS 3
      0  4a99					      include	"repeat.asm"
      1  4a99							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  4a99							;
      3  4a99							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  4a99							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  4a99							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  4a99							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  4a99							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  4a99							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  4a99							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  4a99							; 3/4 of the time between echoes. The SID doesn't echo.
     11  4a99							;
     12  4a99							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  4a99							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  4a99							; or a keytar button).
     15  4a99							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  4a99							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  4a99
     18  4a99		       00 10	   RP_SLOTS   equ	16
     19  4a99		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  4a99
     21  4a99							; REPEAT is on now?
     22  4a99				   RepeatActive
     23  4a99		       ad 58 c5 	      lda	repeatOn
     24  4a9c		       0d b8 c4 	      ora	actCnt+A_REPEAT
     25  4a9f		       60		      rts
