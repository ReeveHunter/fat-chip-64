      3  0ec0							; Scan the whole matrix, turn changes into key events.
      4  0ec0							;
      5  0ec0							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0ec0							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0ec0							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0ec0							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0ec0							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0ec0							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0ec0							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0ec0							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0ec0							; chords whose ghost lands on another used key lose their newest note.
     14  0ec0				   KeyScan
     15  0ec0					      subroutine
     16  0ec0		       a2 07		      ldx	#7
     17  0ec2				   .col
     18  0ec2		       bd 6e 77 	      lda	colSelect,x
     19  0ec5		       8d 00 dc 	      sta	CIA1_PRA
     20  0ec8		       ad 01 dc 	      lda	CIA1_PRB
     21  0ecb		       49 ff		      eor	#$FF
     22  0ecd		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0ed0		       9d 80 c2 	      sta	keyNow,x
     24  0ed3		       ca		      dex
     25  0ed4		       10 ec		      bpl	.col
     26  0ed6		       a9 ff		      lda	#$FF
     27  0ed8		       8d 00 dc 	      sta	CIA1_PRA
     28  0edb							; ---- every column as accepted (nothing pressed or let go): done
     29  0edb		       a2 07		      ldx	#7
     30  0edd				   .same
     31  0edd		       bd 80 c2 	      lda	keyNow,x
     32  0ee0		       dd 90 c2 	      cmp	keyAcc,x
     33  0ee3		       d0 04		      bne	.changed
     34  0ee5		       ca		      dex
     35  0ee6		       10 f5		      bpl	.same
     36  0ee8		       60		      rts
     37  0ee9				   .changed
     38  0ee9							; ---- releases first: accepted keys that are up now
     39  0ee9		       a2 00		      ldx	#0
     40  0eeb				   .rc
     41  0eeb		       8e 37 c3 	      stx	ksCol
     42  0eee		       bd 80 c2 	      lda	keyNow,x
     43  0ef1		       49 ff		      eor	#$FF
     44  0ef3		       3d 90 c2 	      and	keyAcc,x
