    370  3973							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    371  3973							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    372  3973							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    373  3973							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    374  3973		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    375  3977		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    376  397e		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    377  3985		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    378  398a		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    379  398e		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    380  3992		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
    381  3997		       05 0a 0f 14*uTremRH    .byte.b	>1311, >2621, >3932, >5243, >6554
    382  399c		       04 08 0c 10 uDetT      .byte.b	4, 8, 12, 16
    383  39a0		       18 38 64    uWarbT     .byte.b	24, 56, 100
    384  39a3							; ... and the Game Boy's CCs for them (LFO depth CC 1, rate CC 76, delay
    385  39a3							; CC 79, glide CC 5, detune +- from 64 on CC 94)
