------- FILE main.asm
------- FILE viz.asm LEVEL 2 PASS 3
      0  667b					      include	"viz.asm"
      1  667b							; Fat Chip 64 - the visualizers (F7: BARS, GLITCH, back to play), demos
      2  667b							;
      3  667b							; BARS:
      4  667b							; Nine bars, one per voice, in three groups: SID, Game Boy, MidiNES. A new
      5  667b							; note throws its bar to the top; it falls back to a height set by the
      6  667b							; note's pitch (higher notes stand taller) while the note sounds, and to
      7  667b							; nothing when it stops. The tremolo makes the bars breathe. Each bar takes
      8  667b							; the colour of its note's pitch class (C red ... B white). Kick drums flash
      9  667b							; the border in the key's colour; row 24 has the sound, the tempo and, while
     10  667b							; a beat plays, which beat of the bar it's on.
     11  667b							;
     12  667b							; One bar is drawn per screen step (about every 8 ms), so the screen stays
     13  667b							; out of the way of the keyboard and the arp: about 13 frames a second.
     14  667b							;
     15  667b							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
     16  667b							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
     17  667b							; keep spattering more; runs of the screen get copied over other places
     18  667b							; (datamosh) and wiped away, so it fills while you play and dissolves when
     19  667b							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
     20  667b							; the background. VINYL STOP drags it down the screen.
     21  667b
     22  667b		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     23  667b		       00 16	   VIZ_NAMES  equ	22	; note names
     24  667b		       00 a0	   VIZ_FULL   equ	160	; reversed space
     25  667b		       00 62	   VIZ_HALF   equ	98	; lower half block
     26  667b
