     65  0b9c		       8d 04 de 	      sta	ACIA_CTRL
     66  0b9f		       68		      pla
     67  0ba0		       40		      rti
     68  0ba1		       16 96	   midiCtl    .byte.b	ACIA_MODE, ACIA_MODE_RX
     69  0ba3		       91 d4	   irqLo      .byte.b	<Irq, <IrqMidi
     70  0ba5		       0a 0a	   irqHi      .byte.b	>Irq, >IrqMidi
     71  0ba7		       ff ff	   latchLo    .byte.b	<TICK_LATCH, <TICK_LATCH_MS
     72  0ba9		       00 03	   latchHi    .byte.b	>TICK_LATCH, >TICK_LATCH_MS
     73  0bab
     74  0bab							; IRQ: send one wire byte if the ACIA is ready.
     75  0bab				   TxByte
     76  0bab					      subroutine
     77  0bab		       a6 16		      ldx	wireTail
     78  0bad		       e4 15		      cpx	wireHead
     79  0baf		       f0 0f		      beq	.done
     80  0bb1		       ad 06 de 	      lda	ACIA_STAT
     81  0bb4		       29 02		      and	#ACIA_TDRE
     82  0bb6		       f0 08		      beq	.done
     83  0bb8		       bd 00 c0 	      lda	wireBuf,x
     84  0bbb		       8d 05 de 	      sta	ACIA_TX
