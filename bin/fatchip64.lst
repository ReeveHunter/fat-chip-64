      0  0eb7					      include	"voices.asm"
      1  0eb7							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  0eb7							;
      3  0eb7							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  0eb7							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  0eb7							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  0eb7							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  0eb7							; Allocation, whenever the held notes change:
      8  0eb7							;   1. bass voices play the lowest note, an octave down
      9  0eb7							;   2. every other note gets one voice, lowest notes first
     10  0eb7							;   3. leftover voices stack on the lowest two notes, alternating
     11  0eb7							; So one note = a nine-voice unison across three chips, and in chords the
     12  0eb7							; bottom of the chord is fattest. Disabled devices get no notes.
     13  0eb7
     14  0eb7							; ------------------------------------------------------------ SID
     15  0eb7				   SidInit
     16  0eb7					      subroutine
     17  0eb7		       a2 18		      ldx	#24
     18  0eb9		       a9 00		      lda	#0
     19  0ebb				   .clr
     20  0ebb		       9d 00 d4 	      sta	SID,x
     21  0ebe		       ca		      dex
     22  0ebf		       10 fa		      bpl	.clr
     23  0ec1		       20 e4 0e 	      jsr	SidVolume
     24  0ec4		       a2 02		      ldx	#2
     25  0ec6				   .v
     26  0ec6		       bc c7 1c 	      ldy	sidOfs,x
     27  0ec9		       a9 19		      lda	#$19	; attack 1, decay 9
     28  0ecb		       99 05 d4 	      sta	SID+5,y
     29  0ece		       a9 c9		      lda	#$C9	; sustain 12, release 9
     30  0ed0		       99 06 d4 	      sta	SID+6,y
     31  0ed3		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     32  0ed5		       99 03 d4 	      sta	SID+3,y
     33  0ed8		       a9 20		      lda	#$20	; sawtooth, gate off
     34  0eda		       9d 19 c3 	      sta	sidGate,x
     35  0edd		       99 04 d4 	      sta	SID+4,y
     36  0ee0		       ca		      dex
     37  0ee1		       10 e3		      bpl	.v
     38  0ee3		       60		      rts
