    252  0cff				   WirePut
    253  0cff					      subroutine
    254  0cff		       a6 15		      ldx	wireHead
    255  0d01		       9d 00 c0 	      sta	wireBuf,x
    256  0d04		       e6 15		      inc	wireHead
