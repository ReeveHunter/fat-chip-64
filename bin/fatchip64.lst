    882 Ucf79		       00	   beatLoop   ds	1	; loops of the cycle played (A<->B)
    883 Ucf7a		       00	   cycLen     ds	1	; the cycle (the time signature over the beat's 32 steps)
    884 Ucf7b		       00 00 00 00*cycSrc     ds	32	;  each step's place in the beat
    885 Ucf9b		       00 00 00 00*cycPos     ds	32	;  its place in its bar
    886 Ucfbb		       00 00 00 00*cycBar     ds	32	;  which bar
    887 Ucfdb		       00	   hitLo      ds	1	; this step's lanes (bit = LANES order: kick .. hi hat)
    888 Ucfdc		       00	   hitHi      ds	1	;  (open hat .. clave)
    889 Ucfdd		       00	   hitSt      ds	1	; its accent: 0 soft, 1 normal, 2 strong
    890 Ucfde		       00	   hitFill    ds	1	; (a fill: the levels are its own)
    891 Ucfdf		       00	   tripK      ds	1	; triplet hats: the next of the beat's three (3 = none)
    892 Ucfe0		       00	   tripJ      ds	1	;  the first one's place in the layer's 12
    893 Ucfe1		       00 00	   tripMs     ds	2	;  a third of a beat, ms
    894 Ucfe3		       00	   tripAtL    ds	1
    895 Ucfe4		       00	   tripAtH    ds	1
    896 Ucfe5		       00	   gbKitSent  ds	1	; the Game Boy drum kit (CC 70) last sent + 1 (0: not yet)
    897 Ucfe6		       00	   gbHatSent  ds	1	; its HATS (CC 71) + 1
    898 Ucfe7				   ramEnd     ds	0
    899 Ucfe7				  -	      if	ramEnd > $D000
    900 Ucfe7				  -	      echo	"RAM variables run past $D000 (the I/O)"
    901 Ucfe7				  -	      err
    902 Ucfe7					      endif
