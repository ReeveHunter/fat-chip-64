     35  47a8		       a9 01		      lda	#1
     36  47aa		       8d 40 c6 	      sta	vizKick	; (the visualizer's border flash)
     37  47ad				   .nk
     38  47ad		       ad 27 c3 	      lda	devOn+DEV_NES
     39  47b0		       d0 01		      bne	.on
     40  47b2		       60		      rts
