    456  60e1		       ad 54 c8 	      lda	fineTune
    457  60e4		       38		      sec
    458  60e5		       e9 32		      sbc	#50
    459  60e7		       18		      clc
    460  60e8		       7d fe 61 	      adc	scCents,x
    461  60eb		       50 00		      bvc	.c	; (can't overflow: -85..+60)
    462  60ed				   .c
    463  60ed		       cd 55 c8 	      cmp	tuneC
    464  60f0		       f0 1b		      beq	.k
    465  60f2		       8d 55 c8 	      sta	tuneC
