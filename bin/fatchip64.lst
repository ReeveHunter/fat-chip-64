     33  1ab5		       a9 19		      lda	#$19	; attack 1, decay 9
     34  1ab7		       99 05 d4 	      sta	SID+5,y
     35  1aba		       a9 c9		      lda	#$C9	; sustain 12, release 9
     36  1abc		       99 06 d4 	      sta	SID+6,y
     37  1abf		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     38  1ac1		       99 03 d4 	      sta	SID+3,y
     39  1ac4		       a9 20		      lda	#$20	; sawtooth, gate off
     40  1ac6		       9d f6 c7 	      sta	sidGate,x
