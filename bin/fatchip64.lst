    144  2fa7							; A full message: rxStatus, rxD1, rxD2
    145  2fa7				   MidiInMsg
    146  2fa7					      subroutine
    147  2fa7		       ad 26 c4 	      lda	rxStatus
    148  2faa		       29 0f		      and	#15
