------- FILE main.asm LEVEL 1 PASS 3
      1  c5fd ????						; Fat Chip 64 - main program
      2  c5fd ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  c5fd ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  c5fd ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  c5fd ????
      6  c5fd ????				      processor	6502
