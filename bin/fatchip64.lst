    103  0c43							; IRQ: pace device queues onto the wire.
    104  0c43							;
    105  0c43							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0c43							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0c43							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0c43							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0c43							;
    110  0c43							; When the Game Boy is on, everything on the wire also passes through the
    111  0c43							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0c43							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0c43							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0c43							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0c43							; message, the rate measured clean.
    116  0c43				   Schedule
    117  0c43					      subroutine
    118  0c43		       ad 2a c7 	      lda	devOn+DEV_GB
    119  0c46		       f0 10		      beq	.gb
    120  0c48		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0c4a		       f0 0c		      beq	.gb
    122  0c4c		       c6 2e		      dec	linkLoad
    123  0c4e		       f0 08		      beq	.gb
    124  0c50		       a5 10		      lda	ticks
    125  0c52		       29 01		      and	#1
    126  0c54		       f0 02		      beq	.gb
    127  0c56		       c6 2e		      dec	linkLoad
    128  0c58				   .gb
    129  0c58							; ---- Game Boy
    130  0c58		       a5 18		      lda	gbqTail
    131  0c5a		       c5 17		      cmp	gbqHead
    132  0c5c		       f0 36		      beq	.nes
    133  0c5e		       a5 19		      lda	gbNext
    134  0c60		       38		      sec
    135  0c61		       e5 10		      sbc	ticks
    136  0c63		       f0 04		      beq	.gbDue
    137  0c65		       c9 04		      cmp	#GB_GAP+1
    138  0c67		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0c69				   .gbDue
    140  0c69							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0c69							; bytes already waiting would otherwise delay this one and squeeze it
    142  0c69							; against the next). While a Game Boy message is due, the NES doesn't
    143  0c69							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0c69							; holding its notes back.
    145  0c69		       a5 15		      lda	wireHead
    146  0c6b		       c5 16		      cmp	wireTail
    147  0c6d		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0c6f		       20 d5 0c 	      jsr	LinkRoom
    149  0c72		       90 20		      bcc	.nes
    150  0c74		       a6 18		      ldx	gbqTail
    151  0c76		       bd 00 c5 	      lda	gbqS,x
    152  0c79		       bc 80 c5 	      ldy	gbqD2,x
    153  0c7c		       84 2c		      sty	irqT
    154  0c7e		       bc 40 c5 	      ldy	gbqD1,x
    155  0c81		       20 f1 0c 	      jsr	WireMsg
    156  0c84		       a5 18		      lda	gbqTail
    157  0c86		       18		      clc
    158  0c87		       69 01		      adc	#1
    159  0c89		       29 3f		      and	#63
    160  0c8b		       85 18		      sta	gbqTail
    161  0c8d		       a5 10		      lda	ticks
    162  0c8f		       18		      clc
    163  0c90		       69 03		      adc	#GB_GAP
    164  0c92		       85 19		      sta	gbNext
    165  0c94				   .nes
    166  0c94		       20 4e 3a 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0c97		       a5 1b		      lda	nesqTail
    168  0c99		       c5 1a		      cmp	nesqHead
    169  0c9b		       f0 37		      beq	.done
    170  0c9d		       a5 1c		      lda	nesNext
    171  0c9f		       38		      sec
    172  0ca0		       e5 10		      sbc	ticks
    173  0ca2		       f0 04		      beq	.nesDue
    174  0ca4		       c9 02		      cmp	#NES_GAP+1
    175  0ca6		       90 2c		      bcc	.done
    176  0ca8				   .nesDue
    177  0ca8		       20 e8 0c 	      jsr	WireFree
    178  0cab		       c9 03		      cmp	#3
    179  0cad		       90 25		      bcc	.done
