------- FILE main.asm LEVEL 1 PASS 3
      1  ca1f ????						; Fat Chip 64 - main program
      2  ca1f ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  ca1f ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  ca1f ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  ca1f ????
      6  ca1f ????				      processor	6502
