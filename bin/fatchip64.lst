------- FILE drums.asm LEVEL 2 PASS 3
      0  2dd4					      include	"drums.asm"
      1  2dd4							; Fat Chip 64 - drums on the MidiNES
      2  2dd4							;
      3  2dd4							; Two sources, one kit:
      4  2dd4							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  2dd4							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  2dd4							;			   64 = hit, 56 = ghost)
      7  2dd4							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  2dd4							;			   RETURN starts / stops it, at its own tempo (B taps
      9  2dd4							;			   a new one)
     10  2dd4							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  2dd4							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  2dd4							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  2dd4							; a note-on, then a note-off after the sound's length, the level set with
     14  2dd4							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  2dd4							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  2dd4
     17  2dd4		       00 0c	   KIT_SIZE   equ	12
     18  2dd4		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  2dd4		       00 00	   DK_KICK    equ	0
     20  2dd4		       00 01	   DK_SNARE   equ	1
     21  2dd4		       00 02	   DK_CH      equ	2
     22  2dd4		       00 03	   DK_OH      equ	3
     23  2dd4		       00 04	   DK_CY      equ	4
     24  2dd4		       00 05	   DK_TOM     equ	5
     25  2dd4		       00 06	   DK_PERC    equ	6
     26  2dd4
