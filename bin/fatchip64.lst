     40  083b							; keyboard scan every SCAN_EVERY ms
     41  083b		       a9 00		      lda	#0
     42  083d		       8d 3c c3 	      sta	scanned
     43  0840		       a5 12		      lda	scanAt	; due unless 1..SCAN_EVERY ms to go
     44  0842		       38		      sec
     45  0843		       e5 10		      sbc	ticks
     46  0845		       f0 04		      beq	.scan
     47  0847		       c9 05		      cmp	#SCAN_EVERY+1
     48  0849		       90 1c		      bcc	.noScan
     49  084b				   .scan
     50  084b		       a5 10		      lda	ticks
     51  084d		       18		      clc
     52  084e		       69 04		      adc	#SCAN_EVERY
     53  0850		       85 12		      sta	scanAt
     54  0852		       ee 3c c3 	      inc	scanned
     55  0855		       38		      sec
     56  0856		       e9 02		      sbc	#SCAN_EVERY-2	; (A = ticks + SCAN_EVERY): the screen step at ticks + 2
     57  0858		       d0 02		      bne	.sa
     58  085a		       a9 01		      lda	#1	; (0 means none)
     59  085c				   .sa
