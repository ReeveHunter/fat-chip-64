    355  0ae0							;------------------------------------------------------------- interrupts
    356  0ae0							; Every 1/4 ms: take a MIDI-in byte, feed the ACIA one byte (fast path).
    357  0ae0							; Every fourth time (1 ms):
    358  0ae0							; count a tick and move paced messages onto the wire.
    359  0ae0				   Irq
    360  0ae0					      subroutine
    361  0ae0		       48		      pha
    362  0ae1		       8a		      txa
    363  0ae2		       48		      pha
    364  0ae3		       ad 0d dc 	      lda	CIA1_ICR	; acknowledge
    365  0ae6		       ad 06 de 	      lda	ACIA_STAT	; MIDI in: a received byte? (quick check inline)
    366  0ae9		       4a		      lsr
    367  0aea		       90 03		      bcc	.noRx
    368  0aec		       20 db 39 	      jsr	RxGot
    369  0aef				   .noRx
    370  0aef		       a6 16		      ldx	wireTail
    371  0af1		       e4 15		      cpx	wireHead
    372  0af3		       f0 0f		      beq	.noByte
    373  0af5		       ad 06 de 	      lda	ACIA_STAT
    374  0af8		       29 02		      and	#ACIA_TDRE
    375  0afa		       f0 08		      beq	.noByte
    376  0afc		       bd 00 c0 	      lda	wireBuf,x
    377  0aff		       8d 05 de 	      sta	ACIA_TX
    378  0b02		       e6 16		      inc	wireTail
    379  0b04				   .noByte
    380  0b04		       c6 2d		      dec	subTick
    381  0b06		       10 22		      bpl	.out
    382  0b08		       a9 03		      lda	#3
    383  0b0a		       85 2d		      sta	subTick
