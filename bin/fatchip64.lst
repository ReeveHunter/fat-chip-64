------- FILE main.asm
------- FILE nesfx.asm LEVEL 2 PASS 3
      0  80a3					      include	"nesfx.asm"
      1  80a3							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  80a3							;
      3  80a3							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  80a3							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  80a3							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  80a3							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  80a3							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  80a3							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  80a3							;   glide    a new note starts bent back to the voice's last note and slides
     10  80a3							;	      in the way the SID's does (all three channels)
     11  80a3							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  80a3							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  80a3							; semitone, so these are a little stepped.
     14  80a3
     15  80a3		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  80a3							;  (the pulses, and the triangle while it glides)
     17  80a3
     18  80a3							; A = 1 (not Z) when a NesFxTick step is due
     19  80a3				   NesFxDue
     20  80a3					      subroutine
     21  80a3		       ad 2b c3 	      lda	devOn+DEV_NES
     22  80a6		       f0 1c		      beq	.x
     23  80a8		       ad 0b c6 	      lda	vibDepth
     24  80ab		       0d 39 c5 	      ora	nfxGlide
     25  80ae		       0d 3a c5 	      ora	nfxRun
     26  80b1		       0d f9 c9 	      ora	nfxWarb
     27  80b4		       f0 0e		      beq	.x
     28  80b6		       a5 10		      lda	ticks
     29  80b8		       38		      sec
     30  80b9		       ed 35 c5 	      sbc	nfxLast
     31  80bc		       c9 08		      cmp	#NFX_EVERY
     32  80be		       a9 00		      lda	#0
     33  80c0		       90 02		      bcc	.x
     34  80c2		       a9 01		      lda	#1
     35  80c4				   .x
     36  80c4		       60		      rts
     37  80c5
     38  80c5							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     39  80c5							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     40  80c5							; quick return.
     41  80c5				   NesFxTick
     42  80c5					      subroutine
     43  80c5		       ad 2b c3 	      lda	devOn+DEV_NES
     44  80c8		       f0 0e		      beq	.q
