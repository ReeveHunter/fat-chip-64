      0  0b11					      include	"midi.asm"
      1  0b11							; Fat Chip 64 - MIDI out
      2  0b11							;
      3  0b11							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0b11							; at most one message per device onto the wire buffer, no sooner than that
      5  0b11							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0b11							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0b11							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0b11							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0b11							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0b11
     11  0b11				   MidiInit
     12  0b11					      subroutine
     13  0b11		       a9 03		      lda	#ACIA_RESET
     14  0b13		       8d 04 de 	      sta	ACIA_CTRL
     15  0b16		       a9 16		      lda	#ACIA_MODE
     16  0b18		       8d 04 de 	      sta	ACIA_CTRL
     17  0b1b							; (fall into the test)
     18  0b1b
     19  0b1b							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0b1b							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0b1b							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0b1b							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0b1b							; before. Interrupts are off when this is called.
     24  0b1b				   MidiIrqTest
     25  0b1b					      subroutine
     26  0b1b		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0b1d		       8d 0d dc 	      sta	CIA1_ICR
     28  0b20		       ad 0d dc 	      lda	CIA1_ICR
     29  0b23		       a9 6b		      lda	#<IrqTest
     30  0b25		       8d fe ff 	      sta	$FFFE
     31  0b28		       a9 0b		      lda	#>IrqTest
     32  0b2a		       8d ff ff 	      sta	$FFFF
     33  0b2d		       a9 00		      lda	#0
     34  0b2f		       85 2f		      sta	midiIrq
     35  0b31		       a9 b6		      lda	#ACIA_MODE_TX
     36  0b33		       8d 04 de 	      sta	ACIA_CTRL
     37  0b36		       58		      cli
     38  0b37		       a2 00		      ldx	#0
     39  0b39				   .w
     40  0b39		       ca		      dex
     41  0b3a		       d0 fd		      bne	.w
     42  0b3c		       78		      sei
     43  0b3d		       a6 2f		      ldx	midiIrq
     44  0b3f		       bd 77 0b 	      lda	midiCtl,x
     45  0b42		       8d 04 de 	      sta	ACIA_CTRL
     46  0b45		       bd 79 0b 	      lda	irqLo,x
     47  0b48		       8d fe ff 	      sta	$FFFE
     48  0b4b		       bd 7b 0b 	      lda	irqHi,x
     49  0b4e		       8d ff ff 	      sta	$FFFF
     50  0b51		       bd 7d 0b 	      lda	latchLo,x
     51  0b54		       8d 04 dc 	      sta	CIA1_TALO
     52  0b57		       bd 7f 0b 	      lda	latchHi,x
     53  0b5a		       8d 05 dc 	      sta	CIA1_TAHI
