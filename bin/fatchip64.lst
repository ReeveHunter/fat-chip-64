    130  2791							; A full message: rxStatus, rxD1, rxD2
    131  2791				   MidiInMsg
    132  2791					      subroutine
    133  2791		       ad 27 c4 	      lda	rxStatus
    134  2794		       29 0f		      and	#15
    135  2796		       c9 0f		      cmp	#DRUM_CH_IN	; channel 16: the keytar's rhythm
    136  2798		       d0 1d		      bne	.notes
    137  279a		       ad 27 c4 	      lda	rxStatus
    138  279d		       29 f0		      and	#$F0
    139  279f		       c9 c0		      cmp	#$C0
    140  27a1		       d0 03		      bne	.dr
    141  27a3		       4c c6 3b 	      jmp	KeytarStyle	; its style buttons
    142  27a6				   .dr
    143  27a6		       c9 90		      cmp	#$90
    144  27a8		       d0 40		      bne	.x
    145  27aa		       ad 2a c4 	      lda	rxD2
    146  27ad		       f0 3b		      beq	.x
    147  27af		       ad 91 c4 	      lda	syncDrums	; its drum notes: on the MidiNES if the menu says PLAY
    148  27b2		       f0 36		      beq	.x
    149  27b4		       4c 7c 35 	      jmp	KeytarDrum
    150  27b7				   .notes
    151  27b7		       c9 0b		      cmp	#MIDI_IN_CHANS
    152  27b9		       b0 2f		      bcs	.x	; channels 12-15: the keytar's accompaniment
    153  27bb		       85 27		      sta	t3
    154  27bd		       ad 27 c4 	      lda	rxStatus
    155  27c0		       29 f0		      and	#$F0
    156  27c2		       c9 b0		      cmp	#$B0
