------- FILE main.asm LEVEL 1 PASS 2
      1  1905 ????						; Fat Chip 64 - main program
      2  1905 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  1905 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  1905 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  1905 ????
      6  1905 ????				      processor	6502
