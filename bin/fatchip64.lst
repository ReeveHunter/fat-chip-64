------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  316d					      include	"sounds.asm"
      1  316d							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  316d							;
      3  316d							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  316d							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  316d							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  316d							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  316d							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  316d							;
      9  316d							; Each sound has a mono default and a Fat Bass default:
     10  316d							;   MONO      one note (the last key pressed and still held) on every voice;
     11  316d							;	       a new key while another is held changes the pitch without a
     12  316d							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  316d							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  316d							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  316d							;	       the other voices
     16  316d							;
     17  316d							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  316d							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  316d							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  316d
     21  316d							; ------------------------------------------------------------ choosing
     22  316d							; V: next sound (SHIFT+V: previous)
     23  316d				   SoundKey
     24  316d					      subroutine
     25  316d		       20 e7 31 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3170		       ae 94 c3 	      ldx	soundMode
     27  3173		       ad 2a c3 	      lda	shiftDown
     28  3176		       d0 09		      bne	.prev
     29  3178		       e8		      inx
     30  3179		       e0 13		      cpx	#NUM_SOUNDS
     31  317b		       90 09		      bcc	.s
     32  317d		       a2 00		      ldx	#0
     33  317f		       f0 05		      beq	.s
     34  3181				   .prev
     35  3181		       ca		      dex
     36  3182		       10 02		      bpl	.s
