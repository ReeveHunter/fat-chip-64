------- FILE main.asm
------- FILE viz.asm LEVEL 2 PASS 3
      0  7d49					      include	"viz.asm"
      1  7d49							; Fat Chip 64 - the visualizer (F7: GLITCH on / off; v0.28 dropped the BARS)
      2  7d49							;
      3  7d49							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
      4  7d49							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
      5  7d49							; keep spattering more; runs of the screen get copied over other places
      6  7d49							; (datamosh) and wiped away, so it fills while you play and dissolves when
      7  7d49							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
      8  7d49							; the background. VINYL STOP drags it down the screen.
      9  7d49
     10  7d49		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     11  7d49		       00 16	   VIZ_NAMES  equ	22	; note names
     12  7d49		       00 a0	   VIZ_FULL   equ	160	; reversed space
     13  7d49		       00 62	   VIZ_HALF   equ	98	; lower half block
     14  7d49
