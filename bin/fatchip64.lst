------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  3416					      include	"midiin.asm"
      1  3416							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  3416							;
      3  3416							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  3416							; The main loop parses them (running status; realtime and system bytes are
      5  3416							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  3416							; notes mode, latch, arp and K + note.
      7  3416							;
      8  3416							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  3416							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  3416							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  3416							;
     12  3416							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  3416							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  3416							;
     15  3416							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  3416							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  3416							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  3416							; MIDI in is passed on to the Game Boy or NES.
     19  3416
     20  3416							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  3416							; Uses A, X.
     22  3416							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  3416							; with the time; a Start ($FA) makes the next clock a beat.
     24  3416				   RxByte
     25  3416					      subroutine
     26  3416		       ad 06 de 	      lda	ACIA_STAT
     27  3419		       4a		      lsr		; RDRF -> carry
     28  341a		       90 2b		      bcc	.x
     29  341c				   RxGot
     30  341c		       ad 07 de 	      lda	ACIA_RX
     31  341f		       c9 f8		      cmp	#$F8
     32  3421		       f0 25		      beq	.clk
     33  3423		       c9 fa		      cmp	#$FA
     34  3425		       d0 0e		      bne	.buf
     35  3427		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  3429		       8e e9 c5 	      stx	clkPhase
     37  342c		       8e f1 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  342f							;  the main loop could measure it)
     39  342f		       ae ea c5 	      ldx	clkBeat
     40  3432		       8e fc c5 	      stx	clkStartBeat
     41  3435				   .buf
     42  3435		       ae 25 c4 	      ldx	rxHead
     43  3438		       9d e5 c3 	      sta	rxBuf,x
     44  343b		       e8		      inx
     45  343c		       8a		      txa
     46  343d		       29 3f		      and	#63
     47  343f		       cd 26 c4 	      cmp	rxTail
     48  3442		       f0 03		      beq	.x	; full: dropped
     49  3444		       8d 25 c4 	      sta	rxHead
     50  3447				   .x
     51  3447		       60		      rts
     52  3448				   .clk
     53  3448		       ee e5 c5 	      inc	clkCount
     54  344b		       ae e9 c5 	      ldx	clkPhase
     55  344e		       e8		      inx
     56  344f		       e0 18		      cpx	#24
     57  3451		       90 1b		      bcc	.ph
     58  3453		       a5 10		      lda	ticks
     59  3455		       8d ec c5 	      sta	clkAtL
     60  3458		       a5 11		      lda	ticks+1
     61  345a		       8d ed c5 	      sta	clkAtH
     62  345d		       a5 2d		      lda	subTick
     63  345f		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  3461		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  3463		       ad 05 dc 	      lda	CIA1_TAHI
     66  3466				   .q
     67  3466		       8d ee c5 	      sta	clkAtS
     68  3469		       ee ea c5 	      inc	clkBeat
     69  346c		       a2 00		      ldx	#0
     70  346e				   .ph
     71  346e		       8e e9 c5 	      stx	clkPhase
     72  3471		       60		      rts
