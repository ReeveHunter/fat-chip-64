------- FILE main.asm LEVEL 1 PASS 3
      1  d485 ????						; Fat Chip 64 - main program
      2  d485 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  d485 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  d485 ????						; Build: ./build.sh (dasm makes bin/fatchip64-image.prg; tools/crunch.py packs it
      5  d485 ????						; into bin/fatchip64.prg)
      6  d485 ????
      7  d485 ????				      processor	6502
