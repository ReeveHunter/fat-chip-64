    144  34f8							; A full message: rxStatus, rxD1, rxD2
    145  34f8				   MidiInMsg
    146  34f8					      subroutine
    147  34f8		       ad 27 c4 	      lda	rxStatus
    148  34fb		       29 0f		      and	#15
    149  34fd		       c9 0f		      cmp	#DRUM_CH_IN	; channel 16: the keytar's rhythm
    150  34ff		       d0 1d		      bne	.notes
    151  3501		       ad 27 c4 	      lda	rxStatus
    152  3504		       29 f0		      and	#$F0
    153  3506		       c9 c0		      cmp	#$C0
    154  3508		       d0 03		      bne	.dr
    155  350a		       4c b6 50 	      jmp	KeytarStyle	; its style buttons
    156  350d				   .dr
    157  350d		       c9 90		      cmp	#$90
    158  350f		       d0 47		      bne	.x
    159  3511		       ad 2a c4 	      lda	rxD2
    160  3514		       f0 42		      beq	.x
    161  3516		       ad 91 c4 	      lda	syncDrums	; its drum notes: on the MidiNES if the menu says PLAY
    162  3519		       f0 3d		      beq	.x
    163  351b		       4c b4 49 	      jmp	KeytarDrum
    164  351e				   .notes
    165  351e		       c9 0b		      cmp	#MIDI_IN_CHANS
    166  3520		       b0 36		      bcs	.x	; channels 12-15: the keytar's accompaniment
    167  3522		       85 27		      sta	t3
    168  3524		       ad 27 c4 	      lda	rxStatus
    169  3527		       29 f0		      and	#$F0
    170  3529		       c9 b0		      cmp	#$B0
    171  352b		       d0 03		      bne	.pc
    172  352d		       4c 11 51 	      jmp	KeytarCC	; its vibrato / portamento / sustain buttons
    173  3530				   .pc
    174  3530		       c9 c0		      cmp	#$C0
    175  3532		       d0 03		      bne	.pb
    176  3534		       4c ce 50 	      jmp	KeytarVoice	; its voice buttons
    177  3537				   .pb
    178  3537		       c9 d0		      cmp	#$D0
    179  3539		       d0 03		      bne	.pw
    180  353b		       4c 6c 5f 	      jmp	Breath	; channel pressure: the DH-100's breath
    181  353e				   .pw
    182  353e		       c9 e0		      cmp	#$E0
    183  3540		       d0 03		      bne	.nt
    184  3542		       4c 8b 53 	      jmp	KeytarWheel
