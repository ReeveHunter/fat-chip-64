    124  34a0		       20 c8 34 	      jsr	MidiInMsg
    125  34a3		       4c 42 34 	      jmp	.next
    126  34a6				   .rt
    127  34a6		       c9 fa		      cmp	#$FA
    128  34a8		       d0 06		      bne	.rt2
    129  34aa		       20 3c 50 	      jsr	KeytarStart
    130  34ad		       4c 42 34 	      jmp	.next
    131  34b0				   .rt2
