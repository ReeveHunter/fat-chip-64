    101  8090							; ---- the NES queue needs room
    102  8090		       a5 1a		      lda	nesqHead
    103  8092		       38		      sec
    104  8093		       e5 1b		      sbc	nesqTail
    105  8095		       29 3f		      and	#63
    106  8097		       c9 08		      cmp	#Q_BACKLOG
    107  8099		       b0 54		      bcs	.x
    108  809b							; ---- the next NES voice: a bend if its effects moved
