     34  0e27		       ca		      dex
     35  0e28		       10 f5		      bpl	.same
     36  0e2a		       60		      rts
     37  0e2b				   .changed
     38  0e2b							; ---- releases first: accepted keys that are up now
     39  0e2b		       a2 00		      ldx	#0
     40  0e2d				   .rc
