------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  42ea					      include	"sync.asm"
      1  42ea							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  42ea							;
      3  42ea							; Menu, DEVICE SYNC (defaults first):
      4  42ea							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  42ea							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  42ea							;		     sets the tempo, averaged over beats (the clock jitters about
      7  42ea							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  42ea							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  42ea							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  42ea							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  42ea							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  42ea							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  42ea							;		     picks a beat demo (styleBeat)
     14  42ea							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  42ea							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  42ea							;		     key channel) picks a sound (voiceSound)
     17  42ea							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  42ea							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  42ea							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  42ea							;
     21  42ea							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  42ea							; 1/4 ms); a Start makes the next clock a beat.
     23  42ea
     24  42ea		       00 00	   TEMPO_KEYTAR equ	0
     25  42ea		       00 01	   TEMPO_OWN  equ	1
     26  42ea		       00 02	   TEMPO_SC   equ	2
     27  42ea		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  42ea
     29  42ea
     30  42ea
     31  42ea							; ------------------------------------------------------------ clock
     32  42ea							; Main loop, every pass
     33  42ea				   ClockTick
     34  42ea					      subroutine
     35  42ea		       ad e5 c5 	      lda	clkCount	; any clock lately?
     36  42ed		       cd e6 c5 	      cmp	clkCountSeen
     37  42f0		       f0 15		      beq	.alive
     38  42f2		       8d e6 c5 	      sta	clkCountSeen
     39  42f5		       20 19 1a 	      jsr	GetTicks
