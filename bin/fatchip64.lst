    369  0db1		       a9 ff		      lda	#$FF
    370  0db3				   .cc
    371  0db3		       99 82 c9 	      sta	gbCcS,y
    372  0db6		       88		      dey
    373  0db7		       10 fa		      bpl	.cc
    374  0db9							; first, move the Game Boy's voices to our channels (Fat Chip GB v0.08
    375  0db9							; hears CC 113 on any channel, so its own setting doesn't matter)
    376  0db9		       ad 28 c3 	      lda	gbBase
    377  0dbc		       18		      clc
    378  0dbd		       69 40		      adc	#64
    379  0dbf		       aa		      tax
