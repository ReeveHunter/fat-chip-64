------- FILE main.asm
------- FILE viz.asm LEVEL 2 PASS 3
      0  6602					      include	"viz.asm"
      1  6602							; Fat Chip 64 - the visualizers (F7: BARS, GLITCH, back to play), demos
      2  6602							;
      3  6602							; BARS:
      4  6602							; Nine bars, one per voice, in three groups: SID, Game Boy, MidiNES. A new
      5  6602							; note throws its bar to the top; it falls back to a height set by the
      6  6602							; note's pitch (higher notes stand taller) while the note sounds, and to
      7  6602							; nothing when it stops. The tremolo makes the bars breathe. Each bar takes
      8  6602							; the colour of its note's pitch class (C red ... B white). Kick drums flash
      9  6602							; the border in the key's colour; row 24 has the sound, the tempo and, while
     10  6602							; a beat plays, which beat of the bar it's on.
     11  6602							;
     12  6602							; One bar is drawn per screen step (about every 8 ms), so the screen stays
     13  6602							; out of the way of the keyboard and the arp: about 13 frames a second.
     14  6602							;
     15  6602							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
     16  6602							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
     17  6602							; keep spattering more; runs of the screen get copied over other places
     18  6602							; (datamosh) and wiped away, so it fills while you play and dissolves when
     19  6602							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
     20  6602							; the background. VINYL STOP drags it down the screen.
     21  6602
     22  6602		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     23  6602		       00 16	   VIZ_NAMES  equ	22	; note names
     24  6602		       00 a0	   VIZ_FULL   equ	160	; reversed space
     25  6602		       00 62	   VIZ_HALF   equ	98	; lower half block
     26  6602
