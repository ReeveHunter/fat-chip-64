    144  34b7							; A full message: rxStatus, rxD1, rxD2
    145  34b7				   MidiInMsg
    146  34b7					      subroutine
    147  34b7		       ad 26 c4 	      lda	rxStatus
    148  34ba		       29 0f		      and	#15
