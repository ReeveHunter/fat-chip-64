    202  4c5d		       d0 06		      bne	.send
    203  4c5f				   .vd
    204  4c5f		       c9 02		      cmp	#2
    205  4c61		       d0 02		      bne	.send
    206  4c63		       c6 26		      dec	t2
    207  4c65				   .send
    208  4c65		       a9 03		      lda	#3
    209  4c67		       20 e3 4b 	      jsr	NesChStatus
    210  4c6a		       a5 21		      lda	mS
    211  4c6c		       29 0f		      and	#$0F
    212  4c6e		       8d 83 c4 	      sta	drumKind	; (channel; the kind isn't needed any more)
    213  4c71		       ad 7f c4 	      lda	nzNote	; the last noise note off
    214  4c74		       c9 ff		      cmp	#$FF
    215  4c76		       f0 10		      beq	.vol
    216  4c78		       85 22		      sta	mD1
    217  4c7a		       ad 83 c4 	      lda	drumKind
    218  4c7d		       09 80		      ora	#$80
    219  4c7f		       85 21		      sta	mS
    220  4c81		       a9 00		      lda	#0
    221  4c83		       85 23		      sta	mD2
    222  4c85		       20 58 0d 	      jsr	NesPut
