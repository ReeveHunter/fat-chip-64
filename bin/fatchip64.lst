    169  0b49							; Put a message on the wire (IRQ only): A = status, Y = data 1, irqT = data 2.
    170  0b49							; Program change / channel pressure have one data byte.
    171  0b49				   WireMsg
    172  0b49					      subroutine
    173  0b49		       c5 14		      cmp	lastStatus
    174  0b4b		       f0 05		      beq	.rs
    175  0b4d		       85 14		      sta	lastStatus
    176  0b4f		       20 6c 0b 	      jsr	WirePut
    177  0b52				   .rs
    178  0b52		       98		      tya
    179  0b53		       20 6c 0b 	      jsr	WirePut
    180  0b56		       a5 14		      lda	lastStatus
    181  0b58		       29 e0		      and	#$E0
