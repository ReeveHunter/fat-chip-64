      0  1a8c					      include	"voices.asm"
      1  1a8c							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  1a8c							;
      3  1a8c							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  1a8c							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  1a8c							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  1a8c							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  1a8c							; Allocation, whenever the held notes change. Who comes first (v0.21):
      8  1a8c							; Polyphony > Fat Bass > the patch's effects (REPEAT's echoes) > stacking.
      9  1a8c							;   1. every note gets a voice (SPARKLE's arp pair is what you play, so it
     10  1a8c							;	counts as notes and goes first)
     11  1a8c							;   2. Fat Bass: as many bass voices as are spare play the lowest note,
     12  1a8c							;	folded into the bass range (one note fewer needs a voice, so with
     13  1a8c							;	Fat Bass the bottom of the chord is the bass)
     14  1a8c							;   3. REPEAT's echo voices: one or two of what's still spare
     15  1a8c							;   4. leftover voices stack on the lowest two notes, alternating
     16  1a8c							; So one note = a nine-voice unison across three chips, and in chords the
     17  1a8c							; bottom of the chord is fattest. Disabled devices, and voices the drums
     18  1a8c							; hold (vDrum), get no notes.
     19  1a8c
     20  1a8c							; ------------------------------------------------------------ SID
     21  1a8c				   SidInit
