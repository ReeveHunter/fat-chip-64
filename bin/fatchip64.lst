      0  1f08					      include	"arp.asm"
      1  1f08							; Fat Chip 64 - tempo and arpeggiator
      2  1f08							;
      3  1f08							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1f08							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1f08							;
      6  1f08							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1f08							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1f08							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1f08							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1f08							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1f08							;	     until its voice's next turn.
     12  1f08							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1f08							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1f08							;   J faster; either one also picks FREE).
     15  1f08							;
     16  1f08							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1f08							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1f08
     19  1f08							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1f08							; between the two bytes: $22FF read as $23FF)
     21  1f08				   GetTicks
     22  1f08					      subroutine
     23  1f08		       08		      php
     24  1f09		       78		      sei
     25  1f0a		       a5 10		      lda	ticks
     26  1f0c		       8d 3e c3 	      sta	nowL
     27  1f0f		       a5 11		      lda	ticks+1
     28  1f11		       8d 3f c3 	      sta	nowH
     29  1f14		       28		      plp
     30  1f15		       60		      rts
     31  1f16
