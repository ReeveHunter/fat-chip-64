     85  26f6		       98		      tya
     86  26f7		       10 14		      bpl	.data
     87  26f9		       c9 f8		      cmp	#$F8
     88  26fb		       b0 34		      bcs	.rt	; realtime (clocks are counted by RxByte)
     89  26fd		       c9 f0		      cmp	#$F0
     90  26ff		       90 02		      bcc	.status
     91  2701		       a9 00		      lda	#0	; system: no running status until the next one
     92  2703				   .status
     93  2703		       8d 27 c4 	      sta	rxStatus
     94  2706		       a9 00		      lda	#0
     95  2708		       8d 28 c4 	      sta	rxCnt
     96  270b		       f0 d5		      beq	.next
     97  270d				   .data
     98  270d		       ae 27 c4 	      ldx	rxStatus
     99  2710		       f0 d0		      beq	.next	; no status yet
    100  2712		       ae 28 c4 	      ldx	rxCnt
    101  2715		       d0 2e		      bne	.second
    102  2717		       8d 29 c4 	      sta	rxD1
