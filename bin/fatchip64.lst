     83  3b0f		       bd b1 c8 	      lda	rxBuf,x
     84  3b12		       a8		      tay
     85  3b13		       e8		      inx
     86  3b14		       8a		      txa
     87  3b15		       29 3f		      and	#63
     88  3b17		       8d f2 c8 	      sta	rxTail
     89  3b1a		       98		      tya
     90  3b1b		       10 1e		      bpl	.data
     91  3b1d		       c9 f8		      cmp	#$F8
     92  3b1f		       b0 49		      bcs	.rt	; realtime (clocks are counted by RxByte)
     93  3b21		       c9 f0		      cmp	#$F0
     94  3b23		       b0 07		      bcs	.sys
     95  3b25		       a2 00		      ldx	#0	; a channel message ends any SysEx
     96  3b27		       8e 17 cc 	      stx	sxOn
     97  3b2a		       f0 05		      beq	.status
     98  3b2c				   .sys
     99  3b2c		       20 da 3c 	      jsr	SysexStatus	; F0 starts a SysEx, F7 ends it (v0.20)
    100  3b2f		       a9 00		      lda	#0	; system: no running status until the next one
    101  3b31				   .status
    102  3b31		       8d f3 c8 	      sta	rxStatus
    103  3b34		       a9 00		      lda	#0
    104  3b36		       8d f4 c8 	      sta	rxCnt
    105  3b39		       f0 cb		      beq	.next
    106  3b3b				   .data
    107  3b3b		       ae 17 cc 	      ldx	sxOn
    108  3b3e		       f0 06		      beq	.nosx
    109  3b40		       20 1b 3d 	      jsr	SysexByte
    110  3b43		       4c 06 3b 	      jmp	.next
    111  3b46				   .nosx
    112  3b46		       ae f3 c8 	      ldx	rxStatus
    113  3b49		       f0 bb		      beq	.next	; no status yet
    114  3b4b		       ae f4 c8 	      ldx	rxCnt
    115  3b4e		       d0 2e		      bne	.second
    116  3b50		       8d f5 c8 	      sta	rxD1
    117  3b53		       ee f4 c8 	      inc	rxCnt
    118  3b56		       ad f3 c8 	      lda	rxStatus
    119  3b59		       29 e0		      and	#$E0
    120  3b5b		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
    121  3b5d		       d0 a7		      bne	.next
    122  3b5f		       a9 00		      lda	#0
    123  3b61		       8d f4 c8 	      sta	rxCnt
    124  3b64		       20 8c 3b 	      jsr	MidiInMsg
    125  3b67		       4c 06 3b 	      jmp	.next
    126  3b6a				   .rt
    127  3b6a		       c9 fa		      cmp	#$FA
    128  3b6c		       d0 06		      bne	.rt2
    129  3b6e		       20 e7 5d 	      jsr	KeytarStart
    130  3b71		       4c 06 3b 	      jmp	.next
    131  3b74				   .rt2
    132  3b74		       c9 fc		      cmp	#$FC
    133  3b76		       d0 03		      bne	.rt3
    134  3b78		       20 08 5e 	      jsr	KeytarStop
    135  3b7b				   .rt3
    136  3b7b		       4c 06 3b 	      jmp	.next
    137  3b7e				   .second
    138  3b7e		       8d f6 c8 	      sta	rxD2
    139  3b81		       a9 00		      lda	#0
    140  3b83		       8d f4 c8 	      sta	rxCnt
    141  3b86		       20 8c 3b 	      jsr	MidiInMsg
    142  3b89		       4c 06 3b 	      jmp	.next
    143  3b8c
    144  3b8c							; A full message: rxStatus, rxD1, rxD2
    145  3b8c				   MidiInMsg
    146  3b8c					      subroutine
    147  3b8c		       ad f3 c8 	      lda	rxStatus	; (v0.67: every channel plays; the SHS-10's channel 16
    148  3b8f		       29 0f		      and	#15	;  rhythm and 12-15 accompaniment are gone, see README)
    149  3b91		       85 27		      sta	t3
    150  3b93		       ae 60 fd 	      ldx	padCh	; v0.68: PAD MIDI CHANNEL: its notes play the pads
    151  3b96		       f0 16		      beq	.np
    152  3b98		       ca		      dex
    153  3b99		       e4 27		      cpx	t3
    154  3b9b		       d0 11		      bne	.np
    155  3b9d		       ad f3 c8 	      lda	rxStatus
    156  3ba0		       29 f0		      and	#$F0
    157  3ba2		       c9 90		      cmp	#$90
    158  3ba4		       d0 3c		      bne	.x
    159  3ba6		       ad f6 c8 	      lda	rxD2
    160  3ba9		       f0 37		      beq	.x
    161  3bab		       4c d7 85 	      jmp	PadMidi
    162  3bae				   .np
    163  3bae		       ad f3 c8 	      lda	rxStatus
    164  3bb1		       29 f0		      and	#$F0
    165  3bb3		       c9 b0		      cmp	#$B0
    166  3bb5		       d0 03		      bne	.pc
    167  3bb7		       4c 43 5e 	      jmp	KeytarCC	; CC 1 / 65 / 64 (and the DH-100's buttons)
    168  3bba				   .pc
    169  3bba		       c9 c0		      cmp	#$C0
    170  3bbc		       d0 03		      bne	.pb
    171  3bbe		       4c 1e 5e 	      jmp	KeytarVoice	; PROGRAM CHANGE: a patch (or the DH-100's tones)
    172  3bc1				   .pb
    173  3bc1		       c9 d0		      cmp	#$D0
    174  3bc3		       d0 03		      bne	.pw
    175  3bc5		       4c 62 6d 	      jmp	Breath	; channel pressure: the DH-100's breath
    176  3bc8				   .pw
    177  3bc8		       c9 e0		      cmp	#$E0
