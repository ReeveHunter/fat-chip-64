------- FILE attack.asm LEVEL 2 PASS 3
      0  72ef					      include	"attack.asm"
      1  72ef							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  72ef							; how each note starts and ends in pitch
      3  72ef							;
      4  72ef							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  72ef							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  72ef							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  72ef							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  72ef							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  72ef							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  72ef							;   (v0.42) as long as TIME.
     11  72ef							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  72ef							;   release rings.
     13  72ef
     14  72ef							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  72ef							; jumps to the note
     16  72ef				   AtkStep
     17  72ef					      subroutine
     18  72ef		       ac cb c3 	      ldy	envY
     19  72f2		       b9 75 c9 	      lda	atkT,y
     20  72f5		       18		      clc
     21  72f6		       6d 5e c4 	      adc	fxN
     22  72f9		       90 02		      bcc	.t
     23  72fb		       a9 ff		      lda	#255
     24  72fd				   .t
     25  72fd		       99 75 c9 	      sta	atkT,y
     26  7300		       b9 78 c9 	      lda	clickOn,y
     27  7303		       f0 21		      beq	.s
     28  7305		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  7307		       ae a1 c6 	      ldx	sndClick
     30  730a		       e0 02		      cpx	#2
     31  730c		       90 03		      bcc	.cl
     32  730e		       ad a0 c6 	      lda	sndStepT
     33  7311				   .cl
     34  7311		       d9 75 c9 	      cmp	atkT,y
     35  7314		       f0 02		      beq	.ce
     36  7316		       b0 0e		      bcs	.s
     37  7318				   .ce
     38  7318		       a9 00		      lda	#0
     39  731a		       99 78 c9 	      sta	clickOn,y
     40  731d		       be 6b 82 	      ldx	sidOfs,y
     41  7320		       b9 36 c3 	      lda	sidGate,y
     42  7323		       9d 04 d4 	      sta	SID+4,x
     43  7326				   .s
     44  7326		       b9 6e c9 	      lda	sK,y
     45  7329		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  732b		       d0 19		      bne	.x
     47  732d		       b9 75 c9 	      lda	atkT,y
     48  7330		       cd a0 c6 	      cmp	sndStepT
     49  7333		       90 11		      bcc	.x
     50  7335		       b9 68 c4 	      lda	sidTgtLo,y	; TIME's up: the note
     51  7338		       99 ea c3 	      sta	sidBaseLo,y
     52  733b		       b9 6b c4 	      lda	sidTgtHi,y
     53  733e		       99 ed c3 	      sta	sidBaseHi,y
     54  7341		       a9 00		      lda	#0
