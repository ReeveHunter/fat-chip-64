------- FILE main.asm
------- FILE nesfx.asm LEVEL 2 PASS 3
      0  746d					      include	"nesfx.asm"
      1  746d							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  746d							;
      3  746d							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  746d							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  746d							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  746d							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  746d							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  746d							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  746d							;   glide    a new note starts bent back to the voice's last note and slides
     10  746d							;	      in the way the SID's does (all three channels)
     11  746d							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  746d							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  746d							; semitone, so these are a little stepped.
     14  746d
     15  746d		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  746d							;  (the pulses, and the triangle while it glides)
     17  746d
     18  746d							; A = 1 (not Z) when a NesFxTick step is due
     19  746d				   NesFxDue
     20  746d					      subroutine
     21  746d		       ad 27 c3 	      lda	devOn+DEV_NES
     22  7470		       f0 19		      beq	.x
     23  7472		       ad fe c5 	      lda	vibDepth
     24  7475		       0d 2c c5 	      ora	nfxGlide
     25  7478		       0d 2d c5 	      ora	nfxRun
     26  747b		       f0 0e		      beq	.x
     27  747d		       a5 10		      lda	ticks
     28  747f		       38		      sec
     29  7480		       ed 28 c5 	      sbc	nfxLast
     30  7483		       c9 08		      cmp	#NFX_EVERY
     31  7485		       a9 00		      lda	#0
     32  7487		       90 02		      bcc	.x
     33  7489		       a9 01		      lda	#1
     34  748b				   .x
     35  748b		       60		      rts
     36  748c
     37  748c							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  748c							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  748c							; quick return.
     40  748c				   NesFxTick
     41  748c					      subroutine
     42  748c		       ad 27 c3 	      lda	devOn+DEV_NES
     43  748f		       f0 0b		      beq	.q
     44  7491		       ad fe c5 	      lda	vibDepth
     45  7494		       0d 2c c5 	      ora	nfxGlide
     46  7497		       0d 2d c5 	      ora	nfxRun
     47  749a		       d0 01		      bne	.on
     48  749c				   .q
     49  749c		       60		      rts
     50  749d				   .on
     51  749d		       a5 10		      lda	ticks
     52  749f		       38		      sec
