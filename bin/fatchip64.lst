    204  0a70		       9d 00 c1 	      sta	gbqS,x
    205  0a73		       a5 21		      lda	mD1
    206  0a75		       9d 40 c1 	      sta	gbqD1,x
    207  0a78		       a5 22		      lda	mD2
    208  0a7a		       9d 80 c1 	      sta	gbqD2,x
    209  0a7d		       8a		      txa
    210  0a7e		       18		      clc
    211  0a7f		       69 01		      adc	#1
    212  0a81		       29 3f		      and	#63
