------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  4de8					      include	"sync.asm"
      1  4de8							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  4de8							;
      3  4de8							; Menu, DEVICE SYNC (defaults first):
      4  4de8							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  4de8							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  4de8							;		     sets the tempo, averaged over beats (the clock jitters about
      7  4de8							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  4de8							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  4de8							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  4de8							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  4de8							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  4de8							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  4de8							;		     picks a beat demo (styleBeat)
     14  4de8							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  4de8							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  4de8							;		     key channel) picks a sound (voiceSound)
     17  4de8							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  4de8							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  4de8							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  4de8							;
     21  4de8							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  4de8							; 1/4 ms); a Start makes the next clock a beat.
     23  4de8
     24  4de8		       00 00	   TEMPO_KEYTAR equ	0
     25  4de8		       00 01	   TEMPO_OWN  equ	1
     26  4de8		       00 02	   TEMPO_SC   equ	2
     27  4de8		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  4de8
     29  4de8
     30  4de8
     31  4de8							; ------------------------------------------------------------ clock
     32  4de8							; Main loop, every pass
     33  4de8				   ClockTick
     34  4de8					      subroutine
     35  4de8		       ad e5 c5 	      lda	clkCount	; any clock lately?
     36  4deb		       cd e6 c5 	      cmp	clkCountSeen
