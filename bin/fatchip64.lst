    109  08c2		       38		      sec
    110  08c3		       e5 10		      sbc	ticks
    111  08c5		       f0 04		      beq	.sdue
    112  08c7		       c9 03		      cmp	#3
    113  08c9		       90 37		      bcc	.fx	; 1-2 ms to go
    114  08cb				   .sdue
    115  08cb		       ad 10 c9 	      lda	scrStage	; nothing to draw: the pass is the effects'
    116  08ce		       0d f0 c7 	      ora	screenDirty
