     43  291e		       ad 27 c3 	      lda	devOn+DEV_NES
     44  2921		       f0 f1		      beq	.nope
     45  2923		       bd 6e 82 	      lda	vDev,x
     46  2926		       c9 02		      cmp	#DEV_NES
     47  2928		       d0 ea		      bne	.nope
     48  292a		       bd 97 c3 	      lda	vOut,x
     49  292d		       c9 ff		      cmp	#NO_NOTE
     50  292f		       f0 e3		      beq	.nope
     51  2931		       ad 4b c4 	      lda	nesEnvOn
     52  2934		       f0 78		      beq	.fo	; (no envelope: BEND OUT's fall-off, if any)
     53  2936		       bc 06 29 	      ldy	vEnvSlot,x
     54  2939		       30 41		      bmi	.tri
     55  293b							; pulse: release from the current level; step = level x factor / 4 + 1
     56  293b							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  293b							; about 2 s). Factor 0: no release, cut.
     58  293b		       ad 6e c4 	      lda	envRelV
     59  293e		       f0 6e		      beq	.fo
