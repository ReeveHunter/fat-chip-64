      0  6198					      include	"patchedit.asm"
      1  6198							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  6198							; the dice. The settings and their steps come from tools/gen_menu.py
      3  6198							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  6198							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  6198							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  6198							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  6198							; (EnvDerive).
      8  6198
      9  6198		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  6198		       00 30	   LFO_LAST   equ	FLD_gbLDelay
