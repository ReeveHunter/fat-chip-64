     30  d297 ????	       00 16	   ACIA_MODE  equ	$16	; /64 (31250 baud), 8N1, no interrupts
     31  d297 ????	       00 96	   ACIA_MODE_RX equ	$96	; ... and an interrupt when a byte comes in
     32  d297 ????	       00 b6	   ACIA_MODE_TX equ	$B6	; ... and when the next byte can go out too
     33  d297 ????	       00 02	   ACIA_TDRE  equ	$02	; status: transmit register empty
