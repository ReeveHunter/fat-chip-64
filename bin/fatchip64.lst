    370  0aef							;------------------------------------------------------------- interrupts
    371  0aef							; Every 1/4 ms: take a MIDI-in byte, feed the ACIA one byte (fast path).
    372  0aef							; Every fourth time (1 ms):
    373  0aef							; count a tick and move paced messages onto the wire.
    374  0aef				   Irq
    375  0aef					      subroutine
    376  0aef		       48		      pha
    377  0af0		       8a		      txa
    378  0af1		       48		      pha
    379  0af2		       ad 0d dc 	      lda	CIA1_ICR	; acknowledge
    380  0af5		       ad 06 de 	      lda	ACIA_STAT	; MIDI in: a received byte? (quick check inline)
    381  0af8		       4a		      lsr
    382  0af9		       90 03		      bcc	.noRx
    383  0afb		       20 bd 31 	      jsr	RxGot
    384  0afe				   .noRx
    385  0afe		       a6 16		      ldx	wireTail
    386  0b00		       e4 15		      cpx	wireHead
    387  0b02		       f0 0f		      beq	.noByte
    388  0b04		       ad 06 de 	      lda	ACIA_STAT
    389  0b07		       29 02		      and	#ACIA_TDRE
    390  0b09		       f0 08		      beq	.noByte
    391  0b0b		       bd 00 c0 	      lda	wireBuf,x
    392  0b0e		       8d 05 de 	      sta	ACIA_TX
    393  0b11		       e6 16		      inc	wireTail
    394  0b13				   .noByte
    395  0b13		       c6 2d		      dec	subTick
    396  0b15		       10 17		      bpl	.out
    397  0b17		       a9 03		      lda	#3
    398  0b19		       85 2d		      sta	subTick
    399  0b1b		       98		      tya
    400  0b1c		       48		      pha
    401  0b1d		       e6 10		      inc	ticks
    402  0b1f		       d0 02		      bne	.t
    403  0b21		       e6 11		      inc	ticks+1
    404  0b23				   .t
    405  0b23		       20 2e 0c 	      jsr	Schedule
    406  0b26		       20 09 0c 	      jsr	TxByte	; start a just-scheduled message now if the ACIA is free
    407  0b29		       20 b7 31 	      jsr	RxByte	; (again: this pass was long, a byte may be in)
    408  0b2c		       68		      pla
    409  0b2d		       a8		      tay
    410  0b2e				   .out
    411  0b2e		       68		      pla
    412  0b2f		       aa		      tax
