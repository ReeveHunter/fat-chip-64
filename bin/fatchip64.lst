------- FILE midi.asm LEVEL 2 PASS 3
      0  0ab7					      include	"midi.asm"
      1  0ab7							; Fat Chip 64 - MIDI out
      2  0ab7							;
      3  0ab7							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0ab7							; at most one message per device onto the wire buffer, no sooner than that
      5  0ab7							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0ab7							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0ab7							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0ab7							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0ab7							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0ab7
     11  0ab7				   MidiInit
     12  0ab7					      subroutine
     13  0ab7		       a9 03		      lda	#ACIA_RESET
     14  0ab9		       8d 04 de 	      sta	ACIA_CTRL
     15  0abc		       a9 16		      lda	#ACIA_MODE
     16  0abe		       8d 04 de 	      sta	ACIA_CTRL
     17  0ac1		       60		      rts
     18  0ac2
     19  0ac2							; IRQ: send one wire byte if the ACIA is ready.
     20  0ac2				   TxByte
     21  0ac2					      subroutine
     22  0ac2		       a6 16		      ldx	wireTail
     23  0ac4		       e4 15		      cpx	wireHead
     24  0ac6		       f0 0f		      beq	.done
     25  0ac8		       ad 06 de 	      lda	ACIA_STAT
