------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  3112					      include	"sounds.asm"
      1  3112							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  3112							;
      3  3112							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  3112							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  3112							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  3112							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  3112							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  3112							;
      9  3112							; Each sound has a mono default and a Fat Bass default:
     10  3112							;   MONO      one note (the last key pressed and still held) on every voice;
     11  3112							;	       a new key while another is held changes the pitch without a
     12  3112							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  3112							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  3112							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  3112							;	       the other voices
     16  3112							;
     17  3112							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  3112							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  3112							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  3112
     21  3112							; ------------------------------------------------------------ choosing
     22  3112							; V: next sound (SHIFT+V: previous)
     23  3112				   SoundKey
     24  3112					      subroutine
     25  3112		       20 8c 31 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3115		       ae 94 c3 	      ldx	soundMode
     27  3118		       ad 2a c3 	      lda	shiftDown
     28  311b		       d0 09		      bne	.prev
     29  311d		       e8		      inx
     30  311e		       e0 13		      cpx	#NUM_SOUNDS
     31  3120		       90 09		      bcc	.s
     32  3122		       a2 00		      ldx	#0
     33  3124		       f0 05		      beq	.s
     34  3126				   .prev
