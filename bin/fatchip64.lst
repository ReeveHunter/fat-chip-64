     44  2927		       f0 f1		      beq	.nope
     45  2929		       bd 6e 82 	      lda	vDev,x
     46  292c		       c9 02		      cmp	#DEV_NES
     47  292e		       d0 ea		      bne	.nope
     48  2930		       bd 9f c3 	      lda	vOut,x
     49  2933		       c9 ff		      cmp	#NO_NOTE
     50  2935		       f0 e3		      beq	.nope
     51  2937		       ad 53 c4 	      lda	nesEnvOn
     52  293a		       f0 78		      beq	.fo	; (no envelope: BEND OUT's fall-off, if any)
     53  293c		       bc 0c 29 	      ldy	vEnvSlot,x
     54  293f		       30 41		      bmi	.tri
     55  2941							; pulse: release from the current level; step = level x factor / 4 + 1
     56  2941							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  2941							; about 2 s). Factor 0: no release, cut.
