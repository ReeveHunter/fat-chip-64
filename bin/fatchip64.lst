------- FILE sounds.asm LEVEL 2 PASS 3
      0  3d6b					      include	"sounds.asm"
      1  3d6b							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  3d6b							;
      3  3d6b							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  3d6b							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  3d6b							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  3d6b							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  3d6b							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  3d6b							;
      9  3d6b							; Each sound has a mono default and a Fat Bass default:
     10  3d6b							;   MONO      one note (the last key pressed and still held) on every voice;
     11  3d6b							;	       a new key while another is held changes the pitch without a
     12  3d6b							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  3d6b							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  3d6b							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  3d6b							;	       the other voices
     16  3d6b							;
     17  3d6b							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  3d6b							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  3d6b							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  3d6b
     21  3d6b							; ------------------------------------------------------------ choosing
     22  3d6b							; V: next sound (SHIFT+V: previous)
     23  3d6b				   SoundKey
     24  3d6b					      subroutine
     25  3d6b		       20 fb 3d 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3d6e		       ae 9d c7 	      ldx	soundMode
