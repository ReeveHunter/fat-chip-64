------- FILE devices.asm LEVEL 2 PASS 3
      0  63ff					      include	"devices.asm"
      1  63ff							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  63ff							; are in use, and each one in use gets its page on the main menu.
      3  63ff							;
      4  63ff							; YAMAHA SHS-10 (the keytar)
      5  63ff							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  63ff							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  63ff							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  63ff							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  63ff							;		     can play at once.)
     10  63ff							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  63ff							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  63ff							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  63ff							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  63ff							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  63ff							;		     louder (the SID and the NES; the Game Boy would click) or
     16  63ff							;		     brighter (the SID's filter: switched on if the patch has
     17  63ff							;		     none)
     18  63ff							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  63ff							;		     the patch's, or the ADVANCED amounts if it has none;
     20  63ff							;		     FILTER), or an action held while blowing hard
     21  63ff							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  63ff							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  63ff							;   PORTAMENTO BUTTON	an action (CC 65)
     24  63ff							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  63ff							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  63ff							; ATARI SYNTHCART
     27  63ff							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  63ff							;		     about 3% while held, SHIFT + , . step through the ten
     29  63ff							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  63ff							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  63ff							;		     sound's cents (the Synthcart manual's table: each Atari
     32  63ff							;		     sound plays its scales in its own key, a little off)
     33  63ff							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  63ff
     35  63ff		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  63ff		       00 28	   BREATH_LO  equ	40
     37  63ff		       00 01	   BFX_VIB    equ	1
     38  63ff		       00 02	   BFX_WARB   equ	2
     39  63ff		       00 03	   BFX_DET    equ	3
     40  63ff		       00 04	   BFX_FILT   equ	4
     41  63ff		       00 05	   BFX_HELD   equ	5
     42  63ff
