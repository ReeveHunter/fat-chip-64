------- FILE main.asm
------- FILE voices.asm LEVEL 2 PASS 3
      0  126e					      include	"voices.asm"
      1  126e							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  126e							;
      3  126e							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  126e							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  126e							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  126e							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  126e							; Allocation, whenever the held notes change:
      8  126e							;   1. bass voices play the lowest note, an octave down
      9  126e							;   2. every other note gets one voice, lowest notes first
     10  126e							;   3. leftover voices stack on the lowest two notes, alternating
     11  126e							; So one note = a nine-voice unison across three chips, and in chords the
     12  126e							; bottom of the chord is fattest. Disabled devices get no notes.
     13  126e
     14  126e							; ------------------------------------------------------------ SID
     15  126e				   SidInit
     16  126e					      subroutine
     17  126e		       a2 18		      ldx	#24
     18  1270		       a9 00		      lda	#0
     19  1272				   .clr
