     96  39ea		       a9 7f		      lda	#127
     97  39ec				   .a
     98  39ec		       cd 78 c4 	      cmp	dmcBank
     99  39ef		       f0 0c		      beq	.note
    100  39f1		       8d 78 c4 	      sta	dmcBank
    101  39f4		       85 23		      sta	mD2
    102  39f6		       a9 0e		      lda	#14
    103  39f8		       85 22		      sta	mD1
    104  39fa		       20 d9 0b 	      jsr	NesPut
