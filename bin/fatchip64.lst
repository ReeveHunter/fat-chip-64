------- FILE midiin.asm LEVEL 2 PASS 3
      0  2ec5					      include	"midiin.asm"
      1  2ec5							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  2ec5							;
      3  2ec5							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  2ec5							; The main loop parses them (running status; realtime and system bytes are
      5  2ec5							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  2ec5							; notes mode, latch, arp and K + note.
      7  2ec5							;
      8  2ec5							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  2ec5							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  2ec5							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  2ec5							;
     12  2ec5							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  2ec5							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  2ec5							;
     15  2ec5							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  2ec5							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  2ec5							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  2ec5							; MIDI in is passed on to the Game Boy or NES.
     19  2ec5
     20  2ec5							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  2ec5							; Uses A, X.
     22  2ec5							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  2ec5							; with the time; a Start ($FA) makes the next clock a beat.
     24  2ec5				   RxByte
     25  2ec5					      subroutine
     26  2ec5		       ad 06 de 	      lda	ACIA_STAT
     27  2ec8		       4a		      lsr		; RDRF -> carry
     28  2ec9		       90 2b		      bcc	.x
     29  2ecb				   RxGot
     30  2ecb		       ad 07 de 	      lda	ACIA_RX
     31  2ece		       c9 f8		      cmp	#$F8
     32  2ed0		       f0 25		      beq	.clk
     33  2ed2		       c9 fa		      cmp	#$FA
     34  2ed4		       d0 0e		      bne	.buf
     35  2ed6		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  2ed8		       8e e8 c5 	      stx	clkPhase
     37  2edb		       8e f0 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  2ede							;  the main loop could measure it)
     39  2ede		       ae e9 c5 	      ldx	clkBeat
     40  2ee1		       8e fb c5 	      stx	clkStartBeat
     41  2ee4				   .buf
     42  2ee4		       ae 24 c4 	      ldx	rxHead
     43  2ee7		       9d e4 c3 	      sta	rxBuf,x
     44  2eea		       e8		      inx
     45  2eeb		       8a		      txa
     46  2eec		       29 3f		      and	#63
     47  2eee		       cd 25 c4 	      cmp	rxTail
     48  2ef1		       f0 03		      beq	.x	; full: dropped
     49  2ef3		       8d 24 c4 	      sta	rxHead
     50  2ef6				   .x
     51  2ef6		       60		      rts
     52  2ef7				   .clk
     53  2ef7		       ee e4 c5 	      inc	clkCount
     54  2efa		       ae e8 c5 	      ldx	clkPhase
     55  2efd		       e8		      inx
     56  2efe		       e0 18		      cpx	#24
     57  2f00		       90 1b		      bcc	.ph
     58  2f02		       a5 10		      lda	ticks
     59  2f04		       8d eb c5 	      sta	clkAtL
     60  2f07		       a5 11		      lda	ticks+1
     61  2f09		       8d ec c5 	      sta	clkAtH
     62  2f0c		       a5 2d		      lda	subTick
     63  2f0e		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  2f10		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  2f12		       ad 05 dc 	      lda	CIA1_TAHI
     66  2f15				   .q
     67  2f15		       8d ed c5 	      sta	clkAtS
     68  2f18		       ee e9 c5 	      inc	clkBeat
     69  2f1b		       a2 00		      ldx	#0
     70  2f1d				   .ph
     71  2f1d		       8e e8 c5 	      stx	clkPhase
     72  2f20		       60		      rts
