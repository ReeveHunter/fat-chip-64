      0  4068					      include	"drums.asm"
      1  4068							; Fat Chip 64 - drums on the MidiNES
      2  4068							;
      3  4068							; Two sources, one kit:
      4  4068							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  4068							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  4068							;			   64 = hit, 56 = ghost)
      7  4068							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  4068							;			   RETURN starts / stops it, at its own tempo (B taps
      9  4068							;			   a new one)
     10  4068							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  4068							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  4068							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  4068							; a note-on, then a note-off after the sound's length, the level set with
     14  4068							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  4068							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  4068
     17  4068		       00 0c	   KIT_SIZE   equ	12
     18  4068		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  4068		       00 00	   DK_KICK    equ	0
     20  4068		       00 01	   DK_SNARE   equ	1
     21  4068		       00 02	   DK_CH      equ	2
     22  4068		       00 03	   DK_OH      equ	3
     23  4068		       00 04	   DK_CY      equ	4
     24  4068		       00 05	   DK_TOM     equ	5
     25  4068		       00 06	   DK_PERC    equ	6
     26  4068
     27  4068							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
