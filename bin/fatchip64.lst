------- FILE main.asm LEVEL 1 PASS 3
      1  a8fd ????						; Fat Chip 64 - main program
      2  a8fd ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  a8fd ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  a8fd ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  a8fd ????
      6  a8fd ????				      processor	6502
