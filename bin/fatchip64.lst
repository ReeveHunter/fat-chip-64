------- FILE repeat.asm LEVEL 2 PASS 3
      0  48a3					      include	"repeat.asm"
      1  48a3							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  48a3							;
      3  48a3							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  48a3							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  48a3							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  48a3							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  48a3							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  48a3							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  48a3							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  48a3							; 3/4 of the time between echoes. The SID doesn't echo.
     11  48a3							;
     12  48a3							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  48a3							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  48a3							; or a keytar button).
     15  48a3							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  48a3							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  48a3
     18  48a3		       00 10	   RP_SLOTS   equ	16
     19  48a3		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  48a3
     21  48a3							; REPEAT is on now?
     22  48a3				   RepeatActive
     23  48a3		       ad 4c c5 	      lda	repeatOn
     24  48a6		       0d ac c4 	      ora	actCnt+A_REPEAT
     25  48a9		       60		      rts
