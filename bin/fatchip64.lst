     46  4e37		       c9 05		      cmp	#DK_TOM
     47  4e39		       b0 03		      bcs	.dmc
     48  4e3b		       4c f0 4e 	      jmp	NoiseHit
     49  4e3e				   .dmc
     50  4e3e		       ae 87 c4 	      ldx	drumKind
     51  4e41		       bd d7 4e 	      lda	dmcPrioT,x
     52  4e44		       85 24		      sta	t0
     53  4e46		       ad 3f c3 	      lda	nowL
