      0  5384					      include	"menu.asm"
      1  5384							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  5384							;
      3  5384							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  5384							;   page   RETURN opens a page
      5  5384							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  5384							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  5384							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  5384							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  5384							; device pages, until DEVICES says the device is in use).
     10  5384							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  5384							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  5384							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  5384
     14  5384		       00 17	   MENU_VALCOL equ	23
     15  5384
