    154  0fc6							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    155  0fc6							; keys: some other column has a key in this row and shares another row with
    156  0fc6							; this column.
    157  0fc6				   Suspect
    158  0fc6					      subroutine
    159  0fc6		       ac 38 c3 	      ldy	ksRow
    160  0fc9		       b9 59 78 	      lda	rowBit,y
    161  0fcc		       49 ff		      eor	#$FF
    162  0fce		       ae 37 c3 	      ldx	ksCol
    163  0fd1		       3d 80 c2 	      and	keyNow,x
    164  0fd4		       8d 39 c3 	      sta	ksMask	; this column's other held rows
    165  0fd7		       f0 1c		      beq	.no
    166  0fd9		       a2 07		      ldx	#7
    167  0fdb				   .c
    168  0fdb		       ec 37 c3 	      cpx	ksCol
    169  0fde		       f0 12		      beq	.n
    170  0fe0		       bd 80 c2 	      lda	keyNow,x
    171  0fe3		       39 59 78 	      and	rowBit,y
