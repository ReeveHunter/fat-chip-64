     70  0b9d		       0a 0a	   irqHi      .byte.b	>Irq, >IrqMidi
     71  0b9f		       ff ff	   latchLo    .byte.b	<TICK_LATCH, <TICK_LATCH_MS
     72  0ba1		       00 03	   latchHi    .byte.b	>TICK_LATCH, >TICK_LATCH_MS
