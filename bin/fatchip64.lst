      0  5806					      include	"menu.asm"
      1  5806							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  5806							;
      3  5806							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  5806							;   page   RETURN opens a page
      5  5806							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  5806							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  5806							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  5806							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  5806							; device pages, until DEVICES says the device is in use).
     10  5806							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  5806							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  5806							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  5806
     14  5806		       00 17	   MENU_VALCOL equ	23
     15  5806
