------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  3d8f					      include	"sounds.asm"
      1  3d8f							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  3d8f							;
      3  3d8f							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  3d8f							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  3d8f							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  3d8f							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  3d8f							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  3d8f							;
      9  3d8f							; Each sound has a mono default and a Fat Bass default:
     10  3d8f							;   MONO      one note (the last key pressed and still held) on every voice;
     11  3d8f							;	       a new key while another is held changes the pitch without a
     12  3d8f							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  3d8f							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  3d8f							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  3d8f							;	       the other voices
     16  3d8f							;
     17  3d8f							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  3d8f							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  3d8f							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  3d8f
     21  3d8f							; ------------------------------------------------------------ choosing
     22  3d8f							; V: next sound (SHIFT+V: previous)
     23  3d8f				   SoundKey
     24  3d8f					      subroutine
     25  3d8f		       20 1f 3e 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3d92		       ae 5d c8 	      ldx	soundMode
     27  3d95		       ad ee c7 	      lda	shiftDown
     28  3d98		       d0 09		      bne	.prev
     29  3d9a		       e8		      inx
     30  3d9b		       e0 19		      cpx	#NUM_SOUNDS
     31  3d9d		       90 09		      bcc	.s
     32  3d9f		       a2 00		      ldx	#0
     33  3da1		       f0 05		      beq	.s
     34  3da3				   .prev
     35  3da3		       ca		      dex
     36  3da4		       10 02		      bpl	.s
     37  3da6		       a2 18		      ldx	#NUM_SOUNDS-1
     38  3da8				   .s
