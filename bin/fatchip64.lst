------- FILE screen.asm LEVEL 2 PASS 3
      0  7558					      include	"screen.asm"
      1  7558							; Fat Chip 64 - screen
      2  7558							;
      3  7558							;  row 0      header
      4  7558							;  row 2      sound, POLY / MONO, Fat Bass
      5  7558							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  7558							;	       each plays (row 7: a channel overlap warning)
      7  7558							;  row 9      key, notes mode, latch
      8  7558							;  row 10     arp
      9  7558							;  row 12     tempo, beat, mute
     10  7558							;  row 13     SPACE's action, octave (the lowest key), transpose
     11  7558							;  row 14     v0.40: the effect the C= keys work on, its setting
     12  7558							;  row 15     held notes
     13  7558							;  row 16     MIDI in
     14  7558							;  row 24     F keys
     15  7558
     16  7558							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     17  7558							; Letters become screen codes; bit 7 of t2 reverses.
