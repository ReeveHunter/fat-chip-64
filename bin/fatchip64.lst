      1  0bbe							; Fat Chip 64 - keyboard and RESTORE
      2  0bbe
      3  0bbe							; Scan the whole matrix, turn changes into key events.
      4  0bbe							;
      5  0bbe							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0bbe							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0bbe							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0bbe							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0bbe							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0bbe							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0bbe							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0bbe							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0bbe							; chords whose ghost lands on another used key lose their newest note.
     14  0bbe				   KeyScan
     15  0bbe					      subroutine
     16  0bbe		       a2 07		      ldx	#7
     17  0bc0				   .col
     18  0bc0		       bd 77 1c 	      lda	colSelect,x
     19  0bc3		       8d 00 dc 	      sta	CIA1_PRA
     20  0bc6		       ad 01 dc 	      lda	CIA1_PRB
     21  0bc9		       49 ff		      eor	#$FF
     22  0bcb		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0bce		       9d 80 c2 	      sta	keyNow,x
     24  0bd1		       ca		      dex
     25  0bd2		       10 ec		      bpl	.col
     26  0bd4		       a9 ff		      lda	#$FF
     27  0bd6		       8d 00 dc 	      sta	CIA1_PRA
