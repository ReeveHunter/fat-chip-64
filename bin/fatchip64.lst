     43  27b7		       a2 00		      ldx	#0
     44  27b9				   SpaceSet
     45  27b9		       8e d3 c3 	      stx	spaceAct	; (one held now ends with its own action: spaceHeld)
     46  27bc		       4c cd 13 	      jmp	Dirty
     47  27bf
