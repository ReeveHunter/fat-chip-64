     95  2a67		       c9 16		      cmp	#TRI_FLOOR+1
     96  2a69		       90 36		      bcc	.no	; already at the bottom: just cut
     97  2a6b		       8d 93 c8 	      sta	triNote
     98  2a6e		       a9 00		      lda	#0
     99  2a70		       8d 92 c8 	      sta	triK
    100  2a73		       20 a4 24 	      jsr	GetTicks
    101  2a76		       ad 03 c8 	      lda	nowL
    102  2a79		       8d 94 c8 	      sta	triLast
