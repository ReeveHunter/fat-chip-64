      0  7550					      include	"nesfx.asm"
      1  7550							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7550							;
      3  7550							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7550							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7550							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7550							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7550							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7550							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7550							;   glide    a new note starts bent back to the voice's last note and slides
     10  7550							;	      in the way the SID's does (all three channels)
     11  7550							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7550							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7550							; semitone, so these are a little stepped.
     14  7550
     15  7550		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7550							;  (the pulses, and the triangle while it glides)
     17  7550
     18  7550							; A = 1 (not Z) when a NesFxTick step is due
     19  7550				   NesFxDue
     20  7550					      subroutine
     21  7550		       ad 27 c3 	      lda	devOn+DEV_NES
     22  7553		       f0 19		      beq	.x
     23  7555		       ad fe c5 	      lda	vibDepth
     24  7558		       0d 2c c5 	      ora	nfxGlide
     25  755b		       0d 2d c5 	      ora	nfxRun
     26  755e		       f0 0e		      beq	.x
     27  7560		       a5 10		      lda	ticks
     28  7562		       38		      sec
     29  7563		       ed 28 c5 	      sbc	nfxLast
     30  7566		       c9 08		      cmp	#NFX_EVERY
     31  7568		       a9 00		      lda	#0
     32  756a		       90 02		      bcc	.x
     33  756c		       a9 01		      lda	#1
     34  756e				   .x
     35  756e		       60		      rts
     36  756f
     37  756f							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  756f							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  756f							; quick return.
