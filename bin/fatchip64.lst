------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  304e					      include	"midiin.asm"
      1  304e							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  304e							;
      3  304e							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  304e							; The main loop parses them (running status; realtime and system bytes are
      5  304e							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  304e							; notes mode, latch, arp and K + note.
      7  304e							;
      8  304e							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  304e							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  304e							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  304e							;
     12  304e							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  304e							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  304e							;
     15  304e							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  304e							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  304e							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  304e							; MIDI in is passed on to the Game Boy or NES.
     19  304e
     20  304e							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  304e							; Uses A, X.
     22  304e							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  304e							; with the time; a Start ($FA) makes the next clock a beat.
     24  304e				   RxByte
     25  304e					      subroutine
     26  304e		       ad 06 de 	      lda	ACIA_STAT
     27  3051		       4a		      lsr		; RDRF -> carry
     28  3052		       90 2b		      bcc	.x
     29  3054				   RxGot
     30  3054		       ad 07 de 	      lda	ACIA_RX
     31  3057		       c9 f8		      cmp	#$F8
     32  3059		       f0 25		      beq	.clk
     33  305b		       c9 fa		      cmp	#$FA
     34  305d		       d0 0e		      bne	.buf
     35  305f		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  3061		       8e e8 c5 	      stx	clkPhase
     37  3064		       8e f0 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3067							;  the main loop could measure it)
     39  3067		       ae e9 c5 	      ldx	clkBeat
     40  306a		       8e fb c5 	      stx	clkStartBeat
     41  306d				   .buf
     42  306d		       ae 24 c4 	      ldx	rxHead
     43  3070		       9d e4 c3 	      sta	rxBuf,x
     44  3073		       e8		      inx
     45  3074		       8a		      txa
     46  3075		       29 3f		      and	#63
     47  3077		       cd 25 c4 	      cmp	rxTail
     48  307a		       f0 03		      beq	.x	; full: dropped
