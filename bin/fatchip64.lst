------- FILE main.asm
------- FILE voices.asm LEVEL 2 PASS 3
      0  19f2					      include	"voices.asm"
      1  19f2							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  19f2							;
      3  19f2							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  19f2							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  19f2							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  19f2							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  19f2							; Allocation, whenever the held notes change. Who comes first (v0.21):
      8  19f2							; Polyphony > Fat Bass > the patch's effects (REPEAT's echoes) > stacking.
      9  19f2							;   1. every note gets a voice (SPARKLE's arp pair is what you play, so it
     10  19f2							;	counts as notes and goes first)
     11  19f2							;   2. Fat Bass: as many bass voices as are spare play the lowest note,
     12  19f2							;	folded into the bass range (one note fewer needs a voice, so with
     13  19f2							;	Fat Bass the bottom of the chord is the bass)
     14  19f2							;   3. REPEAT's echo voices: one or two of what's still spare
     15  19f2							;   4. leftover voices stack on the lowest two notes, alternating
     16  19f2							; So one note = a nine-voice unison across three chips, and in chords the
     17  19f2							; bottom of the chord is fattest. Disabled devices, and voices the drums
     18  19f2							; hold (vDrum), get no notes.
     19  19f2
     20  19f2							; ------------------------------------------------------------ SID
     21  19f2				   SidInit
     22  19f2					      subroutine
     23  19f2		       a2 18		      ldx	#24
     24  19f4		       a9 00		      lda	#0
     25  19f6				   .clr
     26  19f6		       9d 00 d4 	      sta	SID,x
     27  19f9		       ca		      dex
     28  19fa		       10 fa		      bpl	.clr
     29  19fc		       20 1f 1a 	      jsr	SidVolume
     30  19ff		       a2 02		      ldx	#2
     31  1a01				   .v
     32  1a01		       bc ae 82 	      ldy	sidOfs,x
     33  1a04		       a9 19		      lda	#$19	; attack 1, decay 9
     34  1a06		       99 05 d4 	      sta	SID+5,y
     35  1a09		       a9 c9		      lda	#$C9	; sustain 12, release 9
     36  1a0b		       99 06 d4 	      sta	SID+6,y
     37  1a0e		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     38  1a10		       99 03 d4 	      sta	SID+3,y
     39  1a13		       a9 20		      lda	#$20	; sawtooth, gate off
     40  1a15		       9d 36 c3 	      sta	sidGate,x
     41  1a18		       99 04 d4 	      sta	SID+4,y
     42  1a1b		       ca		      dex
     43  1a1c		       10 e3		      bpl	.v
     44  1a1e		       60		      rts
     45  1a1f
     46  1a1f							; Volume 15, or 0 (silent, no hum) when the SID is off or muted (M).
     47  1a1f							; Volume 15, or 0 when the SID is off or muted. Keeps the filter mode bits.
     48  1a1f				   SidVolume
     49  1a1f					      subroutine
     50  1a1f		       ad 29 c3 	      lda	devOn+DEV_SID
