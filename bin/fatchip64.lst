------- FILE midi.asm LEVEL 2 PASS 3
      0  0ba8					      include	"midi.asm"
      1  0ba8							; Fat Chip 64 - MIDI out
      2  0ba8							;
      3  0ba8							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0ba8							; at most one message per device onto the wire buffer, no sooner than that
      5  0ba8							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0ba8							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0ba8							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0ba8							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0ba8							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0ba8
     11  0ba8				   MidiInit
     12  0ba8					      subroutine
     13  0ba8		       a9 03		      lda	#ACIA_RESET
     14  0baa		       8d 04 de 	      sta	ACIA_CTRL
     15  0bad		       a9 16		      lda	#ACIA_MODE
     16  0baf		       8d 04 de 	      sta	ACIA_CTRL
     17  0bb2							; (fall into the test)
     18  0bb2
     19  0bb2							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0bb2							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0bb2							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0bb2							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0bb2							; before. Interrupts are off when this is called.
     24  0bb2				   MidiIrqTest
     25  0bb2					      subroutine
     26  0bb2		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0bb4		       8d 0d dc 	      sta	CIA1_ICR
     28  0bb7		       ad 0d dc 	      lda	CIA1_ICR
     29  0bba		       a9 02		      lda	#<IrqTest
     30  0bbc		       8d fe ff 	      sta	$FFFE
     31  0bbf		       a9 0c		      lda	#>IrqTest
     32  0bc1		       8d ff ff 	      sta	$FFFF
     33  0bc4		       a9 00		      lda	#0
     34  0bc6		       85 2f		      sta	midiIrq
     35  0bc8		       a9 b6		      lda	#ACIA_MODE_TX
     36  0bca		       8d 04 de 	      sta	ACIA_CTRL
     37  0bcd		       58		      cli
     38  0bce		       a2 00		      ldx	#0
     39  0bd0				   .w
     40  0bd0		       ca		      dex
     41  0bd1		       d0 fd		      bne	.w
     42  0bd3		       78		      sei
     43  0bd4		       a6 2f		      ldx	midiIrq
     44  0bd6		       bd 0e 0c 	      lda	midiCtl,x
     45  0bd9		       8d 04 de 	      sta	ACIA_CTRL
     46  0bdc		       bd 10 0c 	      lda	irqLo,x
     47  0bdf		       8d fe ff 	      sta	$FFFE
     48  0be2		       bd 12 0c 	      lda	irqHi,x
     49  0be5		       8d ff ff 	      sta	$FFFF
     50  0be8		       bd 14 0c 	      lda	latchLo,x
     51  0beb		       8d 04 dc 	      sta	CIA1_TALO
     52  0bee		       bd 16 0c 	      lda	latchHi,x
     53  0bf1		       8d 05 dc 	      sta	CIA1_TAHI
     54  0bf4		       a9 11		      lda	#$11	; start, force load, continuous
     55  0bf6		       8d 0e dc 	      sta	CIA1_CRA
     56  0bf9		       ad 0d dc 	      lda	CIA1_ICR
     57  0bfc		       a9 81		      lda	#$81	; timer A interrupt on
     58  0bfe		       8d 0d dc 	      sta	CIA1_ICR
     59  0c01		       60		      rts
     60  0c02				   IrqTest
     61  0c02		       48		      pha
     62  0c03		       a9 01		      lda	#1
     63  0c05		       85 2f		      sta	midiIrq
     64  0c07		       a9 16		      lda	#ACIA_MODE	; (quiet again)
     65  0c09		       8d 04 de 	      sta	ACIA_CTRL
     66  0c0c		       68		      pla
     67  0c0d		       40		      rti
     68  0c0e		       16 96	   midiCtl    .byte.b	ACIA_MODE, ACIA_MODE_RX
     69  0c10		       fe 41	   irqLo      .byte.b	<Irq, <IrqMidi
     70  0c12		       0a 0b	   irqHi      .byte.b	>Irq, >IrqMidi
     71  0c14		       ff ff	   latchLo    .byte.b	<TICK_LATCH, <TICK_LATCH_MS
     72  0c16		       00 03	   latchHi    .byte.b	>TICK_LATCH, >TICK_LATCH_MS
