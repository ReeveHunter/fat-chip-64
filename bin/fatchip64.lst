------- FILE main.asm
------- FILE viz.asm LEVEL 2 PASS 3
      0  6ffe					      include	"viz.asm"
      1  6ffe							; Fat Chip 64 - the visualizer (F7: GLITCH on / off; v0.28 dropped the BARS)
      2  6ffe							;
      3  6ffe							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
      4  6ffe							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
      5  6ffe							; keep spattering more; runs of the screen get copied over other places
      6  6ffe							; (datamosh) and wiped away, so it fills while you play and dissolves when
      7  6ffe							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
      8  6ffe							; the background. VINYL STOP drags it down the screen.
      9  6ffe
     10  6ffe		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     11  6ffe		       00 16	   VIZ_NAMES  equ	22	; note names
     12  6ffe		       00 a0	   VIZ_FULL   equ	160	; reversed space
     13  6ffe		       00 62	   VIZ_HALF   equ	98	; lower half block
     14  6ffe
