      0  673b					      include	"patchedit.asm"
      1  673b							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  673b							; the dice. The settings and their steps come from tools/gen_menu.py
      3  673b							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  673b							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  673b							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  673b							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  673b							; (EnvDerive).
      8  673b
      9  673b		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  673b		       00 30	   LFO_LAST   equ	FLD_gbLDelay
     11  673b
