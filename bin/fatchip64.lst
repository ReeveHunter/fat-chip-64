     84  2e15		       a9 ff		      lda	#NO_NOTE
     85  2e17		       9d 13 c3 	      sta	vNote,x
     86  2e1a				   .n
     87  2e1a		       a6 24		      ldx	t0
     88  2e1c		       e8		      inx
     89  2e1d		       e0 09		      cpx	#NUM_VOICES
     90  2e1f		       d0 df		      bne	.v
     91  2e21		       a9 00		      lda	#0
