      0  57ea					      include	"patchedit.asm"
      1  57ea							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  57ea							; the dice. The settings and their steps come from tools/gen_menu.py
      3  57ea							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  57ea							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  57ea							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  57ea							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  57ea							; (EnvDerive).
      8  57ea
      9  57ea		       00 2c	   LFO_FIRST  equ	FLD_gbLDest
     10  57ea		       00 30	   LFO_LAST   equ	FLD_gbLDelay
     11  57ea
