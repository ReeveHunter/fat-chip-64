     78  0889		       8d 02 dc 	      sta	CIA1_DDRA	; port A = keyboard columns out
     79  088c		       a9 00		      lda	#0
     80  088e		       8d 03 dc 	      sta	CIA1_DDRB	; port B = rows in
     81  0891		       a9 ff		      lda	#$FF
     82  0893		       8d 00 dc 	      sta	CIA1_PRA
