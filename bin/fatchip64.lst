    443  686c							; ------------------------------------------------------------ tuning
    444  686c							; tuneC = PLAYING's FINE TUNE + the Synthcart's TUNE TO (while it's in use),
    445  686c							; in cents (-100..+100). The Game Boy gets it as master tune (CC 103), the
    446  686c							; NES in its bends (tuneN, 1/64 semitones), the SID in its note frequencies
    447  686c							; (SidTune; the notes sounding move at once). MATCH KEY sets the key's root
    448  686c							; once, when it changes.
    449  686c				   ScTune
    450  686c					      subroutine
    451  686c		       a9 00		      lda	#0
    452  686e		       ae 44 c8 	      ldx	useSc
