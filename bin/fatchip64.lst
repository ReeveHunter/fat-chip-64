     99  80ac		       ca		      dex
    100  80ad		       10 de		      bpl	.v
    101  80af							; ---- the NES queue needs room
    102  80af		       a5 1a		      lda	nesqHead
    103  80b1		       38		      sec
    104  80b2		       e5 1b		      sbc	nesqTail
    105  80b4		       29 3f		      and	#63
    106  80b6		       c9 08		      cmp	#Q_BACKLOG
    107  80b8		       b0 54		      bcs	.x
    108  80ba							; ---- the next NES voice: a bend if its effects moved
    109  80ba		       ad 3a c5 	      lda	nfxRun	; (a few rounds after an effects change)
    110  80bd		       f0 03		      beq	.r
    111  80bf		       ce 3a c5 	      dec	nfxRun
    112  80c2				   .r
    113  80c2		       ae 36 c5 	      ldx	nfxV	; (2, 5, 8)
    114  80c5		       e8		      inx
