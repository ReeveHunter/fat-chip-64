------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  392b					      include	"midiin.asm"
      1  392b							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  392b							;
      3  392b							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  392b							; The main loop parses them (running status; realtime and system bytes are
      5  392b							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  392b							; notes mode, latch, arp and K + note.
      7  392b							;
      8  392b							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  392b							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  392b							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  392b							;
     12  392b							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  392b							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  392b							;
     15  392b							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  392b							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  392b							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  392b							; MIDI in is passed on to the Game Boy or NES.
     19  392b
     20  392b							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  392b							; Uses A, X.
     22  392b							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  392b							; with the time; a Start ($FA) makes the next clock a beat.
     24  392b				   RxByte
     25  392b					      subroutine
     26  392b		       ad 06 de 	      lda	ACIA_STAT
     27  392e		       4a		      lsr		; RDRF -> carry
     28  392f		       90 2b		      bcc	.x
     29  3931				   RxGot
     30  3931		       ad 07 de 	      lda	ACIA_RX
     31  3934		       c9 f8		      cmp	#$F8
     32  3936		       f0 25		      beq	.clk
     33  3938		       c9 fa		      cmp	#$FA
     34  393a		       d0 0e		      bne	.buf
     35  393c		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  393e		       8e f5 c5 	      stx	clkPhase
     37  3941		       8e fd c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3944							;  the main loop could measure it)
     39  3944		       ae f6 c5 	      ldx	clkBeat
     40  3947		       8e 08 c6 	      stx	clkStartBeat
     41  394a				   .buf
     42  394a		       ae 31 c4 	      ldx	rxHead
     43  394d		       9d f1 c3 	      sta	rxBuf,x
     44  3950		       e8		      inx
     45  3951		       8a		      txa
     46  3952		       29 3f		      and	#63
     47  3954		       cd 32 c4 	      cmp	rxTail
     48  3957		       f0 03		      beq	.x	; full: dropped
     49  3959		       8d 31 c4 	      sta	rxHead
     50  395c				   .x
     51  395c		       60		      rts
     52  395d				   .clk
     53  395d		       ee f1 c5 	      inc	clkCount
     54  3960		       ae f5 c5 	      ldx	clkPhase
     55  3963		       e8		      inx
     56  3964		       e0 18		      cpx	#24
     57  3966		       90 1b		      bcc	.ph
     58  3968		       a5 10		      lda	ticks
     59  396a		       8d f8 c5 	      sta	clkAtL
     60  396d		       a5 11		      lda	ticks+1
     61  396f		       8d f9 c5 	      sta	clkAtH
     62  3972		       a5 2d		      lda	subTick
     63  3974		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  3976		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  3978		       ad 05 dc 	      lda	CIA1_TAHI
     66  397b				   .q
     67  397b		       8d fa c5 	      sta	clkAtS
     68  397e		       ee f6 c5 	      inc	clkBeat
     69  3981		       a2 00		      ldx	#0
     70  3983				   .ph
     71  3983		       8e f5 c5 	      stx	clkPhase
     72  3986		       60		      rts
     73  3987
