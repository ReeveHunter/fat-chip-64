------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  3925					      include	"midiin.asm"
      1  3925							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  3925							;
      3  3925							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  3925							; The main loop parses them (running status; realtime and system bytes are
      5  3925							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  3925							; notes mode, latch, arp and K + note.
      7  3925							;
      8  3925							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  3925							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  3925							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  3925							;
     12  3925							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  3925							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  3925							;
     15  3925							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  3925							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  3925							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  3925							; MIDI in is passed on to the Game Boy or NES.
     19  3925
     20  3925							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  3925							; Uses A, X.
     22  3925							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  3925							; with the time; a Start ($FA) makes the next clock a beat.
     24  3925				   RxByte
     25  3925					      subroutine
     26  3925		       ad 06 de 	      lda	ACIA_STAT
     27  3928		       4a		      lsr		; RDRF -> carry
     28  3929		       90 2b		      bcc	.x
     29  392b				   RxGot
     30  392b		       ad 07 de 	      lda	ACIA_RX
     31  392e		       c9 f8		      cmp	#$F8
     32  3930		       f0 25		      beq	.clk
     33  3932		       c9 fa		      cmp	#$FA
     34  3934		       d0 0e		      bne	.buf
     35  3936		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  3938		       8e ed c5 	      stx	clkPhase
     37  393b		       8e f5 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  393e							;  the main loop could measure it)
     39  393e		       ae ee c5 	      ldx	clkBeat
     40  3941		       8e 00 c6 	      stx	clkStartBeat
     41  3944				   .buf
     42  3944		       ae 29 c4 	      ldx	rxHead
     43  3947		       9d e9 c3 	      sta	rxBuf,x
     44  394a		       e8		      inx
     45  394b		       8a		      txa
     46  394c		       29 3f		      and	#63
     47  394e		       cd 2a c4 	      cmp	rxTail
     48  3951		       f0 03		      beq	.x	; full: dropped
     49  3953		       8d 29 c4 	      sta	rxHead
     50  3956				   .x
     51  3956		       60		      rts
     52  3957				   .clk
     53  3957		       ee e9 c5 	      inc	clkCount
     54  395a		       ae ed c5 	      ldx	clkPhase
     55  395d		       e8		      inx
     56  395e		       e0 18		      cpx	#24
     57  3960		       90 1b		      bcc	.ph
     58  3962		       a5 10		      lda	ticks
     59  3964		       8d f0 c5 	      sta	clkAtL
     60  3967		       a5 11		      lda	ticks+1
     61  3969		       8d f1 c5 	      sta	clkAtH
     62  396c		       a5 2d		      lda	subTick
     63  396e		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  3970		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  3972		       ad 05 dc 	      lda	CIA1_TAHI
     66  3975				   .q
     67  3975		       8d f2 c5 	      sta	clkAtS
     68  3978		       ee ee c5 	      inc	clkBeat
     69  397b		       a2 00		      ldx	#0
     70  397d				   .ph
     71  397d		       8e ed c5 	      stx	clkPhase
     72  3980		       60		      rts
     73  3981
     74  3981							; Main loop, every pass: parse what came in.
     75  3981				   MidiInService
     76  3981					      subroutine
     77  3981				   .next
     78  3981		       ae 2a c4 	      ldx	rxTail
