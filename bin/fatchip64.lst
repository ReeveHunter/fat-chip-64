------- FILE main.asm LEVEL 1 PASS 2
      1  455c ????						; Fat Chip 64 - main program
      2  455c ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  455c ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  455c ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  455c ????
      6  455c ????				      processor	6502
