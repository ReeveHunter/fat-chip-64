    132  7ddb		       bd 97 c3 	      lda	vOut,x
    133  7dde		       c9 ff		      cmp	#NO_NOTE
    134  7de0		       f0 20		      beq	.x
    135  7de2		       20 65 7f 	      jsr	NesFxVal
    136  7de5		       a6 24		      ldx	t0
    137  7de7		       ad 33 c5 	      lda	nfxL
    138  7dea		       dd df c4 	      cmp	nesFxSL,x
    139  7ded		       d0 08		      bne	.send
    140  7def		       ad 34 c5 	      lda	nfxH
    141  7df2		       dd e8 c4 	      cmp	nesFxSH,x
    142  7df5		       f0 0b		      beq	.x
    143  7df7				   .send
