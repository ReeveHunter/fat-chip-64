     44  0b48		       bd 80 0b 	      lda	midiCtl,x
     45  0b4b		       8d 04 de 	      sta	ACIA_CTRL
     46  0b4e		       bd 82 0b 	      lda	irqLo,x
     47  0b51		       8d fe ff 	      sta	$FFFE
     48  0b54		       bd 84 0b 	      lda	irqHi,x
     49  0b57		       8d ff ff 	      sta	$FFFF
     50  0b5a		       bd 86 0b 	      lda	latchLo,x
     51  0b5d		       8d 04 dc 	      sta	CIA1_TALO
     52  0b60		       bd 88 0b 	      lda	latchHi,x
