------- FILE main.asm
    540  e53b				   ioEnd
    541  e53b					      rend
    542  e53b				  -	      if	ioEnd > $DE00
    543  e53b				  -			; (Nmi reads the ACIA at $DE06: if one came while BeatLoad has the I/O
    544  e53b				  -			;  switched out, it would read and write the RAM there: keep data below)
    545  e53b				  -	      echo	"the $D000 data runs past $DE00"
    546  e53b				  -	      err
    547  e53b					      endif
