------- FILE main.asm
------- FILE devices.asm LEVEL 2 PASS 3
      0  657a					      include	"devices.asm"
      1  657a							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  657a							; are in use, and each one in use gets its page on the main menu.
      3  657a							;
      4  657a							; YAMAHA SHS-10 (the keytar)
      5  657a							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  657a							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  657a							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  657a							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  657a							;		     can play at once.)
     10  657a							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  657a							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  657a							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  657a							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  657a							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  657a							;		     louder (the SID and the NES; the Game Boy would click) or
     16  657a							;		     brighter (the SID's filter: switched on if the patch has
     17  657a							;		     none)
     18  657a							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  657a							;		     the patch's, or the ADVANCED amounts if it has none;
     20  657a							;		     FILTER), or an action held while blowing hard
     21  657a							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  657a							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  657a							;   PORTAMENTO BUTTON	an action (CC 65)
     24  657a							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  657a							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  657a							; ATARI SYNTHCART
     27  657a							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  657a							;		     about 3% while held, SHIFT + , . step through the ten
     29  657a							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  657a							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  657a							;		     sound's cents (the Synthcart manual's table: each Atari
     32  657a							;		     sound plays its scales in its own key, a little off)
     33  657a							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  657a
     35  657a		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  657a		       00 28	   BREATH_LO  equ	40
     37  657a		       00 01	   BFX_VIB    equ	1
     38  657a		       00 02	   BFX_WARB   equ	2
     39  657a		       00 03	   BFX_DET    equ	3
     40  657a		       00 04	   BFX_FILT   equ	4
     41  657a		       00 05	   BFX_HELD   equ	5
