     96  79a7		       a9 73		      lda	#115
     97  79a9		       d0 08		      bne	.ok
     98  79ab				   .dn
     99  79ab		       18		      clc
    100  79ac		       7d ce c7 	      adc	vWant,x
    101  79af		       b0 02		      bcs	.ok	; (no borrow: 0 or more)
    102  79b1		       a9 00		      lda	#0
    103  79b3				   .ok
    104  79b3		       20 f6 21 	      jsr	SidPitch	; -> ptr
    105  79b6		       a5 28		      lda	ptr
    106  79b8		       99 aa c8 	      sta	sidBaseLo,y
    107  79bb		       a5 29		      lda	ptr+1
    108  79bd		       99 ad c8 	      sta	sidBaseHi,y
    109  79c0		       ad 61 cb 	      lda	sndPenvK
    110  79c3		       ae 5d cb 	      ldx	sndStep
    111  79c6		       f0 02		      beq	.k
    112  79c8		       a9 ff		      lda	#$FF	; (STEP: held; AtkStep jumps)
    113  79ca				   .k
    114  79ca		       99 2a ce 	      sta	sK,y
    115  79cd				   .x
    116  79cd		       60		      rts
