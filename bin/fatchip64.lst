------- FILE main.asm
------- FILE arp.asm LEVEL 2 PASS 3
      0  1c9b					      include	"arp.asm"
      1  1c9b							; Fat Chip 64 - tempo and arpeggiator
      2  1c9b							;
      3  1c9b							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1c9b							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1c9b							;
      6  1c9b							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1c9b							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1c9b							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1c9b							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1c9b							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1c9b							;	     until its voice's next turn.
     12  1c9b							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1c9b							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1c9b							;   J faster; either one also picks FREE).
     15  1c9b							;
     16  1c9b							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1c9b							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1c9b
     19  1c9b							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1c9b							; between the two bytes: $22FF read as $23FF)
     21  1c9b				   GetTicks
     22  1c9b					      subroutine
     23  1c9b		       08		      php
     24  1c9c		       78		      sei
     25  1c9d		       a5 10		      lda	ticks
     26  1c9f		       8d 3e c3 	      sta	nowL
     27  1ca2		       a5 11		      lda	ticks+1
     28  1ca4		       8d 3f c3 	      sta	nowH
     29  1ca7		       28		      plp
     30  1ca8		       60		      rts
     31  1ca9
     32  1ca9							; ------------------------------------------------------------ tempo
     33  1ca9				   TapTempo
     34  1ca9					      subroutine
     35  1ca9		       20 4b 48 	      jsr	FollowActive	; the keytar's clock sets the tempo: taps do nothing
