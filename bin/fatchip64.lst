------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  547c					      include	"sync.asm"
      1  547c							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  547c							;
      3  547c							; Menu, DEVICE SYNC (defaults first):
      4  547c							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  547c							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  547c							;		     sets the tempo, averaged over beats (the clock jitters about
      7  547c							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  547c							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  547c							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  547c							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  547c							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  547c							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  547c							;		     picks a beat demo (styleBeat)
     14  547c							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  547c							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  547c							;		     key channel) picks a sound (voiceSound)
     17  547c							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  547c							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  547c							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  547c							;
     21  547c							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  547c							; 1/4 ms); a Start makes the next clock a beat.
     23  547c
     24  547c		       00 00	   TEMPO_KEYTAR equ	0
     25  547c		       00 01	   TEMPO_OWN  equ	1
     26  547c		       00 02	   TEMPO_SC   equ	2
     27  547c		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  547c
     29  547c
     30  547c
     31  547c							; ------------------------------------------------------------ clock
     32  547c							; Main loop, every pass
     33  547c				   ClockTick
     34  547c					      subroutine
     35  547c		       ad e9 c5 	      lda	clkCount	; any clock lately?
     36  547f		       cd ea c5 	      cmp	clkCountSeen
