------- FILE sounds.asm LEVEL 2 PASS 3
      0  2645					      include	"sounds.asm"
      1  2645							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  2645							;
      3  2645							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  2645							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  2645							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  2645							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  2645							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  2645							;
      9  2645							; Each sound has a mono default and a Fat Bass default:
     10  2645							;   MONO      one note (the last key pressed and still held) on every voice;
     11  2645							;	       a new key while another is held changes the pitch without a
     12  2645							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  2645							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  2645							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  2645							;	       the other voices
     16  2645							;
     17  2645							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  2645							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  2645							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  2645
     21  2645							; ------------------------------------------------------------ choosing
     22  2645							; V: next sound (SHIFT+V: previous)
     23  2645				   SoundKey
     24  2645					      subroutine
     25  2645		       20 87 26 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  2648		       ae 95 c3 	      ldx	soundMode
     27  264b		       ad 2a c3 	      lda	shiftDown
     28  264e		       d0 09		      bne	.prev
     29  2650		       e8		      inx
     30  2651		       e0 11		      cpx	#NUM_SOUNDS
