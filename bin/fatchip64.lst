    390  3cb9		       d0 13		      bne	.x
    391  3cbb		       ae e9 cc 	      ldx	sxCmd
    392  3cbe		       e0 02		      cpx	#2
    393  3cc0		       f0 0d		      beq	.dev
    394  3cc2		       ae 1a cc 	      ldx	sxPos
    395  3cc5		       e0 db		      cpx	#SX_LEN
