    128  0dd1							; A = key code at ksCol / ksRow
    129  0dd1				   KeyCode
    130  0dd1					      subroutine
    131  0dd1		       ad 37 c3 	      lda	ksCol
    132  0dd4		       0a		      asl
    133  0dd5		       0a		      asl
    134  0dd6		       0a		      asl
    135  0dd7		       0d 38 c3 	      ora	ksRow
    136  0dda		       a8		      tay
    137  0ddb		       b9 f8 4f 	      lda	keymap,y
    138  0dde		       60		      rts
    139  0ddf
    140  0ddf							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    141  0ddf							; keys: some other column has a key in this row and shares another row with
    142  0ddf							; this column.
    143  0ddf				   Suspect
    144  0ddf					      subroutine
    145  0ddf		       ac 38 c3 	      ldy	ksRow
    146  0de2		       b9 f0 4f 	      lda	rowBit,y
    147  0de5		       49 ff		      eor	#$FF
    148  0de7		       ae 37 c3 	      ldx	ksCol
    149  0dea		       3d 80 c2 	      and	keyNow,x
    150  0ded		       8d 39 c3 	      sta	ksMask	; this column's other held rows
    151  0df0		       f0 1c		      beq	.no
    152  0df2		       a2 07		      ldx	#7
    153  0df4				   .c
    154  0df4		       ec 37 c3 	      cpx	ksCol
    155  0df7		       f0 12		      beq	.n
    156  0df9		       bd 80 c2 	      lda	keyNow,x
    157  0dfc		       39 f0 4f 	      and	rowBit,y
    158  0dff		       f0 0a		      beq	.n
    159  0e01		       bd 80 c2 	      lda	keyNow,x
    160  0e04		       2d 39 c3 	      and	ksMask
    161  0e07		       f0 02		      beq	.n
    162  0e09		       38		      sec
    163  0e0a		       60		      rts
    164  0e0b				   .n
    165  0e0b		       ca		      dex
    166  0e0c		       10 e6		      bpl	.c
    167  0e0e				   .no
    168  0e0e		       18		      clc
    169  0e0f		       60		      rts
    170  0e10
    171  0e10							; A = key code
    172  0e10							;   overlay	    notes (K held + a note: set the key)
    173  0e10							;   F1/F3/F5/F7    octave: C4 / C3 / C2 / C1 on the lowest key
    174  0e10							;   SHIFT+F1/F3/F5 SID / Game Boy / MidiNES on-off	SHIFT+F7 panic
    175  0e10							;   CTRL+F3/F5     Game Boy / MidiNES: next channel block
    176  0e10							;   M		    mute everything	   SPACE  per its mode
    177  0e10							;   =		    latch: off <-> on, in the menu's LATCH STYLE
