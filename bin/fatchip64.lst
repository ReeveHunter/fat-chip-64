    149  743f							; voice X's glide offset closer to 0: by off / 2^glideK for each 4 ms step
    150  743f							; (worked out once: d = off >> k, off -= d x n; past 0 or nothing left to
    151  743f							; move by: there). Keeps X.
    152  743f				   NesGlideStep
    153  743f					      subroutine
    154  743f		       bd c3 c4 	      lda	nesGlL,x
