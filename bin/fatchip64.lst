     46  4ddc		       c9 05		      cmp	#DK_TOM
     47  4dde		       b0 03		      bcs	.dmc
     48  4de0		       4c 95 4e 	      jmp	NoiseHit
     49  4de3				   .dmc
     50  4de3		       ae 87 c4 	      ldx	drumKind
     51  4de6		       bd 7c 4e 	      lda	dmcPrioT,x
     52  4de9		       85 24		      sta	t0
     53  4deb		       ad 3f c3 	      lda	nowL
