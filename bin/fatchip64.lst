------- FILE attack.asm LEVEL 2 PASS 3
      0  6846					      include	"attack.asm"
      1  6846							; Fat Chip 64 - ATTACK, BEND IN, BEND OUT (v0.30): how each note starts and
      2  6846							; ends in pitch
      3  6846							;
      4  6846							; ATTACK (the SID): BLIP: an octave up for one BLIP STEP, then the note
      5  6846							;   (OCTAVE + 5TH: an octave, a fifth, the note; 2 OCTAVES: two up, one up,
      6  6846							;   the note); CLICK: the first 20 ms as noise.
      7  6846							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      8  6846							;   a scoop) and bends to its pitch over TIME: the SID and NES slide it (the
      9  6846							;   SID per voice, the NES with its glide), the Game Boy has its own pitch
     10  6846							;   envelope (CC 80 / 81).
     11  6846							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  6846							;   release rings.
     13  6846
     14  6846							; SidFxs pitch loop, SID voice envY: ATTACK's clock; the CLICK ends
     15  6846				   AtkStep
     16  6846					      subroutine
     17  6846		       ac c2 c3 	      ldy	envY
     18  6849		       b9 5e c9 	      lda	atkT,y
     19  684c		       18		      clc
     20  684d		       6d 51 c4 	      adc	fxN
     21  6850		       90 02		      bcc	.t
     22  6852		       a9 ff		      lda	#255
     23  6854				   .t
     24  6854		       99 5e c9 	      sta	atkT,y
     25  6857		       b9 61 c9 	      lda	clickOn,y
     26  685a		       f0 15		      beq	.x
     27  685c		       b9 5e c9 	      lda	atkT,y
