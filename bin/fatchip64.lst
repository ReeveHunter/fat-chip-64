------- FILE main.asm
------- FILE arp.asm LEVEL 2 PASS 3
      0  24ed					      include	"arp.asm"
      1  24ed							; Fat Chip 64 - tempo and arpeggiator
      2  24ed							;
      3  24ed							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  24ed							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  24ed							;
      6  24ed							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  24ed							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  24ed							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  24ed							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  24ed							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  24ed							;	     until its voice's next turn.
     12  24ed							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  24ed							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  24ed							;   J faster; either one also picks FREE).
     15  24ed							;
     16  24ed							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  24ed							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  24ed
     19  24ed							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  24ed							; between the two bytes: $22FF read as $23FF)
     21  24ed				   GetTicks
     22  24ed					      subroutine
     23  24ed		       08		      php
     24  24ee		       78		      sei
     25  24ef		       a5 10		      lda	ticks
     26  24f1		       8d 03 c8 	      sta	nowL
     27  24f4		       a5 11		      lda	ticks+1
     28  24f6		       8d 04 c8 	      sta	nowH
     29  24f9		       28		      plp
     30  24fa		       60		      rts
     31  24fb
