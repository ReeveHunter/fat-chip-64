      0  731e					      include	"nesfx.asm"
      1  731e							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  731e							;
      3  731e							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  731e							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  731e							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  731e							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  731e							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  731e							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  731e							;   glide    a new note starts bent back to the voice's last note and slides
     10  731e							;	      in the way the SID's does (all three channels)
     11  731e							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  731e							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  731e							; semitone, so these are a little stepped.
     14  731e
     15  731e		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  731e							;  (the pulses, and the triangle while it glides)
     17  731e
     18  731e							; A = 1 (not Z) when a NesFxTick step is due
     19  731e				   NesFxDue
     20  731e					      subroutine
     21  731e		       ad 27 c3 	      lda	devOn+DEV_NES
     22  7321		       f0 19		      beq	.x
     23  7323		       ad fe c5 	      lda	vibDepth
     24  7326		       0d 2c c5 	      ora	nfxGlide
     25  7329		       0d 2d c5 	      ora	nfxRun
     26  732c		       f0 0e		      beq	.x
     27  732e		       a5 10		      lda	ticks
     28  7330		       38		      sec
     29  7331		       ed 28 c5 	      sbc	nfxLast
     30  7334		       c9 08		      cmp	#NFX_EVERY
     31  7336		       a9 00		      lda	#0
     32  7338		       90 02		      bcc	.x
     33  733a		       a9 01		      lda	#1
     34  733c				   .x
     35  733c		       60		      rts
     36  733d
