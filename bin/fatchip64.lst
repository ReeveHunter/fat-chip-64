------- FILE main.asm
------- FILE nesfx.asm LEVEL 2 PASS 3
      0  7e86					      include	"nesfx.asm"
      1  7e86							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7e86							;
      3  7e86							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7e86							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7e86							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7e86							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7e86							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7e86							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7e86							;   glide    a new note starts bent back to the voice's last note and slides
     10  7e86							;	      in the way the SID's does (all three channels)
     11  7e86							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7e86							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7e86							; semitone, so these are a little stepped.
     14  7e86
     15  7e86		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7e86							;  (the pulses, and the triangle while it glides)
     17  7e86
     18  7e86							; A = 1 (not Z) when a NesFxTick step is due
     19  7e86				   NesFxDue
     20  7e86					      subroutine
     21  7e86		       ad 27 c3 	      lda	devOn+DEV_NES
     22  7e89		       f0 1c		      beq	.x
