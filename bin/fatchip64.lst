      0  51bc					      include	"patchedit.asm"
      1  51bc							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  51bc							; the dice. The settings and their steps come from tools/gen_menu.py
      3  51bc							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  51bc							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  51bc							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  51bc							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  51bc							; (EnvDerive).
      8  51bc
