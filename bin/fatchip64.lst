------- FILE main.asm
------- FILE voices.asm LEVEL 2 PASS 3
      0  15d8					      include	"voices.asm"
      1  15d8							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  15d8							;
      3  15d8							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  15d8							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  15d8							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  15d8							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  15d8							; Allocation, whenever the held notes change. Who comes first (v0.21):
      8  15d8							; Polyphony > Fat Bass > the patch's effects (REPEAT's echoes) > stacking.
      9  15d8							;   1. every note gets a voice (SPARKLE's arp pair is what you play, so it
     10  15d8							;	counts as notes and goes first)
     11  15d8							;   2. Fat Bass: as many bass voices as are spare play the lowest note,
     12  15d8							;	folded into the bass range (one note fewer needs a voice, so with
     13  15d8							;	Fat Bass the bottom of the chord is the bass)
     14  15d8							;   3. REPEAT's echo voices: one or two of what's still spare
     15  15d8							;   4. leftover voices stack on the lowest two notes, alternating
     16  15d8							; So one note = a nine-voice unison across three chips, and in chords the
     17  15d8							; bottom of the chord is fattest. Disabled devices, and voices the drums
     18  15d8							; hold (vDrum), get no notes.
     19  15d8
     20  15d8							; ------------------------------------------------------------ SID
     21  15d8				   SidInit
     22  15d8					      subroutine
     23  15d8		       a2 18		      ldx	#24
     24  15da		       a9 00		      lda	#0
     25  15dc				   .clr
     26  15dc		       9d 00 d4 	      sta	SID,x
     27  15df		       ca		      dex
     28  15e0		       10 fa		      bpl	.clr
     29  15e2		       20 05 16 	      jsr	SidVolume
     30  15e5		       a2 02		      ldx	#2
     31  15e7				   .v
     32  15e7		       bc a3 76 	      ldy	sidOfs,x
     33  15ea		       a9 19		      lda	#$19	; attack 1, decay 9
     34  15ec		       99 05 d4 	      sta	SID+5,y
     35  15ef		       a9 c9		      lda	#$C9	; sustain 12, release 9
     36  15f1		       99 06 d4 	      sta	SID+6,y
     37  15f4		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     38  15f6		       99 03 d4 	      sta	SID+3,y
     39  15f9		       a9 20		      lda	#$20	; sawtooth, gate off
     40  15fb		       9d 31 c3 	      sta	sidGate,x
     41  15fe		       99 04 d4 	      sta	SID+4,y
     42  1601		       ca		      dex
     43  1602		       10 e3		      bpl	.v
     44  1604		       60		      rts
     45  1605
     46  1605							; Volume 15, or 0 (silent, no hum) when the SID is off or muted (M).
     47  1605							; Volume 15, or 0 when the SID is off or muted. Keeps the filter mode bits.
     48  1605				   SidVolume
     49  1605					      subroutine
     50  1605		       ad 25 c3 	      lda	devOn+DEV_SID
     51  1608		       f0 1a		      beq	.z
