     93  3ac5		       c9 f0		      cmp	#$F0
     94  3ac7		       b0 07		      bcs	.sys
     95  3ac9		       a2 00		      ldx	#0	; a channel message ends any SysEx
     96  3acb		       8e 59 cb 	      stx	sxOn
     97  3ace		       f0 05		      beq	.status
     98  3ad0				   .sys
     99  3ad0		       20 88 3c 	      jsr	SysexStatus	; F0 starts a SysEx, F7 ends it (v0.20)
    100  3ad3		       a9 00		      lda	#0	; system: no running status until the next one
    101  3ad5				   .status
    102  3ad5		       8d 33 c8 	      sta	rxStatus
    103  3ad8		       a9 00		      lda	#0
    104  3ada		       8d 34 c8 	      sta	rxCnt
