------- FILE main.asm
------- FILE menu.asm LEVEL 2 PASS 3
      0  5b7f					      include	"menu.asm"
      1  5b7f							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  5b7f							;
      3  5b7f							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  5b7f							;   page   RETURN opens a page
      5  5b7f							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  5b7f							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  5b7f							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  5b7f							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  5b7f							; device pages, until DEVICES says the device is in use).
     10  5b7f							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  5b7f							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  5b7f							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  5b7f
     14  5b7f		       00 17	   MENU_VALCOL equ	23
     15  5b7f
     16  5b7f				   MenuOpen
     17  5b7f		       20 80 7d 	      jsr	GlitchCalm	; (GLITCH may have the picture shaking)
     18  5b82		       a9 01		      lda	#1
     19  5b84		       8d f7 c9 	      sta	colDirty	; (the play screen's dark rows: light green again)
     20  5b87		       8d 96 c4 	      sta	menuOn
     21  5b8a		       a9 00		      lda	#0
     22  5b8c		       8d 97 c4 	      sta	menuRow
     23  5b8f		       8d f6 c9 	      sta	menuJump
