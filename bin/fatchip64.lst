------- FILE main.asm
------- FILE menu.asm LEVEL 2 PASS 3
      0  60e9					      include	"menu.asm"
      1  60e9							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  60e9							;
      3  60e9							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  60e9							;   page   RETURN opens a page
      5  60e9							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  60e9							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  60e9							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  60e9							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  60e9							; device pages, until DEVICES says the device is in use).
     10  60e9							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  60e9							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  60e9							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  60e9
     14  60e9		       00 17	   MENU_VALCOL equ	23
     15  60e9
     16  60e9				   MenuOpen
     17  60e9		       20 d7 82 	      jsr	GlitchCalm	; (GLITCH may have the picture shaking)
     18  60ec		       a9 01		      lda	#1
     19  60ee		       8d bd ce 	      sta	colDirty	; (the play screen's dark rows: light green again)
     20  60f1		       8d 56 c9 	      sta	menuOn
     21  60f4		       a9 00		      lda	#0
     22  60f6		       8d 57 c9 	      sta	menuRow
     23  60f9		       8d bc ce 	      sta	menuJump
