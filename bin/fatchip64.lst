    109  32e3		       20 bb 34 	      jsr	SysexByte
    110  32e6		       4c a9 32 	      jmp	.next
    111  32e9				   .nosx
    112  32e9		       ae 26 c4 	      ldx	rxStatus
    113  32ec		       f0 bb		      beq	.next	; no status yet
    114  32ee		       ae 27 c4 	      ldx	rxCnt
    115  32f1		       d0 2e		      bne	.second
    116  32f3		       8d 28 c4 	      sta	rxD1
    117  32f6		       ee 27 c4 	      inc	rxCnt
    118  32f9		       ad 26 c4 	      lda	rxStatus
    119  32fc		       29 e0		      and	#$E0
    120  32fe		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
    121  3300		       d0 a7		      bne	.next
    122  3302		       a9 00		      lda	#0
    123  3304		       8d 27 c4 	      sta	rxCnt
    124  3307		       20 2f 33 	      jsr	MidiInMsg
    125  330a		       4c a9 32 	      jmp	.next
