------- FILE main.asm LEVEL 1 PASS 3
      1  83b7 ????						; Fat Chip 64 - main program
      2  83b7 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  83b7 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  83b7 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  83b7 ????
      6  83b7 ????				      processor	6502
