      0  1aab					      include	"voices.asm"
      1  1aab							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  1aab							;
      3  1aab							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  1aab							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  1aab							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  1aab							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  1aab							; Allocation, whenever the held notes change. Who comes first (v0.21):
      8  1aab							; Polyphony > Fat Bass > the patch's effects (REPEAT's echoes) > stacking.
      9  1aab							;   1. every note gets a voice (SPARKLE's arp pair is what you play, so it
     10  1aab							;	counts as notes and goes first)
     11  1aab							;   2. Fat Bass: as many bass voices as are spare play the lowest note,
     12  1aab							;	folded into the bass range (one note fewer needs a voice, so with
     13  1aab							;	Fat Bass the bottom of the chord is the bass)
     14  1aab							;   3. REPEAT's echo voices: one or two of what's still spare
     15  1aab							;   4. leftover voices stack on the lowest two notes, alternating
     16  1aab							; So one note = a nine-voice unison across three chips, and in chords the
     17  1aab							; bottom of the chord is fattest. Disabled devices, and voices the drums
     18  1aab							; hold (vDrum), get no notes.
     19  1aab
     20  1aab							; ------------------------------------------------------------ SID
     21  1aab				   SidInit
     22  1aab					      subroutine
     23  1aab		       a2 18		      ldx	#24
     24  1aad		       a9 00		      lda	#0
