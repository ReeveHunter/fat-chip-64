    456  2599							; ------------------------------------------------------------ the arp clock
    457  2599							; Every main loop pass. Steps when due; starts when notes appear.
    458  2599				   ArpTick
    459  2599					      subroutine
    460  2599		       ad 57 c3 	      lda	arpMode
