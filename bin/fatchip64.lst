      0  0bb8					      include	"midi.asm"
      1  0bb8							; Fat Chip 64 - MIDI out
      2  0bb8							;
      3  0bb8							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0bb8							; at most one message per device onto the wire buffer, no sooner than that
      5  0bb8							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0bb8							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0bb8							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0bb8							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0bb8							; The wire uses running status, except that every Game Boy message carries its
     10  0bb8							; status byte (v0.64). The main loop and the IRQ both feed the ACIA.
     11  0bb8
     12  0bb8				   MidiInit
     13  0bb8					      subroutine
     14  0bb8		       a9 03		      lda	#ACIA_RESET
     15  0bba		       8d 04 de 	      sta	ACIA_CTRL
     16  0bbd		       a9 16		      lda	#ACIA_MODE
     17  0bbf		       8d 04 de 	      sta	ACIA_CTRL
     18  0bc2							; (fall into the test)
     19  0bc2
     20  0bc2							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     21  0bc2							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     22  0bc2							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     23  0bc2							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     24  0bc2							; before. Interrupts are off when this is called.
     25  0bc2				   MidiIrqTest
     26  0bc2					      subroutine
     27  0bc2		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     28  0bc4		       8d 0d dc 	      sta	CIA1_ICR
     29  0bc7		       ad 0d dc 	      lda	CIA1_ICR
     30  0bca		       a9 12		      lda	#<IrqTest
     31  0bcc		       8d fe ff 	      sta	$FFFE
     32  0bcf		       a9 0c		      lda	#>IrqTest
     33  0bd1		       8d ff ff 	      sta	$FFFF
     34  0bd4		       a9 00		      lda	#0
     35  0bd6		       85 2f		      sta	midiIrq
     36  0bd8		       a9 b6		      lda	#ACIA_MODE_TX
     37  0bda		       8d 04 de 	      sta	ACIA_CTRL
     38  0bdd		       58		      cli
     39  0bde		       a2 00		      ldx	#0
     40  0be0				   .w
     41  0be0		       ca		      dex
     42  0be1		       d0 fd		      bne	.w
     43  0be3		       78		      sei
     44  0be4		       a6 2f		      ldx	midiIrq
     45  0be6		       bd 1e 0c 	      lda	midiCtl,x
     46  0be9		       8d 04 de 	      sta	ACIA_CTRL
     47  0bec		       bd 20 0c 	      lda	irqLo,x
     48  0bef		       8d fe ff 	      sta	$FFFE
     49  0bf2		       bd 22 0c 	      lda	irqHi,x
     50  0bf5		       8d ff ff 	      sta	$FFFF
     51  0bf8		       bd 24 0c 	      lda	latchLo,x
     52  0bfb		       8d 04 dc 	      sta	CIA1_TALO
     53  0bfe		       bd 26 0c 	      lda	latchHi,x
     54  0c01		       8d 05 dc 	      sta	CIA1_TAHI
     55  0c04		       a9 11		      lda	#$11	; start, force load, continuous
     56  0c06		       8d 0e dc 	      sta	CIA1_CRA
     57  0c09		       ad 0d dc 	      lda	CIA1_ICR
     58  0c0c		       a9 81		      lda	#$81	; timer A interrupt on
     59  0c0e		       8d 0d dc 	      sta	CIA1_ICR
     60  0c11		       60		      rts
