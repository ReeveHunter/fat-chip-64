      0  6baf					      include	"screen.asm"
      1  6baf							; Fat Chip 64 - screen
      2  6baf							;
      3  6baf							;  row 0      header
      4  6baf							;  row 2      sound, POLY / MONO, Fat Bass
      5  6baf							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  6baf							;	       each plays (row 7: a channel overlap warning)
      7  6baf							;  row 9      key, notes mode, latch
      8  6baf							;  row 10     arp
      9  6baf							;  row 12     tempo, beat, mute
     10  6baf							;  row 13     SPACE's action, octave (the lowest key)
     11  6baf							;  row 15     held notes
     12  6baf							;  row 16     MIDI in
     13  6baf							;  row 24     F keys
     14  6baf
     15  6baf							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
