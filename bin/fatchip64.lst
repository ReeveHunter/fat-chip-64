------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  379c					      include	"midiin.asm"
      1  379c							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  379c							;
      3  379c							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  379c							; The main loop parses them (running status; realtime and system bytes are
      5  379c							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  379c							; notes mode, latch, arp and K + note.
      7  379c							;
      8  379c							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  379c							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  379c							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  379c							;
     12  379c							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  379c							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  379c							;
     15  379c							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  379c							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  379c							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  379c							; MIDI in is passed on to the Game Boy or NES.
     19  379c
     20  379c							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  379c							; Uses A, X.
     22  379c							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  379c							; with the time; a Start ($FA) makes the next clock a beat.
     24  379c				   RxByte
     25  379c					      subroutine
     26  379c		       ad 06 de 	      lda	ACIA_STAT
     27  379f		       4a		      lsr		; RDRF -> carry
     28  37a0		       90 2b		      bcc	.x
     29  37a2				   RxGot
