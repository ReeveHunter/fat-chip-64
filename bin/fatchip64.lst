------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  564f					      include	"sync.asm"
      1  564f							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  564f							;
      3  564f							; Menu, DEVICE SYNC (defaults first):
      4  564f							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  564f							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  564f							;		     sets the tempo, averaged over beats (the clock jitters about
      7  564f							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  564f							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  564f							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  564f							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  564f							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  564f							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  564f							;		     picks a beat demo (styleBeat)
     14  564f							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  564f							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  564f							;		     key channel) picks a sound (voiceSound)
     17  564f							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  564f							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  564f							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  564f							;
     21  564f							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  564f							; 1/4 ms); a Start makes the next clock a beat.
     23  564f
     24  564f		       00 00	   TEMPO_KEYTAR equ	0
     25  564f		       00 01	   TEMPO_OWN  equ	1
     26  564f		       00 02	   TEMPO_SC   equ	2
     27  564f		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  564f
     29  564f
     30  564f
