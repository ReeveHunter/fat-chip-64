     89  4619		       85 25		      sta	t1
     90  461b							; bank (CC14 on the sample channel) when it changes
     91  461b		       a9 04		      lda	#4
     92  461d		       20 75 46 	      jsr	NesChStatus	; mS = CC, sample channel
     93  4620		       a9 00		      lda	#0
