     81  3989		       60		      rts
     82  398a				   .byte
     83  398a		       bd e9 c3 	      lda	rxBuf,x
     84  398d		       a8		      tay
     85  398e		       e8		      inx
     86  398f		       8a		      txa
     87  3990		       29 3f		      and	#63
     88  3992		       8d 2a c4 	      sta	rxTail
     89  3995		       98		      tya
     90  3996		       10 1e		      bpl	.data
     91  3998		       c9 f8		      cmp	#$F8
     92  399a		       b0 49		      bcs	.rt	; realtime (clocks are counted by RxByte)
     93  399c		       c9 f0		      cmp	#$F0
     94  399e		       b0 07		      bcs	.sys
     95  39a0		       a2 00		      ldx	#0	; a channel message ends any SysEx
     96  39a2		       8e 51 c7 	      stx	sxOn
     97  39a5		       f0 05		      beq	.status
     98  39a7				   .sys
     99  39a7		       20 5f 3b 	      jsr	SysexStatus	; F0 starts a SysEx, F7 ends it (v0.20)
    100  39aa		       a9 00		      lda	#0	; system: no running status until the next one
    101  39ac				   .status
    102  39ac		       8d 2b c4 	      sta	rxStatus
    103  39af		       a9 00		      lda	#0
    104  39b1		       8d 2c c4 	      sta	rxCnt
    105  39b4		       f0 cb		      beq	.next
    106  39b6				   .data
    107  39b6		       ae 51 c7 	      ldx	sxOn
    108  39b9		       f0 06		      beq	.nosx
    109  39bb		       20 a0 3b 	      jsr	SysexByte
    110  39be		       4c 81 39 	      jmp	.next
    111  39c1				   .nosx
    112  39c1		       ae 2b c4 	      ldx	rxStatus
    113  39c4		       f0 bb		      beq	.next	; no status yet
    114  39c6		       ae 2c c4 	      ldx	rxCnt
    115  39c9		       d0 2e		      bne	.second
    116  39cb		       8d 2d c4 	      sta	rxD1
    117  39ce		       ee 2c c4 	      inc	rxCnt
    118  39d1		       ad 2b c4 	      lda	rxStatus
    119  39d4		       29 e0		      and	#$E0
    120  39d6		       c9 c0		      cmp	#$C0	; program change / channel pressure: one byte
    121  39d8		       d0 a7		      bne	.next
    122  39da		       a9 00		      lda	#0
    123  39dc		       8d 2c c4 	      sta	rxCnt
    124  39df		       20 07 3a 	      jsr	MidiInMsg
    125  39e2		       4c 81 39 	      jmp	.next
    126  39e5				   .rt
    127  39e5		       c9 fa		      cmp	#$FA
    128  39e7		       d0 06		      bne	.rt2
    129  39e9		       20 13 57 	      jsr	KeytarStart
