------- FILE midi.asm LEVEL 2 PASS 3
      0  0b73					      include	"midi.asm"
      1  0b73							; Fat Chip 64 - MIDI out
      2  0b73							;
      3  0b73							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0b73							; at most one message per device onto the wire buffer, no sooner than that
      5  0b73							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0b73							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0b73							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0b73							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0b73							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0b73
     11  0b73				   MidiInit
     12  0b73					      subroutine
     13  0b73		       a9 03		      lda	#ACIA_RESET
     14  0b75		       8d 04 de 	      sta	ACIA_CTRL
     15  0b78		       a9 16		      lda	#ACIA_MODE
     16  0b7a		       8d 04 de 	      sta	ACIA_CTRL
     17  0b7d							; (fall into the test)
     18  0b7d
     19  0b7d							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0b7d							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0b7d							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0b7d							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0b7d							; before. Interrupts are off when this is called.
     24  0b7d				   MidiIrqTest
     25  0b7d					      subroutine
     26  0b7d		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0b7f		       8d 0d dc 	      sta	CIA1_ICR
     28  0b82		       ad 0d dc 	      lda	CIA1_ICR
     29  0b85		       a9 cd		      lda	#<IrqTest
     30  0b87		       8d fe ff 	      sta	$FFFE
     31  0b8a		       a9 0b		      lda	#>IrqTest
     32  0b8c		       8d ff ff 	      sta	$FFFF
     33  0b8f		       a9 00		      lda	#0
     34  0b91		       85 2f		      sta	midiIrq
     35  0b93		       a9 b6		      lda	#ACIA_MODE_TX
     36  0b95		       8d 04 de 	      sta	ACIA_CTRL
     37  0b98		       58		      cli
     38  0b99		       a2 00		      ldx	#0
     39  0b9b				   .w
     40  0b9b		       ca		      dex
     41  0b9c		       d0 fd		      bne	.w
     42  0b9e		       78		      sei
     43  0b9f		       a6 2f		      ldx	midiIrq
     44  0ba1		       bd d9 0b 	      lda	midiCtl,x
     45  0ba4		       8d 04 de 	      sta	ACIA_CTRL
     46  0ba7		       bd db 0b 	      lda	irqLo,x
     47  0baa		       8d fe ff 	      sta	$FFFE
     48  0bad		       bd dd 0b 	      lda	irqHi,x
     49  0bb0		       8d ff ff 	      sta	$FFFF
     50  0bb3		       bd df 0b 	      lda	latchLo,x
     51  0bb6		       8d 04 dc 	      sta	CIA1_TALO
     52  0bb9		       bd e1 0b 	      lda	latchHi,x
     53  0bbc		       8d 05 dc 	      sta	CIA1_TAHI
     54  0bbf		       a9 11		      lda	#$11	; start, force load, continuous
     55  0bc1		       8d 0e dc 	      sta	CIA1_CRA
     56  0bc4		       ad 0d dc 	      lda	CIA1_ICR
     57  0bc7		       a9 81		      lda	#$81	; timer A interrupt on
     58  0bc9		       8d 0d dc 	      sta	CIA1_ICR
     59  0bcc		       60		      rts
     60  0bcd				   IrqTest
     61  0bcd		       48		      pha
     62  0bce		       a9 01		      lda	#1
     63  0bd0		       85 2f		      sta	midiIrq
     64  0bd2		       a9 16		      lda	#ACIA_MODE	; (quiet again)
     65  0bd4		       8d 04 de 	      sta	ACIA_CTRL
     66  0bd7		       68		      pla
     67  0bd8		       40		      rti
     68  0bd9		       16 96	   midiCtl    .byte.b	ACIA_MODE, ACIA_MODE_RX
     69  0bdb		       c9 0c	   irqLo      .byte.b	<Irq, <IrqMidi
     70  0bdd		       0a 0b	   irqHi      .byte.b	>Irq, >IrqMidi
     71  0bdf		       ff ff	   latchLo    .byte.b	<TICK_LATCH, <TICK_LATCH_MS
     72  0be1		       00 03	   latchHi    .byte.b	>TICK_LATCH, >TICK_LATCH_MS
     73  0be3
     74  0be3							; IRQ: send one wire byte if the ACIA is ready.
     75  0be3				   TxByte
     76  0be3					      subroutine
     77  0be3		       a6 16		      ldx	wireTail
     78  0be5		       e4 15		      cpx	wireHead
     79  0be7		       f0 0f		      beq	.done
     80  0be9		       ad 06 de 	      lda	ACIA_STAT
     81  0bec		       29 02		      and	#ACIA_TDRE
