    134  7181		       ad 32 c5 	      lda	nfxL
    135  7184		       dd de c4 	      cmp	nesFxSL,x
    136  7187		       d0 08		      bne	.send
    137  7189		       ad 33 c5 	      lda	nfxH
    138  718c		       dd e7 c4 	      cmp	nesFxSH,x
    139  718f		       f0 0b		      beq	.x
    140  7191				   .send
    141  7191		       a9 01		      lda	#1
