------- FILE screen.asm LEVEL 2 PASS 3
      0  693a					      include	"screen.asm"
      1  693a							; Fat Chip 64 - screen
      2  693a							;
      3  693a							;  row 0      header
      4  693a							;  row 2      sound, POLY / MONO, Fat Bass
      5  693a							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  693a							;	       each plays (row 7: a channel overlap warning)
      7  693a							;  row 9      key, notes mode, latch
      8  693a							;  row 10     arp
      9  693a							;  row 12     tempo, beat, mute
     10  693a							;  row 13     SPACE's action, octave (the lowest key)
     11  693a							;  row 15     held notes
     12  693a							;  row 16     MIDI in
     13  693a							;  row 24     F keys
     14  693a
     15  693a							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     16  693a							; Letters become screen codes; bit 7 of t2 reverses.
     17  693a				   PrintAt
     18  693a					      subroutine
     19  693a		       20 52 69 	      jsr	ScreenAddr
     20  693d		       a0 00		      ldy	#0
     21  693f				   .c
     22  693f		       b1 28		      lda	(ptr),y
     23  6941		       f0 0e		      beq	.done
     24  6943		       c9 40		      cmp	#64
     25  6945		       90 03		      bcc	.noLetter
     26  6947		       38		      sec
     27  6948		       e9 40		      sbc	#64
     28  694a				   .noLetter
     29  694a		       05 26		      ora	t2
     30  694c		       91 2a		      sta	(ptr2),y
     31  694e		       c8		      iny
     32  694f		       d0 ee		      bne	.c
     33  6951				   .done
     34  6951		       60		      rts
     35  6952
