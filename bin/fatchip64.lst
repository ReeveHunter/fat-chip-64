------- FILE sounds.asm LEVEL 2 PASS 3
      0  3a89					      include	"sounds.asm"
      1  3a89							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  3a89							;
      3  3a89							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  3a89							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  3a89							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  3a89							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  3a89							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  3a89							;
      9  3a89							; Each sound has a mono default and a Fat Bass default:
     10  3a89							;   MONO      one note (the last key pressed and still held) on every voice;
     11  3a89							;	       a new key while another is held changes the pitch without a
     12  3a89							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  3a89							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  3a89							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  3a89							;	       the other voices
     16  3a89							;
     17  3a89							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  3a89							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  3a89							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  3a89
     21  3a89							; ------------------------------------------------------------ choosing
     22  3a89							; V: next sound (SHIFT+V: previous)
     23  3a89				   SoundKey
     24  3a89					      subroutine
     25  3a89		       20 14 3b 	      jsr	SoundRelease	; held notes end with the old sound's settings...
