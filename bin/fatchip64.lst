------- FILE main.asm
------- FILE wander.asm LEVEL 2 PASS 3
      0  7007					      include	"wander.asm"
      1  7007							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  7007							;
      3  7007							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  7007							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  7007							;   ATTACK   as always: the new notes start
      6  7007							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  7007							;	      has none)
      8  7007							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  7007							;	      start again
     10  7007							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  7007							;	      late; some glide, some start again (fade out, come back in)
     12  7007							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  7007							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  7007							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  7007							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  7007
     17  7007		       00 01	   CHG_ATTACK equ	1
     18  7007		       00 02	   CHG_GLIDE  equ	2
     19  7007		       00 03	   CHG_STAGGER equ	3
     20  7007		       00 04	   CHG_WANDER equ	4
     21  7007		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  7007		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  7007
     24  7007							; A = the chord change style now (keeps X, Y)
     25  7007				   ChgEff
     26  7007					      subroutine
     27  7007		       ad 65 cc 	      lda	chgMode
     28  700a		       d0 0c		      bne	.x
     29  700c		       ad b3 c7 	      lda	effMode
     30  700f		       c9 02		      cmp	#MODE_DRONE
     31  7011		       d0 03		      bne	.a
