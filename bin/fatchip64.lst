      0  5f46					      include	"screen.asm"
      1  5f46							; Fat Chip 64 - screen
      2  5f46							;
      3  5f46							;  row 0      header
      4  5f46							;  row 2      sound, POLY / MONO, Fat Bass
      5  5f46							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  5f46							;	       each plays (row 7: a channel overlap warning)
      7  5f46							;  row 9      key, notes mode, latch
      8  5f46							;  row 10     arp
      9  5f46							;  row 12     tempo, beat, mute
     10  5f46							;  row 13     SPACE's action, octave (the lowest key)
     11  5f46							;  row 15     held notes
     12  5f46							;  row 16     MIDI in
     13  5f46							;  row 24     F keys
     14  5f46
     15  5f46							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     16  5f46							; Letters become screen codes; bit 7 of t2 reverses.
     17  5f46				   PrintAt
     18  5f46					      subroutine
     19  5f46		       20 5e 5f 	      jsr	ScreenAddr
     20  5f49		       a0 00		      ldy	#0
     21  5f4b				   .c
     22  5f4b		       b1 28		      lda	(ptr),y
     23  5f4d		       f0 0e		      beq	.done
     24  5f4f		       c9 40		      cmp	#64
     25  5f51		       90 03		      bcc	.noLetter
     26  5f53		       38		      sec
     27  5f54		       e9 40		      sbc	#64
     28  5f56				   .noLetter
     29  5f56		       05 26		      ora	t2
     30  5f58		       91 2a		      sta	(ptr2),y
     31  5f5a		       c8		      iny
     32  5f5b		       d0 ee		      bne	.c
     33  5f5d				   .done
     34  5f5d		       60		      rts
     35  5f5e
     36  5f5e							; ptr2 = SCREEN + 40*Y + X (row table: no loop)
     37  5f5e				   ScreenAddr
