     97  740d		       a5 29		      lda	ptr+1
     98  740f		       99 ed c3 	      sta	sidBaseHi,y
     99  7412		       ad a3 c6 	      lda	sndPenvK
    100  7415		       ae 9f c6 	      ldx	sndStep
    101  7418		       f0 02		      beq	.k
    102  741a		       a9 ff		      lda	#$FF	; (STEP: held; AtkStep jumps)
    103  741c				   .k
    104  741c		       99 6e c9 	      sta	sK,y
    105  741f				   .x
    106  741f		       60		      rts
