    387  3a3c		       a2 00		      ldx	#0
    388  3a3e		       8e 4d c7 	      stx	sxOn
    389  3a41		       c9 f7		      cmp	#$F7
    390  3a43		       d0 13		      bne	.x
    391  3a45		       ae 1d c8 	      ldx	sxCmd
    392  3a48		       e0 02		      cpx	#2
    393  3a4a		       f0 0d		      beq	.dev
    394  3a4c		       ae 4e c7 	      ldx	sxPos
    395  3a4f		       e0 d5		      cpx	#SX_LEN
    396  3a51		       d0 05		      bne	.x
    397  3a53		       48		      pha
    398  3a54		       20 ea 3a 	      jsr	PatchReceived
    399  3a57		       68		      pla
    400  3a58				   .x
    401  3a58		       60		      rts
    402  3a59				   .dev
    403  3a59		       ae 4e c7 	      ldx	sxPos
    404  3a5c		       e0 05		      cpx	#5
    405  3a5e		       d0 f8		      bne	.x
    406  3a60		       48		      pha
    407  3a61		       20 c7 3a 	      jsr	DevicesReceived
    408  3a64		       68		      pla
    409  3a65		       60		      rts
    410  3a66
    411  3a66							; A data byte (A) inside a SysEx
    412  3a66				   SysexByte
    413  3a66					      subroutine
    414  3a66		       ae 4e c7 	      ldx	sxPos
    415  3a69		       e0 03		      cpx	#3	; the command: 1 a patch, 2 the chips on / off
    416  3a6b		       d0 0b		      bne	.nc
    417  3a6d		       c9 02		      cmp	#2
    418  3a6f		       d0 07		      bne	.nc
    419  3a71		       8d 1d c8 	      sta	sxCmd
    420  3a74		       ee 4e c7 	      inc	sxPos
    421  3a77		       60		      rts
    422  3a78				   .nc
    423  3a78		       ac 1d c8 	      ldy	sxCmd
    424  3a7b		       c0 02		      cpy	#2
    425  3a7d		       d0 0b		      bne	.pat
    426  3a7f		       e0 04		      cpx	#4	; 2: one byte, bit 0 SID, 1 Game Boy, 2 NES
