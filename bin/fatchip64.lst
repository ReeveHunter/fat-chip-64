------- FILE main.asm
------- FILE voices.asm LEVEL 2 PASS 3
      0  1102					      include	"voices.asm"
      1  1102							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  1102							;
      3  1102							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  1102							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  1102							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  1102							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  1102							; Allocation, whenever the held notes change:
      8  1102							;   1. bass voices play the lowest note, an octave down
      9  1102							;   2. every other note gets one voice, lowest notes first
     10  1102							;   3. leftover voices stack on the lowest two notes, alternating
     11  1102							; So one note = a nine-voice unison across three chips, and in chords the
     12  1102							; bottom of the chord is fattest. Disabled devices get no notes.
     13  1102
     14  1102							; ------------------------------------------------------------ SID
     15  1102				   SidInit
     16  1102					      subroutine
     17  1102		       a2 18		      ldx	#24
     18  1104		       a9 00		      lda	#0
     19  1106				   .clr
     20  1106		       9d 00 d4 	      sta	SID,x
     21  1109		       ca		      dex
     22  110a		       10 fa		      bpl	.clr
     23  110c		       20 2f 11 	      jsr	SidVolume
     24  110f		       a2 02		      ldx	#2
     25  1111				   .v
     26  1111		       bc 28 45 	      ldy	sidOfs,x
     27  1114		       a9 19		      lda	#$19	; attack 1, decay 9
     28  1116		       99 05 d4 	      sta	SID+5,y
     29  1119		       a9 c9		      lda	#$C9	; sustain 12, release 9
     30  111b		       99 06 d4 	      sta	SID+6,y
     31  111e		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     32  1120		       99 03 d4 	      sta	SID+3,y
     33  1123		       a9 20		      lda	#$20	; sawtooth, gate off
     34  1125		       9d 31 c3 	      sta	sidGate,x
     35  1128		       99 04 d4 	      sta	SID+4,y
     36  112b		       ca		      dex
     37  112c		       10 e3		      bpl	.v
     38  112e		       60		      rts
     39  112f
     40  112f							; Volume 15, or 0 (silent, no hum) when the SID is off or muted (M).
     41  112f							; Volume 15, or 0 when the SID is off or muted. Keeps the filter mode bits.
     42  112f				   SidVolume
     43  112f					      subroutine
     44  112f		       ad 25 c3 	      lda	devOn+DEV_SID
     45  1132		       f0 0b		      beq	.z
     46  1134		       ad 90 c3 	      lda	muteNow
     47  1137		       d0 04		      bne	.off
     48  1139		       a9 0f		      lda	#$0F
     49  113b		       d0 02		      bne	.z
     50  113d				   .off
     51  113d		       a9 00		      lda	#0
     52  113f				   .z
     53  113f		       0d b8 c3 	      ora	sidFilt
     54  1142		       8d 18 d4 	      sta	SID_VOL
     55  1145		       60		      rts
     56  1146
     57  1146							; M or SPACE changed: muteNow = mute xor momentary. The SID goes to volume 0;
     58  1146							; the Game Boy and NES get note-offs (so nothing hangs on, and their tails
     59  1146							; ring out naturally), and their notes come back when it unmutes.
     60  1146				   MuteChanged
     61  1146					      subroutine
     62  1146		       ad 41 c4 	      lda	sidMute
