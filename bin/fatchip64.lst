    128  4667		       00 01 00 00*dmcPrioT   .byte.b	0,1,0,0,0,2,3	; kick, snare, -, -, -, tom, perc
    129  466e		       00 03 00 00*kitOfs     .byte.b	0,3,0,0,0,6,9
    130  4675
    131  4675							; mS = control change on MidiNES channel nesBase + A
    132  4675				   NesChStatus
    133  4675					      subroutine
    134  4675		       18		      clc
    135  4676		       6d 29 c3 	      adc	nesBase
    136  4679		       29 0f		      and	#15
