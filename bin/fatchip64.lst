    150  0f07							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    151  0f07							; keys: some other column has a key in this row and shares another row with
    152  0f07							; this column.
    153  0f07				   Suspect
    154  0f07					      subroutine
    155  0f07		       ac 38 c3 	      ldy	ksRow
    156  0f0a		       b9 83 6a 	      lda	rowBit,y
    157  0f0d		       49 ff		      eor	#$FF
    158  0f0f		       ae 37 c3 	      ldx	ksCol
    159  0f12		       3d 80 c2 	      and	keyNow,x
    160  0f15		       8d 39 c3 	      sta	ksMask	; this column's other held rows
    161  0f18		       f0 1c		      beq	.no
    162  0f1a		       a2 07		      ldx	#7
    163  0f1c				   .c
    164  0f1c		       ec 37 c3 	      cpx	ksCol
    165  0f1f		       f0 12		      beq	.n
    166  0f21		       bd 80 c2 	      lda	keyNow,x
    167  0f24		       39 83 6a 	      and	rowBit,y
    168  0f27		       f0 0a		      beq	.n
    169  0f29		       bd 80 c2 	      lda	keyNow,x
    170  0f2c		       2d 39 c3 	      and	ksMask
    171  0f2f		       f0 02		      beq	.n
    172  0f31		       38		      sec
    173  0f32		       60		      rts
    174  0f33				   .n
    175  0f33		       ca		      dex
    176  0f34		       10 e6		      bpl	.c
    177  0f36				   .no
    178  0f36		       18		      clc
