------- FILE main.asm
------- FILE voices.asm LEVEL 2 PASS 2
      0  101f					      include	"voices.asm"
      1  101f							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  101f							;
      3  101f							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  101f							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  101f							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  101f							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  101f							; Allocation, whenever the held notes change:
      8  101f							;   1. bass voices play the lowest note, an octave down
      9  101f							;   2. every other note gets one voice, lowest notes first
     10  101f							;   3. leftover voices stack on the lowest two notes, alternating
     11  101f							; So one note = a nine-voice unison across three chips, and in chords the
     12  101f							; bottom of the chord is fattest. Disabled devices get no notes.
     13  101f
     14  101f							; ------------------------------------------------------------ SID
     15  101f				   SidInit
     16  101f					      subroutine
     17  101f		       a2 18		      ldx	#24
     18  1021		       a9 00		      lda	#0
     19  1023				   .clr
     20  1023		       9d 00 d4 	      sta	SID,x
     21  1026		       ca		      dex
     22  1027		       10 fa		      bpl	.clr
