------- FILE lead.asm LEVEL 2 PASS 3
      0  6fb4					      include	"lead.asm"
      1  6fb4							; Fat Chip 64 - CHORD + LEAD (v0.28): a chord and a lead at once, each its
      2  6fb4							; own patch.
      3  6fb4							;   BASS      (was LOW NOTE) the first key pressed is the chord's root
      4  6fb4							;	       (POLY: just it; SMART CHORD: its 5TH, TRIAD...; DRONE: the
      5  6fb4							;	       drone); every other key is the lead, while the chord key is held
      6  6fb4							;   TRIAD     (was LATCH 3) three keys pressed together are the chord while
      7  6fb4							;	       they're held (v0.36: with LATCH on, it keeps sounding after you
      8  6fb4							;	       let go); every other key is the lead.
      9  6fb4							; v0.36: the lead is LEAD OCTAVE up in every mode (+1 at first; SHIFT + F1 /
     10  6fb4							; F3; v0.43: One Key Play too). v0.43: SHIFT + F5 SPLIT on / off, SHIFT + F7
     11  6fb4							; its mode, SHIFT + K then a note: the split point. LATCH holds KEY's chord side and TRIAD's chord.
     12  6fb4							; The lead is one note (the last key pressed) on one voice per chip (SID 3,
     13  6fb4							; Game Boy pulse 1, NES pulse 1), only while it plays: the rest of the time
     14  6fb4							; those voices are the chord's. Its patch: SHIFT + A S D F G / Z X C V B.
     15  6fb4							; The lead's own: the SID's waveform, width, envelope and octave, the Game
     16  6fb4							; Boy pulse's CCs, the NES pulse's duty. Shared with the chord: the effects
     17  6fb4							; (vibrato, filter, tremolo...), the NES envelope.
     18  6fb4
     19  6fb4							;   KEY       (v0.32) a keyboard split: keys below the split point are the
     20  6fb4							;	       chord (as the mode plays them), keys from it up the lead (LEAD
     21  6fb4							;	       OCTAVE, +1 at first). On the C64's keys the split is a key (it
     22  6fb4							;	       stays put when the octave changes); over MIDI, a note as sent
     23  6fb4							;	       (before MIDI IN OCTAVE). SHIFT + F5 held + a note sets either.
     24  6fb4		       00 01	   CL_KEY     equ	1	; SPLIT (clMode)
     25  6fb4		       00 02	   CL_BASS    equ	2
     26  6fb4		       00 03	   CL_L3      equ	3	; (TRIAD)
     27  6fb4		       00 06	   LEAD_SID   equ	6	; the lead's voices: SID 3, GB pulse 1, NES pulse 1
     28  6fb4		       00 01	   LEAD_GB    equ	1
     29  6fb4		       00 02	   LEAD_NES   equ	2
     30  6fb4
     31  6fb4							; NoteDown, CHORD + LEAD on: key X pressed. Carry set: it's the lead (the
     32  6fb4							; latch styles leave it alone).
     33  6fb4				   ClPress
     34  6fb4					      subroutine
     35  6fb4		       8e b9 c3 	      stx	exI
     36  6fb7		       ad ba c8 	      lda	clMode
     37  6fba		       c9 03		      cmp	#CL_L3
     38  6fbc		       f0 21		      beq	.l3
     39  6fbe		       c9 01		      cmp	#CL_KEY
     40  6fc0		       d0 09		      bne	.low
     41  6fc2		       20 f9 70 	      jsr	LeadSide	; KEY: which side of the split
     42  6fc5		       90 03		      bcc	.ch
     43  6fc7		       8e cc c8 	      stx	clLeadIdx
     44  6fca				   .ch
     45  6fca		       60		      rts
