    148  2774		       f0 36		      beq	.x
    149  2776		       4c 4c 32 	      jmp	KeytarDrum
    150  2779				   .notes
    151  2779		       c9 0b		      cmp	#MIDI_IN_CHANS
    152  277b		       b0 2f		      bcs	.x	; channels 12-15: the keytar's accompaniment
    153  277d		       85 27		      sta	t3
    154  277f		       ad 27 c4 	      lda	rxStatus
    155  2782		       29 f0		      and	#$F0
    156  2784		       c9 b0		      cmp	#$B0
    157  2786		       d0 03		      bne	.pc
    158  2788		       4c f4 38 	      jmp	KeytarCC	; its vibrato / portamento / sustain buttons
