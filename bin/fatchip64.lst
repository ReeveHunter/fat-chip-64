      0  669b					      include	"wander.asm"
      1  669b							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  669b							;
      3  669b							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  669b							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  669b							;   ATTACK   as always: the new notes start
      6  669b							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  669b							;	      has none)
      8  669b							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  669b							;	      start again
     10  669b							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  669b							;	      late; some glide, some start again (fade out, come back in)
     12  669b							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  669b							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  669b							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  669b							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  669b
     17  669b		       00 01	   CHG_ATTACK equ	1
     18  669b		       00 02	   CHG_GLIDE  equ	2
     19  669b		       00 03	   CHG_STAGGER equ	3
     20  669b		       00 04	   CHG_WANDER equ	4
     21  669b		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  669b
