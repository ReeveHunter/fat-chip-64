      0  0b9d					      include	"midi.asm"
      1  0b9d							; Fat Chip 64 - MIDI out
      2  0b9d							;
      3  0b9d							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0b9d							; at most one message per device onto the wire buffer, no sooner than that
      5  0b9d							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0b9d							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0b9d							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0b9d							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0b9d							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0b9d
     11  0b9d				   MidiInit
     12  0b9d					      subroutine
     13  0b9d		       a9 03		      lda	#ACIA_RESET
     14  0b9f		       8d 04 de 	      sta	ACIA_CTRL
     15  0ba2		       a9 16		      lda	#ACIA_MODE
     16  0ba4		       8d 04 de 	      sta	ACIA_CTRL
     17  0ba7							; (fall into the test)
     18  0ba7
     19  0ba7							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0ba7							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0ba7							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0ba7							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0ba7							; before. Interrupts are off when this is called.
     24  0ba7				   MidiIrqTest
     25  0ba7					      subroutine
     26  0ba7		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0ba9		       8d 0d dc 	      sta	CIA1_ICR
     28  0bac		       ad 0d dc 	      lda	CIA1_ICR
     29  0baf		       a9 f7		      lda	#<IrqTest
     30  0bb1		       8d fe ff 	      sta	$FFFE
     31  0bb4		       a9 0b		      lda	#>IrqTest
     32  0bb6		       8d ff ff 	      sta	$FFFF
     33  0bb9		       a9 00		      lda	#0
     34  0bbb		       85 2f		      sta	midiIrq
     35  0bbd		       a9 b6		      lda	#ACIA_MODE_TX
     36  0bbf		       8d 04 de 	      sta	ACIA_CTRL
     37  0bc2		       58		      cli
     38  0bc3		       a2 00		      ldx	#0
     39  0bc5				   .w
     40  0bc5		       ca		      dex
     41  0bc6		       d0 fd		      bne	.w
     42  0bc8		       78		      sei
     43  0bc9		       a6 2f		      ldx	midiIrq
     44  0bcb		       bd 03 0c 	      lda	midiCtl,x
     45  0bce		       8d 04 de 	      sta	ACIA_CTRL
     46  0bd1		       bd 05 0c 	      lda	irqLo,x
     47  0bd4		       8d fe ff 	      sta	$FFFE
     48  0bd7		       bd 07 0c 	      lda	irqHi,x
     49  0bda		       8d ff ff 	      sta	$FFFF
     50  0bdd		       bd 09 0c 	      lda	latchLo,x
     51  0be0		       8d 04 dc 	      sta	CIA1_TALO
     52  0be3		       bd 0b 0c 	      lda	latchHi,x
     53  0be6		       8d 05 dc 	      sta	CIA1_TAHI
     54  0be9		       a9 11		      lda	#$11	; start, force load, continuous
     55  0beb		       8d 0e dc 	      sta	CIA1_CRA
     56  0bee		       ad 0d dc 	      lda	CIA1_ICR
     57  0bf1		       a9 81		      lda	#$81	; timer A interrupt on
     58  0bf3		       8d 0d dc 	      sta	CIA1_ICR
     59  0bf6		       60		      rts
