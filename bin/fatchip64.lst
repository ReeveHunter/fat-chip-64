    391  39c6		       ae 1d c8 	      ldx	sxCmd
    392  39c9		       e0 02		      cpx	#2
    393  39cb		       f0 0d		      beq	.dev
    394  39cd		       ae 4e c7 	      ldx	sxPos
    395  39d0		       e0 d5		      cpx	#SX_LEN
    396  39d2		       d0 05		      bne	.x
    397  39d4		       48		      pha
