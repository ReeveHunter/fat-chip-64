     44  2979		       f0 f1		      beq	.nope
     45  297b		       bd 43 84 	      lda	vDev,x
     46  297e		       c9 02		      cmp	#DEV_NES
     47  2980		       d0 ea		      bne	.nope
     48  2982		       bd 9f c3 	      lda	vOut,x
     49  2985		       c9 ff		      cmp	#NO_NOTE
     50  2987		       f0 e3		      beq	.nope
     51  2989		       ad 53 c4 	      lda	nesEnvOn
     52  298c		       f0 78		      beq	.fo	; (no envelope: BEND OUT's fall-off, if any)
     53  298e		       bc 5e 29 	      ldy	vEnvSlot,x
     54  2991		       30 41		      bmi	.tri
     55  2993							; pulse: release from the current level; step = level x factor / 4 + 1
     56  2993							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  2993							; about 2 s). Factor 0: no release, cut.
