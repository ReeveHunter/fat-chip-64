------- FILE arp.asm LEVEL 2 PASS 3
      0  1846					      include	"arp.asm"
      1  1846							; Fat Chip 64 - tempo and arpeggiator
      2  1846							;
      3  1846							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1846							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1846							;
      6  1846							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1846							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1846							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1846							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1846							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1846							;	     until its voice's next turn.
     12  1846							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1846							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1846							;   J faster; either one also picks FREE).
     15  1846							;
     16  1846							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1846							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1846
     19  1846							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1846							; between the two bytes: $22FF read as $23FF)
     21  1846				   GetTicks
     22  1846					      subroutine
     23  1846		       08		      php
     24  1847		       78		      sei
     25  1848		       a5 10		      lda	ticks
     26  184a		       8d 3e c3 	      sta	nowL
     27  184d		       a5 11		      lda	ticks+1
     28  184f		       8d 3f c3 	      sta	nowH
     29  1852		       28		      plp
     30  1853		       60		      rts
     31  1854
