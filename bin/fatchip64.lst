------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  32b2					      include	"midiin.asm"
      1  32b2							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  32b2							;
      3  32b2							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  32b2							; The main loop parses them (running status; realtime and system bytes are
      5  32b2							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  32b2							; notes mode, latch, arp and K + note.
      7  32b2							;
      8  32b2							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  32b2							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  32b2							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  32b2							;
     12  32b2							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  32b2							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  32b2							;
     15  32b2							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  32b2							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  32b2							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  32b2							; MIDI in is passed on to the Game Boy or NES.
     19  32b2
     20  32b2							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  32b2							; Uses A, X.
     22  32b2							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  32b2							; with the time; a Start ($FA) makes the next clock a beat.
     24  32b2				   RxByte
     25  32b2					      subroutine
     26  32b2		       ad 06 de 	      lda	ACIA_STAT
     27  32b5		       4a		      lsr		; RDRF -> carry
     28  32b6		       90 2b		      bcc	.x
     29  32b8				   RxGot
     30  32b8		       ad 07 de 	      lda	ACIA_RX
     31  32bb		       c9 f8		      cmp	#$F8
     32  32bd		       f0 25		      beq	.clk
     33  32bf		       c9 fa		      cmp	#$FA
     34  32c1		       d0 0e		      bne	.buf
     35  32c3		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  32c5		       8e e8 c5 	      stx	clkPhase
     37  32c8		       8e f0 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  32cb							;  the main loop could measure it)
     39  32cb		       ae e9 c5 	      ldx	clkBeat
     40  32ce		       8e fb c5 	      stx	clkStartBeat
     41  32d1				   .buf
     42  32d1		       ae 24 c4 	      ldx	rxHead
     43  32d4		       9d e4 c3 	      sta	rxBuf,x
     44  32d7		       e8		      inx
     45  32d8		       8a		      txa
     46  32d9		       29 3f		      and	#63
     47  32db		       cd 25 c4 	      cmp	rxTail
     48  32de		       f0 03		      beq	.x	; full: dropped
     49  32e0		       8d 24 c4 	      sta	rxHead
     50  32e3				   .x
     51  32e3		       60		      rts
     52  32e4				   .clk
     53  32e4		       ee e4 c5 	      inc	clkCount
     54  32e7		       ae e8 c5 	      ldx	clkPhase
     55  32ea		       e8		      inx
     56  32eb		       e0 18		      cpx	#24
     57  32ed		       90 1b		      bcc	.ph
     58  32ef		       a5 10		      lda	ticks
     59  32f1		       8d eb c5 	      sta	clkAtL
     60  32f4		       a5 11		      lda	ticks+1
