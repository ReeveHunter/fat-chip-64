------- FILE midiin.asm LEVEL 2 PASS 3
      0  3a6d					      include	"midiin.asm"
      1  3a6d							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  3a6d							;
      3  3a6d							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  3a6d							; The main loop parses them (running status; realtime and system bytes are
      5  3a6d							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  3a6d							; notes mode, latch, arp and K + note.
      7  3a6d							;
      8  3a6d							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  3a6d							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  3a6d							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  3a6d							;
     12  3a6d							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  3a6d							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  3a6d							;
     15  3a6d							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  3a6d							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  3a6d							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  3a6d							; MIDI in is passed on to the Game Boy or NES.
     19  3a6d
     20  3a6d							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  3a6d							; Uses A, X.
     22  3a6d							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  3a6d							; with the time; a Start ($FA) makes the next clock a beat.
     24  3a6d				   RxByte
     25  3a6d					      subroutine
     26  3a6d		       ad 06 de 	      lda	ACIA_STAT
     27  3a70		       4a		      lsr		; RDRF -> carry
     28  3a71		       90 2b		      bcc	.x
     29  3a73				   RxGot
     30  3a73		       ad 07 de 	      lda	ACIA_RX
     31  3a76		       c9 f8		      cmp	#$F8
     32  3a78		       f0 25		      beq	.clk
     33  3a7a		       c9 fa		      cmp	#$FA
     34  3a7c		       d0 0e		      bne	.buf
     35  3a7e		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  3a80		       8e b3 ca 	      stx	clkPhase
     37  3a83		       8e bb ca 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3a86							;  the main loop could measure it)
     39  3a86		       ae b4 ca 	      ldx	clkBeat
     40  3a89		       8e c6 ca 	      stx	clkStartBeat
     41  3a8c				   .buf
     42  3a8c		       ae f1 c8 	      ldx	rxHead
     43  3a8f		       9d b1 c8 	      sta	rxBuf,x
     44  3a92		       e8		      inx
     45  3a93		       8a		      txa
     46  3a94		       29 3f		      and	#63
     47  3a96		       cd f2 c8 	      cmp	rxTail
     48  3a99		       f0 03		      beq	.x	; full: dropped
     49  3a9b		       8d f1 c8 	      sta	rxHead
     50  3a9e				   .x
     51  3a9e		       60		      rts
     52  3a9f				   .clk
     53  3a9f		       ee af ca 	      inc	clkCount
     54  3aa2		       ae b3 ca 	      ldx	clkPhase
     55  3aa5		       e8		      inx
     56  3aa6		       e0 18		      cpx	#24
     57  3aa8		       90 1b		      bcc	.ph
     58  3aaa		       a5 10		      lda	ticks
     59  3aac		       8d b6 ca 	      sta	clkAtL
     60  3aaf		       a5 11		      lda	ticks+1
     61  3ab1		       8d b7 ca 	      sta	clkAtH
     62  3ab4		       a5 2d		      lda	subTick
     63  3ab6		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  3ab8		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  3aba		       ad 05 dc 	      lda	CIA1_TAHI
     66  3abd				   .q
