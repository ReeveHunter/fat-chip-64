------- FILE nesfx.asm LEVEL 2 PASS 3
      0  7d7c					      include	"nesfx.asm"
      1  7d7c							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7d7c							;
      3  7d7c							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7d7c							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7d7c							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7d7c							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7d7c							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7d7c							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7d7c							;   glide    a new note starts bent back to the voice's last note and slides
     10  7d7c							;	      in the way the SID's does (all three channels)
     11  7d7c							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7d7c							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7d7c							; semitone, so these are a little stepped.
     14  7d7c
     15  7d7c		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7d7c							;  (the pulses, and the triangle while it glides)
     17  7d7c
     18  7d7c							; A = 1 (not Z) when a NesFxTick step is due
     19  7d7c				   NesFxDue
     20  7d7c					      subroutine
     21  7d7c		       ad 27 c3 	      lda	devOn+DEV_NES
     22  7d7f		       f0 1c		      beq	.x
     23  7d81		       ad ff c5 	      lda	vibDepth
     24  7d84		       0d 2d c5 	      ora	nfxGlide
     25  7d87		       0d 2e c5 	      ora	nfxRun
     26  7d8a		       0d e3 c9 	      ora	nfxWarb
     27  7d8d		       f0 0e		      beq	.x
     28  7d8f		       a5 10		      lda	ticks
     29  7d91		       38		      sec
     30  7d92		       ed 29 c5 	      sbc	nfxLast
     31  7d95		       c9 08		      cmp	#NFX_EVERY
     32  7d97		       a9 00		      lda	#0
     33  7d99		       90 02		      bcc	.x
     34  7d9b		       a9 01		      lda	#1
     35  7d9d				   .x
     36  7d9d		       60		      rts
     37  7d9e
     38  7d9e							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     39  7d9e							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     40  7d9e							; quick return.
     41  7d9e				   NesFxTick
     42  7d9e					      subroutine
     43  7d9e		       ad 27 c3 	      lda	devOn+DEV_NES
     44  7da1		       f0 0e		      beq	.q
     45  7da3		       ad ff c5 	      lda	vibDepth
     46  7da6		       0d 2d c5 	      ora	nfxGlide
     47  7da9		       0d 2e c5 	      ora	nfxRun
     48  7dac		       0d e3 c9 	      ora	nfxWarb
     49  7daf		       d0 01		      bne	.on
     50  7db1				   .q
     51  7db1		       60		      rts
     52  7db2				   .on
     53  7db2		       a5 10		      lda	ticks
     54  7db4		       38		      sec
     55  7db5		       ed 29 c5 	      sbc	nfxLast
     56  7db8		       c9 08		      cmp	#NFX_EVERY
     57  7dba		       b0 01		      bcs	.go
     58  7dbc		       60		      rts
     59  7dbd				   .go
     60  7dbd		       4a		      lsr
