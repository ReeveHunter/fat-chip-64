     78  69fc		       bd f9 c9 	      lda	vOkp,x	; One Key Play's voices: at once, new attacks (v0.52:
     79  69ff		       d0 5e		      bne	.okp	;  never a chord change's glide)
     80  6a01
     81  6a01		       20 9d 69 	      jsr	ChgEff
