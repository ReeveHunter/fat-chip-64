------- FILE main.asm
------- FILE devices.asm LEVEL 2 PASS 3
      0  6d27					      include	"devices.asm"
      1  6d27							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  6d27							; are in use, and each one in use gets its page on the main menu.
      3  6d27							;
      4  6d27							; YAMAHA SHS-10 (the keytar)
      5  6d27							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  6d27							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  6d27							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  6d27							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  6d27							;		     can play at once.)
     10  6d27							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  6d27							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  6d27							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  6d27							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  6d27							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  6d27							;		     louder (the SID and the NES; the Game Boy would click) or
     16  6d27							;		     brighter (the SID's filter: switched on if the patch has
     17  6d27							;		     none)
     18  6d27							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  6d27							;		     the patch's, or the ADVANCED amounts if it has none;
     20  6d27							;		     FILTER), or an action held while blowing hard
     21  6d27							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  6d27							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  6d27							;   PORTAMENTO BUTTON	an action (CC 65)
     24  6d27							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  6d27							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  6d27							; ATARI SYNTHCART
     27  6d27							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  6d27							;		     about 3% while held, SHIFT + , . step through the ten
     29  6d27							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  6d27							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  6d27							;		     sound's cents (the Synthcart manual's table: each Atari
     32  6d27							;		     sound plays its scales in its own key, a little off)
     33  6d27							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  6d27
     35  6d27		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  6d27		       00 28	   BREATH_LO  equ	40
     37  6d27		       00 01	   BFX_VIB    equ	1
     38  6d27		       00 02	   BFX_WARB   equ	2
     39  6d27		       00 03	   BFX_DET    equ	3
     40  6d27		       00 04	   BFX_FILT   equ	4
     41  6d27		       00 05	   BFX_HELD   equ	5
     42  6d27
     43  6d27							; the devices' settings -> what the MIDI code checks
     44  6d27				   SyncDerive
     45  6d27					      subroutine
     46  6d27		       a2 02		      ldx	#TEMPO_SC	; (v0.67: the Synthcart's sync first: it's asked for;
     47  6d29		       ad 01 cd 	      lda	useSc	;  then MIDI IN CLOCK, FOLLOW by default)
     48  6d2c		       f0 05		      beq	.t1
     49  6d2e		       ad 0b cd 	      lda	scSync
     50  6d31		       d0 09		      bne	.t
     51  6d33				   .t1
     52  6d33		       a2 01		      ldx	#TEMPO_OWN
     53  6d35		       ad 02 cd 	      lda	shsTempo
     54  6d38		       d0 02		      bne	.t
     55  6d3a		       a2 00		      ldx	#TEMPO_KEYTAR
     56  6d3c				   .t
     57  6d3c		       8e 5a c9 	      stx	syncTempo
     58  6d3f		       ad 03 cd 	      lda	shsStart	; start / stop: 0 = MIDI in's
     59  6d42		       8d 5b c9 	      sta	syncStart
     60  6d45		       20 64 6d 	      jsr	BreathFlags
     61  6d48		       20 9d 6f 	      jsr	ScTune	; (Synthcart: tuning and key)
     62  6d4b		       20 29 19 	      jsr	ApplySettings	; (DH-100 NOTES)
     63  6d4e		       a9 01		      lda	#1
     64  6d50		       8d ef c7 	      sta	reallocFlag
     65  6d53		       20 80 3f 	      jsr	FxVars
     66  6d56		       20 f3 42 	      jsr	WarbleSend
     67  6d59		       ad 5a c9 	      lda	syncTempo
     68  6d5c		       c9 02		      cmp	#TEMPO_SC
     69  6d5e		       d0 03		      bne	.x
     70  6d60		       4c dc 5d 	      jmp	TempoChosen	; Synthcart: snap the tempo now
     71  6d63				   .x
     72  6d63		       60		      rts
