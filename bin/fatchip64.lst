    443  656a							; ------------------------------------------------------------ tuning
    444  656a							; tuneC = PLAYING's FINE TUNE + the Synthcart's TUNE TO (while it's in use),
    445  656a							; in cents (-100..+100). The Game Boy gets it as master tune (CC 103), the
    446  656a							; NES in its bends (tuneN, 1/64 semitones), the SID in its note frequencies
    447  656a							; (SidTune; the notes sounding move at once). MATCH KEY sets the key's root
    448  656a							; once, when it changes.
    449  656a				   ScTune
    450  656a					      subroutine
    451  656a		       a9 00		      lda	#0
    452  656c		       ae 38 c8 	      ldx	useSc
