------- FILE arp.asm LEVEL 2 PASS 3
      0  1d8b					      include	"arp.asm"
      1  1d8b							; Fat Chip 64 - tempo and arpeggiator
      2  1d8b							;
      3  1d8b							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1d8b							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1d8b							;
      6  1d8b							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1d8b							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1d8b							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1d8b							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1d8b							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1d8b							;	     until its voice's next turn.
     12  1d8b							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1d8b							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1d8b							;   J faster; either one also picks FREE).
     15  1d8b							;
     16  1d8b							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1d8b							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1d8b
     19  1d8b							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1d8b							; between the two bytes: $22FF read as $23FF)
     21  1d8b				   GetTicks
     22  1d8b					      subroutine
     23  1d8b		       08		      php
     24  1d8c		       78		      sei
     25  1d8d		       a5 10		      lda	ticks
     26  1d8f		       8d 3e c3 	      sta	nowL
     27  1d92		       a5 11		      lda	ticks+1
     28  1d94		       8d 3f c3 	      sta	nowH
     29  1d97		       28		      plp
     30  1d98		       60		      rts
     31  1d99
