------- FILE main.asm
------- FILE nesfx.asm LEVEL 2 PASS 3
      0  9587					      include	"nesfx.asm"
      1  9587							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  9587							;
      3  9587							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  9587							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  9587							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  9587							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  9587							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  9587							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  9587							;   glide    a new note starts bent back to the voice's last note and slides
     10  9587							;	      in the way the SID's does (all three channels)
     11  9587							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  9587							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  9587							; semitone, so these are a little stepped.
     14  9587
     15  9587		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  9587							;  (the pulses, and the triangle while it glides)
     17  9587
     18  9587							; A = 1 (not Z) when a NesFxTick step is due
     19  9587				   NesFxDue
     20  9587					      subroutine
     21  9587		       ad eb c7 	      lda	devOn+DEV_NES
     22  958a		       f0 1c		      beq	.x
     23  958c		       ad c9 ca 	      lda	vibDepth
     24  958f		       0d f7 c9 	      ora	nfxGlide
     25  9592		       0d f8 c9 	      ora	nfxRun
     26  9595		       0d b5 ce 	      ora	nfxWarb
     27  9598		       f0 0e		      beq	.x
     28  959a		       a5 10		      lda	ticks
     29  959c		       38		      sec
     30  959d		       ed f3 c9 	      sbc	nfxLast
     31  95a0		       c9 08		      cmp	#NFX_EVERY
     32  95a2		       a9 00		      lda	#0
     33  95a4		       90 02		      bcc	.x
     34  95a6		       a9 01		      lda	#1
     35  95a8				   .x
     36  95a8		       60		      rts
     37  95a9
     38  95a9							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
