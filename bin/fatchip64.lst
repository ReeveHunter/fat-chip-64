------- FILE keys.asm LEVEL 2 PASS 3
      0  0f2c					      include	"keys.asm"
      1  0f2c							; Fat Chip 64 - keyboard and RESTORE
      2  0f2c
      3  0f2c							; Scan the whole matrix, turn changes into key events.
      4  0f2c							;
      5  0f2c							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0f2c							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0f2c							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0f2c							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0f2c							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0f2c							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0f2c							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0f2c							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0f2c							; chords whose ghost lands on another used key lose their newest note.
     14  0f2c				   KeyScan
     15  0f2c					      subroutine
     16  0f2c		       a2 07		      ldx	#7
     17  0f2e				   .col
     18  0f2e		       bd ce 8f 	      lda	colSelect,x
     19  0f31		       8d 00 dc 	      sta	CIA1_PRA
     20  0f34		       ad 01 dc 	      lda	CIA1_PRB
     21  0f37		       49 ff		      eor	#$FF
     22  0f39		       3d 48 c7 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0f3c		       9d 40 c7 	      sta	keyNow,x
     24  0f3f		       ca		      dex
     25  0f40		       10 ec		      bpl	.col
     26  0f42		       a9 ff		      lda	#$FF
     27  0f44		       8d 00 dc 	      sta	CIA1_PRA
     28  0f47							; ---- every column as accepted (nothing pressed or let go): done
     29  0f47		       a2 07		      ldx	#7
     30  0f49				   .same
     31  0f49		       bd 40 c7 	      lda	keyNow,x
     32  0f4c		       dd 50 c7 	      cmp	keyAcc,x
     33  0f4f		       d0 04		      bne	.changed
     34  0f51		       ca		      dex
     35  0f52		       10 f5		      bpl	.same
     36  0f54		       60		      rts
     37  0f55				   .changed
     38  0f55							; ---- releases first: accepted keys that are up now
     39  0f55		       a2 00		      ldx	#0
     40  0f57				   .rc
     41  0f57		       8e fc c7 	      stx	ksCol
     42  0f5a		       bd 40 c7 	      lda	keyNow,x
     43  0f5d		       49 ff		      eor	#$FF
     44  0f5f		       3d 50 c7 	      and	keyAcc,x
     45  0f62		       8d fb c7 	      sta	ksBits
     46  0f65		       a9 00		      lda	#0
     47  0f67		       8d fd c7 	      sta	ksRow
     48  0f6a				   .rb
     49  0f6a		       ad fb c7 	      lda	ksBits
     50  0f6d		       f0 21		      beq	.rcn
     51  0f6f		       4e fb c7 	      lsr	ksBits
     52  0f72		       90 17		      bcc	.rbn
     53  0f74		       ae fc c7 	      ldx	ksCol
     54  0f77		       ac fd c7 	      ldy	ksRow
     55  0f7a		       b9 d6 8f 	      lda	rowBit,y
     56  0f7d		       49 ff		      eor	#$FF
     57  0f7f		       3d 50 c7 	      and	keyAcc,x
     58  0f82		       9d 50 c7 	      sta	keyAcc,x
     59  0f85		       20 2b 10 	      jsr	KeyCode
     60  0f88		       20 a7 19 	      jsr	KeyUp
