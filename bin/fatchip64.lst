    264  0d10							; ------------------------------------------------------------ queueing (main loop)
    265  0d10							; Message in mS / mD1 / mD2. Dropped if the queue is full (63 messages).
    266  0d10				   GbPut
    267  0d10					      subroutine
    268  0d10							; write the slot at head first (always free: one slot stays empty),
    269  0d10							; then publish head unless the queue is full. Uses only A and X.
    270  0d10		       a6 17		      ldx	gbqHead
    271  0d12		       a5 21		      lda	mS
    272  0d14		       9d 00 c1 	      sta	gbqS,x
    273  0d17		       a5 22		      lda	mD1
    274  0d19		       9d 40 c1 	      sta	gbqD1,x
    275  0d1c		       a5 23		      lda	mD2
    276  0d1e		       9d 80 c1 	      sta	gbqD2,x
    277  0d21		       8a		      txa
    278  0d22		       18		      clc
    279  0d23		       69 01		      adc	#1
    280  0d25		       29 3f		      and	#63
