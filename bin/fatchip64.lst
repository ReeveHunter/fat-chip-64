      0  1942					      include	"arp.asm"
      1  1942							; Fat Chip 64 - tempo and arpeggiator
      2  1942							;
      3  1942							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1942							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1942							;
      6  1942							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1942							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1942							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1942							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1942							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1942							;	     until its voice's next turn.
     12  1942							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1942							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1942							;   J faster; either one also picks FREE).
     15  1942							;
     16  1942							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1942							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1942
     19  1942							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1942							; between the two bytes: $22FF read as $23FF)
     21  1942				   GetTicks
     22  1942					      subroutine
     23  1942		       08		      php
     24  1943		       78		      sei
     25  1944		       a5 10		      lda	ticks
     26  1946		       8d 3e c3 	      sta	nowL
     27  1949		       a5 11		      lda	ticks+1
     28  194b		       8d 3f c3 	      sta	nowH
     29  194e		       28		      plp
     30  194f		       60		      rts
