    364  3c12							; ------------------------------------------------------------ SysEx: a patch from Chip Lab (v0.20)
    365  3c12							; (v0.23: F0 7D 46 43 02 m F7 sets the chips on / off: DevicesReceived)
    366  3c12							; F0 7D 46 43 01 PATCH_SIZE, then the patch (PATCH_SIZE bytes, the live patch's layout:
    367  3c12							; tools/gen_patches.py) as two 4-bit halves each, high first, then F7. It
    368  3c12							; arrives in sxBuf; only a complete one goes into the live patch, which then
    369  3c12							; sounds at once (like choosing a sound). Anything else is ignored.
    370  3c12		       00 05	   SX_HEAD    equ	5
    371  3c12		       00 db	   SX_LEN     equ	SX_HEAD + PATCH_SIZE * 2
