    128  0cec							; A = key code at ksCol / ksRow
    129  0cec				   KeyCode
    130  0cec					      subroutine
    131  0cec		       ad 1f c3 	      lda	ksCol
    132  0cef		       0a		      asl
    133  0cf0		       0a		      asl
    134  0cf1		       0a		      asl
    135  0cf2		       0d 20 c3 	      ora	ksRow
    136  0cf5		       a8		      tay
