     58  66c1							; SidFreqOut: bT3:bT2 (and mulA) up by the BLIP's step now (Y = SID voice).
     59  66c1							; Keeps Y and the temps (t0-t3).
     60  66c1				   BlipApply
     61  66c1					      subroutine
     62  66c1		       b9 58 c9 	      lda	atkT,y
     63  66c4		       a2 00		      ldx	#0
