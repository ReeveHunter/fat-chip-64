      0  5c61					      include	"menu.asm"
      1  5c61							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  5c61							;
      3  5c61							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  5c61							;   page   RETURN opens a page
      5  5c61							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  5c61							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  5c61							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  5c61							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  5c61							; device pages, until DEVICES says the device is in use).
     10  5c61							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  5c61							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  5c61							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  5c61
     14  5c61		       00 17	   MENU_VALCOL equ	23
     15  5c61
