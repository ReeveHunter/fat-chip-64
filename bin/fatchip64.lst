------- FILE main.asm
------- FILE repeat.asm LEVEL 2 PASS 3
      0  33d0					      include	"repeat.asm"
      1  33d0							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  33d0							;
      3  33d0							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  33d0							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  33d0							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  33d0							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  33d0							; 1s), taken out of the chord while REPEAT is on - unless the notes held need
      8  33d0							; them (then held notes come first and the echoes wait). Each echo sounds for
      9  33d0							; 3/4 of the time between echoes. The SID doesn't echo.
     10  33d0							;
     11  33d0							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     12  33d0							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     13  33d0							; or a keytar button).
     14  33d0							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     15  33d0							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     16  33d0
     17  33d0		       00 10	   RP_SLOTS   equ	16
     18  33d0		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     19  33d0
     20  33d0							; REPEAT is on now?
     21  33d0				   RepeatActive
     22  33d0		       ad c3 c4 	      lda	repeatOn
     23  33d3		       0d ac c4 	      ora	actCnt+A_REPEAT
     24  33d6		       60		      rts
     25  33d7
