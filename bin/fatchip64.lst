      0  70b9					      include	"wander.asm"
      1  70b9							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  70b9							;
      3  70b9							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  70b9							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  70b9							;   ATTACK   as always: the new notes start
      6  70b9							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  70b9							;	      has none)
      8  70b9							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  70b9							;	      start again
     10  70b9							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  70b9							;	      late; some glide, some start again (fade out, come back in)
     12  70b9							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  70b9							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  70b9							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  70b9							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  70b9
     17  70b9		       00 01	   CHG_ATTACK equ	1
     18  70b9		       00 02	   CHG_GLIDE  equ	2
     19  70b9		       00 03	   CHG_STAGGER equ	3
     20  70b9		       00 04	   CHG_WANDER equ	4
     21  70b9		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  70b9		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  70b9
