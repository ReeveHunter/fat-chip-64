     87  23f2					      if	TRI_DROP_PADS == 0
     88  23f2		       4c 24 24 	      jmp	.no	; PADS: the bass just stops (Reeve, 2026-11-01)
     89  23f5					      endif
     90  23f5		       bd f7 6f 	      lda	vIdx,x
     91  23f8		       c9 02		      cmp	#2
