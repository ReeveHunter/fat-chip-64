------- FILE main.asm
------- FILE arp.asm LEVEL 2 PASS 3
      0  2491					      include	"arp.asm"
      1  2491							; Fat Chip 64 - tempo and arpeggiator
      2  2491							;
      3  2491							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  2491							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  2491							;
      6  2491							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  2491							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  2491							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  2491							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  2491							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  2491							;	     until its voice's next turn.
     12  2491							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  2491							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  2491							;   J faster; either one also picks FREE).
     15  2491							;
     16  2491							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  2491							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  2491
     19  2491							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  2491							; between the two bytes: $22FF read as $23FF)
     21  2491				   GetTicks
     22  2491					      subroutine
     23  2491		       08		      php
     24  2492		       78		      sei
     25  2493		       a5 10		      lda	ticks
     26  2495		       8d 43 c7 	      sta	nowL
     27  2498		       a5 11		      lda	ticks+1
     28  249a		       8d 44 c7 	      sta	nowH
     29  249d		       28		      plp
     30  249e		       60		      rts
     31  249f
     32  249f							; ------------------------------------------------------------ tempo
     33  249f				   TapTempo
     34  249f					      subroutine
     35  249f		       20 72 5c 	      jsr	FollowActive	; the keytar's clock sets the tempo: taps do nothing
     36  24a2		       f0 01		      beq	.tap
     37  24a4		       60		      rts
