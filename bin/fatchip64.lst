      0  48f5					      include	"menu.asm"
      1  48f5							; Fat Chip 64 - the menu (v0.14): RETURN in, SHIFT+RETURN back out
      2  48f5							;
      3  48f5							; Three pages: the main one (SOUND, PLAYING), ADVANCED SOUND and DEVICE SYNC
      4  48f5							; (RETURN on their lines opens them, SHIFT+RETURN comes back).
      5  48f5							; CRSR DOWN / SHIFT+CRSR DOWN (up): choose a setting. CRSR RIGHT / SHIFT+CRSR
      6  48f5							; RIGHT: its next / previous value. Every other key works as usual (notes
      7  48f5							; play; V, F keys, = ... too: the values here follow).
      8  48f5							; The play screen pauses while the menu is up and redraws when it closes.
      9  48f5
