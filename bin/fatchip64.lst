------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  355d					      include	"sounds.asm"
      1  355d							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  355d							;
      3  355d							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  355d							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  355d							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  355d							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  355d							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  355d							;
      9  355d							; Each sound has a mono default and a Fat Bass default:
     10  355d							;   MONO      one note (the last key pressed and still held) on every voice;
     11  355d							;	       a new key while another is held changes the pitch without a
     12  355d							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  355d							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  355d							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  355d							;	       the other voices
     16  355d							;
     17  355d							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  355d							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  355d							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  355d
     21  355d							; ------------------------------------------------------------ choosing
     22  355d							; V: next sound (SHIFT+V: previous)
     23  355d				   SoundKey
     24  355d					      subroutine
     25  355d		       20 d7 35 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3560		       ae 94 c3 	      ldx	soundMode
     27  3563		       ad 2a c3 	      lda	shiftDown
     28  3566		       d0 09		      bne	.prev
     29  3568		       e8		      inx
     30  3569		       e0 13		      cpx	#NUM_SOUNDS
     31  356b		       90 09		      bcc	.s
     32  356d		       a2 00		      ldx	#0
     33  356f		       f0 05		      beq	.s
     34  3571				   .prev
     35  3571		       ca		      dex
     36  3572		       10 02		      bpl	.s
     37  3574		       a2 12		      ldx	#NUM_SOUNDS-1
     38  3576				   .s
     39  3576		       4c 80 35 	      jmp	SoundSetX
     40  3579
     41  3579							; X = sound (the keytar's voice buttons)
     42  3579				   SoundSet
