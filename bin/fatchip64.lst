    148  0fc4							; A = key code at ksCol / ksRow
    149  0fc4				   KeyCode
    150  0fc4					      subroutine
    151  0fc4		       ad 38 c3 	      lda	ksCol
    152  0fc7		       0a		      asl
    153  0fc8		       0a		      asl
    154  0fc9		       0a		      asl
    155  0fca		       0d 39 c3 	      ora	ksRow
    156  0fcd		       a8		      tay
    157  0fce		       b9 1b 7e 	      lda	keymap,y
    158  0fd1		       60		      rts
