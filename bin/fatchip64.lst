    105  6710		       b0 51		      bcs	.x
    106  6712							; ---- the next NES voice: a bend if its effects moved
    107  6712		       ad 2e c5 	      lda	nfxRun	; (a few rounds after an effects change)
    108  6715		       f0 03		      beq	.r
    109  6717		       ce 2e c5 	      dec	nfxRun
    110  671a				   .r
    111  671a		       ae 2a c5 	      ldx	nfxV	; (2, 5, 8)
    112  671d		       e8		      inx
    113  671e		       e8		      inx
    114  671f		       e8		      inx
    115  6720		       e0 09		      cpx	#NUM_VOICES
    116  6722		       90 02		      bcc	.nv
    117  6724		       a2 02		      ldx	#2
    118  6726				   .nv
    119  6726		       e0 08		      cpx	#8	; the triangle only while it glides or is bent
    120  6728		       d0 0d		      bne	.t
    121  672a		       bd c4 c4 	      lda	nesGlL,x
    122  672d		       1d cd c4 	      ora	nesGlH,x
    123  6730		       1d f1 c4 	      ora	nesBent,x
    124  6733		       d0 02		      bne	.t
    125  6735		       a2 02		      ldx	#2
    126  6737				   .t
    127  6737		       8e 2a c5 	      stx	nfxV
    128  673a		       86 24		      stx	t0
    129  673c		       bd 97 c3 	      lda	vOut,x
    130  673f		       c9 ff		      cmp	#NO_NOTE
    131  6741		       f0 20		      beq	.x
    132  6743		       20 84 68 	      jsr	NesFxVal
    133  6746		       a6 24		      ldx	t0
    134  6748		       ad 33 c5 	      lda	nfxL
    135  674b		       dd df c4 	      cmp	nesFxSL,x
    136  674e		       d0 08		      bne	.send
    137  6750		       ad 34 c5 	      lda	nfxH
    138  6753		       dd e8 c4 	      cmp	nesFxSH,x
    139  6756		       f0 0b		      beq	.x
    140  6758				   .send
    141  6758		       a9 01		      lda	#1
    142  675a		       8d 2b c5 	      sta	nfxHave	; (NesBendVoice: nfx is this voice's already)
    143  675d		       bd 97 c3 	      lda	vOut,x
    144  6760		       4c 00 29 	      jmp	NesBendVoice
    145  6763				   .x
    146  6763		       60		      rts
    147  6764
    148  6764							; voice X's glide offset closer to 0: by off / 2^glideK for each 4 ms step
    149  6764							; (worked out once: d = off >> k, off -= d x n; past 0 or nothing left to
    150  6764							; move by: there). Keeps X.
    151  6764				   NesGlideStep
