------- FILE main.asm
------- FILE drums.asm LEVEL 2 PASS 3
      0  4cab					      include	"drums.asm"
      1  4cab							; Fat Chip 64 - drums on the MidiNES
      2  4cab							;
      3  4cab							; Two sources, one kit:
      4  4cab							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  4cab							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  4cab							;			   64 = hit, 56 = ghost)
      7  4cab							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  4cab							;			   RETURN starts / stops it, at its own tempo (B taps
      9  4cab							;			   a new one)
     10  4cab							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  4cab							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  4cab							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  4cab							; a note-on, then a note-off after the sound's length, the level set with
     14  4cab							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  4cab							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  4cab
     17  4cab		       00 0c	   KIT_SIZE   equ	12
     18  4cab		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  4cab		       00 00	   DK_KICK    equ	0
     20  4cab		       00 01	   DK_SNARE   equ	1
     21  4cab		       00 02	   DK_CH      equ	2
     22  4cab		       00 03	   DK_OH      equ	3
     23  4cab		       00 04	   DK_CY      equ	4
     24  4cab		       00 05	   DK_TOM     equ	5
     25  4cab		       00 06	   DK_PERC    equ	6
     26  4cab
     27  4cab							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  4cab				   DrumHit
     29  4cab					      subroutine
     30  4cab		       8d 83 c4 	      sta	drumKind
     31  4cae		       8e 82 c4 	      stx	drumLvl
     32  4cb1		       8c 84 c4 	      sty	drumTom
     33  4cb4		       c9 00		      cmp	#DK_KICK
     34  4cb6		       d0 05		      bne	.nk
     35  4cb8		       a9 01		      lda	#1
     36  4cba		       8d 40 c6 	      sta	vizKick	; (the visualizer's border flash)
     37  4cbd				   .nk
     38  4cbd		       ad 27 c3 	      lda	devOn+DEV_NES
     39  4cc0		       d0 01		      bne	.on
     40  4cc2		       60		      rts
     41  4cc3				   .on
     42  4cc3		       20 0a 23 	      jsr	GetTicks
     43  4cc6		       ad 83 c4 	      lda	drumKind
     44  4cc9		       c9 02		      cmp	#DK_CH
     45  4ccb		       90 07		      bcc	.dmc
     46  4ccd		       c9 05		      cmp	#DK_TOM
     47  4ccf		       b0 03		      bcs	.dmc
     48  4cd1		       4c 86 4d 	      jmp	NoiseHit
     49  4cd4				   .dmc
     50  4cd4		       ae 83 c4 	      ldx	drumKind
     51  4cd7		       bd 6d 4d 	      lda	dmcPrioT,x
     52  4cda		       85 24		      sta	t0
     53  4cdc		       ad 3f c3 	      lda	nowL
     54  4cdf		       38		      sec
     55  4ce0		       ed 7a c4 	      sbc	dmcAt
     56  4ce3		       a8		      tay
     57  4ce4		       ad 40 c3 	      lda	nowH
     58  4ce7		       ed 7b c4 	      sbc	dmcAt+1
     59  4cea		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  4cec		       c0 0c		      cpy	#DRUM_WINDOW
     61  4cee		       b0 08		      bcs	.ok
     62  4cf0		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     63  4cf2		       cd 79 c4 	      cmp	dmcPrio
     64  4cf5		       90 01		      bcc	.ok
     65  4cf7		       60		      rts
     66  4cf8				   .ok
     67  4cf8							; the sample: kit[beat][kitOfs[kind] + level, or + tom]
     68  4cf8		       ae 83 c4 	      ldx	drumKind
     69  4cfb		       bd 74 4d 	      lda	kitOfs,x
     70  4cfe		       e0 05		      cpx	#DK_TOM
     71  4d00		       d0 07		      bne	.lv
     72  4d02		       18		      clc
     73  4d03		       6d 84 c4 	      adc	drumTom
     74  4d06		       4c 0d 4d 	      jmp	.k
     75  4d09				   .lv
     76  4d09		       18		      clc
     77  4d0a		       6d 82 c4 	      adc	drumLvl
     78  4d0d				   .k
     79  4d0d		       85 25		      sta	t1
     80  4d0f		       ad 6e c4 	      lda	beatSel	; x 12
     81  4d12		       0a		      asl
     82  4d13		       0a		      asl
     83  4d14		       85 26		      sta	t2
     84  4d16		       0a		      asl
     85  4d17		       65 26		      adc	t2
     86  4d19		       65 25		      adc	t1
     87  4d1b		       aa		      tax
     88  4d1c		       bd cc a6 	      lda	kits,x
     89  4d1f		       85 25		      sta	t1
     90  4d21							; bank (CC14 on the sample channel) when it changes
     91  4d21		       a9 04		      lda	#4
     92  4d23		       20 7b 4d 	      jsr	NesChStatus	; mS = CC, sample channel
     93  4d26		       a9 00		      lda	#0
     94  4d28		       a6 25		      ldx	t1
     95  4d2a		       10 02		      bpl	.a
     96  4d2c		       a9 7f		      lda	#127
     97  4d2e				   .a
     98  4d2e		       cd 78 c4 	      cmp	dmcBank
     99  4d31		       f0 0c		      beq	.note
    100  4d33		       8d 78 c4 	      sta	dmcBank
    101  4d36		       85 23		      sta	mD2
    102  4d38		       a9 0e		      lda	#14
    103  4d3a		       85 22		      sta	mD1
    104  4d3c		       20 37 0d 	      jsr	NesPut
    105  4d3f				   .note
    106  4d3f		       a5 21		      lda	mS
    107  4d41		       29 0f		      and	#$0F
    108  4d43		       85 26		      sta	t2	; channel
    109  4d45		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    110  4d47							;  cuts it anyway, and the hit lands 1 ms sooner)
    111  4d47		       29 7f		      and	#$7F
    112  4d49		       8d 85 c4 	      sta	dmcNote
    113  4d4c		       85 22		      sta	mD1
