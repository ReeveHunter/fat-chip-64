      3  0e9f							; Scan the whole matrix, turn changes into key events.
      4  0e9f							;
      5  0e9f							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0e9f							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0e9f							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0e9f							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0e9f							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0e9f							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0e9f							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0e9f							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0e9f							; chords whose ghost lands on another used key lose their newest note.
     14  0e9f				   KeyScan
     15  0e9f					      subroutine
     16  0e9f		       a2 07		      ldx	#7
     17  0ea1				   .col
     18  0ea1		       bd a2 7d 	      lda	colSelect,x
     19  0ea4		       8d 00 dc 	      sta	CIA1_PRA
     20  0ea7		       ad 01 dc 	      lda	CIA1_PRB
     21  0eaa		       49 ff		      eor	#$FF
     22  0eac		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0eaf		       9d 80 c2 	      sta	keyNow,x
     24  0eb2		       ca		      dex
     25  0eb3		       10 ec		      bpl	.col
     26  0eb5		       a9 ff		      lda	#$FF
     27  0eb7		       8d 00 dc 	      sta	CIA1_PRA
     28  0eba							; ---- every column as accepted (nothing pressed or let go): done
     29  0eba		       a2 07		      ldx	#7
     30  0ebc				   .same
     31  0ebc		       bd 80 c2 	      lda	keyNow,x
     32  0ebf		       dd 90 c2 	      cmp	keyAcc,x
     33  0ec2		       d0 04		      bne	.changed
     34  0ec4		       ca		      dex
     35  0ec5		       10 f5		      bpl	.same
     36  0ec7		       60		      rts
     37  0ec8				   .changed
     38  0ec8							; ---- releases first: accepted keys that are up now
     39  0ec8		       a2 00		      ldx	#0
     40  0eca				   .rc
     41  0eca		       8e 38 c3 	      stx	ksCol
     42  0ecd		       bd 80 c2 	      lda	keyNow,x
     43  0ed0		       49 ff		      eor	#$FF
     44  0ed2		       3d 90 c2 	      and	keyAcc,x
     45  0ed5		       8d 37 c3 	      sta	ksBits
     46  0ed8		       a9 00		      lda	#0
     47  0eda		       8d 39 c3 	      sta	ksRow
     48  0edd				   .rb
     49  0edd		       ad 37 c3 	      lda	ksBits
