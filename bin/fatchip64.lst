------- FILE drums.asm LEVEL 2 PASS 3
      0  4ea1					      include	"drums.asm"
      1  4ea1							; Fat Chip 64 - drums on the MidiNES
      2  4ea1							;
      3  4ea1							; Two sources, one kit:
      4  4ea1							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  4ea1							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  4ea1							;			   64 = hit, 56 = ghost)
      7  4ea1							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  4ea1							;			   RETURN starts / stops it, at its own tempo (B taps
      9  4ea1							;			   a new one)
     10  4ea1							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  4ea1							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  4ea1							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  4ea1							; a note-on, then a note-off after the sound's length, the level set with
     14  4ea1							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  4ea1							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  4ea1
     17  4ea1		       00 0c	   KIT_SIZE   equ	12
     18  4ea1		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  4ea1		       00 00	   DK_KICK    equ	0
     20  4ea1		       00 01	   DK_SNARE   equ	1
     21  4ea1		       00 02	   DK_CH      equ	2
     22  4ea1		       00 03	   DK_OH      equ	3
     23  4ea1		       00 04	   DK_CY      equ	4
     24  4ea1		       00 05	   DK_TOM     equ	5
     25  4ea1		       00 06	   DK_PERC    equ	6
     26  4ea1
     27  4ea1							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  4ea1				   DrumHit
     29  4ea1					      subroutine
     30  4ea1		       8d 8f c4 	      sta	drumKind
     31  4ea4		       8e 8e c4 	      stx	drumLvl
     32  4ea7		       8c 90 c4 	      sty	drumTom
     33  4eaa		       c9 00		      cmp	#DK_KICK
     34  4eac		       d0 05		      bne	.nk
     35  4eae		       a9 01		      lda	#1
     36  4eb0		       8d 4c c6 	      sta	vizKick	; (the visualizer's border flash)
     37  4eb3				   .nk
     38  4eb3		       ad 2b c3 	      lda	devOn+DEV_NES
     39  4eb6		       d0 01		      bne	.on
     40  4eb8		       60		      rts
     41  4eb9				   .on
     42  4eb9		       20 1e 24 	      jsr	GetTicks
     43  4ebc		       ad 8f c4 	      lda	drumKind
     44  4ebf		       c9 02		      cmp	#DK_CH
     45  4ec1		       90 07		      bcc	.dmc
     46  4ec3		       c9 05		      cmp	#DK_TOM
     47  4ec5		       b0 03		      bcs	.dmc
     48  4ec7		       4c 7c 4f 	      jmp	NoiseHit
     49  4eca				   .dmc
     50  4eca		       ae 8f c4 	      ldx	drumKind
     51  4ecd		       bd 63 4f 	      lda	dmcPrioT,x
     52  4ed0		       85 24		      sta	t0
     53  4ed2		       ad 43 c3 	      lda	nowL
     54  4ed5		       38		      sec
     55  4ed6		       ed 86 c4 	      sbc	dmcAt
     56  4ed9		       a8		      tay
     57  4eda		       ad 44 c3 	      lda	nowH
     58  4edd		       ed 87 c4 	      sbc	dmcAt+1
     59  4ee0		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  4ee2		       c0 0c		      cpy	#DRUM_WINDOW
     61  4ee4		       b0 08		      bcs	.ok
     62  4ee6		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     63  4ee8		       cd 85 c4 	      cmp	dmcPrio
     64  4eeb		       90 01		      bcc	.ok
     65  4eed		       60		      rts
     66  4eee				   .ok
     67  4eee							; the sample: kit[beat][kitOfs[kind] + level, or + tom]
     68  4eee		       ae 8f c4 	      ldx	drumKind
     69  4ef1		       bd 6a 4f 	      lda	kitOfs,x
     70  4ef4		       e0 05		      cpx	#DK_TOM
     71  4ef6		       d0 07		      bne	.lv
     72  4ef8		       18		      clc
     73  4ef9		       6d 90 c4 	      adc	drumTom
     74  4efc		       4c 03 4f 	      jmp	.k
     75  4eff				   .lv
     76  4eff		       18		      clc
     77  4f00		       6d 8e c4 	      adc	drumLvl
     78  4f03				   .k
     79  4f03		       85 25		      sta	t1
     80  4f05		       ad 7a c4 	      lda	beatSel	; x 12
     81  4f08		       0a		      asl
     82  4f09		       0a		      asl
     83  4f0a		       85 26		      sta	t2
     84  4f0c		       0a		      asl
     85  4f0d		       65 26		      adc	t2
     86  4f0f		       65 25		      adc	t1
     87  4f11		       aa		      tax
     88  4f12		       bd ba a8 	      lda	kits,x
     89  4f15		       85 25		      sta	t1
     90  4f17							; bank (CC14 on the sample channel) when it changes
     91  4f17		       a9 04		      lda	#4
     92  4f19		       20 71 4f 	      jsr	NesChStatus	; mS = CC, sample channel
     93  4f1c		       a9 00		      lda	#0
     94  4f1e		       a6 25		      ldx	t1
     95  4f20		       10 02		      bpl	.a
     96  4f22		       a9 7f		      lda	#127
     97  4f24				   .a
     98  4f24		       cd 84 c4 	      cmp	dmcBank
     99  4f27		       f0 0c		      beq	.note
    100  4f29		       8d 84 c4 	      sta	dmcBank
    101  4f2c		       85 23		      sta	mD2
    102  4f2e		       a9 0e		      lda	#14
    103  4f30		       85 22		      sta	mD1
    104  4f32		       20 57 0d 	      jsr	NesPut
    105  4f35				   .note
    106  4f35		       a5 21		      lda	mS
    107  4f37		       29 0f		      and	#$0F
    108  4f39		       85 26		      sta	t2	; channel
    109  4f3b		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    110  4f3d							;  cuts it anyway, and the hit lands 1 ms sooner)
    111  4f3d		       29 7f		      and	#$7F
    112  4f3f		       8d 91 c4 	      sta	dmcNote
    113  4f42		       85 22		      sta	mD1
    114  4f44		       a5 26		      lda	t2
    115  4f46		       09 90		      ora	#$90
    116  4f48		       85 21		      sta	mS
    117  4f4a		       a9 7f		      lda	#127
    118  4f4c		       85 23		      sta	mD2
    119  4f4e		       20 57 0d 	      jsr	NesPut
    120  4f51		       a5 24		      lda	t0
    121  4f53		       8d 85 c4 	      sta	dmcPrio
    122  4f56		       ad 43 c3 	      lda	nowL
    123  4f59		       8d 86 c4 	      sta	dmcAt
    124  4f5c		       ad 44 c3 	      lda	nowH
    125  4f5f		       8d 87 c4 	      sta	dmcAt+1
    126  4f62		       60		      rts
    127  4f63
    128  4f63		       00 01 00 00*dmcPrioT   .byte.b	0,1,0,0,0,2,3	; kick, snare, -, -, -, tom, perc
    129  4f6a		       00 03 00 00*kitOfs     .byte.b	0,3,0,0,0,6,9
    130  4f71
    131  4f71							; mS = control change on MidiNES channel nesBase + A
    132  4f71				   NesChStatus
    133  4f71					      subroutine
    134  4f71		       18		      clc
