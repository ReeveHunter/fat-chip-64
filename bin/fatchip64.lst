------- FILE main.asm LEVEL 1 PASS 3
      1  83d2 ????						; Fat Chip 64 - main program
      2  83d2 ????						; A live rig controller: plays the SID and drives a Game Boy (Fat Chip GB)
      3  83d2 ????						; and an NES (MidiNES) over the Kerberos MIDI out, as one fat instrument.
      4  83d2 ????						; Build: dasm src/main.asm -f1 -obin/fatchip64.prg -sbin/fatchip64.sym -lbin/fatchip64.lst
      5  83d2 ????
      6  83d2 ????				      processor	6502
