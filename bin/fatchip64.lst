    100  7aa8		       7d ce c7 	      adc	vWant,x
    101  7aab		       b0 02		      bcs	.ok	; (no borrow: 0 or more)
    102  7aad		       a9 00		      lda	#0
    103  7aaf				   .ok
    104  7aaf		       20 5b 22 	      jsr	SidPitch	; -> ptr
    105  7ab2		       a5 28		      lda	ptr
