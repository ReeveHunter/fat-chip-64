      0  666e					      include	"wander.asm"
      1  666e							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  666e							;
      3  666e							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  666e							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  666e							;   ATTACK   as always: the new notes start
      6  666e							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  666e							;	      has none)
      8  666e							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  666e							;	      start again
     10  666e							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  666e							;	      late; some glide, some start again (fade out, come back in)
     12  666e							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  666e							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  666e							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  666e							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  666e
     17  666e		       00 01	   CHG_ATTACK equ	1
     18  666e		       00 02	   CHG_GLIDE  equ	2
     19  666e		       00 03	   CHG_STAGGER equ	3
     20  666e		       00 04	   CHG_WANDER equ	4
     21  666e		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  666e
