------- FILE menu.asm LEVEL 2 PASS 3
      0  5a00					      include	"menu.asm"
      1  5a00							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  5a00							;
      3  5a00							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  5a00							;   page   RETURN opens a page
      5  5a00							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  5a00							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  5a00							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  5a00							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  5a00							; device pages, until DEVICES says the device is in use).
     10  5a00							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  5a00							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  5a00							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  5a00
     14  5a00		       00 17	   MENU_VALCOL equ	23
     15  5a00
