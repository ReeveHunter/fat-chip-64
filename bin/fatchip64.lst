------- FILE midiin.asm LEVEL 2 PASS 3
      0  3a65					      include	"midiin.asm"
      1  3a65							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  3a65							;
      3  3a65							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  3a65							; The main loop parses them (running status; realtime and system bytes are
      5  3a65							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  3a65							; notes mode, latch, arp and K + note.
      7  3a65							;
      8  3a65							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  3a65							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  3a65							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  3a65							;
     12  3a65							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  3a65							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  3a65							;
     15  3a65							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  3a65							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  3a65							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  3a65							; MIDI in is passed on to the Game Boy or NES.
     19  3a65
     20  3a65							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  3a65							; Uses A, X.
     22  3a65							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  3a65							; with the time; a Start ($FA) makes the next clock a beat.
     24  3a65				   RxByte
     25  3a65					      subroutine
     26  3a65		       ad 06 de 	      lda	ACIA_STAT
     27  3a68		       4a		      lsr		; RDRF -> carry
     28  3a69		       90 2b		      bcc	.x
     29  3a6b				   RxGot
     30  3a6b		       ad 07 de 	      lda	ACIA_RX
     31  3a6e		       c9 f8		      cmp	#$F8
     32  3a70		       f0 25		      beq	.clk
     33  3a72		       c9 fa		      cmp	#$FA
     34  3a74		       d0 0e		      bne	.buf
     35  3a76		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  3a78		       8e b5 ca 	      stx	clkPhase
     37  3a7b		       8e bd ca 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3a7e							;  the main loop could measure it)
     39  3a7e		       ae b6 ca 	      ldx	clkBeat
     40  3a81		       8e c8 ca 	      stx	clkStartBeat
     41  3a84				   .buf
     42  3a84		       ae f1 c8 	      ldx	rxHead
     43  3a87		       9d b1 c8 	      sta	rxBuf,x
     44  3a8a		       e8		      inx
     45  3a8b		       8a		      txa
     46  3a8c		       29 3f		      and	#63
     47  3a8e		       cd f2 c8 	      cmp	rxTail
     48  3a91		       f0 03		      beq	.x	; full: dropped
     49  3a93		       8d f1 c8 	      sta	rxHead
     50  3a96				   .x
     51  3a96		       60		      rts
     52  3a97				   .clk
     53  3a97		       ee b1 ca 	      inc	clkCount
     54  3a9a		       ae b5 ca 	      ldx	clkPhase
     55  3a9d		       e8		      inx
     56  3a9e		       e0 18		      cpx	#24
     57  3aa0		       90 1b		      bcc	.ph
     58  3aa2		       a5 10		      lda	ticks
     59  3aa4		       8d b8 ca 	      sta	clkAtL
     60  3aa7		       a5 11		      lda	ticks+1
     61  3aa9		       8d b9 ca 	      sta	clkAtH
     62  3aac		       a5 2d		      lda	subTick
     63  3aae		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  3ab0		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  3ab2		       ad 05 dc 	      lda	CIA1_TAHI
     66  3ab5				   .q
     67  3ab5		       8d ba ca 	      sta	clkAtS
     68  3ab8		       ee b6 ca 	      inc	clkBeat
