    106  4ea9		       a5 21		      lda	mS
    107  4eab		       29 0f		      and	#$0F
    108  4ead		       85 26		      sta	t2	; channel
    109  4eaf		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    110  4eb1							;  cuts it anyway, and the hit lands 1 ms sooner)
    111  4eb1		       29 7f		      and	#$7F
    112  4eb3		       8d 89 c4 	      sta	dmcNote
    113  4eb6		       85 22		      sta	mD1
    114  4eb8		       a5 26		      lda	t2
