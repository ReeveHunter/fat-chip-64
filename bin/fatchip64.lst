      0  0f35					      include	"keys.asm"
      1  0f35							; Fat Chip 64 - keyboard and RESTORE
      2  0f35
      3  0f35							; Scan the whole matrix, turn changes into key events.
      4  0f35							;
      5  0f35							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0f35							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0f35							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0f35							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0f35							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0f35							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0f35							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0f35							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0f35							; chords whose ghost lands on another used key lose their newest note.
     14  0f35				   KeyScan
     15  0f35					      subroutine
     16  0f35		       a2 07		      ldx	#7
     17  0f37				   .col
     18  0f37		       bd c3 98 	      lda	colSelect,x
     19  0f3a		       8d 00 dc 	      sta	CIA1_PRA
     20  0f3d		       ad 01 dc 	      lda	CIA1_PRB
     21  0f40		       49 ff		      eor	#$FF
     22  0f42		       3d 48 c7 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0f45		       9d 40 c7 	      sta	keyNow,x
     24  0f48		       ca		      dex
     25  0f49		       10 ec		      bpl	.col
     26  0f4b		       a9 ff		      lda	#$FF
     27  0f4d		       8d 00 dc 	      sta	CIA1_PRA
     28  0f50							; ---- every column as accepted (nothing pressed or let go): done
     29  0f50		       a2 07		      ldx	#7
     30  0f52				   .same
     31  0f52		       bd 40 c7 	      lda	keyNow,x
     32  0f55		       dd 50 c7 	      cmp	keyAcc,x
     33  0f58		       d0 04		      bne	.changed
     34  0f5a		       ca		      dex
     35  0f5b		       10 f5		      bpl	.same
     36  0f5d		       60		      rts
     37  0f5e				   .changed
     38  0f5e							; ---- releases first: accepted keys that are up now
     39  0f5e		       a2 00		      ldx	#0
     40  0f60				   .rc
     41  0f60		       8e fc c7 	      stx	ksCol
     42  0f63		       bd 40 c7 	      lda	keyNow,x
     43  0f66		       49 ff		      eor	#$FF
     44  0f68		       3d 50 c7 	      and	keyAcc,x
     45  0f6b		       8d fb c7 	      sta	ksBits
     46  0f6e		       a9 00		      lda	#0
