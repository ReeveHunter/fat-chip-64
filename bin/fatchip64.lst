    142  0f04							; A = key code at ksCol / ksRow
    143  0f04				   KeyCode
    144  0f04					      subroutine
    145  0f04		       ad 37 c3 	      lda	ksCol
    146  0f07		       0a		      asl
    147  0f08		       0a		      asl
    148  0f09		       0a		      asl
    149  0f0a		       0d 38 c3 	      ora	ksRow
    150  0f0d		       a8		      tay
    151  0f0e		       b9 03 6e 	      lda	keymap,y
    152  0f11		       60		      rts
