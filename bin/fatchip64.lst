------- FILE main.asm
------- FILE devices.asm LEVEL 2 PASS 3
      0  55ff					      include	"devices.asm"
      1  55ff							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  55ff							; are in use, and each one in use gets its page on the main menu.
      3  55ff							;
      4  55ff							; YAMAHA SHS-10 (the keytar)
      5  55ff							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  55ff							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  55ff							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  55ff							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  55ff							;		     can play at once.)
     10  55ff							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  55ff							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  55ff							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  55ff							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  55ff							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  55ff							;		     louder (the SID and the NES; the Game Boy would click) or
     16  55ff							;		     brighter (the SID's filter: switched on if the patch has
     17  55ff							;		     none)
     18  55ff							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  55ff							;		     the patch's, or the ADVANCED amounts if it has none;
     20  55ff							;		     FILTER), or an action held while blowing hard
     21  55ff							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  55ff							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  55ff							;   PORTAMENTO BUTTON	an action (CC 65)
     24  55ff							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  55ff							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  55ff							; ATARI SYNTHCART
     27  55ff							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  55ff							;		     about 3% while held, SHIFT + , . step through the ten
     29  55ff							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  55ff
     31  55ff		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     32  55ff		       00 28	   BREATH_LO  equ	40
     33  55ff		       00 01	   BFX_VIB    equ	1
     34  55ff		       00 02	   BFX_WARB   equ	2
     35  55ff		       00 03	   BFX_DET    equ	3
     36  55ff		       00 04	   BFX_FILT   equ	4
     37  55ff		       00 05	   BFX_HELD   equ	5
     38  55ff
