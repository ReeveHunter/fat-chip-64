------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  5ae4					      include	"sync.asm"
      1  5ae4							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  5ae4							;
      3  5ae4							; Menu, DEVICE SYNC (defaults first):
      4  5ae4							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  5ae4							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  5ae4							;		     sets the tempo, averaged over beats (the clock jitters about
      7  5ae4							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  5ae4							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  5ae4							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  5ae4							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  5ae4							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  5ae4							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  5ae4							;		     picks a beat (styleBeat)
     14  5ae4							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  5ae4							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  5ae4							;		     key channel) picks a sound (voiceSound)
     17  5ae4							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  5ae4							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  5ae4							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  5ae4							;
     21  5ae4							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  5ae4							; 1/4 ms); a Start makes the next clock a beat.
     23  5ae4
     24  5ae4		       00 00	   TEMPO_KEYTAR equ	0
     25  5ae4		       00 01	   TEMPO_OWN  equ	1
     26  5ae4		       00 02	   TEMPO_SC   equ	2
     27  5ae4		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  5ae4
     29  5ae4
     30  5ae4
