------- FILE screen.asm LEVEL 2 PASS 3
      0  696e					      include	"screen.asm"
      1  696e							; Fat Chip 64 - screen
      2  696e							;
      3  696e							;  row 0      header
      4  696e							;  row 2      sound, POLY / MONO, Fat Bass
      5  696e							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  696e							;	       each plays (row 7: a channel overlap warning)
      7  696e							;  row 9      key, notes mode, latch
      8  696e							;  row 10     arp
      9  696e							;  row 12     tempo, beat, mute
     10  696e							;  row 13     SPACE's action, octave (the lowest key)
     11  696e							;  row 15     held notes
     12  696e							;  row 16     MIDI in
     13  696e							;  row 24     F keys
     14  696e
     15  696e							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     16  696e							; Letters become screen codes; bit 7 of t2 reverses.
     17  696e				   PrintAt
     18  696e					      subroutine
     19  696e		       20 86 69 	      jsr	ScreenAddr
     20  6971		       a0 00		      ldy	#0
     21  6973				   .c
     22  6973		       b1 28		      lda	(ptr),y
     23  6975		       f0 0e		      beq	.done
