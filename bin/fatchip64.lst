------- FILE main.asm
------- FILE voices.asm LEVEL 2 PASS 3
      0  19ef					      include	"voices.asm"
      1  19ef							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  19ef							;
      3  19ef							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  19ef							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  19ef							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  19ef							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  19ef							; Allocation, whenever the held notes change. Who comes first (v0.21):
      8  19ef							; Polyphony > Fat Bass > the patch's effects (REPEAT's echoes) > stacking.
      9  19ef							;   1. every note gets a voice (SPARKLE's arp pair is what you play, so it
     10  19ef							;	counts as notes and goes first)
     11  19ef							;   2. Fat Bass: as many bass voices as are spare play the lowest note,
     12  19ef							;	folded into the bass range (one note fewer needs a voice, so with
     13  19ef							;	Fat Bass the bottom of the chord is the bass)
     14  19ef							;   3. REPEAT's echo voices: one or two of what's still spare
     15  19ef							;   4. leftover voices stack on the lowest two notes, alternating
     16  19ef							; So one note = a nine-voice unison across three chips, and in chords the
     17  19ef							; bottom of the chord is fattest. Disabled devices, and voices the drums
     18  19ef							; hold (vDrum), get no notes.
     19  19ef
     20  19ef							; ------------------------------------------------------------ SID
     21  19ef				   SidInit
     22  19ef					      subroutine
     23  19ef		       a2 18		      ldx	#24
     24  19f1		       a9 00		      lda	#0
     25  19f3				   .clr
     26  19f3		       9d 00 d4 	      sta	SID,x
     27  19f6		       ca		      dex
     28  19f7		       10 fa		      bpl	.clr
     29  19f9		       20 1c 1a 	      jsr	SidVolume
     30  19fc		       a2 02		      ldx	#2
     31  19fe				   .v
     32  19fe		       bc 98 81 	      ldy	sidOfs,x
     33  1a01		       a9 19		      lda	#$19	; attack 1, decay 9
     34  1a03		       99 05 d4 	      sta	SID+5,y
     35  1a06		       a9 c9		      lda	#$C9	; sustain 12, release 9
     36  1a08		       99 06 d4 	      sta	SID+6,y
     37  1a0b		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     38  1a0d		       99 03 d4 	      sta	SID+3,y
     39  1a10		       a9 20		      lda	#$20	; sawtooth, gate off
     40  1a12		       9d 32 c3 	      sta	sidGate,x
     41  1a15		       99 04 d4 	      sta	SID+4,y
     42  1a18		       ca		      dex
     43  1a19		       10 e3		      bpl	.v
     44  1a1b		       60		      rts
     45  1a1c
     46  1a1c							; Volume 15, or 0 (silent, no hum) when the SID is off or muted (M).
     47  1a1c							; Volume 15, or 0 when the SID is off or muted. Keeps the filter mode bits.
     48  1a1c				   SidVolume
     49  1a1c					      subroutine
     50  1a1c		       ad 25 c3 	      lda	devOn+DEV_SID
     51  1a1f		       f0 1a		      beq	.z
