      0  59f0					      include	"patchedit.asm"
      1  59f0							; Fat Chip 64 - editing the live patch (v0.24): the menu's PATCH pages and
      2  59f0							; the dice. The settings and their steps come from tools/gen_menu.py
      3  59f0							; (menutab.asm): each step of a setting writes a few live patch bytes
      4  59f0							; (field, mask, value), and one "key" byte (or two) tells which step a patch
      5  59f0							; is on. The Game Boy's one LFO belongs to VIBRATO when it's on, else PWM
      6  59f0							; (LfoFix); the envelope's Game Boy and NES parts follow its SID nibbles
      7  59f0							; (EnvDerive).
      8  59f0
