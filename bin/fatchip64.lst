    171  0d28							; A = key code
    172  0d28							;   overlay	    notes (K held + a note: set the key)
    173  0d28							;   F1/F3/F5/F7    octave: C4 / C3 / C2 / C1 on the lowest key
    174  0d28							;   SHIFT+F1/F3/F5 SID / Game Boy / MidiNES on-off	SHIFT+F7 panic
    175  0d28							;   CTRL+F3/F5     Game Boy / MidiNES: next channel block
    176  0d28							;   M		    mute everything	   SPACE  momentary (flips mute while held)
    177  0d28							;   =		    latch: OFF -> SMART -> HOLD -> ADD -> OFF
    178  0d28							;   N		    new chord: the next note starts one (twice: clear now)
    179  0d28							;   Z / X	    notes mode (POLY, CHORD, EXT) / extensions (7 9 11 13)
    180  0d28							;   K + note / L   key root / major-minor	  V  sound: FAT or PADS
    181  0d28							;   A / S / D / F  arp mode / pattern / speed / SPARKLE octave
    182  0d28							;   H / J	    free arp speed	      B  tap tempo
    183  0d28							;   G		    phantom-key filter on / off (off at start; for testing)
    184  0d28				   KeyDown
    185  0d28					      subroutine
    186  0d28		       c9 18		      cmp	#24
    187  0d2a		       90 03		      bcc	.isNote
    188  0d2c		       4c c1 0d 	      jmp	.cmd
    189  0d2f				   .isNote
