    465  3ac6		       60		      rts
    466  3ac7		       7d 46 43 01*sxHead     .byte.b	$7D, $46, $43, $01, PATCH_SIZE	; (the size: a Chip Lab with another layout is ignored)
    467  3acc
    468  3acc							; F0 7D 46 43 02 m F7 (v0.23): the chips on or off, m bit 0 SID, 1 Game
    469  3acc							; Boy, 2 NES (Chip Lab's chip buttons) - as SHIFT / C= + F1 F3 F5 do
    470  3acc				   DevicesReceived
    471  3acc					      subroutine
    472  3acc		       a2 00		      ldx	#0
    473  3ace				   .d
    474  3ace		       8e 1f c8 	      stx	sxI
