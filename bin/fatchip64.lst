    130  0fa0		       c9 89		      cmp	#K_RSHIFT
    131  0fa2		       f0 0e		      beq	.y
    132  0fa4		       c9 8c		      cmp	#K_CTRL
    133  0fa6		       f0 0a		      beq	.y
    134  0fa8		       c9 a2		      cmp	#K_CBM
    135  0faa		       f0 06		      beq	.y
    136  0fac		       c9 a3		      cmp	#K_STOP
    137  0fae		       f0 02		      beq	.y
