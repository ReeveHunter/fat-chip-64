      0  67d8					      include	"nesfx.asm"
      1  67d8							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  67d8							;
      3  67d8							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  67d8							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  67d8							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  67d8							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  67d8							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  67d8							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  67d8							;   glide    a new note starts bent back to the voice's last note and slides
     10  67d8							;	      in the way the SID's does (all three channels)
     11  67d8							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  67d8							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  67d8							; semitone, so these are a little stepped.
     14  67d8
     15  67d8		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  67d8							;  (the pulses, and the triangle while it glides)
     17  67d8
     18  67d8							; A = 1 (not Z) when a NesFxTick step is due
     19  67d8				   NesFxDue
