    148  0fd8							; A = key code at ksCol / ksRow
    149  0fd8				   KeyCode
    150  0fd8					      subroutine
    151  0fd8		       ad 38 c3 	      lda	ksCol
    152  0fdb		       0a		      asl
    153  0fdc		       0a		      asl
    154  0fdd		       0a		      asl
