------- FILE drums.asm LEVEL 2 PASS 3
      0  4781					      include	"drums.asm"
      1  4781							; Fat Chip 64 - drums on the MidiNES
      2  4781							;
      3  4781							; Two sources, one kit:
      4  4781							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  4781							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  4781							;			   64 = hit, 56 = ghost)
      7  4781							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  4781							;			   RETURN starts / stops it, at its own tempo (B taps
      9  4781							;			   a new one)
     10  4781							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  4781							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  4781							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  4781							; a note-on, then a note-off after the sound's length, the level set with
     14  4781							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  4781							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  4781
     17  4781		       00 0c	   KIT_SIZE   equ	12
     18  4781		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  4781		       00 00	   DK_KICK    equ	0
     20  4781		       00 01	   DK_SNARE   equ	1
     21  4781		       00 02	   DK_CH      equ	2
     22  4781		       00 03	   DK_OH      equ	3
     23  4781		       00 04	   DK_CY      equ	4
     24  4781		       00 05	   DK_TOM     equ	5
     25  4781		       00 06	   DK_PERC    equ	6
     26  4781
     27  4781							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
