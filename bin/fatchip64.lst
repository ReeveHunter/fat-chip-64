    480  5ea7							; ------------------------------------------------------------ actions
    481  5ea7							; What SPACE and the keytar's buttons do (menu: SPACE, ... BUTTON):
    482  5ea7							;   held     MUTE, BEND DOWN, BEND UP, VIBRATO, TREMOLO, ARP, STUTTER,
    483  5ea7							;	      VINYL STOP, GLIDE, SUSTAIN, OCTAVE UP, REPEAT, FILTER SWEEP,
    484  5ea7							;	      BEAT FILL, TAPE WOBBLE, WIDE
    485  5ea7							;   a press  TAP TEMPO, BEAT ON/OFF, NEXT SOUND; or NOTHING
    486  5ea7							; A held action can be held by several at once; it ends when the last lets go.
    487  5ea7							;
    488  5ea7							; A = action, t3 = 1 pressed / 0 let go
