    362  0d70							; ------------------------------------------------------------ device setup
    363  0d70							; Fat Chip GB startup / resync (protocol section 2)
    364  0d70				   GbStartup
    365  0d70					      subroutine
    366  0d70		       ad 26 c3 	      lda	devOn+DEV_GB
    367  0d73		       f0 5c		      beq	.done
    368  0d75							; first, move the Game Boy's voices to our channels (Fat Chip GB v0.08
    369  0d75							; hears CC 113 on any channel, so its own setting doesn't matter)
    370  0d75		       ad 28 c3 	      lda	gbBase
    371  0d78		       18		      clc
