     95  2f40		       a2 00		      ldx	#0	; a channel message ends any SysEx
     96  2f42		       8e 4c c7 	      stx	sxOn
     97  2f45		       f0 05		      beq	.status
     98  2f47				   .sys
     99  2f47		       20 f2 30 	      jsr	SysexStatus	; F0 starts a SysEx, F7 ends it (v0.20)
    100  2f4a		       a9 00		      lda	#0	; system: no running status until the next one
    101  2f4c				   .status
    102  2f4c		       8d 26 c4 	      sta	rxStatus
    103  2f4f		       a9 00		      lda	#0
    104  2f51		       8d 27 c4 	      sta	rxCnt
