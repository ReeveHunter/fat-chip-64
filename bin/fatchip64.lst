------- FILE nesfx.asm LEVEL 2 PASS 3
      0  6b50					      include	"nesfx.asm"
      1  6b50							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  6b50							;
      3  6b50							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  6b50							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  6b50							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  6b50							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  6b50							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  6b50							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  6b50							;   glide    a new note starts bent back to the voice's last note and slides
     10  6b50							;	      in the way the SID's does (all three channels)
     11  6b50							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  6b50							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  6b50							; semitone, so these are a little stepped.
     14  6b50
     15  6b50		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  6b50							;  (the pulses, and the triangle while it glides)
     17  6b50
     18  6b50							; A = 1 (not Z) when a NesFxTick step is due
     19  6b50				   NesFxDue
     20  6b50					      subroutine
     21  6b50		       ad 27 c3 	      lda	devOn+DEV_NES
     22  6b53		       f0 19		      beq	.x
     23  6b55		       ad fe c5 	      lda	vibDepth
     24  6b58		       0d 2c c5 	      ora	nfxGlide
     25  6b5b		       0d 2d c5 	      ora	nfxRun
     26  6b5e		       f0 0e		      beq	.x
     27  6b60		       a5 10		      lda	ticks
     28  6b62		       38		      sec
     29  6b63		       ed 28 c5 	      sbc	nfxLast
     30  6b66		       c9 08		      cmp	#NFX_EVERY
     31  6b68		       a9 00		      lda	#0
     32  6b6a		       90 02		      bcc	.x
     33  6b6c		       a9 01		      lda	#1
     34  6b6e				   .x
     35  6b6e		       60		      rts
     36  6b6f
     37  6b6f							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  6b6f							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  6b6f							; quick return.
     40  6b6f				   NesFxTick
     41  6b6f					      subroutine
     42  6b6f		       ad 27 c3 	      lda	devOn+DEV_NES
     43  6b72		       f0 0b		      beq	.q
