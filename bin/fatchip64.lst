------- FILE sounds.asm LEVEL 2 PASS 3
      0  2b91					      include	"sounds.asm"
      1  2b91							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  2b91							;
      3  2b91							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  2b91							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  2b91							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  2b91							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  2b91							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  2b91							;
      9  2b91							; Each sound has a mono default and a Fat Bass default:
     10  2b91							;   MONO      one note (the last key pressed and still held) on every voice;
     11  2b91							;	       a new key while another is held changes the pitch without a
     12  2b91							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  2b91							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  2b91							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  2b91							;	       the other voices
     16  2b91							;
     17  2b91							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  2b91							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  2b91							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  2b91
     21  2b91							; ------------------------------------------------------------ choosing
     22  2b91							; V: next sound (SHIFT+V: previous)
     23  2b91				   SoundKey
     24  2b91					      subroutine
     25  2b91		       20 d3 2b 	      jsr	SoundRelease	; held notes end with the old sound's settings...
