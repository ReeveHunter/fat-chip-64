     96  7e97		       8d 31 c5 	      sta	nfxGlide	; (still gliding)
     97  7e9a		       ca		      dex
     98  7e9b		       ca		      dex
     99  7e9c		       ca		      dex
    100  7e9d		       10 de		      bpl	.v
    101  7e9f							; ---- the NES queue needs room
