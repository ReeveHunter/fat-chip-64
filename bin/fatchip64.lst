    160  0fac							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    161  0fac							; keys: some other column has a key in this row and shares another row with
    162  0fac							; this column.
    163  0fac				   Suspect
    164  0fac					      subroutine
    165  0fac		       ac 39 c3 	      ldy	ksRow
    166  0faf		       b9 4f 80 	      lda	rowBit,y
    167  0fb2		       49 ff		      eor	#$FF
    168  0fb4		       ae 38 c3 	      ldx	ksCol
    169  0fb7		       3d 80 c2 	      and	keyNow,x
    170  0fba		       8d 3a c3 	      sta	ksMask	; this column's other held rows
    171  0fbd		       f0 1c		      beq	.no
    172  0fbf		       a2 07		      ldx	#7
    173  0fc1				   .c
    174  0fc1		       ec 38 c3 	      cpx	ksCol
    175  0fc4		       f0 12		      beq	.n
    176  0fc6		       bd 80 c2 	      lda	keyNow,x
    177  0fc9		       39 4f 80 	      and	rowBit,y
    178  0fcc		       f0 0a		      beq	.n
    179  0fce		       bd 80 c2 	      lda	keyNow,x
    180  0fd1		       2d 3a c3 	      and	ksMask
    181  0fd4		       f0 02		      beq	.n
    182  0fd6		       38		      sec
    183  0fd7		       60		      rts
    184  0fd8				   .n
    185  0fd8		       ca		      dex
