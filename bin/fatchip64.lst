     44  4e1c		       4c 40 4e 	      jmp	.beatq
     45  4e1f				   .alive
     46  4e1f		       ad f2 c5 	      lda	clkHave	; none for a while: start measuring afresh
     47  4e22		       f0 1c		      beq	.beatq
     48  4e24		       20 49 1f 	      jsr	GetTicks
     49  4e27		       ad 3f c3 	      lda	nowL
     50  4e2a		       38		      sec
     51  4e2b		       ed e7 c5 	      sbc	clkSeenL
     52  4e2e		       aa		      tax
     53  4e2f		       ad 40 c3 	      lda	nowH
     54  4e32		       ed e8 c5 	      sbc	clkSeenH
     55  4e35		       d0 04		      bne	.lost
     56  4e37		       e0 2c		      cpx	#<CLK_ALIVE
     57  4e39		       90 05		      bcc	.beatq
     58  4e3b				   .lost
     59  4e3b		       a9 00		      lda	#0
     60  4e3d		       8d f2 c5 	      sta	clkHave
     61  4e40				   .beatq
     62  4e40		       ad ea c5 	      lda	clkBeat
