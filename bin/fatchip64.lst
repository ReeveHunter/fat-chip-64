------- FILE keys.asm LEVEL 2 PASS 3
      0  0e52					      include	"keys.asm"
      1  0e52							; Fat Chip 64 - keyboard and RESTORE
      2  0e52
      3  0e52							; Scan the whole matrix, turn changes into key events.
      4  0e52							;
      5  0e52							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0e52							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0e52							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0e52							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0e52							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0e52							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0e52							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0e52							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0e52							; chords whose ghost lands on another used key lose their newest note.
     14  0e52				   KeyScan
     15  0e52					      subroutine
     16  0e52		       a2 07		      ldx	#7
     17  0e54				   .col
     18  0e54		       bd c7 6e 	      lda	colSelect,x
     19  0e57		       8d 00 dc 	      sta	CIA1_PRA
     20  0e5a		       ad 01 dc 	      lda	CIA1_PRB
     21  0e5d		       49 ff		      eor	#$FF
     22  0e5f		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0e62		       9d 80 c2 	      sta	keyNow,x
     24  0e65		       ca		      dex
     25  0e66		       10 ec		      bpl	.col
     26  0e68		       a9 ff		      lda	#$FF
     27  0e6a		       8d 00 dc 	      sta	CIA1_PRA
     28  0e6d							; ---- every column as accepted (nothing pressed or let go): done
     29  0e6d		       a2 07		      ldx	#7
     30  0e6f				   .same
     31  0e6f		       bd 80 c2 	      lda	keyNow,x
