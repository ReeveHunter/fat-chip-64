    128  0cac							; A = key code at ksCol / ksRow
    129  0cac				   KeyCode
    130  0cac					      subroutine
    131  0cac		       ad 1f c3 	      lda	ksCol
    132  0caf		       0a		      asl
    133  0cb0		       0a		      asl
    134  0cb1		       0a		      asl
    135  0cb2		       0d 20 c3 	      ora	ksRow
    136  0cb5		       a8		      tay
