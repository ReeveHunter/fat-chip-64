     79  6d5c		       a9 00		      lda	#0
     80  6d5e		       8d 2c c5 	      sta	nfxGlide
     81  6d61		       a2 08		      ldx	#8	; (the NES voices: 2, 5, 8)
     82  6d63				   .v
     83  6d63		       bd d5 c4 	      lda	nesVT,x
     84  6d66		       18		      clc
     85  6d67		       6d 2e c5 	      adc	nfxN
     86  6d6a		       90 02		      bcc	.vt
     87  6d6c		       a9 ff		      lda	#255
     88  6d6e				   .vt
     89  6d6e		       9d d5 c4 	      sta	nesVT,x
     90  6d71		       20 e2 6d 	      jsr	NesGlideStep
     91  6d74		       bd c3 c4 	      lda	nesGlL,x
     92  6d77		       1d cc c4 	      ora	nesGlH,x
     93  6d7a		       0d 2c c5 	      ora	nfxGlide
