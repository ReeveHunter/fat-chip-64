------- FILE devices.asm LEVEL 2 PASS 3
      0  5ccb					      include	"devices.asm"
      1  5ccb							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  5ccb							; are in use, and each one in use gets its page on the main menu.
      3  5ccb							;
      4  5ccb							; YAMAHA SHS-10 (the keytar)
      5  5ccb							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  5ccb							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  5ccb							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  5ccb							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  5ccb							;		     can play at once.)
     10  5ccb							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  5ccb							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  5ccb							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  5ccb							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  5ccb							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  5ccb							;		     louder (the SID and the NES; the Game Boy would click) or
     16  5ccb							;		     brighter (the SID's filter: switched on if the patch has
     17  5ccb							;		     none)
     18  5ccb							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  5ccb							;		     the patch's, or the ADVANCED amounts if it has none;
     20  5ccb							;		     FILTER), or an action held while blowing hard
     21  5ccb							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  5ccb							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  5ccb							;   PORTAMENTO BUTTON	an action (CC 65)
     24  5ccb							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  5ccb							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  5ccb							; ATARI SYNTHCART
     27  5ccb							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  5ccb							;		     about 3% while held, SHIFT + , . step through the ten
     29  5ccb							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  5ccb							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  5ccb							;		     sound's cents (the Synthcart manual's table: each Atari
     32  5ccb							;		     sound plays its scales in its own key, a little off)
     33  5ccb							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  5ccb
     35  5ccb		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  5ccb		       00 28	   BREATH_LO  equ	40
     37  5ccb		       00 01	   BFX_VIB    equ	1
     38  5ccb		       00 02	   BFX_WARB   equ	2
     39  5ccb		       00 03	   BFX_DET    equ	3
     40  5ccb		       00 04	   BFX_FILT   equ	4
     41  5ccb		       00 05	   BFX_HELD   equ	5
     42  5ccb
