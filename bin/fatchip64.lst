      0  5bec					      include	"menu.asm"
      1  5bec							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  5bec							;
      3  5bec							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  5bec							;   page   RETURN opens a page
      5  5bec							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  5bec							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  5bec							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  5bec							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  5bec							; device pages, until DEVICES says the device is in use).
     10  5bec							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  5bec							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  5bec							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  5bec
     14  5bec		       00 17	   MENU_VALCOL equ	23
     15  5bec
