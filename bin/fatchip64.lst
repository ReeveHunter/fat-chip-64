     81  0f43		       8d 36 c3 	      sta	ksBits
     82  0f46		       a9 00		      lda	#0
     83  0f48		       8d 38 c3 	      sta	ksRow
     84  0f4b				   .pb
     85  0f4b		       ad 36 c3 	      lda	ksBits
     86  0f4e		       f0 3d		      beq	.pcn
     87  0f50		       4e 36 c3 	      lsr	ksBits
     88  0f53		       90 33		      bcc	.pbn
     89  0f55		       ad 3b c3 	      lda	ghostFilter
     90  0f58		       f0 05		      beq	.accept	; filter off (default): phantoms play
     91  0f5a		       20 c6 0f 	      jsr	Suspect
     92  0f5d		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     93  0f5f				   .accept
     94  0f5f		       20 b8 0f 	      jsr	KeyCode
     95  0f62		       20 a1 0f 	      jsr	IsModifier	; Z set = modifier
     96  0f65		       f0 07		      beq	.mod
     97  0f67		       ad 3a c3 	      lda	ksPass
     98  0f6a		       f0 1c		      beq	.pbn	; pass 0: modifiers only
     99  0f6c		       d0 05		      bne	.take
    100  0f6e				   .mod
    101  0f6e		       ad 3a c3 	      lda	ksPass
    102  0f71		       d0 15		      bne	.pbn	; (taken in pass 0)
    103  0f73				   .take
    104  0f73		       ae 37 c3 	      ldx	ksCol
