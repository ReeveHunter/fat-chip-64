------- FILE midi.asm LEVEL 2 PASS 3
      0  0b33					      include	"midi.asm"
      1  0b33							; Fat Chip 64 - MIDI out
      2  0b33							;
      3  0b33							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0b33							; at most one message per device onto the wire buffer, no sooner than that
      5  0b33							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0b33							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0b33							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0b33							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0b33							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0b33
     11  0b33				   MidiInit
     12  0b33					      subroutine
     13  0b33		       a9 03		      lda	#ACIA_RESET
     14  0b35		       8d 04 de 	      sta	ACIA_CTRL
     15  0b38		       a9 16		      lda	#ACIA_MODE
     16  0b3a		       8d 04 de 	      sta	ACIA_CTRL
     17  0b3d							; (fall into the test)
     18  0b3d
     19  0b3d							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0b3d							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0b3d							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0b3d							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0b3d							; before. Interrupts are off when this is called.
     24  0b3d				   MidiIrqTest
     25  0b3d					      subroutine
     26  0b3d		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0b3f		       8d 0d dc 	      sta	CIA1_ICR
     28  0b42		       ad 0d dc 	      lda	CIA1_ICR
     29  0b45		       a9 8d		      lda	#<IrqTest
     30  0b47		       8d fe ff 	      sta	$FFFE
     31  0b4a		       a9 0b		      lda	#>IrqTest
     32  0b4c		       8d ff ff 	      sta	$FFFF
     33  0b4f		       a9 00		      lda	#0
     34  0b51		       85 2f		      sta	midiIrq
     35  0b53		       a9 b6		      lda	#ACIA_MODE_TX
     36  0b55		       8d 04 de 	      sta	ACIA_CTRL
     37  0b58		       58		      cli
     38  0b59		       a2 00		      ldx	#0
     39  0b5b				   .w
     40  0b5b		       ca		      dex
     41  0b5c		       d0 fd		      bne	.w
     42  0b5e		       78		      sei
     43  0b5f		       a6 2f		      ldx	midiIrq
     44  0b61		       bd 99 0b 	      lda	midiCtl,x
     45  0b64		       8d 04 de 	      sta	ACIA_CTRL
     46  0b67		       bd 9b 0b 	      lda	irqLo,x
     47  0b6a		       8d fe ff 	      sta	$FFFE
     48  0b6d		       bd 9d 0b 	      lda	irqHi,x
     49  0b70		       8d ff ff 	      sta	$FFFF
     50  0b73		       bd 9f 0b 	      lda	latchLo,x
     51  0b76		       8d 04 dc 	      sta	CIA1_TALO
     52  0b79		       bd a1 0b 	      lda	latchHi,x
     53  0b7c		       8d 05 dc 	      sta	CIA1_TAHI
     54  0b7f		       a9 11		      lda	#$11	; start, force load, continuous
     55  0b81		       8d 0e dc 	      sta	CIA1_CRA
     56  0b84		       ad 0d dc 	      lda	CIA1_ICR
     57  0b87		       a9 81		      lda	#$81	; timer A interrupt on
