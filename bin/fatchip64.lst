      0  65af					      include	"nesfx.asm"
      1  65af							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  65af							;
      3  65af							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  65af							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  65af							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  65af							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  65af							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  65af							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  65af							;   glide    a new note starts bent back to the voice's last note and slides
     10  65af							;	      in the way the SID's does (all three channels)
     11  65af							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  65af							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  65af							; semitone, so these are a little stepped.
     14  65af
     15  65af		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  65af							;  (the pulses, and the triangle while it glides)
     17  65af
     18  65af							; A = 1 (not Z) when a NesFxTick step is due
     19  65af				   NesFxDue
     20  65af					      subroutine
     21  65af		       ad 27 c3 	      lda	devOn+DEV_NES
     22  65b2		       f0 19		      beq	.x
     23  65b4		       ad fe c5 	      lda	vibDepth
     24  65b7		       0d 2c c5 	      ora	nfxGlide
     25  65ba		       0d 2d c5 	      ora	nfxRun
     26  65bd		       f0 0e		      beq	.x
     27  65bf		       a5 10		      lda	ticks
     28  65c1		       38		      sec
     29  65c2		       ed 28 c5 	      sbc	nfxLast
     30  65c5		       c9 08		      cmp	#NFX_EVERY
     31  65c7		       a9 00		      lda	#0
     32  65c9		       90 02		      bcc	.x
     33  65cb		       a9 01		      lda	#1
     34  65cd				   .x
     35  65cd		       60		      rts
     36  65ce
     37  65ce							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  65ce							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  65ce							; quick return.
