    155  55b5							; clk16 += (period - clk16) / 4; off by more than a quarter (the tempo
    156  55b5							; jumped): the new period at once
    157  55b5		       ad 00 c6 	      lda	clk16H	; bT1:bT0 = clk16 / 4
