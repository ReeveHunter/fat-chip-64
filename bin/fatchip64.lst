    181  0c1e		       90 20		      bcc	.done
    182  0c20		       a6 1b		      ldx	nesqTail
    183  0c22		       bd c0 c1 	      lda	nesqS,x
    184  0c25		       bc 40 c2 	      ldy	nesqD2,x
    185  0c28		       84 2c		      sty	irqT
    186  0c2a		       bc 00 c2 	      ldy	nesqD1,x
