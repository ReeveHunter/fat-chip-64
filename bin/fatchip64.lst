    110  21cb				   .wu
    111  21cb		       ad 9e c4 	      lda	wheelMag
    112  21ce		       38		      sec
    113  21cf		       ed d5 c3 	      sbc	bendLvl
    114  21d2		       a2 01		      ldx	#1
    115  21d4		       b0 06		      bcs	.comb
    116  21d6		       49 ff		      eor	#$FF	; the SPACE bend is bigger: down
    117  21d8		       69 01		      adc	#1
    118  21da		       a2 00		      ldx	#0
    119  21dc				   .comb
    120  21dc		       8d a0 c4 	      sta	bendMag
    121  21df		       8e a1 c4 	      stx	bendUp
    122  21e2		       cd a3 c4 	      cmp	bendSidMag
    123  21e5		       d0 05		      bne	.sid
    124  21e7		       ec a4 c4 	      cpx	bendSidUp
    125  21ea		       f0 09		      beq	.mid2
    126  21ec				   .sid
