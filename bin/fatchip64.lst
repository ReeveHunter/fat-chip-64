------- FILE repeat.asm LEVEL 2 PASS 3
      0  3d7f					      include	"repeat.asm"
      1  3d7f							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  3d7f							;
      3  3d7f							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  3d7f							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  3d7f							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  3d7f							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  3d7f							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  3d7f							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  3d7f							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  3d7f							; 3/4 of the time between echoes. The SID doesn't echo.
     11  3d7f							;
     12  3d7f							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  3d7f							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  3d7f							; or a keytar button).
     15  3d7f							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  3d7f							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  3d7f
     18  3d7f		       00 10	   RP_SLOTS   equ	16
     19  3d7f		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  3d7f
     21  3d7f							; REPEAT is on now?
     22  3d7f				   RepeatActive
     23  3d7f		       ad 4b c5 	      lda	repeatOn
     24  3d82		       0d ab c4 	      ora	actCnt+A_REPEAT
     25  3d85		       60		      rts
