------- FILE lead.asm LEVEL 2 PASS 3
      0  6efd					      include	"lead.asm"
      1  6efd							; Fat Chip 64 - CHORD + LEAD (v0.28): a chord and a lead at once, each its
      2  6efd							; own patch.
      3  6efd							;   BASS      (was LOW NOTE) the first key pressed is the chord's root
      4  6efd							;	       (POLY: just it; SMART CHORD: its 5TH, TRIAD...; DRONE: the
      5  6efd							;	       drone); every other key is the lead, while the chord key is held
      6  6efd							;   TRIAD     (was LATCH 3) three keys pressed together are the chord while
      7  6efd							;	       they're held (v0.36: with LATCH on, it keeps sounding after you
      8  6efd							;	       let go); every other key is the lead.
      9  6efd							; v0.36: the lead is LEAD OCTAVE up in every mode (+1 at first; SHIFT + F1 /
     10  6efd							; F3; v0.43: One Key Play too). v0.43: SHIFT + F5 SPLIT on / off, SHIFT + F7
     11  6efd							; its mode, SHIFT + K then a note: the split point. LATCH holds KEY's chord side and TRIAD's chord.
     12  6efd							; The lead is one note (the last key pressed) on one voice per chip (SID 3,
     13  6efd							; Game Boy pulse 1, NES pulse 1), only while it plays: the rest of the time
     14  6efd							; those voices are the chord's. Its patch: SHIFT + A S D F G / Z X C V B.
     15  6efd							; The lead's own: the SID's waveform, width, envelope and octave, the Game
     16  6efd							; Boy pulse's CCs, the NES pulse's duty. Shared with the chord: the effects
     17  6efd							; (vibrato, filter, tremolo...), the NES envelope.
     18  6efd
     19  6efd							;   KEY       (v0.32) a keyboard split: keys below the split point are the
     20  6efd							;	       chord (as the mode plays them), keys from it up the lead (LEAD
     21  6efd							;	       OCTAVE, +1 at first). On the C64's keys the split is a key (it
     22  6efd							;	       stays put when the octave changes); over MIDI, a note as sent
     23  6efd							;	       (before MIDI IN OCTAVE). SHIFT + F5 held + a note sets either.
     24  6efd		       00 01	   CL_KEY     equ	1	; SPLIT (clMode)
     25  6efd		       00 02	   CL_BASS    equ	2
     26  6efd		       00 03	   CL_L3      equ	3	; (TRIAD)
     27  6efd		       00 06	   LEAD_SID   equ	6	; the lead's voices: SID 3, GB pulse 1, NES pulse 1
     28  6efd		       00 01	   LEAD_GB    equ	1
     29  6efd		       00 02	   LEAD_NES   equ	2
     30  6efd
