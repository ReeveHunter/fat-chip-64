      0  2305					      include	"arp.asm"
      1  2305							; Fat Chip 64 - tempo and arpeggiator
      2  2305							;
      3  2305							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  2305							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  2305							;
      6  2305							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  2305							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  2305							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  2305							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  2305							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  2305							;	     until its voice's next turn.
     12  2305							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  2305							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  2305							;   J faster; either one also picks FREE).
     15  2305							;
     16  2305							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  2305							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  2305
     19  2305							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  2305							; between the two bytes: $22FF read as $23FF)
     21  2305				   GetTicks
     22  2305					      subroutine
     23  2305		       08		      php
     24  2306		       78		      sei
     25  2307		       a5 10		      lda	ticks
     26  2309		       8d 3f c3 	      sta	nowL
     27  230c		       a5 11		      lda	ticks+1
     28  230e		       8d 40 c3 	      sta	nowH
     29  2311		       28		      plp
     30  2312		       60		      rts
     31  2313
