      0  1ae8					      include	"voices.asm"
      1  1ae8							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  1ae8							;
      3  1ae8							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  1ae8							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  1ae8							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  1ae8							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  1ae8							; Allocation, whenever the held notes change. Who comes first (v0.21):
      8  1ae8							; Polyphony > Fat Bass > the patch's effects (REPEAT's echoes) > stacking.
      9  1ae8							;   1. every note gets a voice (SPARKLE's arp pair is what you play, so it
     10  1ae8							;	counts as notes and goes first)
     11  1ae8							;   2. Fat Bass: as many bass voices as are spare play the lowest note,
     12  1ae8							;	folded into the bass range (one note fewer needs a voice, so with
     13  1ae8							;	Fat Bass the bottom of the chord is the bass)
     14  1ae8							;   3. REPEAT's echo voices: one or two of what's still spare
     15  1ae8							;   4. leftover voices stack on the lowest two notes, alternating
     16  1ae8							; So one note = a nine-voice unison across three chips, and in chords the
     17  1ae8							; bottom of the chord is fattest. Disabled devices, and voices the drums
     18  1ae8							; hold (vDrum), get no notes.
     19  1ae8
     20  1ae8							; ------------------------------------------------------------ SID
     21  1ae8				   SidInit
     22  1ae8					      subroutine
     23  1ae8		       a2 18		      ldx	#24
