     27  3abf		       ad 2a c3 	      lda	shiftDown
     28  3ac2		       d0 09		      bne	.prev
     29  3ac4		       e8		      inx
     30  3ac5		       e0 13		      cpx	#NUM_SOUNDS
     31  3ac7		       90 09		      bcc	.s
     32  3ac9		       a2 00		      ldx	#0
