     97  755c		       a5 29		      lda	ptr+1
     98  755e		       99 ed c3 	      sta	sidBaseHi,y
     99  7561		       ad a3 c6 	      lda	sndPenvK
    100  7564		       ae 9f c6 	      ldx	sndStep
    101  7567		       f0 02		      beq	.k
    102  7569		       a9 ff		      lda	#$FF	; (STEP: held; AtkStep jumps)
    103  756b				   .k
    104  756b		       99 6e c9 	      sta	sK,y
    105  756e				   .x
    106  756e		       60		      rts
    107  756f
    108  756f							; VoiceSet, a SID voice let go (X = the voice, Y = SID voice): BEND OUT
    109  756f				   RelDrop
    110  756f					      subroutine
    111  756f		       ad a6 c6 	      lda	sndRdrop
    112  7572		       f0 26		      beq	.x
