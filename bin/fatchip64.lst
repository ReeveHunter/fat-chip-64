    401  3fcd							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    402  3fcd							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    403  3fcd							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    404  3fcd							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    405  3fcd		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    406  3fd1		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    407  3fd8		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    408  3fdf		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    409  3fe4		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    410  3fe8		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    411  3fec		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
    412  3ff1		       05 0a 0f 14*uTremRH    .byte.b	>1311, >2621, >3932, >5243, >6554
    413  3ff6		       04 08 0c 10 uDetT      .byte.b	4, 8, 12, 16
    414  3ffa		       18 38 64    uWarbT     .byte.b	24, 56, 100
