------- FILE main.asm
------- FILE voices.asm LEVEL 2 PASS 3
      0  1265					      include	"voices.asm"
      1  1265							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  1265							;
      3  1265							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  1265							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  1265							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  1265							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  1265							; Allocation, whenever the held notes change:
      8  1265							;   1. bass voices play the lowest note, an octave down
      9  1265							;   2. every other note gets one voice, lowest notes first
     10  1265							;   3. leftover voices stack on the lowest two notes, alternating
     11  1265							; So one note = a nine-voice unison across three chips, and in chords the
     12  1265							; bottom of the chord is fattest. Disabled devices get no notes.
     13  1265
     14  1265							; ------------------------------------------------------------ SID
     15  1265				   SidInit
     16  1265					      subroutine
     17  1265		       a2 18		      ldx	#24
     18  1267		       a9 00		      lda	#0
     19  1269				   .clr
     20  1269		       9d 00 d4 	      sta	SID,x
     21  126c		       ca		      dex
     22  126d		       10 fa		      bpl	.clr
     23  126f		       20 92 12 	      jsr	SidVolume
     24  1272		       a2 02		      ldx	#2
     25  1274				   .v
     26  1274		       bc 3e 67 	      ldy	sidOfs,x
     27  1277		       a9 19		      lda	#$19	; attack 1, decay 9
     28  1279		       99 05 d4 	      sta	SID+5,y
     29  127c		       a9 c9		      lda	#$C9	; sustain 12, release 9
     30  127e		       99 06 d4 	      sta	SID+6,y
     31  1281		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     32  1283		       99 03 d4 	      sta	SID+3,y
     33  1286		       a9 20		      lda	#$20	; sawtooth, gate off
     34  1288		       9d 31 c3 	      sta	sidGate,x
     35  128b		       99 04 d4 	      sta	SID+4,y
     36  128e		       ca		      dex
     37  128f		       10 e3		      bpl	.v
     38  1291		       60		      rts
