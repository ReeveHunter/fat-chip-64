------- FILE nesfx.asm LEVEL 2 PASS 3
      0  7182					      include	"nesfx.asm"
      1  7182							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7182							;
      3  7182							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7182							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7182							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7182							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7182							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7182							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7182							;   glide    a new note starts bent back to the voice's last note and slides
     10  7182							;	      in the way the SID's does (all three channels)
     11  7182							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7182							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7182							; semitone, so these are a little stepped.
     14  7182
     15  7182		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7182							;  (the pulses, and the triangle while it glides)
     17  7182
     18  7182							; A = 1 (not Z) when a NesFxTick step is due
     19  7182				   NesFxDue
     20  7182					      subroutine
     21  7182		       ad 27 c3 	      lda	devOn+DEV_NES
     22  7185		       f0 19		      beq	.x
     23  7187		       ad fe c5 	      lda	vibDepth
     24  718a		       0d 2c c5 	      ora	nfxGlide
     25  718d		       0d 2d c5 	      ora	nfxRun
     26  7190		       f0 0e		      beq	.x
     27  7192		       a5 10		      lda	ticks
     28  7194		       38		      sec
     29  7195		       ed 28 c5 	      sbc	nfxLast
     30  7198		       c9 08		      cmp	#NFX_EVERY
     31  719a		       a9 00		      lda	#0
     32  719c		       90 02		      bcc	.x
     33  719e		       a9 01		      lda	#1
     34  71a0				   .x
     35  71a0		       60		      rts
     36  71a1
     37  71a1							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     38  71a1							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     39  71a1							; quick return.
     40  71a1				   NesFxTick
