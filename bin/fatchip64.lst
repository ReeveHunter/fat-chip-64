    140  0cfa							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    141  0cfa							; keys: some other column has a key in this row and shares another row with
    142  0cfa							; this column.
    143  0cfa				   Suspect
    144  0cfa					      subroutine
    145  0cfa		       ac 20 c3 	      ldy	ksRow
    146  0cfd		       b9 37 25 	      lda	rowBit,y
    147  0d00		       49 ff		      eor	#$FF
    148  0d02		       ae 1f c3 	      ldx	ksCol
    149  0d05		       3d 80 c2 	      and	keyNow,x
    150  0d08		       8d 21 c3 	      sta	ksMask	; this column's other held rows
    151  0d0b		       f0 1c		      beq	.no
    152  0d0d		       a2 07		      ldx	#7
    153  0d0f				   .c
    154  0d0f		       ec 1f c3 	      cpx	ksCol
    155  0d12		       f0 12		      beq	.n
    156  0d14		       bd 80 c2 	      lda	keyNow,x
    157  0d17		       39 37 25 	      and	rowBit,y
    158  0d1a		       f0 0a		      beq	.n
    159  0d1c		       bd 80 c2 	      lda	keyNow,x
    160  0d1f		       2d 21 c3 	      and	ksMask
    161  0d22		       f0 02		      beq	.n
    162  0d24		       38		      sec
    163  0d25		       60		      rts
    164  0d26				   .n
    165  0d26		       ca		      dex
    166  0d27		       10 e6		      bpl	.c
    167  0d29				   .no
    168  0d29		       18		      clc
    169  0d2a		       60		      rts
