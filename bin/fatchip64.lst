    103  0ba0							; IRQ: pace device queues onto the wire.
    104  0ba0							;
    105  0ba0							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0ba0							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0ba0							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0ba0							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0ba0							;
    110  0ba0							; When the Game Boy is on, everything on the wire also passes through the
    111  0ba0							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0ba0							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0ba0							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0ba0							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0ba0							; message, the rate measured clean.
    116  0ba0				   Schedule
    117  0ba0					      subroutine
    118  0ba0		       ad 26 c3 	      lda	devOn+DEV_GB
    119  0ba3		       f0 10		      beq	.gb
    120  0ba5		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0ba7		       f0 0c		      beq	.gb
    122  0ba9		       c6 2e		      dec	linkLoad
    123  0bab		       f0 08		      beq	.gb
    124  0bad		       a5 10		      lda	ticks
    125  0baf		       29 01		      and	#1
    126  0bb1		       f0 02		      beq	.gb
    127  0bb3		       c6 2e		      dec	linkLoad
    128  0bb5				   .gb
    129  0bb5							; ---- Game Boy
    130  0bb5		       a5 18		      lda	gbqTail
    131  0bb7		       c5 17		      cmp	gbqHead
    132  0bb9		       f0 36		      beq	.nes
    133  0bbb		       a5 19		      lda	gbNext
    134  0bbd		       38		      sec
    135  0bbe		       e5 10		      sbc	ticks
    136  0bc0		       f0 04		      beq	.gbDue
    137  0bc2		       c9 04		      cmp	#GB_GAP+1
    138  0bc4		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0bc6				   .gbDue
    140  0bc6							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0bc6							; bytes already waiting would otherwise delay this one and squeeze it
    142  0bc6							; against the next). While a Game Boy message is due, the NES doesn't
    143  0bc6							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0bc6							; holding its notes back.
    145  0bc6		       a5 15		      lda	wireHead
    146  0bc8		       c5 16		      cmp	wireTail
    147  0bca		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0bcc		       20 32 0c 	      jsr	LinkRoom
    149  0bcf		       90 20		      bcc	.nes
    150  0bd1		       a6 18		      ldx	gbqTail
    151  0bd3		       bd 00 c1 	      lda	gbqS,x
    152  0bd6		       bc 80 c1 	      ldy	gbqD2,x
    153  0bd9		       84 2c		      sty	irqT
    154  0bdb		       bc 40 c1 	      ldy	gbqD1,x
    155  0bde		       20 4e 0c 	      jsr	WireMsg
    156  0be1		       a5 18		      lda	gbqTail
    157  0be3		       18		      clc
    158  0be4		       69 01		      adc	#1
    159  0be6		       29 3f		      and	#63
    160  0be8		       85 18		      sta	gbqTail
    161  0bea		       a5 10		      lda	ticks
    162  0bec		       18		      clc
    163  0bed		       69 03		      adc	#GB_GAP
    164  0bef		       85 19		      sta	gbNext
    165  0bf1				   .nes
    166  0bf1		       20 a6 2b 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0bf4		       a5 1b		      lda	nesqTail
    168  0bf6		       c5 1a		      cmp	nesqHead
    169  0bf8		       f0 37		      beq	.done
    170  0bfa		       a5 1c		      lda	nesNext
    171  0bfc		       38		      sec
    172  0bfd		       e5 10		      sbc	ticks
    173  0bff		       f0 04		      beq	.nesDue
    174  0c01		       c9 02		      cmp	#NES_GAP+1
