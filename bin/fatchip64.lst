     46  4c61		       c9 05		      cmp	#DK_TOM
     47  4c63		       b0 03		      bcs	.dmc
     48  4c65		       4c 1a 4d 	      jmp	NoiseHit
     49  4c68				   .dmc
     50  4c68		       ae 83 c4 	      ldx	drumKind
