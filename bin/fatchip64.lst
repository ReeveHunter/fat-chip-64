------- FILE attack.asm LEVEL 2 PASS 3
      0  7977					      include	"attack.asm"
      1  7977							; Fat Chip 64 - BEND IN, BEND OUT (v0.30; v0.41: ATTACK folded into BEND IN):
      2  7977							; how each note starts and ends in pitch
      3  7977							;
      4  7977							; BEND IN: each new note starts AMOUNT semitones away (above: a drop, below:
      5  7977							;   a scoop) and comes to its pitch over TIME. SLIDE: the SID and NES slide
      6  7977							;   it (the SID per voice, the NES with its glide), the Game Boy has its own
      7  7977							;   pitch envelope (CC 80 / 81). STEP: the SID and NES hold it there for TIME,
      8  7977							;   then jump (the chip-tune BLIP); the Game Boy slides as fast as it can.
      9  7977							;   CLICK (the SID): the start of each note as noise: SHORT 20 ms, LONG
     10  7977							;   (v0.42) as long as TIME.
     11  7977							; BEND OUT (the SID): a note let go sags AMOUNT semitones over TIME while its
     12  7977							;   release rings.
     13  7977
     14  7977							; SidFxs pitch loop, SID voice envY: the note's clock; the CLICK ends; a STEP
     15  7977							; jumps to the note
     16  7977				   AtkStep
     17  7977					      subroutine
     18  7977		       ac 8b c8 	      ldy	envY
     19  797a		       b9 35 ce 	      lda	atkT,y
     20  797d		       18		      clc
     21  797e		       6d 1e c9 	      adc	fxN
     22  7981		       90 02		      bcc	.t
     23  7983		       a9 ff		      lda	#255
     24  7985				   .t
     25  7985		       99 35 ce 	      sta	atkT,y
     26  7988		       b9 38 ce 	      lda	clickOn,y
     27  798b		       f0 21		      beq	.s
     28  798d		       a9 05		      lda	#5	; (SHORT: 20 ms of noise; v0.42: LONG: TIME)
     29  798f		       ae 61 cb 	      ldx	sndClick
     30  7992		       e0 02		      cpx	#2
     31  7994		       90 03		      bcc	.cl
     32  7996		       ad 60 cb 	      lda	sndStepT
     33  7999				   .cl
     34  7999		       d9 35 ce 	      cmp	atkT,y
     35  799c		       f0 02		      beq	.ce
     36  799e		       b0 0e		      bcs	.s
     37  79a0				   .ce
     38  79a0		       a9 00		      lda	#0
     39  79a2		       99 38 ce 	      sta	clickOn,y
     40  79a5		       be e0 88 	      ldx	sidOfs,y
     41  79a8		       b9 f6 c7 	      lda	sidGate,y
     42  79ab		       9d 04 d4 	      sta	SID+4,x
     43  79ae				   .s
     44  79ae		       b9 2e ce 	      lda	sK,y
     45  79b1		       c9 ff		      cmp	#$FF	; (STEP: held)
     46  79b3		       d0 19		      bne	.x
     47  79b5		       b9 35 ce 	      lda	atkT,y
     48  79b8		       cd 60 cb 	      cmp	sndStepT
     49  79bb		       90 11		      bcc	.x
     50  79bd		       b9 28 c9 	      lda	sidTgtLo,y	; TIME's up: the note
     51  79c0		       99 aa c8 	      sta	sidBaseLo,y
     52  79c3		       b9 2b c9 	      lda	sidTgtHi,y
     53  79c6		       99 ad c8 	      sta	sidBaseHi,y
     54  79c9		       a9 00		      lda	#0
     55  79cb		       99 2e ce 	      sta	sK,y
     56  79ce				   .x
     57  79ce		       60		      rts
     58  79cf
     59  79cf							; a SID voice's gate went on (Y = SID voice, t2 = its registers): the CLICK
     60  79cf							; starts. Keeps Y.
     61  79cf				   ClickOn
     62  79cf					      subroutine
     63  79cf		       ad 61 cb 	      lda	sndClick
     64  79d2		       f0 11		      beq	.x
     65  79d4		       a9 01		      lda	#1
     66  79d6		       99 38 ce 	      sta	clickOn,y
     67  79d9		       b9 f6 c7 	      lda	sidGate,y
     68  79dc		       29 01		      and	#1
     69  79de		       09 80		      ora	#$80	; noise
     70  79e0		       a6 26		      ldx	t2
     71  79e2		       9d 04 d4 	      sta	SID+4,x
     72  79e5				   .x
     73  79e5		       60		      rts
     74  79e6
     75  79e6							; VoiceSet, a SID voice's new note (Y = SID voice, t0 = the voice, t3 = a new
     76  79e6							; press): BEND IN starts it away from its pitch
     77  79e6				   BendIn
     78  79e6					      subroutine
     79  79e6		       ad 62 cb 	      lda	sndPenv
     80  79e9		       f0 45		      beq	.x
     81  79eb		       a6 24		      ldx	t0
