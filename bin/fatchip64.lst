     91  08a9				   .alloced
     92  08a9							; one screen step per keyboard scan, 2 ms after it, on a pass of its
     93  08a9							; own (a scan and a screen step in one pass would stretch it)
     94  08a9							; (v0.12: the SID effects take a non-scan pass the screen doesn't need)
     95  08a9							; when both are due they take turns (a redraw after a key press would
     96  08a9							; otherwise freeze vibrato and glides for 70 ms)
     97  08a9		       ad 3c c3 	      lda	scanned
     98  08ac		       d0 47		      bne	.x
     99  08ae		       a5 13		      lda	scrAt
    100  08b0		       f0 40		      beq	.fx	; done for this scan
    101  08b2		       38		      sec
    102  08b3		       e5 10		      sbc	ticks
    103  08b5		       f0 04		      beq	.sdue
    104  08b7		       c9 03		      cmp	#3
    105  08b9		       90 37		      bcc	.fx	; 1-2 ms to go
    106  08bb				   .sdue
