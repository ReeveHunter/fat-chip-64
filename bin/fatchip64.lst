     49  522d		       20 33 53 	      jsr	ItemShown
     50  5230		       f0 07		      beq	.fn
     51  5232		       bd d1 84 	      lda	mKind,x
     52  5235		       c9 04		      cmp	#4
     53  5237		       d0 0f		      bne	.vis
     54  5239				   .fn
     55  5239		       e8		      inx
     56  523a		       ce 52 c8 	      dec	mvCnt
     57  523d		       d0 eb		      bne	.fl
     58  523f		       ac 1b c6 	      ldy	menuPage	; (text only: the first line, no cursor)
     59  5242		       b9 ac 8c 	      lda	pgFirst,y
     60  5245		       8d 8a c4 	      sta	menuRow
     61  5248				   .vis
