     91  3c05		       a9 04		      lda	#4
     92  3c07		       20 5f 3c 	      jsr	NesChStatus	; mS = CC, sample channel
     93  3c0a		       a9 00		      lda	#0
     94  3c0c		       a6 25		      ldx	t1
     95  3c0e		       10 02		      bpl	.a
