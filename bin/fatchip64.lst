     30  10af		       99 06 d4 	      sta	SID+6,y
     31  10b2		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     32  10b4		       99 03 d4 	      sta	SID+3,y
     33  10b7		       a9 20		      lda	#$20	; sawtooth, gate off
     34  10b9		       9d 31 c3 	      sta	sidGate,x
     35  10bc		       99 04 d4 	      sta	SID+4,y
     36  10bf		       ca		      dex
