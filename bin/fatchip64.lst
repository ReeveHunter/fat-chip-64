    363  3cac
    364  3cac							; ------------------------------------------------------------ SysEx: a patch from Chip Lab (v0.20)
    365  3cac							; (v0.23: F0 7D 46 43 02 m F7 sets the chips on / off: DevicesReceived)
    366  3cac							; F0 7D 46 43 01 PATCH_SIZE, then the patch (PATCH_SIZE bytes, the live patch's layout:
    367  3cac							; tools/gen_patches.py) as two 4-bit halves each, high first, then F7. It
    368  3cac							; arrives in sxBuf; only a complete one goes into the live patch, which then
    369  3cac							; sounds at once (like choosing a sound). Anything else is ignored.
    370  3cac		       00 05	   SX_HEAD    equ	5
    371  3cac		       00 db	   SX_LEN     equ	SX_HEAD + PATCH_SIZE * 2
    372  3cac
    373  3cac							; A status byte in A (F0-F7); keeps A
    374  3cac				   SysexStatus
    375  3cac					      subroutine
    376  3cac		       c9 f0		      cmp	#$F0
    377  3cae		       d0 0e		      bne	.end
    378  3cb0		       a2 01		      ldx	#1
    379  3cb2		       8e 19 cc 	      stx	sxOn
    380  3cb5		       8e e9 cc 	      stx	sxCmd
    381  3cb8		       a2 00		      ldx	#0
    382  3cba		       8e 1a cc 	      stx	sxPos
    383  3cbd		       60		      rts
    384  3cbe				   .end
    385  3cbe		       ae 19 cc 	      ldx	sxOn
    386  3cc1		       f0 1c		      beq	.x
    387  3cc3		       a2 00		      ldx	#0
    388  3cc5		       8e 19 cc 	      stx	sxOn
    389  3cc8		       c9 f7		      cmp	#$F7
    390  3cca		       d0 13		      bne	.x
    391  3ccc		       ae e9 cc 	      ldx	sxCmd
    392  3ccf		       e0 02		      cpx	#2
    393  3cd1		       f0 0d		      beq	.dev
    394  3cd3		       ae 1a cc 	      ldx	sxPos
    395  3cd6		       e0 db		      cpx	#SX_LEN
    396  3cd8		       d0 05		      bne	.x
    397  3cda		       48		      pha
    398  3cdb		       20 71 3d 	      jsr	PatchReceived
    399  3cde		       68		      pla
    400  3cdf				   .x
    401  3cdf		       60		      rts
    402  3ce0				   .dev
    403  3ce0		       ae 1a cc 	      ldx	sxPos
    404  3ce3		       e0 05		      cpx	#5
    405  3ce5		       d0 f8		      bne	.x
    406  3ce7		       48		      pha
    407  3ce8		       20 4e 3d 	      jsr	DevicesReceived
    408  3ceb		       68		      pla
    409  3cec		       60		      rts
    410  3ced
    411  3ced							; A data byte (A) inside a SysEx
    412  3ced				   SysexByte
    413  3ced					      subroutine
    414  3ced		       ae 1a cc 	      ldx	sxPos
    415  3cf0		       e0 03		      cpx	#3	; the command: 1 a patch, 2 the chips on / off
    416  3cf2		       d0 0b		      bne	.nc
    417  3cf4		       c9 02		      cmp	#2
    418  3cf6		       d0 07		      bne	.nc
    419  3cf8		       8d e9 cc 	      sta	sxCmd
    420  3cfb		       ee 1a cc 	      inc	sxPos
    421  3cfe		       60		      rts
    422  3cff				   .nc
    423  3cff		       ac e9 cc 	      ldy	sxCmd
    424  3d02		       c0 02		      cpy	#2
    425  3d04		       d0 0b		      bne	.pat
    426  3d06		       e0 04		      cpx	#4	; 2: one byte, bit 0 SID, 1 Game Boy, 2 NES
    427  3d08		       d0 39		      bne	.no
    428  3d0a		       8d ea cc 	      sta	sxArg
    429  3d0d		       ee 1a cc 	      inc	sxPos
    430  3d10		       60		      rts
    431  3d11				   .pat
    432  3d11		       e0 05		      cpx	#SX_HEAD
    433  3d13		       b0 09		      bcs	.body
    434  3d15		       dd 49 3d 	      cmp	sxHead,x	; the header must match, or the rest is ignored
    435  3d18		       d0 29		      bne	.no
    436  3d1a		       ee 1a cc 	      inc	sxPos
    437  3d1d		       60		      rts
    438  3d1e				   .body
    439  3d1e		       e0 db		      cpx	#SX_LEN
