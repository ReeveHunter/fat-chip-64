------- FILE main.asm
    533  e259				   hiEnd
    534  e259							; v0.66: under the KERNAL, past its tables (cleared at start): each patch
    535  e259							; setting's step when its effect was last switched off, and per effect
    536  e259							; whether that's been kept (patchedit.asm FxOff / FxOn)
    537  e259		       fe fb	   fxMem      equ	hiEnd
    538  e259		       ff 3b	   fxMemOk    equ	hiEnd+64
    539  e259				  -	      if	fxMemOk+16 > $FFF0
    540  e259				  -	      echo	"fxMem runs into the vectors"
    541  e259				  -	      err
    542  e259					      endif
    543  e259					      rend
    544  e259				  -	      if	hiEnd > $FFFA
    545  e259				  -	      echo	"the $E000 tables run into the CPU's vectors"
    546  e259				  -	      err
    547  e259					      endif
    548  e259
    549  e259							; ---- v0.60: data in the RAM under the I/O ($D000-$DFFF): packed apart too,
    550  e259							; unpacked there with the I/O switched out; read with BeatLoad's copy
    551  e259				   ioPhys
    552  e259					      rorg	$D000
    553  e259				   ioStart
