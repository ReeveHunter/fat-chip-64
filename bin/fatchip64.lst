     31  730c		       91 2a		      sta	(ptr2),y
     32  730e		       c8		      iny
     33  730f		       d0 ee		      bne	.c
     34  7311				   .done
     35  7311		       60		      rts
     36  7312
     37  7312							; ptr2 = SCREEN + 40*Y + X (row table: no loop)
