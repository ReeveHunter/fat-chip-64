      1  7039							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  7039							;
      3  7039							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  7039							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  7039							;   ATTACK   as always: the new notes start
      6  7039							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  7039							;	      has none)
      8  7039							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  7039							;	      start again
     10  7039							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  7039							;	      late; some glide, some start again (fade out, come back in)
     12  7039							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  7039							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  7039							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  7039							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  7039
     17  7039		       00 01	   CHG_ATTACK equ	1
     18  7039		       00 02	   CHG_GLIDE  equ	2
     19  7039		       00 03	   CHG_STAGGER equ	3
     20  7039		       00 04	   CHG_WANDER equ	4
     21  7039		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  7039		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  7039
     24  7039							; A = the chord change style now (keeps X, Y)
     25  7039				   ChgEff
     26  7039					      subroutine
     27  7039		       ad 21 cd 	      lda	chgMode
     28  703c		       d0 0c		      bne	.x
     29  703e		       ad 73 c8 	      lda	effMode
