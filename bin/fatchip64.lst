    384  3a3b				   .end
    385  3a3b		       ae 4d c7 	      ldx	sxOn
    386  3a3e		       f0 1c		      beq	.x
    387  3a40		       a2 00		      ldx	#0
    388  3a42		       8e 4d c7 	      stx	sxOn
    389  3a45		       c9 f7		      cmp	#$F7
    390  3a47		       d0 13		      bne	.x
    391  3a49		       ae 1d c8 	      ldx	sxCmd
    392  3a4c		       e0 02		      cpx	#2
    393  3a4e		       f0 0d		      beq	.dev
    394  3a50		       ae 4e c7 	      ldx	sxPos
    395  3a53		       e0 d5		      cpx	#SX_LEN
    396  3a55		       d0 05		      bne	.x
    397  3a57		       48		      pha
    398  3a58		       20 ee 3a 	      jsr	PatchReceived
    399  3a5b		       68		      pla
    400  3a5c				   .x
    401  3a5c		       60		      rts
    402  3a5d				   .dev
    403  3a5d		       ae 4e c7 	      ldx	sxPos
