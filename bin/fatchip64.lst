     93  4e65		       29 03		      and	#3
     94  4e67		       05 24		      ora	t0
     95  4e69		       85 24		      sta	t0	; t1:t0 = ticks x 4 + quarters
     96  4e6b							; the period since the last beat clock (none yet: this one is the start)
     97  4e6b		       a5 24		      lda	t0
     98  4e6d		       38		      sec
     99  4e6e		       ed ef c5 	      sbc	clkLastQL
    100  4e71		       85 26		      sta	t2
    101  4e73		       a5 25		      lda	t1
    102  4e75		       ed f0 c5 	      sbc	clkLastQH
    103  4e78		       85 27		      sta	t3
