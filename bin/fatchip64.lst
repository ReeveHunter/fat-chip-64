    464  6620				   .c
    465  6620		       cd 56 c8 	      cmp	tuneC
    466  6623		       f0 1b		      beq	.k
    467  6625		       8d 56 c8 	      sta	tuneC
    468  6628		       20 59 66 	      jsr	TuneUnits
    469  662b		       ae 58 c8 	      ldx	gbTune
    470  662e		       a9 67		      lda	#GCC_TUNE
    471  6630		       20 50 0d 	      jsr	GbGlobal
    472  6633		       a9 08		      lda	#8
    473  6635		       8d 2e c5 	      sta	nfxRun	; (the NES bends again)
    474  6638		       a9 00		      lda	#0
    475  663a		       8d 5d c8 	      sta	vsGlide
    476  663d		       20 e4 3d 	      jsr	SidRetune	; (the SID's notes sounding: there at once)
    477  6640				   .k
