    612 Uc641		       00	   vizV       ds	1
    613 Uc642		       00	   vizStep    ds	1
    614 Uc643		       00	   vizAt      ds	1	; the visualizer's last step (ticks)
    615 Uc644		       00 00	   gR	      ds	2	; GLITCH: random numbers
    616 Uc646		       00	   gShake     ds	1	; ... steps of shaking left
    617 Uc647		       00	   gK	      ds	1
    618 Uc648		       00	   gV	      ds	1
    619 Uc649		       00	   gLen       ds	1
    620 Uc64a		       00	   gChr       ds	1
    621 Uc64b		       00	   gCol       ds	1
    622 Uc64c							; v0.18: the live patch. Every sound setting is read from here (the field
    623 Uc64c							; names are in soundtab.asm); choosing a built-in patch copies it in
    624 Uc64c		       00 00 00 00*livePatch  ds	128	; PATCH_SIZE of it used
    625 Uc6cc		       00 00 00 00*sxBuf      ds	128	; v0.20: a patch arriving over SysEx
    626 Uc74c		       00	   sxOn       ds	1	; 1 = inside a SysEx
    627 Uc74d		       00	   sxPos      ds	1	; data bytes so far
    628 Uc74e		       00	   sxCount    ds	1	; patches received
    629 Uc74f		       00 00 00 00*vFat       ds	NUM_VOICES	; v0.21: this bass voice plays Fat Bass now
    630 Uc758		       00 00 00 00*vDrum      ds	NUM_VOICES	; v0.21: held by the drums (none yet)
    631 Uc761		       00	   allocFree  ds	1	; voices spare after the notes and Fat Bass
    632 Uc762		       00 00 00 00*vSent      ds	NUM_VOICES	; v0.21: the note number each MIDI voice was sent
    633 Uc76b		       00	   mlNew      ds	1
    634 Uc76c		       00	   cbmDown    ds	1	; v0.22: C= held
    635 Uc76d		       00	   stopDown   ds	1	; v0.22: RUN/STOP held
    636 Uc76e		       00	   stopUsed   ds	1	;   ... and used with another key (no beat start/stop)
    637 Uc76f		       00	   keyCodeNow ds	1	; the command key being handled
    638 Uc770		       00	   kArm       ds	1	; v0.22: K tapped: the next notes pick key and scale
    639 Uc771		       00	   kCount     ds	1	;   notes still down in that shape
    640 Uc772		       00	   kLow       ds	1	;   its lowest note
    641 Uc773		       00	   kMaskL     ds	1	;   its pitch classes (bit = C .. B)
    642 Uc774		       00	   kMaskH     ds	1
    643 Uc775		       00 00 00 00*kNote      ds	NIDX	;   1 = this key is part of the shape (not played)
    644 Uc795		       00	   exLenM1    ds	1	; the scale's length - 1 (Expand)
    645 Uc796		       00	   curBank    ds	1	; v0.22: the bank (A S D F G) and slot (Z X C V B) chosen
    646 Uc797		       00	   curSlot    ds	1
    647 Uc798		       00	   dcE	      ds	1	; DiceRoll: effect, fields, row
    648 Uc799		       00	   dcN	      ds	1
    649 Uc79a		       00	   dcR	      ds	1
    650 Uc79b		       00	   undoOk     ds	1	; v0.22: a dice roll can be undone (C= + /)
    651 Uc79c		       00 00 00 00*diceUndo   ds	128	;   the live patch before the roll
    652 Uc81c		       00	   sxCmd      ds	1	; v0.23: the SysEx's command (1 patch, 2 chips)
    653 Uc81d		       00	   sxArg      ds	1
    654 Uc81e		       00	   sxI	      ds	1
    655 Uc81f				   ramEnd     ds	0
    656 Uc81f				  -	      if	ramEnd > $C900
    657 Uc81f				  -	      echo	"RAM variables run past $C900: clear more in Start"
    658 Uc81f				  -	      err
    659 Uc81f					      endif
