    103  0c53							; IRQ: pace device queues onto the wire.
    104  0c53							;
    105  0c53							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0c53							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0c53							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0c53							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0c53							;
    110  0c53							; When the Game Boy is on, everything on the wire also passes through the
    111  0c53							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0c53							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0c53							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0c53							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0c53							; message, the rate measured clean.
    116  0c53				   Schedule
    117  0c53					      subroutine
    118  0c53		       ad 26 c3 	      lda	devOn+DEV_GB
    119  0c56		       f0 10		      beq	.gb
    120  0c58		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0c5a		       f0 0c		      beq	.gb
    122  0c5c		       c6 2e		      dec	linkLoad
    123  0c5e		       f0 08		      beq	.gb
    124  0c60		       a5 10		      lda	ticks
    125  0c62		       29 01		      and	#1
    126  0c64		       f0 02		      beq	.gb
    127  0c66		       c6 2e		      dec	linkLoad
    128  0c68				   .gb
    129  0c68							; ---- Game Boy
    130  0c68		       a5 18		      lda	gbqTail
    131  0c6a		       c5 17		      cmp	gbqHead
    132  0c6c		       f0 36		      beq	.nes
    133  0c6e		       a5 19		      lda	gbNext
    134  0c70		       38		      sec
    135  0c71		       e5 10		      sbc	ticks
    136  0c73		       f0 04		      beq	.gbDue
    137  0c75		       c9 04		      cmp	#GB_GAP+1
    138  0c77		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0c79				   .gbDue
    140  0c79							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0c79							; bytes already waiting would otherwise delay this one and squeeze it
    142  0c79							; against the next). While a Game Boy message is due, the NES doesn't
    143  0c79							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0c79							; holding its notes back.
    145  0c79		       a5 15		      lda	wireHead
    146  0c7b		       c5 16		      cmp	wireTail
    147  0c7d		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0c7f		       20 e5 0c 	      jsr	LinkRoom
    149  0c82		       90 20		      bcc	.nes
    150  0c84		       a6 18		      ldx	gbqTail
    151  0c86		       bd 00 c1 	      lda	gbqS,x
    152  0c89		       bc 80 c1 	      ldy	gbqD2,x
    153  0c8c		       84 2c		      sty	irqT
    154  0c8e		       bc 40 c1 	      ldy	gbqD1,x
    155  0c91		       20 01 0d 	      jsr	WireMsg
    156  0c94		       a5 18		      lda	gbqTail
    157  0c96		       18		      clc
    158  0c97		       69 01		      adc	#1
    159  0c99		       29 3f		      and	#63
    160  0c9b		       85 18		      sta	gbqTail
    161  0c9d		       a5 10		      lda	ticks
    162  0c9f		       18		      clc
    163  0ca0		       69 03		      adc	#GB_GAP
    164  0ca2		       85 19		      sta	gbNext
    165  0ca4				   .nes
    166  0ca4		       20 c2 33 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0ca7		       a5 1b		      lda	nesqTail
    168  0ca9		       c5 1a		      cmp	nesqHead
    169  0cab		       f0 37		      beq	.done
    170  0cad		       a5 1c		      lda	nesNext
    171  0caf		       38		      sec
    172  0cb0		       e5 10		      sbc	ticks
    173  0cb2		       f0 04		      beq	.nesDue
    174  0cb4		       c9 02		      cmp	#NES_GAP+1
    175  0cb6		       90 2c		      bcc	.done
    176  0cb8				   .nesDue
    177  0cb8		       20 f8 0c 	      jsr	WireFree
    178  0cbb		       c9 03		      cmp	#3
    179  0cbd		       90 25		      bcc	.done
