------- FILE midi.asm LEVEL 2 PASS 3
      0  0a68					      include	"midi.asm"
      1  0a68							; Fat Chip 64 - MIDI out
      2  0a68							;
      3  0a68							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0a68							; at most one message per device onto the wire buffer, no sooner than that
      5  0a68							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0a68							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0a68							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0a68							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0a68							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0a68
     11  0a68				   MidiInit
     12  0a68					      subroutine
     13  0a68		       a9 03		      lda	#ACIA_RESET
     14  0a6a		       8d 04 de 	      sta	ACIA_CTRL
     15  0a6d		       a9 16		      lda	#ACIA_MODE
     16  0a6f		       8d 04 de 	      sta	ACIA_CTRL
     17  0a72		       60		      rts
     18  0a73
     19  0a73							; IRQ: send one wire byte if the ACIA is ready.
     20  0a73				   TxByte
     21  0a73					      subroutine
     22  0a73		       a6 16		      ldx	wireTail
     23  0a75		       e4 15		      cpx	wireHead
     24  0a77		       f0 0f		      beq	.done
     25  0a79		       ad 06 de 	      lda	ACIA_STAT
     26  0a7c		       29 02		      and	#ACIA_TDRE
     27  0a7e		       f0 08		      beq	.done
     28  0a80		       bd 00 c0 	      lda	wireBuf,x
     29  0a83		       8d 05 de 	      sta	ACIA_TX
     30  0a86		       e6 16		      inc	wireTail
     31  0a88				   .done
     32  0a88		       60		      rts
     33  0a89
     34  0a89							; Main loop: same, with interrupts off around it.
     35  0a89				   TxService
     36  0a89					      subroutine
     37  0a89		       08		      php
     38  0a8a		       78		      sei
