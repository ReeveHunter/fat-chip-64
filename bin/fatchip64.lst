------- FILE nesenv.asm LEVEL 2 PASS 3
      0  21d2					      include	"nesenv.asm"
      1  21d2							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  21d2							;
      3  21d2							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  21d2							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  21d2							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  21d2							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  21d2							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  21d2							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  21d2							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  21d2							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  21d2							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  21d2							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  21d2							; would wrap to a high pitch).
     14  21d2							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  21d2
     16  21d2							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  21d2							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  21d2							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  21d2							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  21d2							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  21d2		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  21d2		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  21d2							; NES channels too, and can't take a bend every 4 ms
     24  21d2		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  21d2		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  21d2
     27  21d2							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  21d2		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  21db		       02 05	   slotVoice  .byte.b	2,5
     30  21dd
     31  21dd							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  21dd							; note keeps sounding for now). X = voice (= t0).
     33  21dd				   NesSoftRelease
     34  21dd					      subroutine
     35  21dd		       4c e2 21 	      jmp	.go
     36  21e0				   .nope
     37  21e0		       18		      clc
     38  21e1		       60		      rts
     39  21e2				   .go
     40  21e2		       ad 46 c4 	      lda	nesEnvOn
     41  21e5		       f0 f9		      beq	.nope
     42  21e7		       ad 8f c3 	      lda	muteNow
     43  21ea		       0d ca c3 	      ora	hardCut
     44  21ed		       d0 f1		      bne	.nope
     45  21ef		       ad 27 c3 	      lda	devOn+DEV_NES
     46  21f2		       f0 ec		      beq	.nope
     47  21f4		       bd a1 6e 	      lda	vDev,x
     48  21f7		       c9 02		      cmp	#DEV_NES
     49  21f9		       d0 7c		      bne	.no
     50  21fb		       bd 96 c3 	      lda	vOut,x
     51  21fe		       c9 ff		      cmp	#NO_NOTE
     52  2200		       f0 75		      beq	.no
     53  2202		       bc d2 21 	      ldy	vEnvSlot,x
     54  2205		       30 3e		      bmi	.tri
     55  2207							; pulse: release from the current level; step = level x factor / 4 + 1
     56  2207							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  2207							; about 2 s). Factor 0: no release, cut.
     58  2207		       ad 69 c4 	      lda	envRelV
     59  220a		       f0 6b		      beq	.no
     60  220c		       86 26		      stx	t2
     61  220e		       84 27		      sty	t3
