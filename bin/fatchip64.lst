    444  6e9e		       aa		      tax
    445  6e9f		       ad 1d cd 	      lda	fineTune
    446  6ea2		       38		      sec
    447  6ea3		       e9 32		      sbc	#50
    448  6ea5		       18		      clc
    449  6ea6		       7d bc 6f 	      adc	scCents,x
    450  6ea9		       50 00		      bvc	.c	; (can't overflow: -85..+60)
    451  6eab				   .c
    452  6eab		       cd 1e cd 	      cmp	tuneC
    453  6eae		       f0 1b		      beq	.k
    454  6eb0		       8d 1e cd 	      sta	tuneC
    455  6eb3		       20 e4 6e 	      jsr	TuneUnits
    456  6eb6		       ae 20 cd 	      ldx	gbTune
    457  6eb9		       a9 67		      lda	#GCC_TUNE
    458  6ebb		       20 8f 0d 	      jsr	GbGlobal
    459  6ebe		       a9 08		      lda	#8
    460  6ec0		       8d f8 c9 	      sta	nfxRun	; (the NES bends again)
    461  6ec3		       a9 00		      lda	#0
    462  6ec5		       8d 25 cd 	      sta	vsGlide
    463  6ec8		       20 e8 40 	      jsr	SidRetune	; (the SID's notes sounding: there at once)
    464  6ecb				   .k
    465  6ecb		       ae 1c cd 	      ldx	tuneNow
    466  6ece		       f0 13		      beq	.x
    467  6ed0		       ad 18 cd 	      lda	scKey
