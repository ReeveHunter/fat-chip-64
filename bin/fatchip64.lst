    196  0a6c							; ------------------------------------------------------------ queueing (main loop)
    197  0a6c							; Message in mS / mD1 / mD2. Dropped if the queue is full (63 messages).
    198  0a6c				   GbPut
    199  0a6c					      subroutine
    200  0a6c							; write the slot at head first (always free: one slot stays empty),
    201  0a6c							; then publish head unless the queue is full. Uses only A and X.
    202  0a6c		       a6 16		      ldx	gbqHead
    203  0a6e		       a5 20		      lda	mS
    204  0a70		       9d 00 c1 	      sta	gbqS,x
    205  0a73		       a5 21		      lda	mD1
    206  0a75		       9d 40 c1 	      sta	gbqD1,x
    207  0a78		       a5 22		      lda	mD2
    208  0a7a		       9d 80 c1 	      sta	gbqD2,x
    209  0a7d		       8a		      txa
    210  0a7e		       18		      clc
    211  0a7f		       69 01		      adc	#1
    212  0a81		       29 3f		      and	#63
    213  0a83		       c5 17		      cmp	gbqTail
    214  0a85		       f0 02		      beq	.full
    215  0a87		       85 16		      sta	gbqHead
    216  0a89				   .full
    217  0a89		       60		      rts
