     72  71fa				   .x
     73  71fa		       60		      rts
     74  71fb
     75  71fb							; VoiceSet, a SID voice's new note (Y = SID voice, t0 = the voice, t3 = a new
     76  71fb							; press): BEND IN starts it away from its pitch
     77  71fb				   BendIn
     78  71fb					      subroutine
     79  71fb		       ad 96 c6 	      lda	sndPenv
     80  71fe		       f0 36		      beq	.x
