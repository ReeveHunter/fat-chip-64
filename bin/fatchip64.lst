------- FILE drums.asm LEVEL 2 PASS 3
      0  4f39					      include	"drums.asm"
      1  4f39							; Fat Chip 64 - drums on the MidiNES
      2  4f39							;
      3  4f39							; Two sources, one kit:
      4  4f39							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  4f39							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  4f39							;			   64 = hit, 56 = ghost)
      7  4f39							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  4f39							;			   RETURN starts / stops it, at its own tempo (B taps
      9  4f39							;			   a new one)
     10  4f39							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  4f39							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  4f39							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  4f39							; a note-on, then a note-off after the sound's length, the level set with
     14  4f39							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  4f39							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  4f39
     17  4f39		       00 0c	   KIT_SIZE   equ	12
     18  4f39		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  4f39		       00 00	   DK_KICK    equ	0
     20  4f39		       00 01	   DK_SNARE   equ	1
     21  4f39		       00 02	   DK_CH      equ	2
     22  4f39		       00 03	   DK_OH      equ	3
     23  4f39		       00 04	   DK_CY      equ	4
     24  4f39		       00 05	   DK_TOM     equ	5
     25  4f39		       00 06	   DK_PERC    equ	6
     26  4f39
     27  4f39							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  4f39				   DrumHit
     29  4f39					      subroutine
     30  4f39		       8d 8f c4 	      sta	drumKind
     31  4f3c		       8e 8e c4 	      stx	drumLvl
     32  4f3f		       8c 90 c4 	      sty	drumTom
     33  4f42		       c9 00		      cmp	#DK_KICK
     34  4f44		       d0 05		      bne	.nk
     35  4f46		       a9 01		      lda	#1
     36  4f48		       8d 4c c6 	      sta	vizKick	; (the visualizer's border flash)
     37  4f4b				   .nk
     38  4f4b		       ad 2b c3 	      lda	devOn+DEV_NES
     39  4f4e		       d0 01		      bne	.on
     40  4f50		       60		      rts
     41  4f51				   .on
     42  4f51		       20 1e 24 	      jsr	GetTicks
     43  4f54		       ad 8f c4 	      lda	drumKind
     44  4f57		       c9 02		      cmp	#DK_CH
     45  4f59		       90 07		      bcc	.dmc
     46  4f5b		       c9 05		      cmp	#DK_TOM
     47  4f5d		       b0 03		      bcs	.dmc
     48  4f5f		       4c 14 50 	      jmp	NoiseHit
     49  4f62				   .dmc
     50  4f62		       ae 8f c4 	      ldx	drumKind
     51  4f65		       bd fb 4f 	      lda	dmcPrioT,x
     52  4f68		       85 24		      sta	t0
     53  4f6a		       ad 43 c3 	      lda	nowL
     54  4f6d		       38		      sec
     55  4f6e		       ed 86 c4 	      sbc	dmcAt
     56  4f71		       a8		      tay
     57  4f72		       ad 44 c3 	      lda	nowH
     58  4f75		       ed 87 c4 	      sbc	dmcAt+1
     59  4f78		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  4f7a		       c0 0c		      cpy	#DRUM_WINDOW
     61  4f7c		       b0 08		      bcs	.ok
     62  4f7e		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     63  4f80		       cd 85 c4 	      cmp	dmcPrio
     64  4f83		       90 01		      bcc	.ok
     65  4f85		       60		      rts
     66  4f86				   .ok
     67  4f86							; the sample: kit[beat][kitOfs[kind] + level, or + tom]
     68  4f86		       ae 8f c4 	      ldx	drumKind
     69  4f89		       bd 02 50 	      lda	kitOfs,x
     70  4f8c		       e0 05		      cpx	#DK_TOM
     71  4f8e		       d0 07		      bne	.lv
     72  4f90		       18		      clc
     73  4f91		       6d 90 c4 	      adc	drumTom
     74  4f94		       4c 9b 4f 	      jmp	.k
     75  4f97				   .lv
     76  4f97		       18		      clc
     77  4f98		       6d 8e c4 	      adc	drumLvl
     78  4f9b				   .k
     79  4f9b		       85 25		      sta	t1
     80  4f9d		       ad 7a c4 	      lda	beatSel	; x 12
     81  4fa0		       0a		      asl
     82  4fa1		       0a		      asl
     83  4fa2		       85 26		      sta	t2
     84  4fa4		       0a		      asl
     85  4fa5		       65 26		      adc	t2
     86  4fa7		       65 25		      adc	t1
     87  4fa9		       aa		      tax
     88  4faa		       bd 52 a9 	      lda	kits,x
     89  4fad		       85 25		      sta	t1
     90  4faf							; bank (CC14 on the sample channel) when it changes
     91  4faf		       a9 04		      lda	#4
