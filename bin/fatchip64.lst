    441  60c2							; ------------------------------------------------------------ tuning
    442  60c2							; tuneC = PLAYING's FINE TUNE + the Synthcart's TUNE TO (while it's in use),
    443  60c2							; in cents (-100..+100). The Game Boy gets it as master tune (CC 103), the
    444  60c2							; NES in its bends (tuneN, 1/64 semitones), the SID in its note frequencies
    445  60c2							; (SidTune; the notes sounding move at once). MATCH KEY sets the key's root
    446  60c2							; once, when it changes.
    447  60c2				   ScTune
    448  60c2					      subroutine
    449  60c2		       a9 00		      lda	#0
    450  60c4		       ae 37 c8 	      ldx	useSc
