    362  0d9b							; ------------------------------------------------------------ device setup
    363  0d9b							; Fat Chip GB startup / resync (protocol section 2)
    364  0d9b				   GbStartup
    365  0d9b					      subroutine
    366  0d9b		       ad 26 c3 	      lda	devOn+DEV_GB
    367  0d9e		       f0 66		      beq	.done
