------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  2c1f					      include	"midiin.asm"
      1  2c1f							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  2c1f							;
      3  2c1f							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  2c1f							; The main loop parses them (running status; realtime and system bytes are
      5  2c1f							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  2c1f							; notes mode, latch, arp and K + note.
      7  2c1f							;
      8  2c1f							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  2c1f							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  2c1f							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  2c1f							;
     12  2c1f							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  2c1f							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  2c1f							;
     15  2c1f							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  2c1f							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  2c1f							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  2c1f							; MIDI in is passed on to the Game Boy or NES.
     19  2c1f
     20  2c1f							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  2c1f							; Uses A, X.
     22  2c1f							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  2c1f							; with the time; a Start ($FA) makes the next clock a beat.
     24  2c1f				   RxByte
     25  2c1f					      subroutine
     26  2c1f		       ad 06 de 	      lda	ACIA_STAT
     27  2c22		       4a		      lsr		; RDRF -> carry
     28  2c23		       90 2b		      bcc	.x
     29  2c25				   RxGot
     30  2c25		       ad 07 de 	      lda	ACIA_RX
     31  2c28		       c9 f8		      cmp	#$F8
     32  2c2a		       f0 25		      beq	.clk
     33  2c2c		       c9 fa		      cmp	#$FA
     34  2c2e		       d0 0e		      bne	.buf
     35  2c30		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  2c32		       8e e9 c5 	      stx	clkPhase
     37  2c35		       8e f1 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  2c38							;  the main loop could measure it)
