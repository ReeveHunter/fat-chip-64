     46  66a4		       0d 2e c5 	      ora	nfxRun
     47  66a7		       d0 01		      bne	.on
     48  66a9				   .q
     49  66a9		       60		      rts
     50  66aa				   .on
     51  66aa		       a5 10		      lda	ticks
     52  66ac		       38		      sec
     53  66ad		       ed 29 c5 	      sbc	nfxLast
     54  66b0		       c9 08		      cmp	#NFX_EVERY
     55  66b2		       b0 01		      bcs	.go
     56  66b4		       60		      rts
     57  66b5				   .go
     58  66b5		       4a		      lsr
     59  66b6		       4a		      lsr		; 4 ms steps
     60  66b7		       c9 08		      cmp	#8
     61  66b9		       90 02		      bcc	.n
     62  66bb		       a9 08		      lda	#8
     63  66bd				   .n
