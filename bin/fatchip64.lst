      0  6ada					      include	"wander.asm"
      1  6ada							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  6ada							;
      3  6ada							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  6ada							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  6ada							;   ATTACK   as always: the new notes start
      6  6ada							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  6ada							;	      has none)
      8  6ada							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  6ada							;	      start again
     10  6ada							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  6ada							;	      late; some glide, some start again (fade out, come back in)
     12  6ada							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  6ada							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  6ada							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  6ada							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  6ada
     17  6ada		       00 01	   CHG_ATTACK equ	1
     18  6ada		       00 02	   CHG_GLIDE  equ	2
     19  6ada		       00 03	   CHG_STAGGER equ	3
     20  6ada		       00 04	   CHG_WANDER equ	4
     21  6ada		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  6ada		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  6ada
