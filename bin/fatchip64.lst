      0  0bcf					      include	"keys.asm"
      1  0bcf							; Fat Chip 64 - keyboard and RESTORE
      2  0bcf
      3  0bcf							; Scan the whole matrix, turn changes into key events.
      4  0bcf							;
      5  0bcf							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0bcf							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0bcf							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0bcf							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0bcf							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0bcf							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0bcf							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0bcf							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0bcf							; chords whose ghost lands on another used key lose their newest note.
     14  0bcf				   KeyScan
     15  0bcf					      subroutine
     16  0bcf		       a2 07		      ldx	#7
     17  0bd1				   .col
     18  0bd1		       bd 81 20 	      lda	colSelect,x
     19  0bd4		       8d 00 dc 	      sta	CIA1_PRA
     20  0bd7		       ad 01 dc 	      lda	CIA1_PRB
     21  0bda		       49 ff		      eor	#$FF
     22  0bdc		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0bdf		       9d 80 c2 	      sta	keyNow,x
     24  0be2		       ca		      dex
     25  0be3		       10 ec		      bpl	.col
     26  0be5		       a9 ff		      lda	#$FF
     27  0be7		       8d 00 dc 	      sta	CIA1_PRA
     28  0bea							; ---- releases first: accepted keys that are up now
     29  0bea		       a2 00		      ldx	#0
     30  0bec				   .rc
     31  0bec		       8e 1f c3 	      stx	ksCol
     32  0bef		       bd 80 c2 	      lda	keyNow,x
     33  0bf2		       49 ff		      eor	#$FF
     34  0bf4		       3d 90 c2 	      and	keyAcc,x
     35  0bf7		       8d 1e c3 	      sta	ksBits
     36  0bfa		       a9 00		      lda	#0
     37  0bfc		       8d 20 c3 	      sta	ksRow
     38  0bff				   .rb
     39  0bff		       ad 1e c3 	      lda	ksBits
     40  0c02		       f0 21		      beq	.rcn
     41  0c04		       4e 1e c3 	      lsr	ksBits
     42  0c07		       90 17		      bcc	.rbn
     43  0c09		       ae 1f c3 	      ldx	ksCol
     44  0c0c		       ac 20 c3 	      ldy	ksRow
     45  0c0f		       b9 89 20 	      lda	rowBit,y
     46  0c12		       49 ff		      eor	#$FF
     47  0c14		       3d 90 c2 	      and	keyAcc,x
     48  0c17		       9d 90 c2 	      sta	keyAcc,x
     49  0c1a		       20 ac 0c 	      jsr	KeyCode
     50  0c1d		       20 fb 0e 	      jsr	KeyUp
     51  0c20				   .rbn
     52  0c20		       ee 20 c3 	      inc	ksRow
     53  0c23		       d0 da		      bne	.rb
     54  0c25				   .rcn
     55  0c25		       ae 1f c3 	      ldx	ksCol
     56  0c28		       e8		      inx
     57  0c29		       e0 08		      cpx	#8
     58  0c2b		       d0 bf		      bne	.rc
     59  0c2d							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     60  0c2d							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     61  0c2d							; still count as a combination.
     62  0c2d		       a9 00		      lda	#0
     63  0c2f		       8d 22 c3 	      sta	ksPass
     64  0c32				   .pass
     65  0c32		       a2 00		      ldx	#0
     66  0c34				   .pc
     67  0c34		       8e 1f c3 	      stx	ksCol
     68  0c37		       bd 90 c2 	      lda	keyAcc,x
     69  0c3a		       49 ff		      eor	#$FF
     70  0c3c		       3d 80 c2 	      and	keyNow,x
     71  0c3f		       8d 1e c3 	      sta	ksBits
     72  0c42		       a9 00		      lda	#0
     73  0c44		       8d 20 c3 	      sta	ksRow
     74  0c47				   .pb
     75  0c47		       ad 1e c3 	      lda	ksBits
     76  0c4a		       f0 3d		      beq	.pcn
     77  0c4c		       4e 1e c3 	      lsr	ksBits
     78  0c4f		       90 33		      bcc	.pbn
     79  0c51		       ad 23 c3 	      lda	ghostFilter
     80  0c54		       f0 05		      beq	.accept	; filter off (default): phantoms play
     81  0c56		       20 ba 0c 	      jsr	Suspect
     82  0c59		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     83  0c5b				   .accept
     84  0c5b		       20 ac 0c 	      jsr	KeyCode
     85  0c5e		       20 9d 0c 	      jsr	IsModifier	; Z set = modifier
     86  0c61		       f0 07		      beq	.mod
     87  0c63		       ad 22 c3 	      lda	ksPass
     88  0c66		       f0 1c		      beq	.pbn	; pass 0: modifiers only
     89  0c68		       d0 05		      bne	.take
     90  0c6a				   .mod
     91  0c6a		       ad 22 c3 	      lda	ksPass
     92  0c6d		       d0 15		      bne	.pbn	; (taken in pass 0)
     93  0c6f				   .take
     94  0c6f		       ae 1f c3 	      ldx	ksCol
     95  0c72		       ac 20 c3 	      ldy	ksRow
     96  0c75		       b9 89 20 	      lda	rowBit,y
     97  0c78		       1d 90 c2 	      ora	keyAcc,x
     98  0c7b		       9d 90 c2 	      sta	keyAcc,x
     99  0c7e		       20 ac 0c 	      jsr	KeyCode
    100  0c81		       20 eb 0c 	      jsr	KeyDown
    101  0c84				   .pbn
    102  0c84		       ee 20 c3 	      inc	ksRow
    103  0c87		       d0 be		      bne	.pb
    104  0c89				   .pcn
    105  0c89		       ae 1f c3 	      ldx	ksCol
    106  0c8c		       e8		      inx
    107  0c8d		       e0 08		      cpx	#8
    108  0c8f		       d0 a3		      bne	.pc
    109  0c91		       ad 22 c3 	      lda	ksPass
