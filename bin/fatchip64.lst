     54  62e9		       ad 38 c8 	      lda	useSc
     55  62ec		       f0 07		      beq	.t
     56  62ee		       ad 43 c8 	      lda	scSync
     57  62f1		       f0 02		      beq	.t
     58  62f3		       a2 02		      ldx	#TEMPO_SC
     59  62f5				   .t
     60  62f5		       8e 8e c4 	      stx	syncTempo
