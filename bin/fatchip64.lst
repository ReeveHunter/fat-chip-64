     99  7228		       ad 97 c6 	      lda	sndPenvK
    100  722b		       ae 93 c6 	      ldx	sndStep
    101  722e		       f0 02		      beq	.k
    102  7230		       a9 ff		      lda	#$FF	; (STEP: held; AtkStep jumps)
    103  7232				   .k
    104  7232		       99 62 c9 	      sta	sK,y
    105  7235				   .x
    106  7235		       60		      rts
