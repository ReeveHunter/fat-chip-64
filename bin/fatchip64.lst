    150  0f04							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    151  0f04							; keys: some other column has a key in this row and shares another row with
    152  0f04							; this column.
    153  0f04				   Suspect
    154  0f04					      subroutine
    155  0f04		       ac 38 c3 	      ldy	ksRow
    156  0f07		       b9 21 6a 	      lda	rowBit,y
    157  0f0a		       49 ff		      eor	#$FF
    158  0f0c		       ae 37 c3 	      ldx	ksCol
    159  0f0f		       3d 80 c2 	      and	keyNow,x
    160  0f12		       8d 39 c3 	      sta	ksMask	; this column's other held rows
    161  0f15		       f0 1c		      beq	.no
    162  0f17		       a2 07		      ldx	#7
    163  0f19				   .c
    164  0f19		       ec 37 c3 	      cpx	ksCol
    165  0f1c		       f0 12		      beq	.n
    166  0f1e		       bd 80 c2 	      lda	keyNow,x
    167  0f21		       39 21 6a 	      and	rowBit,y
    168  0f24		       f0 0a		      beq	.n
    169  0f26		       bd 80 c2 	      lda	keyNow,x
    170  0f29		       2d 39 c3 	      and	ksMask
    171  0f2c		       f0 02		      beq	.n
    172  0f2e		       38		      sec
    173  0f2f		       60		      rts
    174  0f30				   .n
    175  0f30		       ca		      dex
    176  0f31		       10 e6		      bpl	.c
    177  0f33				   .no
    178  0f33		       18		      clc
    179  0f34		       60		      rts
