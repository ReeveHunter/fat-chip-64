    103  0c32							; IRQ: pace device queues onto the wire.
    104  0c32							;
    105  0c32							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
    106  0c32							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
    107  0c32							; times as signed numbers, so after 33 s of silence every queue froze for
    108  0c32							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
    109  0c32							;
    110  0c32							; When the Game Boy is on, everything on the wire also passes through the
    111  0c32							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
    112  0c32							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
    113  0c32							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
    114  0c32							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
    115  0c32							; message, the rate measured clean.
    116  0c32				   Schedule
    117  0c32					      subroutine
    118  0c32		       ad 26 c3 	      lda	devOn+DEV_GB
    119  0c35		       f0 10		      beq	.gb
    120  0c37		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
    121  0c39		       f0 0c		      beq	.gb
    122  0c3b		       c6 2e		      dec	linkLoad
    123  0c3d		       f0 08		      beq	.gb
    124  0c3f		       a5 10		      lda	ticks
    125  0c41		       29 01		      and	#1
    126  0c43		       f0 02		      beq	.gb
    127  0c45		       c6 2e		      dec	linkLoad
    128  0c47				   .gb
    129  0c47							; ---- Game Boy
    130  0c47		       a5 18		      lda	gbqTail
    131  0c49		       c5 17		      cmp	gbqHead
    132  0c4b		       f0 36		      beq	.nes
    133  0c4d		       a5 19		      lda	gbNext
    134  0c4f		       38		      sec
    135  0c50		       e5 10		      sbc	ticks
    136  0c52		       f0 04		      beq	.gbDue
    137  0c54		       c9 04		      cmp	#GB_GAP+1
    138  0c56		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
    139  0c58				   .gbDue
    140  0c58							; only onto an empty wire, so the gap holds on the cable itself (NES
    141  0c58							; bytes already waiting would otherwise delay this one and squeeze it
    142  0c58							; against the next). While a Game Boy message is due, the NES doesn't
    143  0c58							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
    144  0c58							; holding its notes back.
    145  0c58		       a5 15		      lda	wireHead
    146  0c5a		       c5 16		      cmp	wireTail
    147  0c5c		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
    148  0c5e		       20 c4 0c 	      jsr	LinkRoom
    149  0c61		       90 20		      bcc	.nes
    150  0c63		       a6 18		      ldx	gbqTail
    151  0c65		       bd 00 c1 	      lda	gbqS,x
    152  0c68		       bc 80 c1 	      ldy	gbqD2,x
    153  0c6b		       84 2c		      sty	irqT
    154  0c6d		       bc 40 c1 	      ldy	gbqD1,x
    155  0c70		       20 e0 0c 	      jsr	WireMsg
    156  0c73		       a5 18		      lda	gbqTail
    157  0c75		       18		      clc
    158  0c76		       69 01		      adc	#1
    159  0c78		       29 3f		      and	#63
    160  0c7a		       85 18		      sta	gbqTail
    161  0c7c		       a5 10		      lda	ticks
    162  0c7e		       18		      clc
    163  0c7f		       69 03		      adc	#GB_GAP
    164  0c81		       85 19		      sta	gbNext
    165  0c83				   .nes
    166  0c83		       20 ef 37 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    167  0c86		       a5 1b		      lda	nesqTail
    168  0c88		       c5 1a		      cmp	nesqHead
    169  0c8a		       f0 37		      beq	.done
    170  0c8c		       a5 1c		      lda	nesNext
    171  0c8e		       38		      sec
    172  0c8f		       e5 10		      sbc	ticks
    173  0c91		       f0 04		      beq	.nesDue
    174  0c93		       c9 02		      cmp	#NES_GAP+1
