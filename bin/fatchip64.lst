------- FILE midiin.asm LEVEL 2 PASS 3
      0  268d					      include	"midiin.asm"
      1  268d							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  268d							;
      3  268d							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  268d							; The main loop parses them (running status; realtime and system bytes are
      5  268d							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  268d							; notes mode, latch, arp and K + note.
      7  268d							;
      8  268d							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  268d							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  268d							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  268d							;
     12  268d							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  268d							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  268d							;
     15  268d							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  268d							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  268d							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  268d							; MIDI in is passed on to the Game Boy or NES.
     19  268d
     20  268d							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  268d							; Uses A, X.
     22  268d							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  268d							; with the time; a Start ($FA) makes the next clock a beat.
     24  268d				   RxByte
     25  268d					      subroutine
     26  268d		       ad 06 de 	      lda	ACIA_STAT
     27  2690		       4a		      lsr		; RDRF -> carry
     28  2691		       90 2b		      bcc	.x
     29  2693				   RxGot
     30  2693		       ad 07 de 	      lda	ACIA_RX
     31  2696		       c9 f8		      cmp	#$F8
     32  2698		       f0 25		      beq	.clk
     33  269a		       c9 fa		      cmp	#$FA
     34  269c		       d0 0e		      bne	.buf
     35  269e		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  26a0		       8e ca c4 	      stx	clkPhase
     37  26a3		       8e d2 c4 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  26a6							;  the main loop could measure it)
     39  26a6		       ae cb c4 	      ldx	clkBeat
     40  26a9		       8e dd c4 	      stx	clkStartBeat
     41  26ac				   .buf
     42  26ac		       ae 25 c4 	      ldx	rxHead
     43  26af		       9d e5 c3 	      sta	rxBuf,x
     44  26b2		       e8		      inx
     45  26b3		       8a		      txa
     46  26b4		       29 3f		      and	#63
     47  26b6		       cd 26 c4 	      cmp	rxTail
     48  26b9		       f0 03		      beq	.x	; full: dropped
     49  26bb		       8d 25 c4 	      sta	rxHead
     50  26be				   .x
     51  26be		       60		      rts
     52  26bf				   .clk
     53  26bf		       ee c6 c4 	      inc	clkCount
     54  26c2		       ae ca c4 	      ldx	clkPhase
     55  26c5		       e8		      inx
     56  26c6		       e0 18		      cpx	#24
     57  26c8		       90 14		      bcc	.ph
     58  26ca		       a5 10		      lda	ticks
     59  26cc		       8d cd c4 	      sta	clkAtL
     60  26cf		       a5 11		      lda	ticks+1
     61  26d1		       8d ce c4 	      sta	clkAtH
     62  26d4		       a5 2d		      lda	subTick
     63  26d6		       8d cf c4 	      sta	clkAtS
     64  26d9		       ee cb c4 	      inc	clkBeat
     65  26dc		       a2 00		      ldx	#0
     66  26de				   .ph
     67  26de		       8e ca c4 	      stx	clkPhase
     68  26e1		       60		      rts
