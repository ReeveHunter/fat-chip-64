    183 U0032 ????				      seg.u	zp
    184 U0010					      org	$10
    185 U0010		       00 00	   ticks      ds	2	; 1 ms counter (IRQ)
    186 U0012		       00	   scanAt     ds	1	; low byte of ticks for the next scan
    187 U0013		       00	   scrAt      ds	1	; ... for the next screen step
    188 U0014		       00	   lastStatus ds	1	; running status on the wire
    189 U0015		       00	   wireHead   ds	1	; wire ring: head = write, tail = read
    190 U0016		       00	   wireTail   ds	1
    191 U0017		       00	   gbqHead    ds	1	; Game Boy message queue (64 entries)
    192 U0018		       00	   gbqTail    ds	1
    193 U0019		       00	   gbNext     ds	1	; ticks (low byte) when the next GB message may go
    194 U001a		       00	   nesqHead   ds	1
    195 U001b		       00	   nesqTail   ds	1
    196 U001c		       00	   nesNext    ds	1
    197 U001d		       00	   nmiCount   ds	1	; RESTORE presses seen by the NMI handler
    198 U001e		       00 00	   nmiTick    ds	2
    199 U0020		       00	   nmiSeen    ds	1
    200 U0021		       00	   mS	      ds	1	; message being queued: status, data 1, data 2
    201 U0022		       00	   mD1	      ds	1
    202 U0023		       00	   mD2	      ds	1
    203 U0024		       00	   t0	      ds	1
