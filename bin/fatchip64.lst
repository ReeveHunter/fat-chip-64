      0  196c					      include	"voices.asm"
      1  196c							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  196c							;
      3  196c							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  196c							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  196c							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  196c							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  196c							; Allocation, whenever the held notes change. Who comes first (v0.21):
      8  196c							; Polyphony > Fat Bass > the patch's effects (REPEAT's echoes) > stacking.
      9  196c							;   1. every note gets a voice (SPARKLE's arp pair is what you play, so it
     10  196c							;	counts as notes and goes first)
     11  196c							;   2. Fat Bass: as many bass voices as are spare play the lowest note,
     12  196c							;	folded into the bass range (one note fewer needs a voice, so with
     13  196c							;	Fat Bass the bottom of the chord is the bass)
     14  196c							;   3. REPEAT's echo voices: one or two of what's still spare
     15  196c							;   4. leftover voices stack on the lowest two notes, alternating
     16  196c							; So one note = a nine-voice unison across three chips, and in chords the
     17  196c							; bottom of the chord is fattest. Disabled devices, and voices the drums
     18  196c							; hold (vDrum), get no notes.
     19  196c
     20  196c							; ------------------------------------------------------------ SID
     21  196c				   SidInit
     22  196c					      subroutine
