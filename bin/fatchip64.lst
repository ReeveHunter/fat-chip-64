      0  0c24					      include	"keys.asm"
      1  0c24							; Fat Chip 64 - keyboard and RESTORE
      2  0c24
      3  0c24							; Scan the whole matrix, turn changes into key events.
      4  0c24							;
      5  0c24							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0c24							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0c24							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0c24							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0c24							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0c24							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0c24							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0c24							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0c24							; chords whose ghost lands on another used key lose their newest note.
     14  0c24				   KeyScan
     15  0c24					      subroutine
     16  0c24		       a2 07		      ldx	#7
     17  0c26				   .col
     18  0c26		       bd 05 28 	      lda	colSelect,x
     19  0c29		       8d 00 dc 	      sta	CIA1_PRA
     20  0c2c		       ad 01 dc 	      lda	CIA1_PRB
     21  0c2f		       49 ff		      eor	#$FF
     22  0c31		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0c34		       9d 80 c2 	      sta	keyNow,x
     24  0c37		       ca		      dex
     25  0c38		       10 ec		      bpl	.col
     26  0c3a		       a9 ff		      lda	#$FF
     27  0c3c		       8d 00 dc 	      sta	CIA1_PRA
     28  0c3f							; ---- releases first: accepted keys that are up now
     29  0c3f		       a2 00		      ldx	#0
     30  0c41				   .rc
     31  0c41		       8e 1f c3 	      stx	ksCol
     32  0c44		       bd 80 c2 	      lda	keyNow,x
     33  0c47		       49 ff		      eor	#$FF
     34  0c49		       3d 90 c2 	      and	keyAcc,x
     35  0c4c		       8d 1e c3 	      sta	ksBits
     36  0c4f		       a9 00		      lda	#0
     37  0c51		       8d 20 c3 	      sta	ksRow
     38  0c54				   .rb
     39  0c54		       ad 1e c3 	      lda	ksBits
     40  0c57		       f0 21		      beq	.rcn
     41  0c59		       4e 1e c3 	      lsr	ksBits
     42  0c5c		       90 17		      bcc	.rbn
     43  0c5e		       ae 1f c3 	      ldx	ksCol
     44  0c61		       ac 20 c3 	      ldy	ksRow
     45  0c64		       b9 0d 28 	      lda	rowBit,y
     46  0c67		       49 ff		      eor	#$FF
     47  0c69		       3d 90 c2 	      and	keyAcc,x
     48  0c6c		       9d 90 c2 	      sta	keyAcc,x
     49  0c6f		       20 01 0d 	      jsr	KeyCode
     50  0c72		       20 9f 0f 	      jsr	KeyUp
     51  0c75				   .rbn
     52  0c75		       ee 20 c3 	      inc	ksRow
     53  0c78		       d0 da		      bne	.rb
     54  0c7a				   .rcn
     55  0c7a		       ae 1f c3 	      ldx	ksCol
     56  0c7d		       e8		      inx
     57  0c7e		       e0 08		      cpx	#8
     58  0c80		       d0 bf		      bne	.rc
     59  0c82							; ---- presses: down now, not accepted yet. Two passes: modifiers (SHIFT,
     60  0c82							; CTRL, K) first, so SHIFT+F7 or K + a note pressed in the same scan
     61  0c82							; still count as a combination.
     62  0c82		       a9 00		      lda	#0
     63  0c84		       8d 22 c3 	      sta	ksPass
     64  0c87				   .pass
     65  0c87		       a2 00		      ldx	#0
     66  0c89				   .pc
     67  0c89		       8e 1f c3 	      stx	ksCol
     68  0c8c		       bd 90 c2 	      lda	keyAcc,x
     69  0c8f		       49 ff		      eor	#$FF
     70  0c91		       3d 80 c2 	      and	keyNow,x
     71  0c94		       8d 1e c3 	      sta	ksBits
     72  0c97		       a9 00		      lda	#0
     73  0c99		       8d 20 c3 	      sta	ksRow
     74  0c9c				   .pb
     75  0c9c		       ad 1e c3 	      lda	ksBits
     76  0c9f		       f0 3d		      beq	.pcn
     77  0ca1		       4e 1e c3 	      lsr	ksBits
     78  0ca4		       90 33		      bcc	.pbn
     79  0ca6		       ad 23 c3 	      lda	ghostFilter
     80  0ca9		       f0 05		      beq	.accept	; filter off (default): phantoms play
     81  0cab		       20 0f 0d 	      jsr	Suspect
     82  0cae		       b0 29		      bcs	.pbn	; maybe a phantom: wait
     83  0cb0				   .accept
     84  0cb0		       20 01 0d 	      jsr	KeyCode
     85  0cb3		       20 f2 0c 	      jsr	IsModifier	; Z set = modifier
     86  0cb6		       f0 07		      beq	.mod
     87  0cb8		       ad 22 c3 	      lda	ksPass
     88  0cbb		       f0 1c		      beq	.pbn	; pass 0: modifiers only
     89  0cbd		       d0 05		      bne	.take
     90  0cbf				   .mod
     91  0cbf		       ad 22 c3 	      lda	ksPass
     92  0cc2		       d0 15		      bne	.pbn	; (taken in pass 0)
     93  0cc4				   .take
     94  0cc4		       ae 1f c3 	      ldx	ksCol
     95  0cc7		       ac 20 c3 	      ldy	ksRow
     96  0cca		       b9 0d 28 	      lda	rowBit,y
     97  0ccd		       1d 90 c2 	      ora	keyAcc,x
     98  0cd0		       9d 90 c2 	      sta	keyAcc,x
     99  0cd3		       20 01 0d 	      jsr	KeyCode
    100  0cd6		       20 40 0d 	      jsr	KeyDown
    101  0cd9				   .pbn
    102  0cd9		       ee 20 c3 	      inc	ksRow
    103  0cdc		       d0 be		      bne	.pb
    104  0cde				   .pcn
    105  0cde		       ae 1f c3 	      ldx	ksCol
    106  0ce1		       e8		      inx
    107  0ce2		       e0 08		      cpx	#8
    108  0ce4		       d0 a3		      bne	.pc
    109  0ce6		       ad 22 c3 	      lda	ksPass
    110  0ce9		       d0 06		      bne	.done
    111  0ceb		       ee 22 c3 	      inc	ksPass
    112  0cee		       4c 87 0c 	      jmp	.pass
    113  0cf1				   .done
    114  0cf1		       60		      rts
