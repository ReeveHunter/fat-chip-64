------- FILE screen.asm LEVEL 2 PASS 3
      0  75a2					      include	"screen.asm"
      1  75a2							; Fat Chip 64 - screen
      2  75a2							;
      3  75a2							;  row 0      header
      4  75a2							;  row 2      sound, POLY / MONO, Fat Bass
      5  75a2							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  75a2							;	       each plays (row 7: a channel overlap warning)
      7  75a2							;  row 9      key, notes mode, latch
      8  75a2							;  row 10     arp
      9  75a2							;  row 12     tempo, beat, mute
     10  75a2							;  row 13     SPACE's action, octave (the lowest key), transpose
     11  75a2							;  row 14     v0.40: the effect the C= keys work on, its setting
     12  75a2							;  row 15     held notes
     13  75a2							;  row 16     MIDI in
     14  75a2							;  row 24     F keys
     15  75a2
     16  75a2							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     17  75a2							; Letters become screen codes; bit 7 of t2 reverses.
     18  75a2				   PrintAt
     19  75a2					      subroutine
     20  75a2		       20 ba 75 	      jsr	ScreenAddr
     21  75a5		       a0 00		      ldy	#0
     22  75a7				   .c
     23  75a7		       b1 28		      lda	(ptr),y
     24  75a9		       f0 0e		      beq	.done
     25  75ab		       c9 40		      cmp	#64
     26  75ad		       90 03		      bcc	.noLetter
     27  75af		       38		      sec
     28  75b0		       e9 40		      sbc	#64
     29  75b2				   .noLetter
     30  75b2		       05 26		      ora	t2
     31  75b4		       91 2a		      sta	(ptr2),y
     32  75b6		       c8		      iny
     33  75b7		       d0 ee		      bne	.c
     34  75b9				   .done
     35  75b9		       60		      rts
     36  75ba
     37  75ba							; ptr2 = SCREEN + 40*Y + X (row table: no loop)
     38  75ba				   ScreenAddr
     39  75ba					      subroutine
     40  75ba		       8a		      txa
     41  75bb		       18		      clc
