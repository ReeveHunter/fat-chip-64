------- FILE nesfx.asm LEVEL 2 PASS 3
      0  7d10					      include	"nesfx.asm"
      1  7d10							; Fat Chip 64 - MidiNES vibrato, glide and detune (v0.15), with pitch bend
      2  7d10							;
      3  7d10							; The MidiNES has no vibrato, glide or detune of its own, so Fat Chip 64
      4  7d10							; bends each NES channel itself, on top of the SPACE / wheel / VINYL bends:
      5  7d10							;   detune   the pulses apart: pulse 1 down, pulse 2 up, by the SID's detune
      6  7d10							;	      (FAT about 1/16 semitone each way; WIDE more)
      7  7d10							;   vibrato  the SID's vibrato (depth, rate, delay, spread; TAPE WOBBLE) on
      8  7d10							;	      the two pulses (the triangle is usually the bass: it stays put)
      9  7d10							;   glide    a new note starts bent back to the voice's last note and slides
     10  7d10							;	      in the way the SID's does (all three channels)
     11  7d10							; Bends go out every NFX_EVERY ms at most, only when they change, and only
     12  7d10							; while the NES queue has room. The MidiNES moves in steps of about 1/16
     13  7d10							; semitone, so these are a little stepped.
     14  7d10
     15  7d10		       00 08	   NFX_EVERY  equ	8	; ms between steps: one NES channel a step
     16  7d10							;  (the pulses, and the triangle while it glides)
     17  7d10
     18  7d10							; A = 1 (not Z) when a NesFxTick step is due
     19  7d10				   NesFxDue
     20  7d10					      subroutine
     21  7d10		       ad 27 c3 	      lda	devOn+DEV_NES
     22  7d13		       f0 1c		      beq	.x
     23  7d15		       ad ff c5 	      lda	vibDepth
     24  7d18		       0d 2d c5 	      ora	nfxGlide
     25  7d1b		       0d 2e c5 	      ora	nfxRun
     26  7d1e		       0d e3 c9 	      ora	nfxWarb
     27  7d21		       f0 0e		      beq	.x
     28  7d23		       a5 10		      lda	ticks
     29  7d25		       38		      sec
     30  7d26		       ed 29 c5 	      sbc	nfxLast
     31  7d29		       c9 08		      cmp	#NFX_EVERY
     32  7d2b		       a9 00		      lda	#0
     33  7d2d		       90 02		      bcc	.x
     34  7d2f		       a9 01		      lda	#1
     35  7d31				   .x
     36  7d31		       60		      rts
     37  7d32
     38  7d32							; From FxTick, on a pass of its own (the effects' passes). Nothing to do (no vibrato, no glide
     39  7d32							; moving, no effects change to catch up with: nfxRun, set by FxVars): a
     40  7d32							; quick return.
     41  7d32				   NesFxTick
