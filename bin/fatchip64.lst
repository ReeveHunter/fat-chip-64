      0  0e02					      include	"keys.asm"
      1  0e02							; Fat Chip 64 - keyboard and RESTORE
      2  0e02
      3  0e02							; Scan the whole matrix, turn changes into key events.
      4  0e02							;
      5  0e02							; Phantom keys: the C64 keyboard has no diodes, so holding three keys on the
      6  0e02							; corners of a rectangle in the matrix makes the fourth corner read as held.
      7  0e02							; keyAcc holds the keys we've accepted. A newly down key is accepted only if
      8  0e02							; it isn't the corner of a rectangle of held keys; if it is, it could be a
      9  0e02							; phantom (the matrix can't tell a real fourth key from a ghost), so it waits
     10  0e02							; until the rectangle breaks. Keys Fat Chip doesn't use (most are under the
     11  0e02							; overlay) are left out: they're never really pressed, so a reading on one is
     12  0e02							; always a ghost. So Q 2 E plays all three (the ghost lands on 4), and only
     13  0e02							; chords whose ghost lands on another used key lose their newest note.
     14  0e02				   KeyScan
     15  0e02					      subroutine
     16  0e02		       a2 07		      ldx	#7
     17  0e04				   .col
     18  0e04		       bd 1d 69 	      lda	colSelect,x
     19  0e07		       8d 00 dc 	      sta	CIA1_PRA
     20  0e0a		       ad 01 dc 	      lda	CIA1_PRB
     21  0e0d		       49 ff		      eor	#$FF
     22  0e0f		       3d 88 c2 	      and	keyUsed,x	; unused keys only ever read as ghosts
     23  0e12		       9d 80 c2 	      sta	keyNow,x
     24  0e15		       ca		      dex
     25  0e16		       10 ec		      bpl	.col
     26  0e18		       a9 ff		      lda	#$FF
     27  0e1a		       8d 00 dc 	      sta	CIA1_PRA
     28  0e1d							; ---- every column as accepted (nothing pressed or let go): done
     29  0e1d		       a2 07		      ldx	#7
     30  0e1f				   .same
