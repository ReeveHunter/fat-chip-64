    143  4173					      subroutine
    144  4173		       ad 82 c4 	      lda	drumKind
    145  4176		       38		      sec
    146  4177		       e9 02		      sbc	#DK_CH
    147  4179		       85 24		      sta	t0	; 0 closed, 1 open, 2 cymbal
    148  417b		       a9 02		      lda	#2
    149  417d		       38		      sec
    150  417e		       e5 24		      sbc	t0
    151  4180		       85 27		      sta	t3	; priority (0 = most important)
    152  4182		       ad 3e c3 	      lda	nowL
    153  4185		       38		      sec
    154  4186		       ed 7c c4 	      sbc	nzAt
    155  4189		       a8		      tay
    156  418a		       ad 3f c3 	      lda	nowH
    157  418d		       ed 7d c4 	      sbc	nzAt+1
    158  4190		       d0 0c		      bne	.ok
    159  4192		       c0 0c		      cpy	#DRUM_WINDOW
    160  4194		       b0 08		      bcs	.ok
    161  4196		       a5 27		      lda	t3
    162  4198		       cd 7b c4 	      cmp	nzPrio
    163  419b		       90 01		      bcc	.ok
    164  419d		       60		      rts
    165  419e				   .ok
    166  419e		       a5 24		      lda	t0	; preset = sound x 3 + level
    167  41a0		       0a		      asl
    168  41a1		       65 24		      adc	t0
