------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  2e64					      include	"midiin.asm"
      1  2e64							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  2e64							;
      3  2e64							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  2e64							; The main loop parses them (running status; realtime and system bytes are
      5  2e64							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  2e64							; notes mode, latch, arp and K + note.
      7  2e64							;
      8  2e64							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  2e64							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  2e64							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  2e64							;
     12  2e64							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  2e64							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  2e64							;
     15  2e64							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  2e64							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  2e64							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  2e64							; MIDI in is passed on to the Game Boy or NES.
     19  2e64
     20  2e64							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  2e64							; Uses A, X.
     22  2e64							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  2e64							; with the time; a Start ($FA) makes the next clock a beat.
     24  2e64				   RxByte
     25  2e64					      subroutine
     26  2e64		       ad 06 de 	      lda	ACIA_STAT
     27  2e67		       4a		      lsr		; RDRF -> carry
     28  2e68		       90 2b		      bcc	.x
     29  2e6a				   RxGot
     30  2e6a		       ad 07 de 	      lda	ACIA_RX
     31  2e6d		       c9 f8		      cmp	#$F8
     32  2e6f		       f0 25		      beq	.clk
     33  2e71		       c9 fa		      cmp	#$FA
     34  2e73		       d0 0e		      bne	.buf
     35  2e75		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  2e77		       8e e8 c5 	      stx	clkPhase
     37  2e7a		       8e f0 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  2e7d							;  the main loop could measure it)
     39  2e7d		       ae e9 c5 	      ldx	clkBeat
     40  2e80		       8e fb c5 	      stx	clkStartBeat
     41  2e83				   .buf
     42  2e83		       ae 24 c4 	      ldx	rxHead
     43  2e86		       9d e4 c3 	      sta	rxBuf,x
     44  2e89		       e8		      inx
     45  2e8a		       8a		      txa
     46  2e8b		       29 3f		      and	#63
     47  2e8d		       cd 25 c4 	      cmp	rxTail
     48  2e90		       f0 03		      beq	.x	; full: dropped
     49  2e92		       8d 24 c4 	      sta	rxHead
     50  2e95				   .x
     51  2e95		       60		      rts
     52  2e96				   .clk
     53  2e96		       ee e4 c5 	      inc	clkCount
     54  2e99		       ae e8 c5 	      ldx	clkPhase
     55  2e9c		       e8		      inx
     56  2e9d		       e0 18		      cpx	#24
     57  2e9f		       90 1b		      bcc	.ph
     58  2ea1		       a5 10		      lda	ticks
     59  2ea3		       8d eb c5 	      sta	clkAtL
     60  2ea6		       a5 11		      lda	ticks+1
     61  2ea8		       8d ec c5 	      sta	clkAtH
     62  2eab		       a5 2d		      lda	subTick
     63  2ead		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  2eaf		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  2eb1		       ad 05 dc 	      lda	CIA1_TAHI
     66  2eb4				   .q
     67  2eb4		       8d ed c5 	      sta	clkAtS
     68  2eb7		       ee e9 c5 	      inc	clkBeat
     69  2eba		       a2 00		      ldx	#0
     70  2ebc				   .ph
     71  2ebc		       8e e8 c5 	      stx	clkPhase
     72  2ebf		       60		      rts
     73  2ec0
     74  2ec0							; Main loop, every pass: parse what came in.
     75  2ec0				   MidiInService
     76  2ec0					      subroutine
     77  2ec0				   .next
     78  2ec0		       ae 25 c4 	      ldx	rxTail
     79  2ec3		       ec 24 c4 	      cpx	rxHead
     80  2ec6		       d0 01		      bne	.byte
     81  2ec8		       60		      rts
