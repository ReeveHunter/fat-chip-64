------- FILE main.asm
------- FILE midiin.asm LEVEL 2 PASS 3
      0  2ba9					      include	"midiin.asm"
      1  2ba9							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  2ba9							;
      3  2ba9							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  2ba9							; The main loop parses them (running status; realtime and system bytes are
      5  2ba9							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  2ba9							; notes mode, latch, arp and K + note.
      7  2ba9							;
      8  2ba9							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  2ba9							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  2ba9							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  2ba9							;
     12  2ba9							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  2ba9							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  2ba9							;
     15  2ba9							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  2ba9							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  2ba9							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  2ba9							; MIDI in is passed on to the Game Boy or NES.
     19  2ba9
     20  2ba9							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  2ba9							; Uses A, X.
     22  2ba9							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  2ba9							; with the time; a Start ($FA) makes the next clock a beat.
     24  2ba9				   RxByte
     25  2ba9					      subroutine
     26  2ba9		       ad 06 de 	      lda	ACIA_STAT
     27  2bac		       4a		      lsr		; RDRF -> carry
     28  2bad		       90 2b		      bcc	.x
     29  2baf				   RxGot
     30  2baf		       ad 07 de 	      lda	ACIA_RX
     31  2bb2		       c9 f8		      cmp	#$F8
     32  2bb4		       f0 25		      beq	.clk
     33  2bb6		       c9 fa		      cmp	#$FA
     34  2bb8		       d0 0e		      bne	.buf
     35  2bba		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  2bbc		       8e e9 c5 	      stx	clkPhase
     37  2bbf		       8e f1 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  2bc2							;  the main loop could measure it)
     39  2bc2		       ae ea c5 	      ldx	clkBeat
     40  2bc5		       8e fc c5 	      stx	clkStartBeat
     41  2bc8				   .buf
     42  2bc8		       ae 25 c4 	      ldx	rxHead
     43  2bcb		       9d e5 c3 	      sta	rxBuf,x
     44  2bce		       e8		      inx
     45  2bcf		       8a		      txa
     46  2bd0		       29 3f		      and	#63
     47  2bd2		       cd 26 c4 	      cmp	rxTail
     48  2bd5		       f0 03		      beq	.x	; full: dropped
     49  2bd7		       8d 25 c4 	      sta	rxHead
     50  2bda				   .x
     51  2bda		       60		      rts
     52  2bdb				   .clk
     53  2bdb		       ee e5 c5 	      inc	clkCount
     54  2bde		       ae e9 c5 	      ldx	clkPhase
     55  2be1		       e8		      inx
     56  2be2		       e0 18		      cpx	#24
     57  2be4		       90 1b		      bcc	.ph
     58  2be6		       a5 10		      lda	ticks
     59  2be8		       8d ec c5 	      sta	clkAtL
     60  2beb		       a5 11		      lda	ticks+1
     61  2bed		       8d ed c5 	      sta	clkAtH
     62  2bf0		       a5 2d		      lda	subTick
     63  2bf2		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  2bf4		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  2bf6		       ad 05 dc 	      lda	CIA1_TAHI
     66  2bf9				   .q
     67  2bf9		       8d ee c5 	      sta	clkAtS
     68  2bfc		       ee ea c5 	      inc	clkBeat
     69  2bff		       a2 00		      ldx	#0
     70  2c01				   .ph
     71  2c01		       8e e9 c5 	      stx	clkPhase
     72  2c04		       60		      rts
     73  2c05
     74  2c05							; Main loop, every pass: parse what came in.
     75  2c05				   MidiInService
     76  2c05					      subroutine
     77  2c05				   .next
     78  2c05		       ae 26 c4 	      ldx	rxTail
