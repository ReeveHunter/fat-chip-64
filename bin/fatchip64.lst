     43  2357		       0d ca c3 	      ora	hardCut
     44  235a		       d0 f1		      bne	.nope
     45  235c		       ad 27 c3 	      lda	devOn+DEV_NES
     46  235f		       f0 ec		      beq	.nope
     47  2361		       bd c2 6f 	      lda	vDev,x
     48  2364		       c9 02		      cmp	#DEV_NES
     49  2366		       d0 7c		      bne	.no
     50  2368		       bd 96 c3 	      lda	vOut,x
