------- FILE main.asm
------- FILE devices.asm LEVEL 2 PASS 3
      0  5e9f					      include	"devices.asm"
      1  5e9f							; Fat Chip 64 - the devices plugged into MIDI IN (v0.24): DEVICES says which
      2  5e9f							; are in use, and each one in use gets its page on the main menu.
      3  5e9f							;
      4  5e9f							; YAMAHA SHS-10 (the keytar)
      5  5e9f							;   TEMPO	     FOLLOW / IGNORE: its MIDI clock sets the tempo
      6  5e9f							;   SHS-10 RHYTHM   IGNORE / PLAY ON MIDINES: its drum notes (channel 16)
      7  5e9f							;   START/STOP      BUILT-IN BEATS / IGNORE: its Start and Stop start / stop
      8  5e9f							;		     Fat Chip's beat. (RUN/STOP always does too. Both rhythms
      9  5e9f							;		     can play at once.)
     10  5e9f							;   VOICE BUTTONS   PICK PATCH / IGNORE: its 25 voices pick the 25 bank slots
     11  5e9f							;		     (A1-A5, S1-S5 ... an empty slot does nothing)
     12  5e9f							;   RHYTHM BUTTONS, WHEEL, VIBRATO / PORTAMENTO / SUSTAIN BUTTON: sync.asm
     13  5e9f							; CASIO DH-100 (the horn: MIDI out only; breath = channel pressure)
     14  5e9f							;   BREATH	     VOLUME / VOLUME+FILTER / FILTER / OFF: blowing harder is
     15  5e9f							;		     louder (the SID and the NES; the Game Boy would click) or
     16  5e9f							;		     brighter (the SID's filter: switched on if the patch has
     17  5e9f							;		     none)
     18  5e9f							;   BREATH FX1, FX2 a depth that follows the breath (VIBRATO, WARBLE, DETUNE:
     19  5e9f							;		     the patch's, or the ADVANCED amounts if it has none;
     20  5e9f							;		     FILTER), or an action held while blowing hard
     21  5e9f							;   BREATH FEEL     SOFT / NORMAL / HARD
     22  5e9f							;   NOTES	     AS PLAYED / CHORD / HARMONY (a third above, in the key)
     23  5e9f							;   PORTAMENTO BUTTON	an action (CC 65)
     24  5e9f							;   TONE BUTTONS    PICK BANK / IGNORE: its six tones pick the banks FAT,
     25  5e9f							;		     PADS, LEADS, BASS, FX, and the sixth rolls the dice
     26  5e9f							; ATARI SYNTHCART
     27  5e9f							;   TEMPO	     OFF / SYNC: tempos snap to Synthcart's ten; , . nudge
     28  5e9f							;		     about 3% while held, SHIFT + , . step through the ten
     29  5e9f							;   TRIM	     -8..+8: about 0.1% a step, for clock drift
     30  5e9f							;   TUNE TO	     OFF / one of its five sounds: Fat Chip moves by that
     31  5e9f							;		     sound's cents (the Synthcart manual's table: each Atari
     32  5e9f							;		     sound plays its scales in its own key, a little off)
     33  5e9f							;   MATCH KEY	     ON / OFF: the key's root goes to that sound's key
     34  5e9f
     35  5e9f		       00 40	   BREATH_HI  equ	64	; a held action: on at this breath, off under BREATH_LO
     36  5e9f		       00 28	   BREATH_LO  equ	40
     37  5e9f		       00 01	   BFX_VIB    equ	1
     38  5e9f		       00 02	   BFX_WARB   equ	2
     39  5e9f		       00 03	   BFX_DET    equ	3
     40  5e9f		       00 04	   BFX_FILT   equ	4
     41  5e9f		       00 05	   BFX_HELD   equ	5
     42  5e9f
