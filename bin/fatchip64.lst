    236  0cbf				   .rs
    237  0cbf		       98		      tya
    238  0cc0		       20 d9 0c 	      jsr	WirePut
    239  0cc3		       a5 14		      lda	lastStatus
    240  0cc5		       29 e0		      and	#$E0
    241  0cc7		       c9 c0		      cmp	#$C0	; $Cx and $Dx: one data byte
    242  0cc9		       f0 05		      beq	.done
    243  0ccb		       a5 2c		      lda	irqT
    244  0ccd		       20 d9 0c 	      jsr	WirePut
    245  0cd0				   .done
