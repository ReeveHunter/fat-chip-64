      0  479f					      include	"menu.asm"
      1  479f							; Fat Chip 64 - the menu (v0.14): RETURN in, SHIFT+RETURN back out
      2  479f							;
      3  479f							; Three pages: the main one (SOUND, PLAYING), ADVANCED SOUND and DEVICE SYNC
      4  479f							; (RETURN on their lines opens them, SHIFT+RETURN comes back).
      5  479f							; CRSR DOWN / SHIFT+CRSR DOWN (up): choose a setting. CRSR RIGHT / SHIFT+CRSR
      6  479f							; RIGHT: its next / previous value. Every other key works as usual (notes
      7  479f							; play; V, F keys, = ... too: the values here follow).
      8  479f							; The play screen pauses while the menu is up and redraws when it closes.
      9  479f
     10  479f		       00 17	   MENU_VALCOL equ	23
