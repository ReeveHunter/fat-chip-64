      0  4893					      include	"menu.asm"
      1  4893							; Fat Chip 64 - the menu (v0.14): RETURN in, SHIFT+RETURN back out
      2  4893							;
      3  4893							; Three pages: the main one (SOUND, PLAYING), ADVANCED SOUND and DEVICE SYNC
      4  4893							; (RETURN on their lines opens them, SHIFT+RETURN comes back).
      5  4893							; CRSR DOWN / SHIFT+CRSR DOWN (up): choose a setting. CRSR RIGHT / SHIFT+CRSR
      6  4893							; RIGHT: its next / previous value. Every other key works as usual (notes
      7  4893							; play; V, F keys, = ... too: the values here follow).
      8  4893							; The play screen pauses while the menu is up and redraws when it closes.
      9  4893
     10  4893		       00 17	   MENU_VALCOL equ	23
