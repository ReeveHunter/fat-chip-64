------- FILE main.asm
------- FILE wander.asm LEVEL 2 PASS 3
      0  6a23					      include	"wander.asm"
      1  6a23							; Fat Chip 64 - chord changes, DRONE and One Key Play (v0.27)
      2  6a23							;
      3  6a23							; CHORD CHANGE (PLAYING): how the voices move when the chord changes.
      4  6a23							;   AS MODE  DRONE wanders, the other modes ATTACK
      5  6a23							;   ATTACK   as always: the new notes start
      6  6a23							;   GLIDE    every voice slides to its new note (a glide even if the patch
      7  6a23							;	      has none)
      8  6a23							;   STAGGER  the SID and the bass voices glide, the Game Boy and NES pulses
      9  6a23							;	      start again
     10  6a23							;   WANDER   each voice moves at its own moment within WANDER TIME, the bass
     11  6a23							;	      late; some glide, some start again (fade out, come back in)
     12  6a23							; DRONE (C= + Z): the lowest key held is the root: open fifths up from it
     13  6a23							;   (DRONE VOICING: FIFTHS, FIFTHS + 9TH, SUS4). A new key moves the drone.
     14  6a23							; ONE KEY PLAY: the cursor keys step through a phrase (pentatonic pairs or
     15  6a23							;   the chord's notes); alternate the two for fast runs. See OkpPress.
     16  6a23
     17  6a23		       00 01	   CHG_ATTACK equ	1
     18  6a23		       00 02	   CHG_GLIDE  equ	2
     19  6a23		       00 03	   CHG_STAGGER equ	3
     20  6a23		       00 04	   CHG_WANDER equ	4
     21  6a23		       00 06	   CHG_K      equ	6	; CHORD CHANGE's glide (as a patch's glideK)
     22  6a23		       00 07	   DRONE_K    equ	7	; v0.42: DRONE's glide, slower (about 1.5 s; the Game Boy's slowest)
     23  6a23
     24  6a23							; A = the chord change style now (keeps X, Y)
     25  6a23				   ChgEff
     26  6a23					      subroutine
     27  6a23		       ad 65 c8 	      lda	chgMode
     28  6a26		       d0 0c		      bne	.x
     29  6a28		       ad b3 c3 	      lda	effMode
     30  6a2b		       c9 02		      cmp	#MODE_DRONE
     31  6a2d		       d0 03		      bne	.a
     32  6a2f		       a9 04		      lda	#CHG_WANDER
     33  6a31		       60		      rts
     34  6a32				   .a
     35  6a32		       a9 01		      lda	#CHG_ATTACK
     36  6a34				   .x
     37  6a34		       60		      rts
     38  6a35
     39  6a35							; ApplyVoices, voice X changes note: how. A = 0 (Z): change it now (t3,
     40  6a35							; legatoNow, vsGlide set); A = 1: not yet (WANDER). Keeps X.
     41  6a35				   ChgStyle
     42  6a35					      subroutine
     43  6a35		       bd 17 c3 	      lda	vNote,x
     44  6a38		       c9 ff		      cmp	#NO_NOTE
     45  6a3a		       d0 34		      bne	.snd
     46  6a3c		       bd 0e c3 	      lda	vWant,x	; from silence: at once (GLIDE, STAGGER: from the
     47  6a3f		       c9 ff		      cmp	#NO_NOTE	;  voice's last note, like a portamento)
     48  6a41		       f0 2a		      beq	.now0
     49  6a43		       ad d7 c3 	      lda	hardCut
     50  6a46		       0d 51 c4 	      ora	monoMode
     51  6a49		       d0 22		      bne	.now0
     52  6a4b		       bd fb c9 	      lda	vOkp,x	; (v0.50: One Key Play's: no glide from silence)
     53  6a4e		       d0 1d		      bne	.now0
     54  6a50		       20 23 6a 	      jsr	ChgEff
     55  6a53		       c9 02		      cmp	#CHG_GLIDE
     56  6a55		       f0 10		      beq	.gs
     57  6a57		       c9 03		      cmp	#CHG_STAGGER
     58  6a59		       d0 12		      bne	.now0
     59  6a5b		       bd f4 82 	      lda	vDev,x
     60  6a5e		       f0 07		      beq	.gs
     61  6a60		       bd fd 82 	      lda	vIdx,x
     62  6a63		       c9 02		      cmp	#2
     63  6a65		       d0 06		      bne	.now0
     64  6a67				   .gs
     65  6a67		       ad 10 c6 	      lda	glideK
     66  6a6a		       8d 69 c8 	      sta	vsGlide
     67  6a6d				   .now0
     68  6a6d		       a9 00		      lda	#0
     69  6a6f		       60		      rts
     70  6a70				   .snd
     71  6a70		       bd 0e c3 	      lda	vWant,x
     72  6a73		       c9 ff		      cmp	#NO_NOTE
     73  6a75		       f0 72		      beq	.now
     74  6a77		       ad d7 c3 	      lda	hardCut
     75  6a7a		       1d 7e c3 	      ora	vArpHit,x	; (the arp, MONO: their own way)
     76  6a7d		       0d 51 c4 	      ora	monoMode
     77  6a80		       d0 67		      bne	.now
     78  6a82		       bd fb c9 	      lda	vOkp,x	; One Key Play's voices: at once, new attacks (v0.52:
     79  6a85		       d0 5e		      bne	.okp	;  never a chord change's glide)
     80  6a87
     81  6a87		       20 23 6a 	      jsr	ChgEff
     82  6a8a		       c9 01		      cmp	#CHG_ATTACK
     83  6a8c		       f0 5b		      beq	.now
     84  6a8e		       c9 02		      cmp	#CHG_GLIDE
     85  6a90		       f0 5a		      beq	.glide
     86  6a92		       c9 03		      cmp	#CHG_STAGGER
     87  6a94		       d0 0e		      bne	.wander
     88  6a96		       bd f4 82 	      lda	vDev,x	; STAGGER: the SID and the bass glide
     89  6a99		       f0 51		      beq	.glide
     90  6a9b		       bd fd 82 	      lda	vIdx,x
     91  6a9e		       c9 02		      cmp	#2
     92  6aa0		       f0 4a		      beq	.glide
     93  6aa2		       d0 37		      bne	.attack
     94  6aa4				   .wander
     95  6aa4		       bd 6a c8 	      lda	vWaitOn,x
     96  6aa7		       d0 11		      bne	.waiting
     97  6aa9		       a9 01		      lda	#1
     98  6aab		       9d 6a c8 	      sta	vWaitOn,x
     99  6aae		       20 1a 6b 	      jsr	WanderDelay
    100  6ab1		       18		      clc
    101  6ab2		       6d 7c c8 	      adc	unitNow
    102  6ab5		       9d 73 c8 	      sta	vDue,x
    103  6ab8		       d0 44		      bne	.wait	; (always: a later pass)
    104  6aba				   .waiting
    105  6aba		       ad 7c c8 	      lda	unitNow
    106  6abd		       38		      sec
