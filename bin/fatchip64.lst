    148  0fa3							; A = key code at ksCol / ksRow
    149  0fa3				   KeyCode
    150  0fa3					      subroutine
    151  0fa3		       ad 38 c3 	      lda	ksCol
    152  0fa6		       0a		      asl
    153  0fa7		       0a		      asl
    154  0fa8		       0a		      asl
    155  0fa9		       0d 39 c3 	      ora	ksRow
    156  0fac		       a8		      tay
    157  0fad		       b9 c2 80 	      lda	keymap,y
    158  0fb0		       60		      rts
