    182 U0032 ????				      seg.u	zp
    183 U0010					      org	$10
    184 U0010		       00 00	   ticks      ds	2	; 1 ms counter (IRQ)
    185 U0012		       00	   scanAt     ds	1	; low byte of ticks for the next scan
    186 U0013		       00	   scrAt      ds	1	; ... for the next screen step
    187 U0014		       00	   lastStatus ds	1	; running status on the wire
    188 U0015		       00	   wireHead   ds	1	; wire ring: head = write, tail = read
    189 U0016		       00	   wireTail   ds	1
