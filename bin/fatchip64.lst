    215  0bce		       69 01		      adc	#1
    216  0bd0		       29 3f		      and	#63
    217  0bd2		       c5 18		      cmp	gbqTail
    218  0bd4		       f0 02		      beq	.full
    219  0bd6		       85 17		      sta	gbqHead
    220  0bd8				   .full
    221  0bd8		       60		      rts
