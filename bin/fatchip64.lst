    148  0fa3							; A = key code at ksCol / ksRow
    149  0fa3				   KeyCode
    150  0fa3					      subroutine
    151  0fa3		       ad 38 c3 	      lda	ksCol
    152  0fa6		       0a		      asl
    153  0fa7		       0a		      asl
    154  0fa8		       0a		      asl
    155  0fa9		       0d 39 c3 	      ora	ksRow
    156  0fac		       a8		      tay
    157  0fad		       b9 58 81 	      lda	keymap,y
    158  0fb0		       60		      rts
    159  0fb1
    160  0fb1							; Carry set if the key at ksCol / ksRow is the corner of a rectangle of held
    161  0fb1							; keys: some other column has a key in this row and shares another row with
    162  0fb1							; this column.
    163  0fb1				   Suspect
    164  0fb1					      subroutine
    165  0fb1		       ac 39 c3 	      ldy	ksRow
    166  0fb4		       b9 50 81 	      lda	rowBit,y
    167  0fb7		       49 ff		      eor	#$FF
    168  0fb9		       ae 38 c3 	      ldx	ksCol
    169  0fbc		       3d 80 c2 	      and	keyNow,x
    170  0fbf		       8d 3a c3 	      sta	ksMask	; this column's other held rows
    171  0fc2		       f0 1c		      beq	.no
    172  0fc4		       a2 07		      ldx	#7
    173  0fc6				   .c
    174  0fc6		       ec 38 c3 	      cpx	ksCol
    175  0fc9		       f0 12		      beq	.n
    176  0fcb		       bd 80 c2 	      lda	keyNow,x
    177  0fce		       39 50 81 	      and	rowBit,y
    178  0fd1		       f0 0a		      beq	.n
    179  0fd3		       bd 80 c2 	      lda	keyNow,x
    180  0fd6		       2d 3a c3 	      and	ksMask
    181  0fd9		       f0 02		      beq	.n
    182  0fdb		       38		      sec
    183  0fdc		       60		      rts
    184  0fdd				   .n
    185  0fdd		       ca		      dex
    186  0fde		       10 e6		      bpl	.c
    187  0fe0				   .no
    188  0fe0		       18		      clc
    189  0fe1		       60		      rts
    190  0fe2
    191  0fe2							; A = key code (v0.22 layout)
    192  0fe2							;   overlay	    notes
    193  0fe2							;   A S D F G	    bank (FAT PADS LEADS BASS FX): switches at once, same slot
    194  0fe2							;   Z X C V B	    patch 1-5 in the bank
    195  0fe2							;   L		    latch on / off	      K, then a note or a shape: key + scale
    196  0fe2							;   =		    tap tempo		      , / .  tempo -1 / +1 (SHIFT: 10)
    197  0fe2							;   /		    mute		      SHIFT+/  the dice
    198  0fe2							;   ; / :	    free arp speed	      SPACE  its action
    199  0fe2							;   F1 / F3	    octave up / down	      F5  arp on / off	  F7  visualizer
    200  0fe2							;   RETURN	    the menu		      CTRL+F3/F5  GB / NES channel block
    201  0fe2							;   C= +  A S D F  arp type / pattern / speed / SPARKLE octave
    202  0fe2							;	   Z X C    notes mode / extensions / POLY-MONO     L  latch style
    203  0fe2							;	   , .	    SPACE's action	      ; :  MIDI in octave down / up
    204  0fe2							;	   /	    undo the dice	      F1 F3 F5	SID / GB / NES on-off
    205  0fe2							;	   F7	    panic		      (SHIFT + F keys too, as before)
    206  0fe2							;   RUN/STOP	    tapped: beat start / stop; held + A S D F G H: pick a beat
    207  0fe2				   KeyDown
    208  0fe2					      subroutine
    209  0fe2		       c9 18		      cmp	#24
    210  0fe4		       90 03		      bcc	NoteDown
    211  0fe6		       4c 93 10 	      jmp	.cmd
    212  0fe9				   NoteDown		; A = note index (overlay key 0-23, MIDI slot 24-31)
    213  0fe9		       aa		      tax
    214  0fea		       ad c1 c8 	      lda	spArm
    215  0fed		       f0 03		      beq	.nsp
    216  0fef		       4c 42 6f 	      jmp	SplitSet	; (C= + V held: this note sets the split, it doesn't play)
    217  0ff2				   .nsp
    218  0ff2		       ad 75 c7 	      lda	kArm
    219  0ff5		       f0 03		      beq	.note
