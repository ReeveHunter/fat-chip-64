------- FILE main.asm
------- FILE repeat.asm LEVEL 2 PASS 3
      0  387c					      include	"repeat.asm"
      1  387c							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  387c							;
      3  387c							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  387c							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  387c							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  387c							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  387c							; 1s), taken out of the chord while REPEAT is on - unless the notes held need
      8  387c							; them (then held notes come first and the echoes wait). Each echo sounds for
      9  387c							; 3/4 of the time between echoes. The SID doesn't echo.
     10  387c							;
     11  387c							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     12  387c							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     13  387c							; or a keytar button).
     14  387c							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     15  387c							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     16  387c
     17  387c		       00 10	   RP_SLOTS   equ	16
     18  387c		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     19  387c
     20  387c							; REPEAT is on now?
     21  387c				   RepeatActive
     22  387c		       ad 4c c5 	      lda	repeatOn
     23  387f		       0d ac c4 	      ora	actCnt+A_REPEAT
     24  3882		       60		      rts
     25  3883
