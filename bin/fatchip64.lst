------- FILE sounds.asm LEVEL 2 PASS 3
      0  3d7e					      include	"sounds.asm"
      1  3d7e							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  3d7e							;
      3  3d7e							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  3d7e							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  3d7e							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  3d7e							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  3d7e							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  3d7e							;
      9  3d7e							; Each sound has a mono default and a Fat Bass default:
     10  3d7e							;   MONO      one note (the last key pressed and still held) on every voice;
     11  3d7e							;	       a new key while another is held changes the pitch without a
     12  3d7e							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  3d7e							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  3d7e							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  3d7e							;	       the other voices
     16  3d7e							;
     17  3d7e							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  3d7e							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  3d7e							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  3d7e
     21  3d7e							; ------------------------------------------------------------ choosing
     22  3d7e							; V: next sound (SHIFT+V: previous)
     23  3d7e				   SoundKey
     24  3d7e					      subroutine
     25  3d7e		       20 0e 3e 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  3d81		       ae 5d c8 	      ldx	soundMode
