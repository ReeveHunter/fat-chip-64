------- FILE arp.asm LEVEL 2 PASS 3
      0  1a16					      include	"arp.asm"
      1  1a16							; Fat Chip 64 - tempo and arpeggiator
      2  1a16							;
      3  1a16							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  1a16							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  1a16							;
      6  1a16							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  1a16							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  1a16							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  1a16							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  1a16							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  1a16							;	     until its voice's next turn.
     12  1a16							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  1a16							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  1a16							;   J faster; either one also picks FREE).
     15  1a16							;
     16  1a16							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  1a16							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  1a16
     19  1a16							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  1a16							; between the two bytes: $22FF read as $23FF)
     21  1a16				   GetTicks
     22  1a16					      subroutine
     23  1a16		       08		      php
     24  1a17		       78		      sei
     25  1a18		       a5 10		      lda	ticks
     26  1a1a		       8d 3e c3 	      sta	nowL
     27  1a1d		       a5 11		      lda	ticks+1
     28  1a1f		       8d 3f c3 	      sta	nowH
     29  1a22		       28		      plp
     30  1a23		       60		      rts
     31  1a24
