------- FILE repeat.asm LEVEL 2 PASS 3
      0  46de					      include	"repeat.asm"
      1  46de							; Fat Chip 64 - REPEAT (v0.13): echoes of the notes you play
      2  46de							;
      3  46de							; Each key pressed (overlay or MIDI in) is played again REPEATS times, every
      4  46de							; REPEAT TIME, each one REPEAT LEVEL as loud as the one before (velocity:
      5  46de							; the Game Boy and MidiNES scale their level by it). The echoes play on one
      6  46de							; or two "echo voices" (Game Boy pulse 2 and NES pulse 2 first, then pulse
      7  46de							; 1s), taken out of the chord while REPEAT is on - from what's spare once
      8  46de							; the notes and Fat Bass have theirs (v0.21: Polyphony > Fat Bass >
      9  46de							; effects; with nothing spare the echoes wait). Each echo sounds for
     10  46de							; 3/4 of the time between echoes. The SID doesn't echo.
     11  46de							;
     12  46de							; REPEAT on / off: the sound's default, the menu's REPEAT (AS SOUND / ON /
     13  46de							; OFF; ON uses the ADVANCED SOUND values), or the REPEAT action held (SPACE
     14  46de							; or a keytar button).
     15  46de							; REPEAT TIME: 1/4, 1/8 dotted, 1/8, 1/8T, 1/16 of the tempo, or FREE
     16  46de							; 80-500 ms. REPEATS: 1-8. REPEAT LEVEL: FULL, 90, 80, 70, 60, 50 %.
     17  46de
     18  46de		       00 10	   RP_SLOTS   equ	16
     19  46de		       00 05	   RP_SYNCED  equ	5	; REPEAT TIME 0-4 follow the tempo, 5- are ms
     20  46de
     21  46de							; REPEAT is on now?
     22  46de				   RepeatActive
     23  46de		       ad 4c c5 	      lda	repeatOn
     24  46e1		       0d ac c4 	      ora	actCnt+A_REPEAT
     25  46e4		       60		      rts
     26  46e5
