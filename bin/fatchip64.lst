    443  6690							; ------------------------------------------------------------ tuning
    444  6690							; tuneC = PLAYING's FINE TUNE + the Synthcart's TUNE TO (while it's in use),
    445  6690							; in cents (-100..+100). The Game Boy gets it as master tune (CC 103), the
    446  6690							; NES in its bends (tuneN, 1/64 semitones), the SID in its note frequencies
    447  6690							; (SidTune; the notes sounding move at once). MATCH KEY sets the key's root
    448  6690							; once, when it changes.
    449  6690				   ScTune
    450  6690					      subroutine
    451  6690		       a9 00		      lda	#0
    452  6692		       ae 38 c8 	      ldx	useSc
    453  6695		       f0 03		      beq	.t
    454  6697		       ad 4f c8 	      lda	scSound
