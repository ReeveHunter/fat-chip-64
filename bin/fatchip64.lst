------- FILE main.asm
------- FILE voices.asm LEVEL 2 PASS 2
      0  0e27					      include	"voices.asm"
      1  0e27							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  0e27							;
      3  0e27							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  0e27							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  0e27							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  0e27							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  0e27							; Allocation, whenever the held notes change:
      8  0e27							;   1. bass voices play the lowest note, an octave down
      9  0e27							;   2. every other note gets one voice, lowest notes first
     10  0e27							;   3. leftover voices stack on the lowest two notes, alternating
     11  0e27							; So one note = a nine-voice unison across three chips, and in chords the
     12  0e27							; bottom of the chord is fattest. Disabled devices get no notes.
     13  0e27
     14  0e27							; ------------------------------------------------------------ SID
     15  0e27				   SidInit
     16  0e27					      subroutine
     17  0e27		       a2 18		      ldx	#24
     18  0e29		       a9 00		      lda	#0
     19  0e2b				   .clr
     20  0e2b		       9d 00 d4 	      sta	SID,x
     21  0e2e		       ca		      dex
     22  0e2f		       10 fa		      bpl	.clr
     23  0e31		       20 54 0e 	      jsr	SidVolume
     24  0e34		       a2 02		      ldx	#2
     25  0e36				   .v
     26  0e36		       bc a5 15 	      ldy	sidOfs,x
     27  0e39		       a9 19		      lda	#$19	; attack 1, decay 9
     28  0e3b		       99 05 d4 	      sta	SID+5,y
     29  0e3e		       a9 c9		      lda	#$C9	; sustain 12, release 9
     30  0e40		       99 06 d4 	      sta	SID+6,y
     31  0e43		       a9 08		      lda	#$08	; pulse width 50% (for pulse patches later)
     32  0e45		       99 03 d4 	      sta	SID+3,y
     33  0e48		       a9 20		      lda	#$20	; sawtooth, gate off
     34  0e4a		       9d 19 c3 	      sta	sidGate,x
     35  0e4d		       99 04 d4 	      sta	SID+4,y
     36  0e50		       ca		      dex
     37  0e51		       10 e3		      bpl	.v
     38  0e53		       60		      rts
     39  0e54
     40  0e54							; Volume 15, or 0 (silent, no hum) when the SID is off or muted (M).
