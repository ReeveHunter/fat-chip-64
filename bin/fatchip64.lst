      0  1122					      include	"voices.asm"
      1  1122							; Fat Chip 64 - voice pool and smart stacking (poly synth mode)
      2  1122							;
      3  1122							; Nine voices across three chips, interleaved so a stack mixes chips:
      4  1122							;   v0 SID 1	v1 GB pulse 1	v2 NES pulse 1
      5  1122							;   v3 SID 2	v4 GB pulse 2	v5 NES pulse 2
      6  1122							;   v6 SID 3	v7 GB wave*	v8 NES triangle*      (* bass voices)
      7  1122							; Allocation, whenever the held notes change:
      8  1122							;   1. bass voices play the lowest note, an octave down
      9  1122							;   2. every other note gets one voice, lowest notes first
     10  1122							;   3. leftover voices stack on the lowest two notes, alternating
     11  1122							; So one note = a nine-voice unison across three chips, and in chords the
     12  1122							; bottom of the chord is fattest. Disabled devices get no notes.
     13  1122
     14  1122							; ------------------------------------------------------------ SID
     15  1122				   SidInit
