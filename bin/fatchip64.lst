------- FILE drums.asm LEVEL 2 PASS 3
      0  4098					      include	"drums.asm"
      1  4098							; Fat Chip 64 - drums on the MidiNES
      2  4098							;
      3  4098							; Two sources, one kit:
      4  4098							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  4098							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  4098							;			   64 = hit, 56 = ghost)
      7  4098							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  4098							;			   RETURN starts / stops it, at its own tempo (B taps
      9  4098							;			   a new one)
     10  4098							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  4098							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  4098							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  4098							; a note-on, then a note-off after the sound's length, the level set with
     14  4098							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  4098							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  4098
     17  4098		       00 0c	   KIT_SIZE   equ	12
     18  4098		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  4098		       00 00	   DK_KICK    equ	0
     20  4098		       00 01	   DK_SNARE   equ	1
     21  4098		       00 02	   DK_CH      equ	2
     22  4098		       00 03	   DK_OH      equ	3
     23  4098		       00 04	   DK_CY      equ	4
     24  4098		       00 05	   DK_TOM     equ	5
     25  4098		       00 06	   DK_PERC    equ	6
     26  4098
     27  4098							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  4098				   DrumHit
     29  4098					      subroutine
     30  4098		       8d 82 c4 	      sta	drumKind
     31  409b		       8e 81 c4 	      stx	drumLvl
     32  409e		       8c 83 c4 	      sty	drumTom
     33  40a1		       c9 00		      cmp	#DK_KICK
     34  40a3		       d0 05		      bne	.nk
     35  40a5		       a9 01		      lda	#1
     36  40a7		       8d 3f c6 	      sta	vizKick	; (the visualizer's border flash)
     37  40aa				   .nk
     38  40aa		       ad 27 c3 	      lda	devOn+DEV_NES
     39  40ad		       d0 01		      bne	.on
     40  40af		       60		      rts
     41  40b0				   .on
     42  40b0		       20 fc 1c 	      jsr	GetTicks
     43  40b3		       ad 82 c4 	      lda	drumKind
     44  40b6		       c9 02		      cmp	#DK_CH
     45  40b8		       90 07		      bcc	.dmc
     46  40ba		       c9 05		      cmp	#DK_TOM
     47  40bc		       b0 03		      bcs	.dmc
     48  40be		       4c 73 41 	      jmp	NoiseHit
     49  40c1				   .dmc
     50  40c1		       ae 82 c4 	      ldx	drumKind
     51  40c4		       bd 5a 41 	      lda	dmcPrioT,x
     52  40c7		       85 24		      sta	t0
     53  40c9		       ad 3e c3 	      lda	nowL
     54  40cc		       38		      sec
     55  40cd		       ed 79 c4 	      sbc	dmcAt
     56  40d0		       a8		      tay
     57  40d1		       ad 3f c3 	      lda	nowH
     58  40d4		       ed 7a c4 	      sbc	dmcAt+1
     59  40d7		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  40d9		       c0 0c		      cpy	#DRUM_WINDOW
     61  40db		       b0 08		      bcs	.ok
     62  40dd		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     63  40df		       cd 78 c4 	      cmp	dmcPrio
     64  40e2		       90 01		      bcc	.ok
     65  40e4		       60		      rts
     66  40e5				   .ok
     67  40e5							; the sample: kit[beat][kitOfs[kind] + level, or + tom]
     68  40e5		       ae 82 c4 	      ldx	drumKind
     69  40e8		       bd 61 41 	      lda	kitOfs,x
     70  40eb		       e0 05		      cpx	#DK_TOM
     71  40ed		       d0 07		      bne	.lv
     72  40ef		       18		      clc
     73  40f0		       6d 83 c4 	      adc	drumTom
     74  40f3		       4c fa 40 	      jmp	.k
     75  40f6				   .lv
     76  40f6		       18		      clc
     77  40f7		       6d 81 c4 	      adc	drumLvl
     78  40fa				   .k
     79  40fa		       85 25		      sta	t1
     80  40fc		       ad 6d c4 	      lda	beatSel	; x 12
     81  40ff		       0a		      asl
     82  4100		       0a		      asl
     83  4101		       85 26		      sta	t2
     84  4103		       0a		      asl
     85  4104		       65 26		      adc	t2
     86  4106		       65 25		      adc	t1
     87  4108		       aa		      tax
     88  4109		       bd 03 9d 	      lda	kits,x
     89  410c		       85 25		      sta	t1
     90  410e							; bank (CC14 on the sample channel) when it changes
     91  410e		       a9 04		      lda	#4
     92  4110		       20 68 41 	      jsr	NesChStatus	; mS = CC, sample channel
     93  4113		       a9 00		      lda	#0
     94  4115		       a6 25		      ldx	t1
     95  4117		       10 02		      bpl	.a
     96  4119		       a9 7f		      lda	#127
     97  411b				   .a
     98  411b		       cd 77 c4 	      cmp	dmcBank
     99  411e		       f0 0c		      beq	.note
    100  4120		       8d 77 c4 	      sta	dmcBank
    101  4123		       85 23		      sta	mD2
    102  4125		       a9 0e		      lda	#14
    103  4127		       85 22		      sta	mD1
    104  4129		       20 d0 0c 	      jsr	NesPut
    105  412c				   .note
    106  412c		       a5 21		      lda	mS
    107  412e		       29 0f		      and	#$0F
    108  4130		       85 26		      sta	t2	; channel
    109  4132		       a5 25		      lda	t1	; (no note-off for the last sample: a note-on
    110  4134							;  cuts it anyway, and the hit lands 1 ms sooner)
    111  4134		       29 7f		      and	#$7F
    112  4136		       8d 84 c4 	      sta	dmcNote
    113  4139		       85 22		      sta	mD1
    114  413b		       a5 26		      lda	t2
    115  413d		       09 90		      ora	#$90
    116  413f		       85 21		      sta	mS
    117  4141		       a9 7f		      lda	#127
    118  4143		       85 23		      sta	mD2
    119  4145		       20 d0 0c 	      jsr	NesPut
    120  4148		       a5 24		      lda	t0
    121  414a		       8d 78 c4 	      sta	dmcPrio
    122  414d		       ad 3e c3 	      lda	nowL
    123  4150		       8d 79 c4 	      sta	dmcAt
