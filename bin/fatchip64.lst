    139  3bc3		       a9 00		      lda	#0
    140  3bc5		       8d f4 c8 	      sta	rxCnt
    141  3bc8		       20 ce 3b 	      jsr	MidiInMsg
    142  3bcb		       4c 48 3b 	      jmp	.next
