     39  1caf		       a9 00		      lda	#0
     40  1cb1		       8d 1a c6 	      sta	beatFresh	; (a tempo of your own: a beat starting keeps it)
     41  1cb4		       20 9b 1c 	      jsr	GetTicks
     42  1cb7		       ad 3e c3 	      lda	nowL
     43  1cba		       38		      sec
     44  1cbb		       ed 43 c3 	      sbc	tapLast
     45  1cbe		       85 24		      sta	t0
     46  1cc0		       ad 3f c3 	      lda	nowH
     47  1cc3		       ed 44 c3 	      sbc	tapLast+1
     48  1cc6		       85 25		      sta	t1
     49  1cc8		       ad 3e c3 	      lda	nowL
     50  1ccb		       8d 43 c3 	      sta	tapLast
     51  1cce		       ad 3f c3 	      lda	nowH
     52  1cd1		       8d 44 c3 	      sta	tapLast+1
     53  1cd4		       ad 45 c3 	      lda	tapCount
     54  1cd7		       d0 03		      bne	.had
     55  1cd9		       4c 5d 1d 	      jmp	.first
     56  1cdc				   .had
     57  1cdc							; 240 ms (250 BPM) <= gap < 2000 ms (30 BPM)
     58  1cdc		       a5 25		      lda	t1
     59  1cde		       c9 07		      cmp	#>2000
     60  1ce0		       90 08		      bcc	.lt2000
     61  1ce2		       d0 79		      bne	.first2
     62  1ce4		       a5 24		      lda	t0
     63  1ce6		       c9 d0		      cmp	#<2000
