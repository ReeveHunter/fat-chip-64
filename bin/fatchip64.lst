    469  3acb							; Boy, 2 NES (Chip Lab's chip buttons) - as SHIFT / C= + F1 F3 F5 do
    470  3acb				   DevicesReceived
    471  3acb					      subroutine
    472  3acb		       a2 00		      ldx	#0
