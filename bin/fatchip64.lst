------- FILE main.asm
------- FILE sounds.asm LEVEL 2 PASS 3
      0  31ea					      include	"sounds.asm"
      1  31ea							; Fat Chip 64 - sounds (V), mono (C), Fat Bass, SID effects
      2  31ea							;
      3  31ea							; Each sound is a column in soundtab.asm (made by tools/gen_sounds.py): the
      4  31ea							; SID's envelope, wave, width, filter, detune and effects; the Game Boy's
      5  31ea							; parameters (sent once as CCs: it does its own LFOs and warble); the
      6  31ea							; MidiNES's duty and envelope (CC7, nesenv.asm). FAT, PADS and RAW are
      7  31ea							; v0.11's; the rest are demo versions of the Chip Lab sounds.
      8  31ea							;
      9  31ea							; Each sound has a mono default and a Fat Bass default:
     10  31ea							;   MONO      one note (the last key pressed and still held) on every voice;
     11  31ea							;	       a new key while another is held changes the pitch without a
     12  31ea							;	       new attack (legato; the Game Boy glides if the sound has glide)
     13  31ea							;   FAT BASS  the Game Boy wave and the NES triangle play the lowest note,
     14  31ea							;	       folded by octaves into E1-E2 (BASS_LO-BASS_HI); off, they join
     15  31ea							;	       the other voices
     16  31ea							;
     17  31ea							; SID effects, every 4 ms (FxTick): filter LFO and envelope, pulse-width LFO
     18  31ea							; (each voice its own phase), vibrato (all voices in step unless the sound
     19  31ea							; spreads them), glide; and the duty sequence (SID width steps, NES CC1).
     20  31ea
     21  31ea							; ------------------------------------------------------------ choosing
     22  31ea							; V: next sound (SHIFT+V: previous)
     23  31ea				   SoundKey
     24  31ea					      subroutine
     25  31ea		       20 64 32 	      jsr	SoundRelease	; held notes end with the old sound's settings...
     26  31ed		       ae 94 c3 	      ldx	soundMode
     27  31f0		       ad 2a c3 	      lda	shiftDown
     28  31f3		       d0 09		      bne	.prev
     29  31f5		       e8		      inx
     30  31f6		       e0 13		      cpx	#NUM_SOUNDS
     31  31f8		       90 09		      bcc	.s
