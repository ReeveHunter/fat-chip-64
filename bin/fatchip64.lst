     95  7e04		       0d 2d c5 	      ora	nfxGlide
     96  7e07		       8d 2d c5 	      sta	nfxGlide	; (still gliding)
     97  7e0a		       ca		      dex
     98  7e0b		       ca		      dex
     99  7e0c		       ca		      dex
    100  7e0d		       10 de		      bpl	.v
    101  7e0f							; ---- the NES queue needs room
    102  7e0f		       a5 1a		      lda	nesqHead
    103  7e11		       38		      sec
    104  7e12		       e5 1b		      sbc	nesqTail
    105  7e14		       29 3f		      and	#63
    106  7e16		       c9 08		      cmp	#Q_BACKLOG
    107  7e18		       b0 54		      bcs	.x
    108  7e1a							; ---- the next NES voice: a bend if its effects moved
    109  7e1a		       ad 2e c5 	      lda	nfxRun	; (a few rounds after an effects change)
    110  7e1d		       f0 03		      beq	.r
