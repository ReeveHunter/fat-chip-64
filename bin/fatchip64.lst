     29  6f09		       90 0e		      bcc	.x
     30  6f0b		       a9 00		      lda	#0
     31  6f0d		       99 6c c9 	      sta	clickOn,y
     32  6f10		       be 5b 7e 	      ldx	sidOfs,y
     33  6f13		       b9 32 c3 	      lda	sidGate,y
     34  6f16		       9d 04 d4 	      sta	SID+4,x
     35  6f19				   .x
