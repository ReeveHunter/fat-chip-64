------- FILE main.asm
------- FILE viz.asm LEVEL 2 PASS 3
      0  61cd					      include	"viz.asm"
      1  61cd							; Fat Chip 64 - the visualizers (F7: BARS, GLITCH, back to play), demos
      2  61cd							;
      3  61cd							; BARS:
      4  61cd							; Nine bars, one per voice, in three groups: SID, Game Boy, MidiNES. A new
      5  61cd							; note throws its bar to the top; it falls back to a height set by the
      6  61cd							; note's pitch (higher notes stand taller) while the note sounds, and to
      7  61cd							; nothing when it stops. The tremolo makes the bars breathe. Each bar takes
      8  61cd							; the colour of its note's pitch class (C red ... B white). Kick drums flash
      9  61cd							; the border in the key's colour; row 24 has the sound, the tempo and, while
     10  61cd							; a beat plays, which beat of the bar it's on.
     11  61cd							;
     12  61cd							; One bar is drawn per screen step (about every 8 ms), so the screen stays
     13  61cd							; out of the way of the keyboard and the arp: about 13 frames a second.
     14  61cd							;
     15  61cd							; GLITCH (v0.15): the whole screen, no text. Each new note tears a streak of
     16  61cd							; PETSCII blocks across a row picked by its pitch, in its colour; held notes
     17  61cd							; keep spattering more; runs of the screen get copied over other places
     18  61cd							; (datamosh) and wiped away, so it fills while you play and dissolves when
     19  61cd							; you stop. Kick drums shake the picture (the VIC's fine scroll) and flash
     20  61cd							; the background. VINYL STOP drags it down the screen.
     21  61cd
     22  61cd		       00 15	   VIZ_BOTTOM equ	21	; bars: rows 2-21 (20 rows, 40 half rows)
     23  61cd		       00 16	   VIZ_NAMES  equ	22	; note names
     24  61cd		       00 a0	   VIZ_FULL   equ	160	; reversed space
     25  61cd		       00 62	   VIZ_HALF   equ	98	; lower half block
     26  61cd
