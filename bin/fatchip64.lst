    364  3a29							; ------------------------------------------------------------ SysEx: a patch from Chip Lab (v0.20)
    365  3a29							; (v0.23: F0 7D 46 43 02 m F7 sets the chips on / off: DevicesReceived)
    366  3a29							; F0 7D 46 43 01 PATCH_SIZE, then the patch (PATCH_SIZE bytes, the live patch's layout:
    367  3a29							; tools/gen_patches.py) as two 4-bit halves each, high first, then F7. It
    368  3a29							; arrives in sxBuf; only a complete one goes into the live patch, which then
    369  3a29							; sounds at once (like choosing a sound). Anything else is ignored.
    370  3a29		       00 05	   SX_HEAD    equ	5
    371  3a29		       00 d5	   SX_LEN     equ	SX_HEAD + PATCH_SIZE * 2
    372  3a29
    373  3a29							; A status byte in A (F0-F7); keeps A
    374  3a29				   SysexStatus
    375  3a29					      subroutine
    376  3a29		       c9 f0		      cmp	#$F0
    377  3a2b		       d0 0e		      bne	.end
    378  3a2d		       a2 01		      ldx	#1
    379  3a2f		       8e 4d c7 	      stx	sxOn
    380  3a32		       8e 1d c8 	      stx	sxCmd
    381  3a35		       a2 00		      ldx	#0
    382  3a37		       8e 4e c7 	      stx	sxPos
