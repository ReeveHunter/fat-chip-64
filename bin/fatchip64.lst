------- FILE main.asm
------- FILE arp.asm LEVEL 2 PASS 2
      0  12be					      include	"arp.asm"
      1  12be							; Fat Chip 64 - tempo and arpeggiator
      2  12be							;
      3  12be							; Tempo: B taps it (average of the last four taps; a gap over 2 s starts
      4  12be							; again). Default 120 BPM. The Game Boy gets it as CC 107/108.
      5  12be							;
      6  12be							; Arp (A): OFF -> UNISON -> SPARKLE.
      7  12be							;   UNISON  every voice plays the arp note (a nine-voice stepped unison)
      8  12be							;   SPARKLE two voices arpeggiate over the held chord as a pad: the Game Boy
      9  12be							;	     pulses (panned left / right, so the arp ping-pongs), or the NES
     10  12be							;	     pulses if the Game Boy is off, or SID 1 and 2. Each arp note rings
     11  12be							;	     until its voice's next turn.
     12  12be							; Pattern (S): UP, DOWN, UP-DOWN, RANDOM, AS PLAYED.
     13  12be							; Speed (D): 1/4, 1/8, 1/8T, 1/16, 1/32 of the tempo, or FREE (H slower,
     14  12be							;   J faster; either one also picks FREE).
     15  12be							;
     16  12be							; Steps are timed from the 1 ms ticks and checked on every main loop pass;
     17  12be							; arpNext advances by exactly one step each time, so the arp keeps tempo.
     18  12be
     19  12be							; nowL / nowH = ticks, read in one piece (the IRQ could otherwise bump it
     20  12be							; between the two bytes: $22FF read as $23FF)
     21  12be				   GetTicks
     22  12be					      subroutine
     23  12be		       08		      php
     24  12bf		       78		      sei
     25  12c0		       a5 10		      lda	ticks
     26  12c2		       8d 25 c3 	      sta	nowL
     27  12c5		       a5 11		      lda	ticks+1
     28  12c7		       8d 26 c3 	      sta	nowH
     29  12ca		       28		      plp
     30  12cb		       60		      rts
     31  12cc
     32  12cc							; ------------------------------------------------------------ tempo
