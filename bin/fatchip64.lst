    376  0afe							;------------------------------------------------------------- interrupts
    377  0afe							; Every 1/4 ms: take a MIDI-in byte, feed the ACIA one byte (fast path).
    378  0afe							; Every fourth time (1 ms):
    379  0afe							; count a tick and move paced messages onto the wire.
    380  0afe				   Irq
    381  0afe					      subroutine
    382  0afe		       48		      pha
    383  0aff		       8a		      txa
    384  0b00		       48		      pha
    385  0b01		       ad 0d dc 	      lda	CIA1_ICR	; acknowledge
    386  0b04		       ad 06 de 	      lda	ACIA_STAT	; MIDI in: a received byte? (quick check inline)
    387  0b07		       4a		      lsr
    388  0b08		       90 03		      bcc	.noRx
    389  0b0a		       20 b8 32 	      jsr	RxGot
    390  0b0d				   .noRx
    391  0b0d		       a6 16		      ldx	wireTail
    392  0b0f		       e4 15		      cpx	wireHead
    393  0b11		       f0 0f		      beq	.noByte
    394  0b13		       ad 06 de 	      lda	ACIA_STAT
    395  0b16		       29 02		      and	#ACIA_TDRE
    396  0b18		       f0 08		      beq	.noByte
    397  0b1a		       bd 00 c0 	      lda	wireBuf,x
    398  0b1d		       8d 05 de 	      sta	ACIA_TX
    399  0b20		       e6 16		      inc	wireTail
    400  0b22				   .noByte
    401  0b22		       c6 2d		      dec	subTick
    402  0b24		       10 17		      bpl	.out
    403  0b26		       a9 03		      lda	#3
    404  0b28		       85 2d		      sta	subTick
    405  0b2a		       98		      tya
    406  0b2b		       48		      pha
    407  0b2c		       e6 10		      inc	ticks
    408  0b2e		       d0 02		      bne	.t
    409  0b30		       e6 11		      inc	ticks+1
    410  0b32				   .t
    411  0b32		       20 3d 0c 	      jsr	Schedule
    412  0b35		       20 18 0c 	      jsr	TxByte	; start a just-scheduled message now if the ACIA is free
    413  0b38		       20 b2 32 	      jsr	RxByte	; (again: this pass was long, a byte may be in)
    414  0b3b		       68		      pla
    415  0b3c		       a8		      tay
    416  0b3d				   .out
    417  0b3d		       68		      pla
    418  0b3e		       aa		      tax
    419  0b3f		       68		      pla
    420  0b40		       40		      rti
    421  0b41
    422  0b41							; With the MIDI chip's interrupts (midiIrq, v0.16): the chip interrupts when
    423  0b41							; a byte has come in or the next can go out; the CIA timer ticks each ms.
    424  0b41				   IrqMidi
    425  0b41					      subroutine
    426  0b41		       48		      pha
    427  0b42		       8a		      txa
    428  0b43		       48		      pha
    429  0b44		       ad 06 de 	      lda	ACIA_STAT
    430  0b47		       10 23		      bpl	.tim	; (not the MIDI chip)
    431  0b49		       4a		      lsr		; a byte in?
    432  0b4a		       90 03		      bcc	.tx
    433  0b4c		       20 b8 32 	      jsr	RxGot
    434  0b4f				   .tx
    435  0b4f		       ad 06 de 	      lda	ACIA_STAT
    436  0b52		       29 02		      and	#ACIA_TDRE
    437  0b54		       f0 16		      beq	.tim
    438  0b56		       a6 16		      ldx	wireTail
    439  0b58		       e4 15		      cpx	wireHead
    440  0b5a		       f0 0b		      beq	.quiet
    441  0b5c		       bd 00 c0 	      lda	wireBuf,x
    442  0b5f		       8d 05 de 	      sta	ACIA_TX
    443  0b62		       e6 16		      inc	wireTail
    444  0b64		       4c 6c 0b 	      jmp	.tim
    445  0b67				   .quiet
    446  0b67		       a9 96		      lda	#ACIA_MODE_RX	; nothing to send: no more "ready" interrupts
    447  0b69		       8d 04 de 	      sta	ACIA_CTRL
    448  0b6c				   .tim
    449  0b6c		       ad 0d dc 	      lda	CIA1_ICR	; the 1 ms tick?
    450  0b6f		       4a		      lsr
    451  0b70		       90 16		      bcc	.out
    452  0b72		       98		      tya
    453  0b73		       48		      pha
    454  0b74		       e6 10		      inc	ticks
    455  0b76		       d0 02		      bne	.t
    456  0b78		       e6 11		      inc	ticks+1
    457  0b7a				   .t
    458  0b7a		       20 3d 0c 	      jsr	Schedule
    459  0b7d		       20 b2 32 	      jsr	RxByte	; (a long tick: a byte may be waiting, and
    460  0b80		       20 18 0c 	      jsr	TxByte	;  the MIDI chip holds only one)
    461  0b83		       20 b2 32 	      jsr	RxByte
    462  0b86		       68		      pla
    463  0b87		       a8		      tay
    464  0b88				   .out
    465  0b88		       68		      pla
    466  0b89		       aa		      tax
    467  0b8a		       68		      pla
    468  0b8b		       40		      rti
    469  0b8c
    470  0b8c							; RESTORE: the only NMI source. Count presses; the main loop acts on them.
    471  0b8c							; (A MIDI chip wired to NMI instead could fire one during MidiIrqTest: that
    472  0b8c							; isn't a press.)
    473  0b8c				   Nmi
    474  0b8c					      subroutine
    475  0b8c		       48		      pha
    476  0b8d		       ad 06 de 	      lda	ACIA_STAT
    477  0b90		       10 07		      bpl	.r
    478  0b92		       a9 16		      lda	#ACIA_MODE
    479  0b94		       8d 04 de 	      sta	ACIA_CTRL
    480  0b97		       68		      pla
    481  0b98		       40		      rti
    482  0b99				   .r
    483  0b99		       ad 0d dd 	      lda	CIA2_ICR	; acknowledge anything CIA 2 holds, so the NMI
    484  0b9c							; line is free for the next RESTORE edge
    485  0b9c		       e6 1d		      inc	nmiCount
    486  0b9e		       a5 10		      lda	ticks
    487  0ba0		       85 1e		      sta	nmiTick
    488  0ba2		       a5 11		      lda	ticks+1
    489  0ba4		       85 1f		      sta	nmiTick+1
    490  0ba6		       68		      pla
    491  0ba7		       40		      rti
    492  0ba8
------- FILE midi.asm LEVEL 2 PASS 3
      0  0ba8					      include	"midi.asm"
      1  0ba8							; Fat Chip 64 - MIDI out
      2  0ba8							;
      3  0ba8							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0ba8							; at most one message per device onto the wire buffer, no sooner than that
      5  0ba8							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0ba8							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0ba8							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0ba8							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0ba8							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0ba8
     11  0ba8				   MidiInit
     12  0ba8					      subroutine
     13  0ba8		       a9 03		      lda	#ACIA_RESET
     14  0baa		       8d 04 de 	      sta	ACIA_CTRL
     15  0bad		       a9 16		      lda	#ACIA_MODE
     16  0baf		       8d 04 de 	      sta	ACIA_CTRL
     17  0bb2							; (fall into the test)
     18  0bb2
     19  0bb2							; Does the MIDI chip's interrupt reach the C64? (v0.16) Ask for one (the
     20  0bb2							; transmit-empty interrupt asks at once) with the timer quiet: if it comes,
     21  0bb2							; the MIDI chip interrupts when a byte comes in or can go out (IrqMidi) and
     22  0bb2							; the timer only ticks the ms. If not, poll it 4000 times a second (Irq) as
     23  0bb2							; before. Interrupts are off when this is called.
     24  0bb2				   MidiIrqTest
     25  0bb2					      subroutine
     26  0bb2		       a9 7f		      lda	#$7F	; the CIA's interrupts off
     27  0bb4		       8d 0d dc 	      sta	CIA1_ICR
     28  0bb7		       ad 0d dc 	      lda	CIA1_ICR
     29  0bba		       a9 02		      lda	#<IrqTest
     30  0bbc		       8d fe ff 	      sta	$FFFE
     31  0bbf		       a9 0c		      lda	#>IrqTest
     32  0bc1		       8d ff ff 	      sta	$FFFF
     33  0bc4		       a9 00		      lda	#0
     34  0bc6		       85 2f		      sta	midiIrq
     35  0bc8		       a9 b6		      lda	#ACIA_MODE_TX
     36  0bca		       8d 04 de 	      sta	ACIA_CTRL
     37  0bcd		       58		      cli
     38  0bce		       a2 00		      ldx	#0
     39  0bd0				   .w
     40  0bd0		       ca		      dex
     41  0bd1		       d0 fd		      bne	.w
     42  0bd3		       78		      sei
     43  0bd4		       a6 2f		      ldx	midiIrq
     44  0bd6		       bd 0e 0c 	      lda	midiCtl,x
     45  0bd9		       8d 04 de 	      sta	ACIA_CTRL
     46  0bdc		       bd 10 0c 	      lda	irqLo,x
     47  0bdf		       8d fe ff 	      sta	$FFFE
     48  0be2		       bd 12 0c 	      lda	irqHi,x
     49  0be5		       8d ff ff 	      sta	$FFFF
     50  0be8		       bd 14 0c 	      lda	latchLo,x
     51  0beb		       8d 04 dc 	      sta	CIA1_TALO
     52  0bee		       bd 16 0c 	      lda	latchHi,x
     53  0bf1		       8d 05 dc 	      sta	CIA1_TAHI
     54  0bf4		       a9 11		      lda	#$11	; start, force load, continuous
     55  0bf6		       8d 0e dc 	      sta	CIA1_CRA
     56  0bf9		       ad 0d dc 	      lda	CIA1_ICR
     57  0bfc		       a9 81		      lda	#$81	; timer A interrupt on
     58  0bfe		       8d 0d dc 	      sta	CIA1_ICR
     59  0c01		       60		      rts
     60  0c02				   IrqTest
     61  0c02		       48		      pha
     62  0c03		       a9 01		      lda	#1
     63  0c05		       85 2f		      sta	midiIrq
     64  0c07		       a9 16		      lda	#ACIA_MODE	; (quiet again)
     65  0c09		       8d 04 de 	      sta	ACIA_CTRL
     66  0c0c		       68		      pla
     67  0c0d		       40		      rti
     68  0c0e		       16 96	   midiCtl    .byte.b	ACIA_MODE, ACIA_MODE_RX
     69  0c10		       fe 41	   irqLo      .byte.b	<Irq, <IrqMidi
     70  0c12		       0a 0b	   irqHi      .byte.b	>Irq, >IrqMidi
     71  0c14		       ff ff	   latchLo    .byte.b	<TICK_LATCH, <TICK_LATCH_MS
     72  0c16		       00 03	   latchHi    .byte.b	>TICK_LATCH, >TICK_LATCH_MS
