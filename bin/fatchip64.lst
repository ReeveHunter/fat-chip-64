------- FILE midiin.asm LEVEL 2 PASS 3
      0  3880					      include	"midiin.asm"
      1  3880							; Fat Chip 64 - MIDI in (Kerberos MIDI IN), v0.11
      2  3880							;
      3  3880							; The IRQ (and the main loop's TxService) move each received byte into rxBuf.
      4  3880							; The main loop parses them (running status; realtime and system bytes are
      5  3880							; skipped) and plays incoming notes exactly like overlay keys: through the
      6  3880							; notes mode, latch, arp and K + note.
      7  3880							;
      8  3880							; Channels 1-11 are played (any of them, so the keytar's key channel can be
      9  3880							; anything up to 11). 12-16 are ignored: the Yamaha SHS-10 sends its
     10  3880							; accompaniment there (chords 12-14, bass 15, drums 16).
     11  3880							;
     12  3880							; H / J move incoming notes down / up an octave (-4..+4). A held note keeps
     13  3880							; its pitch until its note-off, so changing it mid-note can't hang anything.
     14  3880							;
     15  3880							; Note indexes: 0-23 are the overlay keys (note = index + octBase); 24-31 are
     16  3880							; MIDI slots, each holding one incoming note (midiNote = the note it plays,
     17  3880							; midiSrc = the note number that came in, for the note-off). Nothing from
     18  3880							; MIDI in is passed on to the Game Boy or NES.
     19  3880
     20  3880							; IRQ / main loop (interrupts off): take a received byte if there is one.
     21  3880							; Uses A, X.
     22  3880							; v0.13: clocks ($F8) aren't stored: counted here, every 24th (a beat) stamped
     23  3880							; with the time; a Start ($FA) makes the next clock a beat.
     24  3880				   RxByte
     25  3880					      subroutine
     26  3880		       ad 06 de 	      lda	ACIA_STAT
     27  3883		       4a		      lsr		; RDRF -> carry
     28  3884		       90 2b		      bcc	.x
     29  3886				   RxGot
     30  3886		       ad 07 de 	      lda	ACIA_RX
     31  3889		       c9 f8		      cmp	#$F8
     32  388b		       f0 25		      beq	.clk
     33  388d		       c9 fa		      cmp	#$FA
     34  388f		       d0 0e		      bne	.buf
     35  3891		       a2 17		      ldx	#23	; Start: the next clock is beat 1
     36  3893		       8e ed c5 	      stx	clkPhase
     37  3896		       8e f5 c5 	      stx	clkSkip	; (and its period isn't a beat: set here, before
     38  3899							;  the main loop could measure it)
     39  3899		       ae ee c5 	      ldx	clkBeat
     40  389c		       8e 00 c6 	      stx	clkStartBeat
     41  389f				   .buf
     42  389f		       ae 29 c4 	      ldx	rxHead
     43  38a2		       9d e9 c3 	      sta	rxBuf,x
     44  38a5		       e8		      inx
     45  38a6		       8a		      txa
     46  38a7		       29 3f		      and	#63
     47  38a9		       cd 2a c4 	      cmp	rxTail
     48  38ac		       f0 03		      beq	.x	; full: dropped
     49  38ae		       8d 29 c4 	      sta	rxHead
     50  38b1				   .x
     51  38b1		       60		      rts
     52  38b2				   .clk
     53  38b2		       ee e9 c5 	      inc	clkCount
     54  38b5		       ae ed c5 	      ldx	clkPhase
     55  38b8		       e8		      inx
     56  38b9		       e0 18		      cpx	#24
     57  38bb		       90 1b		      bcc	.ph
     58  38bd		       a5 10		      lda	ticks
     59  38bf		       8d f0 c5 	      sta	clkAtL
     60  38c2		       a5 11		      lda	ticks+1
     61  38c4		       8d f1 c5 	      sta	clkAtH
     62  38c7		       a5 2d		      lda	subTick
     63  38c9		       a6 2f		      ldx	midiIrq	; (1 ms ticks: the timer's high byte counts 3-0
     64  38cb		       f0 03		      beq	.q	;  through the ms, like subTick)
     65  38cd		       ad 05 dc 	      lda	CIA1_TAHI
     66  38d0				   .q
     67  38d0		       8d f2 c5 	      sta	clkAtS
     68  38d3		       ee ee c5 	      inc	clkBeat
     69  38d6		       a2 00		      ldx	#0
     70  38d8				   .ph
     71  38d8		       8e ed c5 	      stx	clkPhase
     72  38db		       60		      rts
