------- FILE main.asm
------- FILE sync.asm LEVEL 2 PASS 3
      0  567a					      include	"sync.asm"
      1  567a							; Fat Chip 64 - device sync (v0.13): the keytar (Yamaha SHS-10) and Synthcart
      2  567a							;
      3  567a							; Menu, DEVICE SYNC (defaults first):
      4  567a							;   TEMPO FROM      KEYTAR / OWN / SYNTHCART
      5  567a							;		     KEYTAR: its MIDI clock (24 a beat, sent even while stopped)
      6  567a							;		     sets the tempo, averaged over beats (the clock jitters about
      7  567a							;		     4 ms). Without a clock for 300 ms, Fat Chip's own tempo
      8  567a							;		     (B taps) is back. SYNTHCART: taps and beat tempos snap to
      9  567a							;		     Synthcart's ten NTSC tempos (whole Atari frames a beat).
     10  567a							;   START/STOP      KEYTAR / OWN: its Start and Stop start / stop the beat demo
     11  567a							;		     (a start waits for the next beat clock: step 1 lands on it)
     12  567a							;   RHYTHM BUTTONS  PICK BEAT / IGNORE: its style (Program Change on channel 16)
     13  567a							;		     picks a beat demo (styleBeat)
     14  567a							;   DRUM NOTES      IGNORE / PLAY: its drum notes on the MidiNES (drums.asm)
     15  567a							;   VOICE BUTTONS   PICK SOUND / IGNORE: its voice (Program Change 0-24 on the
     16  567a							;		     key channel) picks a sound (voiceSound)
     17  567a							;   WHEEL	     BEND / OFF: +-BEND RANGE on everything (bend.asm)
     18  567a							;   VIBRATO / PORTAMENTO / SUSTAIN BUTTON  an action each (CC 1 / 65 / 64,
     19  567a							;		     127 held, 0 let go), the same list as SPACE (actions below)
     20  567a							;
     21  567a							; The IRQ (RxByte) counts clocks itself and stamps every 24th (clkAt*, to the
     22  567a							; 1/4 ms); a Start makes the next clock a beat.
     23  567a
     24  567a		       00 00	   TEMPO_KEYTAR equ	0
     25  567a		       00 01	   TEMPO_OWN  equ	1
     26  567a		       00 02	   TEMPO_SC   equ	2
     27  567a		       01 2c	   CLK_ALIVE  equ	300	; ms: no clock for this long = not following
     28  567a
     29  567a
     30  567a
     31  567a							; ------------------------------------------------------------ clock
     32  567a							; Main loop, every pass
