    125  7a1d		       f0 1f		      beq	.x
    126  7a1f		       38		      sec
    127  7a20		       ed a6 ca 	      sbc	sndRdrop
    128  7a23		       20 3f 7a 	      jsr	NoteClamp
    129  7a26		       20 d7 21 	      jsr	SidPitch
    130  7a29		       a5 28		      lda	ptr
    131  7a2b		       99 68 c8 	      sta	sidTgtLo,y
    132  7a2e		       a5 29		      lda	ptr+1
    133  7a30		       99 6b c8 	      sta	sidTgtHi,y
    134  7a33		       ad a7 ca 	      lda	sndRdropK
    135  7a36		       99 6e cd 	      sta	sK,y
    136  7a39		       a9 01		      lda	#1
    137  7a3b		       99 72 cd 	      sta	rdOn,y
    138  7a3e				   .x
    139  7a3e		       60		      rts
