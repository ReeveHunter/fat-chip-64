    411  0b3c							; With the MIDI chip's interrupts (midiIrq, v0.16): the chip interrupts when
    412  0b3c							; a byte has come in or the next can go out; the CIA timer ticks each ms.
    413  0b3c				   IrqMidi
    414  0b3c					      subroutine
    415  0b3c		       48		      pha
    416  0b3d		       8a		      txa
    417  0b3e		       48		      pha
    418  0b3f		       ad 06 de 	      lda	ACIA_STAT
    419  0b42		       10 23		      bpl	.tim	; (not the MIDI chip)
    420  0b44		       4a		      lsr		; a byte in?
    421  0b45		       90 03		      bcc	.tx
    422  0b47		       20 6b 3a 	      jsr	RxGot
    423  0b4a				   .tx
    424  0b4a		       ad 06 de 	      lda	ACIA_STAT
    425  0b4d		       29 02		      and	#ACIA_TDRE
    426  0b4f		       f0 16		      beq	.tim
