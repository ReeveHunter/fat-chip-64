------- FILE nesenv.asm LEVEL 2 PASS 3
      0  27de					      include	"nesenv.asm"
      1  27de							; Fat Chip 64 - MidiNES envelopes (PADS sound)
      2  27de							;
      3  27de							; The NES Lab (2026-11-01) showed CC7 changes the volume of a sounding note,
      4  27de							; so in PADS the NES pulses get a software envelope: CC7 to 0, note-on, then
      5  27de							; CC7 stepped through the NES's 16 levels on a 10 ms clock:
      6  27de							;   attack 0.6 s to 15, decay 0.4 s to 11, sustain 11, release 2 s to 0
      7  27de							; (Reeve's Lab settings). The note-off waits until the release reaches 0.
      8  27de							; (Off in PADS since v0.09: kept for a future mono bass synth sound.)
      9  27de							; The triangle has no volume, so its release is a pitch drop (Reeve's
     10  27de							; plugin trick): -24 semitones over 250 ms, slow at first, a bend every
     11  27de							; 4 ms (8 ms while the Game Boy is on), then the note-off and the bend back to centre. The drop stops at
     12  27de							; the triangle's lowest note (MIDI 21: its 11-bit timer can't go lower and
     13  27de							; would wrap to a high pitch).
     14  27de							; FAT sound: no envelopes (CC7 full). Mute, panic and device off cut at once.
     15  27de
     16  27de							; v0.12: the envelope comes from the sound (envAtkV, envDecV, envSusV,
     17  27de							; envPeakV, envRelV; PADS keeps 64 / 26 / 11 / 15 / 5), every sound but FAT
     18  27de							; and RAW uses it (it also sets the pulses' loudness), and the sound may add
     19  27de							; a tremolo: the level sent is level - level x amount / 16, the amount
     20  27de							; following a triangle (or square) LFO on the 10 ms clock, both pulses in step.
     21  27de		       00 04	   TRI_GAP    equ	4	; ms between drop bends (Reeve: 4 ms is smoothest)
     22  27de		       00 08	   TRI_GAP_GB equ	8	; while the Game Boy is on: its adapter forwards the
     23  27de							; NES channels too, and can't take a bend every 4 ms
     24  27de		       00 15	   TRI_FLOOR  equ	21	; lowest triangle note
     25  27de		       00 00	   TRI_DROP_PADS equ	0	; the drop is for a future mono bass sound, not PADS
     26  27de
     27  27de							; voice -> envelope slot (NES pulse 1 = v2, pulse 2 = v5)
     28  27de		       ff ff 00 ff*vEnvSlot   .byte.b	$FF,$FF,0, $FF,$FF,1, $FF,$FF,$FF
     29  27e7		       02 05	   slotVoice  .byte.b	2,5
     30  27e9
     31  27e9							; VoiceSet, a NES voice going silent: C set if a soft release took over (the
     32  27e9							; note keeps sounding for now). X = voice (= t0).
     33  27e9				   NesSoftRelease
     34  27e9					      subroutine
     35  27e9		       4c ee 27 	      jmp	.go
     36  27ec				   .nope
     37  27ec		       18		      clc
     38  27ed		       60		      rts
     39  27ee				   .go
     40  27ee		       ad 90 c3 	      lda	muteNow
     41  27f1		       0d cb c3 	      ora	hardCut
     42  27f4		       d0 f6		      bne	.nope
     43  27f6		       ad 27 c3 	      lda	devOn+DEV_NES
     44  27f9		       f0 f1		      beq	.nope
     45  27fb		       bd f5 7d 	      lda	vDev,x
     46  27fe		       c9 02		      cmp	#DEV_NES
     47  2800		       d0 ea		      bne	.nope
     48  2802		       bd 97 c3 	      lda	vOut,x
     49  2805		       c9 ff		      cmp	#NO_NOTE
     50  2807		       f0 e3		      beq	.nope
     51  2809		       ad 47 c4 	      lda	nesEnvOn
     52  280c		       f0 78		      beq	.fo	; (no envelope: BEND OUT's fall-off, if any)
     53  280e		       bc de 27 	      ldy	vEnvSlot,x
     54  2811		       30 41		      bmi	.tri
     55  2813							; pulse: release from the current level; step = level x factor / 4 + 1
     56  2813							; (8.8 per 10 ms), so any level fades out in 10.24 s / factor (PADS: 5,
     57  2813							; about 2 s). Factor 0: no release, cut.
     58  2813		       ad 6a c4 	      lda	envRelV
     59  2816		       f0 6e		      beq	.fo
