    116  0dc2							; Z set if key code A is a modifier. Keeps A.
    117  0dc2				   IsModifier
    118  0dc2		       c9 88		      cmp	#K_LSHIFT
    119  0dc4		       f0 0a		      beq	.y
    120  0dc6		       c9 89		      cmp	#K_RSHIFT
    121  0dc8		       f0 06		      beq	.y
    122  0dca		       c9 8c		      cmp	#K_CTRL
    123  0dcc		       f0 02		      beq	.y
    124  0dce		       c9 9a		      cmp	#K_K
    125  0dd0				   .y
