    126  2b17		       4c b7 2a 	      jmp	.next
    127  2b1a				   .second
    128  2b1a		       8d 2a c4 	      sta	rxD2
    129  2b1d		       a9 00		      lda	#0
    130  2b1f		       8d 28 c4 	      sta	rxCnt
    131  2b22		       20 28 2b 	      jsr	MidiInMsg
