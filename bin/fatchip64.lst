    124  0b06		       bd c0 c1 	      lda	nesqS,x
    125  0b09		       bc 40 c2 	      ldy	nesqD2,x
    126  0b0c		       84 2c		      sty	irqT
    127  0b0e		       bc 00 c2 	      ldy	nesqD1,x
    128  0b11		       20 41 0b 	      jsr	WireMsg
    129  0b14		       a5 1b		      lda	nesqTail
    130  0b16		       18		      clc
    131  0b17		       69 01		      adc	#1
    132  0b19		       29 3f		      and	#63
    133  0b1b		       85 1b		      sta	nesqTail
