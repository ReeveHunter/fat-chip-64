    301  2fb8							; ADVANCED SOUND values (the menu's choices index these). SID vibrato depth
    302  2fb8							; x 1/4096 of the frequency (61 = 1/4 semitone), rate x 1/262 Hz, delay in
    303  2fb8							; 4 ms; glide 1/2^k of the way per 4 ms; tremolo depth of 15, rate x 1/655
    304  2fb8							; Hz; SID detune (8 = FAT's, about 7 cents); Game Boy warble.
    305  2fb8		       1e 3d 5b 7a uVibDepT   .byte.b	30, 61, 91, 122
    306  2fbc		       0c 12 18 1e*uVibRateLo .byte.b	<524, <786, <1048, <1310, <1572, <1834, <2096
    307  2fc3		       02 03 04 05*uVibRateHi .byte.b	>524, >786, >1048, >1310, >1572, >1834, >2096
    308  2fca		       00 19 3f 7d*uVibDelT   .byte.b	0, 25, 63, 125, 250
    309  2fcf		       03 04 05 06 uGlideT    .byte.b	3, 4, 5, 6
    310  2fd3		       04 07 0a 0f uTremDepT  .byte.b	4, 7, 10, 15
    311  2fd7		       1f 3d 5c 7b*uTremRL    .byte.b	<1311, <2621, <3932, <5243, <6554
    312  2fdc		       05 0a 0f 14*uTremRH    .byte.b	>1311, >2621, >3932, >5243, >6554
    313  2fe1		       04 08 0c 10 uDetT      .byte.b	4, 8, 12, 16
    314  2fe5		       18 38 64    uWarbT     .byte.b	24, 56, 100
    315  2fe8							; ... and the Game Boy's CCs for them (LFO depth CC 1, rate CC 76, delay
    316  2fe8							; CC 79, glide CC 5, detune +- from 64 on CC 94)
    317  2fe8		       10 18 1c 20 gbVibDepT  .byte.b	16, 24, 28, 32
