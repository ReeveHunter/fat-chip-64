------- FILE midi.asm LEVEL 2 PASS 2
      0  0a4c					      include	"midi.asm"
      1  0a4c							; Fat Chip 64 - MIDI out
      2  0a4c							;
      3  0a4c							; Each device has its own queue of 3-byte messages. Every 1 ms the IRQ moves
      4  0a4c							; at most one message per device onto the wire buffer, no sooner than that
      5  0a4c							; device's gap (GB_GAP / NES_GAP) after its previous one. The Game Boy link
      6  0a4c							; drops messages when MIDI arrives at full speed (measured on Reeve's
      7  0a4c							; Teensyboy Pro: 1 per 2 ms is clean, 1 per 1 ms loses), so its queue is
      8  0a4c							; paced, and the shared link budget (linkLoad) covers NES traffic too.
      9  0a4c							; The wire uses running status. The main loop and the IRQ both feed the ACIA.
     10  0a4c
     11  0a4c				   MidiInit
     12  0a4c					      subroutine
     13  0a4c		       a9 03		      lda	#ACIA_RESET
     14  0a4e		       8d 04 de 	      sta	ACIA_CTRL
     15  0a51		       a9 16		      lda	#ACIA_MODE
     16  0a53		       8d 04 de 	      sta	ACIA_CTRL
     17  0a56		       60		      rts
     18  0a57
     19  0a57							; IRQ: send one wire byte if the ACIA is ready.
     20  0a57				   TxByte
     21  0a57					      subroutine
     22  0a57		       a6 16		      ldx	wireTail
     23  0a59		       e4 15		      cpx	wireHead
     24  0a5b		       f0 0f		      beq	.done
     25  0a5d		       ad 06 de 	      lda	ACIA_STAT
     26  0a60		       29 02		      and	#ACIA_TDRE
     27  0a62		       f0 08		      beq	.done
     28  0a64		       bd 00 c0 	      lda	wireBuf,x
     29  0a67		       8d 05 de 	      sta	ACIA_TX
     30  0a6a		       e6 16		      inc	wireTail
     31  0a6c				   .done
     32  0a6c		       60		      rts
     33  0a6d
     34  0a6d							; Main loop: same, with interrupts off around it.
     35  0a6d				   TxService
     36  0a6d					      subroutine
     37  0a6d		       08		      php
     38  0a6e		       78		      sei
     39  0a6f		       20 57 0a 	      jsr	TxByte
     40  0a72		       20 50 23 	      jsr	RxByte
     41  0a75		       28		      plp
     42  0a76		       60		      rts
     43  0a77
     44  0a77							; IRQ: pace device queues onto the wire.
     45  0a77							;
     46  0a77							; "Due" uses the low byte only: a queue may send when (next - ticks) is 0 or
     47  0a77							; more than its gap, i.e. next is now or in the past. (v0.1 compared 16-bit
     48  0a77							; times as signed numbers, so after 33 s of silence every queue froze for
     49  0a77							; another 33 s, filled up and dropped messages: the hung Game Boy notes.)
     50  0a77							;
     51  0a77							; When the Game Boy is on, everything on the wire also passes through the
     52  0a77							; Teensyboy (it forwards channels 1-15 to the Game Boy, NES ones too, about
     53  0a77							; 0.5 ms per byte, with a 64-byte buffer). linkLoad estimates how many bytes
     54  0a77							; are waiting in it: +3 per message, -1.5 per ms. Nothing goes out while it
     55  0a77							; is over LINK_MAX, so bursts are fine and long streams slow to 2 ms per
     56  0a77							; message, the rate measured clean.
     57  0a77				   Schedule
     58  0a77					      subroutine
     59  0a77		       ad 26 c3 	      lda	devOn+DEV_GB
     60  0a7a		       f0 10		      beq	.gb
     61  0a7c		       a5 2e		      lda	linkLoad	; drain: 1 then 2 bytes on alternate ms
     62  0a7e		       f0 0c		      beq	.gb
     63  0a80		       c6 2e		      dec	linkLoad
     64  0a82		       f0 08		      beq	.gb
     65  0a84		       a5 10		      lda	ticks
     66  0a86		       29 01		      and	#1
     67  0a88		       f0 02		      beq	.gb
     68  0a8a		       c6 2e		      dec	linkLoad
     69  0a8c				   .gb
     70  0a8c							; ---- Game Boy
     71  0a8c		       a5 18		      lda	gbqTail
     72  0a8e		       c5 17		      cmp	gbqHead
     73  0a90		       f0 36		      beq	.nes
     74  0a92		       a5 19		      lda	gbNext
     75  0a94		       38		      sec
     76  0a95		       e5 10		      sbc	ticks
     77  0a97		       f0 04		      beq	.gbDue
     78  0a99		       c9 04		      cmp	#GB_GAP+1
     79  0a9b		       90 2b		      bcc	.nes	; 1..GB_GAP ms to go
     80  0a9d				   .gbDue
     81  0a9d							; only onto an empty wire, so the gap holds on the cable itself (NES
     82  0a9d							; bytes already waiting would otherwise delay this one and squeeze it
     83  0a9d							; against the next). While a Game Boy message is due, the NES doesn't
     84  0a9d							; start one (v0.11), so NES bursts fill the Game Boy's gaps instead of
     85  0a9d							; holding its notes back.
     86  0a9d		       a5 15		      lda	wireHead
     87  0a9f		       c5 16		      cmp	wireTail
     88  0aa1		       d0 65		      bne	.done	; (and the NES waits too: the Game Boy goes first)
     89  0aa3		       20 09 0b 	      jsr	LinkRoom
     90  0aa6		       90 20		      bcc	.nes
     91  0aa8		       a6 18		      ldx	gbqTail
     92  0aaa		       bd 00 c1 	      lda	gbqS,x
     93  0aad		       bc 80 c1 	      ldy	gbqD2,x
     94  0ab0		       84 2c		      sty	irqT
     95  0ab2		       bc 40 c1 	      ldy	gbqD1,x
     96  0ab5		       20 25 0b 	      jsr	WireMsg
     97  0ab8		       a5 18		      lda	gbqTail
     98  0aba		       18		      clc
     99  0abb		       69 01		      adc	#1
    100  0abd		       29 3f		      and	#63
    101  0abf		       85 18		      sta	gbqTail
    102  0ac1		       a5 10		      lda	ticks
    103  0ac3		       18		      clc
    104  0ac4		       69 03		      adc	#GB_GAP
    105  0ac6		       85 19		      sta	gbNext
    106  0ac8				   .nes
    107  0ac8		       20 50 23 	      jsr	RxByte	; (MIDI in: a long IRQ mustn't miss a byte)
    108  0acb		       a5 1b		      lda	nesqTail
    109  0acd		       c5 1a		      cmp	nesqHead
    110  0acf		       f0 37		      beq	.done
    111  0ad1		       a5 1c		      lda	nesNext
    112  0ad3		       38		      sec
    113  0ad4		       e5 10		      sbc	ticks
    114  0ad6		       f0 04		      beq	.nesDue
