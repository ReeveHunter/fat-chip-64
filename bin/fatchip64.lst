------- FILE screen.asm LEVEL 2 PASS 3
      0  5763					      include	"screen.asm"
      1  5763							; Fat Chip 64 - screen
      2  5763							;
      3  5763							;  row 0      header
      4  5763							;  row 2      sound, POLY / MONO, Fat Bass
      5  5763							;  rows 4-6   SID, Game Boy, MidiNES: on / off or channels, the three notes
      6  5763							;	       each plays (row 7: a channel overlap warning)
      7  5763							;  row 9      key, notes mode, latch
      8  5763							;  row 10     arp
      9  5763							;  row 12     tempo, beat, mute
     10  5763							;  row 13     SPACE's action, octave (the lowest key)
     11  5763							;  row 15     held notes
     12  5763							;  row 16     MIDI in
     13  5763							;  row 24     F keys
     14  5763
     15  5763							; Print the 0-terminated ASCII string at (ptr) to screen row Y, column X.
     16  5763							; Letters become screen codes; bit 7 of t2 reverses.
     17  5763				   PrintAt
     18  5763					      subroutine
     19  5763		       20 7b 57 	      jsr	ScreenAddr
     20  5766		       a0 00		      ldy	#0
     21  5768				   .c
     22  5768		       b1 28		      lda	(ptr),y
     23  576a		       f0 0e		      beq	.done
     24  576c		       c9 40		      cmp	#64
     25  576e		       90 03		      bcc	.noLetter
     26  5770		       38		      sec
     27  5771		       e9 40		      sbc	#64
     28  5773				   .noLetter
     29  5773		       05 26		      ora	t2
     30  5775		       91 2a		      sta	(ptr2),y
     31  5777		       c8		      iny
     32  5778		       d0 ee		      bne	.c
     33  577a				   .done
     34  577a		       60		      rts
     35  577b
     36  577b							; ptr2 = SCREEN + 40*Y + X (row table: no loop)
     37  577b				   ScreenAddr
     38  577b					      subroutine
     39  577b		       8a		      txa
     40  577c		       18		      clc
     41  577d		       79 8c 57 	      adc	rowAddrLo,y
     42  5780		       85 2a		      sta	ptr2
     43  5782		       b9 a5 57 	      lda	rowAddrHi,y
     44  5785		       69 00		      adc	#0
     45  5787		       85 2b		      sta	ptr2+1
     46  5789		       a0 00		      ldy	#0	; (callers expect Y = 0, as the old loop left it)
     47  578b		       60		      rts
     48  578c				   rowAddrLo
     49  578c		       00 28 50 78*	      .byte.b	<(SCREEN+0),<(SCREEN+40),<(SCREEN+80),<(SCREEN+120),<(SCREEN+160),<(SCREEN+200),<(SCREEN+240),<(SCREEN+280),<(SCREEN+320),<(SCREEN+360),<(SCREEN+400),<(SCREEN+440),<(SCREEN+480),<(SCREEN+520),<(SCREEN+560),<(SCREEN+600),<(SCREEN+640),<(SCREEN+680),<(SCREEN+720),<(SCREEN+760),<(SCREEN+800),<(SCREEN+840),<(SCREEN+880),<(SCREEN+920),<(SCREEN+960)
     50  57a5				   rowAddrHi
     51  57a5		       04 04 04 04*	      .byte.b	>(SCREEN+0),>(SCREEN+40),>(SCREEN+80),>(SCREEN+120),>(SCREEN+160),>(SCREEN+200),>(SCREEN+240),>(SCREEN+280),>(SCREEN+320),>(SCREEN+360),>(SCREEN+400),>(SCREEN+440),>(SCREEN+480),>(SCREEN+520),>(SCREEN+560),>(SCREEN+600),>(SCREEN+640),>(SCREEN+680),>(SCREEN+720),>(SCREEN+760),>(SCREEN+800),>(SCREEN+840),>(SCREEN+880),>(SCREEN+920),>(SCREEN+960)
     52  57be
     53  57be							; macro-ish helper: PRINT row, col, label
     54  57be					      mac	print
     55  57be					      ldx	#{2}
     56  57be					      ldy	#{1}
     57  57be					      lda	#<{3}
     58  57be					      sta	ptr
     59  57be					      lda	#>{3}
     60  57be					      sta	ptr+1
     61  57be					      jsr	PrintAt
     62  57be					      endm
     63  57be
     64  57be							; Put the character in A at column X of the row in ptr2 (ScreenAddr first).
