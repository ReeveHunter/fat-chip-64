     22  67db		       f0 19		      beq	.x
     23  67dd		       ad ff c5 	      lda	vibDepth
     24  67e0		       0d 2d c5 	      ora	nfxGlide
     25  67e3		       0d 2e c5 	      ora	nfxRun
     26  67e6		       f0 0e		      beq	.x
     27  67e8		       a5 10		      lda	ticks
     28  67ea		       38		      sec
     29  67eb		       ed 29 c5 	      sbc	nfxLast
     30  67ee		       c9 08		      cmp	#NFX_EVERY
     31  67f0		       a9 00		      lda	#0
     32  67f2		       90 02		      bcc	.x
     33  67f4		       a9 01		      lda	#1
     34  67f6				   .x
     35  67f6		       60		      rts
