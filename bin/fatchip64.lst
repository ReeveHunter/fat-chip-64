    376  0afe							;------------------------------------------------------------- interrupts
    377  0afe							; Every 1/4 ms: take a MIDI-in byte, feed the ACIA one byte (fast path).
    378  0afe							; Every fourth time (1 ms):
    379  0afe							; count a tick and move paced messages onto the wire.
    380  0afe				   Irq
    381  0afe					      subroutine
    382  0afe		       48		      pha
    383  0aff		       8a		      txa
    384  0b00		       48		      pha
    385  0b01		       ad 0d dc 	      lda	CIA1_ICR	; acknowledge
    386  0b04		       ad 06 de 	      lda	ACIA_STAT	; MIDI in: a received byte? (quick check inline)
    387  0b07		       4a		      lsr
    388  0b08		       90 03		      bcc	.noRx
    389  0b0a		       20 db 33 	      jsr	RxGot
    390  0b0d				   .noRx
    391  0b0d		       a6 16		      ldx	wireTail
    392  0b0f		       e4 15		      cpx	wireHead
    393  0b11		       f0 0f		      beq	.noByte
    394  0b13		       ad 06 de 	      lda	ACIA_STAT
    395  0b16		       29 02		      and	#ACIA_TDRE
    396  0b18		       f0 08		      beq	.noByte
    397  0b1a		       bd 00 c0 	      lda	wireBuf,x
    398  0b1d		       8d 05 de 	      sta	ACIA_TX
    399  0b20		       e6 16		      inc	wireTail
    400  0b22				   .noByte
    401  0b22		       c6 2d		      dec	subTick
    402  0b24		       10 22		      bpl	.out
    403  0b26		       a9 03		      lda	#3
    404  0b28		       85 2d		      sta	subTick
    405  0b2a		       98		      tya
    406  0b2b		       48		      pha
    407  0b2c		       e6 10		      inc	ticks
    408  0b2e		       d0 02		      bne	.t
    409  0b30		       e6 11		      inc	ticks+1
    410  0b32				   .t
    411  0b32		       ad 83 c9 	      lda	sidVolNow	; (the SID's volume: a step towards its target)
    412  0b35		       cd 84 c9 	      cmp	sidVolTgt
    413  0b38		       f0 03		      beq	.vs
    414  0b3a		       20 4a 16 	      jsr	VolSlew
    415  0b3d				   .vs
    416  0b3d		       20 53 0c 	      jsr	Schedule
    417  0b40		       20 2e 0c 	      jsr	TxByte	; start a just-scheduled message now if the ACIA is free
    418  0b43		       20 d5 33 	      jsr	RxByte	; (again: this pass was long, a byte may be in)
    419  0b46		       68		      pla
    420  0b47		       a8		      tay
    421  0b48				   .out
    422  0b48		       68		      pla
    423  0b49		       aa		      tax
    424  0b4a		       68		      pla
    425  0b4b		       40		      rti
    426  0b4c
    427  0b4c							; With the MIDI chip's interrupts (midiIrq, v0.16): the chip interrupts when
    428  0b4c							; a byte has come in or the next can go out; the CIA timer ticks each ms.
    429  0b4c				   IrqMidi
    430  0b4c					      subroutine
    431  0b4c		       48		      pha
    432  0b4d		       8a		      txa
    433  0b4e		       48		      pha
    434  0b4f		       ad 06 de 	      lda	ACIA_STAT
    435  0b52		       10 23		      bpl	.tim	; (not the MIDI chip)
    436  0b54		       4a		      lsr		; a byte in?
    437  0b55		       90 03		      bcc	.tx
    438  0b57		       20 db 33 	      jsr	RxGot
    439  0b5a				   .tx
    440  0b5a		       ad 06 de 	      lda	ACIA_STAT
    441  0b5d		       29 02		      and	#ACIA_TDRE
    442  0b5f		       f0 16		      beq	.tim
    443  0b61		       a6 16		      ldx	wireTail
    444  0b63		       e4 15		      cpx	wireHead
    445  0b65		       f0 0b		      beq	.quiet
    446  0b67		       bd 00 c0 	      lda	wireBuf,x
    447  0b6a		       8d 05 de 	      sta	ACIA_TX
    448  0b6d		       e6 16		      inc	wireTail
    449  0b6f		       4c 77 0b 	      jmp	.tim
    450  0b72				   .quiet
    451  0b72		       a9 96		      lda	#ACIA_MODE_RX	; nothing to send: no more "ready" interrupts
    452  0b74		       8d 04 de 	      sta	ACIA_CTRL
    453  0b77				   .tim
    454  0b77		       ad 0d dc 	      lda	CIA1_ICR	; the 1 ms tick?
    455  0b7a		       4a		      lsr
    456  0b7b		       90 21		      bcc	.out
    457  0b7d		       98		      tya
    458  0b7e		       48		      pha
    459  0b7f		       e6 10		      inc	ticks
    460  0b81		       d0 02		      bne	.t
    461  0b83		       e6 11		      inc	ticks+1
    462  0b85				   .t
    463  0b85		       ad 83 c9 	      lda	sidVolNow	; (the SID's volume: a step towards its target)
    464  0b88		       cd 84 c9 	      cmp	sidVolTgt
    465  0b8b		       f0 03		      beq	.vs
    466  0b8d		       20 4a 16 	      jsr	VolSlew
    467  0b90				   .vs
    468  0b90		       20 53 0c 	      jsr	Schedule
    469  0b93		       20 d5 33 	      jsr	RxByte	; (a long tick: a byte may be waiting, and
    470  0b96		       20 2e 0c 	      jsr	TxByte	;  the MIDI chip holds only one)
    471  0b99		       20 d5 33 	      jsr	RxByte
    472  0b9c		       68		      pla
    473  0b9d		       a8		      tay
    474  0b9e				   .out
    475  0b9e		       68		      pla
    476  0b9f		       aa		      tax
    477  0ba0		       68		      pla
    478  0ba1		       40		      rti
    479  0ba2
    480  0ba2							; RESTORE: the only NMI source. Count presses; the main loop acts on them.
    481  0ba2							; (A MIDI chip wired to NMI instead could fire one during MidiIrqTest: that
    482  0ba2							; isn't a press.)
    483  0ba2				   Nmi
    484  0ba2					      subroutine
    485  0ba2		       48		      pha
    486  0ba3		       ad 06 de 	      lda	ACIA_STAT
    487  0ba6		       10 07		      bpl	.r
    488  0ba8		       a9 16		      lda	#ACIA_MODE
    489  0baa		       8d 04 de 	      sta	ACIA_CTRL
    490  0bad		       68		      pla
    491  0bae		       40		      rti
    492  0baf				   .r
    493  0baf		       ad 0d dd 	      lda	CIA2_ICR	; acknowledge anything CIA 2 holds, so the NMI
    494  0bb2							; line is free for the next RESTORE edge
    495  0bb2		       e6 1d		      inc	nmiCount
    496  0bb4		       a5 10		      lda	ticks
    497  0bb6		       85 1e		      sta	nmiTick
