------- FILE menu.asm LEVEL 2 PASS 3
      0  4cb4					      include	"menu.asm"
      1  4cb4							; Fat Chip 64 - the menu (v0.24): RETURN in, SHIFT+RETURN back out
      2  4cb4							;
      3  4cb4							; Pages and lines come from tools/gen_menu.py (menutab.asm). A line is:
      4  4cb4							;   page   RETURN opens a page
      5  4cb4							;   enum   a setting: CRSR RIGHT / SHIFT+CRSR RIGHT step its value
      6  4cb4							;   effect a patch effect: CRSR RIGHT on / off, RETURN its settings
      7  4cb4							;   param  a patch setting: CRSR RIGHT / SHIFT+CRSR RIGHT step it
      8  4cb4							; A line can depend on a variable (mShow): it's left out while that's 0 (the
      9  4cb4							; device pages, until DEVICES says the device is in use).
     10  4cb4							; CRSR DOWN / SHIFT+CRSR DOWN choose a line. SHIFT + /: on a patch setting,
     11  4cb4							; roll just that setting; anywhere else, roll the patch. Every other key does
     12  4cb4							; its usual job (notes, banks, C= keys...), and the values shown follow.
     13  4cb4
     14  4cb4		       00 17	   MENU_VALCOL equ	23
     15  4cb4
     16  4cb4				   MenuOpen
     17  4cb4		       20 79 62 	      jsr	GlitchCalm	; (GLITCH may have the picture shaking)
