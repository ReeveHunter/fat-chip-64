------- FILE drums.asm LEVEL 2 PASS 3
      0  472d					      include	"drums.asm"
      1  472d							; Fat Chip 64 - drums on the MidiNES
      2  472d							;
      3  472d							; Two sources, one kit:
      4  472d							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  472d							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  472d							;			   64 = hit, 56 = ghost)
      7  472d							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  472d							;			   RETURN starts / stops it, at its own tempo (B taps
      9  472d							;			   a new one)
     10  472d							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  472d							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  472d							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  472d							; a note-on, then a note-off after the sound's length, the level set with
     14  472d							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  472d							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  472d
     17  472d		       00 0c	   KIT_SIZE   equ	12
     18  472d		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  472d		       00 00	   DK_KICK    equ	0
     20  472d		       00 01	   DK_SNARE   equ	1
     21  472d		       00 02	   DK_CH      equ	2
     22  472d		       00 03	   DK_OH      equ	3
     23  472d		       00 04	   DK_CY      equ	4
     24  472d		       00 05	   DK_TOM     equ	5
     25  472d		       00 06	   DK_PERC    equ	6
     26  472d
     27  472d							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  472d				   DrumHit
     29  472d					      subroutine
