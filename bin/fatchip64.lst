------- FILE main.asm
------- FILE drums.asm LEVEL 2 PASS 3
      0  4f58					      include	"drums.asm"
      1  4f58							; Fat Chip 64 - drums on the MidiNES
      2  4f58							;
      3  4f58							; Two sources, one kit:
      4  4f58							;   the keytar's rhythm   MIDI in channel 16 (Yamaha SHS-10: 45 kick, 48 tom,
      5  4f58							;			   52 snare, 57 hat, 62 cymbal; velocity 127 = accent,
      6  4f58							;			   64 = hit, 56 = ghost)
      7  4f58							;   the beat demos	   G picks one of six Beat Lab beats (and its kit),
      8  4f58							;			   RETURN starts / stops it, at its own tempo (B taps
      9  4f58							;			   a new one)
     10  4f58							; Kick, snare, toms and percussion are samples on the MidiNES's sample
     11  4f58							; channel (one at a time: a hit within DRUM_WINDOW ms of a more important one
     12  4f58							; is dropped; kick > snare > tom > perc). Hats and cymbals are NES noise:
     13  4f58							; a note-on, then a note-off after the sound's length, the level set with
     14  4f58							; CC7; closed hats vary their note and level a little on each hit (the Beat
     15  4f58							; Lab's noise hats). Kits are in beats.asm (tools/gen_beats.py).
     16  4f58
     17  4f58		       00 0c	   KIT_SIZE   equ	12
     18  4f58		       00 0c	   DRUM_WINDOW equ	12	; ms
     19  4f58		       00 00	   DK_KICK    equ	0
     20  4f58		       00 01	   DK_SNARE   equ	1
     21  4f58		       00 02	   DK_CH      equ	2
     22  4f58		       00 03	   DK_OH      equ	3
     23  4f58		       00 04	   DK_CY      equ	4
     24  4f58		       00 05	   DK_TOM     equ	5
     25  4f58		       00 06	   DK_PERC    equ	6
     26  4f58
     27  4f58							; A = kind, X = level (0 ghost, 1 hit, 2 accent), Y = tom (0 hi, 1 mid, 2 lo)
     28  4f58				   DrumHit
     29  4f58					      subroutine
     30  4f58		       8d 8f c4 	      sta	drumKind
     31  4f5b		       8e 8e c4 	      stx	drumLvl
     32  4f5e		       8c 90 c4 	      sty	drumTom
     33  4f61		       c9 00		      cmp	#DK_KICK
     34  4f63		       d0 05		      bne	.nk
     35  4f65		       a9 01		      lda	#1
     36  4f67		       8d 4c c6 	      sta	vizKick	; (the visualizer's border flash)
     37  4f6a				   .nk
     38  4f6a		       ad 2b c3 	      lda	devOn+DEV_NES
     39  4f6d		       d0 01		      bne	.on
     40  4f6f		       60		      rts
     41  4f70				   .on
     42  4f70		       20 1e 24 	      jsr	GetTicks
     43  4f73		       ad 8f c4 	      lda	drumKind
     44  4f76		       c9 02		      cmp	#DK_CH
     45  4f78		       90 07		      bcc	.dmc
     46  4f7a		       c9 05		      cmp	#DK_TOM
     47  4f7c		       b0 03		      bcs	.dmc
     48  4f7e		       4c 33 50 	      jmp	NoiseHit
     49  4f81				   .dmc
     50  4f81		       ae 8f c4 	      ldx	drumKind
     51  4f84		       bd 1a 50 	      lda	dmcPrioT,x
     52  4f87		       85 24		      sta	t0
     53  4f89		       ad 43 c3 	      lda	nowL
     54  4f8c		       38		      sec
     55  4f8d		       ed 86 c4 	      sbc	dmcAt
     56  4f90		       a8		      tay
     57  4f91		       ad 44 c3 	      lda	nowH
     58  4f94		       ed 87 c4 	      sbc	dmcAt+1
     59  4f97		       d0 0c		      bne	.ok	; (16 bits: a hit 256 ms ago isn't "just now")
     60  4f99		       c0 0c		      cpy	#DRUM_WINDOW
     61  4f9b		       b0 08		      bcs	.ok
     62  4f9d		       a5 24		      lda	t0	; soon after another hit: only if this one matters more
     63  4f9f		       cd 85 c4 	      cmp	dmcPrio
     64  4fa2		       90 01		      bcc	.ok
     65  4fa4		       60		      rts
